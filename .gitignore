# ── Secrets & environment (NEVER commit real config) ──────────────────────────
.env
.env.local
.env.*.local
**/.env
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
*_rsa
secrets.*
credentials.*

# ── Build / runtime artifacts ─────────────────────────────────────────────────
*.tar.gz
*.log
runtime/log/
runtime/txlog/
runtime/db/
*.class
*.jar
# …except the compiled zenith helper classes that are intentionally shipped to the container
!docs/infra/zenith-classes/**

# ── Node (lint tooling) ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Editors / IDEs ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*~

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Scratch ───────────────────────────────────────────────────────────────────
tmp/
*.tmp

# Local developer compose file — contains throwaway passwords, must never be committed
*.local.yml