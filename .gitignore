# ── Secrets & environment (NEVER commit real config) ──────────────────────────
.env
.env.local
.env.*.local
# Local verification YAML can contain local passwords; see docs/infra/local-dev-setup.md.
*.local.yml
**/.env
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
*_rsa
secrets.*
credentials.*

# ── Build / runtime artifacts ─────────────────────────────────────────────────
*.tar.gz
*.log
runtime/log/
runtime/txlog/
runtime/db/
*.class
__pycache__/
*.pyc
*.jar
!docs/infra/zenith-libs/zxing-core-3.5.4.jar
# …except the compiled zenith helper classes that are intentionally shipped to the container
!docs/infra/zenith-classes/**

# ── Node (lint tooling) ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Editors / IDEs ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*~

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Scratch ───────────────────────────────────────────────────────────────────
tmp/
*.tmp
