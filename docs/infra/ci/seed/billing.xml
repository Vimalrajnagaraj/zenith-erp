<?xml version="1.0" encoding="UTF-8"?>
<!-- CI staging ONLY — synthetic MARUTHI-shaped billing fixtures (never prod data).
     Turns CITEST_ORG_A (the isolation test tenant; john.doe is already active there via
     isolation.xml) into a billable POS tenant: company/tax settings, a GST config, a store, a
     terminal, an OPEN session, and three products across GST slabs with RETAIL/WHOLESALE/EMPLOYEE
     prices. The CI mint driver (docs/infra/ci/billing.mjs) then rings up cash/card/split sales and
     the workflow asserts the stored pricing/tax against a golden baseline — proving a billing-path
     change is no-op-safe for a MARUTHI-shaped tenant WITHOUT using MARUTHI's data.

     type="demo" + auto-discovered in the SAME single load as isolation.xml (both docker-cp'd into a
     component data/ dir). SELF-SUFFICIENT: it re-declares CITEST_ORG_A (idempotent upsert by PK) so
     it is load-order-independent from isolation.xml — whichever file loads first creates the org.
     All ids are CITEST_* for easy identification/cleanup. All GST slabs (GST_5/12/18) ship in
     zenith-erp-india seed. Prices/HSN are SYNTHETIC — not real MARUTHI/GSTIN/HSN values. -->
<entity-facade-xml type="demo">

    <!-- ===== the billing tenant (re-declared, idempotent) ===== -->
    <mantle.party.Party partyId="CITEST_ORG_A" partyTypeEnumId="PtyOrganization" ownerPartyId="CITEST_ORG_A"/>
    <mantle.party.Organization partyId="CITEST_ORG_A" organizationName="CI Tenant A"/>
    <mantle.party.PartyRole partyId="CITEST_ORG_A" roleTypeId="OrgInternal"/>

    <!-- ===== company + tax settings (WITHOUT TAX_CALCULATION_SERVICE, tax computes to ZERO) ===== -->
    <zenith.erp.base.CompanySettings organizationPartyId="CITEST_ORG_A" settingKey="COUNTRY_GEO_ID" settingValue="IND"/>
    <zenith.erp.base.CompanySettings organizationPartyId="CITEST_ORG_A" settingKey="CURRENCY_UOM_ID" settingValue="INR"/>
    <zenith.erp.base.CompanySettings organizationPartyId="CITEST_ORG_A" settingKey="TAX_CALCULATION_SERVICE" settingValue="zenith.india.IndiaTaxServices.calculate#Tax"/>
    <zenith.erp.base.CompanySettings organizationPartyId="CITEST_ORG_A" settingKey="FY_START_MONTH" settingValue="4"/>

    <!-- supplier state = Tamil Nadu GST code "33". With no customer, buyer state defaults to supplier
         state -> intra-state -> CGST + SGST (each half the slab rate). isCompositionScheme=N (a
         composition dealer forces zero GST). -->
    <zenith.erp.india.IndiaGstConfig organizationPartyId="CITEST_ORG_A" gstin="33AAAAA0000A1Z5"
        legalName="CI Tenant A" stateCode="33" registrationType="Regular" isCompositionScheme="N"/>

    <!-- ===== store + terminal + an OPEN session (data-loaded; the mint only reads statusId+terminalId) =====
         regionGeoId="33" is what the tax engine uses as supplier AND buyer state code. -->
    <mantle.facility.Facility facilityId="CITEST_A_STORE" facilityTypeEnumId="FcTpRetailStore"
        ownerPartyId="CITEST_ORG_A" facilityName="CI Tenant A Store"/>

    <zenith.erp.pos.PosTerminal terminalId="CITEST_A_TERM" terminalName="CI Test Terminal A"
        organizationPartyId="CITEST_ORG_A" facilityId="CITEST_A_STORE"
        regionGeoId="33" countryGeoId="IND" stateCode="33" isActive="Y"/>

    <zenith.erp.pos.PosSession sessionId="CITEST_A_SESS" terminalId="CITEST_A_TERM"
        organizationPartyId="CITEST_ORG_A" openDate="2026-10-06 09:00:00" openingCash="0"
        totalSales="0" totalReturns="0" totalTransactions="0" statusId="PsOpen"/>

    <!-- ===== three products across GST slabs (tax-exclusive; RETAIL uses mrpAmount) =====
         inventoryTracked=N so the sale never touches stock. gstSlabId set directly = deterministic. -->
    <mantle.product.Product productId="CITEST_BW5" pseudoId="CITEST_BW5" productName="CI Widget 5pct"
        productTypeEnumId="PtAsset" ownerPartyId="CITEST_ORG_A" amountUomId="OTH_ea"
        mrpAmount="100.00" gstSlabId="GST_5" inventoryTracked="N"/>
    <mantle.product.Product productId="CITEST_BW12" pseudoId="CITEST_BW12" productName="CI Widget 12pct"
        productTypeEnumId="PtAsset" ownerPartyId="CITEST_ORG_A" amountUomId="OTH_ea"
        mrpAmount="200.00" gstSlabId="GST_12" inventoryTracked="N"/>
    <mantle.product.Product productId="CITEST_BW18" pseudoId="CITEST_BW18" productName="CI Widget 18pct"
        productTypeEnumId="PtAsset" ownerPartyId="CITEST_ORG_A" amountUomId="OTH_ea"
        mrpAmount="100.00" gstSlabId="GST_18" inventoryTracked="N"/>

    <!-- ===== per-mode prices (RETAIL needs none; WHOLESALE/EMPLOYEE block the add if unset) ===== -->
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW5"  salesModeId="WHOLESALE" organizationPartyId="CITEST_ORG_A" price="90.00"/>
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW5"  salesModeId="EMPLOYEE"  organizationPartyId="CITEST_ORG_A" price="80.00"/>
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW12" salesModeId="WHOLESALE" organizationPartyId="CITEST_ORG_A" price="180.00"/>
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW12" salesModeId="EMPLOYEE"  organizationPartyId="CITEST_ORG_A" price="160.00"/>
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW18" salesModeId="WHOLESALE" organizationPartyId="CITEST_ORG_A" price="85.00"/>
    <zenith.erp.pos.PosProductModePrice productId="CITEST_BW18" salesModeId="EMPLOYEE"  organizationPartyId="CITEST_ORG_A" price="90.00"/>

</entity-facade-xml>
