<?xml version="1.0" encoding="UTF-8"?>
<!-- CI staging ONLY — synthetic org-isolation fixtures (never prod data).
     Two throwaway tenants, each owning exactly one uniquely-named contact, and john.doe made an
     internal agent of Tenant A with ACTIVE_ORGANIZATION=CITEST_ORG_A (mirrors prod's ZIZI PrtAgent /
     OrgInternal structure so the active-org preference sticks and isn't stripped).
     Copied into a temporary CI-only component/data directory. Normal data discovery loads this
     demo fixture after its contacts/base/framework prerequisites, in the same loader invocation.
     The org-isolation assert then checks: as john.doe (active=Tenant A), the contacts list shows
     Tenant A's contact and NOT Tenant B's. All ids are CITEST_*-prefixed for easy identification. -->
<entity-facade-xml type="demo">

    <!-- Framework demo login can exist while an unrelated mantle demo file that creates its
         party rolls back. Make this synthetic association self-contained, without copying users. -->
    <mantle.party.Party partyId="EX_JOHN_DOE" partyTypeEnumId="PtyPerson"/>
    <mantle.party.Person partyId="EX_JOHN_DOE" firstName="John" lastName="CI Demo"/>
    <moqui.security.UserAccount userId="EX_JOHN_DOE" partyId="EX_JOHN_DOE"/>

    <!-- ===== two throwaway tenant orgs (no ownerPartyId so they don't list as their own contacts) ===== -->
    <mantle.party.Party partyId="CITEST_ORG_A" partyTypeEnumId="PtyOrganization"/>
    <mantle.party.Organization partyId="CITEST_ORG_A" organizationName="CI Tenant A"/>
    <mantle.party.PartyRole partyId="CITEST_ORG_A" roleTypeId="OrgInternal"/>

    <mantle.party.Party partyId="CITEST_ORG_B" partyTypeEnumId="PtyOrganization"/>
    <mantle.party.Organization partyId="CITEST_ORG_B" organizationName="CI Tenant B"/>
    <mantle.party.PartyRole partyId="CITEST_ORG_B" roleTypeId="OrgInternal"/>

    <!-- ===== one contact owned by each tenant (distinctive, greppable last names) ===== -->
    <mantle.party.Party partyId="CITEST_A_CUST" partyTypeEnumId="PtyPerson" ownerPartyId="CITEST_ORG_A" disabled="N"/>
    <mantle.party.Person partyId="CITEST_A_CUST" firstName="Alpha" lastName="CITestOnlyInTenantA"/>
    <mantle.party.PartyRole partyId="CITEST_A_CUST" roleTypeId="Customer"/>

    <mantle.party.Party partyId="CITEST_B_CUST" partyTypeEnumId="PtyPerson" ownerPartyId="CITEST_ORG_B" disabled="N"/>
    <mantle.party.Person partyId="CITEST_B_CUST" firstName="Bravo" lastName="CITestOnlyInTenantB"/>
    <mantle.party.PartyRole partyId="CITEST_B_CUST" roleTypeId="Customer"/>

    <!-- ===== make john.doe an internal agent of Tenant A + set it active =====
         fromDate is a past date ON PURPOSE: a null fromDate is excluded by a `fromDate <= now`
         currently-valid filter, which would make the membership invisible, strip ACTIVE_ORGANIZATION,
         and (pre-#14 ignore-if-empty) list ALL contacts -> a FALSE isolation "leak". -->
    <mantle.party.PartyRelationship partyRelationshipId="CITEST_REL_JD_A" fromPartyId="EX_JOHN_DOE"
        toPartyId="CITEST_ORG_A" relationshipTypeEnumId="PrtAgent" toRoleTypeId="OrgInternal"
        fromDate="2020-01-01 00:00:00"/>
    <moqui.security.UserPreference userId="EX_JOHN_DOE" preferenceKey="ACTIVE_ORGANIZATION" preferenceValue="CITEST_ORG_A"/>

</entity-facade-xml>
