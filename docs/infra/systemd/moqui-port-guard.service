[Unit]
Description=Restrict Docker-published Moqui :8080 to localhost (defense-in-depth)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i eth0 -p tcp --dport 8080 -j DROP 2>/dev/null || iptables -I DOCKER-USER -i eth0 -p tcp --dport 8080 -j DROP'
ExecStart=/bin/sh -c 'ip6tables -C DOCKER-USER -i eth0 -p tcp --dport 8080 -j DROP 2>/dev/null || ip6tables -I DOCKER-USER -i eth0 -p tcp --dport 8080 -j DROP'

[Install]
WantedBy=multi-user.target
