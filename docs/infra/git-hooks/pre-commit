#!/bin/sh
# Repo-guards pre-commit hook (2026-07-19).
# Runs the STATIC source guards in docs/infra/ when the file type a guard cares about is
# staged, so a footgun is caught at commit time instead of after a deploy. Guards whose file
# type isn't staged are skipped (fast, no false friction). NOT wired: lint-purge-vocabulary.sh
# (needs the Docker API — a runtime check, not a source lint; would block commits when Docker
# is down).
#
# Activate once per clone:  git config core.hooksPath docs/infra/git-hooks
#                    (or)  sh docs/infra/install-git-hooks.sh
# Emergency bypass:         git commit --no-verify
#
# The guards scan the whole component tree (fast), so they also enforce that no PRE-EXISTING
# violation slips in alongside your change. All three currently pass on the tree.

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

# staged file names (added / copied / modified / renamed)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

staged_has() { printf '%s\n' "$staged" | grep -qiE "$1"; }

rc=0
run() { # run <guard.sh> <human label>
  echo "pre-commit: $2"
  sh "docs/infra/$1" || rc=1
}

# CSS comment footgun — any staged .css, or .xml that may carry a <style> block
if staged_has '\.css$' || staged_has '\.xml$'; then
  run lint-css-comments.sh "lint-css-comments (stray */ in a CSS comment)"
fi

# XML-only guards
if staged_has '\.xml$'; then
  run lint-party-picker.sh "lint-party-picker (cross-tenant party type-ahead)"
  run lint-cross-module-transitions.sh "lint-cross-module-transitions (unregistered cross-module call)"
  run lint-form-dom-collisions.sh "lint-form-dom-collisions (form control shadows a DOM property)"
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: a repo guard FAILED (see above). Fix it, or bypass with 'git commit --no-verify'." >&2
fi
exit "$rc"
