<?xml version="1.0" encoding="UTF-8"?>
<!-- Disposable fixture only: pause after the real service calculated its total. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="PosQaTotalsSchedulingBarrier" entity="zenith.erp.pos.PosTransaction" on-update="true" run-before="true">
        <condition><expression>qa.pos.PosTotalsBarrier.shouldPause(entityValue.transactionId) &amp;&amp; entityValue.get('subtotal') != null</expression></condition>
        <actions><script><![CDATA[
            qa.pos.PosTotalsBarrier.pause()
        ]]></script></actions>
    </eeca>
</eecas>
