# Keep the repo-guard scripts + git hook LF so they run on Linux CI runners and any fresh
# clone (a stray CRLF makes /bin/sh fail with "bad interpreter: ...^M"). Scoped to these files
# only — deliberately NOT a repo-wide `* text=auto`, which would renormalize the 800+ XML files.
/docs/infra/lint-css-comments.sh              text eol=lf
/docs/infra/lint-css-comments.js              text eol=lf
/docs/infra/lint-party-picker.sh              text eol=lf
/docs/infra/lint-cross-module-transitions.sh  text eol=lf
/docs/infra/lint-cross-module-transitions.js  text eol=lf
/docs/infra/install-git-hooks.sh              text eol=lf
/docs/infra/git-hooks/pre-commit              text eol=lf
