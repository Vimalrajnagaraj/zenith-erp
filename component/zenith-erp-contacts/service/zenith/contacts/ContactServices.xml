<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Org-isolation guard: a tenant user may only touch contacts owned by their active organization.
         Platform super-admins (ADMIN) are exempt (they manage cross-tenant). Returns allowed=false and
         adds an error when access is denied. Used by EditContact and the mutating contact services so a
         crafted request can't read/edit another tenant's contact (the lists were already isolated). -->
    <service verb="assert" noun="ContactAccess">
        <in-parameters><parameter name="partyId" required="true"/></in-parameters>
        <out-parameters><parameter name="allowed" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                allowed = true
                if (!ec.user.isInGroup('ADMIN')) {
                    def activeOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    if (!activeOrg || activeOrg == '_NA_') {
                        allowed = false
                    } else {
                        def p = ec.entity.find('mantle.party.Party').condition('partyId', partyId).disableAuthz().one()
                        if (p == null || p.ownerPartyId != activeOrg) allowed = false
                    }
                    if (!allowed) ec.message.addError("You do not have access to this contact.")
                }
            ]]></script>
        </actions>
    </service>

    <service verb="create" noun="Contact">
        <in-parameters>
            <parameter name="partyTypeEnumId" required="true"/>
            <parameter name="organizationName"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="roleTypeId" default-value="Customer"/>
            <parameter name="emailAddress"/>
            <parameter name="countryCode"/>
            <parameter name="contactNumber"/>
            <parameter name="taxRegistrationNumber"/>
            <parameter name="taxRegistrationTypeEnumId"/>
            <parameter name="countryGeoId"/>
            <parameter name="regionGeoId"/>
            <parameter name="creditLimit" type="BigDecimal"/>
            <parameter name="creditDays" type="Integer"/>
            <parameter name="openingBalance" type="BigDecimal"/>
            <parameter name="bankAccountName"/>
            <parameter name="bankAccountNumber"/>
            <parameter name="bankRoutingCode"/>
            <parameter name="bankRoutingCodeType"/>
        </in-parameters>
        <out-parameters>
            <parameter name="partyId"/>
        </out-parameters>
        <actions>
            <!-- Require a name so contacts don't get created blank (shown as "Unknown" everywhere). -->
            <if condition="partyTypeEnumId == 'PtyOrganization'">
                <if condition="!organizationName?.trim()">
                    <return error="true" message="Please enter a business name."/>
                </if>
                <else>
                    <if condition="!firstName?.trim() &amp;&amp; !lastName?.trim()">
                        <return error="true" message="Please enter a first or last name."/>
                    </if>
                </else>
            </if>

            <if condition="partyTypeEnumId == 'PtyOrganization'">
                <service-call name="mantle.party.PartyServices.create#Organization"
                              in-map="[organizationName:organizationName, roleTypeId:roleTypeId]" out-map="context"/>
                <else>
                    <service-call name="mantle.party.PartyServices.create#Person"
                                  in-map="[firstName:firstName, lastName:lastName, roleTypeId:roleTypeId]" out-map="context"/>
                </else>
            </if>

            <!-- tag new contact with the active tenant org so it stays isolated and visible to the tenant -->
            <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="activeOrgId">
                <service-call name="update#mantle.party.Party" in-map="[partyId:partyId, ownerPartyId:activeOrgId]"/>
            </if>

            <service-call name="update#mantle.party.Party"
                          in-map="[partyId:partyId, creditLimit:creditLimit, creditDays:creditDays,
                                   openingBalance:openingBalance, bankAccountName:bankAccountName,
                                   bankAccountNumber:bankAccountNumber, bankRoutingCode:bankRoutingCode,
                                   bankRoutingCodeType:bankRoutingCodeType]"/>

            <if condition="emailAddress">
                <service-call name="mantle.party.ContactServices.create#EmailAddress"
                              in-map="[partyId:partyId, emailAddress:emailAddress, contactMechPurposeId:'EmailPrimary']"/>
            </if>
            <if condition="contactNumber">
                <service-call name="mantle.party.ContactServices.create#TelecomNumber"
                              in-map="[partyId:partyId, countryCode:countryCode, contactNumber:contactNumber, contactMechPurposeId:'PhonePrimary']"/>
            </if>

            <!-- Create tax registration if provided -->
            <if condition="taxRegistrationNumber">
                <service-call name="zenith.tax.TaxServices.create#TaxRegistration" ignore-error="true"
                              in-map="[partyId:partyId,
                                       taxAuthorityId:(countryGeoId ?: 'DEFAULT') + '_NATIONAL',
                                       registrationTypeEnumId:taxRegistrationTypeEnumId ?: 'TrtGeneral',
                                       registrationNumber:taxRegistrationNumber,
                                       regionGeoId:regionGeoId]"/>
            </if>
        </actions>
    </service>

    <service verb="update" noun="Contact">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="organizationName"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="disabled"/>
            <parameter name="paymentTermLockDays" type="Integer"/>
            <parameter name="bankAccountName"/>
            <parameter name="bankAccountNumber"/>
            <parameter name="bankRoutingCode"/>
            <parameter name="bankRoutingCodeType"/>
            <parameter name="creditLimit" type="BigDecimal"/>
            <parameter name="creditDays" type="Integer"/>
            <parameter name="openingBalance" type="BigDecimal"/>
            <parameter name="priceListId"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.contacts.ContactServices.assert#ContactAccess" in-map="[partyId:partyId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return/></if>
            <entity-find-one entity-name="mantle.party.Party" value-field="party"/>
            <if condition="party.partyTypeEnumId == 'PtyOrganization' &amp;&amp; organizationName">
                <service-call name="update#mantle.party.Organization"
                              in-map="[partyId:partyId, organizationName:organizationName]"/>
            </if>
            <if condition="party.partyTypeEnumId == 'PtyPerson'">
                <service-call name="update#mantle.party.Person"
                              in-map="[partyId:partyId, firstName:firstName, lastName:lastName]"/>
            </if>

            <service-call name="update#mantle.party.Party"
                          in-map="[partyId:partyId, disabled:disabled,
                                   paymentTermLockDays:paymentTermLockDays,
                                   bankAccountName:bankAccountName, bankAccountNumber:bankAccountNumber,
                                   bankRoutingCode:bankRoutingCode, bankRoutingCodeType:bankRoutingCodeType,
                                   creditLimit:creditLimit, creditDays:creditDays,
                                   openingBalance:openingBalance, priceListId:priceListId]"/>
        </actions>
    </service>

    <service verb="add" noun="ContactTag">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="tagName" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.contacts.ContactServices.assert#ContactAccess" in-map="[partyId:partyId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return/></if>
            <service-call name="store#zenith.erp.contacts.PartyTag"
                          in-map="[partyId:partyId, tagName:tagName]"/>
        </actions>
    </service>

    <service verb="remove" noun="ContactTag">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="tagName" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.contacts.ContactServices.assert#ContactAccess" in-map="[partyId:partyId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return/></if>
            <service-call name="delete#zenith.erp.contacts.PartyTag"
                          in-map="[partyId:partyId, tagName:tagName]"/>
        </actions>
    </service>

    <service verb="add" noun="ContactTaxRegistration">
        <description>Add a tax registration to a contact (generic replacement for add#ContactGstin)</description>
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="registrationNumber" required="true"/>
            <parameter name="registrationTypeEnumId" required="true"/>
            <parameter name="taxAuthorityId" required="true"/>
            <parameter name="regionGeoId"/>
            <parameter name="isDefault" default-value="Y"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.contacts.ContactServices.assert#ContactAccess" in-map="[partyId:partyId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return/></if>
            <!-- Validate Indian GSTIN format when this is a GST registration (15 chars: 2-digit state code,
                 5 letters, 4 digits, 1 letter, 1 alnum, 'Z', 1 alnum). Other tax types are not pattern-checked. -->
            <script><![CDATA[
                def rn = registrationNumber?.trim()?.toUpperCase()
                def isGst = (registrationTypeEnumId == 'TrtGstin' || (taxAuthorityId?.toString()?.contains('GST')))
                if (rn &amp;&amp; (isGst || rn.length() == 15)) {
                    if (!(rn ==~ /[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]/)) {
                        ec.message.addError("That GSTIN doesn't look valid. A GSTIN is 15 characters, e.g. 29ABCDE1234F1Z5.")
                    }
                }
                if (!ec.message.hasError()) registrationNumber = rn
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="zenith.tax.TaxServices.create#TaxRegistration"
                          in-map="[partyId:partyId, taxAuthorityId:taxAuthorityId,
                                   registrationTypeEnumId:registrationTypeEnumId,
                                   registrationNumber:registrationNumber,
                                   regionGeoId:regionGeoId, isDefault:isDefault]"/>
        </actions>
    </service>

    <service verb="merge" noun="Contacts">
        <in-parameters>
            <parameter name="survivingPartyId" required="true"/>
            <parameter name="mergedPartyId" required="true"/>
        </in-parameters>
        <actions>
            <if condition="survivingPartyId == mergedPartyId">
                <return error="true" message="Cannot merge a contact with itself"/>
            </if>

            <entity-find entity-name="mantle.party.PartyRole" list="mergedRoles">
                <econdition field-name="partyId" from="mergedPartyId"/>
            </entity-find>
            <iterate list="mergedRoles" entry="role">
                <service-call name="store#mantle.party.PartyRole"
                              in-map="[partyId:survivingPartyId, roleTypeId:role.roleTypeId]"/>
            </iterate>

            <entity-find entity-name="mantle.party.contact.PartyContactMech" list="mergedContactMechs">
                <econdition field-name="partyId" from="mergedPartyId"/>
                <date-filter/>
            </entity-find>
            <iterate list="mergedContactMechs" entry="pcm">
                <service-call name="create#mantle.party.contact.PartyContactMech"
                              in-map="[partyId:survivingPartyId, contactMechId:pcm.contactMechId,
                                       contactMechPurposeId:pcm.contactMechPurposeId, fromDate:ec.user.nowTimestamp]"/>
            </iterate>

            <entity-find entity-name="zenith.erp.contacts.PartyTag" list="mergedTags">
                <econdition field-name="partyId" from="mergedPartyId"/>
            </entity-find>
            <iterate list="mergedTags" entry="tag">
                <service-call name="store#zenith.erp.contacts.PartyTag"
                              in-map="[partyId:survivingPartyId, tagName:tag.tagName]"/>
            </iterate>

            <!-- Merge tax registrations -->
            <entity-find entity-name="zenith.erp.tax.TaxRegistration" list="mergedRegs">
                <econdition field-name="partyId" from="mergedPartyId"/>
            </entity-find>
            <iterate list="mergedRegs" entry="reg">
                <service-call name="update#zenith.erp.tax.TaxRegistration"
                              in-map="[registrationId:reg.registrationId, partyId:survivingPartyId]"/>
            </iterate>

            <service-call name="update#mantle.party.Party"
                          in-map="[partyId:mergedPartyId, disabled:'Y']"/>

            <service-call name="create#zenith.erp.contacts.PartyMergeHistory"
                          in-map="[survivingPartyId:survivingPartyId, mergedPartyId:mergedPartyId,
                                   mergedDate:ec.user.nowTimestamp, mergedByUserId:ec.user.userId]"/>
        </actions>
    </service>

    <!-- ========== Customer Group Services ========== -->

    <service verb="create" noun="CustomerGroup">
        <in-parameters>
            <parameter name="groupName" required="true"/>
            <parameter name="groupTypeEnumId" required="true"/>
            <parameter name="description"/>
            <parameter name="priceListId"/>
            <parameter name="defaultDiscountPercent" type="BigDecimal"/>
            <parameter name="creditTermDays" type="Integer"/>
            <parameter name="creditLimitDefault" type="BigDecimal"/>
            <parameter name="paymentTerms"/>
        </in-parameters>
        <out-parameters><parameter name="customerGroupId"/></out-parameters>
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.contacts.CustomerGroup" out-map="context"
                          in-map="context + [organizationPartyId:organizationPartyId]"/>
        </actions>
    </service>

    <service verb="update" noun="CustomerGroup">
        <in-parameters>
            <parameter name="customerGroupId" required="true"/>
            <parameter name="groupName"/>
            <parameter name="groupTypeEnumId"/>
            <parameter name="description"/>
            <parameter name="priceListId"/>
            <parameter name="defaultDiscountPercent" type="BigDecimal"/>
            <parameter name="creditTermDays" type="Integer"/>
            <parameter name="creditLimitDefault" type="BigDecimal"/>
            <parameter name="paymentTerms"/>
            <parameter name="isActive"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.contacts.CustomerGroup" in-map="context"/>
        </actions>
    </service>

    <service verb="assign" noun="CustomerGroup">
        <in-parameters>
            <parameter name="customerGroupId" required="true"/>
            <parameter name="partyId" required="true"/>
            <parameter name="notes"/>
        </in-parameters>
        <actions>
            <!-- Check for existing active membership -->
            <entity-find entity-name="zenith.erp.contacts.CustomerGroupMember" list="existing">
                <econdition field-name="customerGroupId"/>
                <econdition field-name="partyId"/>
                <date-filter/>
            </entity-find>
            <if condition="existing">
                <return message="Customer is already in this group"/>
            </if>
            <service-call name="create#zenith.erp.contacts.CustomerGroupMember"
                          in-map="[customerGroupId:customerGroupId, partyId:partyId,
                                   fromDate:ec.user.nowTimestamp, notes:notes]"/>
        </actions>
    </service>

    <service verb="remove" noun="CustomerGroupMember">
        <in-parameters>
            <parameter name="customerGroupId" required="true"/>
            <parameter name="partyId" required="true"/>
            <parameter name="fromDate" type="Timestamp" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.contacts.CustomerGroupMember"
                          in-map="[customerGroupId:customerGroupId, partyId:partyId,
                                   fromDate:fromDate, thruDate:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="get" noun="CustomerGroups">
        <description>Get all active groups for a customer</description>
        <in-parameters><parameter name="partyId" required="true"/></in-parameters>
        <out-parameters><parameter name="groups" type="List"/></out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.contacts.CustomerGroupMemberDetail" list="groups">
                <econdition field-name="partyId"/>
                <date-filter/>
            </entity-find>
        </actions>
    </service>

    <service verb="get" noun="GroupMembers">
        <description>Get all active members of a customer group</description>
        <in-parameters><parameter name="customerGroupId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="members" type="List"/>
            <parameter name="memberCount" type="Integer"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.contacts.CustomerGroupMemberDetail" list="members">
                <econdition field-name="customerGroupId"/>
                <date-filter/>
            </entity-find>
            <set field="memberCount" from="members.size()"/>
        </actions>
    </service>

</services>
