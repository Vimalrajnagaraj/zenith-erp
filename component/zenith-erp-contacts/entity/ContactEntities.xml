<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Generic Party Extensions ========== -->
    <extend-entity entity-name="Party" package="mantle.party">
        <field name="creditLimit" type="number-decimal"/>
        <field name="creditDays" type="number-integer" enable-audit-log="true"/>
        <field name="openingBalance" type="number-decimal"/>
        <field name="priceListId" type="id"/>
        <field name="paymentTermLockDays" type="number-integer"/>
        <field name="bankAccountName" type="text-medium"/>
        <field name="bankAccountNumber" type="text-short"/>
        <field name="bankRoutingCode" type="text-short"><description>IFSC (India), Sort Code (UK), ABA (US), IBAN (EU)</description></field>
        <field name="bankRoutingCodeType" type="text-short"><description>IFSC, SWIFT, ABA, IBAN, SortCode</description></field>
    </extend-entity>

    <!-- ========== Party Tags ========== -->
    <entity entity-name="PartyTag" package="zenith.erp.contacts" short-alias="PartyTag">
        <field name="partyId" type="id" is-pk="true"/>
        <field name="tagName" type="text-medium" is-pk="true"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ========== Party Merge History ========== -->
    <entity entity-name="PartyMergeHistory" package="zenith.erp.contacts" short-alias="PartyMergeHistory">
        <field name="mergeId" type="id" is-pk="true"/>
        <field name="survivingPartyId" type="id"/>
        <field name="mergedPartyId" type="id"/>
        <field name="mergedDate" type="date-time"/>
        <field name="mergedByUserId" type="id"/>
        <relationship type="one" title="Surviving" related="mantle.party.Party">
            <key-map field-name="survivingPartyId" related="partyId"/>
        </relationship>
    </entity>

    <!-- ZE-CONTACTS-MERGE-HIST: org-scoped view of merge history. PartyMergeHistory itself has NO org
         column, so a bare find leaked EVERY tenant's merges. The surviving contact carries the org on
         Party.ownerPartyId (same source as ContactListView.ownerPartyId), so join through it and filter
         by ownerPartyId. Inner join → merges whose surviving party still exists (all of them). -->
    <view-entity entity-name="PartyMergeHistoryView" package="zenith.erp.contacts">
        <member-entity entity-alias="MH" entity-name="zenith.erp.contacts.PartyMergeHistory"/>
        <member-entity entity-alias="SURV" entity-name="mantle.party.Party" join-from-alias="MH">
            <key-map field-name="survivingPartyId" related="partyId"/>
        </member-entity>
        <alias entity-alias="MH" name="mergeId"/>
        <alias entity-alias="MH" name="survivingPartyId"/>
        <alias entity-alias="MH" name="mergedPartyId"/>
        <alias entity-alias="MH" name="mergedDate"/>
        <alias entity-alias="MH" name="mergedByUserId"/>
        <alias entity-alias="SURV" name="ownerPartyId"/>
    </view-entity>

    <!-- ========== Customer Group ========== -->
    <entity entity-name="CustomerGroup" package="zenith.erp.contacts" short-alias="CustomerGroups">
        <field name="customerGroupId" type="id" is-pk="true"/>
        <field name="groupName" type="text-medium"/>
        <field name="groupTypeEnumId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="priceListId" type="id"/>
        <field name="defaultDiscountPercent" type="number-decimal"/>
        <field name="creditTermDays" type="number-integer"/>
        <field name="creditLimitDefault" type="currency-amount"/>
        <field name="paymentTerms" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="organizationPartyId" type="id"><description>Owning tenant org (multi-tenant isolation)</description></field>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="CustomerGroupType" description="Customer Group Type"/>
            <moqui.basic.Enumeration enumId="CgtWholesale" enumTypeId="CustomerGroupType" description="Wholesale" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CgtRetail" enumTypeId="CustomerGroupType" description="Retail" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CgtVip" enumTypeId="CustomerGroupType" description="VIP" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CgtEmployee" enumTypeId="CustomerGroupType" description="Employee" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="CgtFranchise" enumTypeId="CustomerGroupType" description="Franchise" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="CgtDistributor" enumTypeId="CustomerGroupType" description="Distributor" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="CgtGovernment" enumTypeId="CustomerGroupType" description="Government" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="CgtOnline" enumTypeId="CustomerGroupType" description="Online" sequenceNum="8"/>
        </seed-data>
    </entity>

    <!-- ========== Customer Group Member ========== -->
    <entity entity-name="CustomerGroupMember" package="zenith.erp.contacts" short-alias="CustomerGroupMembers">
        <field name="customerGroupId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.contacts.CustomerGroup"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ========== Customer Group Member View ========== -->
    <view-entity entity-name="CustomerGroupMemberDetail" package="zenith.erp.contacts">
        <member-entity entity-alias="CGM" entity-name="zenith.erp.contacts.CustomerGroupMember"/>
        <member-entity entity-alias="CG" entity-name="zenith.erp.contacts.CustomerGroup" join-from-alias="CGM">
            <key-map field-name="customerGroupId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="CGM" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="CGM" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias entity-alias="CGM" name="customerGroupId"/>
        <alias entity-alias="CGM" name="partyId"/>
        <alias entity-alias="CGM" name="fromDate"/>
        <alias entity-alias="CGM" name="thruDate"/>
        <alias entity-alias="CG" name="groupName"/>
        <alias entity-alias="CG" name="groupTypeEnumId"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="ORG" name="organizationName"/>
    </view-entity>

    <!-- ========== Generic Contact List View ========== -->
    <view-entity entity-name="ContactListView" package="zenith.erp.contacts">
        <member-entity entity-alias="PTY" entity-name="mantle.party.Party"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="EML_PCM" entity-name="mantle.party.contact.PartyContactMech" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/>
            <entity-condition><econdition field-name="contactMechPurposeId" value="EmailPrimary"/></entity-condition>
        </member-entity>
        <member-entity entity-alias="EML_CM" entity-name="mantle.party.contact.ContactMech" join-from-alias="EML_PCM" join-optional="true">
            <key-map field-name="contactMechId"/>
        </member-entity>
        <member-entity entity-alias="TEL_PCM" entity-name="mantle.party.contact.PartyContactMech" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/>
            <entity-condition><econdition field-name="contactMechPurposeId" value="PhonePrimary"/></entity-condition>
        </member-entity>
        <member-entity entity-alias="TEL_CM" entity-name="mantle.party.contact.ContactMech" join-from-alias="TEL_PCM" join-optional="true">
            <key-map field-name="contactMechId"/>
        </member-entity>
        <!-- ZE-CONTACTS-009: a phone number lives in TelecomNumber.contactNumber, NOT ContactMech.infoString
             (which is null for telecom purposes), so the phoneNumber alias must come from here or the
             All-Contacts directory / merge / export show no phone. -->
        <member-entity entity-alias="TEL_TN" entity-name="mantle.party.contact.TelecomNumber" join-from-alias="TEL_PCM" join-optional="true">
            <key-map field-name="contactMechId"/>
        </member-entity>
        <member-entity entity-alias="TREG" entity-name="zenith.erp.tax.TaxRegistration" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/>
            <entity-condition><econdition field-name="isDefault" value="Y"/><econdition field-name="isActive" value="Y"/></entity-condition>
        </member-entity>

        <alias entity-alias="PTY" name="partyId"/>
        <alias entity-alias="PTY" name="ownerPartyId"/>
        <alias entity-alias="PTY" name="partyTypeEnumId"/>
        <alias entity-alias="PTY" name="disabled"/>
        <alias entity-alias="PTY" name="creditLimit"/>
        <alias entity-alias="PTY" name="creditDays"/>
        <alias entity-alias="PTY" name="openingBalance"/>
        <alias entity-alias="PTY" name="priceListId"/>
        <alias entity-alias="PTY" name="paymentTermLockDays"/>
        <alias entity-alias="PTY" name="bankAccountName"/>
        <alias entity-alias="PTY" name="bankAccountNumber"/>
        <alias entity-alias="PTY" name="bankRoutingCode"/>
        <alias entity-alias="PTY" name="bankRoutingCodeType"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="ORG" name="organizationName"/>
        <alias entity-alias="EML_CM" name="emailAddress" field="infoString"/>
        <alias entity-alias="TEL_TN" name="phoneNumber" field="contactNumber"/>
        <alias entity-alias="TREG" name="taxRegistrationNumber" field="registrationNumber"/>
    </view-entity>

</entities>
