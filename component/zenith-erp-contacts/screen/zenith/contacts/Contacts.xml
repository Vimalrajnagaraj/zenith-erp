<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contacts" default-menu-index="2">

    <always-actions>
        <set field="html_title" value="Contacts"/>
        <!-- Plan-aware cross-module nav: SaaS tenants only see buttons for modules in their plan -->
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showSales" from="!planGate || saasAllowedModules.contains('sales')"/>
        <set field="showPurchase" from="!planGate || saasAllowedModules.contains('purchase')"/>
        <set field="showAccounting" from="!planGate || saasAllowedModules.contains('accounting')"/>
        <set field="showCrm" from="!planGate || saasAllowedModules.contains('crm')"/>
        <set field="showHr" from="!planGate || saasAllowedModules.contains('hr')"/>
        <set field="showMarketing" from="!planGate || saasAllowedModules.contains('marketing')"/>
    </always-actions>

    <subscreens default-item="ContactsDashboard">
        <!-- ZE-CONTACTS-NAV: tab order prioritises the most-used views (All Contacts, Customers) before Dashboard.
             menu-index on the subscreens-item overrides each screen's default-menu-index:
             All Contacts(1), Customers(2), Dashboard(3), Suppliers(4), Customer Groups(5), Merge Contacts(6). -->
        <subscreens-item name="ContactsDashboard" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/ContactsDashboard.xml" menu-index="3"/>
        <subscreens-item name="Customers" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Customers.xml" menu-index="2"/>
        <subscreens-item name="Vendors" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Vendors.xml" menu-index="4"/>
        <subscreens-item name="FindContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/FindContact.xml" menu-title="All Contacts" menu-index="1"/>
        <subscreens-item name="CustomerGroups" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/CustomerGroups.xml"
                         menu-title="Customer Groups" menu-index="5"/>
        <subscreens-item name="MergeContacts" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/MergeContacts.xml"
                         menu-title="Merge Contacts" menu-index="6"/>
        <subscreens-item name="MergeHistory" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/MergeHistory.xml" menu-include="false"/>
        <subscreens-item name="EditContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditContact.xml"/>
        <subscreens-item name="ContactProfile" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/ContactProfile.xml" menu-include="false"/>
        <subscreens-item name="EditCustomerGroup" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditCustomerGroup.xml" menu-include="false"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goAccounting"><default-response url="../Accounting/Invoices"/></transition>
    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>

    <widgets>
        <!-- ZE-CONTACTS-NAV (report 'Contacts Navigation Overlap' secondary ask): collapse the always-visible
             cross-module quick-nav row into a compact "More" disclosure so the Contacts header stays clean.
             Native <details> + inline <a sri.buildUrl> links → renders on /apps, /qapps AND /vapps (no JS, no
             <style>); per-surface URLs preserved; plan-gating (show*) preserved. -->
        <render-mode><text type="html,vuet,qvt" template="true"><![CDATA[
        <div class="zc-module-nav" style="display:flex;justify-content:flex-end;padding:12px 16px 0">
          <#assign contactsModuleNavPrefix = ''>
          <#include 'component://zenith-erp-contacts/screen/zenith/contacts/includes/ContactsModuleLinks.html.ftl'>
        </div>
        ]]></text></render-mode>
        <subscreens-active/>
    </widgets>
</screen>
