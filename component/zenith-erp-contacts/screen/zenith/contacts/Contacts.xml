<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contacts" default-menu-index="2">

    <always-actions>
        <set field="html_title" value="Contacts"/>
    </always-actions>

    <actions>
        <!-- Plan-aware cross-module nav: SaaS tenants only see buttons for modules in their plan -->
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showSales" from="!planGate || saasAllowedModules.contains('sales')"/>
        <set field="showPurchase" from="!planGate || saasAllowedModules.contains('purchase')"/>
        <set field="showAccounting" from="!planGate || saasAllowedModules.contains('accounting')"/>
        <set field="showCrm" from="!planGate || saasAllowedModules.contains('crm')"/>
        <set field="showHr" from="!planGate || saasAllowedModules.contains('hr')"/>
        <set field="showMarketing" from="!planGate || saasAllowedModules.contains('marketing')"/>
    </actions>

    <subscreens default-item="ContactsDashboard">
        <subscreens-item name="ContactsDashboard" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/ContactsDashboard.xml"/>
        <subscreens-item name="Customers" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Customers.xml"/>
        <subscreens-item name="Vendors" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/Vendors.xml"/>
        <subscreens-item name="FindContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/FindContact.xml" menu-title="All Contacts"/>
        <subscreens-item name="CustomerGroups" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/CustomerGroups.xml"
                         menu-title="Customer Groups" menu-index="5"/>
        <subscreens-item name="MergeContacts" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/MergeContacts.xml"
                         menu-title="Merge Contacts" menu-index="6"/>
        <subscreens-item name="EditContact" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditContact.xml"/>
        <subscreens-item name="EditCustomerGroup" location="component://zenith-erp-contacts/screen/zenith/contacts/Contacts/EditCustomerGroup.xml" menu-include="false"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goPurchase"><default-response url="../Purchase/RfqList"/></transition>
    <transition name="goAccounting"><default-response url="../Accounting/Invoices"/></transition>
    <transition name="goCrm"><default-response url="../Crm/Leads"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goMarketing"><default-response url="../marketing/Campaigns"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="navSales"><condition><expression>showSales</expression></condition><widgets>
                <link url="goSales" text="Sales" icon="fa fa-line-chart" btn-type="primary" style="q-btn--dense"/>
            </widgets></section>
            <section name="navPurchase"><condition><expression>showPurchase</expression></condition><widgets>
                <link url="goPurchase" text="Purchase" icon="fa fa-shopping-cart" btn-type="info" style="q-btn--dense"/>
            </widgets></section>
            <section name="navAccounting"><condition><expression>showAccounting</expression></condition><widgets>
                <link url="goAccounting" text="Accounting" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            </widgets></section>
            <section name="navCrm"><condition><expression>showCrm</expression></condition><widgets>
                <link url="goCrm" text="CRM" icon="fa fa-bullseye" btn-type="warning" style="q-btn--dense"/>
            </widgets></section>
            <section name="navHr"><condition><expression>showHr</expression></condition><widgets>
                <link url="goHr" text="HR" icon="fa fa-users" btn-type="danger" style="q-btn--dense"/>
            </widgets></section>
            <section name="navMarketing"><condition><expression>showMarketing</expression></condition><widgets>
                <link url="goMarketing" text="Marketing" icon="fa fa-bullhorn" style="q-btn--dense"/>
            </widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
