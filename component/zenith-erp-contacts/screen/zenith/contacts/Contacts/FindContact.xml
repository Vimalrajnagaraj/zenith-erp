<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Find Contacts" default-menu-index="1">

    <transition name="editContact"><default-response url="../EditContact"/></transition>

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization']"/>
        <default-response url="../EditContact"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactList">
            <search-form-inputs default-order-by="organizationName,firstName"/>
            <econdition field-name="partyTypeEnumId" from="partyTypeEnumId" ignore-if-empty="true"/>
            <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box class="zenith-card"><box-header title="All Contacts — everyone you do business with"/><box-toolbar>
            <container-dialog id="NewPersonDialog" button-text="Add Person" button-class="q-btn--flat bg-primary text-white q-mr-sm">
                <form-single name="NewPersonForm" transition="createPerson">
                    <field name="firstName"><default-field><text-line size="30"/></default-field></field>
                    <field name="lastName"><default-field><text-line size="30"/></default-field></field>
                    <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                    <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                    <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                    
                    <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                    <field name="tdsApplicable"><default-field title="TDS Applicable">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    
                    <field name="roleTypeId"><default-field title="Role">
                        <drop-down no-current-selected-key="Customer">
                            <option key="Customer" text="Customer"/>
                            <option key="Vendor" text="Vendor"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Person"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="NewOrgDialog" button-text="Add Company" button-class="q-btn--flat bg-secondary text-white">
                <form-single name="NewOrgForm" transition="createOrganization">
                    <field name="organizationName"><default-field title="Organization Name"><text-line size="60"/></default-field></field>
                    <field name="businessStructureEnumId"><default-field title="Business Structure">
                        <drop-down allow-empty="true">
                            <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                            <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                        </drop-down>
                    </default-field></field>

                    <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                    <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                    <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                    
                    <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                    <field name="gstRegistrationType"><default-field title="GST Registration">
                        <drop-down no-current-selected-key="Regular">
                            <option key="Regular"/><option key="Composition"/>
                            <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                    <field name="tdsApplicable"><default-field title="TDS Applicable">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>

                    <field name="roleTypeId"><default-field title="Role">
                        <drop-down no-current-selected-key="Customer">
                            <option key="Customer" text="Customer"/>
                            <option key="Vendor" text="Vendor"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Organization"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="ContactListForm" list="contactList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                
                                <row-actions>
                    <set field="contactName" from="organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()"/>
                    <set field="initial" from="contactName ? contactName.substring(0,1).toUpperCase() : '?'"/>
                    <set field="isOrg" from="partyTypeEnumId == 'PtyOrganization'"/>
                    
                    <set field="isCsv" from="sri.getRenderMode() == 'csv'"/>

                    <if condition="isCsv">
                        <set field="profileHtml" from="contactName + ' (' + (isOrg ? 'Organization' : 'Person') + ') - ID: ' + partyId"/>
                        
                        <set field="contactParts" from="[]"/>
                        <script>if (emailAddress) contactParts.add(emailAddress)</script>
                        <script>if (phoneNumber) contactParts.add(phoneNumber)</script>
                        <set field="contactHtml" from="contactParts.join(' | ')" />
                        
                        <set field="taxParts" from="[]"/>
                        <script>if (gstin) taxParts.add('GSTIN: ' + gstin + ' (' + gstRegistrationType + ')')</script>
                        <script>if (panNumber) taxParts.add('PAN: ' + panNumber)</script>
                        <script>if (cinNumber) taxParts.add('CIN: ' + cinNumber)</script>
                        <script>if (tdsApplicable == 'Y') taxParts.add('TDS Applicable')</script>
                        <script>if (msmeStatusEnumId &amp;&amp; msmeStatusEnumId != 'Not Registered') taxParts.add('MSME: ' + msmeStatusEnumId)</script>
                        <set field="taxHtml" from="taxParts.join(' | ')"/>
                    <else>
                        <set field="profileHtml" from="&quot;
                            &lt;div style='display:flex; align-items:center;'&gt;
                                &lt;div class='zenith-avatar &quot; + (isOrg ? 'org' : '') + &quot;' style='width:40px;height:40px;font-size:1rem;margin-right:12px;'&gt;&quot; + initial + &quot;&lt;/div&gt;
                                &lt;div&gt;
                                    &lt;div class='text-weight-bold text-primary' style='font-size:1.1rem;'&gt;&quot; + contactName + &quot;&lt;/div&gt;
                                    &lt;div class='text-caption text-grey-6'&gt;
                                        &lt;span class='zenith-badge &quot; + (isOrg ? 'secondary' : 'primary') + &quot;' style='padding:2px 8px;font-size:0.65rem;'&gt;&quot; + (isOrg ? 'Organization' : 'Person') + &quot;&lt;/span&gt;
                                        ID: &quot; + partyId + &quot;
                                    &lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;&quot;"/>

                        <set field="contactHtml" from="&quot;
                            &lt;div style='display:flex; flex-direction:column; gap:4px;'&gt;
                                &quot; + (emailAddress ? &quot;&lt;div&gt;&lt;i class='fa fa-envelope text-primary' style='width:16px;'&gt;&lt;/i&gt; &quot; + emailAddress + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (phoneNumber ? &quot;&lt;div&gt;&lt;i class='fa fa-phone text-secondary' style='width:16px;'&gt;&lt;/i&gt; &quot; + phoneNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                            &lt;/div&gt;&quot;"/>

                        <set field="taxHtml" from="&quot;
                            &lt;div style='display:flex; flex-direction:column; gap:4px;'&gt;
                                &quot; + (gstin ? &quot;&lt;div&gt;&lt;strong&gt;GSTIN:&lt;/strong&gt; &quot; + gstin + &quot; &lt;small class='text-grey'&gt;(&quot; + gstRegistrationType + &quot;)&lt;/small&gt;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (panNumber ? &quot;&lt;div&gt;&lt;strong&gt;PAN:&lt;/strong&gt; &quot; + panNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (cinNumber ? &quot;&lt;div&gt;&lt;strong&gt;CIN:&lt;/strong&gt; &quot; + cinNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &lt;div style='display:flex; gap: 8px;'&gt;
                                    &quot; + (tdsApplicable == 'Y' ? &quot;&lt;span class='zenith-badge warning' style='padding:2px 8px;font-size:0.65rem;'&gt;TDS Applicable&lt;/span&gt;&quot; : &quot;&quot;) + &quot;
                                    &quot; + (msmeStatusEnumId &amp;&amp; msmeStatusEnumId != 'Not Registered' ? &quot;&lt;span class='zenith-badge secondary' style='padding:2px 8px;font-size:0.65rem;'&gt;MSME: &quot; + msmeStatusEnumId + &quot;&lt;/span&gt;&quot; : &quot;&quot;) + &quot;
                                &lt;/div&gt;
                            &lt;/div&gt;&quot;"/>
                    </else>
                    </if>
                </row-actions>

                <!-- Hidden Search Fields -->
                <field name="partyTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true">
                        <option key="PtyPerson" text="Person"/>
                        <option key="PtyOrganization" text="Organization"/>
                    </drop-down>
                </header-field></field>
                <field name="organizationName"><header-field show-order-by="true"><text-line size="30"/></header-field></field>
                <field name="firstName"><header-field show-order-by="true"><text-line size="20"/></header-field></field>
                <field name="lastName"><header-field show-order-by="true"><text-line size="20"/></header-field></field>
                
                <!-- Added Indian Compliance & Contact Search Fields -->
                <field name="gstin"><header-field title="GSTIN"><text-line size="15"/></header-field></field>
                <field name="panNumber"><header-field title="PAN"><text-line size="10"/></header-field></field>
                <field name="cinNumber"><header-field title="CIN"><text-line size="21"/></header-field></field>
                <field name="emailAddress"><header-field title="Email"><text-line size="40"/></header-field></field>
                <field name="phoneNumber"><header-field title="Phone"><text-line size="15"/></header-field></field>

                <!-- Visible Columns -->
                <field name="contactProfile">
                    <header-field title="Contact Profile" show-order-by="false"/>
                    <default-field><display text="${profileHtml}" encode="false"/></default-field>
                </field>

                <field name="contactDetails">
                    <header-field title="Contact Information"/>
                    <default-field><display text="${contactHtml}" encode="false"/></default-field>
                </field>

                <field name="taxDetails">
                    <header-field title="Tax Info"/>
                    <default-field><display text="${taxHtml}" encode="false"/></default-field>
                </field>

                <field name="actions">
                    <header-field title=""/>
                    <default-field>
                        <link url="editContact" text="View / Edit" icon="edit" class="q-btn--flat bg-grey-2 text-primary"/>
                    </default-field>
                </field>

                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
