<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Contacts" default-menu-index="1">

    <!-- ZE-CONTACTS-PROFILE: the row "View / Edit" action now opens the redesigned read-oriented
         ContactProfile (which has its own Edit -> EditContact). Create flows below still land on EditContact. -->
    <transition name="editContact"><default-response url="../ContactProfile"/></transition>

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization']"/>
        <default-response url="../EditContact"/>
    </transition>

    <!-- ZE-CONTACTS-027 / CT-166: real XLSX export (Moqui 4.0 has no xlsx render mode — see
         build#ListXlsx). Exports the full org-scoped, non-disabled contact directory. GSTIN/PAN/CIN are
         enriched per row from IndiaGstin + Party (ContactListView does not alias them), so the sheet
         carries the compliance columns. Org isolation via the ownerPartyId econdition. Read-only. -->
    <transition name="export" read-only="true">
        <parameter name="format"/>
        <actions>
            <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactList">
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <order-by field-name="organizationName"/>
                <order-by field-name="firstName"/>
            </entity-find>
            <script><![CDATA[
                def rows = []
                for (r in contactList) {
                    def party = ec.entity.find("mantle.party.Party").condition("partyId", r.partyId).one()
                    def gstList = ec.entity.find("zenith.erp.india.IndiaGstin").condition("partyId", r.partyId).list()
                    def gstin = gstList ? gstList[0].gstin : ''
                    def gstReg = gstList ? (gstList[0].gstRegistrationType ?: '') : ''
                    def nm = r.organizationName ?: (((r.firstName ?: '') + ' ' + (r.lastName ?: '')).trim())
                    def typ = (r.partyTypeEnumId == 'PtyOrganization') ? 'Organization' : 'Person'
                    rows.add([ (r.partyId ?: ''), (nm ?: 'Unknown'), typ, (r.emailAddress ?: ''), (r.phoneNumber ?: ''),
                               gstin, gstReg, (party?.panNumber ?: ''), (party?.cinNumber ?: '') ])
                }
                context.expHeaders = ['ID', 'Name', 'Type', 'Email', 'Phone', 'GSTIN', 'GST Registration', 'PAN', 'CIN']
                context.expRows = rows
            ]]></script>
            <if condition="format == 'csv'">
                <service-call name="zenith.contacts.ContactServices.build#ListCsv"
                              in-map="[headers:expHeaders, rows:expRows]" out-map="context"/>
                <script><![CDATA[
                    ec.web.response.setContentType("text/csv; charset=utf-8")
                    ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"All_Contacts.csv\"")
                    def os = ec.web.response.outputStream
                    os.write(csvText.getBytes("UTF-8"))
                    os.flush()
                ]]></script>
                <else>
                    <service-call name="zenith.contacts.ContactServices.build#ListXlsx"
                                  in-map="[sheetName:'All Contacts', headers:expHeaders, rows:expRows]" out-map="context"/>
                    <script><![CDATA[
                        ec.web.response.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
                        ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"All_Contacts.xlsx\"")
                        def os = ec.web.response.outputStream
                        os.write(xlsxBase64.decodeBase64())
                        os.flush()
                    ]]></script>
                </else>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <!-- ZE-CONTACTS-016: disabled contacts are hidden by default (so Customers/Vendors stay clean),
             but "Show Disabled = Yes" drops the filter so a disabled contact can be found and re-enabled
             (Edit Profile > Disabled = No). disabledFilter is null when showing all -> ignore-if-empty
             skips the condition; otherwise 'Y' -> excludes disabled. -->
        <set field="disabledFilter" from="(showDisabled == 'Y') ? null : 'Y'"/>
        <!-- ZE-CONTACTS-010: search by GSTIN / PAN / CIN / email / phone. Resolve each term to matching
             partyIds (these live on IndiaGstin / Party / ContactMech, not ContactListView) and filter below. -->
        <script><![CDATA[
            // ZE-CONTACTS-026: GSTIN/PAN/CIN/email/phone live on IndiaGstin / Party / ContactMech, NOT on
            // ContactListView, so resolve each provided term to matching partyIds; the list then filters on
            // `searchPartyIds`. Hardening: (a) accept the OLD direct param names (gstin/panNumber/cinNumber)
            // as fallbacks — those are NOT ContactListView columns, so a stale form/bookmark passing them was
            // silently ignored and the list returned EVERY contact (the "GSTIN/PAN/CIN returns all" bug);
            // (b) normalize the phone term to digits (strip + / spaces / dashes and drop a country-code
            // prefix) so the number as displayed on the profile matches the bare stored contactNumber.
            def _sets = []
            def _gstinT = (gstinSearch ?: gstin)?.toString()?.trim()
            def _panT   = (panSearch ?: panNumber)?.toString()?.trim()
            def _cinT   = (cinSearch ?: cinNumber)?.toString()?.trim()
            def _emailT = emailSearch?.toString()?.trim()
            def _phoneT = phoneSearch?.toString()?.trim()
            if (_gstinT) _sets.add(ec.entity.find("zenith.erp.india.IndiaGstin").condition("gstin","like","%"+_gstinT.toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (_panT)   _sets.add(ec.entity.find("mantle.party.Party").condition("panNumber","like","%"+_panT.toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (_cinT)   _sets.add(ec.entity.find("mantle.party.Party").condition("cinNumber","like","%"+_cinT.toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (_emailT) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechInfo").condition("contactMechTypeEnumId","CmtEmailAddress").condition("infoString","like","%"+_emailT+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (_phoneT) {
                def _pd = _phoneT.replaceAll(/[^0-9]/, '')
                if (_pd.length() > 10) _pd = _pd.substring(_pd.length() - 10)   // drop a country-code prefix (10-digit local number)
                if (_pd) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechTelecomNumber").condition("contactNumber","like","%"+_pd+"%").list().collect{it.partyId}.findAll{it}.unique())
            }
            searchPartyIds = null
            if (_sets) {
                searchPartyIds = _sets[0]
                for (int i = 1; i < _sets.size(); i++) searchPartyIds = searchPartyIds.intersect(_sets[i])
                if (!searchPartyIds) searchPartyIds = ['__NO_MATCH__']
            }
        ]]></script>
        <!-- ZE-CONTACTS-LIST: default 20/page (mockup) — MUST run BEFORE this entity-find, which paginates via
             search-form-inputs; placed after it, the list fetched the default 50 before the seed took effect. -->
        <script><![CDATA[
            if (ec.web != null) { def p = ec.web.parameters; def cur = p?.pageSize; if (cur == null || cur.toString().trim().isEmpty()) { ec.context.pageSize = 20; try { p.put("pageSize", "20") } catch (Throwable _t) { } } }
        ]]></script>
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactList">
            <search-form-inputs default-order-by="organizationName,firstName"/>
            <econdition field-name="partyId" operator="in" from="searchPartyIds" ignore-if-empty="true"/>
            <econdition field-name="partyTypeEnumId" from="partyTypeEnumId" ignore-if-empty="true"/>
            <econdition field-name="disabled" operator="not-equals" from="disabledFilter" or-null="true" ignore-if-empty="true"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <!-- ZE-SALES-0306 f/u: Indian state list for the optional "Place of Supply" dropdown on the create forms. -->
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Freshness: reload if restored from the back/forward cache so a newly-added contact always shows. -->
        <render-mode><text type="html"><![CDATA[<script>
        window.addEventListener('pageshow',function(e){if(e.persisted){location.reload();}});
        /* ZE-DASH-010: the dashboard "Add Contact" quick action deep-links here with ?newContact=1 so the
           Add Person dialog opens straight away (there is no standalone new-contact screen; EditContact needs
           an existing partyId). Text-matched click so it's robust to the dialog's generated id; /apps only. */
        (function(){ if(!/[?&]newContact=1/.test(location.search)) return;
          var tries=0, iv=setInterval(function(){
            var b=[].slice.call(document.querySelectorAll('button,a')).filter(function(x){return x.textContent.trim()==='Add Person';})[0];
            if(b){ b.click(); clearInterval(iv); } else if(++tries>25){ clearInterval(iv); }
          }, 300);
        })();
        </script>]]></text></render-mode>
        <container-box class="zenith-card"><box-header title="All Contacts — everyone you do business with"/><box-toolbar>
            <section name="FindContact_write">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewPersonDialog" button-text="Add Person" button-class="q-btn--flat bg-primary text-white q-mr-sm">
                <form-single name="NewPersonForm" transition="createPerson">
                    <field name="firstName"><default-field><text-line size="30" maxlength="60"/></default-field></field>
                    <field name="lastName"><default-field><text-line size="30" maxlength="60"/></default-field></field>
                    <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                    <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                    <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>

                    <!-- ZE-SALES-0306 f/u: capture GSTIN on the person form too (a sole-proprietor customer can be
                         GST-registered). Entering it stores an IndiaGstin whose state code drives intra vs inter-state
                         GST — the same auto-derive-from-GSTIN path as the company form. Leave blank for a B2C walk-in;
                         such sales then correctly default to the seller's state (intra / CGST+SGST). -->
                    <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                    <field name="gstRegistrationType"><default-field title="GST Registration">
                        <drop-down no-current-selected-key="Regular">
                            <option key="Regular"/><option key="Composition"/>
                            <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                        </drop-down>
                    </default-field></field>

                    <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                    <field name="tdsApplicable"><default-field title="TDS Applicable">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>

                    <!-- ZE-SALES-0306 f/u: optional place-of-supply state, used ONLY when there's no GSTIN
                         above (a GSTIN sets the state itself). Lets an unregistered OUT-OF-STATE customer be
                         billed IGST; leave blank for a local customer (defaults to your state / CGST+SGST). -->
                    <field name="regionGeoId"><default-field title="State (if no GSTIN)">
                        <drop-down allow-empty="true">
                            <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                        </drop-down>
                    </default-field></field>

                    <field name="roleTypeId"><default-field title="Role">
                        <drop-down no-current-selected-key="Customer">
                            <option key="Customer" text="Customer"/>
                            <option key="Supplier" text="Vendor"/>
                            <option key="Both" text="Both (Customer &amp; Vendor)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Person"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="NewOrgDialog" button-text="Add Company" button-class="q-btn--flat bg-secondary text-white">
                <form-single name="NewOrgForm" transition="createOrganization">
                    <field name="organizationName"><default-field title="Organization Name"><text-line size="60" maxlength="120"/></default-field></field>
                    <field name="businessStructureEnumId"><default-field title="Business Structure">
                        <drop-down allow-empty="true">
                            <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                            <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                        </drop-down>
                    </default-field></field>

                    <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                    <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                    <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                    
                    <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                    <field name="gstRegistrationType"><default-field title="GST Registration">
                        <drop-down no-current-selected-key="Regular">
                            <option key="Regular"/><option key="Composition"/>
                            <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                    <field name="tdsApplicable"><default-field title="TDS Applicable">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>

                    <!-- ZE-SALES-0306 f/u: optional place-of-supply state, used ONLY when there's no GSTIN
                         above (a GSTIN sets the state itself). Lets an unregistered OUT-OF-STATE customer be
                         billed IGST; leave blank for a local customer (defaults to your state / CGST+SGST). -->
                    <field name="regionGeoId"><default-field title="State (if no GSTIN)">
                        <drop-down allow-empty="true">
                            <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                        </drop-down>
                    </default-field></field>

                    <field name="roleTypeId"><default-field title="Role">
                        <drop-down no-current-selected-key="Customer">
                            <option key="Customer" text="Customer"/>
                            <option key="Supplier" text="Vendor"/>
                            <option key="Both" text="Both (Customer &amp; Vendor)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Organization"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
            <!-- ZE-CONTACTS-027 / ZE-CONTACTS-025: export the contact directory to CSV or Excel (both clean,
                 via the shared export transition — replaces the native show-csv-button, unifying with the
                 other Contacts lists as proper columns rather than the old 3 mushed HTML columns). -->
            <link url="export" text="Export to CSV" icon="file_download" btn-type="info" class="text-white q-mr-sm"
                  parameter-map="[format:'csv']" link-type="anchor" target-window="_blank"/>
            <link url="export" text="Export to Excel" icon="file_download" btn-type="success" class="text-white"
                  parameter-map="[format:'xlsx']" link-type="anchor" target-window="_blank"/>
        </box-toolbar><box-body>
            <container style="sup-compact">
            <form-list name="ContactListForm" list="contactList" skip-form="true" header-dialog="true"
                       show-page-size="true">
                
                                <row-actions>
                    <set field="contactName" from="organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()"/>
                    <set field="initial" from="contactName ? contactName.substring(0,1).toUpperCase() : '?'"/>
                    <set field="isOrg" from="partyTypeEnumId == 'PtyOrganization'"/>
                    
                    <set field="isCsv" from="sri.getRenderMode() == 'csv'"/>

                    <!-- ZE-CONTACTS-027 f/u: ContactListView does NOT alias GSTIN/PAN/CIN/TDS/MSME, so the
                         Tax Info column was ALWAYS blank (the fields below were null). Enrich per row from
                         source — IndiaGstin for the GSTIN + its registration type (1-to-many; take the
                         first by gstinId), Party for PAN/CIN/TDS/MSME — the same row-actions approach the
                         Customers/Vendors lists already use. -->
                    <entity-find entity-name="zenith.erp.india.IndiaGstin" list="rowGstins">
                        <econdition field-name="partyId" from="partyId"/>
                        <order-by field-name="gstinId"/>
                    </entity-find>
                    <set field="gstin" from="rowGstins ? rowGstins[0].gstin : null"/>
                    <set field="gstRegistrationType" from="rowGstins ? rowGstins[0].gstRegistrationType : null"/>
                    <entity-find-one entity-name="mantle.party.Party" value-field="rowParty">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <set field="panNumber" from="rowParty?.panNumber"/>
                    <set field="cinNumber" from="rowParty?.cinNumber"/>
                    <set field="tdsApplicable" from="rowParty?.tdsApplicable"/>
                    <set field="msmeStatusEnumId" from="rowParty?.msmeStatusEnumId"/>

                    <!-- ZE-CONTACTS-LIST: Contact Type badge (role), Status, and the simplified GSTIN/ID cell. -->
                    <script><![CDATA[
                        def _roles = ec.entity.find("mantle.party.PartyRole").condition("partyId", partyId).useCache(true).list().collect{it.roleTypeId}
                        if ((partyId ?: '').toString().startsWith('WALKIN')) { contactType = 'Walk-in'; contactBadge = 'sup-b-blue' }
                        else if (_roles.any{it in ['Customer','CustomerBillTo']}) { contactType = 'Customer'; contactBadge = 'sup-b-green' }
                        else if (_roles.any{it in ['Supplier','Vendor']}) { contactType = 'Supplier'; contactBadge = 'sup-b-purple' }
                        else { contactType = 'Contact'; contactBadge = 'sup-b-grey' }
                        statusActive = (disabled != 'Y')
                        gstinDisp = gstin ?: '—'
                    ]]></script>

                    <if condition="isCsv">
                        <set field="profileHtml" from="contactName + ' (' + (isOrg ? 'Organization' : 'Person') + ') - ID: ' + partyId"/>
                        
                        <set field="contactParts" from="[]"/>
                        <script>if (emailAddress) contactParts.add(emailAddress)</script>
                        <script>if (phoneNumber) contactParts.add(phoneNumber)</script>
                        <set field="contactHtml" from="contactParts.join(' | ')" />
                        
                        <set field="taxParts" from="[]"/>
                        <script>if (gstin) taxParts.add('GSTIN: ' + gstin + ' (' + gstRegistrationType + ')')</script>
                        <script>if (panNumber) taxParts.add('PAN: ' + panNumber)</script>
                        <script>if (cinNumber) taxParts.add('CIN: ' + cinNumber)</script>
                        <script>if (tdsApplicable == 'Y') taxParts.add('TDS Applicable')</script>
                        <script>if (msmeStatusEnumId &amp;&amp; msmeStatusEnumId != 'Not Registered') taxParts.add('MSME: ' + msmeStatusEnumId)</script>
                        <set field="taxHtml" from="taxParts.join(' | ')"/>
                    <else>
                        <!-- Defense in depth: these columns are rendered with encode="false", so HTML-escape
                             every user-supplied value before it is concatenated into the markup. (The framework
                             input filter already rejects &lt;/&gt; on submit; this guards other entry paths.) -->
                        <script><![CDATA[
                            def _esc = { v -> v == null ? '' : v.toString().replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('"','&quot;').replace("'","&#39;") }
                            contactName = _esc(contactName); initial = _esc(initial); partyId = _esc(partyId)
                            emailAddress = _esc(emailAddress); phoneNumber = _esc(phoneNumber)
                            gstin = _esc(gstin); gstRegistrationType = _esc(gstRegistrationType)
                            panNumber = _esc(panNumber); cinNumber = _esc(cinNumber); msmeStatusEnumId = _esc(msmeStatusEnumId)
                        ]]></script>
                        <set field="profileHtml" from="&quot;
                            &lt;div style='display:flex; align-items:center;'&gt;
                                &lt;div class='zenith-avatar &quot; + (isOrg ? 'org' : '') + &quot;' style='width:40px;height:40px;font-size:1rem;margin-right:12px;'&gt;&quot; + initial + &quot;&lt;/div&gt;
                                &lt;div style='min-width:0;'&gt;
                                    &lt;div class='text-weight-bold text-primary' style='font-size:0.95rem; max-width:230px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;' title='&quot; + contactName + &quot;'&gt;&quot; + contactName + &quot;&lt;/div&gt;
                                    &lt;div class='text-caption text-grey-6'&gt;
                                        &lt;span class='zenith-badge &quot; + (isOrg ? 'secondary' : 'primary') + &quot;' style='padding:2px 8px;font-size:0.65rem;'&gt;&quot; + (isOrg ? 'Organization' : 'Person') + &quot;&lt;/span&gt;&quot; + (disabled == 'Y' ? &quot; &lt;span class='zenith-badge negative' style='padding:2px 8px;font-size:0.65rem;'&gt;Disabled&lt;/span&gt;&quot; : &quot;&quot;) + &quot;
                                        ID: &quot; + partyId + &quot;
                                    &lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;&quot;"/>

                        <set field="contactHtml" from="&quot;
                            &lt;div style='display:flex; flex-direction:column; gap:4px;'&gt;
                                &quot; + (emailAddress ? &quot;&lt;div&gt;&lt;i class='fa fa-envelope text-primary' style='width:16px;'&gt;&lt;/i&gt; &quot; + emailAddress + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (phoneNumber ? &quot;&lt;div&gt;&lt;i class='fa fa-phone text-secondary' style='width:16px;'&gt;&lt;/i&gt; &quot; + phoneNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                            &lt;/div&gt;&quot;"/>

                        <set field="taxHtml" from="&quot;
                            &lt;div style='display:flex; flex-direction:column; gap:4px;'&gt;
                                &quot; + (gstin ? &quot;&lt;div&gt;&lt;strong&gt;GSTIN:&lt;/strong&gt; &quot; + gstin + &quot; &lt;small class='text-grey'&gt;(&quot; + gstRegistrationType + &quot;)&lt;/small&gt;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (panNumber ? &quot;&lt;div&gt;&lt;strong&gt;PAN:&lt;/strong&gt; &quot; + panNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &quot; + (cinNumber ? &quot;&lt;div&gt;&lt;strong&gt;CIN:&lt;/strong&gt; &quot; + cinNumber + &quot;&lt;/div&gt;&quot; : &quot;&quot;) + &quot;
                                &lt;div style='display:flex; gap: 8px;'&gt;
                                    &quot; + (tdsApplicable == 'Y' ? &quot;&lt;span class='zenith-badge warning' style='padding:2px 8px;font-size:0.65rem;'&gt;TDS Applicable&lt;/span&gt;&quot; : &quot;&quot;) + &quot;
                                    &quot; + (msmeStatusEnumId &amp;&amp; msmeStatusEnumId != 'Not Registered' ? &quot;&lt;span class='zenith-badge secondary' style='padding:2px 8px;font-size:0.65rem;'&gt;MSME: &quot; + msmeStatusEnumId + &quot;&lt;/span&gt;&quot; : &quot;&quot;) + &quot;
                                &lt;/div&gt;
                            &lt;/div&gt;&quot;"/>
                    </else>
                    </if>
                </row-actions>

                <!-- Hidden Search Fields -->
                <field name="partyTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true">
                        <option key="PtyPerson" text="Person"/>
                        <option key="PtyOrganization" text="Organization"/>
                    </drop-down>
                </header-field></field>
                <!-- ZE-CONTACTS-026: name search was case-sensitive exact-match — a plain <text-line> sends only
                     the value (no operator/ignore-case), so search-form-inputs defaulted to a case-sensitive
                     equals. Use <text-find> like the Customers/Suppliers lists: its Find Options control defaults
                     to ignore-case (and offers contains/begins), so "liya papers" finds "Liya Papers". -->
                <field name="organizationName"><header-field title="Organization Name" show-order-by="true"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="firstName"><header-field title="First Name" show-order-by="true"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="lastName"><header-field title="Last Name" show-order-by="true"><text-find/></header-field><default-field><hidden/></default-field></field>
                <!-- ZE-CONTACTS-010: search by GSTIN / PAN / CIN / email / phone (resolved to partyIds in actions) -->
                <field name="gstinSearch"><header-field title="GSTIN Search"><text-line size="18"/></header-field><default-field><hidden/></default-field></field>
                <field name="panSearch"><header-field title="PAN Search"><text-line size="12"/></header-field><default-field><hidden/></default-field></field>
                <field name="cinSearch"><header-field title="CIN Search"><text-line size="22"/></header-field><default-field><hidden/></default-field></field>
                <field name="emailSearch"><header-field title="Email Search"><text-line size="30"/></header-field><default-field><hidden/></default-field></field>
                <field name="phoneSearch"><header-field title="Phone Search"><text-line size="15"/></header-field><default-field><hidden/></default-field></field>
                
                <!-- Added Indian Compliance & Contact Search Fields -->
                <!-- ZE-CONTACTS-0-10 (CT-061/062/063): the Find Options dialog showed GSTIN/PAN/CIN/Email/Phone
                     TWICE. These direct-column header-fields were the OLD search, superseded by the *Search fields
                     above (which resolve via IndiaGstin / Party / ContactMech since these values are NOT reliably
                     on ContactListView). Removed the duplicates; the *Search fields remain the single search path. -->
                <!-- ZE-CONTACTS-016: reveal disabled contacts so they can be re-enabled -->
                <field name="showDisabled"><header-field title="Show Disabled">
                    <drop-down no-current-selected-key="N"><option key="N" text="No"/><option key="Y" text="Yes (include disabled)"/></drop-down>
                </header-field></field>

                <!-- Visible Columns -->
                <field name="contactProfile">
                    <header-field title="Contact Profile" show-order-by="false"/>
                    <default-field><display text="${profileHtml}" encode="false"/></default-field>
                </field>

                <field name="contactDetails">
                    <header-field title="Contact Information"/>
                    <default-field><display text="${contactHtml}" encode="false"/></default-field>
                </field>

                <!-- ZE-CONTACTS-LIST: Contact Type (role badge), GSTIN/ID, Status — detailed Tax Info (PAN/CIN/MSME/TDS)
                     dropped from the list per the mockup (it stays on the contact profile/edit screens). -->
                <field name="contactType">
                    <header-field title="Contact Type"/>
                    <default-field><label text="${contactType}" type="span" style="sup-badge ${contactBadge}"/></default-field>
                </field>
                <field name="gstinId">
                    <header-field title="GSTIN / ID"/>
                    <default-field><label text="${gstinDisp}" type="span" style="sup-gstin ${gstin ? '' : 'sup-none'}"/></default-field>
                </field>
                <field name="status">
                    <header-field title="Status"/>
                    <default-field><label text="${statusActive ? 'Active' : 'Inactive'}" type="span" style="sup-badge ${statusActive ? 'sup-b-green' : 'sup-b-orange'}"/></default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <link url="editContact" text="Edit" icon="edit" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-primary bg-white"/>
                    </default-field>
                </field>

                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
            </container>
        </box-body></container-box>
    </widgets>
</screen>
