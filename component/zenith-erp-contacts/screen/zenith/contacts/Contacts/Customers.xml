<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Customers" default-menu-index="2">

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson', roleTypeId:'Customer']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization', roleTypeId:'Customer']"/>
        <default-response url="../EditContact"/>
    </transition>

    <actions>
        <!-- plan-aware action buttons: hide links to modules not in the tenant plan -->
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showSalesBtn" from="!planGate || saasAllowedModules.contains('sales')"/>
        <set field="showAccountingBtn" from="!planGate || saasAllowedModules.contains('accounting')"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Customers" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Everyone you sell to. Add a customer, search the list, or open one to see their details, orders and invoices." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-x-sm">
                <container-dialog id="NewOrgDialog" button-text="Add Company" button-class="q-btn--flat bg-indigo-8 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a company as a customer" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <form-single name="NewOrgForm" transition="createOrganization">
                            <field name="organizationName"><default-field title="Business Name"><text-line size="60"/></default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="submitButton"><default-field title="Save customer"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                <container-dialog id="NewPersonDialog" button-text="Add Person" button-class="q-btn--flat bg-indigo-6 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a person as a customer" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <form-single name="NewPersonForm" transition="createPerson">
                            <field name="firstName"><default-field><text-line size="30"/></default-field></field>
                            <field name="lastName"><default-field><text-line size="30"/></default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="submitButton"><default-field title="Save customer"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
            </container>
        </container>

        <label text="Tip: use the search boxes at the top of each column to find someone fast, and click a name to open their full profile." type="p" style="text-grey-6 text-caption q-mb-sm"/>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="FindCustomerList" list="customerList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <entity-find entity-name="mantle.party.PartyDetailAndRole" list="customerList">
                    <search-form-inputs default-order-by="organizationName,firstName"/>
                    <econdition field-name="roleTypeId" operator="in" value="Customer,CustomerBillTo"/>
                    <!-- We want a unique list of parties, but PartyDetailAndRole can have multiple roles. 
                         Moqui will fetch them, so we just group by partyId if needed, or assume standard roles. -->
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.Party" value-field="partyDetail">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="zenith.erp.india.IndiaGstin" value-field="gstinRec">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                </row-actions>

                <field name="partyId">
                    <header-field title="ID" show-order-by="true"><text-find/></header-field>
                    <default-field><link url="../EditContact" text="${partyId}" parameter-map="[partyId:partyId]" style="text-indigo-8 text-weight-bold"/></default-field>
                </field>

                <field name="organizationName"><header-field title="Company Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="firstName"><header-field title="First Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="lastName"><header-field title="Last Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>

                <field name="name">
                    <header-field title="Customer Name" show-order-by="true"/>
                    <default-field>
                        <label text="${organizationName ?: (((firstName ?: '') + ' ' + (lastName ?: '')).trim()) ?: 'Unknown'}" type="span" style="text-dark text-weight-medium"/>
                    </default-field>
                </field>

                <field name="partyTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="PtyOrganization" text="Organization"/>
                            <option key="PtyPerson" text="Person"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <label text="${partyTypeEnumId == 'PtyOrganization' ? 'Business' : 'Individual'}" type="span" style="zenith-badge info"/>
                    </default-field>
                </field>

                <field name="gstin">
                    <header-field title="GST Number"/>
                    <default-field>
                        <label text="${gstinRec?.gstin ?: 'Not Provided'}" type="span" style="${gstinRec?.gstin ? 'text-dark' : 'text-grey-5'}"/>
                        <label text="Valid" type="span" style="zenith-badge success q-ml-sm" condition="gstinRec?.gstin"/>
                    </default-field>
                </field>
                
                <field name="pan">
                    <header-field title="PAN (tax ID)"/>
                    <default-field>
                        <label text="${partyDetail?.panNumber ?: '-'}" type="span"/>
                    </default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <link url="/apps/zenith/sales/FindOrder" text="Orders" icon="shopping_cart" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-primary q-mr-sm bg-white" parameter-map="[customerPartyId:partyId]" link-type="anchor" condition="showSalesBtn"/>
                        <link url="/apps/zenith/Accounting/Invoices" text="Invoices" icon="receipt_long" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-secondary bg-white" parameter-map="[toPartyId:partyId]" link-type="anchor" condition="showAccountingBtn"/>
                    </default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
