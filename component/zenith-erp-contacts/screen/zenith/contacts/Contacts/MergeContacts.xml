<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Merge Contacts" default-menu-index="6">

    <transition name="mergeContacts">
        <service-call name="zenith.contacts.ContactServices.merge#Contacts"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>

        <!-- Org-scoped, non-disabled contacts to choose from (one row per contact). -->
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactOptions">
            <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
            <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
            <order-by field-name="organizationName,firstName"/>
        </entity-find>

        <!-- Recent merges (this org) for an audit trail. -->
        <entity-find entity-name="zenith.erp.contacts.PartyMergeHistory" list="mergeHistory">
            <order-by field-name="-mergedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- ZE-CONTACTS-MERGE-HEAD: page header grouped as title/description (left) + contextual action
             (right), via the cross-surface .zc-page-head theme class (the Quasar flex utilities used
             before were no-ops on /apps, so "Back to Contacts" fell below-left instead of right). -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Merge Contacts" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Combine a duplicate contact into the one you want to keep." type="p" style="text-grey-6 q-mt-xs q-mb-none"/>
            </container>
            <container style="zc-page-head__actions">
                <link url="../FindContact" text="Back to Contacts" btn-type="secondary" style="zc-btn-back"/>
            </container>
        </container>

        <container-row>
            <row-col lg="7" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <!-- What a merge does + its limits. -->
                    <container style="zenith-card bg-amber-1 border-radius-md q-pa-md q-mb-md">
                        <label text="How merging works" type="h6" style="text-weight-bold q-mb-xs text-orange-9"/>
                        <label type="p" style="text-grey-8 q-my-none"
                               text="The contact you keep stays as-is. The duplicate is DISABLED (hidden from lists) and everything on it — phone/email, roles, tags, tax registrations, and its orders, invoices, payments, POS bills, shipments, subscriptions, loyalty and any store-credit / gift-card balances — moves onto the contact you keep. Invoice and bill numbers and their GST details stay unchanged. This is not easily undone — double-check the two contacts first."/>
                    </container>

                    <form-single name="MergeForm" transition="mergeContacts">
                        <field name="survivingPartyId"><default-field title="Keep this contact">
                            <drop-down>
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="zenith.erp.contacts.ContactListView">
                                        <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
                                        <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                                        <order-by field-name="organizationName,firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>

                        <field name="mergedPartyId"><default-field title="Merge &amp; disable this duplicate">
                            <drop-down>
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="zenith.erp.contacts.ContactListView">
                                        <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
                                        <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                                        <order-by field-name="organizationName,firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>

                        <field name="submitBtn">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                            <submit text="Merge Contacts" confirmation="Merge these two contacts? The duplicate will be disabled. This cannot be easily undone."/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>

            <row-col lg="5" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Recent merges" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="MergeHistoryList" list="mergeHistory" skip-form="true">
                        <row-actions>
                            <entity-find-one entity-name="mantle.party.PartyDetail" value-field="survDetail">
                                <field-map field-name="partyId" from="survivingPartyId"/></entity-find-one>
                            <entity-find-one entity-name="mantle.party.PartyDetail" value-field="mergDetail">
                                <field-map field-name="partyId" from="mergedPartyId"/></entity-find-one>
                        </row-actions>
                        <field name="mergedDate"><default-field title="When"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="survivingPartyId"><default-field title="Kept">
                            <label text="${(survDetail?.organizationName ?: ((survDetail?.firstName?:'') + ' ' + (survDetail?.lastName?:'')).trim()) ?: survivingPartyId}" type="span"/>
                        </default-field></field>
                        <field name="mergedPartyId"><default-field title="Merged (disabled)">
                            <label text="${(mergDetail?.organizationName ?: ((mergDetail?.firstName?:'') + ' ' + (mergDetail?.lastName?:'')).trim()) ?: mergedPartyId}" type="span" style="text-grey-6"/>
                        </default-field></field>
                    </form-list>
                    <label text="No merges yet." type="p" style="text-grey-5" condition="!mergeHistory"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
