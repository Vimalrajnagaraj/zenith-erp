<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Merge Contacts" default-menu-index="6">

    <transition name="mergeContacts">
        <service-call name="zenith.contacts.ContactServices.merge#Contacts"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>

        <!-- Org-scoped, non-disabled contacts to choose from (one row per contact). -->
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contactOptions">
            <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
            <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
            <order-by field-name="organizationName,firstName"/>
        </entity-find>

        <!-- Recent merges (THIS org only) for an audit trail — capped to the latest few; the full list
             is the MergeHistory screen. PartyMergeHistoryView is org-scoped via the surviving party's
             owner (PartyMergeHistory has no org column — a bare find leaked every tenant's merges). -->
        <entity-find entity-name="zenith.erp.contacts.PartyMergeHistoryView" list="mergeHistory" limit="6">
            <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
            <order-by field-name="-mergedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- ZE-CONTACTS-MERGE-HEAD: page header grouped as title/description (left) + contextual action
             (right), via the cross-surface .zc-page-head theme class (the Quasar flex utilities used
             before were no-ops on /apps, so "Back to Contacts" fell below-left instead of right). -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Merge Contacts" type="h3" style="text-weight-bold q-my-none"/>
                <label text="Combine a duplicate contact into the one you want to keep." type="p" style="text-grey-6 q-mt-xs q-mb-none"/>
            </container>
            <container style="zc-page-head__actions">
                <link url="../FindContact" text="Back to Contacts" btn-type="secondary" style="zc-btn-back"/>
            </container>
        </container>

        <container-row>
            <row-col lg="7" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <!-- ZE-CONTACTS-MERGE-FORM: light INFO panel (was an amber warning-style block); the
                         irreversibility caution now lives in a dedicated "Important" panel just before the
                         action (report's key change: separate understanding from execution). -->
                    <container style="zc-info-panel q-mb-md">
                        <label text="How merging works" type="h6" style="zc-info-ttl text-primary text-weight-bold q-mb-xs"/>
                        <label type="p" style="text-grey-8 q-my-none"
                               text="The contact you keep stays as-is. The duplicate is DISABLED (hidden from lists) and everything on it — phone/email, roles, tags, tax registrations, and its orders, invoices, payments, POS bills, shipments, subscriptions, loyalty and any store-credit / gift-card balances — moves onto the contact you keep. Invoice and bill numbers and their GST details stay unchanged."/>
                    </container>

                    <form-single name="MergeForm" transition="mergeContacts">
                        <field name="survivingPartyId"><default-field title="Keep this contact">
                            <drop-down>
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="zenith.erp.contacts.ContactListView">
                                        <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
                                        <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                                        <order-by field-name="organizationName,firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>

                        <field name="mergedPartyId"><default-field title="Merge &amp; disable this duplicate">
                            <drop-down>
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="zenith.erp.contacts.ContactListView">
                                        <econdition field-name="ownerPartyId" from="activeOrg" ignore-if-empty="true"/>
                                        <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                                        <order-by field-name="organizationName,firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>

                        <!-- Dedicated irreversible-action warning immediately before the primary action
                             (the merge#Contacts service already rejects same-contact + non-owned merges). -->
                        <field name="importantWarn"><default-field title="">
                            <label type="p" style="zc-warn-panel" text="Important — This action will disable the selected duplicate contact and cannot be undone."/>
                        </default-field></field>

                        <field name="submitBtn">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                            <submit text="Merge Contacts" confirmation="Merge these two contacts? The duplicate will be disabled. This cannot be easily undone."/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                    <!-- ZE-MERGE-DS §3: prepend a read-only avatar chip to each contact select (mockup's in-field
                         chip). Reads the select's current option only — never writes the value, so the destructive
                         merge target is untouched. /apps native select -> chip attaches; /qapps q-select -> no-op. -->
                    <render-mode><text type="html,qvt"><![CDATA[<img alt="" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" onload="(function(){var t=0;function g(){var d=true;['survivingPartyId','mergedPartyId'].forEach(function(n){var s=document.querySelector('select[name='+n+']');if(!s){d=false;return;}var sc=s.parentNode.querySelector('.select2-container');if(!sc){d=false;return;}if(sc.zcChip)return;sc.zcChip=1;var f=document.createElement('div');f.className='zc-mrg-field';sc.parentNode.insertBefore(f,sc);var c=document.createElement('span');c.className='zc-mrg-chip';f.appendChild(c);f.appendChild(sc);function u(){var o=s.options[s.selectedIndex];var x=(o?o.text:'').trim();var m=x.match(/[A-Za-z0-9]/);c.textContent=m?m[0].toUpperCase():'?';}s.addEventListener('change',u);u();});if(!d&&t++<30){setTimeout(g,300);}}g();})()"/>]]></text></render-mode>
                </container>
            </row-col>

            <row-col lg="5" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Recent merges" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="MergeHistoryList" list="mergeHistory" skip-form="true">
                        <row-actions>
                            <entity-find-one entity-name="mantle.party.PartyDetail" value-field="survDetail">
                                <field-map field-name="partyId" from="survivingPartyId"/></entity-find-one>
                            <entity-find-one entity-name="mantle.party.PartyDetail" value-field="mergDetail">
                                <field-map field-name="partyId" from="mergedPartyId"/></entity-find-one>
                        </row-actions>
                        <field name="mergedDate"><default-field title="When"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="survivingPartyId"><default-field title="Kept">
                            <label text="${(survDetail?.organizationName ?: ((survDetail?.firstName?:'') + ' ' + (survDetail?.lastName?:'')).trim()) ?: survivingPartyId}" type="span"/>
                        </default-field></field>
                        <field name="mergedPartyId"><default-field title="Merged (disabled)">
                            <label text="${(mergDetail?.organizationName ?: ((mergDetail?.firstName?:'') + ' ' + (mergDetail?.lastName?:'')).trim()) ?: mergedPartyId}" type="span" style="text-grey-6"/>
                        </default-field></field>
                    </form-list>
                    <label text="No merges yet." type="p" style="text-grey-5" condition="!mergeHistory"/>
                    <!-- Completion path to the full history (secondary to the table). Shown only when there
                         are merges; link-type="anchor" keeps it a plain text link (no btn-* classes). -->
                    <section name="ViewAllMergesLink">
                        <condition><expression>mergeHistory</expression></condition>
                        <widgets>
                            <container style="zc-viewall-row">
                                <link url="../MergeHistory" text="View all merges" link-type="anchor" style="zc-viewall"/>
                            </container>
                        </widgets>
                    </section>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
