<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Group" default-menu-include="false">

    <parameter name="customerGroupId" required="true"/>

    <transition name="updateGroup">
        <service-call name="zenith.contacts.ContactServices.update#CustomerGroup"/>
        <default-response url="."/>
    </transition>
    <transition name="assignMember">
        <service-call name="zenith.contacts.ContactServices.assign#CustomerGroup"/>
        <default-response url="."/>
    </transition>
    <transition name="removeMember">
        <service-call name="zenith.contacts.ContactServices.remove#CustomerGroupMember"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.contacts.CustomerGroup" value-field="group"/>
        <entity-find entity-name="zenith.erp.contacts.CustomerGroupMemberDetail" list="members">
            <econdition field-name="customerGroupId"/>
            <date-filter/>
            <order-by field-name="organizationName,firstName"/>
        </entity-find>
        <!-- ZE-CG-SUM: resolve the group type DISPLAY NAME — the summary showed the raw enumId (e.g. "CgtWholesale"). -->
        <set field="groupTypeName" from="group?.groupTypeEnumId"/>
        <if condition="group?.groupTypeEnumId">
            <entity-find-one entity-name="moqui.basic.Enumeration" value-field="_gte">
                <field-map field-name="enumId" from="group.groupTypeEnumId"/>
            </entity-find-one>
            <set field="groupTypeName" from="_gte?.description ?: group.groupTypeEnumId"/>
        </if>
    </actions>

    <widgets>
        <!-- ZE-CG-EDIT-HEAD: title/subtitle (left) + Back-to-Customer-Groups (right), per edit-customer-group §1.
             Reuses .zc-page-head + the brand-outlined .zc-btn-back (← arrow), same as Merge Contacts. -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Edit Customer Group" type="h3" style="cust-title text-weight-bold q-my-none"/>
                <label text="Update group details and manage members." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
            </container>
            <container style="zc-page-head__actions">
                <link url="../CustomerGroups" text="Back to Customer Groups" btn-type="secondary" style="zc-btn-back"/>
            </container>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <!-- Group Details -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Group Details" type="h5" style="text-weight-bold q-mb-md cust-title"/>
                    <container style="cg-form">
                    <form-single name="GroupForm" map="group" transition="updateGroup">
                        <field name="customerGroupId"><default-field><hidden/></default-field></field>
                        <field name="groupName"><default-field title="Group Name *"><text-line size="30" placeholder="Enter group name"/></default-field></field>
                        <field name="groupTypeEnumId"><default-field title="Type *">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="CustomerGroupType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <!-- ZE-PRC-019: list the org's real price lists (was hardcoded Retail/Wholesale/Distributor
                             back when the PriceList entity was empty). Sets CustomerGroup.priceListId, which
                             calculate#Price now resolves for a customer via their group membership. -->
                        <field name="priceListId"><default-field title="Price List">
                            <drop-down allow-empty="true">
                                <entity-options key="${priceListId}" text="${priceListName}">
                                    <entity-find entity-name="zenith.erp.pricing.PriceList">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="isActive" value="Y"/>
                                        <order-by field-name="priceListName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                        <field name="defaultDiscountPercent"><default-field title="Default Discount (%)"><text-line size="8" default-value="0"/></default-field></field>
                        <field name="creditTermDays"><default-field title="Credit Term (days)"><text-line size="8" default-value="0"/></default-field></field>
                        <field name="creditLimitDefault"><default-field title="Default Credit Limit (₹)"><text-line size="12" default-value="0.00"/></default-field></field>
                        <field name="paymentTerms"><default-field title="Payment Terms"><text-line size="25" placeholder="e.g. Net 30, Immediate"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="50" placeholder="Enter description (optional)"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn">
                            <conditional-field name="save_write" condition="modCanWrite" title=""><submit text="Update Group" icon="fa fa-save"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                        <!-- ZE-CG-EDIT: two-column grid; Active (left) + Update (right) on the last row. isActive stays a
                             real Y/N <drop-down> (renders + submits correctly on BOTH surfaces). On /apps, cpe-tabs.js hides
                             the select and shows a purple toggle synced to it (a checkbox toggle can't POST "N" unchecked,
                             so it could never deactivate a group); /qapps keeps the safe dropdown. -->
                        <field-layout>
                            <field-ref name="customerGroupId"/>
                            <field-row><field-ref name="groupName"/><field-ref name="groupTypeEnumId"/></field-row>
                            <field-row><field-ref name="priceListId"/><field-ref name="defaultDiscountPercent"/></field-row>
                            <field-row><field-ref name="creditTermDays"/><field-ref name="creditLimitDefault"/></field-row>
                            <field-ref name="paymentTerms"/>
                            <field-ref name="description"/>
                            <field-row><field-ref name="isActive"/><field-ref name="submitBtn"/></field-row>
                        </field-layout>
                    </form-single>
                    </container>
                </container>

                <!-- Members -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Members (${members.size()})" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="EditCustomerGroup_addmember_write">
                          <condition><expression>modCanWrite</expression></condition>
                          <widgets>
                        <container-dialog id="AddMember" button-text="Add Member" type="success">
                            <form-single name="AddMemberForm" transition="assignMember">
                                <field name="customerGroupId" from="group.customerGroupId"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Customer">
                                    <drop-down><entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Customer"/>
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="notes"><default-field><text-line size="30"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                          </widgets>
                        </section>
                    </container>

                    <!-- ZE-CG-EDIT §6/§7: the members table when populated, else a centered empty state. -->
                    <section name="MembersList">
                        <condition><expression>members.size() &gt; 0</expression></condition>
                        <widgets>
                    <form-list name="MembersForm" list="members" skip-form="true">
                        <field name="partyId"><default-field title="Customer">
                            <display text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}"/>
                        </default-field></field>
                        <field name="fromDate"><default-field title="Since"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="removeBtn">
                            <conditional-field name="removeBtn_write" condition="modCanWrite" title="">
                            <link url="removeMember" text="Remove" btn-type="danger"
                                  parameter-map="[customerGroupId:customerGroupId, partyId:partyId, fromDate:fromDate]"
                                  confirmation="Remove this member from the group?"/>
                            </conditional-field>
                            <default-field><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                        </widgets>
                    </section>
                    <section name="MembersEmpty">
                        <condition><expression>members.size() == 0</expression></condition>
                        <widgets>
                            <render-mode><text type="html,qvt,vuet"><![CDATA[
                                <div class="cg-empty">
                                  <div class="cg-empty-ico"><span class="material-icons">group</span></div>
                                  <div class="cg-empty-h">No members added yet.</div>
                                  <div class="cg-empty-sub">Add customers to this group to get started.</div>
                                </div>
                            ]]></text></render-mode>
                        </widgets>
                    </section>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <!-- ZE-CG-SUM: two stacked centered cards (Members / Type) consolidated into ONE compact
                     "Group Summary" card — horizontal, purple icon chips, grey labels, bold-black values, and the
                     Type DISPLAY NAME (was the raw enumId "CgtWholesale"). -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Group Summary" type="h6" style="text-weight-bold q-mb-md cg-summary-title"/>
                    <container style="cg-summary-row">
                        <container style="cg-summary-item">
                            <container style="cg-summary-ico"><label text="group" type="span" style="material-icons"/></container>
                            <container style="cg-summary-text">
                                <label text="Members" type="span" style="cg-summary-label"/>
                                <label text="${members.size()}" type="span" style="cg-summary-val"/>
                            </container>
                        </container>
                        <container style="cg-summary-item">
                            <container style="cg-summary-ico"><label text="shield" type="span" style="material-icons"/></container>
                            <container style="cg-summary-text">
                                <label text="Type" type="span" style="cg-summary-label"/>
                                <label text="${groupTypeName ?: '—'}" type="span" style="cg-summary-val"/>
                            </container>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
