<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization']"/>
        <default-response url="../EditContact"/>
    </transition>

    <actions>
        <!-- Aggregate Customers -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="customerList">
            <econdition field-name="roleTypeId" operator="in" value="Customer,CustomerBillTo"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalCustomers" from="customerList?.size() ?: 0"/>
        
        <!-- Aggregate Vendors -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendorList">
            <econdition field-name="roleTypeId" operator="in" value="Supplier,Vendor"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalVendors" from="vendorList?.size() ?: 0"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Contacts Dashboard" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Everyone you do business with — the people and companies you sell to (customers) and buy from (suppliers), all in one place." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-x-sm">
                <container-dialog id="NewPersonDashDialog" button-text="Add Person" button-class="q-btn--outline bg-white text-primary text-weight-bold shadow-1">
                    <form-single name="NewPersonDashForm" transition="createPerson">
                        <field name="firstName"><default-field><text-line size="30"/></default-field></field>
                        <field name="lastName"><default-field><text-line size="30"/></default-field></field>
                        <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                        <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                        <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                        
                        <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                        <field name="tdsApplicable"><default-field title="TDS Applicable">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        
                        <field name="roleTypeId"><default-field title="Role">
                            <drop-down no-current-selected-key="Customer">
                                <option key="Customer" text="Customer"/>
                                <option key="Vendor" text="Vendor"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Create Person"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                    </form-single>
                </container-dialog>
                <container-dialog id="NewOrgDashDialog" button-text="Add Company" button-class="q-btn--unelevated bg-indigo-8 text-white text-weight-bold shadow-2">
                    <form-single name="NewOrgDashForm" transition="createOrganization">
                        <field name="organizationName"><default-field title="Organization Name"><text-line size="60"/></default-field></field>
                        <field name="businessStructureEnumId"><default-field title="Business Structure">
                            <drop-down allow-empty="true">
                                <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                                <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                            </drop-down>
                        </default-field></field>

                        <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                        <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                        <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                        
                        <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                        <field name="gstRegistrationType"><default-field title="GST Registration">
                            <drop-down no-current-selected-key="Regular">
                                <option key="Regular"/><option key="Composition"/>
                                <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                        <field name="tdsApplicable"><default-field title="TDS Applicable">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>

                        <field name="roleTypeId"><default-field title="Role">
                            <drop-down no-current-selected-key="Customer">
                                <option key="Customer" text="Customer"/>
                                <option key="Vendor" text="Vendor"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Create Organization"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <!-- Total Customers -->
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-lg border-left border-info q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Total Customers" type="h6" style="text-grey-7 q-my-none"/>
                            <label text="${totalCustomers}" type="h3" style="text-info text-weight-bold q-my-none q-mt-sm"/>
                        </container>
                        <container style="zenith-avatar text-info bg-cyan-1" type="div">
                            <render-mode><text type="html"><![CDATA[<q-icon name="groups" class="text-h3"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-md">
                        <link url="../Customers" text="View Customers" style="q-btn q-btn--flat text-info text-weight-bold"/>
                    </container>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Total Vendors -->
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-lg border-left border-warning q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Total Suppliers" type="h6" style="text-grey-7 q-my-none"/>
                            <label text="${totalVendors}" type="h3" style="text-warning text-weight-bold q-my-none q-mt-sm"/>
                        </container>
                        <container style="zenith-avatar text-warning bg-orange-1" type="div">
                            <render-mode><text type="html"><![CDATA[<q-icon name="local_shipping" class="text-h3"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-md">
                        <link url="../Vendors" text="View Vendors" style="q-btn q-btn--flat text-warning text-weight-bold"/>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-indigo-9 text-white shadow-2 border-radius-lg q-pa-xl q-mt-lg text-center">
                    <label text="Tip: add a customer or supplier once, and they're ready to use everywhere — sales, invoices and payments." type="h5" style="text-indigo-1 text-weight-medium"/>
                    <label text="Make sure to record the accurate GSTIN and PAN details for all active customers and vendors to ensure smooth invoicing and tax filing." type="p" style="text-indigo-2 q-mt-sm"/>
                    <link url="../FindContact" text="Manage Directory" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-white text-indigo-9 q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-xl q-mt-md"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
