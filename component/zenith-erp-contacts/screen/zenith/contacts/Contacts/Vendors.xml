<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Suppliers" default-menu-index="3">

    <!-- ZE-SUP-LIST: inline filter params (Supplier Type + Show Disabled), read from the GET URL. -->
    <parameter name="showDisabled"/>
    <parameter name="partyTypeEnumId"/>

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson', roleTypeId:'Vendor']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization', roleTypeId:'Vendor']"/>
        <default-response url="../EditContact"/>
    </transition>

    <!-- ZE-CONTACTS-027 / CT-166: real XLSX export (Moqui 4.0 has no xlsx render mode — see
         build#ListXlsx). Exports the full org-scoped, non-disabled supplier list; org isolation via the
         ownerPartyId econdition (transitions run outside the active-org filter). Read-only. -->
    <transition name="export" read-only="true">
        <parameter name="format"/>
        <actions>
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendorList">
                <econdition field-name="roleTypeId" operator="in" value="Supplier,Vendor"/>
                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <order-by field-name="organizationName"/>
                <order-by field-name="firstName"/>
            </entity-find>
            <script><![CDATA[
                def rows = []
                def seen = new HashSet()
                for (r in vendorList) {
                    if (!seen.add(r.partyId)) continue   // PartyDetailAndRole repeats a party across roles
                    def party = ec.entity.find("mantle.party.Party").condition("partyId", r.partyId).one()
                    def gstList = ec.entity.find("zenith.erp.india.IndiaGstin").condition("partyId", r.partyId).list()
                    def nm = r.organizationName ?: (((r.firstName ?: '') + ' ' + (r.lastName ?: '')).trim())
                    def typ = (r.partyTypeEnumId == 'PtyOrganization') ? 'Business' : 'Individual'
                    rows.add([ (r.partyId ?: ''), (nm ?: 'Unknown'), typ, (gstList ? gstList[0].gstin : ''), (party?.panNumber ?: '') ])
                }
                context.expHeaders = ['ID', 'Vendor Name', 'Type', 'GSTIN', 'PAN']
                context.expRows = rows
            ]]></script>
            <if condition="format == 'csv'">
                <service-call name="zenith.contacts.ContactServices.build#ListCsv"
                              in-map="[headers:expHeaders, rows:expRows]" out-map="context"/>
                <script><![CDATA[
                    ec.web.response.setContentType("text/csv; charset=utf-8")
                    ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Suppliers.csv\"")
                    def os = ec.web.response.outputStream
                    os.write(csvText.getBytes("UTF-8"))
                    os.flush()
                ]]></script>
                <else>
                    <service-call name="zenith.contacts.ContactServices.build#ListXlsx"
                                  in-map="[sheetName:'Suppliers', headers:expHeaders, rows:expRows]" out-map="context"/>
                    <script><![CDATA[
                        ec.web.response.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
                        ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Suppliers.xlsx\"")
                        def os = ec.web.response.outputStream
                        os.write(xlsxBase64.decodeBase64())
                        os.flush()
                    ]]></script>
                </else>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showPurchaseBtn" from="!planGate || saasAllowedModules.contains('purchase')"/>
        <set field="showAccountingBtn" from="!planGate || saasAllowedModules.contains('accounting')"/>
        <!-- ZE-SUP-LIST: Show Disabled — default hides disabled (disabledFilter='Y' excludes them); the
             toggle sets showDisabled='Y' -> disabledFilter=null -> ignore-if-empty drops the filter. -->
        <set field="disabledFilter" from="(showDisabled == 'Y') ? null : 'Y'"/>
        <!-- ZE-CONTACTS-010: let the Find Options dialog search by GSTIN / PAN / CIN / email / phone.
             Resolve each provided term to matching partyIds (these live on IndiaGstin / Party / ContactMech,
             not the PartyDetailAndRole search view); the list then filters on `searchPartyIds`. -->
        <script><![CDATA[
            def _sets = []
            if (gstinSearch?.trim()) _sets.add(ec.entity.find("zenith.erp.india.IndiaGstin").condition("gstin","like","%"+gstinSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (panSearch?.trim()) _sets.add(ec.entity.find("mantle.party.Party").condition("panNumber","like","%"+panSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (cinSearch?.trim()) _sets.add(ec.entity.find("mantle.party.Party").condition("cinNumber","like","%"+cinSearch.trim().toUpperCase()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (emailSearch?.trim()) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechInfo").condition("contactMechTypeEnumId","CmtEmailAddress").condition("infoString","like","%"+emailSearch.trim()+"%").list().collect{it.partyId}.findAll{it}.unique())
            if (phoneSearch?.trim()) _sets.add(ec.entity.find("mantle.party.contact.PartyContactMechTelecomNumber").condition("contactNumber","like","%"+phoneSearch.trim()+"%").list().collect{it.partyId}.findAll{it}.unique())
            searchPartyIds = null
            if (_sets) {
                searchPartyIds = _sets[0]
                for (int i = 1; i < _sets.size(); i++) searchPartyIds = searchPartyIds.intersect(_sets[i])
                if (!searchPartyIds) searchPartyIds = ['__NO_MATCH__']
            }
        ]]></script>
    </actions>

    <widgets>
        <!-- Freshness: reload if restored from the back/forward cache so a newly-added supplier always shows without F5. -->
        <render-mode><text type="html"><![CDATA[<script>window.addEventListener('pageshow',function(e){if(e.persisted){location.reload();}});</script>]]></text></render-mode>
        <container style="sup-head q-mb-md">
            <container style="sup-head-main">
                <label text="Suppliers" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Everyone you buy from. Add a supplier, search the list, or open one to see their details and bills." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                <label text="Manage your supply chain partners and ensure ITC compliance via GSTIN tracking." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
                <!-- ZE-SUP-LIST: guidance tip. -->
                <label text="Tip: use Find Options to search by name, company, or ID — then click a supplier's name or ID to open their full profile." type="p" style="sup-tip"/>
            </container>
            <!-- ZE-SUP-LIST: consolidated action bar — Add buttons (write-gated) + exports, on the title row. -->
            <container style="sup-head-actions">
              <section name="Vendors_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                  <container style="row q-gutter-x-sm">
                <container-dialog id="NewOrgDialog" button-text="Add Company" button-class="q-btn--flat bg-indigo-8 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a company as a supplier" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <!-- Same rich fields as Customers/Dashboard so Add behaves the same everywhere.
                             All fields except the name are optional. Role is fixed to Vendor on this screen. -->
                        <form-single name="NewOrgForm" transition="createOrganization">
                            <field name="organizationName"><default-field title="Business Name"><text-line size="60"/></default-field></field>
                            <field name="businessStructureEnumId"><default-field title="Business Structure">
                                <drop-down allow-empty="true">
                                    <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                                    <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                                </drop-down>
                            </default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                            <field name="gstRegistrationType"><default-field title="GST Registration">
                                <drop-down no-current-selected-key="Regular">
                                    <option key="Regular"/><option key="Composition"/>
                                    <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                                </drop-down>
                            </default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Create Business Vendor"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                <container-dialog id="NewPersonDialog" button-text="Add Person" button-class="q-btn--flat bg-indigo-6 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a person as a supplier" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <form-single name="NewPersonForm" transition="createPerson">
                            <field name="firstName"><default-field title="First Name"><text-line size="30"/></default-field></field>
                            <field name="lastName"><default-field title="Last Name"><text-line size="30"/></default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Create Individual Vendor"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                  </container>
                </widgets>
              </section>
              <!-- ZE-CONTACTS-027 / ZE-CONTACTS-025: export to CSV or Excel via the shared export transition
                   (both kept — Excel is a real, used feature). Now on the action row with the Add buttons. -->
              <link url="export" text="Export to CSV" icon="file_download" btn-type="info" class="text-white"
                    parameter-map="[format:'csv']" link-type="anchor" target-window="_blank"/>
              <link url="export" text="Export to Excel" icon="file_download" btn-type="success" class="text-white"
                    parameter-map="[format:'xlsx']" link-type="anchor" target-window="_blank"/>
            </container>
        </container>

        <!-- ZE-SUP-LIST v2: inline filter bar — Supplier Type dropdown (native <details>, no JS) + a real
             Show Disabled toggle-switch. GET-param filters (the form-list binds partyTypeEnumId; showDisabled
             drops the active-only condition); each control preserves the other param. Renders on all three
             surfaces (html/qvt/vuet). Default = active-only = MARUTHI no-op. -->
        <render-mode><text type="html,qvt,vuet"><![CDATA[
            <#assign _t = (partyTypeEnumId)!''><#assign _sd = (showDisabled)!''>
            <#assign _tName><#if _t == 'PtyOrganization'>Business<#elseif _t == 'PtyPerson'>Individual<#else>All</#if></#assign>
            <div class="sup-filterbar2">
              <span class="sup-flabel">Supplier Type:</span>
              <details class="sup-dd">
                <summary class="sup-dd-btn"><span>${_tName}</span><span class="sup-dd-caret">▼</span></summary>
                <div class="sup-dd-menu">
                  <a href="?partyTypeEnumId=&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == ''> on</#if>">All</a>
                  <a href="?partyTypeEnumId=PtyOrganization&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == 'PtyOrganization'> on</#if>">Business</a>
                  <a href="?partyTypeEnumId=PtyPerson&amp;showDisabled=${_sd}" class="sup-dd-item<#if _t == 'PtyPerson'> on</#if>">Individual</a>
                </div>
              </details>
              <span class="sup-fspacer"></span>
              <a href="?showDisabled=<#if _sd == 'Y'>N<#else>Y</#if>&amp;partyTypeEnumId=${_t}" class="sup-switch-link<#if _sd == 'Y'> sup-switch-on</#if>">Show Disabled</a>
            </div>
        ]]></text></render-mode>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md sup-compact">
            <form-list name="FindVendorList" list="vendorList" skip-form="true" header-dialog="true" show-page-size="true">
                <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendorList">
                    <search-form-inputs default-order-by="organizationName,firstName"/>
                    <econdition field-name="roleTypeId" operator="in" value="Supplier,Vendor"/>
                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                    <!-- Hide disabled contacts by default; the Show Disabled toggle drops this filter. -->
                    <econdition field-name="disabled" operator="not-equals" from="disabledFilter" or-null="true" ignore-if-empty="true"/>
                    <!-- ZE-CONTACTS-010: GSTIN/PAN/CIN/email/phone search resolves to partyIds in screen actions. -->
                    <econdition field-name="partyId" operator="in" from="searchPartyIds" ignore-if-empty="true"/>
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.Party" value-field="partyDetail">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="zenith.erp.india.IndiaGstin" value-field="gstinRec">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <!-- ZE-SUP-LIST: per-row display values — name, avatar initial+colour, type, and the
                         supplier's PRIMARY email/phone (real contact data; null-safe, blank when none). -->
                    <script><![CDATA[
                        dispName = organizationName ?: (((firstName ?: '') + ' ' + (lastName ?: '')).trim()) ?: 'Unknown'
                        avatarInitial = dispName.trim().take(1).toUpperCase()
                        isBiz = (partyTypeEnumId == 'PtyOrganization')
                        def _pal = ['a','b','c','d','e','f']
                        avatarColor = _pal[(((partyId ?: '').hashCode() % _pal.size()) + _pal.size()) % _pal.size()]
                        rowEmail = null; rowPhone = null
                        try {
                            def _em = ec.entity.find("mantle.party.contact.PartyContactMechInfo")
                                        .condition("partyId", partyId).condition("contactMechTypeEnumId", "CmtEmailAddress")
                                        .conditionDate("fromDate", "thruDate", ec.user.nowTimestamp)
                                        .orderBy("-contactMechPurposeId").list()
                            if (_em) rowEmail = _em[0].infoString
                            def _ph = ec.entity.find("mantle.party.contact.PartyContactMechTelecomNumber")
                                        .condition("partyId", partyId)
                                        .conditionDate("fromDate", "thruDate", ec.user.nowTimestamp)
                                        .orderBy("-contactMechPurposeId").list()
                            if (_ph) rowPhone = _ph[0].contactNumber
                        } catch (Throwable _t) { }
                    ]]></script>
                </row-actions>

                <!-- ZE-SUP-LIST: Party ID is no longer its own column (the ID shows under the supplier name);
                     kept as a hidden Find-Options search field so ID lookup still works. -->
                <field name="partyId">
                    <header-field title="Party ID"><text-find/></header-field>
                    <default-field><hidden/></default-field>
                </field>

                <field name="organizationName"><header-field title="Company Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="firstName"><header-field title="First Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="lastName"><header-field title="Last Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>

                <!-- ZE-CONTACTS-010: search by GSTIN / PAN / CIN / email / phone (resolved to partyIds in actions) -->
                <field name="gstinSearch"><header-field title="GSTIN Search"><text-line size="18"/></header-field><default-field><hidden/></default-field></field>
                <field name="panSearch"><header-field title="PAN Search"><text-line size="12"/></header-field><default-field><hidden/></default-field></field>
                <field name="cinSearch"><header-field title="CIN Search"><text-line size="22"/></header-field><default-field><hidden/></default-field></field>
                <field name="emailSearch"><header-field title="Email Search"><text-line size="30"/></header-field><default-field><hidden/></default-field></field>
                <field name="phoneSearch"><header-field title="Phone Search"><text-line size="15"/></header-field><default-field><hidden/></default-field></field>
                <!-- ZE-SUP-LIST: Show Disabled also in Find Options so the inline toggle's param round-trips. -->
                <field name="showDisabled"><header-field title="Show Disabled"><drop-down no-current-selected-key="N"><option key="N" text="No"/><option key="Y" text="Yes (include disabled)"/></drop-down></header-field><default-field><hidden/></default-field></field>

                <field name="name">
                    <header-field title="Supplier Name" show-order-by="true"/>
                    <default-field>
                        <!-- CT-041 / ZE-CONTACTS-007: name opens the profile (parity with the Customers list).
                             ZE-SUP-LIST: avatar + bold name + ID underneath (Party ID column removed). -->
                        <container style="sup-namecell">
                            <label text="${avatarInitial}" type="span" style="sup-avatar sup-av-${avatarColor}"/>
                            <container style="sup-nametext">
                                <link url="../ContactProfile" text="${dispName}" parameter-map="[partyId:partyId]" link-type="anchor" style="sup-name zenith-contact-name"/>
                                <label text="ID: ${partyId}" type="span" style="sup-id"/>
                            </container>
                        </container>
                    </default-field>
                </field>

                <!-- ZE-SUP-LIST: Contact Information — the supplier's primary email + phone (real data). -->
                <field name="contactInfo">
                    <header-field title="Contact Information"/>
                    <default-field>
                        <container style="sup-stack">
                            <container style="sup-cline"><label text="mail" type="span" style="material-icons sup-cicon" condition="rowEmail"/><label text="${rowEmail}" type="span" style="sup-cval" condition="rowEmail"/></container>
                            <container style="sup-cline"><label text="call" type="span" style="material-icons sup-cicon" condition="rowPhone"/><label text="${rowPhone}" type="span" style="sup-cval" condition="rowPhone"/></container>
                            <label text="No contact info" type="span" style="sup-cval sup-cempty" condition="!rowEmail &amp;&amp; !rowPhone"/>
                        </container>
                    </default-field>
                </field>

                <field name="partyTypeEnumId">
                    <header-field title="Supplier Type">
                        <drop-down allow-empty="true">
                            <option key="PtyOrganization" text="Organization"/>
                            <option key="PtyPerson" text="Person"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <label text="${isBiz ? 'Business' : 'Individual'}" type="span" style="sup-badge ${isBiz ? 'sup-b-green' : 'sup-b-purple'}"/>
                    </default-field>
                </field>

                <field name="gstin">
                    <header-field title="GSTIN (For ITC)"/>
                    <default-field>
                        <container style="sup-stack">
                            <label text="${gstinRec?.gstin}" type="span" style="sup-gstin" condition="gstinRec?.gstin"/>
                            <label text="GST registered" type="span" style="sup-badge sup-b-green" condition="gstinRec?.gstin"/>
                            <label text="Not Provided" type="span" style="sup-gstin sup-none" condition="!gstinRec?.gstin"/>
                            <label text="No ITC" type="span" style="sup-noitc" condition="!gstinRec?.gstin"/>
                        </container>
                    </default-field>
                </field>
                
                <field name="pan">
                    <header-field title="PAN"/>
                    <default-field>
                        <label text="${partyDetail?.panNumber ?: '-'}" type="span" style="sup-gstin"/>
                    </default-field>
                </field>

                <!-- ZE-SUP-LIST: Status badge from the real `disabled` field (the list already hides disabled,
                     so shown suppliers read Active — honest, not fabricated). -->
                <field name="status">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${partyDetail?.disabled == 'Y' ? 'Disabled' : 'Active'}" type="span" style="sup-badge ${partyDetail?.disabled == 'Y' ? 'sup-b-grey' : 'sup-b-green'}"/>
                    </default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <link url="/apps/zenith/Purchase/FindPurchaseOrder" text="POs" icon="shopping_bag" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-primary q-mr-sm bg-white" parameter-map="[vendorPartyId:partyId]" link-type="anchor" condition="showPurchaseBtn"/>
                        <link url="/apps/zenith/Purchase/FindPurchaseInvoice" text="Bills" icon="receipt" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-warning q-mr-sm bg-white" parameter-map="[fromPartyId:partyId]" link-type="anchor" condition="showPurchaseBtn"/>
                        <link url="/apps/zenith/Accounting/Invoices" text="Ledger" icon="account_balance_wallet" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-secondary bg-white" parameter-map="[fromPartyId:partyId]" link-type="anchor" condition="showAccountingBtn"/>
                    </default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
