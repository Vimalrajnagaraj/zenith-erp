<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Suppliers" default-menu-index="3">

    <transition name="createPerson">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyPerson', roleTypeId:'Vendor']"/>
        <default-response url="../EditContact"/>
    </transition>
    <transition name="createOrganization">
        <service-call name="zenith.contacts.ContactServices.create#Contact"
                      in-map="context + [partyTypeEnumId:'PtyOrganization', roleTypeId:'Vendor']"/>
        <default-response url="../EditContact"/>
    </transition>

    <actions>
        <set field="planGate" from="isSaasTenant &amp;&amp; !saasHasAllAccess &amp;&amp; saasAllowedModules != null"/>
        <set field="showPurchaseBtn" from="!planGate || saasAllowedModules.contains('purchase')"/>
        <set field="showAccountingBtn" from="!planGate || saasAllowedModules.contains('accounting')"/>
    </actions>

    <widgets>
        <!-- Freshness: reload if restored from the back/forward cache so a newly-added supplier always shows without F5. -->
        <render-mode><text type="html"><![CDATA[<script>window.addEventListener('pageshow',function(e){if(e.persisted){location.reload();}});</script>]]></text></render-mode>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Suppliers" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Everyone you buy from. Add a supplier, search the list, or open one to see their details and bills." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                <label text="Manage your supply chain partners and ensure ITC compliance via GSTIN tracking." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-x-sm">
                <container-dialog id="NewOrgDialog" button-text="Add Company" button-class="q-btn--flat bg-indigo-8 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a company as a supplier" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <!-- Same rich fields as Customers/Dashboard so Add behaves the same everywhere.
                             All fields except the name are optional. Role is fixed to Vendor on this screen. -->
                        <form-single name="NewOrgForm" transition="createOrganization">
                            <field name="organizationName"><default-field title="Business Name"><text-line size="60"/></default-field></field>
                            <field name="businessStructureEnumId"><default-field title="Business Structure">
                                <drop-down allow-empty="true">
                                    <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                                    <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                                </drop-down>
                            </default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                            <field name="gstRegistrationType"><default-field title="GST Registration">
                                <drop-down no-current-selected-key="Regular">
                                    <option key="Regular"/><option key="Composition"/>
                                    <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                                </drop-down>
                            </default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Create Business Vendor"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
                <container-dialog id="NewPersonDialog" button-text="Add Person" button-class="q-btn--flat bg-indigo-6 text-white" width="600">
                    <container style="q-pa-md">
                        <label text="Add a person as a supplier" type="h5" style="text-primary text-weight-bold q-mb-md"/>
                        <form-single name="NewPersonForm" transition="createPerson">
                            <field name="firstName"><default-field title="First Name"><text-line size="30"/></default-field></field>
                            <field name="lastName"><default-field title="Last Name"><text-line size="30"/></default-field></field>
                            <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                            <field name="countryCode"><default-field title="Country Code"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Phone"><text-line size="12"/></default-field></field>
                            <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                            <field name="tdsApplicable"><default-field title="TDS Applicable">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Create Individual Vendor"><submit class="q-btn--unelevated bg-primary text-white full-width q-mt-md"/></default-field></field>
                        </form-single>
                    </container>
                </container-dialog>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="FindVendorList" list="vendorList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendorList">
                    <search-form-inputs default-order-by="organizationName,firstName"/>
                    <econdition field-name="roleTypeId" operator="in" value="Supplier,Vendor"/>
                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                    <!-- Hide disabled contacts (consistent with the All-Contacts directory). -->
                    <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.Party" value-field="partyDetail">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="zenith.erp.india.IndiaGstin" value-field="gstinRec">
                        <field-map field-name="partyId" from="partyId"/>
                    </entity-find-one>
                </row-actions>

                <field name="partyId">
                    <header-field title="Party ID" show-order-by="true"><text-find/></header-field>
                    <default-field><link url="../EditContact" text="${partyId}" parameter-map="[partyId:partyId]" style="text-indigo-8 text-weight-bold"/></default-field>
                </field>

                <field name="organizationName"><header-field title="Company Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="firstName"><header-field title="First Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>
                <field name="lastName"><header-field title="Last Name Search"><text-find/></header-field><default-field><hidden/></default-field></field>

                <field name="name">
                    <header-field title="Vendor Name" show-order-by="true"/>
                    <default-field>
                        <!-- CT-041 / ZE-CONTACTS-007: Vendor Name opens the profile too (parity with the Customers list). -->
                        <link url="../EditContact" text="${organizationName ?: (((firstName ?: '') + ' ' + (lastName ?: '')).trim()) ?: 'Unknown'}" parameter-map="[partyId:partyId]" style="text-indigo-8 text-weight-medium zenith-contact-name"/>
                    </default-field>
                </field>

                <field name="partyTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="PtyOrganization" text="Organization"/>
                            <option key="PtyPerson" text="Person"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <label text="${partyTypeEnumId == 'PtyOrganization' ? 'Business' : 'Individual'}" type="span" style="zenith-badge warning"/>
                    </default-field>
                </field>

                <field name="gstin">
                    <header-field title="GSTIN (For ITC)"/>
                    <default-field>
                        <label text="${gstinRec?.gstin ?: 'Not Provided'}" type="span" style="${gstinRec?.gstin ? 'text-dark' : 'text-danger text-weight-bold'}"/>
                        <label text="GST registered" type="span" style="zenith-badge success q-ml-sm" condition="gstinRec?.gstin"/>
                        <label text="No ITC" type="span" style="zenith-badge danger q-ml-sm" condition="!gstinRec?.gstin"/>
                    </default-field>
                </field>
                
                <field name="pan">
                    <header-field title="PAN"/>
                    <default-field>
                        <label text="${partyDetail?.panNumber ?: '-'}" type="span"/>
                    </default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <link url="/apps/zenith/Purchase/FindPurchaseOrder" text="POs" icon="shopping_bag" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-primary q-mr-sm bg-white" parameter-map="[vendorPartyId:partyId]" link-type="anchor" condition="showPurchaseBtn"/>
                        <link url="/apps/zenith/Purchase/FindPurchaseInvoice" text="Bills" icon="receipt" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-warning q-mr-sm bg-white" parameter-map="[fromPartyId:partyId]" link-type="anchor" condition="showPurchaseBtn"/>
                        <link url="/apps/zenith/Accounting/Invoices" text="Ledger" icon="account_balance_wallet" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-secondary bg-white" parameter-map="[fromPartyId:partyId]" link-type="anchor" condition="showAccountingBtn"/>
                    </default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
