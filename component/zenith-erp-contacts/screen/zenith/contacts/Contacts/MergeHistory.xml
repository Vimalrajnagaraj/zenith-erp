<?xml version="1.0" encoding="UTF-8"?>
<!-- ZE-CONTACTS-MERGE-HIST: the complete merge-history view (the "View all merges" destination from the
     Merge Contacts page). Read-only audit list; org-scoped via PartyMergeHistoryView (surviving party's
     owner) so a tenant only ever sees ITS OWN merges. Hidden from the nav (reached via the link). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Merge History" default-menu-include="false">

    <actions>
        <service-call name="zenith.contacts.ContactServices.get#AuthorizedActiveOrganization" out-map="_contactOrg"/>
        <set field="activeOrg" from="_contactOrg?.activeOrgId ?: '__NO_ORGANIZATION__'"/>

        <!-- Full history for THIS org, most recent first, paginated. -->
        <entity-find entity-name="zenith.erp.contacts.PartyMergeHistoryView" list="mergeHistory">
            <search-form-inputs skip-fields="ownerPartyId" default-order-by="-mergedDate"/>
            <econdition field-name="ownerPartyId" from="activeOrg"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Merge History" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Every duplicate-contact merge for this organization, most recent first." type="p" style="text-grey-6 q-mt-xs q-mb-none"/>
            </container>
            <container style="zc-page-head__actions">
                <link url="../MergeContacts" text="Back to Merge Contacts" btn-type="secondary" style="zc-btn-back"/>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AllMergesList" list="mergeHistory" skip-form="true" paginate="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="survDetail">
                        <field-map field-name="partyId" from="survivingPartyId"/></entity-find-one>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="mergDetail">
                        <field-map field-name="partyId" from="mergedPartyId"/></entity-find-one>
                </row-actions>
                <field name="mergedDate"><default-field title="When"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="survivingPartyId"><default-field title="Kept">
                    <label text="${(survDetail?.organizationName ?: ((survDetail?.firstName?:'') + ' ' + (survDetail?.lastName?:'')).trim()) ?: survivingPartyId}" type="span"/>
                </default-field></field>
                <field name="mergedPartyId"><default-field title="Merged (disabled)">
                    <label text="${(mergDetail?.organizationName ?: ((mergDetail?.firstName?:'') + ' ' + (mergDetail?.lastName?:'')).trim()) ?: mergedPartyId}" type="span" style="text-grey-6"/>
                </default-field></field>
            </form-list>
            <label text="No merges yet." type="p" style="text-grey-5" condition="!mergeHistory"/>
        </container>
    </widgets>
</screen>
