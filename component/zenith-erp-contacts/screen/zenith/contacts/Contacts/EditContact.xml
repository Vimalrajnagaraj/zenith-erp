<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact" default-menu-index="2" default-menu-include="false">

    <parameter name="partyId" required="true"/>

    <transition name="updateContact">
        <service-call name="zenith.contacts.ContactServices.update#Contact"/>
        <default-response url="."/>
    </transition>
    <transition name="addGstin">
        <service-call name="zenith.contacts.ContactServices.add#ContactTaxRegistration"/>
        <default-response url="."/>
    </transition>
    <transition name="addTag">
        <service-call name="zenith.contacts.ContactServices.add#ContactTag"/>
        <default-response url="."/>
    </transition>
    <transition name="removeTag">
        <service-call name="zenith.contacts.ContactServices.remove#ContactTag"/>
        <default-response url="."/>
    </transition>
    <transition name="createPostalAddress">
        <service-call name="mantle.party.ContactServices.create#PostalAddress"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePostalAddress">
        <service-call name="mantle.party.ContactServices.update#PostalAddress"/>
        <default-response url="."/>
    </transition>
    <transition name="createEmailAddress">
        <service-call name="mantle.party.ContactServices.create#EmailAddress"/>
        <default-response url="."/>
    </transition>
    <transition name="createPhoneNumber">
        <service-call name="mantle.party.ContactServices.create#TelecomNumber"/>
        <default-response url="."/>
    </transition>
    <transition name="findContact"><default-response url="../FindContact"/></transition>

    <actions>
        <entity-find-one entity-name="mantle.party.Party" value-field="party"/>
        <entity-find-one entity-name="mantle.party.Person" value-field="person"/>
        <entity-find-one entity-name="mantle.party.Organization" value-field="organization"/>

        <entity-find entity-name="mantle.party.PartyRole" list="partyRoles">
            <econdition field-name="partyId"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.IndiaGstin" list="gstinList">
            <econdition field-name="partyId"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.contacts.PartyTag" list="tagList">
            <econdition field-name="partyId"/>
        </entity-find>

        <entity-find entity-name="mantle.party.contact.PartyContactMechInfo" list="emailList">
            <econdition field-name="partyId"/>
            <econdition field-name="contactMechTypeEnumId" value="CmtEmailAddress"/>
            <date-filter/>
            <order-by field-name="contactMechPurposeId"/>
        </entity-find>
        <entity-find entity-name="mantle.party.contact.PartyContactMechInfo" list="phoneList">
            <econdition field-name="partyId"/>
            <econdition field-name="contactMechTypeEnumId" value="CmtTelecomNumber"/>
            <date-filter/>
        </entity-find>
        <entity-find entity-name="mantle.party.contact.PartyContactMechPostalAddress" list="addressList">
            <econdition field-name="partyId"/>
            <date-filter/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.IndiaTdsSection" list="tdsSections">
            <order-by field-name="sectionCode"/>
        </entity-find>

        <!-- Sales History -->
        <entity-find entity-name="mantle.account.invoice.Invoice" list="invoiceList" limit="10">
            <econdition field-name="toPartyId" from="partyId"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>

        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="orderList" limit="10">
            <econdition field-name="customerPartyId" from="partyId"/>
            <econdition field-name="statusId" operator="not-in" value="OrderProposed,OrderRejected"/>
            <order-by field-name="-entryDate"/>
        </entity-find>

        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="quoteList" limit="10">
            <econdition field-name="customerPartyId" from="partyId"/>
            <econdition field-name="statusId" operator="in" value="OrderProposed,OrderRejected"/>
            <order-by field-name="-entryDate"/>
        </entity-find>

        <!-- Purchase History -->
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="poList" limit="10">
            <econdition field-name="vendorPartyId" from="partyId"/>
            <econdition field-name="statusId" operator="not-in" value="OrderProposed,OrderRejected"/>
            <order-by field-name="-entryDate"/>
        </entity-find>
        <entity-find entity-name="mantle.account.invoice.Invoice" list="payableInvoiceList" limit="10">
            <econdition field-name="fromPartyId" from="partyId"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>

        <set field="contactName" from="organization?.organizationName ?: ((person?.firstName ?: '') + ' ' + (person?.lastName ?: '')).trim()"/>
    </actions>

    <widgets>
        <link url="findContact" text="Back to Contacts" link-type="anchor" icon="arrow_back" class="q-btn--flat bg-grey-2 text-primary q-mb-md"/>

        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap full-width">
                <container style="row items-center no-wrap">
                    <container style="zenith-avatar q-mr-xl ${party.partyTypeEnumId == 'PtyOrganization' ? 'org' : ''}">
                        <label text="${contactName ? contactName.substring(0,1).toUpperCase() : '?'}" type="span"/>
                    </container>
                    <container style="column">
                        <label text="${contactName}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="ID: ${partyId} â€¢ ${party.partyTypeEnumId == 'PtyPerson' ? 'Person' : 'Organization'}" type="p" style="text-grey-7 text-body1 q-mt-xs"/>
                        
                        <container style="row q-mt-sm">
                            <section-iterate name="ProfileTagsList" list="tagList" entry="tagItem">
                                <widgets>
                                    <label text="${tagItem.tagName}" type="span" style="zenith-badge secondary q-mr-sm"/>
                                </widgets>
                            </section-iterate>
                            <section name="DisabledBadge" condition="party?.disabled == 'Y'"><widgets>
                                <label text="Disabled" type="span" style="zenith-badge warning"/>
                            </widgets></section>
                        </container>
                    </container>
                </container>

                <!-- Quick Actions -->
                <container style="row q-gutter-x-sm">
                    <link url="/vapps/zenith/sales/CreateQuotation" text="New Quote" parameter-map="[customerPartyId:partyId]" class="q-btn q-btn--outline bg-white text-primary text-weight-bold shadow-1"/>
                    <link url="/vapps/zenith/sales/CreateOrder" text="New Order" parameter-map="[customerPartyId:partyId]" class="q-btn q-btn--outline bg-white text-secondary text-weight-bold shadow-1"/>
                    <link url="/vapps/zenith/purchase/Purchase/EditRfq" text="New PO" parameter-map="[vendorPartyId:partyId]" class="q-btn q-btn--outline bg-white text-deep-orange text-weight-bold shadow-1"/>
                    <link url="/vapps/zenith/sales/CreateInvoice" text="New Invoice" parameter-map="[partyId:partyId]" class="q-btn q-btn--unelevated bg-indigo-8 text-white text-weight-bold shadow-2"/>
                </container>
            </container>
        </container>

        <!-- Main Content -->
        <container-row>
            <row-col lg="12">
                <container-box class="zenith-card"><box-header title="Comprehensive Contact Profile"/><box-body>
                                                                                <form-single name="ContactDetailForm" transition="updateContact" map="party">
                        <field name="partyId"><default-field><hidden/></default-field></field>

                        <field name="header1"><default-field title=" "><label text="Basic Details" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        
                        <section name="PersonSection" condition="party.partyTypeEnumId == 'PtyPerson'"><widgets>
                            <field name="firstName"><default-field><text-line size="30" default-value="${person?.firstName}"/></default-field></field>
                            <field name="lastName"><default-field><text-line size="30" default-value="${person?.lastName}"/></default-field></field>
                        </widgets></section>
                        <section name="OrgSection" condition="party.partyTypeEnumId == 'PtyOrganization'"><widgets>
                            <field name="organizationName"><default-field><text-line size="60" default-value="${organization?.organizationName}"/></default-field></field>
                        </widgets></section>

                        <field name="businessStructureEnumId"><default-field title="Business Structure">
                            <drop-down allow-empty="true">
                                <option key="Proprietorship"/><option key="Partnership"/><option key="LLP"/>
                                <option key="Pvt Ltd"/><option key="Public Ltd"/><option key="HUF"/><option key="Trust"/>
                            </drop-down>
                        </default-field></field>
                        <field name="disabled"><default-field title="Disabled">
                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                        </default-field></field>

                        <field name="header2"><default-field title=" "><label text="Tax Details (GST)" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        <field name="panNumber"><default-field title="PAN"><text-line size="10" maxlength="10"/></default-field></field>
                        <field name="gstRegistrationType"><default-field title="GST Registration">
                            <drop-down>
                                <option key="Regular"/><option key="Composition"/>
                                <option key="Unregistered"/><option key="SEZ"/><option key="Overseas"/>
                            </drop-down>
                        </default-field></field>
                        <field name="cinNumber"><default-field title="CIN (Corporate ID)"><text-line size="21"/></default-field></field>
                        <field name="tanNumber"><default-field title="TAN Number"><text-line size="10" maxlength="10"/></default-field></field>
                        <field name="tdsApplicable"><default-field title="TDS Applicable">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="defaultTdsSectionId"><default-field title="Default TDS Section">
                            <drop-down allow-empty="true">
                                <list-options list="tdsSections" key="${tdsSectionId}" text="${sectionCode} - ${description}"/>
                            </drop-down>
                        </default-field></field>

                        <field name="header3"><default-field title=" "><label text="Small Business (MSME) &amp; Payment Terms" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        <field name="msmeStatusEnumId"><default-field title="MSME Status">
                            <drop-down allow-empty="true">
                                <option key="Not Registered"/><option key="Micro"/><option key="Small"/><option key="Medium"/>
                            </drop-down>
                        </default-field></field>
                        <field name="msmeUdyamNumber"><default-field title="MSME Udyam No."><text-line size="20"/></default-field></field>
                        <field name="paymentTermLockDays"><default-field title="Mandatory Payment Days"><text-line size="3"/></default-field></field>

                        <field name="header4"><default-field title=" "><label text="Bank &amp; Payment Details" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        <field name="bankAccountName"><default-field title="Bank Account Name"><text-line size="40"/></default-field></field>
                        <field name="bankAccountNumber"><default-field title="Account Number"><text-line size="20"/></default-field></field>
                        <field name="bankIfscCode"><default-field title="IFSC Code"><text-line size="11"/></default-field></field>
                        <field name="upiVpa"><default-field title="UPI ID / VPA"><text-line size="30"/></default-field></field>
                        <field name="bankBeneficiaryStatus"><default-field title="Beneficiary Status">
                            <drop-down allow-empty="true">
                                <option key="Pending"/><option key="Verified"/><option key="Rejected"/>
                            </drop-down>
                        </default-field></field>

                        <field name="header5"><default-field title=" "><label text="Licenses &amp; ID Proof" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        <field name="fssaiLicense"><default-field title="FSSAI License"><text-line size="14"/></default-field></field>
                        <field name="drugLicense"><default-field title="Drug License"><text-line size="20"/></default-field></field>
                        <field name="tradeLicense"><default-field title="Trade License"><text-line size="20"/></default-field></field>

                        <field name="header6"><default-field title=" "><label text="Credit &amp; Money Settings" type="h6" style="text-primary q-mt-md"/></default-field></field>
                        <field name="creditLimit"><default-field title="Credit Limit (${currSymbol})"><text-line size="15"/></default-field></field>
                        <field name="creditDays"><default-field title="Credit Days"><text-line size="5"/></default-field></field>
                        <field name="openingBalance"><default-field title="Opening Balance (${currSymbol})"><text-line size="15"/></default-field></field>
                        <field name="priceListId"><default-field title="Price List">
                            <drop-down allow-empty="true">
                                <option key="Retail"/><option key="Wholesale"/><option key="Distributor"/>
                            </drop-down>
                        </default-field></field>

                        <field name="submitButton"><default-field title="Save Contact Profile"><submit class="q-btn--unelevated bg-primary text-white"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            </container-row>

        <container-row>
            <row-col lg="6">
                <container-box class="zenith-card"><box-header title="GSTIN Records"/><box-toolbar>
                    <container-dialog id="AddGstinDialog" button-text="Add GST Number" button-class="q-btn--flat bg-primary text-white">
                        <form-single name="AddGstinForm" transition="addGstin">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="gstin"><default-field title="GSTIN"><text-line size="15" maxlength="15"/></default-field></field>
                            <field name="gstRegistrationType"><default-field title="Type">
                                <drop-down no-current-selected-key="Regular">
                                    <option key="Regular"/><option key="Composition"/><option key="SEZ"/>
                                </drop-down>
                            </default-field></field>
                            <field name="stateCode"><default-field title="State">
                                <drop-down allow-empty="true">
                                    <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <form-list name="GstinListForm" list="gstinList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                        <field name="gstin"><default-field title="GSTIN"><display/></default-field></field>
                        <field name="stateCode"><default-field title="State"><display/></default-field></field>
                        <field name="gstRegistrationType"><default-field title="Type"><display/></default-field></field>
                        <field name="isCompositionScheme"><default-field title="Composition">
                            <display text="${isCompositionScheme == 'Y' ? 'Yes' : 'No'}"/>
                        </default-field></field>
                        <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </box-body></container-box>

                <container-box class="zenith-card"><box-header title="Tags"/><box-toolbar>
                    <container-dialog id="AddTagDialog" button-text="Add Tag" button-class="q-btn--flat bg-primary text-white">
                        <form-single name="AddTagForm" transition="addTag">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="tagName"><default-field title="Tag"><text-line size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <section name="TagsSection" condition="tagList"><widgets>
                        <form-list name="TagListForm" list="tagList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <field name="tagName"><default-field title="Tag"><display/></default-field></field>
                            <field name="removeButton"><default-field title="">
                                <link url="removeTag" text="Remove" icon="delete" class="text-negative"
                                      parameter-map="[partyId:partyId, tagName:tagName]"/>
                            </default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                    </widgets><fail-widgets>
                        <label text="No labels added yet." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>
            </row-col>

            <!-- Sales History Section -->
            <row-col lg="6">
                <!-- Recent Invoices -->
                <container-box class="zenith-card"><box-header title="Recent Invoices"/><box-body>
                    <section name="InvoicesSection" condition="invoiceList"><widgets>
                        <form-list name="ProfileInvoiceList" list="invoiceList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <row-actions>
                                <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                            </row-actions>
                            <field name="invoiceId">
                                <header-field title="Invoice No."/>
                                <default-field><link url="/vapps/zenith/sales/EditInvoice" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" class="text-weight-bold"/></default-field>
                            </field>
                            <field name="invoiceDate"><header-field title="Date"/><default-field><display format="yyyy-MM-dd"/></default-field></field>
                            <field name="invoiceTotal"><header-field title="Total"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field><display text="${statusItem?.description}"/></default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                    </widgets><fail-widgets>
                        <label text="No invoices yet." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>

                <!-- Recent Orders -->
                <container-box class="zenith-card"><box-header title="Recent Sales Orders"/><box-body>
                    <section name="OrdersSection" condition="orderList"><widgets>
                        <form-list name="ProfileOrderList" list="orderList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <row-actions>
                                <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                            </row-actions>
                            <field name="orderId">
                                <header-field title="Order No."/>
                                <default-field><link url="/vapps/zenith/sales/EditOrder" text="${displayId ?: orderId}" parameter-map="[orderId:orderId]" class="text-weight-bold"/></default-field>
                            </field>
                            <field name="entryDate"><header-field title="Date"/><default-field><display format="yyyy-MM-dd"/></default-field></field>
                            <field name="grandTotal"><header-field title="Total"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field><display text="${statusItem?.description}"/></default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                    </widgets><fail-widgets>
                        <label text="No orders found." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>

                <!-- Recent Quotations -->
                <container-box class="zenith-card"><box-header title="Recent Quotations"/><box-body>
                    <section name="QuotesSection" condition="quoteList"><widgets>
                        <form-list name="ProfileQuoteList" list="quoteList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <row-actions>
                                <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                            </row-actions>
                            <field name="orderId">
                                <header-field title="Quote No."/>
                                <default-field><link url="/vapps/zenith/sales/EditQuotation" text="${displayId ?: orderId}" parameter-map="[orderId:orderId]" class="text-weight-bold"/></default-field>
                            </field>
                            <field name="entryDate"><header-field title="Date"/><default-field><display format="yyyy-MM-dd"/></default-field></field>
                            <field name="grandTotal"><header-field title="Total"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field><display text="${statusItem?.description}"/></default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                    </widgets><fail-widgets>
                        <label text="No quotations found." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>

                <!-- Recent Purchase Orders -->
                <container-box class="zenith-card"><box-header title="Recent Purchase Orders"/><box-body>
                    <section name="PurchaseOrdersSection" condition="poList"><widgets>
                        <form-list name="ProfilePoList" list="poList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <row-actions>
                                <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                            </row-actions>
                            <field name="orderId">
                                <header-field title="PO No."/>
                                <default-field><link url="/vapps/zenith/purchase/Purchase/EditRfq" text="${displayId ?: orderId}" parameter-map="[orderId:orderId]" class="text-weight-bold"/></default-field>
                            </field>
                            <field name="entryDate"><header-field title="Date"/><default-field><display format="yyyy-MM-dd"/></default-field></field>
                            <field name="grandTotal"><header-field title="Total"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field><display text="${statusItem?.description}"/></default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No purchase orders found." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>

                <!-- Recent Vendor Bills -->
                <container-box class="zenith-card"><box-header title="Recent Vendor Bills"/><box-body>
                    <section name="VendorBillsSection" condition="payableInvoiceList"><widgets>
                        <form-list name="ProfilePayableInvoiceList" list="payableInvoiceList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                            <row-actions>
                                <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                            </row-actions>
                            <field name="invoiceId">
                                <header-field title="Bill No."/>
                                <default-field><link url="/vapps/zenith/purchase/Purchase/EditPurchaseInvoice" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" class="text-weight-bold"/></default-field>
                            </field>
                            <field name="invoiceDate"><header-field title="Date"/><default-field><display format="yyyy-MM-dd"/></default-field></field>
                            <field name="invoiceTotal"><header-field title="Total"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                            <field name="statusId"><header-field title="Status"/><default-field><display text="${statusItem?.description}"/></default-field></field>
                            <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No vendor bills found." type="p" style="text-grey"/>
                    </fail-widgets></section>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="4">
                <container-box><box-header title="Email Addresses"/><box-toolbar>
                    <container-dialog id="AddEmailDialog" button-text="Add Email">
                        <form-single name="AddEmailForm" transition="createEmailAddress">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="emailAddress"><default-field><text-line size="40"/></default-field></field>
                            <field name="contactMechPurposeId"><default-field title="Purpose">
                                <drop-down no-current-selected-key="EmailPrimary">
                                    <option key="EmailPrimary" text="Primary"/>
                                    <option key="EmailBilling" text="Billing"/>
                                    <option key="EmailShipping" text="Shipping"/>
                                    <option key="EmailOther" text="Other"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <form-list name="EmailListForm" list="emailList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                        <field name="infoString"><default-field title="Email"><display/></default-field></field>
                        <field name="contactMechPurposeId"><default-field title="Purpose"><display/></default-field></field>
                        <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </box-body></container-box>
            </row-col>
            <row-col lg="4">
                <container-box><box-header title="Phone Numbers"/><box-toolbar>
                    <container-dialog id="AddPhoneDialog" button-text="Add Phone">
                        <form-single name="AddPhoneForm" transition="createPhoneNumber">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="countryCode"><default-field title="Country"><text-line size="4" default-value="91"/></default-field></field>
                            <field name="contactNumber"><default-field title="Number"><text-line size="12"/></default-field></field>
                            <field name="contactMechPurposeId"><default-field title="Purpose">
                                <drop-down no-current-selected-key="PhonePrimary">
                                    <option key="PhonePrimary" text="Primary"/>
                                    <option key="PhoneBilling" text="Billing"/>
                                    <option key="PhoneShipping" text="Shipping"/>
                                    <option key="PhoneMobile" text="Mobile"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <form-list name="PhoneListForm" list="phoneList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                        <field name="countryCode"><default-field title="Code"><display text="+${countryCode}"/></default-field></field>
                        <field name="contactNumber"><default-field title="Number"><display/></default-field></field>
                        <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </box-body></container-box>
            </row-col>
            <row-col lg="4">
                <container-box><box-header title="Addresses"/><box-toolbar>
                    <container-dialog id="AddAddressDialog" button-text="Add Address">
                        <form-single name="AddAddressForm" transition="createPostalAddress">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="address1"><default-field title="Address Line 1"><text-line size="40"/></default-field></field>
                            <field name="address2"><default-field title="Address Line 2"><text-line size="40"/></default-field></field>
                            <field name="city"><default-field><text-line size="20"/></default-field></field>
                            <field name="postalCode"><default-field title="PIN Code"><text-line size="6" maxlength="6"/></default-field></field>
                            <field name="stateProvinceGeoId"><default-field title="State">
                                <drop-down allow-empty="true">
                                    <entity-options key="${toGeoId}" text="${geoName}">
                                        <entity-find entity-name="moqui.basic.GeoAssocAndToDetail">
                                            <econdition field-name="geoId" from="companyCountry"/>
                                            <econdition field-name="geoAssocTypeEnumId" value="GAT_REGIONS"/>
                                            <order-by field-name="geoName"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field></field>
                            <field name="countryGeoId"><default-field><hidden default-value="${companyCountry}"/></default-field></field>
                            <field name="contactMechPurposeId"><default-field title="Purpose">
                                <drop-down no-current-selected-key="PostalPrimary">
                                    <option key="PostalPrimary" text="Primary"/>
                                    <option key="PostalBilling" text="Billing"/>
                                    <option key="PostalShipping" text="Shipping"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <form-list name="AddressListForm" list="addressList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                        <field name="address1"><default-field title="Address"><display text="${address1}${address2 ? ', ' + address2 : ''}"/></default-field></field>
                        <field name="cityState"><default-field title="City/State"><display text="${city ?: ''}, ${postalCode ?: ''}"/></default-field></field>
                        <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-box><box-header title="Roles"/><box-body>
            <form-list name="RoleListForm" list="partyRoles" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="roleTypeId"><default-field title="Role">
                    <display-entity entity-name="mantle.party.RoleType" text="${description}"/>
                </default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </box-body></container-box>
    </widgets>
</screen>
