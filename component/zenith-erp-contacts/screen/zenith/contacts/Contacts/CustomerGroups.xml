<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Customer Groups" default-menu-index="5">

    <transition name="editGroup"><default-response url="../EditCustomerGroup"/></transition>
    <transition name="createGroup">
        <service-call name="zenith.contacts.ContactServices.create#CustomerGroup"/>
        <default-response url="../EditCustomerGroup"/>
    </transition>

    <!-- ZE-CONTACTS-027 / CT-166: real XLSX export (Moqui 4.0 has no xlsx render mode — see
         build#ListXlsx). Exports the org-scoped customer groups; org isolation via organizationPartyId. Read-only. -->
    <transition name="export" read-only="true">
        <parameter name="format"/>
        <actions>
            <entity-find entity-name="zenith.erp.contacts.CustomerGroup" list="groups">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <order-by field-name="groupName"/>
            </entity-find>
            <script><![CDATA[
                def rows = []
                for (g in groups) {
                    def typeDesc = ''
                    if (g.groupTypeEnumId) {
                        def en = ec.entity.find("moqui.basic.Enumeration").condition("enumId", g.groupTypeEnumId).one()
                        typeDesc = en ? (en.description ?: g.groupTypeEnumId) : g.groupTypeEnumId
                    }
                    rows.add([ (g.groupName ?: ''), typeDesc,
                               (g.defaultDiscountPercent != null ? g.defaultDiscountPercent.toString() : ''),
                               (g.creditTermDays != null ? g.creditTermDays.toString() : ''),
                               (g.creditLimitDefault != null ? g.creditLimitDefault.toString() : ''),
                               (g.paymentTerms ?: ''), (g.isActive ?: '') ])
                }
                context.expHeaders = ['Group', 'Type', 'Discount %', 'Credit Days', 'Credit Limit', 'Terms', 'Active']
                context.expRows = rows
            ]]></script>
            <if condition="format == 'csv'">
                <service-call name="zenith.contacts.ContactServices.build#ListCsv"
                              in-map="[headers:expHeaders, rows:expRows]" out-map="context"/>
                <script><![CDATA[
                    ec.web.response.setContentType("text/csv; charset=utf-8")
                    ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Customer_Groups.csv\"")
                    def os = ec.web.response.outputStream
                    os.write(csvText.getBytes("UTF-8"))
                    os.flush()
                ]]></script>
                <else>
                    <service-call name="zenith.contacts.ContactServices.build#ListXlsx"
                                  in-map="[sheetName:'Customer Groups', headers:expHeaders, rows:expRows]" out-map="context"/>
                    <script><![CDATA[
                        ec.web.response.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
                        ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"Customer_Groups.xlsx\"")
                        def os = ec.web.response.outputStream
                        os.write(xlsxBase64.decodeBase64())
                        os.flush()
                    ]]></script>
                </else>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.contacts.CustomerGroup" list="groups">
            <search-form-inputs default-order-by="groupName"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <!-- ZE-CG-LIST: default the page size to 20 (mockup) unless the user picks another (form-list reads pageSize
             from the request params, so seed it there when absent). -->
        <script><![CDATA[
            if (ec.web != null) {
                def p = ec.web.parameters
                def cur = p?.pageSize
                if (cur == null || cur.toString().trim().isEmpty()) { ec.context.pageSize = 20; try { p.put("pageSize", "20") } catch (Throwable _t) { } }
            }
        ]]></script>
    </actions>

    <widgets>
        <!-- ZE-CG-HEAD: header + action bar consolidated into ONE compact row (was a `row justify-between` /apps
             no-op cramming title/description/button together, plus a separate colored-export row below). Mirrors the
             Customers header (.zc-page-head + .cust-actions): black title, filled "+ Add Group" primary CTA, outlined
             CSV/Excel export buttons. -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Customer Groups" type="h3" style="cust-title text-weight-bold q-my-none"/>
                <label text="Bundle customers together (e.g. Wholesale, VIP) so they all get the same prices, discounts or credit terms." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
            </container>
            <container style="cust-actions">
              <section name="CustomerGroups_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                <!-- Filled "+ Add Group" primary CTA — single create action (no Person/Company split like Customers)
                     so no dropdown arrow. Proxy-clicks the hidden real CreateGroup dialog trigger (cpe-tabs.js matches
                     by button text); container-dialog ignores button-class so it can't be styled directly. -->
                <render-mode><text type="html,qvt,vuet"><![CDATA[
                    <div class="cust-newcust"><button type="button" class="cust-nc-solo" data-nctext="Add Group"><span class="material-icons cust-nc-plus">add</span>Add Group</button></div>
                ]]></text></render-mode>
                <container style="cust-nc-src">
                <container-dialog id="CreateGroup" button-text="Add Group" type="success">
                <form-single name="CreateGroupForm" transition="createGroup">
                    <field name="groupName"><default-field title="Group Name"><text-line size="30"/></default-field></field>
                    <field name="groupTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="CustomerGroupType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <!-- ZE-PRC-019: list the org's real price lists (custom Parent/Child lists), replacing the old
                         hardcoded Retail/Wholesale/Distributor placeholders. -->
                    <field name="priceListId"><default-field title="Price List">
                        <drop-down allow-empty="true">
                            <entity-options key="${priceListId}" text="${priceListName}">
                                <entity-find entity-name="zenith.erp.pricing.PriceList">
                                    <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <econdition field-name="isActive" value="Y"/>
                                    <order-by field-name="priceListName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                    <field name="defaultDiscountPercent"><default-field title="Default Discount %"><text-line size="8"/></default-field></field>
                    <field name="creditTermDays"><default-field title="Credit Term (days)"><text-line size="8"/></default-field></field>
                    <field name="creditLimitDefault"><default-field title="Default Credit Limit"><text-line size="12"/></default-field></field>
                    <field name="paymentTerms"><default-field title="Payment Terms"><text-line size="25"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
                </container-dialog>
                </container>
                </widgets>
              </section>
              <!-- ZE-CONTACTS-027/025: CSV/Excel export via the shared export transition (the native show-csv-button
                   dropped the Group name and leaked the title/description into the header). Outlined download buttons
                   (.cust-export), same row as the CTA. Outside the write section so read-only users can export too. -->
              <link url="export" text="Export to CSV" parameter-map="[format:'csv']" link-type="anchor" target-window="_blank" style="cust-export"/>
              <link url="export" text="Export to Excel" parameter-map="[format:'xlsx']" link-type="anchor" target-window="_blank" style="cust-export"/>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md sup-compact">
            <form-list name="GroupsForm" list="groups" skip-form="true" header-dialog="true"
                       select-columns="true" show-page-size="true">
                <!-- ZE-CG-LIST: per-row display — avatar initial+hue (by group id), type description + badge colour. -->
                <row-actions>
                    <script><![CDATA[
                        def gn = (groupName ?: '').trim()
                        avInitial = gn ? gn.substring(0,1).toUpperCase() : '?'
                        def _pal = ['a','b','c','d','e','f']
                        def gid = (customerGroupId ?: '').toString()
                        avHue = _pal[((gid.hashCode() % _pal.size()) + _pal.size()) % _pal.size()]
                        typeDesc = ''
                        if (groupTypeEnumId) {
                            def en = ec.entity.find("moqui.basic.Enumeration").condition("enumId", groupTypeEnumId).useCache(true).one()
                            typeDesc = en ? (en.description ?: groupTypeEnumId) : groupTypeEnumId
                        }
                        // Colour common type names per the mockup (Wholesale/Premium=green, VIP/Distributor=purple,
                        // Retail=red, Default/General=grey); hash any other type to a stable palette colour.
                        def _tl = typeDesc.toLowerCase()
                        def _bpal = ['sup-b-green','sup-b-purple','sup-b-red','sup-b-grey']
                        if (!typeDesc) typeBadge = 'sup-b-grey'
                        else if (_tl.contains('wholesale') || _tl.contains('premium')) typeBadge = 'sup-b-green'
                        else if (_tl.contains('vip') || _tl.contains('distributor')) typeBadge = 'sup-b-purple'
                        else if (_tl.contains('retail')) typeBadge = 'sup-b-red'
                        else if (_tl.contains('default') || _tl.contains('general')) typeBadge = 'sup-b-grey'
                        else typeBadge = _bpal[((typeDesc.hashCode() % _bpal.size()) + _bpal.size()) % _bpal.size()]
                        isActiveYes = (isActive != 'N')
                        // Discount shown as "5%" (mockup); empty cells fall back to a muted "—" placeholder in the
                        // fields below — NEVER a fabricated number (constraint #2).
                        discDisp = (defaultDiscountPercent != null) ? (ec.l10n.format(defaultDiscountPercent, '#0.##') + '%') : ''
                    ]]></script>
                </row-actions>
                <field name="groupName"><header-field title="Group Name" show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Group Name">
                        <container style="sup-namecell">
                            <label text="${avInitial}" type="span" style="sup-avatar sup-av-${avHue}"/>
                            <container style="sup-nametext">
                                <link url="editGroup" text="${groupName}" parameter-map="[customerGroupId:customerGroupId]" link-type="anchor" style="sup-name zenith-contact-name"/>
                                <label text="ID: ${customerGroupId}" type="span" style="sup-id"/>
                            </container>
                        </container>
                    </default-field></field>
                <field name="groupTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="CustomerGroupType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <label text="${typeDesc}" type="span" style="sup-badge ${typeBadge}" condition="typeDesc"/>
                        <label text="—" type="span" style="text-grey-5" condition="!typeDesc"/>
                    </default-field></field>
                <!-- ZE-CG-LIST: real values via <display> (keeps Indian grouping); a muted "—" placeholder renders
                     ONLY when the value is genuinely null so sparse rows read as intentional, never fabricated. -->
                <field name="defaultDiscountPercent"><default-field title="Discount %">
                    <label text="${discDisp}" type="span" condition="defaultDiscountPercent != null"/>
                    <label text="—" type="span" style="text-grey-5" condition="defaultDiscountPercent == null"/>
                </default-field></field>
                <field name="creditTermDays"><default-field title="Credit Days">
                    <display/>
                    <label text="—" type="span" style="text-grey-5" condition="creditTermDays == null"/>
                </default-field></field>
                <field name="creditLimitDefault"><default-field title="Credit Limit (₹)">
                    <display format="#,##0.00"/>
                    <label text="—" type="span" style="text-grey-5" condition="creditLimitDefault == null"/>
                </default-field></field>
                <field name="paymentTerms"><default-field title="Terms">
                    <display/>
                    <label text="—" type="span" style="text-grey-5" condition="!paymentTerms"/>
                </default-field></field>
                <field name="isActive"><default-field title="Active">
                    <label text="${isActiveYes ? 'Yes' : 'No'}" type="span" style="sup-badge ${isActiveYes ? 'sup-b-green' : 'sup-b-grey'}"/>
                </default-field></field>
                <!-- ZE-CG-LIST: Edit action (opens EditCustomerGroup). No ⋮ overflow — Edit is the only wired
                     per-row action (an empty overflow would be dead UI). -->
                <field name="actions"><header-field title="Actions"/>
                    <default-field>
                        <link url="editGroup" text="Edit" icon="edit" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-primary bg-white" parameter-map="[customerGroupId:customerGroupId]" link-type="anchor" condition="modCanWrite"/>
                    </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
