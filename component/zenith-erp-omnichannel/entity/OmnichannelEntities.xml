<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Fulfillment Option: defines how an order can be fulfilled -->
    <entity entity-name="FulfillmentOption" package="zenith.erp.omnichannel" short-alias="FulfillmentOption">
        <field name="fulfillmentOptionId" type="id" is-pk="true"/>
        <field name="optionName" type="text-medium"/>
        <field name="fulfillmentTypeEnumId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="requiresPickup" type="text-indicator" default="'N'"/>
        <field name="requiresShipping" type="text-indicator" default="'N'"/>
        <field name="estimatedMinutes" type="number-integer"/>
        <field name="description" type="text-long"/>
        <relationship type="one" title="FulfillmentType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="fulfillmentTypeEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="FulfillmentType" description="Fulfillment Type"/>
            <moqui.basic.Enumeration enumId="FtShipToHome" enumTypeId="FulfillmentType" description="Ship to Home" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="FtBopis" enumTypeId="FulfillmentType" description="Buy Online Pick Up In Store" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="FtCurbside" enumTypeId="FulfillmentType" description="Curbside Pickup" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="FtShipFromStore" enumTypeId="FulfillmentType" description="Ship From Store" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="FtEndlessAisle" enumTypeId="FulfillmentType" description="Endless Aisle" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="FtSameDay" enumTypeId="FulfillmentType" description="Same Day Delivery" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- Store Inventory Visibility: near-real-time stock per store -->
    <entity entity-name="StoreInventoryVisibility" package="zenith.erp.omnichannel" short-alias="StoreInventoryVisibility">
        <field name="storeId" type="id" is-pk="true"/>
        <field name="productId" type="id" is-pk="true"/>
        <field name="availableQuantity" type="number-decimal"/>
        <field name="reservedQuantity" type="number-decimal" default="0"/>
        <field name="safetyStock" type="number-decimal" default="0"/>
        <field name="sellableQuantity" type="number-decimal"/>
        <field name="lastSyncTime" type="date-time"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
    </entity>

    <!-- Pickup Slot: time windows for BOPIS / curbside -->
    <entity entity-name="PickupSlot" package="zenith.erp.omnichannel" short-alias="PickupSlot">
        <field name="pickupSlotId" type="id" is-pk="true"/>
        <field name="storeId" type="id"/>
        <field name="slotDate" type="date"/>
        <field name="timeFrom" type="time"/>
        <field name="timeTo" type="time"/>
        <field name="maxOrders" type="number-integer" default="10"/>
        <field name="bookedOrders" type="number-integer" default="0"/>
        <field name="isAvailable" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
    </entity>

    <!-- Store Pick Order: in-store pick assignment for BOPIS/SFS -->
    <entity entity-name="StorePickOrder" package="zenith.erp.omnichannel" short-alias="StorePickOrder">
        <field name="pickOrderId" type="id" is-pk="true"/>
        <field name="orderId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="pickupSlotId" type="id"/>
        <field name="pickerPartyId" type="id"/>
        <field name="fulfillmentTypeEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="assignedDate" type="date-time"/>
        <field name="pickedDate" type="date-time"/>
        <field name="readyDate" type="date-time"/>
        <field name="collectedDate" type="date-time"/>
        <field name="customerNotified" type="text-indicator" default="'N'"/>
        <field name="customerName" type="text-medium"/>
        <field name="customerPhone" type="text-short"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
        <relationship type="one" related="zenith.erp.omnichannel.PickupSlot" short-alias="slot"/>
        <relationship type="one" title="StorePickOrder" related="moqui.basic.StatusItem" short-alias="status">
            <key-map field-name="statusId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="StorePickOrder" description="Store Pick Order Status"/>
            <moqui.basic.StatusItem statusId="SpPending" statusTypeId="StorePickOrder" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SpAssigned" statusTypeId="StorePickOrder" description="Assigned" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SpPicking" statusTypeId="StorePickOrder" description="Picking" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SpReady" statusTypeId="StorePickOrder" description="Ready for Pickup" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="SpCollected" statusTypeId="StorePickOrder" description="Collected" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="SpShipped" statusTypeId="StorePickOrder" description="Shipped" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="SpCancelled" statusTypeId="StorePickOrder" description="Cancelled" sequenceNum="7"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpPending" toStatusId="SpAssigned" transitionName="Assign"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpAssigned" toStatusId="SpPicking" transitionName="Start Picking"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpPicking" toStatusId="SpReady" transitionName="Ready"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpReady" toStatusId="SpCollected" transitionName="Collected"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpReady" toStatusId="SpShipped" transitionName="Ship"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpPending" toStatusId="SpCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SpAssigned" toStatusId="SpCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- Store Pick Order Item -->
    <entity entity-name="StorePickOrderItem" package="zenith.erp.omnichannel" short-alias="StorePickOrderItem">
        <field name="pickOrderId" type="id" is-pk="true"/>
        <field name="pickItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="orderedQuantity" type="number-decimal"/>
        <field name="pickedQuantity" type="number-decimal" default="0"/>
        <field name="substituteProductId" type="id"/>
        <field name="substituteReason" type="text-medium"/>
        <relationship type="one" related="zenith.erp.omnichannel.StorePickOrder" short-alias="pickOrder"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
    </entity>

    <!-- Channel Configuration: per-channel settings -->
    <entity entity-name="ChannelConfiguration" package="zenith.erp.omnichannel" short-alias="ChannelConfiguration">
        <field name="channelId" type="id" is-pk="true"/>
        <field name="channelName" type="text-medium"/>
        <field name="channelTypeEnumId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="defaultFulfillmentTypeEnumId" type="id"/>
        <field name="defaultStoreId" type="id"/>
        <field name="apiEndpoint" type="text-long"/>
        <field name="syncFrequencyMinutes" type="number-integer"/>
        <relationship type="one" title="ChannelType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="channelTypeEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ChannelType" description="Sales Channel Type"/>
            <moqui.basic.Enumeration enumId="CtPosInStore" enumTypeId="ChannelType" description="POS In-Store" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CtWebsite" enumTypeId="ChannelType" description="Website" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CtMobileApp" enumTypeId="ChannelType" description="Mobile App" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CtMarketplace" enumTypeId="ChannelType" description="Marketplace" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="CtSocialMedia" enumTypeId="ChannelType" description="Social Media" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="CtCallCenter" enumTypeId="ChannelType" description="Call Center" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="CtWholesale" enumTypeId="ChannelType" description="Wholesale" sequenceNum="7"/>
        </seed-data>
    </entity>

    <!-- View: StorePickOrderDetail -->
    <view-entity entity-name="StorePickOrderDetail" package="zenith.erp.omnichannel">
        <member-entity entity-alias="SPO" entity-name="zenith.erp.omnichannel.StorePickOrder"/>
        <member-entity entity-alias="ST" entity-name="zenith.erp.stores.Store" join-from-alias="SPO">
            <key-map field-name="storeId"/></member-entity>
        <member-entity entity-alias="PS" entity-name="zenith.erp.omnichannel.PickupSlot" join-from-alias="SPO" join-optional="true">
            <key-map field-name="pickupSlotId"/></member-entity>
        <alias-all entity-alias="SPO"/>
        <alias entity-alias="ST" name="storeName" field="storeName"/>
        <alias entity-alias="ST" name="storeCode" field="storeCode"/>
        <alias entity-alias="PS" name="slotDate" field="slotDate"/>
        <alias entity-alias="PS" name="timeFrom" field="timeFrom"/>
        <alias entity-alias="PS" name="timeTo" field="timeTo"/>
    </view-entity>

</entities>
