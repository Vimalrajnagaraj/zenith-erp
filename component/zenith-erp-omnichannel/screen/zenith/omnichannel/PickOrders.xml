<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pick Orders" default-menu-index="2">

    <transition name="editPickOrder"><default-response url="../EditPickOrder"/></transition>
    <transition name="createPickOrder">
        <service-call name="zenith.omnichannel.OmnichannelServices.create#StorePickOrder"/>
        <default-response url="../EditPickOrder"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.omnichannel.StorePickOrderDetail" list="pickOrders">
            <search-form-inputs default-order-by="-assignedDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Pick Orders" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreatePickOrder" button-text="New Pick Order" type="success">
                <form-single name="CreatePickOrderForm" transition="createPickOrder">
                    <field name="orderId"><default-field title="Order ID"><text-line size="15"/></default-field></field>
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store">
                                <econdition field-name="statusId" value="StActive"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="fulfillmentTypeEnumId"><default-field title="Fulfillment Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="FulfillmentType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="customerName"><default-field><text-line size="20"/></default-field></field>
                    <field name="customerPhone"><default-field><text-line size="15"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <link url="." text="Generate Optimized Pick Path" icon="glyphicon glyphicon-random" class="btn btn-warning q-ml-sm" tooltip="Calculate shortest walking distance for warehouse workers based on Bin Sequencing"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Pick Orders..." style="display:none"></span>]]></text></render-mode>
            <form-list name="PickOrdersForm" list="pickOrders" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="pickOrderId"><default-field title="Pick #">
                    <link url="editPickOrder" text="${pickOrderId}" parameter-map="[pickOrderId:pickOrderId]"/>
                </default-field></field>
                <field name="orderId"><default-field title="Order"><display/></default-field></field>
                <field name="storeName"><default-field title="Store"><display/></default-field></field>
                <field name="fulfillmentTypeEnumId"><default-field title="Fulfillment">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                <field name="slotDate"><default-field title="Pickup Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="timeFrom"><default-field title="Slot"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="SpPending" text="Pending"/><option key="SpAssigned" text="Assigned"/>
                        <option key="SpPicking" text="Picking"/><option key="SpReady" text="Ready"/>
                        <option key="SpCollected" text="Collected"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <field name="assignedDate"><header-field show-order-by="true"/>
                    <default-field title="Created"><display format="dd-MMM HH:mm"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
