<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pickup Slots" default-menu-index="3">

    <transition name="createSlots">
        <service-call name="zenith.omnichannel.OmnichannelServices.create#PickupSlots"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.omnichannel.PickupSlot" list="slots">
            <search-form-inputs default-order-by="-slotDate,timeFrom"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Pickup Slots" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="GenerateSlots" button-text="Generate Slots" type="success">
                <form-single name="GenerateSlotsForm" transition="createSlots">
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store">
                                <econdition field-name="statusId" value="StActive"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="slotDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="startHour"><default-field title="Start Hour"><text-line size="3" default-value="9"/></default-field></field>
                    <field name="endHour"><default-field title="End Hour"><text-line size="3" default-value="21"/></default-field></field>
                    <field name="slotDurationMinutes"><default-field title="Slot Duration (min)"><text-line size="4" default-value="60"/></default-field></field>
                    <field name="maxOrdersPerSlot"><default-field title="Max Orders/Slot"><text-line size="4" default-value="10"/></default-field></field>
                    <field name="submitBtn"><default-field title="Generate"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="SlotsForm" list="slots" skip-form="true" header-dialog="true" select-columns="true">
                <field name="storeId"><default-field title="Store">
                    <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                </default-field></field>
                <field name="slotDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="timeFrom"><default-field title="From"><display/></default-field></field>
                <field name="timeTo"><default-field title="To"><display/></default-field></field>
                <field name="maxOrders"><default-field title="Max"><display/></default-field></field>
                <field name="bookedOrders"><default-field title="Booked"><display/></default-field></field>
                <field name="isAvailable"><default-field title="Available"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
