<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <service-call name="zenith.omnichannel.OmnichannelServices.get#OmnichannelDashboard" out-map="dashboard"/>
        <entity-find entity-name="zenith.erp.omnichannel.StorePickOrderDetail" list="recentPicks" limit="10">
            <order-by field-name="-assignedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Omnichannel Dashboard" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Pending Picks" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.pendingPicks ?: 0}" type="h3" style="text-warning text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Ready for Pickup" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.readyForPickup ?: 0}" type="h3" style="text-info text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Completed Today" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.completedToday ?: 0}" type="h3" style="text-positive text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Today's Slots" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.todaySlots?.size() ?: 0}" type="h3" style="text-primary text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Pick Orders" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentPicksForm" list="recentPicks" skip-form="true">
                <field name="pickOrderId"><default-field title="Pick #">
                    <link url="../EditPickOrder" text="${pickOrderId}" parameter-map="[pickOrderId:pickOrderId]"/>
                </default-field></field>
                <field name="orderId"><default-field title="Order"><display/></default-field></field>
                <field name="storeName"><default-field title="Store"><display/></default-field></field>
                <field name="fulfillmentTypeEnumId"><default-field title="Fulfillment">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <field name="assignedDate"><default-field title="Assigned"><display format="dd-MMM HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
