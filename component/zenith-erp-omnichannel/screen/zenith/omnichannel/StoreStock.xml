<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Store Stock" default-menu-index="5">

    <transition name="syncStock">
        <service-call name="zenith.omnichannel.OmnichannelServices.sync#StoreInventory"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Store -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.stores.Store" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="storeId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.storeId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.omnichannel.StoreInventoryVisibility" list="stockList">
            <search-form-inputs default-order-by="storeId,productId"/>
            <econdition field-name="storeId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Store Stock Visibility" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="SyncStock" button-text="Sync Stock" type="info">
                <form-single name="SyncStockForm" transition="syncStock">
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down><entity-options key="${productId}" text="${productName}">
                            <entity-find entity-name="mantle.product.Product">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Sync"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Store Stock..." style="display:none"></span>]]></text></render-mode>
            <form-list name="StockForm" list="stockList" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="storeId"><header-field>
                    <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                        <entity-find entity-name="zenith.erp.stores.Store"/>
                    </entity-options></drop-down></header-field>
                    <default-field title="Store">
                        <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                    </default-field></field>
                <field name="productId"><default-field title="Product">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="availableQuantity"><default-field title="Available"><display/></default-field></field>
                <field name="reservedQuantity"><default-field title="Reserved"><display/></default-field></field>
                <field name="safetyStock"><default-field title="Safety"><display/></default-field></field>
                <field name="sellableQuantity"><default-field title="Sellable"><display/></default-field></field>
                <field name="lastSyncTime"><default-field title="Last Sync"><display format="dd-MMM HH:mm"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
