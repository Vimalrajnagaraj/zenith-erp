<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Channels" default-menu-index="4">

    <transition name="createChannel">
        <service-call name="create#zenith.erp.omnichannel.ChannelConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="updateChannel">
        <service-call name="update#zenith.erp.omnichannel.ChannelConfiguration"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.omnichannel.ChannelConfiguration" list="channels">
            <order-by field-name="channelName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Sales Channels" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="AddChannel" button-text="Add Channel" type="success">
                <form-single name="AddChannelForm" transition="createChannel">
                    <field name="channelName"><default-field><text-line size="20"/></default-field></field>
                    <field name="channelTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="ChannelType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="defaultFulfillmentTypeEnumId"><default-field title="Default Fulfillment">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="FulfillmentType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="defaultStoreId"><default-field title="Default Store">
                        <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ChannelsForm" list="channels" transition="updateChannel">
                <field name="channelId"><default-field><hidden/></default-field></field>
                <field name="channelName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="channelTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="syncFrequencyMinutes"><default-field title="Sync (min)"><text-line size="5"/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
