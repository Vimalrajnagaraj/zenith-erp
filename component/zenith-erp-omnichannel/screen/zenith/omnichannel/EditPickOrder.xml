<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Pick Order" default-menu-include="false">

    <parameter name="pickOrderId" required="true"/>

    <transition name="assignPicker">
        <service-call name="zenith.omnichannel.OmnichannelServices.assign#Picker"/>
        <default-response url="."/>
    </transition>
    <transition name="readyOrder">
        <service-call name="zenith.omnichannel.OmnichannelServices.ready#PickOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="completePickup">
        <service-call name="zenith.omnichannel.OmnichannelServices.complete#Pickup"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.omnichannel.StorePickOrder" value-field="pickOrder"/>
        <entity-find entity-name="zenith.erp.omnichannel.StorePickOrderItem" list="items">
            <econdition field-name="pickOrderId"/>
            <order-by field-name="pickItemSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Pick Order: ${pickOrderId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Order Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="PickOrderForm" map="pickOrder">
                        <field name="orderId"><default-field title="Order"><display/></default-field></field>
                        <field name="storeId"><default-field title="Store">
                            <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                        </default-field></field>
                        <field name="fulfillmentTypeEnumId"><default-field title="Fulfillment">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="customerName"><default-field><display/></default-field></field>
                        <field name="customerPhone"><default-field><display/></default-field></field>
                        <field name="pickerPartyId"><default-field title="Picker"><display/></default-field></field>
                        <field name="assignedDate"><default-field><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="readyDate"><default-field><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="collectedDate"><default-field><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                    </form-single>
                </container>

                <!-- Actions based on status -->
                <section name="AssignSection" condition="pickOrder.statusId == 'SpPending'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <label text="Assign Picker" type="h5" style="text-weight-bold q-mb-md"/>
                            <form-single name="AssignForm" transition="assignPicker">
                                <field name="pickOrderId" from="pickOrder.pickOrderId"><default-field><hidden/></default-field></field>
                                <field name="pickerPartyId"><default-field title="Picker">
                                    <drop-down><entity-options key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}">
                                        <entity-find entity-name="mantle.party.Person"/>
                                    </entity-options></drop-down></default-field></field>
                                <field name="submitBtn"><default-field title="Assign"><submit type="info"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>
                <section name="ReadySection" condition="pickOrder.statusId in ['SpAssigned', 'SpPicking']">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <form-single name="ReadyForm" transition="readyOrder">
                                <field name="pickOrderId" from="pickOrder.pickOrderId"><default-field><hidden/></default-field></field>
                                <field name="submitBtn"><default-field title="Mark Ready for Pickup"><submit type="success"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>
                <section name="CompleteSection" condition="pickOrder.statusId == 'SpReady'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <form-single name="CompleteForm" transition="completePickup">
                                <field name="pickOrderId" from="pickOrder.pickOrderId"><default-field><hidden/></default-field></field>
                                <field name="submitBtn"><default-field title="Complete Pickup"><submit type="success"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>

                <!-- Items -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Items" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="ItemsForm" list="items" skip-form="true">
                        <field name="pickItemSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                        </default-field></field>
                        <field name="orderedQuantity"><default-field title="Ordered"><display/></default-field></field>
                        <field name="pickedQuantity"><default-field title="Picked"><display/></default-field></field>
                        <field name="substituteProductId"><default-field title="Substitute">
                            <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${pickOrder.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Notified" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${pickOrder.customerNotified == 'Y' ? 'Yes' : 'No'}" type="h5"
                           style="${pickOrder.customerNotified == 'Y' ? 'text-positive' : 'text-grey-5'} text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
