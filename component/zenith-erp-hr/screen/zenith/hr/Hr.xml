<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="HR" default-menu-index="7">

    <always-actions>
        <set field="html_title" value="Human Resources"/>
    </always-actions>

    <subscreens default-item="Employees">
        <subscreens-item name="MyProfile" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyProfile.xml" menu-title="My Profile"/>
        <subscreens-item name="MyPayslips" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyPayslips.xml" menu-title="My Payslips"/>
        <subscreens-item name="MyLeaves" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyLeaves.xml" menu-title="My Leaves"/>
        <subscreens-item name="MyAttendance" location="component://zenith-erp-hr/screen/zenith/hr/Hr/MyAttendance.xml" menu-title="My Attendance"/>
    </subscreens>

    <transition name="goPayroll"><default-response url="/apps/zenith/payroll/PayrollRuns"/></transition>
    <transition name="goAttendance"><default-response url="/apps/zenith/attendance/AllAttendance"/></transition>
    <transition name="goTimeOff"><default-response url="/apps/zenith/timeoff/AllLeaves"/></transition>
    <transition name="goRecruitment"><default-response url="/apps/zenith/recruitment/Applications"/></transition>
    <transition name="goExpenses"><default-response url="/apps/zenith/expenses/AllReports"/></transition>
    <transition name="goContacts"><default-response url="/apps/zenith/Contacts/FindContact"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_payroll_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('payroll'))"><widgets><link url="goPayroll" text="Payroll" icon="fa fa-money" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_attendance_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('attendance'))"><widgets><link url="goAttendance" text="Attendance" icon="fa fa-calendar-check-o" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_timeoff_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('timeoff'))"><widgets><link url="goTimeOff" text="Time Off" icon="fa fa-plane" btn-type="warning" style="q-btn--dense"/></widgets></section>
            <section name="gate_recruitment_4" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('recruitment'))"><widgets><link url="goRecruitment" text="Recruitment" icon="fa fa-user-plus" btn-type="success" style="q-btn--dense"/></widgets></section>
            <section name="gate_expenses_5" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('expenses'))"><widgets><link url="goExpenses" text="Expenses" icon="fa fa-credit-card" btn-type="danger" style="q-btn--dense"/></widgets></section>
            <section name="gate_contacts_6" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="goContacts" text="Contacts" icon="fa fa-address-book" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
