<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Employees" default-menu-index="1">

    <transition name="createEmployee">
        <service-call name="zenith.hr.HrServices.create#Employee"/>
        <default-response url="../EditEmployee"/>
    </transition>
    <transition name="editEmployee">
        <default-response url="../EditEmployee"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.hr.EmployeeListView" list="empList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="employeeCode"/>
        </entity-find>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <!-- ZE-INV-IV-070 f/u: a tenant has exactly one org; auto-fill it (the /qapps Vue m-drop-down renders the
             get#ActiveOrgList list-options EMPTY, blocking New Employee). Super-admins (no active org) keep the picker. -->
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="organizationPartyId" from="_ao"/></if>
        <entity-find entity-name="zenith.erp.hr.Department" list="deptList">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="departmentName"/></entity-find>
        <entity-find entity-name="zenith.erp.hr.Designation" list="desList">
            <econdition field-name="isActive" value="Y"/><order-by field-name="level"/></entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Employees"/><box-toolbar>
            <section name="NewEmp_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewEmpDialog" button-text="New Employee">
                <form-single name="NewEmpForm" transition="createEmployee">
                    <field name="organizationPartyId">
                        <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                        <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                        <default-field title="Organization">
                        <drop-down>
                            <list-options list="orgList" key="${partyId}" text="${organizationName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="firstName"><default-field title="First Name"><text-line size="20"/></default-field></field>
                    <field name="lastName"><default-field title="Last Name"><text-line size="20"/></default-field></field>
                    <field name="employeeCode"><default-field title="Emp Code (auto if blank)"><text-line size="10"/></default-field></field>
                    <field name="joiningDate"><default-field title="Date of Joining"><date-time type="date"/></default-field></field>
                    <field name="employmentType"><default-field title="Type">
                        <drop-down>
                            <option key="Permanent"/><option key="Probation"/><option key="Contract"/>
                            <option key="Consultant"/><option key="Intern"/><option key="Apprentice"/>
                        </drop-down>
                    </default-field></field>
                    <field name="departmentId"><default-field title="Department">
                        <drop-down allow-empty="true">
                            <list-options list="deptList" key="${departmentId}" text="${departmentName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="designationId"><default-field title="Designation">
                        <drop-down allow-empty="true">
                            <list-options list="desList" key="${designationId}" text="${designationName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="panNumber"><default-field title="PAN"><text-line size="12"/></default-field></field>
                    <field name="aadhaarNumber"><default-field title="Aadhaar"><text-line size="14"/></default-field></field>
                    <field name="email"><default-field><text-line size="30"/></default-field></field>
                    <field name="phone"><default-field title="Mobile"><text-line size="15" default-value="+91"/></default-field></field>
                    <field name="stateCode"><default-field title="State (for PT)">
                        <drop-down allow-empty="true">
                            <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="ctcAnnual"><default-field title="Annual CTC (${currSymbol})"><text-line size="12"/></default-field></field>
                    <field name="incomeTaxRegime"><default-field title="IT Regime">
                        <drop-down><option key="New" text="New Regime"/><option key="Old" text="Old Regime"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Employee"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Employees..." style="display:none"></span>]]></text></render-mode>
            <form-list name="EmpListForm" list="empList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="employeeCode">
                    <header-field title="Code" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><link url="editEmployee" text="${employeeCode}" parameter-map="[employeeId:employeeId]"/></default-field>
                </field>
                <field name="firstName">
                    <header-field title="Name"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><link url="editEmployee" text="${firstName} ${lastName ?: ''}" parameter-map="[employeeId:employeeId]"/></default-field>
                </field>
                <field name="departmentName">
                    <header-field title="Department">
                        <drop-down allow-empty="true">
                            <list-options list="deptList" key="${departmentId}" text="${departmentName}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="designationName">
                    <default-field title="Designation"><display/></default-field>
                </field>
                <field name="joiningDate">
                    <header-field title="Joining" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="employmentType">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="Permanent"/><option key="Probation"/><option key="Contract"/>
                            <option key="Consultant"/><option key="Intern"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="panNumber"><default-field title="PAN"><display/></default-field></field>
                <field name="ctcAnnual">
                    <header-field title="CTC" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="EmpActive" text="Active"/><option key="EmpProbation" text="Probation"/>
                            <option key="EmpNoticeperiod" text="Notice"/><option key="EmpRelieved" text="Relieved"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
