<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Leave Register" default-menu-index="3">

    <transition name="approveLeave">
        <service-call name="zenith.hr.HrServices.approve#Leave"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Org-isolation: LeaveApplication has no org column; scope via the active org's employees -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="activeOrg">
            <entity-find entity-name="zenith.erp.hr.Employee" list="orgEmpList">
                <econdition field-name="organizationPartyId" from="activeOrg"/>
                <select-field field-name="employeeId"/>
            </entity-find>
            <set field="orgEmpIds" from="orgEmpList ? orgEmpList.collect{ it.employeeId } : ['__NONE__']"/>
        </if>
        <entity-find entity-name="zenith.erp.hr.LeaveApplication" list="leaveList">
            <econdition field-name="employeeId" operator="in" from="orgEmpIds" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-fromDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Leave Register"/><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Leave Register..." style="display:none"></span>]]></text></render-mode>
            <form-list name="LeaveRegForm" list="leaveList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="employeeId">
                    <header-field title="Employee"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="leaveType">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="EL" text="Earned"/><option key="CL" text="Casual"/>
                            <option key="SL" text="Sick"/><option key="LWP"/><option key="CompOff"/>
                            <option key="Maternity"/><option key="Paternity"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="fromDate">
                    <header-field title="From" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="toDate">
                    <default-field title="To"><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="totalDays"><default-field title="Days"><display/></default-field></field>
                <field name="reason"><default-field><display/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="LvPending" text="Pending"/><option key="LvApproved" text="Approved"/>
                            <option key="LvRejected" text="Rejected"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="actions"><default-field title="">
                    <link url="approveLeave" text="Approve"
                          parameter-map="[leaveApplicationId:leaveApplicationId]"
                          condition="statusId == 'LvPending' &amp;&amp; modCanWrite" confirmation="Approve this leave?"/>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
