<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Leaves" default-menu-index="12">

    <transition name="applyLeave">
        <actions>
            <!-- ZE-SB-013 (Tier 5): this entity-auto create BYPASSES the guarded apply#Leave service — guard the
                 transition so a forged employeeId can't file leave against another org's employee. -->
            <if condition="employeeId">
                <service-call name="zenith.base.SecurityServices.assert#EmployeeOrgAccess" out-map="_ea" in-map="[employeeId:employeeId]"/>
                <if condition="!_ea.allowed"><return error="true" message="Employee not found for your account."/></if>
            </if>
            <service-call name="create#zenith.erp.hr.LeaveApplication" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="cancelLeave">
        <service-call name="update#zenith.erp.hr.LeaveApplication"
            in-map="[leaveApplicationId: leaveApplicationId, statusId: 'LvCancelled']"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.hr.Employee" list="myEmpList">
            <econdition field-name="partyId" from="ec.user.userAccount.partyId"/>
        </entity-find>
        <set field="myEmployee" from="myEmpList ? myEmpList[0] : null"/>

        <if condition="myEmployee">
            <entity-find entity-name="zenith.erp.hr.LeaveApplication" list="leaveList">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <order-by field-name="-fromDate"/>
            </entity-find>

            <!-- Count by status -->
            <entity-find-count entity-name="zenith.erp.hr.LeaveApplication" count-field="pendingCount">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <econdition field-name="statusId" value="LvPending"/>
            </entity-find-count>
            <entity-find-count entity-name="zenith.erp.hr.LeaveApplication" count-field="approvedCount">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <econdition field-name="statusId" value="LvApproved"/>
            </entity-find-count>

            <!-- Current year leave taken -->
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="yearStart" from="new java.sql.Date(cal.get(java.util.Calendar.YEAR) - 1900, 0, 1)"/>
            <entity-find entity-name="zenith.erp.hr.LeaveApplication" list="yearLeaves">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <econdition field-name="statusId" operator="in" value="LvApproved"/>
                <econdition field-name="fromDate" operator="greater-equals" from="yearStart"/>
            </entity-find>
            <set field="totalDaysTaken" from="0" type="BigDecimal"/>
            <script>for (def l : yearLeaves) totalDaysTaken += (l.totalDays ?: 0)</script>
        </if>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="My Leaves" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Apply for leave and track your leave history" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <section name="ApplyLeaveSection" condition="myEmployee &amp;&amp; modCanWrite">
                <widgets>
                    <container-dialog id="ApplyLeaveDialog" button-text="Apply for Leave" width="600"
                                      button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                        <form-single name="ApplyLeaveForm" transition="applyLeave">
                            <field name="employeeId"><default-field><hidden default-value="${myEmployee.employeeId}"/></default-field></field>
                            <field name="leaveType"><default-field title="Leave Type">
                                <drop-down allow-empty="false">
                                    <option key="EL" text="Earned Leave (${myEmployee.earnedLeaveBalance ?: 0} available)"/>
                                    <option key="CL" text="Casual Leave (${myEmployee.casualLeaveBalance ?: 0} available)"/>
                                    <option key="SL" text="Sick Leave (${myEmployee.sickLeaveBalance ?: 0} available)"/>
                                    <option key="LWP" text="Leave Without Pay"/>
                                    <option key="CompOff" text="Compensatory Off"/>
                                </drop-down>
                            </default-field></field>
                            <field name="fromDate"><default-field title="From Date"><date-time type="date"/></default-field></field>
                            <field name="toDate"><default-field title="To Date"><date-time type="date"/></default-field></field>
                            <field name="totalDays"><default-field title="Total Days"><text-line size="5"/></default-field></field>
                            <field name="reason"><default-field title="Reason"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="statusId"><default-field><hidden default-value="LvPending"/></default-field></field>
                            <field name="submitButton"><default-field title="Submit Application"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </widgets>
            </section>
        </container>

        <section name="NoEmpLeaves" condition="!myEmployee">
            <widgets>
                <container style="bg-white shadow-2 q-pa-xl text-center border-radius-lg">
                    <label text="No employee record found." type="h5" style="text-grey-7"/>
                </container>
            </widgets>
        </section>

        <section name="LeavesSection" condition="myEmployee">
            <widgets>
                <!-- Leave Balance Cards -->
                <container-row>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Earned Leave" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.earnedLeaveBalance ?: 0}" type="h4" style="text-positive text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Casual Leave" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.casualLeaveBalance ?: 0}" type="h4" style="text-info text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Sick Leave" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.sickLeaveBalance ?: 0}" type="h4" style="text-warning text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Days Taken (YTD)" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${totalDaysTaken}" type="h4" style="text-grey-8 text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Pending" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${pendingCount}" type="h4" style="text-amber text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="2">
                        <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                            <label text="Approved" type="p" style="text-grey-7 text-weight-bold q-mb-xs"/>
                            <label text="${approvedCount}" type="h4" style="text-positive text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                </container-row>

                <!-- Leave History -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
                    <form-list name="MyLeaveList" list="leaveList" skip-form="true" show-csv-button="true">
                        <field name="leaveType"><default-field title="Type"><display/></default-field></field>
                        <field name="fromDate"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="toDate"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="totalDays"><default-field title="Days"><display/></default-field></field>
                        <field name="reason"><default-field title="Reason"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                        </default-field></field>
                        <field name="actions"><default-field title="">
                            <link url="cancelLeave" text="Cancel" btn-type="danger" style="q-btn--dense"
                                  parameter-map="[leaveApplicationId: leaveApplicationId]"
                                  condition="statusId == 'LvPending' &amp;&amp; modCanWrite"
                                  confirmation="Cancel this leave application?"/>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
