<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Departments" default-menu-index="2">

    <transition name="createDept">
        <actions>
            <!-- Org-isolation: stamp the new department with the active org so it is tenant-scoped -->
            <service-call name="create#zenith.erp.hr.Department"
                          in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateDept">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (prevent cross-tenant IDOR edit) -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="zenith.erp.hr.Department" value-field="curDept"/>
            <if condition="curDept == null || (activeOrg &amp;&amp; curDept.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Department not found for your account."/>
            </if>
            <service-call name="update#zenith.erp.hr.Department" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.hr.Department" list="deptList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="departmentName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Departments"/><box-toolbar>
            <container-dialog id="NewDeptDialog" button-text="New Department">
                <form-single name="NewDeptForm" transition="createDept">
                    <field name="departmentName"><default-field title="Name"><text-line size="30"/></default-field></field>
                    <field name="parentDepartmentId"><default-field title="Parent">
                        <drop-down allow-empty="true">
                            <list-options list="deptList" key="${departmentId}" text="${departmentName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="DeptListForm" list="deptList" skip-form="true" transition="updateDept">
                <field name="departmentId"><default-field><hidden/></default-field></field>
                <field name="departmentName">
                    <header-field title="Name" show-order-by="true"><text-find size="25" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="parentDepartmentId">
                    <default-field title="Parent"><display/></default-field>
                </field>
                <field name="isActive">
                    <header-field title="Active">
                        <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
