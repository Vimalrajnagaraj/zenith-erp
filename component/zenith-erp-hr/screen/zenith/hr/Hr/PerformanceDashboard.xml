<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Performance Management" default-menu-index="40">

    <transition name="startAppraisal">
        <service-call name="zenith.hr.PerformanceServices.start#AppraisalCycle" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Org-isolation: OkrObjective has no org column; scope via the active org's employees -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="activeOrg">
            <entity-find entity-name="zenith.erp.hr.Employee" list="orgEmpList">
                <econdition field-name="organizationPartyId" from="activeOrg"/>
                <select-field field-name="employeeId"/>
            </entity-find>
            <set field="orgEmpIds" from="orgEmpList ? orgEmpList.collect{ it.employeeId } : ['__NONE__']"/>
        </if>
        <entity-find entity-name="zenith.erp.hr.OkrObjective" list="objectives">
            <econdition field-name="employeeId" operator="in" from="orgEmpIds" ignore-if-empty="true"/>
        </entity-find>

        <!-- For the Robust Peer Selection Filter -->
        <entity-find entity-name="zenith.erp.hr.Department" list="departments">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.hr.Designation" list="designations"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Performance Management" type="h4" style="text-weight-bold q-my-none"/>
            <section name="StartAppraisal_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="StartAppraisalDialog" button-text="Start 360 Appraisal Cycle" type="primary">
                <form-single name="StartAppraisalForm" transition="startAppraisal">
                    <field name="employeeId"><default-field title="Target Employee">
                        <drop-down>
                            <entity-options key="${employeeId}" text="${employeeCode} - ${((firstName?:'') + ' ' + (lastName?:'')).trim()}">
                                <entity-find entity-name="zenith.erp.hr.EmployeeListView"><econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="managerEmployeeId"><default-field title="Direct Manager">
                        <drop-down>
                            <entity-options key="${employeeId}" text="${employeeCode} - ${((firstName?:'') + ' ' + (lastName?:'')).trim()}">
                                <entity-find entity-name="zenith.erp.hr.EmployeeListView"><econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="cycleId"><default-field title="Appraisal Cycle"><text-line size="20" default-value="FY2026-Q3"/></default-field></field>
                    
                    <!-- Robust Peer Selection (Search and Filter) -->
                    <field name="peerSelectionLabel">
                        <default-field title="Select Peers for 360 Feedback">
                            <label text="Filter by Department or Designation to narrow down the employee list." type="p" style="text-grey-6 text-caption"/>
                        </default-field>
                    </field>
                    <field name="filterDepartmentId"><default-field title="Filter: Department"><drop-down allow-empty="true">
                        <entity-options key="${departmentId}" text="${departmentName}">
                            <entity-find entity-name="zenith.erp.hr.Department"><econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find>
                        </entity-options>
                    </drop-down></default-field></field>
                    <field name="filterDesignationId"><default-field title="Filter: Role/Designation"><drop-down allow-empty="true">
                        <entity-options key="${designationId}" text="${designationName}">
                            <entity-find entity-name="zenith.erp.hr.Designation"/>
                        </entity-options>
                    </drop-down></default-field></field>
                    <field name="peerEmployeeIds"><default-field title="Select Peers">
                        <drop-down allow-multiple="true">
                            <entity-options key="${employeeId}" text="${employeeCode} - ${((firstName?:'') + ' ' + (lastName?:'')).trim()} (${departmentName})">
                                <!-- Moqui handles dynamic UI filtering via dependent drops, we use a broad view here -->
                                <entity-find entity-name="zenith.erp.hr.EmployeeListView"><econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>

                    <field name="submitBtn"><default-field title="Start Appraisal Cycle"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Active OKRs (Objectives &amp; Key Results)" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <!-- Mock OKR List -->
                    <form-list name="OkrList" list="objectives" skip-form="true">
                        <field name="title"><default-field title="Objective"><display/></default-field></field>
                        <field name="progressPercent"><default-field title="Progress">
                            <display text="${progressPercent}%" style="text-success text-weight-bold"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
