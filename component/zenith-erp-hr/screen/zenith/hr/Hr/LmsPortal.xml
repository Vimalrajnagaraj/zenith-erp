<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="LMS (Compliance Portal)" default-menu-index="50">

    <transition name="completeTraining">
        <service-call name="zenith.hr.LmsServices.complete#Training" in-map="context"/>
        <default-response url="."/>
    </transition>
    
    <transition name="assignTraining">
        <service-call name="zenith.hr.LmsServices.assign#MandatoryTraining" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Mock fetching trainings for current logged in user/employee -->
        <entity-find entity-name="zenith.erp.hr.EmployeeTraining" list="myTrainings">
            <!-- <econdition field-name="employeeId" value="${ec.user.userAccount.partyId}"/> -->
        </entity-find>
        
        <entity-find entity-name="zenith.erp.hr.TrainingCourse" list="allCourses"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Learning Management System (Compliance)" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="AssignTrainingDialog" button-text="Assign Mandatory Training" type="warning">
                <form-single name="AssignTrainingForm" transition="assignTraining">
                    <field name="employeeId"><default-field title="Employee">
                        <drop-down>
                            <entity-options key="${employeeId}" text="${employeeCode} - ${firstName} ${lastName}">
                                <entity-find entity-name="zenith.erp.hr.EmployeeListView"/>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="courseId"><default-field title="Course">
                        <drop-down>
                            <entity-options key="${courseId}" text="${courseName}">
                                <entity-find entity-name="zenith.erp.hr.TrainingCourse">
                                    <econdition field-name="isMandatoryCompliance" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Assign Course"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="My Pending Compliance Training" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-list name="MyTrainingList" list="myTrainings" transition="completeTraining">
                        <field name="employeeTrainingId"><default-field><hidden/></default-field></field>
                        <field name="courseId"><default-field title="Course">
                            <display-entity entity-name="zenith.erp.hr.TrainingCourse" text="${courseName}"/>
                        </default-field></field>
                        <field name="dueDate"><default-field title="Due By"><display format="yyyy-MM-dd"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field></field>
                        <field name="completeBtn"><default-field title="Action">
                            <submit text="Mark Completed" type="success" confirmation="I certify I have reviewed and understood this compliance material."/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
