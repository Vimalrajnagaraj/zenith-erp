<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Employee Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="employeeId" required="true"/>

    <transition name="updateEmployee">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (prevent cross-tenant IDOR edit) -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="zenith.erp.hr.Employee" value-field="curEmp"/>
            <if condition="curEmp == null || (activeOrg &amp;&amp; curEmp.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Employee not found for your account."/>
            </if>
            <service-call name="update#zenith.erp.hr.Employee" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="confirmEmployee">
        <service-call name="zenith.hr.HrServices.confirm#Employee"/>
        <default-response url="."/>
    </transition>
    <transition name="resignEmployee">
        <service-call name="zenith.hr.HrServices.resign#Employee"/>
        <default-response url="."/>
    </transition>
    <transition name="applyLeave">
        <service-call name="zenith.hr.HrServices.apply#Leave"/>
        <default-response url="."/>
    </transition>
    <transition name="approveLeave">
        <service-call name="zenith.hr.HrServices.approve#Leave"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="zenith.erp.hr.Employee" value-field="emp"/>
        <!-- Org-isolation: block IDOR read of another tenant's employee (PAN/Aadhaar/UAN/bank/CTC) -->
        <if condition="emp == null || (activeOrg &amp;&amp; emp.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
            <!-- Wipe the loaded record and stop before any sensitive field can render -->
            <set field="emp" from="[:]"/>
            <set field="person" from="[:]"/>
            <return error="true" message="Employee not found for your account."/>
        </if>
        <entity-find-one entity-name="mantle.party.Person" value-field="person">
            <field-map field-name="partyId" from="emp.partyId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.hr.Department" list="deptList">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <order-by field-name="departmentName"/></entity-find>
        <entity-find entity-name="zenith.erp.hr.Designation" list="desList">
            <econdition field-name="isActive" value="Y"/><order-by field-name="level"/></entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
        <entity-find entity-name="zenith.erp.hr.LeaveApplication" list="leaveList">
            <econdition field-name="employeeId"/>
            <order-by field-name="-fromDate"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="${person.firstName} ${person.lastName ?: ''} - ${emp.employeeCode}" type="h4"/>
        <label text="Status: ${emp.statusId} | Type: ${emp.employmentType} | Joined: ${ec.l10n.format(emp.joiningDate, 'dd/MM/yyyy')}" type="div" style="text-muted"/>

        <container-row>
            <row-col lg="6">
                <container-box><box-header title="Employment Details"/><box-toolbar>
                    <section name="EmpStatusActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <link url="confirmEmployee" text="Confirm" parameter-map="[employeeId:employeeId]"
                          condition="emp.statusId == 'EmpProbation'" confirmation="Confirm this employee? Status will change to Active."/>
                    <link url="resignEmployee" text="Resign" parameter-map="[employeeId:employeeId]"
                          condition="emp.statusId == 'EmpActive'" confirmation="Process resignation? Notice period will be calculated."/>
                    </widgets></section>
                </box-toolbar><box-body>
                    <form-single name="EditEmpForm" map="emp" transition="updateEmployee">
                        <field name="employeeId"><default-field><hidden/></default-field></field>
                        <field name="departmentId"><default-field title="Department">
                            <drop-down allow-empty="true">
                                <list-options list="deptList" key="${departmentId}" text="${departmentName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="designationId"><default-field title="Designation">
                            <drop-down allow-empty="true">
                                <list-options list="desList" key="${designationId}" text="${designationName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="employmentType"><default-field title="Type">
                            <drop-down>
                                <option key="Permanent"/><option key="Probation"/><option key="Contract"/>
                                <option key="Consultant"/><option key="Intern"/><option key="Apprentice"/>
                            </drop-down>
                        </default-field></field>
                        <field name="noticePeriodDays"><default-field title="Notice Period (days)"><text-line size="6"/></default-field></field>
                        <field name="ctcAnnual"><default-field title="Annual CTC (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="incomeTaxRegime"><default-field title="IT Regime">
                            <drop-down><option key="New" text="New Regime"/><option key="Old" text="Old Regime"/></drop-down>
                        </default-field></field>
                        <field name="stateCode"><default-field title="State (for PT)">
                            <drop-down allow-empty="true">
                                <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="isMetroCity"><default-field title="Metro City (HRA)">
                            <drop-down><option key="N" text="No (40% HRA)"/><option key="Y" text="Yes (50% HRA)"/></drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="emp_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="Statutory IDs"/><box-body>
                    <form-single name="StatutoryForm" map="emp" transition="updateEmployee">
                        <field name="employeeId"><default-field><hidden/></default-field></field>
                        <field name="panNumber"><default-field title="PAN"><text-line size="12"/></default-field></field>
                        <field name="aadhaarNumber"><default-field title="Aadhaar"><text-line size="14"/></default-field></field>
                        <field name="uanNumber"><default-field title="UAN (EPF)"><text-line size="14"/></default-field></field>
                        <field name="pfNumber"><default-field title="PF Number"><text-line size="20"/></default-field></field>
                        <field name="esiNumber"><default-field title="ESI Number"><text-line size="14"/></default-field></field>
                        <field name="pfApplicable"><default-field title="PF Applicable">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="esiApplicable"><default-field title="ESI Applicable">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="ptApplicable"><default-field title="PT Applicable">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="stat_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <container-box><box-header title="Bank Details"/><box-body>
                    <form-single name="BankForm" map="emp" transition="updateEmployee">
                        <field name="employeeId"><default-field><hidden/></default-field></field>
                        <field name="bankName"><default-field><text-line size="25"/></default-field></field>
                        <field name="bankAccountNumber"><default-field title="Account No"><text-line size="20"/></default-field></field>
                        <field name="ifscCode"><default-field title="IFSC"><text-line size="12"/></default-field></field>
                        <field name="bankBranch"><default-field title="Branch"><text-line size="25"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="bank_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Leave Section -->
        <container-row>
            <row-col lg="12">
                <container-box><box-header title="Leave Balance &amp; Applications"/><box-toolbar>
                    <label text="EL: ${emp.earnedLeaveBalance ?: 0} | CL: ${emp.casualLeaveBalance ?: 0} | SL: ${emp.sickLeaveBalance ?: 0}" type="span" style="text-info"/>
                    <section name="ApplyLeave_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="ApplyLeaveDialog" button-text="Apply Leave">
                        <form-single name="ApplyLeaveForm" transition="applyLeave">
                            <field name="employeeId"><default-field><hidden/></default-field></field>
                            <field name="leaveType"><default-field title="Type">
                                <drop-down>
                                    <option key="EL" text="Earned Leave"/>
                                    <option key="CL" text="Casual Leave"/>
                                    <option key="SL" text="Sick Leave"/>
                                    <option key="LWP" text="Leave Without Pay"/>
                                    <option key="CompOff" text="Compensatory Off"/>
                                    <option key="Maternity" text="Maternity Leave"/>
                                    <option key="Paternity" text="Paternity Leave"/>
                                </drop-down>
                            </default-field></field>
                            <field name="fromDate"><default-field><date-time type="date"/></default-field></field>
                            <field name="toDate"><default-field><date-time type="date"/></default-field></field>
                            <field name="reason"><default-field><text-area rows="2" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Apply"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar><box-body>
                    <form-list name="LeaveListForm" list="leaveList" skip-form="true">
                        <field name="leaveType"><default-field title="Type"><display/></default-field></field>
                        <field name="fromDate"><default-field title="From"><display format="dd/MM/yyyy"/></default-field></field>
                        <field name="toDate"><default-field title="To"><display format="dd/MM/yyyy"/></default-field></field>
                        <field name="totalDays"><default-field title="Days"><display/></default-field></field>
                        <field name="reason"><default-field><display/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                        <field name="actions"><default-field title="">
                            <link url="approveLeave" text="Approve"
                                  parameter-map="[leaveApplicationId:leaveApplicationId]"
                                  condition="statusId == 'LvPending' &amp;&amp; modCanWrite"/>
                        </default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
