<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Profile" default-menu-index="10">

    <transition name="updateProfile">
        <service-call name="update#zenith.erp.hr.Employee"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Find the employee record for the current logged-in user -->
        <entity-find entity-name="zenith.erp.hr.Employee" list="myEmpList">
            <econdition field-name="partyId" from="ec.user.userAccount.partyId"/>
        </entity-find>
        <set field="myEmployee" from="myEmpList ? myEmpList[0] : null"/>

        <if condition="myEmployee">
            <entity-find-one entity-name="mantle.party.Person" value-field="person">
                <field-map field-name="partyId" from="myEmployee.partyId"/>
            </entity-find-one>
            <entity-find-one entity-name="zenith.erp.hr.Department" value-field="dept">
                <field-map field-name="departmentId" from="myEmployee.departmentId"/>
            </entity-find-one>
            <entity-find-one entity-name="zenith.erp.hr.Designation" value-field="desig">
                <field-map field-name="designationId" from="myEmployee.designationId"/>
            </entity-find-one>
            <!-- Reporting manager -->
            <if condition="myEmployee.reportingToEmployeeId">
                <entity-find-one entity-name="zenith.erp.hr.Employee" value-field="manager">
                    <field-map field-name="employeeId" from="myEmployee.reportingToEmployeeId"/>
                </entity-find-one>
                <if condition="manager">
                    <entity-find-one entity-name="mantle.party.Person" value-field="managerPerson">
                        <field-map field-name="partyId" from="manager.partyId"/>
                    </entity-find-one>
                </if>
            </if>
        </if>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="My Profile" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="View and update your personal information" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <section name="NoEmployeeSection" condition="!myEmployee">
            <widgets>
                <container style="bg-white shadow-2 q-pa-xl text-center border-radius-lg">
                    <label text="No employee record found for your user account." type="h5" style="text-grey-7"/>
                    <label text="Please contact HR to link your user account to an employee record." type="p" style="text-grey-5"/>
                </container>
            </widgets>
        </section>

        <section name="ProfileSection" condition="myEmployee">
            <widgets>
                <!-- Profile Header Card -->
                <container style="bg-white shadow-3 q-pa-lg border-radius-lg q-mb-lg">
                    <container-row>
                        <row-col lg="2">
                            <container style="text-center">
                                <container style="bg-primary text-white text-weight-bold text-h3 q-pa-lg border-radius-lg" style-inline="width:100px;height:100px;display:flex;align-items:center;justify-content:center;margin:0 auto">
                                    <label text="${(person?.firstName ?: '?')[0]}${(person?.lastName ?: '?')[0]}"/>
                                </container>
                            </container>
                        </row-col>
                        <row-col lg="5">
                            <label text="${person?.firstName ?: ''} ${person?.lastName ?: ''}" type="h4" style="text-weight-bold q-my-none"/>
                            <label text="${desig?.designationName ?: 'N/A'} | ${dept?.departmentName ?: 'N/A'}" type="p" style="text-grey-7 q-mb-xs"/>
                            <label text="Employee Code: ${myEmployee.employeeCode ?: 'N/A'}" type="p" style="text-grey-6 q-mb-xs"/>
                            <label text="Joining Date: ${ec.l10n.format(myEmployee.joiningDate, 'dd-MMM-yyyy')}" type="p" style="text-grey-6 q-mb-none"/>
                        </row-col>
                        <row-col lg="5">
                            <container style="bg-blue-1 q-pa-md border-radius-lg">
                                <label text="Employment Details" type="p" style="text-weight-bold text-primary q-mb-sm"/>
                                <label text="Type: ${myEmployee.employmentType ?: 'N/A'}" type="p" style="text-grey-8 q-mb-xs"/>
                                <label text="Status: ${myEmployee.statusId ?: 'N/A'}" type="p" style="text-grey-8 q-mb-xs"/>
                                <label text="Reports To: ${managerPerson ? (managerPerson.firstName + ' ' + managerPerson.lastName) : 'N/A'}" type="p" style="text-grey-8 q-mb-none"/>
                            </container>
                        </row-col>
                    </container-row>
                </container>

                <!-- Leave Balance Cards -->
                <container-row>
                    <row-col lg="4">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Earned Leave" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${myEmployee.earnedLeaveBalance ?: 0}" type="h3" style="text-positive text-weight-bolder q-my-none"/>
                            <label text="days available" type="p" style="text-grey-5 q-mb-none"/>
                        </container>
                    </row-col>
                    <row-col lg="4">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Casual Leave" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${myEmployee.casualLeaveBalance ?: 0}" type="h3" style="text-info text-weight-bolder q-my-none"/>
                            <label text="days available" type="p" style="text-grey-5 q-mb-none"/>
                        </container>
                    </row-col>
                    <row-col lg="4">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Sick Leave" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${myEmployee.sickLeaveBalance ?: 0}" type="h3" style="text-warning text-weight-bolder q-my-none"/>
                            <label text="days available" type="p" style="text-grey-5 q-mb-none"/>
                        </container>
                    </row-col>
                </container-row>

                <!-- Editable Personal Info -->
                <container style="bg-white shadow-2 q-pa-lg border-radius-lg q-mb-md">
                    <label text="Personal Information" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="UpdateProfileForm" transition="updateProfile" map="myEmployee">
                        <field name="employeeId"><default-field><hidden/></default-field></field>
                        <field name="emergencyContactName"><default-field title="Emergency Contact Name"><text-line size="30"/></default-field></field>
                        <field name="emergencyContactPhone"><default-field title="Emergency Contact Phone"><text-line size="15"/></default-field></field>
                        <field name="currentAddress"><default-field title="Current Address"><text-area rows="2" cols="50"/></default-field></field>
                        <field name="bloodGroup"><default-field title="Blood Group">
                            <drop-down allow-empty="true">
                                <option key="A+" text="A+"/><option key="A-" text="A-"/>
                                <option key="B+" text="B+"/><option key="B-" text="B-"/>
                                <option key="AB+" text="AB+"/><option key="AB-" text="AB-"/>
                                <option key="O+" text="O+"/><option key="O-" text="O-"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="Update Profile"><submit/></conditional-field>
                            <default-field title="Update Profile"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>

                <!-- Bank Details (read-only for security) -->
                <container style="bg-white shadow-2 q-pa-lg border-radius-lg">
                    <label text="Bank Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <label text="Bank details can only be updated by HR for security purposes." type="p" style="text-grey-6 q-mb-md"/>
                    <container-row>
                        <row-col lg="4">
                            <label text="Bank Name" type="p" style="text-grey-6 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.bankName ?: 'Not set'}" type="p" style="text-grey-8"/>
                        </row-col>
                        <row-col lg="4">
                            <label text="Account Number" type="p" style="text-grey-6 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.bankAccountNumber ? ('****' + myEmployee.bankAccountNumber[-4..-1]) : 'Not set'}" type="p" style="text-grey-8"/>
                        </row-col>
                        <row-col lg="4">
                            <label text="Routing Code" type="p" style="text-grey-6 text-weight-bold q-mb-xs"/>
                            <label text="${myEmployee.bankRoutingCode ?: 'Not set'}" type="p" style="text-grey-8"/>
                        </row-col>
                    </container-row>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
