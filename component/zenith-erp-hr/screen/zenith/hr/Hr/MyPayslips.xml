<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Payslips" default-menu-index="11">

    <actions>
        <!-- Find the employee record for the current logged-in user -->
        <entity-find entity-name="zenith.erp.hr.Employee" list="myEmpList">
            <econdition field-name="partyId" from="ec.user.userAccount.partyId"/>
        </entity-find>
        <set field="myEmployee" from="myEmpList ? myEmpList[0] : null"/>

        <if condition="myEmployee">
            <entity-find entity-name="zenith.erp.payroll.PayslipView" list="payslipList">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <order-by field-name="-periodYear,-periodMonth"/>
            </entity-find>

            <!-- Current year summary -->
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
            <entity-find entity-name="zenith.erp.payroll.Payslip" list="yearPayslips">
                <econdition field-name="employeeId" from="myEmployee.employeeId"/>
                <econdition field-name="periodYear" from="currentYear"/>
            </entity-find>
            <set field="ytdGross" from="0" type="BigDecimal"/>
            <set field="ytdDeductions" from="0" type="BigDecimal"/>
            <set field="ytdNet" from="0" type="BigDecimal"/>
            <set field="ytdTax" from="0" type="BigDecimal"/>
            <script>
                for (def ps : yearPayslips) {
                    ytdGross += (ps.grossEarnings ?: 0)
                    ytdDeductions += (ps.totalDeductions ?: 0)
                    ytdNet += (ps.netPay ?: 0)
                    ytdTax += (ps.incomeTax ?: 0)
                }
            </script>
        </if>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="My Payslips" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="View your salary slips and year-to-date earnings summary" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <section name="NoEmployeePayslips" condition="!myEmployee">
            <widgets>
                <container style="bg-white shadow-2 q-pa-xl text-center border-radius-lg">
                    <label text="No employee record found." type="h5" style="text-grey-7"/>
                </container>
            </widgets>
        </section>

        <section name="PayslipsSection" condition="myEmployee">
            <widgets>
                <!-- YTD Summary -->
                <container-row>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="YTD Gross Earnings" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${zinr.inr(ec.l10n.format(ytdGross, '#,##,##0'))}" type="h4" style="text-positive text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="YTD Deductions" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${zinr.inr(ec.l10n.format(ytdDeductions, '#,##,##0'))}" type="h4" style="text-negative text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="YTD Net Pay" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${zinr.inr(ec.l10n.format(ytdNet, '#,##,##0'))}" type="h4" style="text-primary text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="YTD Income Tax" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${zinr.inr(ec.l10n.format(ytdTax, '#,##,##0'))}" type="h4" style="text-warning text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                </container-row>

                <!-- Payslip List -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
                    <form-list name="MyPayslipList" list="payslipList" skip-form="true" show-csv-button="true">
                        <field name="periodYear"><default-field title="Year"><display/></default-field></field>
                        <field name="periodMonth"><default-field title="Month"><display/></default-field></field>
                        <field name="workingDays"><default-field title="Working Days"><display/></default-field></field>
                        <field name="presentDays"><default-field title="Present Days"><display/></default-field></field>
                        <field name="basicPay"><default-field title="Basic Pay"><display format="#,##,##0"/></default-field></field>
                        <field name="grossEarnings"><default-field title="Gross"><display format="#,##,##0"/></default-field></field>
                        <field name="totalDeductions"><default-field title="Deductions"><display format="#,##,##0"/></default-field></field>
                        <field name="netPay"><default-field title="Net Pay"><display format="#,##,##0"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                        </default-field></field>
                        <field name="viewPayslip"><default-field title="">
                            <section name="gate_payroll_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('payroll'))"><widgets><link url="/apps/zenith/payroll/ViewPayslip" text="View" btn-type="info" style="q-btn--dense"
                                  parameter-map="[payslipId: payslipId]"/></widgets></section>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
