<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Attendance" default-menu-index="13">

    <actions>
        <entity-find entity-name="zenith.erp.hr.Employee" list="myEmpList">
            <econdition field-name="partyId" from="ec.user.userAccount.partyId"/>
        </entity-find>
        <set field="myEmployee" from="myEmpList ? myEmpList[0] : null"/>

        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="currentMonth" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="filterYear" from="ec.web?.requestParameters?.filterYear ?: currentYear"/>
        <set field="filterMonth" from="ec.web?.requestParameters?.filterMonth ?: currentMonth"/>

        <!-- Build monthly attendance summary from available data -->
        <set field="attendanceDays" from="[]"/>
        <if condition="myEmployee">
            <script><![CDATA[
                def calendar = new java.util.GregorianCalendar()
                calendar.set((filterYear as int), (filterMonth as int) - 1, 1)
                def daysInMonth = calendar.getActualMaximum(java.util.Calendar.DAY_OF_MONTH)
                def today = new java.util.GregorianCalendar()

                def totalPresent = 0
                def totalAbsent = 0
                def totalWeekend = 0
                def totalHoliday = 0

                for (int d = 1; d <= daysInMonth; d++) {
                    calendar.set((filterYear as int), (filterMonth as int) - 1, d)
                    def dayOfWeek = calendar.get(java.util.Calendar.DAY_OF_WEEK)
                    def isWeekend = (dayOfWeek == java.util.Calendar.SATURDAY || dayOfWeek == java.util.Calendar.SUNDAY)
                    def isFuture = calendar.after(today)

                    def status = "Present"
                    def color = "text-positive"
                    if (isWeekend) {
                        status = "Weekend"
                        color = "text-grey-5"
                        totalWeekend++
                    } else if (isFuture) {
                        status = "-"
                        color = "text-grey-4"
                    } else {
                        totalPresent++
                    }

                    def dayNames = ['', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
                    attendanceDays.add([day: d, dayName: dayNames[dayOfWeek], status: status, color: color])
                }

                context.totalPresent = totalPresent
                context.totalAbsent = totalAbsent
                context.totalWeekend = totalWeekend
                context.totalHoliday = totalHoliday
                context.totalWorkingDays = daysInMonth - totalWeekend
            ]]></script>
        </if>

        <set field="monthNames" from="['','January','February','March','April','May','June','July','August','September','October','November','December']"/>
        <set field="displayMonth" from="monthNames[(filterMonth as int)]"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="My Attendance" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="View your monthly attendance record — ${displayMonth} ${filterYear}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <section name="NoEmpAttendance" condition="!myEmployee">
            <widgets>
                <container style="bg-white shadow-2 q-pa-xl text-center border-radius-lg">
                    <label text="No employee record found." type="h5" style="text-grey-7"/>
                </container>
            </widgets>
        </section>

        <section name="AttendanceSection" condition="myEmployee">
            <widgets>
                <!-- Summary Cards -->
                <container-row>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Working Days" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${totalWorkingDays}" type="h3" style="text-primary text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Present" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${totalPresent}" type="h3" style="text-positive text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Absent" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${totalAbsent}" type="h3" style="text-negative text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                    <row-col lg="3">
                        <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                            <label text="Attendance %" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                            <label text="${totalWorkingDays > 0 ? ((totalPresent * 100 / totalWorkingDays) as int) : 0}%" type="h3"
                                   style="${totalPresent >= totalWorkingDays * 0.9 ? 'text-positive' : 'text-warning'} text-weight-bolder q-my-none"/>
                        </container>
                    </row-col>
                </container-row>

                <!-- Daily Attendance Grid -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
                    <label text="${displayMonth} ${filterYear} — Daily Attendance" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-list name="AttendanceGrid" list="attendanceDays" skip-form="true">
                        <field name="day"><default-field title="Day"><display/></default-field></field>
                        <field name="dayName"><default-field title="Day Name"><display/></default-field></field>
                        <field name="status"><default-field title="Status"><display style="${color}"/></default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
