<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Employee (generic) ========== -->
    <entity entity-name="Employee" package="zenith.erp.hr" table-name="ZENITH_EMPLOYEE">
        <field name="employeeId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="employeeCode" type="text-short"/>
        <field name="joiningDate" type="date"/>
        <field name="confirmationDate" type="date"/>
        <field name="resignationDate" type="date"/>
        <field name="relievingDate" type="date"/>
        <field name="lastWorkingDate" type="date"/>
        <field name="statusId" type="id"/>

        <field name="employmentType" type="text-short"><description>Permanent, Contract, Probation, Consultant, Intern, Apprentice</description></field>
        <field name="probationMonths" type="number-integer"/>
        <field name="noticePeriodDays" type="number-integer"/>

        <field name="departmentId" type="id"/>
        <field name="designationId" type="id"/>
        <field name="reportingToEmployeeId" type="id"/>

        <!-- Generic identification -->
        <field name="taxIdNumber" type="text-short"><description>PAN (India), SSN (US), NI (UK), etc.</description></field>
        <field name="nationalIdNumber" type="text-short"><description>Aadhaar (India), SSN (US), NI (UK), etc.</description></field>
        <field name="socialSecurityNumber" type="text-short"><description>UAN (India), SSN (US), NI (UK)</description></field>
        <field name="passportNumber" type="text-short"/>

        <!-- Bank details -->
        <field name="bankName" type="text-medium"/>
        <field name="bankAccountNumber" type="text-short"/>
        <field name="bankRoutingCode" type="text-short"><description>IFSC (India), Sort Code (UK), ABA (US)</description></field>
        <field name="bankRoutingCodeType" type="text-short"/>
        <field name="bankBranch" type="text-medium"/>

        <!-- Personal -->
        <field name="dateOfBirth" type="date"/>
        <field name="gender" type="text-short"/>
        <field name="bloodGroup" type="text-short"/>
        <field name="maritalStatus" type="text-short"/>
        <field name="fatherName" type="text-medium"/>
        <field name="emergencyContactName" type="text-medium"/>
        <field name="emergencyContactPhone" type="text-short"/>
        <field name="permanentAddress" type="text-long"/>
        <field name="currentAddress" type="text-long"/>
        <field name="regionGeoId" type="id"/>
        <field name="countryGeoId" type="id"/>

        <!-- Salary -->
        <field name="ctcAnnual" type="currency-amount"/>
        <field name="salaryStructureId" type="id"/>

        <!-- Leave balance -->
        <field name="earnedLeaveBalance" type="number-decimal" default="0"/>
        <field name="casualLeaveBalance" type="number-decimal" default="0"/>
        <field name="sickLeaveBalance" type="number-decimal" default="0"/>

        <relationship type="one" related="mantle.party.Person">
            <key-map field-name="partyId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.hr.Department"/>
        <relationship type="one" related="zenith.erp.hr.Designation"/>
        <relationship type="one" title="ReportingTo" related="zenith.erp.hr.Employee">
            <key-map field-name="reportingToEmployeeId" related="employeeId"/></relationship>

        <seed-data>
            <moqui.basic.StatusType statusTypeId="HrEmployee" description="Employee"/>
            <moqui.basic.StatusItem statusId="EmpActive" statusTypeId="HrEmployee" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EmpProbation" statusTypeId="HrEmployee" description="On Probation" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EmpNoticeperiod" statusTypeId="HrEmployee" description="In Notice Period" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EmpRelieved" statusTypeId="HrEmployee" description="Relieved" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="EmpTerminated" statusTypeId="HrEmployee" description="Terminated" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="EmpAbsconding" statusTypeId="HrEmployee" description="Absconding" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EmpProbation" toStatusId="EmpActive" transitionName="Confirm"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EmpActive" toStatusId="EmpNoticeperiod" transitionName="Resign"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EmpNoticeperiod" toStatusId="EmpRelieved" transitionName="Relieve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EmpActive" toStatusId="EmpTerminated" transitionName="Terminate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EmpActive" toStatusId="EmpAbsconding" transitionName="Mark Absconding"/>
        </seed-data>
    </entity>

    <!-- ========== Department ========== -->
    <entity entity-name="Department" package="zenith.erp.hr">
        <field name="departmentId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="departmentName" type="text-medium"/>
        <field name="parentDepartmentId" type="id"/>
        <field name="headEmployeeId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" title="Parent" related="zenith.erp.hr.Department">
            <key-map field-name="parentDepartmentId" related="departmentId"/></relationship>
    </entity>

    <!-- ========== Designation ========== -->
    <entity entity-name="Designation" package="zenith.erp.hr">
        <field name="designationId" type="id" is-pk="true"/>
        <field name="designationName" type="text-medium"/>
        <field name="level" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== Leave Application ========== -->
    <entity entity-name="LeaveApplication" package="zenith.erp.hr" table-name="ZENITH_HR_LEAVE_APP">
        <field name="leaveApplicationId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="leaveType" type="text-short"><description>EL, CL, SL, LWP, CompOff, Maternity, Paternity</description></field>
        <field name="fromDate" type="date"/>
        <field name="toDate" type="date"/>
        <field name="totalDays" type="number-decimal"/>
        <field name="reason" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="approvedByEmployeeId" type="id"/>
        <field name="approvalDate" type="date-time"/>
        <field name="rejectionReason" type="text-medium"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="LeaveApplication" description="Leave Application"/>
            <moqui.basic.StatusItem statusId="LvPending" statusTypeId="LeaveApplication" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="LvApproved" statusTypeId="LeaveApplication" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="LvRejected" statusTypeId="LeaveApplication" description="Rejected" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="LvCancelled" statusTypeId="LeaveApplication" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvPending" toStatusId="LvApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvPending" toStatusId="LvRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvPending" toStatusId="LvCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== Employee Document ========== -->
    <entity entity-name="EmployeeDocument" package="zenith.erp.hr">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="documentType" type="text-short"/>
        <field name="documentName" type="text-medium"/>
        <field name="uploadDate" type="date-time"/>
        <field name="expiryDate" type="date"/>
        <field name="remarks" type="text-medium"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <!-- ========== Full & Final Settlement ========== -->
    <entity entity-name="FullAndFinal" package="zenith.erp.hr">
        <field name="fnfId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="lastWorkingDate" type="date"/>
        <field name="settlementDate" type="date"/>
        <field name="pendingSalary" type="currency-amount"/>
        <field name="leaveEncashmentDays" type="number-decimal"/>
        <field name="leaveEncashmentAmount" type="currency-amount"/>
        <field name="gratuityAmount" type="currency-amount"/>
        <field name="bonusAmount" type="currency-amount"/>
        <field name="noticePeriodRecovery" type="currency-amount"/>
        <field name="otherDeductions" type="currency-amount"/>
        <field name="otherEarnings" type="currency-amount"/>
        <field name="withholdingTaxAmount" type="currency-amount"/>
        <field name="retirementFundSettlement" type="currency-amount"/>
        <field name="netPayable" type="currency-amount"/>
        <field name="statusId" type="id"/>
        <field name="remarks" type="text-long"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <!-- ========== View: Employee List ========== -->
    <view-entity entity-name="EmployeeListView" package="zenith.erp.hr">
        <member-entity entity-alias="EMP" entity-name="zenith.erp.hr.Employee"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="EMP">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="DEP" entity-name="zenith.erp.hr.Department" join-from-alias="EMP" join-optional="true">
            <key-map field-name="departmentId"/></member-entity>
        <member-entity entity-alias="DES" entity-name="zenith.erp.hr.Designation" join-from-alias="EMP" join-optional="true">
            <key-map field-name="designationId"/></member-entity>
        <alias entity-alias="EMP" name="employeeId"/>
        <alias entity-alias="EMP" name="partyId"/>
        <alias entity-alias="EMP" name="employeeCode"/>
        <alias entity-alias="EMP" name="joiningDate"/>
        <alias entity-alias="EMP" name="statusId"/>
        <alias entity-alias="EMP" name="employmentType"/>
        <alias entity-alias="EMP" name="departmentId"/>
        <alias entity-alias="EMP" name="designationId"/>
        <alias entity-alias="EMP" name="taxIdNumber"/>
        <alias entity-alias="EMP" name="ctcAnnual"/>
        <alias entity-alias="EMP" name="regionGeoId"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="DEP" name="departmentName"/>
        <alias entity-alias="DES" name="designationName"/>
    </view-entity>
    <!-- ========== Performance Management (OKRs) ========== -->
    <entity entity-name="OkrObjective" package="zenith.erp.hr">
        <field name="objectiveId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="cycleId" type="id"/>
        <field name="title" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="progressPercent" type="number-decimal" default="0"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <entity entity-name="OkrKeyResult" package="zenith.erp.hr">
        <field name="keyResultId" type="id" is-pk="true"/>
        <field name="objectiveId" type="id"/>
        <field name="title" type="text-medium"/>
        <field name="targetValue" type="number-decimal"/>
        <field name="currentValue" type="number-decimal" default="0"/>
        <field name="progressPercent" type="number-decimal" default="0"/>
        <relationship type="one" related="zenith.erp.hr.OkrObjective"/>
    </entity>

    <!-- ========== Performance Management (Appraisals & 360) ========== -->
    <entity entity-name="AppraisalReview" package="zenith.erp.hr">
        <field name="reviewId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/> <!-- The employee being reviewed -->
        <field name="reviewerEmployeeId" type="id"/> <!-- The peer/manager writing the review -->
        <field name="cycleId" type="id"/>
        <field name="reviewType" type="text-short"><description>Manager, Peer, Self</description></field>
        <field name="statusId" type="id"/>
        <field name="rating" type="number-integer"/>
        <field name="feedbackText" type="text-long"/>
        <relationship type="one" title="Subject" related="zenith.erp.hr.Employee">
            <key-map field-name="employeeId"/>
        </relationship>
        <relationship type="one" title="Reviewer" related="zenith.erp.hr.Employee">
            <key-map field-name="reviewerEmployeeId" related="employeeId"/>
        </relationship>
        <seed-data>
            <!-- V2 Roadmap: Employee Nomination Workflow -->
            <moqui.basic.StatusType statusTypeId="AppraisalReview" description="Appraisal Review Status"/>
            <moqui.basic.StatusItem statusId="RevNominated" statusTypeId="AppraisalReview" description="Nominated by Employee" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RevPending" statusTypeId="AppraisalReview" description="Pending (Manager Approved)" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RevCompleted" statusTypeId="AppraisalReview" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RevRejected" statusTypeId="AppraisalReview" description="Rejected by Manager" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== Learning Management System (LMS) ========== -->
    <entity entity-name="TrainingCourse" package="zenith.erp.hr">
        <field name="courseId" type="id" is-pk="true"/>
        <field name="courseName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="isMandatoryCompliance" type="text-indicator" default="'N'"/>
    </entity>

    <entity entity-name="EmployeeTraining" package="zenith.erp.hr">
        <field name="employeeTrainingId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="courseId" type="id"/>
        <field name="assignedDate" type="date-time"/>
        <field name="dueDate" type="date"/>
        <field name="completionDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
        <relationship type="one" related="zenith.erp.hr.TrainingCourse"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="EmployeeTraining" description="Training Status"/>
            <moqui.basic.StatusItem statusId="TrnAssigned" statusTypeId="EmployeeTraining" description="Assigned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="TrnInProgress" statusTypeId="EmployeeTraining" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="TrnCompleted" statusTypeId="EmployeeTraining" description="Completed" sequenceNum="3"/>
        </seed-data>
    </entity>

</entities>
