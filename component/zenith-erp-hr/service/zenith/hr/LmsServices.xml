<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="assign" noun="MandatoryTraining">
        <description>
            Assigns a mandatory compliance training course to an employee.
        </description>
        <in-parameters>
            <parameter name="employeeId" type="String" required="true"/>
            <parameter name="courseId" type="String" required="true"/>
            <parameter name="dueDate" type="Date" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="create#zenith.erp.hr.EmployeeTraining"
                          in-map="[employeeId:employeeId, courseId:courseId, dueDate:dueDate, assignedDate:ec.user.nowTimestamp, statusId:'TrnAssigned']"/>
            <message>Mandatory Training successfully assigned.</message>
        </actions>
    </service>

    <service verb="complete" noun="Training">
        <description>
            Marks a compliance training as completed.
        </description>
        <in-parameters>
            <parameter name="employeeTrainingId" type="String" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.hr.EmployeeTraining" value-field="training">
                <field-map field-name="employeeTrainingId"/>
            </entity-find-one>
            <script><![CDATA[
                if (training) {
                    training.statusId = 'TrnCompleted'
                    training.completionDate = ec.user.nowTimestamp
                    training.update()
                    ec.message.addMessage("Training Marked as Completed.")
                } else {
                    ec.message.addError("Training Record not found.")
                }
            ]]></script>
        </actions>
    </service>

</services>
