<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="calculate" noun="OkrProgress">
        <description>
            Calculates the roll-up progress of an OKR Objective based on its Key Results.
        </description>
        <in-parameters>
            <parameter name="objectiveId" type="String" required="true"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.hr.OkrKeyResult" list="keyResults">
                <econdition field-name="objectiveId"/>
            </entity-find>
            <script><![CDATA[
                if (keyResults) {
                    BigDecimal totalPercent = 0.0
                    for (kr in keyResults) {
                        BigDecimal target = kr.targetValue ?: 1.0
                        BigDecimal current = kr.currentValue ?: 0.0
                        kr.progressPercent = (current / target) * 100.0
                        if (kr.progressPercent > 100.0) kr.progressPercent = 100.0
                        kr.update()
                        totalPercent += kr.progressPercent
                    }
                    BigDecimal objProgress = totalPercent / keyResults.size()
                    
                    def obj = ec.entity.find("zenith.erp.hr.OkrObjective").condition("objectiveId", objectiveId).one()
                    if (obj) {
                        obj.progressPercent = objProgress
                        obj.update()
                    }
                }
            ]]></script>
        </actions>
    </service>

    <service verb="start" noun="AppraisalCycle">
        <description>
            Starts a 360 appraisal cycle. 
            V1: Manager manually selects peers. 
            V2: Will integrate with 'RevNominated' status for Employee Nominations.
        </description>
        <in-parameters>
            <parameter name="employeeId" type="String" required="true"/>
            <parameter name="cycleId" type="String" required="true"/>
            <parameter name="managerEmployeeId" type="String" required="true"/>
            <parameter name="peerEmployeeIds" type="List"/> <!-- Manual selection by Manager -->
        </in-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 5): the subject, the manager-reviewer, and every peer must all be employees of YOUR org. -->
            <iterate list="([employeeId, managerEmployeeId] + (peerEmployeeIds ?: []))" entry="_eid">
                <if condition="_eid">
                    <service-call name="zenith.base.SecurityServices.assert#EmployeeOrgAccess" out-map="_ea" in-map="[employeeId:_eid]"/>
                    <if condition="!_ea.allowed"><return error="true" message="All reviewers must be employees of your organization."/></if>
                </if>
            </iterate>
            <!-- 1. Manager Review Task -->
            <service-call name="create#zenith.erp.hr.AppraisalReview"
                          in-map="[employeeId:employeeId, reviewerEmployeeId:managerEmployeeId, cycleId:cycleId, reviewType:'Manager', statusId:'RevPending']"/>
            
            <!-- 2. Self Review Task -->
            <service-call name="create#zenith.erp.hr.AppraisalReview"
                          in-map="[employeeId:employeeId, reviewerEmployeeId:employeeId, cycleId:cycleId, reviewType:'Self', statusId:'RevPending']"/>
            
            <!-- 3. Peer Review Tasks (Manager Override / Selection) -->
            <iterate list="peerEmployeeIds" entry="peerId">
                <service-call name="create#zenith.erp.hr.AppraisalReview"
                              in-map="[employeeId:employeeId, reviewerEmployeeId:peerId, cycleId:cycleId, reviewType:'Peer', statusId:'RevPending']"/>
            </iterate>
            
            <message>Appraisal Cycle successfully started. Reviewers have been assigned.</message>
        </actions>
    </service>

</services>
