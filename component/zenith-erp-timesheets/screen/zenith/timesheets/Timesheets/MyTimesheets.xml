<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Timesheets" default-menu-index="1">

    <transition name="createTimesheet">
        <service-call name="zenith.timesheets.TimesheetsServices.create#Timesheet"/>
        <default-response url="."/>
    </transition>
    <transition name="editTimesheet">
        <default-response url="../EditTimesheet"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timesheets.TimesheetListView" list="timesheetList">
            <search-form-inputs default-order-by="-weekStartDate"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="lastName,firstName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <econdition field-name="statusTypeId" value="TimesheetStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="My Timesheets"/>
            <box-toolbar>
                <container-dialog id="NewTimesheetDialog" button-text="New Timesheet">
                    <form-single name="CreateTimesheetForm" transition="createTimesheet">
                        <field name="partyId"><default-field title="Employee">
                            <drop-down>
                                <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${partyId}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="organizationPartyId"><default-field title="Organization">
                            <drop-down>
                                <list-options list="orgList" key="${partyId}" text="${organizationName ?: (firstName + ' ' + lastName)} [${partyId}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="weekStartDate"><default-field title="Week Start Date">
                            <date-time type="date"/>
                        </default-field></field>
                        <field name="notes"><default-field title="Notes">
                            <text-area rows="3" cols="60"/>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Create Timesheet">
                            <submit/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search My Timesheets..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TimesheetListForm" list="timesheetList" header-dialog="true">
                    <field name="timesheetId"><header-field title="ID" show-order-by="true"/>
                        <default-field>
                            <link url="editTimesheet" text="${timesheetId}" link-type="anchor">
                                <parameter name="timesheetId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="employeeName"><default-field title="Employee">
                        <display text="${firstName ?: ''} ${lastName ?: ''}"/>
                    </default-field></field>
                    <field name="partyId"><header-field title="Employee">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </header-field></field>
                    <field name="weekStartDate"><header-field title="Week Start" show-order-by="true"/>
                        <default-field>
                            <display format="yyyy-MM-dd"/>
                        </default-field>
                    </field>
                    <field name="weekEndDate"><header-field title="Week End" show-order-by="true"/>
                        <default-field>
                            <display format="yyyy-MM-dd"/>
                        </default-field>
                    </field>
                    <field name="totalHours"><header-field title="Total Hours" show-order-by="true"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="statusId"><header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                        </default-field>
                    </field>
                    <field name="submitBtn"><header-field title="Find">
                        <submit/>
                    </header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
