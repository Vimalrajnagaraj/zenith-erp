<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Timesheets" default-menu-index="2">

    <transition name="approveTimesheet">
        <service-call name="zenith.timesheets.TimesheetsServices.approve#Timesheet"/>
        <default-response url="."/>
    </transition>
    <transition name="rejectTimesheet">
        <service-call name="zenith.timesheets.TimesheetsServices.reject#Timesheet"/>
        <default-response url="."/>
    </transition>
    <transition name="editTimesheet">
        <default-response url="../EditTimesheet"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timesheets.TimesheetListView" list="timesheetList">
            <search-form-inputs default-order-by="-weekStartDate"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <econdition field-name="statusTypeId" value="TimesheetStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="lastName,firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Timesheets (Manager View)"/>
            <box-body>
                <form-list name="AllTimesheetsForm" list="timesheetList" header-dialog="true">
                    <field name="timesheetId"><header-field title="ID" show-order-by="true"/>
                        <default-field>
                            <link url="editTimesheet" text="${timesheetId}" link-type="anchor">
                                <parameter name="timesheetId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="employeeName"><default-field title="Employee">
                        <display text="${firstName ?: ''} ${lastName ?: ''}"/>
                    </default-field></field>
                    <field name="partyId"><header-field title="Employee">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${firstName} ${lastName}"/>
                        </drop-down>
                    </header-field></field>
                    <field name="weekStartDate"><header-field title="Week Start" show-order-by="true"/>
                        <default-field>
                            <display format="yyyy-MM-dd"/>
                        </default-field>
                    </field>
                    <field name="weekEndDate"><header-field title="Week End" show-order-by="true"/>
                        <default-field>
                            <display format="yyyy-MM-dd"/>
                        </default-field>
                    </field>
                    <field name="totalHours"><header-field title="Total Hours" show-order-by="true"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="statusId"><header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                        </default-field>
                    </field>
                    <field name="actions"><default-field title="Actions">
                        <section name="ApproveRejectSection">
                            <condition><expression>statusId == 'TsSubmitted'</expression></condition>
                            <widgets>
                                <link url="approveTimesheet" text="Approve" link-type="anchor" style="text-positive"
                                        confirmation="Approve this timesheet?">
                                    <parameter name="timesheetId"/>
                                </link>
                                <label text=" | " type="span"/>
                                <link url="rejectTimesheet" text="Reject" link-type="anchor" style="text-negative"
                                        confirmation="Reject this timesheet?">
                                    <parameter name="timesheetId"/>
                                </link>
                            </widgets>
                            <fail-widgets>
                                <label text="-" type="span"/>
                            </fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="submitBtn"><header-field title="Find">
                        <submit/>
                    </header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
