<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Timesheet" default-menu-index="99">

    <parameter name="timesheetId" required="true"/>

    <transition name="submitTimesheet">
        <service-call name="zenith.timesheets.TimesheetsServices.submit#Timesheet"/>
        <default-response url="."/>
    </transition>
    <transition name="addEntry">
        <service-call name="zenith.timesheets.TimesheetsServices.add#TimesheetEntry"/>
        <default-response url="."/>
    </transition>
    <transition name="updateEntry">
        <service-call name="zenith.timesheets.TimesheetsServices.update#TimesheetEntry"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteEntry">
        <service-call name="zenith.timesheets.TimesheetsServices.delete#TimesheetEntry"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.timesheets.Timesheet" value-field="timesheet">
            <field-map field-name="timesheetId"/>
        </entity-find-one>
        <entity-find entity-name="zenith.erp.timesheets.TimesheetEntry" list="entryList">
            <econdition field-name="timesheetId"/>
            <order-by field-name="workDate"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="lastName,firstName"/>
        </entity-find>

        <!-- Look up employee name -->
        <entity-find-one entity-name="mantle.party.Person" value-field="employeePerson">
            <field-map field-name="partyId" from="timesheet.partyId"/>
        </entity-find-one>
        <set field="employeeName" from="(employeePerson?.firstName ?: '') + ' ' + (employeePerson?.lastName ?: '')"/>
    </actions>

    <widgets>
        <!-- Timesheet Header Info -->
        <container style="q-my-md">
            <label text="Timesheet: ${timesheetId}" type="h3"/>
        </container>

        <form-single name="TimesheetHeaderForm" map="timesheet">
            <field name="timesheetId"><default-field title="Timesheet ID">
                <display/>
            </default-field></field>
            <field name="employeeName"><default-field title="Employee">
                <display text="${employeeName}"/>
            </default-field></field>
            <field name="weekStartDate"><default-field title="Week Start">
                <display format="yyyy-MM-dd"/>
            </default-field></field>
            <field name="weekEndDate"><default-field title="Week End">
                <display format="yyyy-MM-dd"/>
            </default-field></field>
            <field name="statusId"><default-field title="Status">
                <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
            </default-field></field>
            <field name="totalHours"><default-field title="Total Hours">
                <display/>
            </default-field></field>
        </form-single>

        <!-- Submit Button (only when Draft) -->
        <section name="SubmitSection">
            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
            <widgets>
                <container style="q-my-md">
                    <form-single name="SubmitTimesheetForm" transition="submitTimesheet">
                        <field name="timesheetId"><default-field>
                            <hidden/>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Submit for Approval">
                            <submit confirmation="Submit this timesheet for approval?"/>
                        </default-field></field>
                    </form-single>
                </container>
            </widgets>
        </section>

        <!-- Time Entries Section -->
        <container-box>
            <box-header title="Time Entries"/>
            <box-toolbar>
                <section name="AddEntrySection">
                    <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                    <widgets>
                        <container-dialog id="AddEntryDialog" button-text="Add Entry">
                            <form-single name="AddEntryForm" transition="addEntry">
                                <field name="timesheetId"><default-field>
                                    <hidden/>
                                </default-field></field>
                                <field name="workDate"><default-field title="Work Date">
                                    <date-time type="date"/>
                                </default-field></field>
                                <field name="hours"><default-field title="Hours">
                                    <text-line size="6"/>
                                </default-field></field>
                                <field name="taskDescription"><default-field title="Task">
                                    <text-line size="40"/>
                                </default-field></field>
                                <field name="description"><default-field title="Description">
                                    <text-line size="60"/>
                                </default-field></field>
                                <field name="billable"><default-field title="Billable">
                                    <drop-down>
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="submitBtn"><default-field title="Add Entry">
                                    <submit/>
                                </default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </box-toolbar>
            <box-body>
                <form-list name="EntriesListForm" list="entryList" transition="updateEntry">
                    <field name="entryId"><default-field title="Entry ID">
                        <display/>
                    </default-field></field>
                    <field name="workDate"><default-field title="Date">
                        <section name="WorkDateEditSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets><date-time type="date"/></widgets>
                            <fail-widgets><display format="yyyy-MM-dd"/></fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="hours"><default-field title="Hours">
                        <section name="HoursEditSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets><text-line size="6"/></widgets>
                            <fail-widgets><display/></fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="taskDescription"><default-field title="Task">
                        <section name="TaskEditSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets><text-line size="30"/></widgets>
                            <fail-widgets><display/></fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="description"><default-field title="Description">
                        <section name="DescEditSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets><text-line size="40"/></widgets>
                            <fail-widgets><display/></fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="billable"><default-field title="Billable">
                        <section name="BillableEditSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets>
                                <drop-down>
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </widgets>
                            <fail-widgets><display/></fail-widgets>
                        </section>
                    </default-field></field>
                    <field name="updateBtn"><default-field title="">
                        <section name="UpdateBtnSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets><submit text="Update"/></widgets>
                        </section>
                    </default-field></field>
                    <field name="deleteBtn"><default-field title="">
                        <section name="DeleteBtnSection">
                            <condition><expression>timesheet.statusId == 'TsDraft'</expression></condition>
                            <widgets>
                                <!-- ZE-BC-DELETE-001 sweep: link-type="anchor" (GET) is rejected on a WRITE
                                     transition; drop it so the delete POSTs. -->
                                <link url="deleteEntry" text="Delete" style="text-negative"
                                        confirmation="Delete this time entry?">
                                    <parameter name="entryId"/>
                                    <parameter name="timesheetId"/>
                                </link>
                            </widgets>
                        </section>
                    </default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
