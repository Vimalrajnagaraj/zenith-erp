<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Timesheets" default-menu-index="51">

    <always-actions>
        <set field="html_title" value="Timesheets"/>
    </always-actions>

    <subscreens default-item="MyTimesheets">
        <subscreens-item name="EditTimesheet" menu-include="false" location="component://zenith-erp-timesheets/screen/zenith/timesheets/Timesheets/EditTimesheet.xml"/>
    </subscreens>

    <transition name="goProject"><default-response url="../project/Projects"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>

    <widgets>
        <container style="q-my-md">
            <section name="gate_project_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('project'))"><widgets><link url="goProject" text="Projects" link-type="anchor" style="q-mr-md"/></widgets></section>
            <section name="gate_hr_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('hr'))"><widgets><link url="goHr" text="HR / Employees" link-type="anchor"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
