<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Timesheet Entity ========== -->
    <entity entity-name="Timesheet" package="zenith.erp.timesheets" table-name="ZENITH_TIMESHEET" short-alias="Timesheet">
        <field name="timesheetId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="weekStartDate" type="date"/>
        <field name="weekEndDate" type="date"/>
        <field name="totalHours" type="number-decimal"/>
        <field name="notes" type="text-long"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="approvedDate" type="date-time"/>

        <relationship type="one" title="Employee" related="mantle.party.Party">
            <key-map field-name="partyId"/>
        </relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="ApprovedBy" related="mantle.party.Party">
            <key-map field-name="approvedByPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="Timesheet" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>

        <seed-data>
            <!-- Status Type -->
            <moqui.basic.StatusType statusTypeId="TimesheetStatus" description="Timesheet Status"/>

            <!-- Status Items -->
            <moqui.basic.StatusItem statusId="TsDraft" statusTypeId="TimesheetStatus"
                    description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="TsSubmitted" statusTypeId="TimesheetStatus"
                    description="Submitted" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="TsApproved" statusTypeId="TimesheetStatus"
                    description="Approved" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="TsRejected" statusTypeId="TimesheetStatus"
                    description="Rejected" sequenceNum="4"/>

            <!-- Status Flow Transitions -->
            <moqui.basic.StatusFlowTransition statusFlowTransitionId="TsDraft_TsSubmitted"
                    statusId="TsDraft" toStatusId="TsSubmitted" transitionName="Submit"/>
            <moqui.basic.StatusFlowTransition statusFlowTransitionId="TsSubmitted_TsApproved"
                    statusId="TsSubmitted" toStatusId="TsApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowTransitionId="TsSubmitted_TsRejected"
                    statusId="TsSubmitted" toStatusId="TsRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowTransitionId="TsRejected_TsDraft"
                    statusId="TsRejected" toStatusId="TsDraft" transitionName="Reopen"/>
        </seed-data>
    </entity>

    <!-- ========== TimesheetEntry Entity ========== -->
    <entity entity-name="TimesheetEntry" package="zenith.erp.timesheets" short-alias="TimesheetEntry">
        <field name="entryId" type="id" is-pk="true"/>
        <field name="timesheetId" type="id"/>
        <field name="workDate" type="date"/>
        <field name="hours" type="number-decimal"/>
        <field name="projectId" type="id"/>
        <field name="taskDescription" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="billable" type="text-indicator" default="'Y'"/>

        <relationship type="one" related="zenith.erp.timesheets.Timesheet">
            <key-map field-name="timesheetId"/>
        </relationship>
    </entity>

    <!-- ========== TimesheetListView View Entity ========== -->
    <view-entity entity-name="TimesheetListView" package="zenith.erp.timesheets">
        <member-entity entity-alias="TS" entity-name="zenith.erp.timesheets.Timesheet"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="TS" join-optional="true">
            <key-map field-name="partyId"/>
        </member-entity>

        <alias entity-alias="TS" name="timesheetId"/>
        <alias entity-alias="TS" name="partyId"/>
        <alias entity-alias="TS" name="organizationPartyId"/>
        <alias entity-alias="TS" name="statusId"/>
        <alias entity-alias="TS" name="weekStartDate"/>
        <alias entity-alias="TS" name="weekEndDate"/>
        <alias entity-alias="TS" name="totalHours"/>
        <alias entity-alias="TS" name="approvedByPartyId"/>
        <alias entity-alias="TS" name="approvedDate"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>

</entities>
