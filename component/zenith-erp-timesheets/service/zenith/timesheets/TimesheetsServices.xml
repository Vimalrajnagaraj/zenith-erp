<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Create Timesheet ========== -->
    <service verb="create" noun="Timesheet">
        <description>Create a new Timesheet in Draft status with calculated week end date.</description>
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="weekStartDate" type="java.sql.Date" required="true"/>
            <parameter name="notes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="timesheetId"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="TsDraft"/>
            <set field="totalHours" value="0" type="BigDecimal"/>

            <!-- Calculate weekEndDate = weekStartDate + 6 days -->
            <script><![CDATA[
                def cal = Calendar.getInstance()
                cal.setTime(weekStartDate)
                cal.add(Calendar.DAY_OF_MONTH, 6)
                weekEndDate = new java.sql.Date(cal.getTimeInMillis())
            ]]></script>

            <service-call name="create#zenith.erp.timesheets.Timesheet" in-map="context" out-map="context"/>
        </actions>
    </service>

    <!-- ========== Add Timesheet Entry ========== -->
    <service verb="add" noun="TimesheetEntry">
        <description>Add a time entry to a timesheet and recalculate total hours.</description>
        <in-parameters>
            <parameter name="timesheetId" required="true"/>
            <parameter name="workDate" type="java.sql.Date" required="true"/>
            <parameter name="hours" type="BigDecimal" required="true"/>
            <parameter name="projectId"/>
            <parameter name="taskDescription"/>
            <parameter name="description"/>
            <parameter name="billable" default-value="Y"/>
        </in-parameters>
        <out-parameters>
            <parameter name="entryId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.timesheets.TimesheetEntry" in-map="context" out-map="context"/>
            <service-call name="zenith.timesheets.TimesheetsServices.recalculate#TimesheetHours"
                    in-map="[timesheetId:timesheetId]"/>
        </actions>
    </service>

    <!-- ========== Update Timesheet Entry ========== -->
    <service verb="update" noun="TimesheetEntry">
        <description>Update an existing time entry and recalculate total hours.</description>
        <in-parameters>
            <parameter name="entryId" required="true"/>
            <parameter name="workDate" type="java.sql.Date"/>
            <parameter name="hours" type="BigDecimal"/>
            <parameter name="projectId"/>
            <parameter name="taskDescription"/>
            <parameter name="description"/>
            <parameter name="billable"/>
        </in-parameters>
        <out-parameters>
            <parameter name="entryId"/>
        </out-parameters>
        <actions>
            <!-- Get timesheetId from the entry before updating -->
            <entity-find-one entity-name="zenith.erp.timesheets.TimesheetEntry" value-field="entry">
                <field-map field-name="entryId"/>
            </entity-find-one>
            <set field="timesheetId" from="entry.timesheetId"/>

            <service-call name="update#zenith.erp.timesheets.TimesheetEntry" in-map="context"/>
            <service-call name="zenith.timesheets.TimesheetsServices.recalculate#TimesheetHours"
                    in-map="[timesheetId:timesheetId]"/>
        </actions>
    </service>

    <!-- ========== Delete Timesheet Entry ========== -->
    <service verb="delete" noun="TimesheetEntry">
        <description>Delete a time entry and recalculate total hours.</description>
        <in-parameters>
            <parameter name="entryId" required="true"/>
        </in-parameters>
        <actions>
            <!-- Get timesheetId before deleting -->
            <entity-find-one entity-name="zenith.erp.timesheets.TimesheetEntry" value-field="entry">
                <field-map field-name="entryId"/>
            </entity-find-one>
            <set field="timesheetId" from="entry.timesheetId"/>

            <service-call name="delete#zenith.erp.timesheets.TimesheetEntry"
                    in-map="[entryId:entryId]"/>
            <service-call name="zenith.timesheets.TimesheetsServices.recalculate#TimesheetHours"
                    in-map="[timesheetId:timesheetId]"/>
        </actions>
    </service>

    <!-- ========== Submit Timesheet ========== -->
    <service verb="submit" noun="Timesheet">
        <description>Submit a timesheet for approval. Must be in Draft status.</description>
        <in-parameters>
            <parameter name="timesheetId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.timesheets.Timesheet" value-field="timesheet">
                <field-map field-name="timesheetId"/>
            </entity-find-one>

            <if condition="timesheet.statusId != 'TsDraft'">
                <return error="true" message="Timesheet must be in Draft status to submit. Current status: ${timesheet.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.timesheets.Timesheet"
                    in-map="[timesheetId:timesheetId, statusId:'TsSubmitted']"/>
        </actions>
    </service>

    <!-- ========== Approve Timesheet ========== -->
    <service verb="approve" noun="Timesheet">
        <description>Approve a submitted timesheet. Must be in Submitted status.</description>
        <in-parameters>
            <parameter name="timesheetId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.timesheets.Timesheet" value-field="timesheet">
                <field-map field-name="timesheetId"/>
            </entity-find-one>

            <if condition="timesheet.statusId != 'TsSubmitted'">
                <return error="true" message="Timesheet must be in Submitted status to approve. Current status: ${timesheet.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.timesheets.Timesheet"
                    in-map="[timesheetId:timesheetId, statusId:'TsApproved',
                             approvedByPartyId:ec.user.userId,
                             approvedDate:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <!-- ========== Reject Timesheet ========== -->
    <service verb="reject" noun="Timesheet">
        <description>Reject a submitted timesheet. Must be in Submitted status.</description>
        <in-parameters>
            <parameter name="timesheetId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.timesheets.Timesheet" value-field="timesheet">
                <field-map field-name="timesheetId"/>
            </entity-find-one>

            <if condition="timesheet.statusId != 'TsSubmitted'">
                <return error="true" message="Timesheet must be in Submitted status to reject. Current status: ${timesheet.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.timesheets.Timesheet"
                    in-map="[timesheetId:timesheetId, statusId:'TsRejected']"/>
        </actions>
    </service>

    <!-- ========== Recalculate Timesheet Hours ========== -->
    <service verb="recalculate" noun="TimesheetHours">
        <description>Recalculate total hours on a timesheet by summing all entry hours.</description>
        <in-parameters>
            <parameter name="timesheetId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.timesheets.TimesheetEntry" list="entryList">
                <econdition field-name="timesheetId"/>
            </entity-find>

            <set field="totalHours" value="0" type="BigDecimal"/>
            <iterate list="entryList" entry="entry">
                <set field="totalHours" from="totalHours + (entry.hours ?: 0)"/>
            </iterate>

            <service-call name="update#zenith.erp.timesheets.Timesheet"
                    in-map="[timesheetId:timesheetId, totalHours:totalHours]"/>
        </actions>
    </service>

</services>
