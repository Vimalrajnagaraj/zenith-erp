<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Rental Asset: items available for rent -->
    <entity entity-name="RentalAsset" package="zenith.erp.rental" short-alias="RentalAsset">
        <field name="rentalAssetId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="assetName" type="text-medium"/>
        <field name="serialNumber" type="text-short"/>
        <field name="categoryEnumId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="purchaseDate" type="date"/>
        <field name="purchaseCost" type="currency-amount"/>
        <field name="replacementCost" type="currency-amount"/>
        <field name="dailyRate" type="currency-amount"/>
        <field name="weeklyRate" type="currency-amount"/>
        <field name="monthlyRate" type="currency-amount"/>
        <field name="securityDeposit" type="currency-amount"/>
        <field name="conditionEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="lastMaintenanceDate" type="date"/>
        <field name="nextMaintenanceDate" type="date"/>
        <field name="notes" type="text-long"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="RentalCategory" description="Rental Asset Category"/>
            <moqui.basic.Enumeration enumId="RcEquipment" enumTypeId="RentalCategory" description="Equipment" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RcVehicle" enumTypeId="RentalCategory" description="Vehicle" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RcFurniture" enumTypeId="RentalCategory" description="Furniture" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RcElectronics" enumTypeId="RentalCategory" description="Electronics" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RcTools" enumTypeId="RentalCategory" description="Tools" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="RcOther" enumTypeId="RentalCategory" description="Other" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="AssetCondition" description="Rental Asset Condition"/>
            <moqui.basic.Enumeration enumId="AcNew" enumTypeId="AssetCondition" description="New" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AcGood" enumTypeId="AssetCondition" description="Good" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="AcFair" enumTypeId="AssetCondition" description="Fair" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="AcPoor" enumTypeId="AssetCondition" description="Poor" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="AcDamaged" enumTypeId="AssetCondition" description="Damaged" sequenceNum="5"/>

            <moqui.basic.StatusType statusTypeId="RentalAsset" description="Rental Asset Status"/>
            <moqui.basic.StatusItem statusId="RaAvailable" statusTypeId="RentalAsset" description="Available" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RaRented" statusTypeId="RentalAsset" description="Rented Out" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RaMaintenance" statusTypeId="RentalAsset" description="Under Maintenance" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RaReserved" statusTypeId="RentalAsset" description="Reserved" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="RaRetired" statusTypeId="RentalAsset" description="Retired" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaAvailable" toStatusId="RaRented" transitionName="Rent Out"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaAvailable" toStatusId="RaMaintenance" transitionName="Send to Maintenance"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaAvailable" toStatusId="RaReserved" transitionName="Reserve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaRented" toStatusId="RaAvailable" transitionName="Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaRented" toStatusId="RaMaintenance" transitionName="Return for Maintenance"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaMaintenance" toStatusId="RaAvailable" transitionName="Maintenance Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaReserved" toStatusId="RaRented" transitionName="Rent Out"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaReserved" toStatusId="RaAvailable" transitionName="Cancel Reservation"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaAvailable" toStatusId="RaRetired" transitionName="Retire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RaMaintenance" toStatusId="RaRetired" transitionName="Retire"/>
        </seed-data>
    </entity>

    <!-- Rental Agreement -->
    <entity entity-name="RentalAgreement" package="zenith.erp.rental" short-alias="RentalAgreement">
        <field name="rentalAgreementId" type="id" is-pk="true"/>
        <field name="agreementNumber" type="text-short"/>
        <field name="customerPartyId" type="id"/>
        <field name="billingTypeEnumId" type="id"/>
        <field name="startDate" type="date"/>
        <field name="expectedReturnDate" type="date"/>
        <field name="actualReturnDate" type="date"/>
        <field name="totalRentalAmount" type="currency-amount" default="0"/>
        <field name="totalDepositAmount" type="currency-amount" default="0"/>
        <field name="depositRefundedAmount" type="currency-amount" default="0"/>
        <field name="damageCharges" type="currency-amount" default="0"/>
        <field name="lateCharges" type="currency-amount" default="0"/>
        <field name="totalAmount" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="termsAndConditions" type="text-long"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" title="Customer" related="mantle.party.Party" short-alias="customer">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="RentalBillingType" description="Rental Billing Type"/>
            <moqui.basic.Enumeration enumId="RbtDaily" enumTypeId="RentalBillingType" description="Daily" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RbtWeekly" enumTypeId="RentalBillingType" description="Weekly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RbtMonthly" enumTypeId="RentalBillingType" description="Monthly" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RbtFixedPeriod" enumTypeId="RentalBillingType" description="Fixed Period" sequenceNum="4"/>

            <moqui.basic.StatusType statusTypeId="RentalAgreement" description="Rental Agreement Status"/>
            <moqui.basic.StatusItem statusId="RgDraft" statusTypeId="RentalAgreement" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RgActive" statusTypeId="RentalAgreement" description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RgOverdue" statusTypeId="RentalAgreement" description="Overdue" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RgReturned" statusTypeId="RentalAgreement" description="Returned" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="RgCompleted" statusTypeId="RentalAgreement" description="Completed" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="RgCancelled" statusTypeId="RentalAgreement" description="Cancelled" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgDraft" toStatusId="RgActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgActive" toStatusId="RgOverdue" transitionName="Mark Overdue"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgActive" toStatusId="RgReturned" transitionName="Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgOverdue" toStatusId="RgReturned" transitionName="Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgReturned" toStatusId="RgCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgDraft" toStatusId="RgCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- Rental Agreement Items -->
    <entity entity-name="RentalAgreementItem" package="zenith.erp.rental" short-alias="RentalAgreementItem">
        <field name="rentalAgreementId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="rentalAssetId" type="id"/>
        <field name="quantity" type="number-decimal" default="1"/>
        <field name="rateApplied" type="currency-amount"/>
        <field name="rentalAmount" type="currency-amount"/>
        <field name="depositAmount" type="currency-amount" default="0"/>
        <field name="conditionAtRent" type="id"/>
        <field name="conditionAtReturn" type="id"/>
        <field name="damageNotes" type="text-long"/>
        <field name="damageCharges" type="currency-amount" default="0"/>
        <relationship type="one" related="zenith.erp.rental.RentalAgreement" short-alias="agreement"/>
        <relationship type="one" related="zenith.erp.rental.RentalAsset" short-alias="asset"/>
    </entity>

    <!-- Rental Invoice (periodic billing) -->
    <entity entity-name="RentalInvoice" package="zenith.erp.rental" short-alias="RentalInvoice">
        <field name="rentalInvoiceId" type="id" is-pk="true"/>
        <field name="rentalAgreementId" type="id"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="periodFrom" type="date"/>
        <field name="periodTo" type="date"/>
        <field name="rentalAmount" type="currency-amount"/>
        <field name="taxAmount" type="currency-amount" default="0"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="statusId" type="id"/>
        <field name="dueDate" type="date"/>
        <field name="paidDate" type="date"/>
        <relationship type="one" related="zenith.erp.rental.RentalAgreement" short-alias="agreement"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="RentalInvoice" description="Rental Invoice Status"/>
            <moqui.basic.StatusItem statusId="RiDraft" statusTypeId="RentalInvoice" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RiSent" statusTypeId="RentalInvoice" description="Sent" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RiPaid" statusTypeId="RentalInvoice" description="Paid" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RiOverdue" statusTypeId="RentalInvoice" description="Overdue" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RiDraft" toStatusId="RiSent" transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RiSent" toStatusId="RiPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RiSent" toStatusId="RiOverdue" transitionName="Mark Overdue"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RiOverdue" toStatusId="RiPaid" transitionName="Mark Paid"/>
        </seed-data>
    </entity>

    <!-- View: RentalAgreementDetail -->
    <view-entity entity-name="RentalAgreementDetail" package="zenith.erp.rental">
        <member-entity entity-alias="RA" entity-name="zenith.erp.rental.RentalAgreement"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="RA" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="RA" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <alias-all entity-alias="RA"/>
        <alias entity-alias="ORG" name="organizationName"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>

</entities>
