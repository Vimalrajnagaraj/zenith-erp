<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices" default-menu-index="3">

    <transition name="updateInvoice">
        <service-call name="update#zenith.erp.rental.RentalInvoice"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.rental.RentalInvoice" list="invoices">
            <search-form-inputs default-order-by="-periodFrom"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Rental Invoices" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="InvoicesForm" list="invoices" transition="updateInvoice" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="rentalInvoiceId"><default-field title="Invoice #"><display/></default-field></field>
                <field name="rentalAgreementId"><default-field title="Agreement"><display/></default-field></field>
                <field name="periodFrom"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="periodTo"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="rentalAmount"><default-field title="Rental"><display format="#,##0.00"/></default-field></field>
                <field name="taxAmount"><default-field title="Tax"><display format="#,##0.00"/></default-field></field>
                <field name="totalAmount"><default-field title="Total"><display format="#,##0.00"/></default-field></field>
                <field name="dueDate"><default-field title="Due"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="RiDraft" text="Draft"/><option key="RiSent" text="Sent"/>
                        <option key="RiPaid" text="Paid"/><option key="RiOverdue" text="Overdue"/>
                    </drop-down></header-field>
                    <default-field title="Status">
                        <drop-down>
                            <entity-options key="${toStatusId}" text="${transitionName}">
                                <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                    <econdition field-name="statusFlowId" value="Default"/>
                                    <econdition field-name="statusId"/>
                                </entity-find>
                            </entity-options>
                            <option key="${statusId}" text="${statusId}"/>
                        </drop-down></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
