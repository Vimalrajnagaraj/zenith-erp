<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Agreement" default-menu-include="false">

    <parameter name="rentalAgreementId" required="true"/>

    <transition name="updateAgreement">
        <service-call name="update#zenith.erp.rental.RentalAgreement"/>
        <default-response url="."/>
    </transition>
    <transition name="activateAgreement">
        <service-call name="zenith.rental.RentalServices.activate#RentalAgreement"/>
        <default-response url="."/>
    </transition>
    <transition name="returnAgreement">
        <service-call name="zenith.rental.RentalServices.return#RentalAgreement"/>
        <default-response url="."/>
    </transition>
    <transition name="addItem">
        <service-call name="create#zenith.erp.rental.RentalAgreementItem"/>
        <default-response url="."/>
    </transition>
    <transition name="generateInvoice">
        <service-call name="zenith.rental.RentalServices.generate#RentalInvoice"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.rental.RentalAgreement" value-field="agreement"/>
        <entity-find entity-name="zenith.erp.rental.RentalAgreementItem" list="items">
            <econdition field-name="rentalAgreementId"/></entity-find>
        <entity-find entity-name="zenith.erp.rental.RentalInvoice" list="invoices">
            <econdition field-name="rentalAgreementId"/>
            <order-by field-name="-periodFrom"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Rental Agreement: ${rentalAgreementId}" type="h4" style="text-weight-bold q-my-none"/>
            <container>
                <section name="ActivateBtn" condition="agreement.statusId == 'RgDraft'">
                    <widgets>
                        <form-single name="ActivateForm" transition="activateAgreement">
                            <field name="rentalAgreementId" from="agreement.rentalAgreementId"><default-field><hidden/></default-field></field>
                            <field name="submitBtn"><default-field title="Activate"><submit type="success"/></default-field></field>
                        </form-single>
                    </widgets>
                </section>
                <section name="ReturnBtn" condition="agreement.statusId in ['RgActive', 'RgOverdue']">
                    <widgets>
                        <container-dialog id="ReturnDialog" button-text="Return" type="warning">
                            <form-single name="ReturnForm" transition="returnAgreement">
                                <field name="rentalAgreementId" from="agreement.rentalAgreementId"><default-field><hidden/></default-field></field>
                                <field name="damageCharges"><default-field title="Damage Charges"><text-line size="10" default-value="0"/></default-field></field>
                                <field name="submitBtn"><default-field title="Process Return"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </container>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Agreement Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="AgreementForm" map="agreement" transition="updateAgreement">
                        <field name="rentalAgreementId"><default-field><hidden/></default-field></field>
                        <field name="customerPartyId"><default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                        </default-field></field>
                        <field name="billingTypeEnumId"><default-field title="Billing">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="startDate"><default-field><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="expectedReturnDate"><default-field title="Expected Return"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="notes"><default-field><text-area rows="3" cols="40"/></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <!-- Items -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Rental Items" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="AddItemSection" condition="agreement.statusId == 'RgDraft'">
                            <widgets>
                                <container-dialog id="AddItem" button-text="Add Item" type="info">
                                    <form-single name="AddItemForm" transition="addItem">
                                        <field name="rentalAgreementId" from="agreement.rentalAgreementId"><default-field><hidden/></default-field></field>
                                        <field name="itemSeqId" from="String.format('%05d', (items?.size() ?: 0) + 1)"><default-field><hidden/></default-field></field>
                                        <field name="rentalAssetId"><default-field title="Asset">
                                            <drop-down><entity-options key="${rentalAssetId}" text="${assetName} (${serialNumber ?: 'No S/N'})">
                                                <entity-find entity-name="zenith.erp.rental.RentalAsset">
                                                    <econdition field-name="statusId" value="RaAvailable"/>
                                                </entity-find>
                                            </entity-options></drop-down></default-field></field>
                                        <field name="quantity"><default-field><text-line size="5" default-value="1"/></default-field></field>
                                        <field name="rateApplied"><default-field title="Rate"><text-line size="10"/></default-field></field>
                                        <field name="rentalAmount"><default-field><text-line size="10"/></default-field></field>
                                        <field name="depositAmount"><default-field title="Deposit"><text-line size="10" default-value="0"/></default-field></field>
                                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </container>
                    <form-list name="ItemsForm" list="items" skip-form="true">
                        <field name="rentalAssetId"><default-field title="Asset">
                            <display-entity entity-name="zenith.erp.rental.RentalAsset" key-field-name="rentalAssetId" text="${assetName}"/>
                        </default-field></field>
                        <field name="quantity"><default-field title="Qty"><display/></default-field></field>
                        <field name="rateApplied"><default-field title="Rate"><display format="#,##0.00"/></default-field></field>
                        <field name="rentalAmount"><default-field title="Rental"><display format="#,##0.00"/></default-field></field>
                        <field name="depositAmount"><default-field title="Deposit"><display format="#,##0.00"/></default-field></field>
                    </form-list>
                </container>

                <!-- Invoices -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Invoices" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="GenInvoiceSection" condition="agreement.statusId in ['RgActive', 'RgOverdue']">
                            <widgets>
                                <container-dialog id="GenInvoice" button-text="Generate Invoice" type="info">
                                    <form-single name="GenInvoiceForm" transition="generateInvoice">
                                        <field name="rentalAgreementId" from="agreement.rentalAgreementId"><default-field><hidden/></default-field></field>
                                        <field name="periodFrom"><default-field><date-time type="date"/></default-field></field>
                                        <field name="periodTo"><default-field><date-time type="date"/></default-field></field>
                                        <field name="dueDate"><default-field><date-time type="date"/></default-field></field>
                                        <field name="submitBtn"><default-field title="Generate"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </container>
                    <form-list name="InvoicesForm" list="invoices" skip-form="true">
                        <field name="rentalInvoiceId"><default-field title="Invoice #"><display/></default-field></field>
                        <field name="periodFrom"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="periodTo"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="totalAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                        <field name="dueDate"><default-field title="Due"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${agreement.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Total Amount" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(agreement.totalAmount ?: 0, '#,##0.00')}" type="h4" style="text-dark text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Deposit" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(agreement.totalDepositAmount ?: 0, '#,##0.00')}" type="h5" style="text-weight-bold q-my-sm"/>
                </container>
                <section name="DamageCard" condition="agreement.damageCharges &amp;&amp; agreement.damageCharges > 0">
                    <widgets>
                        <container style="zenith-card bg-negative shadow-2 border-radius-lg q-pa-lg q-mb-md text-center text-white">
                            <label text="Damage Charges" type="p" style="text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${ec.l10n.format(agreement.damageCharges, '#,##0.00')}" type="h5" style="text-weight-bold"/>
                        </container>
                    </widgets>
                </section>
            </row-col>
        </container-row>
    </widgets>
</screen>
