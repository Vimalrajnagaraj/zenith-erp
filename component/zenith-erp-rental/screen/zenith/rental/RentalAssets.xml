<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rental Assets" default-menu-index="1">

    <transition name="createAsset">
        <service-call name="create#zenith.erp.rental.RentalAsset"/>
        <default-response url="."/>
    </transition>
    <transition name="updateAsset">
        <service-call name="update#zenith.erp.rental.RentalAsset"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.rental.RentalAsset" list="assets">
            <search-form-inputs default-order-by="assetName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Rental Assets" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateAsset" button-text="New Asset" type="success">
                <form-single name="CreateAssetForm" transition="createAsset">
                    <field name="assetName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                    <field name="categoryEnumId"><default-field title="Category">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="RentalCategory"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="dailyRate"><default-field><text-line size="10"/></default-field></field>
                    <field name="weeklyRate"><default-field><text-line size="10"/></default-field></field>
                    <field name="monthlyRate"><default-field><text-line size="10"/></default-field></field>
                    <field name="securityDeposit"><default-field><text-line size="10"/></default-field></field>
                    <field name="purchaseCost"><default-field><text-line size="10"/></default-field></field>
                    <field name="conditionEnumId" from="'AcNew'"><default-field title="Condition">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="AssetCondition"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="statusId" from="'RaAvailable'"><default-field><hidden/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AssetsForm" list="assets" transition="updateAsset" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="rentalAssetId"><default-field><hidden/></default-field></field>
                <field name="assetName"><default-field title="Name"><display/></default-field></field>
                <field name="serialNumber"><default-field><display/></default-field></field>
                <field name="categoryEnumId"><default-field title="Category">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="dailyRate"><default-field title="Daily"><display format="#,##0.00"/></default-field></field>
                <field name="weeklyRate"><default-field title="Weekly"><display format="#,##0.00"/></default-field></field>
                <field name="monthlyRate"><default-field title="Monthly"><display format="#,##0.00"/></default-field></field>
                <field name="securityDeposit"><default-field title="Deposit"><display format="#,##0.00"/></default-field></field>
                <field name="conditionEnumId"><default-field title="Condition">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="RaAvailable" text="Available"/><option key="RaRented" text="Rented"/>
                        <option key="RaMaintenance" text="Maintenance"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
