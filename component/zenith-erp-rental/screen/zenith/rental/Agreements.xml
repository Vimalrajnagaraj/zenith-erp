<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Agreements" default-menu-index="2">

    <transition name="editAgreement"><default-response url="../EditAgreement"/></transition>
    <transition name="createAgreement">
        <service-call name="zenith.rental.RentalServices.create#RentalAgreement"/>
        <default-response url="../EditAgreement"/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning party -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.rental.RentalAgreementDetail" list="agreements">
            <econdition field-name="customerPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-startDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Rental Agreements" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateAgreement" button-text="New Agreement" type="success">
                <form-single name="CreateForm" transition="createAgreement">
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="billingTypeEnumId"><default-field title="Billing">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="RentalBillingType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="startDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="expectedReturnDate"><default-field title="Expected Return"><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AgreementsForm" list="agreements" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="rentalAgreementId"><default-field title="Agreement #">
                    <link url="editAgreement" text="${rentalAgreementId}" parameter-map="[rentalAgreementId:rentalAgreementId]"/>
                </default-field></field>
                <field name="firstName"><default-field title="Customer">
                    <display text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></default-field></field>
                <field name="billingTypeEnumId"><default-field title="Billing">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="startDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="expectedReturnDate"><default-field title="Expected Return"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalAmount"><default-field title="Total"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="RgActive" text="Active"/><option key="RgOverdue" text="Overdue"/>
                        <option key="RgReturned" text="Returned"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
