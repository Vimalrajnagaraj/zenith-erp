<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Demand-shift alert: raised when a product's recent demand moves beyond a
         statistically-derived threshold (>= 2 sigma of its own historical daily
         volatility). Populated by AdvancedForecastServices.cycle#DemandForecast. -->
    <entity entity-name="DemandAlert" package="zenith.erp.inventory" short-alias="DemandAlerts">
        <field name="alertId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="productName" type="text-medium"/>
        <field name="alertDate" type="date"/>
        <field name="alertType" type="text-short"/>
        <field name="direction" type="text-short"/>
        <field name="reorderPoint" type="number-decimal"/>
        <field name="stockOnHand" type="number-decimal"/>
        <field name="recentAvgDaily" type="number-decimal"/>
        <field name="baselineAvgDaily" type="number-decimal"/>
        <field name="pctChange" type="number-decimal"/>
        <field name="zScore" type="number-decimal"/>
        <field name="message" type="text-long"/>
        <field name="statusId" type="id"/>
        <field name="createdStamp" type="date-time"/>
        <index name="IDX_DMDALERT_ORGSTAT"><index-field name="organizationPartyId"/><index-field name="statusId"/></index>
        <index name="IDX_DMDALERT_PRODDT"><index-field name="productId"/><index-field name="alertDate"/></index>
    </entity>

</entities>
