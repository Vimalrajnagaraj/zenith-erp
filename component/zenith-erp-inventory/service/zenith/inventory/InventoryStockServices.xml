<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Move a product's on-hand quantity by quantityDiff (negative = issue/sale, positive = receipt).
         Updates the Asset and writes an AssetDetail audit row. Creates the Asset if missing. -->
    <service verb="adjust" noun="AssetOnHand" authenticate="false">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="productId" required="true"/>
            <parameter name="quantityDiff" type="BigDecimal" required="true"/>
            <parameter name="reason"/>
            <parameter name="effectiveDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="facilityId"><description>Optional: track stock per facility (for multi-store transfers)</description></parameter>
            <parameter name="batchNumber"><description>Optional: target/create a specific batch asset (batch-tracked products)</description></parameter>
            <parameter name="expiryDate" type="Date"><description>Batch expiry — only used when creating a new batch asset</description></parameter>
            <parameter name="manufacturingDate" type="Date"/>
            <parameter name="mrpAmount" type="BigDecimal"/>
            <parameter name="valuationRate" type="BigDecimal"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetId"/>
            <parameter name="newQoh" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <!-- When batchNumber is given, target/create the asset for THAT batch so batch identity + expiry
                 stay intact (e.g. across a stock transfer). Otherwise the generic per-facility asset. -->
            <entity-find entity-name="mantle.product.asset.Asset" list="assets" limit="1">
                <econdition field-name="ownerPartyId" from="organizationPartyId"/>
                <econdition field-name="productId"/>
                <econdition field-name="facilityId" from="facilityId" ignore-if-empty="true"/>
                <econdition field-name="batchNumber" from="batchNumber" ignore-if-empty="true"/>
                <order-by field-name="assetId"/>
            </entity-find>
            <set field="asset" from="assets ? assets[0] : null"/>
            <!-- ZE-INV-001 f/u: never leave stock facility-less — it's invisible in the by-facility views (Stock
                 Levels list, dashboard KPI). When the caller gave no facility and the target lot has none, default
                 to the org's PRIMARY (first) facility. Applies on create AND heals an existing facility-less lot.
                 The FIND above stays facility-agnostic (ignore-if-empty), so we still reuse the existing lot rather
                 than spawn a duplicate; if the org has no facility at all we leave it null (nothing to assign). -->
            <if condition="!facilityId &amp;&amp; (asset == null || !asset.facilityId)">
                <entity-find entity-name="mantle.facility.Facility" list="_orgFacs" limit="1">
                    <econdition field-name="ownerPartyId" from="organizationPartyId"/>
                    <order-by field-name="facilityId"/>
                </entity-find>
                <if condition="_orgFacs"><set field="facilityId" from="_orgFacs[0].facilityId"/></if>
            </if>
            <if condition="asset == null">
                <service-call name="create#mantle.product.asset.Asset" out-map="createAsset"
                    in-map="[assetTypeEnumId:'AstTpInventory', statusId:'AstAvailable', ownerPartyId:organizationPartyId,
                             productId:productId, facilityId:facilityId, hasQuantity:'Y', quantityOnHandTotal:0, availableToPromiseTotal:0,
                             batchNumber:batchNumber, expiryDate:expiryDate, manufacturingDate:manufacturingDate,
                             mrpAmount:mrpAmount, valuationRate:valuationRate]"/>
                <entity-find-one entity-name="mantle.product.asset.Asset" value-field="asset">
                    <field-map field-name="assetId" from="createAsset.assetId"/>
                </entity-find-one>
            </if>
            <set field="newQoh" from="((asset.quantityOnHandTotal ?: 0) as BigDecimal) + quantityDiff" type="BigDecimal"/>
            <set field="newAtp" from="((asset.availableToPromiseTotal ?: 0) as BigDecimal) + quantityDiff" type="BigDecimal"/>
            <service-call name="update#mantle.product.asset.Asset"
                in-map="[assetId:asset.assetId, quantityOnHandTotal:newQoh, availableToPromiseTotal:newAtp, facilityId:(facilityId ?: asset.facilityId)]"/>
            <service-call name="create#mantle.product.asset.AssetDetail"
                in-map="[assetId:asset.assetId, productId:productId, effectiveDate:effectiveDate,
                         quantityOnHandDiff:quantityDiff, availableToPromiseDiff:quantityDiff, description:reason]"/>
            <set field="assetId" from="asset.assetId"/>
        </actions>
    </service>

    <!-- Load opening stock: set each product's on-hand to the supplied absolute quantity (as an
         adjustment from current), then switch INVENTORY_TRACKING_ENABLED on so sales start depleting. -->
    <service verb="load" noun="OpeningStock" authenticate="false" transaction-timeout="1800">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="effectiveDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="enableTracking" default-value="Y"/>
            <parameter name="items" type="List" required="true">
                <parameter name="itemEntry" type="Map">
                    <parameter name="productId" required="true"/>
                    <parameter name="quantity" type="BigDecimal" required="true"/>
                </parameter>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="updatedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="updatedCount" from="0" type="Integer"/>
            <iterate list="items" entry="row">
                <entity-find entity-name="mantle.product.asset.Asset" list="curAssets" limit="1">
                    <econdition field-name="ownerPartyId" from="organizationPartyId"/>
                    <econdition field-name="productId" from="row.productId"/>
                    <order-by field-name="assetId"/>
                </entity-find>
                <set field="curQoh" from="curAssets ? ((curAssets[0].quantityOnHandTotal ?: 0) as BigDecimal) : (0 as BigDecimal)"/>
                <set field="diff" from="((row.quantity ?: 0) as BigDecimal) - curQoh" type="BigDecimal"/>
                <service-call name="zenith.inventory.InventoryStockServices.adjust#AssetOnHand"
                    in-map="[organizationPartyId:organizationPartyId, productId:row.productId, quantityDiff:diff,
                             reason:'Opening stock', effectiveDate:effectiveDate]"/>
                <service-call name="update#mantle.product.Product" in-map="[productId:row.productId, inventoryTracked:'Y']"/>
                <set field="updatedCount" from="updatedCount + 1"/>
            </iterate>
            <if condition="enableTracking == 'Y'">
                <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="ts">
                    <field-map field-name="organizationPartyId"/>
                    <field-map field-name="settingKey" value="INVENTORY_TRACKING_ENABLED"/>
                </entity-find-one>
                <if condition="ts">
                    <service-call name="update#zenith.erp.base.CompanySettings"
                        in-map="[organizationPartyId:organizationPartyId, settingKey:'INVENTORY_TRACKING_ENABLED', settingValue:'Y']"/>
                <else>
                    <service-call name="create#zenith.erp.base.CompanySettings"
                        in-map="[organizationPartyId:organizationPartyId, settingKey:'INVENTORY_TRACKING_ENABLED', settingValue:'Y']"/>
                </else></if>
            </if>
        </actions>
    </service>

    <!-- ZE-INV-007 f/u: one-off (idempotent) reconciliation of legacy/migrated lots whose on-hand was set without a
         matching AssetDetail ledger (e.g. direct SQL / migration inserts). For each inventory asset where
         quantityOnHandTotal != SUM(AssetDetail.quantityOnHandDiff), it seeds ONE "opening balance" AssetDetail for the
         gap so the ledger sum equals the on-hand. It NEVER changes quantityOnHandTotal — a RAW entity insert is used
         (the create#AssetDetail SERVICE would move on-hand; the raw insert only writes the ledger row), so it is a true
         no-op for on-hand and safe to run alongside live POS sales. Already-consistent lots (gap 0) are skipped, so
         re-running is a no-op. dryRun (default true) only reports. -->
    <service verb="reconcile" noun="AssetLedgers" authenticate="true">
        <in-parameters>
            <parameter name="organizationPartyId"><description>Optional: scope to one tenant; blank = all tenants</description></parameter>
            <parameter name="dryRun" type="Boolean" default="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="scanned" type="Integer"/>
            <parameter name="reconciled" type="Integer"/>
            <parameter name="report"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                def _find = ec.entity.find("mantle.product.asset.Asset").condition("assetTypeEnumId", "AstTpInventory").disableAuthz()
                if (organizationPartyId) _find.condition("ownerPartyId", organizationPartyId)
                def _assets = _find.list()
                int _scanned = 0; int _reconciled = 0
                def _perOrg = [:]
                for (def a : _assets) {
                    if (a.quantityOnHandTotal == null) continue
                    _scanned++
                    def _details = ec.entity.find("mantle.product.asset.AssetDetail").condition("assetId", a.assetId).disableAuthz().list()
                    def _qohSum = BigDecimal.ZERO; def _atpSum = BigDecimal.ZERO; def _minEff = null
                    for (def d : _details) {
                        _qohSum = _qohSum.add(d.quantityOnHandDiff ?: BigDecimal.ZERO)
                        _atpSum = _atpSum.add(d.availableToPromiseDiff ?: BigDecimal.ZERO)
                        if (d.effectiveDate != null && (_minEff == null || d.effectiveDate.getTime() < _minEff.getTime())) _minEff = d.effectiveDate
                    }
                    def _origQoh = (a.quantityOnHandTotal ?: BigDecimal.ZERO)
                    def _origAtp = (a.availableToPromiseTotal ?: BigDecimal.ZERO)
                    def _qohGap = _origQoh.subtract(_qohSum)
                    def _atpGap = _origAtp.subtract(_atpSum)
                    if (_qohGap.compareTo(BigDecimal.ZERO) == 0 && _atpGap.compareTo(BigDecimal.ZERO) == 0) continue
                    _reconciled++
                    _perOrg[a.ownerPartyId ?: '(none)'] = (_perOrg[a.ownerPartyId ?: '(none)'] ?: 0) + 1
                    if (!dryRun) {
                        // opening date: asset receipt/acquire, else just before the earliest existing ledger row, else now
                        def _eff = a.receivedDate ?: a.acquiredDate ?: _minEff ?: ec.user.nowTimestamp
                        // RAW insert — does NOT touch quantityOnHandTotal (the service create#AssetDetail would)
                        ec.entity.makeValue("mantle.product.asset.AssetDetail").setAll([
                            assetId: a.assetId, productId: a.productId, effectiveDate: _eff,
                            quantityOnHandDiff: _qohGap, availableToPromiseDiff: _atpGap,
                            description: 'Opening balance (ledger reconciliation)']).setSequencedIdPrimary().create()
                    }
                }
                scanned = _scanned
                reconciled = _reconciled
                report = (dryRun ? '[DRY RUN] ' : '[APPLIED] ') + 'scanned ' + _scanned + ' inventory lots; ' + _reconciled + ' need an opening ledger entry. Per org: ' + _perOrg
            ]]></script>
        </actions>
    </service>

    <!-- ZE-INV-007 f/u: re-home ORPHANED inventory lots — an asset with no ownerPartyId whose PRODUCT is owned by a
         tenant is that tenant's stock (a migration/creation gap left the asset unowned, so it is invisible in the
         tenant's org-scoped inventory/expiry views). Set the asset owner to its product's owner via update#Asset
         (cache-safe, unlike a raw SQL write). On-hand is NOT touched. Only NULL-owner lots are moved; a lot already
         owned by a DIFFERENT org is never reassigned. dryRun (default) only reports; organizationPartyId (optional)
         limits to orphans whose product is owned by that tenant. Idempotent (a re-homed lot is no longer NULL-owner). -->
    <service verb="rehome" noun="OrphanAssets" authenticate="true">
        <in-parameters>
            <parameter name="organizationPartyId"><description>Optional: only orphans whose PRODUCT is owned by this org</description></parameter>
            <parameter name="dryRun" type="Boolean" default="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="scanned" type="Integer"/>
            <parameter name="rehomed" type="Integer"/>
            <parameter name="report"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                def _all = ec.entity.find("mantle.product.asset.Asset").condition("assetTypeEnumId", "AstTpInventory").disableAuthz().list()
                int _scanned = 0; int _rehomed = 0
                def _perOrg = [:]; def _log = []
                for (def a : _all) {
                    if (a.ownerPartyId != null) continue                 // only owner-less lots
                    _scanned++
                    if (a.productId == null) continue
                    def _p = ec.entity.find("mantle.product.Product").condition("productId", a.productId).disableAuthz().one()
                    def _newOwner = _p?.ownerPartyId
                    if (_newOwner == null) continue                      // product also unowned -> tenant unknown, skip
                    if (organizationPartyId && _newOwner != organizationPartyId) continue
                    _rehomed++
                    _perOrg[_newOwner] = (_perOrg[_newOwner] ?: 0) + 1
                    _log.add(a.assetId + ' (qoh ' + (a.quantityOnHandTotal ?: 0) + ') -> ' + _newOwner)
                    if (!dryRun) {
                        ec.service.sync().name("update#mantle.product.asset.Asset").parameters([assetId:a.assetId, ownerPartyId:_newOwner]).call()
                    }
                }
                scanned = _scanned
                rehomed = _rehomed
                report = (dryRun ? '[DRY RUN] ' : '[APPLIED] ') + 'scanned ' + _scanned + ' owner-less inventory lots; ' + _rehomed + ' re-homed to their product owner. Per org: ' + _perOrg + '. Detail: ' + _log
            ]]></script>
        </actions>
    </service>

</services>
