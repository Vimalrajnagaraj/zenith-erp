<?xml version="1.0" encoding="UTF-8"?>
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- ZE-INV-001 f/u (completes "no negative value anywhere"): stock value = qoh * (valuationRate ->
         acquireCost -> MRP), so a negative acquireCost or valuationRate makes stock value negative on the
         dashboard / Stock Levels / EditProduct / EditFacility — the exact bug this whole thread fixed.
         These cost fields are entered on ReceiveInventory, Stock Adjustments and Add-Expiring-Stock (and
         passed through adjust#AssetOnHand). Central pre-service guard on every entity-auto write of Asset.
         BILLING-PATH NOTE: this is safe on the POS/inventory hot path because it fires ONLY when a cost
         field is actually in the in-map AND negative — qoh/atp-only updates (POS depletion, transfers,
         reservations) pass neither field, so the condition is false and the update proceeds untouched.
         Cost/valuation are never legitimately negative here. pre-service so a bad write is aborted BEFORE
         it lands (a post-service <return error> does not roll back a begin-transaction="false" caller).
         store# covered too (it does not delegate to create#/update#). -->
    <seca id="ZenithAssetCostNonNegCreate" service="create#mantle.product.asset.Asset" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>(valuationRate != null &amp;&amp; (valuationRate as java.math.BigDecimal) &lt; 0G) || (acquireCost != null &amp;&amp; (acquireCost as java.math.BigDecimal) &lt; 0G)</expression></condition>
        <actions><return error="true" message="A product's cost / valuation rate can't be negative — enter 0 or a positive amount."/></actions>
    </seca>
    <seca id="ZenithAssetCostNonNegUpdate" service="update#mantle.product.asset.Asset" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>(valuationRate != null &amp;&amp; (valuationRate as java.math.BigDecimal) &lt; 0G) || (acquireCost != null &amp;&amp; (acquireCost as java.math.BigDecimal) &lt; 0G)</expression></condition>
        <actions><return error="true" message="A product's cost / valuation rate can't be negative — enter 0 or a positive amount."/></actions>
    </seca>
    <seca id="ZenithAssetCostNonNegStore" service="store#mantle.product.asset.Asset" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>(valuationRate != null &amp;&amp; (valuationRate as java.math.BigDecimal) &lt; 0G) || (acquireCost != null &amp;&amp; (acquireCost as java.math.BigDecimal) &lt; 0G)</expression></condition>
        <actions><return error="true" message="A product's cost / valuation rate can't be negative — enter 0 or a positive amount."/></actions>
    </seca>
</secas>
