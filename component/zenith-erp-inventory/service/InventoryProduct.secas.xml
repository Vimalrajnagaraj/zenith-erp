<?xml version="1.0" encoding="UTF-8"?>
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- ZE-INV-001 f/u: CENTRAL guard so a negative selling price (MRP) is impossible on EVERY path that
         writes Product.mrpAmount (the two manual screens FindProduct/EditProduct, ProductImport bulk CSV,
         any POS-side price edit, REST/API) — not just the two screens, which keep their own pre-emptive
         guard for nicer inline UX. A negative MRP makes stock value negative across the dashboard, Stock
         Levels, EditProduct and EditFacility. Uses when="pre-service" + <return error> so the service is
         ABORTED BEFORE the entity write (no row is created/updated at all — verified that a post-service
         <return error> did NOT roll back the write when the caller runs with begin-transaction="false",
         e.g. Tools/ServiceRun, so pre-service is the correct hook for an input guard). Blank / 0 / positive
         all pass; only mrpAmount < 0 is rejected. Fires only when mrpAmount is actually being written
         (null = not in the in-map, e.g. an inventoryTracked-only update -> condition false -> no-op). -->
    <seca id="ZenithProductMrpNonNegativeCreate" service="create#mantle.product.Product" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>mrpAmount != null &amp;&amp; (mrpAmount as java.math.BigDecimal) &lt; 0G</expression></condition>
        <actions><return error="true" message="Selling Price / MRP can't be negative — please enter 0 or a positive amount."/></actions>
    </seca>
    <seca id="ZenithProductMrpNonNegativeUpdate" service="update#mantle.product.Product" when="pre-service" run-on-error="false" priority="1">
        <condition><expression>mrpAmount != null &amp;&amp; (mrpAmount as java.math.BigDecimal) &lt; 0G</expression></condition>
        <actions><return error="true" message="Selling Price / MRP can't be negative — please enter 0 or a positive amount."/></actions>
    </seca>
</secas>
