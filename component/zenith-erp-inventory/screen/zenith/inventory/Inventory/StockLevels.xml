<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock Levels" default-menu-index="4">

    <actions>
        <entity-find entity-name="zenith.erp.inventory.StockByFacilityView" list="stockList">
            <search-form-inputs default-order-by="productName,facilityName"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/></entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="How much stock you have (by store)"/><box-body>
            <label text="Each row shows one item at one store. &quot;In Stock&quot; is what you physically have; &quot;Free to Sell&quot; is what is not already reserved for an order." type="p" style="text-grey-7 q-pa-sm q-mb-sm"/>
            <form-list name="StockLevelForm" list="stockList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="pseudoId">
                    <header-field title="SKU" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="productName">
                    <header-field title="Product" show-order-by="true"><text-find size="25" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="hsnCode">
                    <header-field title="HSN"><text-find size="8" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="facilityId">
                    <header-field title="Store / Warehouse">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </header-field>
                </field>
                <field name="facilityName">
                    <header-field title="Store / Warehouse" show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="totalQoh">
                    <header-field title="In Stock" show-order-by="true"/>
                    <default-field><display format="#,##0.##"/></default-field>
                </field>
                <field name="totalAtp">
                    <header-field title="Free to Sell" show-order-by="true"/>
                    <default-field><display format="#,##0.##"/></default-field>
                </field>
                <field name="mrpAmount">
                    <default-field title="MRP"><display format="#,##,##0.00"/></default-field>
                </field>
                <field name="totalValue">
                    <header-field title="Stock Value" show-order-by="true"/>
                    <default-field title="Value (${currSymbol})"><display format="#,##,##0.00"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
