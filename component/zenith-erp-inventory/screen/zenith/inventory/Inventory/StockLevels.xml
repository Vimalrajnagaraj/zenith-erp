<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock Levels" default-menu-index="4">

    <actions>
        <!-- ZE-SHOP: default the facility filter to the globally-selected shop (an explicit ?facilityId= wins) -->
        <script>_stockFac = ec.web.getRequest()?.getParameter('facilityId') ?: null; if (!_stockFac) { try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").call(); _stockFac = _sc?.activeShopId } catch (Exception _e) {} }</script>
        <entity-find entity-name="zenith.erp.inventory.StockByFacilityView" list="stockList">
            <search-form-inputs default-order-by="productName,facilityName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="facilityId" from="_stockFac" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="facilityName"/></entity-find>
        <set field="currSymbol" value="₹"/>

        <!-- XF-001: org-wide inventory summary (across ALL products, independent of the list's
             filter/pagination). Units/SKU/out/recent come from the grouped view; VALUE is computed
             from Assets directly (see below) — bounded by SKU×store count. -->
        <entity-find entity-name="zenith.erp.inventory.StockByFacilityView" list="allStock">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="facilityId" from="_stockFac" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>
        <script><![CDATA[
            import org.moqui.entity.EntityCondition
            def ef = ec.entity
            def _orgId = ec.user.getPreference('ACTIVE_ORGANIZATION')

            // ZE-INV-001 f/u: Stock Value now matches the Inventory Dashboard. The by-facility view's
            // totalValue = sum(acquireCost) is 0 for MRP-priced stock (cost never set) AND it's sum-of-
            // costs, not sum(qty*cost). So value each unit from the Asset directly, valuationRate ->
            // acquireCost -> product MRP (same fallback as the dashboard / Expiry Risk). stockValueByRow
            // keys product|facility|lot to line up 1:1 with the view's rows (identical group-by), so the
            // per-row "Stock Value" column and the summary total are both correct + consistent.
            stockValueByRow = [:]
            def _mrpCache = [:]
            sumValue = 0.0G
            def _aq = ef.find("mantle.product.asset.Asset")
                        .condition("assetTypeEnumId", "AstTpInventory")
                        .condition("quantityOnHandTotal", EntityCondition.GREATER_THAN, 0G)
            if (_orgId) _aq.condition("ownerPartyId", _orgId)   // mirror the list's org-isolation (CSV standalone render bypasses authz)
            for (a in _aq.list()) {
                def qoh = (a.quantityOnHandTotal ?: 0G) as java.math.BigDecimal
                def vr = a.valuationRate ? (a.valuationRate as java.math.BigDecimal) : null
                def ac = a.acquireCost ? (a.acquireCost as java.math.BigDecimal) : null
                def rate = (vr != null && vr > 0G) ? vr : ((ac != null && ac > 0G) ? ac : null)
                if (rate == null) {
                    def mrp = _mrpCache[a.productId]
                    if (mrp == null) {
                        def p = ef.find("mantle.product.Product").condition("productId", a.productId).one()
                        mrp = (p?.mrpAmount ?: 0G) as java.math.BigDecimal
                        _mrpCache[a.productId] = mrp
                    }
                    rate = mrp
                }
                def val = qoh * (rate ?: 0G)
                sumValue += val
                def k = (a.productId ?: '') + '|' + (a.facilityId ?: '') + '|' + (a.lotId ?: '')
                stockValueByRow[k] = (stockValueByRow[k] ?: 0G) + val
            }

            // units / SKU count / out-of-stock / recently-updated — from the grouped view (unchanged)
            sumQoh = 0.0G
            outCount = 0
            recentCount = 0
            def _skus = new HashSet()
            def _nowMs = ec.user.nowTimestamp.getTime()
            def _weekMs = 604800000L
            for (def r in allStock) {
                def q = (r.totalQoh ?: 0)
                sumQoh = sumQoh + q
                if (r.productId) _skus.add(r.productId)
                if (q <= 0) outCount = outCount + 1
                if (r.lastUpdated != null && (_nowMs - r.lastUpdated.getTime()) < _weekMs) recentCount = recentCount + 1
            }
            skuCount = _skus.size()
            stockLineCount = allStock.size()
        ]]></script>
    </actions>

    <widgets>
        <!-- XF-001: at-a-glance inventory summary across all products. Layout via .xf-summary-*
             classes in the theme CSS (Moqui renders `style` as the class attribute). -->
        <container style="xf-summary-row">
            <container style="zenith-card bg-blue-1 border-radius-md q-pa-md xf-summary-card">
                <label text="Products in stock" type="p" style="xf-summary-label"/>
                <label text="${ec.l10n.format(skuCount ?: 0,'#,##0')}" type="p" style="xf-summary-num"/>
            </container>
            <container style="zenith-card bg-green-1 border-radius-md q-pa-md xf-summary-card">
                <label text="Total units in stock" type="p" style="xf-summary-label"/>
                <label text="${ec.l10n.format(sumQoh ?: 0,'#,##0.##')}" type="p" style="xf-summary-num"/>
            </container>
            <container style="zenith-card bg-indigo-1 border-radius-md q-pa-md xf-summary-card">
                <label text="Total stock value" type="p" style="xf-summary-label"/>
                <label text="${ec.l10n.format(sumValue ?: 0,'#,##,##0.00')}" type="p" style="xf-summary-num"/>
            </container>
            <container style="zenith-card bg-red-1 border-radius-md q-pa-md xf-summary-card">
                <label text="Out of stock" type="p" style="xf-summary-label"/>
                <label text="${ec.l10n.format(outCount ?: 0,'#,##0')}" type="p" style="xf-summary-num"/>
            </container>
            <container style="zenith-card bg-amber-1 border-radius-md q-pa-md xf-summary-card">
                <label text="Updated in last 7 days" type="p" style="xf-summary-label"/>
                <label text="${ec.l10n.format(recentCount ?: 0,'#,##0')}" type="p" style="xf-summary-num"/>
            </container>
        </container>

        <container-box><box-header title="How much stock you have (by store)"/><box-body>
            <label text="Each row shows one item at one store. &quot;In Stock&quot; is what you physically have; &quot;Free to Sell&quot; is what is not already reserved for an order." type="p" style="text-grey-7 q-pa-sm q-mb-sm"/>
            <form-list name="StockLevelForm" list="stockList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <!-- ZE-INV-001 f/u: per-row Stock Value from the asset-derived map (keyed product|facility|lot,
                     matching this view's group-by). row-actions runs for screen + CSV/XLSX render alike. -->
                <row-actions>
                    <set field="rowStockValue"
                         from="(stockValueByRow[(productId ?: '') + '|' + (facilityId ?: '') + '|' + (lotId ?: '')] ?: 0G) as java.math.BigDecimal"/>
                </row-actions>
                <field name="pseudoId">
                    <header-field title="SKU" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="productName">
                    <header-field title="Product" show-order-by="true"><text-find size="25" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="hsnCode">
                    <header-field title="HSN"><text-find size="8" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="facilityId">
                    <header-field title="Store / Warehouse">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </header-field>
                </field>
                <field name="facilityName">
                    <header-field title="Store / Warehouse" show-order-by="true"/>
                    <!-- ZE-INV-002: facility-less stock (LEFT join) has no facilityName -> label it so the row
                         reads clearly and nudges the user to assign a store. -->
                    <default-field><display text="${facilityName ?: '— No store —'}"/></default-field>
                </field>
                <field name="totalQoh">
                    <header-field title="In Stock" show-order-by="true"/>
                    <default-field><display format="#,##0.##"/></default-field>
                </field>
                <field name="totalAtp">
                    <header-field title="Free to Sell" show-order-by="true"/>
                    <default-field><display format="#,##0.##"/></default-field>
                </field>
                <field name="mrpAmount">
                    <default-field title="MRP"><display format="#,##,##0.00"/></default-field>
                </field>
                <!-- name is a screen-computed value (set in row-actions), not the view's totalValue, so no
                     native show-order-by (it would sort by the stale acquireCost sum, not this value). -->
                <field name="rowStockValue">
                    <header-field title="Stock Value"/>
                    <default-field title="Value (${currSymbol})"><display format="#,##,##0.00"/></default-field>
                </field>
                <!-- XF-001: surface recently-changed stock (received / sold / adjusted in the last 7 days). -->
                <field name="lastUpdated">
                    <header-field title="Updated"/>
                    <default-field>
                        <label text="${lastUpdated ? ec.l10n.format(lastUpdated,'dd MMM yy') : '—'}" type="span" style="text-caption text-grey-7"/>
                        <label text="Recent" type="span" style="zenith-badge success q-ml-xs"
                               condition="lastUpdated != null &amp;&amp; (ec.user.nowTimestamp.time - lastUpdated.time) &lt; 604800000"/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
