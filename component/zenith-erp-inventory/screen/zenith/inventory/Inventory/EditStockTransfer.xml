<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Transfer" default-menu-include="false">

    <parameter name="stockTransferId" required="true"/>

    <transition name="addItem">
        <actions>
            <!-- ZE-INV-IV-06A: block editing another tenant's transfer via a forged POST -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.add#StockTransferItem" in-map="context"/>
        </actions>
        <default-response url="."><parameter name="stockTransferId"/></default-response>
    </transition>
    <transition name="deleteItem">
        <actions>
            <!-- ZE-INV-IV-06A: block removing a line from another tenant's transfer -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <entity-find entity-name="zenith.erp.inventory.StockTransferItemSerial" list="_delSer">
                <econdition field-name="stockTransferId"/>
                <econdition field-name="transferItemSeqId"/>
            </entity-find>
            <iterate list="_delSer" entry="_ds"><entity-delete value-field="_ds"/></iterate>
            <service-call name="delete#zenith.erp.inventory.StockTransferItem"
                          in-map="[stockTransferId:stockTransferId, transferItemSeqId:transferItemSeqId]"/>
        </actions>
        <default-response url="."><parameter name="stockTransferId"/></default-response>
    </transition>
    <transition name="shipTransfer">
        <actions>
            <!-- ZE-INV-IV-06A: block shipping another tenant's transfer (would move their stock) -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.ship#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="."><parameter name="stockTransferId"/></default-response>
    </transition>
    <transition name="receiveTransfer">
        <actions>
            <!-- ZE-INV-IV-06A: block receiving another tenant's transfer (would move their stock) -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.receive#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="."><parameter name="stockTransferId"/></default-response>
    </transition>
    <transition name="back"><default-response url="../StockTransfers"/></transition>

    <!-- XF-004: edit the draft header / delete the draft. Both guard write-access (defense-in-depth)
         and the services enforce the StxDraft-only rule. -->
    <transition name="editHeader">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't change this transfer."/></if>
            <!-- ZE-INV-IV-06A: block editing another tenant's transfer header -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.edit#StockTransfer" in-map="context"/>
        </actions>
        <default-response url="."><parameter name="stockTransferId"/></default-response>
    </transition>
    <transition name="deleteTransfer">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't delete this transfer."/></if>
            <!-- ZE-INV-IV-06A: block deleting another tenant's transfer -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.delete#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="../StockTransfers"/>
    </transition>

    <actions>
        <!-- ZE-INV-IV-06A: org-isolation guard — only open a transfer owned by the caller's active org
             (super-admins exempt). Load NOTHING when blocked; widgets show a plain no-access panel.
             Same shape as EditStockAdjustment (no <return/> — it would halt the whole render). -->
        <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="zenith.erp.inventory.StockTransfer" value-field="stx"/>
        <entity-find-one entity-name="mantle.facility.Facility" value-field="fromFac"><field-map field-name="facilityId" from="stx?.fromFacilityId"/></entity-find-one>
        <entity-find-one entity-name="mantle.facility.Facility" value-field="toFac"><field-map field-name="facilityId" from="stx?.toFacilityId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.inventory.StockTransferItem" list="itemList">
            <econdition field-name="stockTransferId" from="stockTransferId"/>
            <order-by field-name="transferItemSeqId"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="prodList">
            <econdition field-name="ownerPartyId" from="orgId"/>
            <order-by field-name="productName"/>
        </entity-find>
        <!-- Lots available at the sending facility, so a user can pick exactly which batch to move
             (else the ship auto-picks the earliest-expiry lot). Empty for non-batch stock. -->
        <script><![CDATA[
            batchList = []
            def batchOrg = stx?.organizationPartyId ?: orgId
            if (stx?.fromFacilityId && batchOrg) {
                def bas = ec.entity.find("mantle.product.asset.Asset")
                    .condition("ownerPartyId", batchOrg).condition("facilityId", stx.fromFacilityId)
                    .orderBy("productId,expiryDate").list()
                for (a in bas) {
                    if (!a.batchNumber || ((a.quantityOnHandTotal ?: 0) as BigDecimal) <= 0) continue
                    def p = ec.entity.find("mantle.product.Product").condition("productId", a.productId).one()
                    batchList.add([batchNumber: a.batchNumber,
                        label: (p?.productName ?: a.productId) + ' · ' + a.batchNumber
                               + (a.expiryDate ? (' · exp ' + a.expiryDate) : '')
                               + ' · ' + (a.quantityOnHandTotal ?: 0) + ' in stock'])
                }
            }
            // In-stock serial units at the sending facility (for serial-tracked products), so a user can
            // pick exactly which units to move. Empty for non-serial stock.
            serialList = []
            if (stx?.fromFacilityId && batchOrg) {
                def sns = ec.entity.find("zenith.erp.inventory.ProductSerialNumber")
                    .condition("facilityId", stx.fromFacilityId).condition("statusId", "SnInStock")
                    .orderBy("productId,serialNumber").list()
                for (sn in sns) {
                    def p = ec.entity.find("mantle.product.Product").condition("productId", sn.productId).one()
                    if (p == null || p.ownerPartyId != batchOrg) continue
                    serialList.add([serialNumberId: sn.serialNumberId, label: (p?.productName ?: sn.productId) + ' · ' + sn.serialNumber])
                }
            }
        ]]></script>
        <set field="isDraft" from="stx?.statusId == 'StxDraft'"/>
        <set field="isTransit" from="stx?.statusId == 'StxInTransit'"/>
        <set field="isReceived" from="stx?.statusId == 'StxReceived'"/>
        <set field="isCancelled" from="stx?.statusId == 'StxCancelled'"/>
        <set field="statusNice" from="isDraft ? 'Draft' : (isTransit ? 'In transit' : (isReceived ? 'Received ✓' : (isCancelled ? 'Cancelled' : (stx?.statusId ?: ''))))"/>
        <!-- XF-004: facilities for the edit-header dialog (org-scoped) + pre-fill the current values. -->
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="stx?.organizationPartyId ?: orgId" ignore-if-empty="true"/>
            <order-by field-name="facilityName"/>
        </entity-find>
        <set field="fromFacilityId" from="stx?.fromFacilityId"/>
        <set field="toFacilityId" from="stx?.toFacilityId"/>
        <set field="transferDate" from="stx?.transferDate"/>
        <set field="remarks" from="stx?.remarks"/>
        </if>
    </actions>

    <widgets>
        <link url="back" text="← Back to Stock Transfers" link-type="anchor" style="text-grey-7"/>

        <!-- ZE-INV-IV-06A: cross-tenant / missing record — plain notice, never another org's data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-lg q-mt-sm text-center">
                    <label text="That stock transfer isn't part of your account." type="h6" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Stock Transfers” above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheTransfer">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-md q-mt-sm q-mb-md">
            <container style="row items-center justify-between">
                <container style="column">
                    <label text="Stock Transfer" type="h5" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Move stock from one store/warehouse to another. Add the products, ship them out (stock leaves the sender), then receive them (stock arrives at the receiver)." type="p" style="text-grey-6 text-caption q-mb-none"/>
                </container>
                <label text="${statusNice}" type="span" style="zenith-badge ${isReceived ? 'success' : (isTransit ? 'info' : 'warning')}"/>
            </container>
            <container style="row q-gutter-xl q-mt-sm">
                <container style="column"><label text="From (sender)" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${fromFac?.facilityName ?: stx?.fromFacilityId ?: '—'}" type="p" style="text-dark text-weight-bold q-my-none"/></container>
                <container style="column"><label text="To (receiver)" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${toFac?.facilityName ?: stx?.toFacilityId ?: '—'}" type="p" style="text-dark text-weight-bold q-my-none"/></container>
                <container style="column"><label text="E-Way Bill" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${stx?.ewayBillRequired == 'Y' ? 'Required' : 'Not needed'}" type="p" style="text-dark q-my-none"/></container>
            </container>
        </container>

        <!-- XF-004: edit / delete the transfer RECORD (draft only). Once shipped/received the header is
             locked (stock has moved) and we show the reversal rule instead. -->
        <section name="DraftHeaderActions">
            <condition><expression>isDraft &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="row items-center q-gutter-sm q-mb-md">
                    <container-dialog id="EditTransferDialog" button-text="Edit transfer" button-class="btn btn-primary text-weight-bold">
                        <label text="Edit transfer" type="h5" style="text-primary text-weight-bold q-mb-xs"/>
                        <label text="Change where this draft is going, its date, or the notes. The source can only be changed while there are no product lines (their lots/serials come from that sender)." type="p" style="text-grey-7 q-mb-md"/>
                        <form-single name="EditTransferForm" transition="editHeader">
                            <field name="stockTransferId"><default-field><hidden/></default-field></field>
                            <field name="fromFacilityId"><default-field title="From (sender)">
                                <drop-down><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down>
                            </default-field></field>
                            <field name="toFacilityId"><default-field title="To (receiver)">
                                <drop-down><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down>
                            </default-field></field>
                            <field name="transferDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                            <field name="remarks"><default-field title="Notes"><text-area rows="2" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Save changes"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <link url="deleteTransfer" text="Delete transfer" parameter-map="[stockTransferId:stockTransferId]"
                          confirmation="Delete this draft transfer? It removes the transfer and its product lines. This can't be undone."
                          btn-type="danger" style="text-weight-bold"/>
                </container>
            </widgets>
        </section>
        <section name="LockedHeaderExplain">
            <condition><expression>(isTransit || isReceived) &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="bg-blue-1 q-pa-md border-radius-md q-mb-md">
                    <label text="This transfer can no longer be edited or deleted" type="p" style="text-weight-bold text-grey-9 q-mb-xs"/>
                    <label text="${isReceived ? 'It has been received — the stock has already moved to the destination. To reverse it, create a new transfer in the opposite direction.' : 'It has shipped — the stock has left the sender. Receive it at the destination, or create a return transfer to send it back.'}" type="p" style="text-grey-7 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <!-- ZE-INV-010: Add-item form is a write action — hidden for view-only users -->
        <section name="AddRow">
            <condition><expression>isDraft &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="zenith-card bg-indigo-1 border-radius-md q-pa-md q-mb-md">
                    <label text="Add a product to send" type="p" style="text-indigo-9 text-weight-bold q-mb-sm"/>
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="stockTransferId"><default-field><hidden/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <drop-down><list-options list="prodList" key="${productId}" text="${pseudoId ? (pseudoId + ' — ') : ''}${productName}"/></drop-down>
                        </default-field></field>
                        <field name="quantity"><default-field title="Quantity to send"><text-line size="10"/></default-field></field>
                        <field name="batchNumber"><default-field title="Lot / Batch (optional)">
                            <drop-down allow-empty="true"><list-options list="batchList" key="${batchNumber}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="serialNumbers"><default-field title="Serial numbers (optional — sets quantity)">
                            <drop-down allow-empty="true" allow-multiple="true"><list-options list="serialList" key="${serialNumberId}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title=""><submit text="Add" icon="add" style="bg-indigo-7 text-white text-weight-bold border-radius-sm"/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="productId"/><field-ref name="quantity"/><field-ref name="batchNumber"/><field-ref name="submitButton"/></field-row>
                            <field-row><field-ref name="serialNumbers"/></field-row>
                        </field-layout>
                    </form-single>
                </container>
            </widgets>
        </section>

        <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-md q-mb-md">
            <label text="Products in this transfer" type="h6" style="text-primary text-weight-bold q-mb-sm"/>
            <form-list name="ItemList" list="itemList" skip-form="true">
                <row-actions>
                    <entity-find entity-name="zenith.erp.inventory.StockTransferItemSerial" list="_serRows">
                        <econdition field-name="stockTransferId" from="stockTransferId"/>
                        <econdition field-name="transferItemSeqId"/>
                        <order-by field-name="serialNumber"/>
                    </entity-find>
                    <set field="serialNames" from="_serRows ? _serRows.collect { it.serialNumber }.join(', ') : ''"/>
                </row-actions>
                <field name="productId"><default-field title="Product">
                    <display-entity entity-name="mantle.product.Product" text="${pseudoId} ${productName}"/>
                </default-field></field>
                <field name="batchNumber"><default-field title="Lot"><display text="${batchNumber ?: '—'}"/></default-field></field>
                <field name="serialNames"><default-field title="Serials"><display text="${serialNames ?: '—'}"/></default-field></field>
                <field name="quantity"><default-field title="Sent"><display text="${ec.l10n.format(quantity ?: 0,'#,##0')}"/></default-field></field>
                <field name="quantityReceived"><default-field title="Received"><display text="${quantityReceived != null ? ec.l10n.format(quantityReceived,'#,##0') : '—'}"/></default-field></field>
                <field name="del">
                  <!-- ZE-INV-010: Remove line is a write action — hidden for view-only users -->
                  <conditional-field name="delWrite" condition="invCanWrite" title="">
                    <link url="deleteItem" text="Remove" parameter-map="[stockTransferId:stockTransferId, transferItemSeqId:transferItemSeqId]" condition="isDraft" style="text-danger"/>
                  </conditional-field>
                  <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
            <section name="NoItems">
                <condition><expression>!itemList</expression></condition>
                <widgets><label text="No products added yet — add what you want to send above." type="p" style="text-grey-6 q-pa-sm"/></widgets>
            </section>
        </container>

        <!-- ZE-INV-010: Ship out is a write action — hidden for view-only users -->
        <section name="ShipRow">
            <condition><expression>isDraft &amp;&amp; itemList &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="row items-center justify-between bg-orange-1 q-pa-md border-radius-md">
                    <label text="Shipping will remove this stock from the sender (${fromFac?.facilityName ?: 'source'})." type="p" style="text-grey-8 q-mb-none"/>
                    <link url="shipTransfer" text="Ship out" parameter-map="[stockTransferId:stockTransferId]"
                          confirmation="Ship this transfer? Stock will leave the sender."
                          style="q-btn bg-orange-8 text-white text-weight-bold q-px-lg border-radius-sm"/>
                </container>
            </widgets>
        </section>
        <!-- ZE-INV-010: Receive is a write action — hidden for view-only users -->
        <section name="ReceiveRow">
            <condition><expression>isTransit &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="row items-center justify-between bg-green-1 q-pa-md border-radius-md">
                    <label text="Goods arrived? Receiving will add this stock to ${toFac?.facilityName ?: 'the receiver'}." type="p" style="text-grey-8 q-mb-none"/>
                    <link url="receiveTransfer" text="Receive" parameter-map="[stockTransferId:stockTransferId]"
                          confirmation="Receive this transfer? Stock will be added to the receiver."
                          style="q-btn bg-positive text-white text-weight-bold q-px-lg border-radius-sm"/>
                </container>
            </widgets>
        </section>
        <section name="DoneRow">
            <condition><expression>isReceived</expression></condition>
            <widgets>
                <container style="bg-green-1 q-pa-md border-radius-md text-center">
                    <label text="✓ Transfer complete — stock has moved from the sender to the receiver." type="p" style="text-success text-weight-bold q-mb-none"/>
                </container>
            </widgets>
        </section>
        </widgets>
        </section>
    </widgets>
</screen>
