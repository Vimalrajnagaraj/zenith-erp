<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Adjustment" default-menu-include="false">

    <parameter name="stockAdjustmentId" required="true"/>

    <transition name="addItem">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Stock adjustment changes require a POST request."/></if>
            <!-- ZE-INV-IV-06A: block adding a line to another tenant's adjustment via a forged POST -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock adjustment."/></if>
            <service-call name="zenith.inventory.InventoryServices.add#StockAdjustmentItem" in-map="context"/>
        </actions>
        <default-response url="."><parameter name="stockAdjustmentId"/></default-response>
    </transition>
    <transition name="deleteItem">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Stock adjustment changes require a POST request."/></if>
            <!-- ZE-INV-IV-06A: block removing a line from another tenant's adjustment -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock adjustment."/></if>
            <service-call name="zenith.inventory.StockAdjustmentServices.delete#StockAdjustmentItem"
                          in-map="[stockAdjustmentId:stockAdjustmentId, adjustmentItemSeqId:adjustmentItemSeqId]"/>
        </actions>
        <default-response url="."><parameter name="stockAdjustmentId"/></default-response>
    </transition>
    <transition name="applyAdjustment">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Stock adjustment changes require a POST request."/></if>
            <!-- ZE-INV-IV-06A: block applying another tenant's adjustment to their live stock -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock adjustment."/></if>
            <service-call name="zenith.inventory.InventoryServices.apply#StockAdjustment" in-map="[stockAdjustmentId:stockAdjustmentId]"/>
        </actions>
        <error-response url="."><parameter name="stockAdjustmentId"/></error-response>
        <default-response url="../StockAdjustments"/>
    </transition>
    <transition name="approveAdjustment">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Stock adjustment changes require a POST request."/></if>
            <service-call in-map="context" name="zenith.inventory.StockAdjustmentServices.approve#StockAdjustment"/>
        </actions>
        <default-response url="."><parameter name="stockAdjustmentId"/></default-response>
    </transition>
    <transition name="reopenAdjustment">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Stock adjustment changes require a POST request."/></if>
            <service-call in-map="context" name="zenith.inventory.StockAdjustmentServices.reopen#StockAdjustment"/>
        </actions>
        <default-response url="."><parameter name="stockAdjustmentId"/></default-response>
    </transition>
    <transition name="back"><default-response url="../StockAdjustments"/></transition>

    <actions>
        <!-- ZE-INV-IV-06A: org-isolation guard — a tenant user may only open an adjustment owned by their
             active organization, including super-admins. Without this, any logged-in user could view (and, via
             the transitions above, edit/apply) another tenant's adjustment by guessing the id in the URL.
             Runs BEFORE any record is loaded so a foreign record is never exposed. -->
        <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
        <!-- Blocked: flag it and load NOTHING (so no foreign data is ever fetched or exposed); the widgets
             show a plain "not part of your account" panel. NB: do NOT <return/> here — a return in screen
             actions halts the whole render including widgets, so the panel would never show. And do NOT
             sri.sendRedirectAndStopRender — in /apps this subscreen renders after the outer shell has
             committed the HTTP response, so a redirect throws IllegalStateException("Committed"). -->
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
            <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="zenith.erp.inventory.StockAdjustment" value-field="adj"/>
            <entity-find entity-name="zenith.erp.inventory.StockAdjustmentItem" list="itemList">
                <econdition field-name="stockAdjustmentId" from="stockAdjustmentId"/>
                <order-by field-name="adjustmentItemSeqId"/>
            </entity-find>
            <entity-find entity-name="mantle.product.Product" list="prodList">
                <econdition field-name="ownerPartyId" from="orgId"/>
                <order-by field-name="productName"/>
            </entity-find>
            <set field="isDraft" from="adj?.statusId == 'AdjPending'"/>
            <set field="isApproved" from="adj?.statusId == 'AdjApproved'"/>
            <entity-find entity-name="mantle.product.asset.Asset" list="countAssets">
                <econdition field-name="ownerPartyId" from="orgId"/><econdition field-name="facilityId" from="adj.facilityId"/>
                <econdition field-name="assetTypeEnumId" value="AstTpInventory"/><order-by field-name="productId,assetId"/>
            </entity-find>
            <script><![CDATA[
                countProductNames = prodList.collectEntries { p -> [(p.productId): ((p.pseudoId ? p.pseudoId + ' — ' : '') + (p.productName ?: p.productId))] }
                countAssetNames = countAssets.collectEntries { a -> [(a.assetId): ((a.batchNumber ?: 'Unbatched') + ' (' + a.assetId + ')')] }
                countSerialNames = [:]
                def ownIds = prodList.collect { it.productId }
                def serials = ownIds ? ec.entity.find('zenith.erp.inventory.ProductSerialNumber').condition('productId', 'in', ownIds).condition('facilityId', adj.facilityId).list().collectEntries { [(it.serialNumberId):it.serialNumber] } : [:]
                for (line in itemList) {
                    if (!line.serialSnapshot) continue
                    try {
                        def data = new groovy.json.JsonSlurper().parseText(line.serialSnapshot)
                        countSerialNames[line.adjustmentItemSeqId] = data.counted ? data.counted.collect { serials[it] ?: 'Unavailable serial' }.join(', ') : 'None counted'
                    } catch (Exception ignored) { countSerialNames[line.adjustmentItemSeqId] = 'Recount required' }
                }
            ]]></script>
            <set field="isApplied" from="adj?.statusId == 'AdjApplied'"/>
            <set field="typeNice" from="adj?.adjustmentType == 'PhysicalCount' ? 'Physical count' : (adj?.adjustmentType == 'WriteOff' ? 'Write off' : (adj?.adjustmentType ?: ''))"/>
        </if>
    </actions>

    <widgets>
        <container id="stockAdjustmentDetail">
        <link url="back" text="← Back to Stock Adjustments" link-type="anchor" style="text-grey-7"/>

        <!-- ZE-INV-IV-06A: cross-tenant / missing record — show a plain notice, never another org's data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-lg q-mt-sm text-center">
                    <label text="That stock adjustment isn't part of your account." type="h6" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Stock Adjustments” above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheAdjustment">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-md q-mt-sm q-mb-md">
            <container style="row items-center justify-between">
                <container style="column">
                    <label text="Stock Adjustment" type="h5" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Correct your on-hand stock — for a physical recount, damage, expiry or a write-off. Add each product, type the real count you have, then approve and apply. Approved counts are locked; reopen them to correct a draft." type="p" style="text-grey-6 text-caption q-mb-none"/>
                </container>
                <label text="${isApplied ? 'Applied ✓' : (adj?.statusId == 'AdjApproved' ? 'Approved' : 'Draft')}" type="span" style="zenith-badge ${isApplied ? 'success' : 'warning'}"/>
            </container>
            <container style="row q-gutter-xl q-mt-sm">
                <container style="column"><label text="Reason" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${typeNice}" type="p" style="text-dark text-weight-bold q-my-none"/></container>
                <container style="column"><label text="Date" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${adj?.adjustmentDate ? ec.l10n.format(adj.adjustmentDate,'dd-MMM-yyyy') : '—'}" type="p" style="text-dark text-weight-bold q-my-none"/></container>
                <container style="column"><label text="Note" type="p" style="text-grey-6 text-caption q-mb-none"/><label text="${adj?.remarks ?: '—'}" type="p" style="text-dark q-my-none"/></container>
            </container>
        </container>

        <!-- ZE-INV-010: Add-item form is a write action — hidden for view-only users -->
        <section name="AddRow">
            <condition><expression>isDraft &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="zenith-card bg-indigo-1 border-radius-md q-pa-md q-mb-md">
                    <label text="Add a product to count" type="p" style="text-indigo-9 text-weight-bold q-mb-sm"/>
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="stockAdjustmentId"><default-field><hidden/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <drop-down><list-options list="prodList" key="${productId}" text="${pseudoId ? (pseudoId + ' — ') : ''}${productName}"/></drop-down>
                        </default-field></field>
                        <field name="assetId"><default-field title="Batch / lot (batch products only)"><drop-down allow-empty="true"><list-options list="countAssets" key="${assetId}" text="${productId} — ${batchNumber ?: 'unbatched'} (${assetId})"/></drop-down></default-field></field>
                        <field name="countedSerialNumbers"><default-field title="Counted serial numbers (one per line)"><text-area rows="3"/></default-field></field>
                        <field name="actualQuantity"><default-field title="Actual count"><text-line size="10"/></default-field></field>
                        <field name="remarks"><default-field title="Note (optional)"><text-line size="25"/></default-field></field>
                        <field name="submitButton"><default-field title=""><submit text="Add" icon="add" style="bg-indigo-7 text-white text-weight-bold border-radius-sm"/></default-field></field>
                        <field-layout><field-row><field-ref name="productId"/><field-ref name="assetId"/><field-ref name="countedSerialNumbers"/><field-ref name="actualQuantity"/><field-ref name="remarks"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                    <label text="Ordinary products count all stock at this warehouse. For batch products choose the exact asset. For serial products list every counted serial, including reserved units; omitted units are written off, and only registered returned units can be restocked." type="p" style="text-grey-6 text-caption q-mt-xs q-mb-none"/>
                </container>
            </widgets>
        </section>

        <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-md q-mb-md">
            <label text="Products in this adjustment" type="h6" style="text-primary text-weight-bold q-mb-sm"/>
            <form-list name="ItemList" list="itemList" skip-form="true">
                <field name="productId"><default-field title="Product">
                    <label text="${countProductNames[productId] ?: 'Unavailable product'}" type="span"/>
                </default-field></field>
                <field name="assetId"><default-field title="Stock counted"><label text="${assetId ? (countAssetNames[assetId] ?: 'Unavailable batch') : 'All warehouse stock'}" type="span"/></default-field></field>
                <field name="serialSnapshot"><default-field title="Counted serials"><label text="${countSerialNames[adjustmentItemSeqId] ?: '—'}" type="span"/></default-field></field>
                <field name="systemQuantity"><default-field title="System has"><display text="${ec.l10n.format(systemQuantity ?: 0,'#,##0.######')}"/></default-field></field>
                <field name="actualQuantity"><default-field title="You counted"><display text="${ec.l10n.format(actualQuantity ?: 0,'#,##0.######')}"/></default-field></field>
                <field name="differenceQuantity"><default-field title="Difference">
                    <label text="${(differenceQuantity ?: 0) > 0 ? '+' : ''}${ec.l10n.format(differenceQuantity ?: 0,'#,##0.######')}" type="span" style="text-weight-bold ${(differenceQuantity ?: 0) > 0 ? 'text-success' : ((differenceQuantity ?: 0) &lt; 0 ? 'text-danger' : 'text-grey-7')}"/>
                </default-field></field>
                <field name="remarks"><default-field title="Note"><display/></default-field></field>
                <field name="del">
                  <!-- ZE-INV-010: Remove line is a write action — hidden for view-only users -->
                  <conditional-field name="delWrite" condition="invCanWrite" title="">
                    <link url="deleteItem" text="Remove" parameter-map="[stockAdjustmentId:stockAdjustmentId, adjustmentItemSeqId:adjustmentItemSeqId]" condition="isDraft" style="text-danger"/>
                  </conditional-field>
                  <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
            <section name="NoItems">
                <condition><expression>!itemList</expression></condition>
                <widgets><label text="No products added yet — add the items you want to recount above." type="p" style="text-grey-6 q-pa-sm"/></widgets>
            </section>
        </container>

        <!-- ZE-INV-010: Apply is a write action — hidden for view-only users -->
        <section name="ApproveRow">
            <condition><expression>isDraft &amp;&amp; itemList &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container-dialog id="ApproveCountsDialog" button-text="Approve counts">
                    <label text="Approve these counts and lock the adjustment? You can reopen approved counts before applying." type="p"/>
                    <form-single name="ApproveCountsForm" transition="approveAdjustment">
                        <field name="stockAdjustmentId"><default-field><hidden/></default-field></field>
                        <field name="submitButton"><default-field title="Confirm approval"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <section name="ReopenRow">
            <condition><expression>isApproved &amp;&amp; invCanWrite</expression></condition>
            <widgets><link url="reopenAdjustment" text="Reopen to correct counts" parameter-map="[stockAdjustmentId:stockAdjustmentId]" style="q-btn btn btn-default"/></widgets>
        </section>
        <section name="ApplyRow">
            <condition><expression>isApproved &amp;&amp; itemList &amp;&amp; invCanWrite</expression></condition>
            <widgets>
                <container style="row items-center justify-between bg-green-1 q-pa-md border-radius-md">
                    <label text="Ready? Applying will update your real on-hand stock to the counts above. This can't be undone." type="p" style="text-grey-8 q-mb-none"/>
                    <container-dialog id="ApplyCountsDialog" button-text="Apply &amp; update stock">
                        <label text="Apply this adjustment? On-hand stock will match the approved counts. This action cannot be undone or applied again." type="p"/>
                        <form-single name="ApplyCountsForm" transition="applyAdjustment">
                            <field name="stockAdjustmentId"><default-field><hidden/></default-field></field>
                            <field name="submitButton"><default-field title="Confirm and update stock"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>
            </widgets>
        </section>
        <section name="DoneRow">
            <condition><expression>isApplied</expression></condition>
            <widgets>
                <container style="bg-green-1 q-pa-md border-radius-md text-center">
                    <label text="✓ This adjustment has been applied — your stock is updated." type="p" style="text-success text-weight-bold q-mb-none"/>
                </container>
            </widgets>
        </section>
        </widgets>
        </section>
        </container>
    </widgets>
</screen>
