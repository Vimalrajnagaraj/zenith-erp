<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock Transfers" default-menu-index="3">

    <parameter name="quickSearch"/>

    <!-- stock-creation: New Transfer is now the full-page ../NewStockTransfer screen (which owns createTransfer). -->
    <transition name="updateTransfer">
        <actions>
            <!-- ZE-INV-IV-06A: block editing another tenant's transfer via a forged list POST -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.StockTransferServices.update#StockTransferLogistics" in-map="context"/>
        </actions>
        <default-response url="."><parameter name="quickSearch" from="returnQuickSearch"/><parameter name="pageSize" from="returnPageSize"/><parameter name="fromFacilityId" from="returnFromFacilityId"/><parameter name="toFacilityId" from="returnToFacilityId"/><parameter name="transferNumber" from="returnTransferNumber"/><parameter name="transferNumber_op" from="returnTransferNumber_op"/><parameter name="transferDate_from" from="returnTransferDate_from"/><parameter name="transferDate_thru" from="returnTransferDate_thru"/><parameter name="orderByField" from="returnOrderByField"/><parameter name="statusId" from="listStatusId"/></default-response>
    </transition>
    <transition name="shipTransfer">
        <actions>
            <!-- ZE-INV-IV-06A: block shipping another tenant's transfer -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <!-- XF-002 f/u: bare service-call inside a transition's <actions> does NOT see the posted params
                 (only a direct <transition> child auto-maps); the IDOR sweep wrapped this in <actions> for the
                 assert but dropped the in-map, so the list's Ship button failed "Field cannot be empty". -->
            <service-call name="zenith.inventory.InventoryServices.ship#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="."><parameter name="quickSearch"/><parameter name="pageSize"/><parameter name="fromFacilityId"/><parameter name="toFacilityId"/><parameter name="transferNumber"/><parameter name="transferNumber_op"/><parameter name="transferDate_from"/><parameter name="transferDate_thru"/><parameter name="orderByField"/><parameter name="statusId" from="listStatusId"/></default-response>
    </transition>
    <transition name="receiveTransfer">
        <actions>
            <!-- ZE-INV-IV-06A: block receiving another tenant's transfer -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <!-- XF-002 f/u: restore the dropped in-map (see shipTransfer above) — the list's Receive button
                 failed silently without it. -->
            <service-call name="zenith.inventory.InventoryServices.receive#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="."><parameter name="quickSearch"/><parameter name="pageSize"/><parameter name="fromFacilityId"/><parameter name="toFacilityId"/><parameter name="transferNumber"/><parameter name="transferNumber_op"/><parameter name="transferDate_from"/><parameter name="transferDate_thru"/><parameter name="orderByField"/><parameter name="statusId" from="listStatusId"/></default-response>
    </transition>
    <!-- XF-004: delete a draft transfer straight from the list (service enforces StxDraft-only). -->
    <transition name="deleteTransfer">
        <actions>
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't delete this transfer."/></if>
            <!-- ZE-INV-IV-06A: block deleting another tenant's transfer -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockTransferAccess" in-map="[stockTransferId:stockTransferId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.delete#StockTransfer" in-map="[stockTransferId:stockTransferId]"/>
        </actions>
        <default-response url="."><parameter name="quickSearch"/><parameter name="pageSize"/><parameter name="fromFacilityId"/><parameter name="toFacilityId"/><parameter name="transferNumber"/><parameter name="transferNumber_op"/><parameter name="transferDate_from"/><parameter name="transferDate_thru"/><parameter name="orderByField"/><parameter name="statusId" from="listStatusId"/></default-response>
    </transition>

    <actions>
        <set field="stockTransferExport" from="sri.renderMode in ['csv','xlsx']"/>
        <set field="transferOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="transferOrg" from="transferOrg &amp;&amp; transferOrg != '_NA_' ? transferOrg : '_NA_'"/>
        <script><![CDATA[
            // Append a stable tie-breaker after the requested sort; pre-ordering the find would suppress its default date ordering.
            orderByField = orderByField instanceof Collection ? orderByField.join(',') : (orderByField ?: '-transferDate').toString()
            def stableSort = orderByField
            if (!stableSort.split(',').any { it.replaceFirst('^[-+]', '') == 'stockTransferId' }) stableSort += ',-stockTransferId'
            transferSearch = new HashMap(ec.context)
            transferSearch.orderByField = stableSort
            quickTransferIds = []
            def term = quickSearch?.toString()?.trim()
            if (term && transferOrg != '_NA_') {
                def products = ec.entity.find('mantle.product.Product').condition('ownerPartyId', transferOrg)
                    .condition(ec.entity.conditionFactory.makeCondition([
                        ec.entity.conditionFactory.makeCondition('productName', org.moqui.entity.EntityCondition.LIKE, '%' + term + '%').ignoreCase(),
                        ec.entity.conditionFactory.makeCondition('pseudoId', org.moqui.entity.EntityCondition.LIKE, '%' + term + '%').ignoreCase()
                    ], org.moqui.entity.EntityCondition.OR)).selectField('productId').list().collect { it.productId }
                if (products) quickTransferIds = ec.entity.find('zenith.erp.inventory.StockTransferItem').condition('productId', 'in', products)
                    .selectField('stockTransferId').distinct(true).list().collect { it.stockTransferId }
            }
        ]]></script>
        <entity-find entity-name="zenith.erp.inventory.StockTransferView" list="transferList">
            <search-form-inputs input-fields-map="transferSearch" default-order-by="-transferDate,-stockTransferId"/>
            <econdition field-name="organizationPartyId" from="transferOrg"/>
            <!-- ZE-INV-STK-SEARCH (stock-transfers §6): quick-search box — case-insensitive OR across transfer #,
                 from- and to-warehouse names. Each term is ignore-if-empty, so an empty box is a full no-op
                 (the whole OR group contributes nothing) and the list is byte-identical to before. -->
            <econditions combine="or">
                <econdition field-name="stockTransferId" operator="in" from="quickTransferIds ?: ['_NO_MATCH_']" ignore-if-empty="true" ignore="!quickSearch?.toString()?.trim()"/>
                <econdition field-name="stockTransferId" operator="like" ignore-case="true" ignore-if-empty="true"
                            from="ec.context.quickSearch ? ('%' + ec.context.quickSearch.toString().trim() + '%') : null"/>
                <econdition field-name="transferNumber" operator="like" ignore-case="true" ignore-if-empty="true"
                            from="ec.context.quickSearch ? ('%' + ec.context.quickSearch.toString().trim() + '%') : null"/>
                <econdition field-name="fromFacilityName" operator="like" ignore-case="true" ignore-if-empty="true"
                            from="ec.context.quickSearch ? ('%' + ec.context.quickSearch.toString().trim() + '%') : null"/>
                <econdition field-name="toFacilityName" operator="like" ignore-case="true" ignore-if-empty="true"
                            from="ec.context.quickSearch ? ('%' + ec.context.quickSearch.toString().trim() + '%') : null"/>
            </econditions>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="transferOrg"/><order-by field-name="facilityName"/></entity-find>
        <!-- ZE-INV-IV-070: the Organization is ALWAYS the tenant's own active org (a transfer is within one org).
             The IV-031 picker (get#ActiveOrgList -> list-options) rendered EMPTY on /qapps — the Vue m-drop-down
             got "no options and no options-url" — so the required field couldn't be selected and New Transfer was
             fully blocked. Auto-fill the org (like From/To warehouse); create#StockTransfer also defaults it
             server-side. Guard '_NA_' (a super-admin with no active org) down to null. -->
        <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="organizationPartyId == '_NA_'"><set field="organizationPartyId" from="null"/></if>

        <!-- ZE-INV-STK-KPI: five summary counts for the KPI row (org-scoped like the list; no active org returns zero).
             Real data — NOT the mockup's illustrative 24/6/18/2/1. Total = all transfers; Pending = Draft (awaiting
             ship); In Transit = shipped-not-received; Completed = Received; Today = transferDate is today. -->
        <script><![CDATA[
            def _org = ec.user.getPreference('ACTIVE_ORGANIZATION')
            def _stCount = { st ->
                def f = ec.entity.find("zenith.erp.inventory.StockTransfer")
                f.condition("organizationPartyId", transferOrg)
                if (st) f.condition("statusId", st)
                f.count()
            }
            kpiTotal     = _stCount(null)
            kpiInTransit = _stCount('StxInTransit')
            kpiCompleted = _stCount('StxReceived')
            kpiPending   = _stCount('StxDraft')
            def _cal = java.util.Calendar.getInstance(ec.user.timeZone); _cal.setTime(ec.user.nowTimestamp)
            _cal.set(java.util.Calendar.HOUR_OF_DAY,0); _cal.set(java.util.Calendar.MINUTE,0); _cal.set(java.util.Calendar.SECOND,0); _cal.set(java.util.Calendar.MILLISECOND,0)
            def _t0 = new java.sql.Timestamp(_cal.getTimeInMillis())
            _cal.add(java.util.Calendar.DAY_OF_MONTH,1); def _t1 = new java.sql.Timestamp(_cal.getTimeInMillis())
            def _ft = ec.entity.find("zenith.erp.inventory.StockTransfer")
            _ft.condition("organizationPartyId", transferOrg)
            _ft.condition("transferDate", org.moqui.entity.EntityCondition.GREATER_THAN_EQUAL_TO, _t0).condition("transferDate", org.moqui.entity.EntityCondition.LESS_THAN, _t1)
            kpiToday = _ft.count()
        ]]></script>
    </actions>

    <widgets>
        <section name="StockTransfersInteractive" condition="!stockTransferExport"><widgets>
        <container id="stockTransfers">
            <container style="st-page-head">
                <container><label text="Stock Transfers" type="h3"/><label text="Move stock from one store/warehouse to another. Create a transfer, &quot;Ship&quot; it (stock leaves the sender), then &quot;Receive&quot; it (stock arrives at the receiver)." type="p"/></container>
                <section name="NewTransferWrite" condition="invCanWrite &amp;&amp; transferOrg != '_NA_'"><widgets><link url="../NewStockTransfer" text="New Transfer" icon="fa fa-plus" btn-type="primary" style="z-solid st-new-transfer"/></widgets></section>
            </container>
            <section name="NoTransferOrganization" condition="transferOrg == '_NA_'"><widgets><label text="Select an organization to view or create stock transfers." type="p" style="st-notice"/></widgets></section>
            <render-mode><text type="html,qvt,vuet" template="true"><![CDATA[
                <div class="stk-row"><div class="stk-card stk-blue"><span class="stk-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16m-5-5 5 5-5 5M20 17H4m5-5-5 5 5 5"/></svg></span><div class="stk-txt"><span class="stk-lab">Total Transfers</span><span class="stk-val">${(kpiTotal!0)?c}</span></div></div><div class="stk-card stk-green"><span class="stk-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5Zm-9 5v10l9 5 9-5V7M12 12v10"/></svg></span><div class="stk-txt"><span class="stk-lab">In Transit</span><span class="stk-val">${(kpiInTransit!0)?c}</span></div></div><div class="stk-card stk-violet"><span class="stk-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17V5h11v12H3Zm11-9h4l3 4v5h-7M3 17H1"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span><div class="stk-txt"><span class="stk-lab">Completed</span><span class="stk-val">${(kpiCompleted!0)?c}</span></div></div><div class="stk-card stk-red"><span class="stk-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 10 18H2L12 3Zm0 6v5m0 3h.01"/></svg></span><div class="stk-txt"><span class="stk-lab">Pending</span><span class="stk-val">${(kpiPending!0)?c}</span></div></div><div class="stk-card stk-amber"><span class="stk-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6m10-6v6M3 11h18"/></svg></span><div class="stk-txt"><span class="stk-lab">Today</span><span class="stk-val">${(kpiToday!0)?c}</span></div></div></div>
            ]]></text></render-mode>
            <render-mode><text type="html,qvt,vuet" template="true"><![CDATA[
                <#assign _q0 = (quickSearch)!''>
                <form class="sup-searchrow" aria-label="Search stock transfers" method="get">
                  <input type="hidden" name="pageIndex" value="0"/>
                  <#list ['statusId','fromFacilityId','toFacilityId','transferNumber','transferNumber_op','transferDate_from','transferDate_thru','pageSize','orderByField'] as filterName>
                    <#assign filterValue = (ec.web.requestParameters[filterName])!''>
                    <#if filterValue?has_content><input type="hidden" name="${filterName}" value="${filterValue?string?html}"/></#if>
                  </#list>
                  <div class="sup-search">
                    <svg class="sup-search-ico" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg>
                    <input aria-label="Search stock transfers" type="search" name="quickSearch" class="sup-search-input" value="${_q0?html}" placeholder="Search by transfer no., from, to or product..." autocomplete="off" style="padding-right:16px"/>
                  </div>
                  <button type="submit" class="stk-search-go">Search</button>
                  <button type="button" class="st-filter"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 4h18l-7 8v7l-4 2v-9L3 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>Filters</button>
                </form>
            ]]></text></render-mode>
            <container style="st-stock-card">
                <render-mode><text type="html,qvt,vuet"><![CDATA[<div class="st-card-head"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="6" height="7" rx="1"/><rect x="15" y="3" width="6" height="7" rx="1"/><rect x="3" y="14" width="6" height="7" rx="1"/><path d="M18 14v7m-3-4 3-3 3 3"/></svg>Stock Transfers</h2></div>]]></text></render-mode>
                <container style="st-native-list">
            <form-list name="TransferListForm" list="transferList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <row-actions>
                    <script><![CDATA[
                        def esc = { value -> (value ?: '').toString().replace('&','&amp;').replace('"','&quot;').replace('<','&lt;').replace('>','&gt;').replace("'",'&#39;') }
                        def pagePath = (sri.renderMode in ['qvt','vuet'] || ec.web.request.requestURI.startsWith('/qapps/') ? '/qapps' : '/apps') + '/zenith/Inventory/StockTransfers'
                        def id = java.net.URLEncoder.encode(stockTransferId.toString(), 'UTF-8')
                        def parentPath = pagePath.substring(0,pagePath.lastIndexOf('/'))
                        transferActionsHtml = "<details class='st-row-menu'><summary aria-label='Transfer actions'><span class='material-icons' aria-hidden='true'>more_vert</span></summary><div class='st-row-options'><a href='" + parentPath + '/EditStockTransfer?stockTransferId=' + id + "'>View transfer</a>"
                        if (invCanWrite) {
                            if (statusId in ['StxDraft','StxInTransit']) transferActionsHtml += "<button type='button' class='st-logistics-proxy' data-transfer-id='" + esc(stockTransferId) + "'>Logistics</button>"
                            def actions = statusId == 'StxDraft' ? [[name:'shipTransfer', label:'Ship', confirm:'Ship this transfer? Stock will leave the sender.'],[name:'deleteTransfer',label:'Delete draft',confirm:'Delete this draft transfer and its product lines?']] :
                                (statusId == 'StxInTransit' ? [[name:'receiveTransfer',label:'Receive',confirm:'Receive this transfer? The actual quantities will be added to the receiver.']] : [])
                            for (action in actions) {
                                transferActionsHtml += "<form method='post' class='st-action-form' action='" + pagePath + '/' + action.name + "' data-confirm='" + esc(action.confirm) + "'><input type='hidden' name='moquiSessionToken' value='" + esc(ec.web.sessionToken) + "'><input type='hidden' name='stockTransferId' value='" + esc(stockTransferId) + "'>"
                                for (key in ['quickSearch','pageSize','fromFacilityId','toFacilityId','transferNumber','transferNumber_op','transferDate_from','transferDate_thru','orderByField']) {
                                    def value = ec.web.requestParameters[key]
                                    if (value) transferActionsHtml += "<input type='hidden' name='" + key + "' value='" + esc(value) + "'>"
                                }
                                if (ec.web.requestParameters.statusId) transferActionsHtml += "<input type='hidden' name='listStatusId' value='" + esc(ec.web.requestParameters.statusId) + "'>"
                                transferActionsHtml += "<button type='submit'" + (action.name == 'deleteTransfer' ? " class='st-delete'" : '') + '>' + action.label + '</button></form>'
                            }
                        }
                        transferActionsHtml += '</div></details>'
                    ]]></script>
                </row-actions>
                <field name="transferNumber">
                    <header-field title="Transfer #" show-order-by="true"><text-find hide-options="true"/></header-field>
                    <!-- stock-transfers §7b/§9: Transfer # as a white link-pill (1px primary border, primary text). -->
                    <default-field><link url="../EditStockTransfer" text="${transferNumber ?: stockTransferId}" parameter-map="[stockTransferId:stockTransferId]" link-type="anchor" style="stk-idpill"/></default-field>
                </field>
                <field name="transferDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd MMM yy"/></default-field>
                </field>
                <field name="fromFacilityId">
                    <header-field title="From"><drop-down allow-empty="true"><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down></header-field>
                    <default-field title="From"><display text="${fromFacilityName ?: '—'}"/></default-field>
                </field>
                <field name="toFacilityId">
                    <header-field title="To"><drop-down allow-empty="true"><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down></header-field>
                    <default-field title="To"><display text="${toFacilityName ?: '—'}"/></default-field>
                </field>
                <field name="totalValue">
                    <header-field title="Value" show-order-by="true"/>
                    <default-field><display text="${totalValue != null ? ec.l10n.format(totalValue, '#,##0.00') : '—'}"/></default-field>
                </field>
                <field name="ewayBillRequired">
                    <default-field title="E-Way"><display/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="StxDraft" text="Pending"/>
                            <option key="StxInTransit" text="In Transit"/>
                            <option key="StxReceived" text="Received"/>
                            <option key="StxCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <!-- Reference labels preserve the underlying lifecycle status IDs. -->
                    <default-field><label type="span" text="${statusId == 'StxDraft' ? 'Pending' : (statusId == 'StxReceived' ? 'StxReceived' : (ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId))}" style="st-status ${(statusId == 'StxReceived') ? 'st-status-green' : (statusId == 'StxInTransit' ? 'st-status-blue' : 'st-status-red')}"/></default-field>
                </field>
                <field name="dispatchLogistics">
                    <conditional-field condition="sri.renderMode in ['csv','xlsx']" title="Logistics &amp; Tax">
                        <display text="${(vehicleNumber ? 'Veh: '+vehicleNumber+' ' : '') + (lrNumber ? 'LR: '+lrNumber+' ' : '') + (igstInvoiceId ? 'IGST: '+igstInvoiceId : '')}"/>
                    </conditional-field>
                    <!-- ZE-INV-010: the Logistics edit dialog is write-only; view-only users still see the read labels below -->
                    <conditional-field name="dispatchWrite" condition="invCanWrite" title="E-Way Bill &amp; Logistics">
                        <container style="st-native-logistics"><container-dialog id="DispatchDialog_${stockTransferId}" button-text="Logistics" condition="statusId == 'StxDraft' || statusId == 'StxInTransit'">
                            <form-single name="UpdateLogisticsForm_${stockTransferId}" transition="updateTransfer">
                                <field name="stockTransferId"><default-field><hidden/></default-field></field>
                                <field name="returnQuickSearch"><default-field><hidden default-value="${ec.web.requestParameters.quickSearch ?: ''}"/></default-field></field>
                                <field name="returnPageSize"><default-field><hidden default-value="${ec.web.requestParameters.pageSize ?: ''}"/></default-field></field>
                                <field name="returnFromFacilityId"><default-field><hidden default-value="${ec.web.requestParameters.fromFacilityId ?: ''}"/></default-field></field>
                                <field name="returnToFacilityId"><default-field><hidden default-value="${ec.web.requestParameters.toFacilityId ?: ''}"/></default-field></field>
                                <field name="returnTransferNumber"><default-field><hidden default-value="${ec.web.requestParameters.transferNumber ?: ''}"/></default-field></field>
                                <field name="returnTransferNumber_op"><default-field><hidden default-value="${ec.web.requestParameters.transferNumber_op ?: ''}"/></default-field></field>
                                <field name="returnTransferDate_from"><default-field><hidden default-value="${ec.web.requestParameters.transferDate_from ?: ''}"/></default-field></field>
                                <field name="returnTransferDate_thru"><default-field><hidden default-value="${ec.web.requestParameters.transferDate_thru ?: ''}"/></default-field></field>
                                <field name="returnOrderByField"><default-field><hidden default-value="${ec.web.requestParameters.orderByField ?: ''}"/></default-field></field>
                                <field name="listStatusId"><default-field><hidden default-value="${ec.web.requestParameters.statusId ?: ''}"/></default-field></field>
                                <field name="transporterGstin"><default-field title="Transporter GSTIN"><text-line size="15" default-value="${transporterGstin ?: ''}"/></default-field></field>
                                <field name="lrNumber"><default-field title="LR Number"><text-line size="20" default-value="${lrNumber ?: ''}"/></default-field></field>
                                <field name="vehicleNumber"><default-field title="Vehicle No."><text-line size="15" default-value="${vehicleNumber ?: ''}"/></default-field></field>
                                <field name="submitButton"><default-field title="Save logistics"><submit/></default-field></field>
                            </form-single>
                        </container-dialog></container>
                        <label text="—" type="span" condition="!vehicleNumber &amp;&amp; !lrNumber &amp;&amp; !igstInvoiceId &amp;&amp; !(fromFacilityGstin &amp;&amp; toFacilityGstin)"/>
                        <!-- Show them if present -->
                        <label text="${vehicleNumber ? 'Veh: ' + vehicleNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="vehicleNumber"/>
                        <label text="${lrNumber ? 'LR: ' + lrNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="lrNumber"/>
                        <!-- IGST indicator -->
                        <label text="IGST Invoice: ${igstInvoiceId}" type="span" style="block text-warning text-caption text-weight-bold" condition="igstInvoiceId"/>
                        <!-- ZE-INV-IV-074: inter- vs intra-state is decided by the STATE CODE (first 2 digits of the
                             GSTIN), NOT the full GSTIN — two GSTINs in the SAME state is INTRA-state (CGST+SGST, no
                             IGST). Comparing whole GSTINs mislabeled a same-state / different-GSTIN move (e.g. 100868,
                             both state 29) as inter-state. -->
                        <label text="Inter-state move — IGST pending" type="span" style="block text-warning text-caption" condition="!igstInvoiceId &amp;&amp; fromFacilityGstin &amp;&amp; toFacilityGstin &amp;&amp; fromFacilityGstin.take(2) != toFacilityGstin.take(2)"/>
                        <label text="No IGST — intra-state" type="span" style="block text-grey-6 text-caption" condition="!igstInvoiceId &amp;&amp; fromFacilityGstin &amp;&amp; toFacilityGstin &amp;&amp; fromFacilityGstin.take(2) == toFacilityGstin.take(2)"/>
                    </conditional-field>
                    <default-field title="E-Way Bill &amp; Logistics">
                        <label text="—" type="span" condition="!vehicleNumber &amp;&amp; !lrNumber &amp;&amp; !igstInvoiceId &amp;&amp; !(fromFacilityGstin &amp;&amp; toFacilityGstin)"/>
                        <!-- read-only: logistics/tax info without the edit dialog -->
                        <label text="${vehicleNumber ? 'Veh: ' + vehicleNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="vehicleNumber"/>
                        <label text="${lrNumber ? 'LR: ' + lrNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="lrNumber"/>
                        <label text="IGST Invoice: ${igstInvoiceId}" type="span" style="block text-warning text-caption text-weight-bold" condition="igstInvoiceId"/>
                        <!-- ZE-INV-IV-074: inter- vs intra-state is decided by the STATE CODE (first 2 digits of the
                             GSTIN), NOT the full GSTIN — two GSTINs in the SAME state is INTRA-state (CGST+SGST, no
                             IGST). Comparing whole GSTINs mislabeled a same-state / different-GSTIN move (e.g. 100868,
                             both state 29) as inter-state. -->
                        <label text="Inter-state move — IGST pending" type="span" style="block text-warning text-caption" condition="!igstInvoiceId &amp;&amp; fromFacilityGstin &amp;&amp; toFacilityGstin &amp;&amp; fromFacilityGstin.take(2) != toFacilityGstin.take(2)"/>
                        <label text="No IGST — intra-state" type="span" style="block text-grey-6 text-caption" condition="!igstInvoiceId &amp;&amp; fromFacilityGstin &amp;&amp; toFacilityGstin &amp;&amp; fromFacilityGstin.take(2) == toFacilityGstin.take(2)"/>
                    </default-field>
                </field>
                <field name="actions">
                    <conditional-field condition="sri.renderMode == 'csv'"><ignored/></conditional-field>
                    <default-field title=""><display text="${transferActionsHtml}" encode="false"/></default-field>
                </field>
                <field name="stockTransferId"><header-field title="Transfer ID" show-order-by="true"><hidden/></header-field><default-field><ignored/></default-field></field>
                <field name="quickSearch"><header-field><hidden/></header-field><default-field><ignored/></default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
                </container>
            </container>
        </container>
        </widgets></section>
        <section name="StockTransfersExport" condition="stockTransferExport"><widgets>
            <form-list name="TransferExportForm" list="transferList" skip-form="true">
                <field name="transferNumber"><default-field title="Transfer #"><display text="${transferNumber ?: stockTransferId}"/></default-field></field>
                <field name="transferDate"><default-field title="Date"><display format="dd MMM yy"/></default-field></field>
                <field name="fromFacilityName"><default-field title="From"><display/></default-field></field>
                <field name="toFacilityName"><default-field title="To"><display/></default-field></field>
                <field name="totalValue"><default-field title="Value"><display text="${totalValue != null ? ec.l10n.format(totalValue, '#,##0.00') : '—'}"/></default-field></field>
                <field name="ewayBillRequired"><default-field title="E-Way"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display text="${statusId == 'StxDraft' ? 'Pending' : (statusId == 'StxReceived' ? 'StxReceived' : (ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId))}"/></default-field></field>
                <field name="dispatchLogistics"><default-field title="E-Way Bill &amp; Logistics"><display text="${(vehicleNumber ? 'Veh: '+vehicleNumber+' ' : '') + (lrNumber ? 'LR: '+lrNumber+' ' : '') + (igstInvoiceId ? 'IGST: '+igstInvoiceId : '')}"/></default-field></field>
            </form-list>
        </widgets></section>
    </widgets>
</screen>
