<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock Transfers" default-menu-index="3">

    <transition name="createTransfer">
        <service-call name="zenith.inventory.InventoryServices.create#StockTransfer"/>
        <default-response url="../EditStockTransfer"><parameter name="stockTransferId" from="stockTransferId"/></default-response>
    </transition>
    <transition name="updateTransfer">
        <service-call name="update#zenith.erp.inventory.StockTransfer" in-map="context"/>
        <default-response url="."/>
    </transition>
    <transition name="shipTransfer">
        <service-call name="zenith.inventory.InventoryServices.ship#StockTransfer"/>
        <default-response url="."/>
    </transition>
    <transition name="receiveTransfer">
        <service-call name="zenith.inventory.InventoryServices.receive#StockTransfer"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.inventory.StockTransferView" list="transferList">
            <search-form-inputs default-order-by="-transferDate"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/></entity-find>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Stock Transfers"/><box-toolbar>
            <!-- friendly intro in body -->
            <container-dialog id="NewTransferDialog" button-text="New Transfer">
                <form-single name="NewTransferForm" transition="createTransfer">
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down>
                            <list-options list="orgList" key="${partyId}" text="${organizationName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="fromFacilityId"><default-field title="From Warehouse">
                        <drop-down>
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="toFacilityId"><default-field title="To Warehouse">
                        <drop-down>
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="transferDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Transfer"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <label text="Move stock from one store/warehouse to another. Create a transfer, &quot;Ship&quot; it (stock leaves the sender), then &quot;Receive&quot; it (stock arrives at the receiver)." type="p" style="text-grey-7 q-pa-sm q-mb-sm"/>
            <form-list name="TransferListForm" list="transferList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="transferNumber">
                    <header-field title="Transfer #" show-order-by="true"><text-find hide-options="true"/></header-field>
                    <default-field><link url="../EditStockTransfer" text="${transferNumber ?: stockTransferId}" parameter-map="[stockTransferId:stockTransferId]" style="text-indigo-8 text-weight-bold"/></default-field>
                </field>
                <field name="transferDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="fromFacilityName">
                    <default-field title="From"><display/></default-field>
                </field>
                <field name="toFacilityName">
                    <default-field title="To"><display/></default-field>
                </field>
                <field name="totalValue">
                    <header-field title="Value" show-order-by="true"/>
                    <default-field><display format="#,##,##0.00"/></default-field>
                </field>
                <field name="ewayBillRequired">
                    <default-field title="E-Way"><display/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="StxDraft" text="Draft"/>
                            <option key="StxInTransit" text="In Transit"/>
                            <option key="StxReceived" text="Received"/>
                            <option key="StxCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="dispatchLogistics">
                    <conditional-field condition="ec.web?.parameters?.renderMode == 'csv' || ec.web?.parameters?.renderMode == 'xlsx'" title="Logistics &amp; Tax">
                        <display text="${(vehicleNumber ? 'Veh: '+vehicleNumber+' ' : '') + (lrNumber ? 'LR: '+lrNumber+' ' : '') + (igstInvoiceId ? 'IGST: '+igstInvoiceId : '')}"/>
                    </conditional-field>
                    <default-field title="E-Way Bill &amp; Logistics">
                        <container-dialog id="DispatchDialog_${stockTransferId}" button-text="Logistics" condition="statusId == 'StxDraft' || statusId == 'StxInTransit'">
                            <form-single name="UpdateLogisticsForm_${stockTransferId}" transition="updateTransfer">
                                <field name="stockTransferId"><default-field><hidden/></default-field></field>
                                <field name="transporterGstin"><default-field title="Transporter GSTIN"><text-line size="15" default-value="${transporterGstin ?: ''}"/></default-field></field>
                                <field name="lrNumber"><default-field title="LR Number"><text-line size="20" default-value="${lrNumber ?: ''}"/></default-field></field>
                                <field name="vehicleNumber"><default-field title="Vehicle No."><text-line size="15" default-value="${vehicleNumber ?: ''}"/></default-field></field>
                                <field name="submitButton"><default-field title="Save &amp; Generate E-Way Bill"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <!-- Show them if present -->
                        <label text="${vehicleNumber ? 'Veh: ' + vehicleNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="vehicleNumber"/>
                        <label text="${lrNumber ? 'LR: ' + lrNumber : ''}" type="span" style="block text-grey-7 text-caption" condition="lrNumber"/>
                        <!-- IGST indicator -->
                        <label text="IGST Invoice: ${igstInvoiceId}" type="span" style="block text-warning text-caption text-weight-bold" condition="igstInvoiceId"/>
                        <label text="Inter-state move — IGST pending" type="span" style="block text-warning text-caption" condition="!igstInvoiceId &amp;&amp; fromFacilityId != toFacilityId"/>
                    </default-field>
                </field>
                <field name="actions">
                    <conditional-field condition="ec.web?.parameters?.renderMode == 'csv' || ec.web?.parameters?.renderMode == 'xlsx'"><ignored/></conditional-field>
                    <default-field title="">
                        <link url="shipTransfer" text="Ship" parameter-map="[stockTransferId:stockTransferId]"
                              condition="statusId == 'StxDraft'" confirmation="Ship this transfer? Stock will be deducted from source."/>
                        <link url="receiveTransfer" text="Receive" parameter-map="[stockTransferId:stockTransferId]"
                              condition="statusId == 'StxInTransit'" confirmation="Receive this transfer? Stock will be added to destination."/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
