<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Expiry Risk Dashboard" default-menu-index="2">

    <!-- ZE-INV-001 (IV-100): the Expiry Risk module had no way to create expiry-tracked stock (the only flow that
         sets an expiry date is ReceiveInventory, which needs a purchase order), so the dashboard was always empty.
         This adds a direct "Add Expiring Stock" entry that creates an Asset with an expiry date, batch, quantity
         and a valuationRate (which is what the dashboard values by — ReceiveInventory only set acquireCost), owned
         by the active org so it shows for that tenant. Also writes the AssetDetail ledger entry so the on-hand
         quantity persists (a direct qoh with no ledger receipt gets zeroed on the first sale). -->
    <transition name="createExpiryStock">
        <actions>
            <!-- ZE-INV-010 (IV-110): enforce Inventory write access (defense-in-depth; the central gate is fail-open) -->
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't make changes here."/></if>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!productId"><return error="true" message="Please select a product."/></if>
            <if condition="!expiryDate"><return error="true" message="Please enter an expiry date."/></if>
            <script><![CDATA[
                def _numOk = { v -> v != null && v.toString().trim() != '' && (v.toString().trim() ==~ /\d*\.?\d+/) }
                if (!_numOk(quantity)) { ec.message.addError("Quantity must be a number greater than zero."); return }
                def _qty = new BigDecimal(quantity)
                if (_qty.signum() <= 0) { ec.message.addError("Quantity must be greater than zero."); return }
                def _rate = _numOk(unitValue) ? new BigDecimal(unitValue) : BigDecimal.ZERO
                def _org = (activeOrg && activeOrg != '_NA_') ? activeOrg : null
                def inMap = [
                    assetTypeEnumId:'AstTpInventory', classEnumId:'AsClsInventory', statusId:'AstAvailable',
                    productId:productId, quantityOnHandTotal:_qty, availableToPromiseTotal:_qty,
                    valuationRate:_rate, acquireCost:_rate, expiryDate:expiryDate, receivedDate:ec.user.nowTimestamp
                ]
                if (_org) inMap.ownerPartyId = _org
                if (facilityId) inMap.facilityId = facilityId
                if (batchNumber) inMap.batchNumber = batchNumber
                def _a = ec.service.sync().name("create#mantle.product.asset.Asset").parameters(inMap).call()
                ec.service.sync().name("create#mantle.product.asset.AssetDetail").parameters([
                    assetId:_a.assetId, productId:productId, effectiveDate:ec.user.nowTimestamp,
                    quantityOnHandDiff:_qty, availableToPromiseDiff:_qty, description:'Expiry-tracked stock added']).call()
                ec.message.addMessage("Added " + _qty + " units (expiry " + expiryDate + "). It will appear below if it expires within 90 days.")
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-INV-007 (IV-106): UPDATE an existing expiry lot (expiry date, quantity, value, batch) from the dashboard.
         On save the dashboard re-renders (url=".") so the list + Risk Summary reflect the change immediately. The
         asset is looked up with disableAuthz but an EXPLICIT owner==active-org guard keeps a tenant from editing
         another tenant's stock (a super-admin with no active org may edit any). A quantity change also writes an
         AssetDetail ledger diff so the on-hand persists (matching the create path). -->
    <transition name="updateExpiryStock">
        <actions>
            <!-- ZE-INV-010 (IV-110): enforce Inventory write access (defense-in-depth; the central gate is fail-open) -->
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't make changes here."/></if>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!assetId"><return error="true" message="Missing stock reference."/></if>
            <if condition="!expiryDate"><return error="true" message="Please enter an expiry date."/></if>
            <script><![CDATA[
                def _asset = ec.entity.find("mantle.product.asset.Asset").condition("assetId", assetId).disableAuthz().one()
                if (_asset == null) { ec.message.addError("Stock not found."); return }
                if (activeOrg && activeOrg != '_NA_' && _asset.ownerPartyId != activeOrg) { ec.message.addError("You can only edit stock owned by your organization."); return }
                def _numOk = { v -> v != null && v.toString().trim() != '' && (v.toString().trim() ==~ /\d*\.?\d+/) }
                if (!_numOk(quantity)) { ec.message.addError("Quantity must be a number greater than zero."); return }
                def _newQty = new BigDecimal(quantity.toString().trim())
                if (_newQty.signum() <= 0) { ec.message.addError("Quantity must be greater than zero."); return }
                def _rate = _numOk(unitValue) ? new BigDecimal(unitValue.toString().trim()) : (_asset.valuationRate ?: BigDecimal.ZERO)
                def _oldQty = _asset.quantityOnHandTotal ?: BigDecimal.ZERO
                def _bn = (batchNumber != null && batchNumber.toString().trim() != '' && batchNumber.toString().trim() != 'N/A') ? batchNumber.toString().trim() : null
                // metadata (expiry / value / batch) — a plain field update; on-hand is ledger-driven, handled below
                ec.service.sync().name("update#mantle.product.asset.Asset")
                    .parameters([assetId:assetId, expiryDate:expiryDate, valuationRate:_rate, acquireCost:_rate, batchNumber:_bn]).call()
                // A quantity change is a formal Inventory Adjustment: record a StockAdjustment header (who / when /
                // reason / org) + a StockAdjustmentItem line (product / lot / system vs actual qty), so the correction
                // is visible in the Stock Adjustments audit trail — not just a bare ledger line. Created already-applied
                // because we post the ledger right here (the shared apply#StockAdjustment is product-level, not lot-
                // precise, so we can't reuse it for a specific expiry lot).
                if (_newQty.compareTo(_oldQty) != 0) {
                    def _reason = (adjustReason != null && adjustReason.toString().trim() != '') ? adjustReason.toString().trim() : 'PhysicalCount'
                    def _saOrg = (activeOrg && activeOrg != '_NA_') ? activeOrg : _asset.ownerPartyId
                    def _sa = ec.service.sync().name("create#zenith.erp.inventory.StockAdjustment").parameters([
                        organizationPartyId:_saOrg, facilityId:_asset.facilityId, adjustmentType:_reason,
                        adjustmentDate:ec.user.nowTimestamp, statusId:'AdjApplied', adjustedBy:ec.user.userId,
                        remarks:'Expiry Risk dashboard — lot ' + assetId + ' qty ' + _oldQty + ' → ' + _newQty]).call()
                    ec.service.sync().name("create#zenith.erp.inventory.StockAdjustmentItem").parameters([
                        stockAdjustmentId:_sa.stockAdjustmentId, productId:_asset.productId, assetId:assetId,
                        systemQuantity:_oldQty, actualQuantity:_newQty, differenceQuantity:_newQty.subtract(_oldQty),
                        valuationRate:_rate, remarks:'Edited from Expiry Risk dashboard']).call()
                    // Post the ledger for THIS lot. Moqui recomputes quantityOnHandTotal from the SUM of AssetDetail
                    // diffs, so the diff is (target - ledger sum), NOT (target - qoh) — this lands the on-hand exactly
                    // on target even for legacy/migrated lots whose qoh was set without a ledger, and reconciles it.
                    def _qohSum = BigDecimal.ZERO; def _atpSum = BigDecimal.ZERO
                    for (def d : ec.entity.find("mantle.product.asset.AssetDetail").condition("assetId", assetId).disableAuthz().list()) {
                        _qohSum = _qohSum.add(d.quantityOnHandDiff ?: BigDecimal.ZERO)
                        _atpSum = _atpSum.add(d.availableToPromiseDiff ?: BigDecimal.ZERO)
                    }
                    ec.service.sync().name("create#mantle.product.asset.AssetDetail").parameters([
                        assetId:assetId, productId:_asset.productId, effectiveDate:ec.user.nowTimestamp,
                        quantityOnHandDiff:_newQty.subtract(_qohSum), availableToPromiseDiff:_newQty.subtract(_atpSum),
                        description:'Stock adjustment ' + _sa.stockAdjustmentId + ' (' + _reason + ')']).call()
                    ec.message.addMessage("Updated stock " + assetId + " — qty " + _oldQty + " → " + _newQty + " (adjustment " + _sa.stockAdjustmentId + " logged). Expiry " + expiryDate + ".")
                } else {
                    ec.message.addMessage("Updated stock " + assetId + " — expiry " + expiryDate + ".")
                }
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-INV-004 (IV-103): the filter form submits here and just re-renders the dashboard; the actions read
         searchText / withinDays from the request and narrow the list. -->
    <transition name="filterExpiry">
        <default-response url="."/>
    </transition>

    <!-- ZE-INV-008 (IV-107): save this tenant's expiry-alert threshold + on/off -->
    <transition name="saveAlertSettings">
        <actions>
            <!-- ZE-INV-010 (IV-110): enforce Inventory write access (defense-in-depth; the central gate is fail-open) -->
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't make changes here."/></if>
            <set field="_org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!_org || _org == '_NA_'"><return error="true" message="Select an organization before changing alert settings."/></if>
            <service-call name="zenith.inventory.InventoryAlertServices.set#ExpiryAlertConfig"
                in-map="[organizationPartyId: _org, alertDays: alertDays, alertEnabled: alertEnabled, alertEmail: alertEmail]"/>
            <script>ec.message.addMessage("Expiry alert settings saved.")</script>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-INV-006 (IV-105): CSV export of the same (org-scoped, filtered, sorted) list, streamed as a download.
         read-only so it can be invoked from a GET link with the filter/sort URL params (like the print transitions);
         it only reads + writes the response, no data mutation. -->
    <transition name="exportCsv" read-only="true">
        <actions>
            <service-call name="zenith.inventory.InventoryServices.get#ExpiryRisk" out-map="_ex"
                in-map="[organizationPartyId: ec.user.getPreference('ACTIVE_ORGANIZATION'),
                         searchText: ec.context.searchText, withinDays: ec.context.withinDays, orderByField: ec.context.orderByField]"/>
            <script><![CDATA[
                def esc = { s -> '"' + (s == null ? '' : s.toString()).replace('"','""') + '"' }
                def sb = new StringBuilder()
                sb.append("Stock ID,Product Name,Batch/Lot,Supplier,Expiry Date,Days to Expiry,Quantity,Value at Risk,Valuation Basis\r\n")
                for (def r : (_ex.expiringAssets ?: [])) {
                    def _basis = (r.valueBasis == 'MRP') ? 'MRP (retail)' : (r.valueBasis == 'unvalued' ? 'not valued' : 'cost')
                    def _days = (r.daysToExpiry != null && r.daysToExpiry <= 0) ? 'EXPIRED' : ('' + r.daysToExpiry)
                    def _exp = r.expiryDate ? ec.l10n.format(r.expiryDate, 'yyyy-MM-dd') : ''
                    sb.append([esc(r.assetId), esc(r.productName), esc(r.batchNumber), esc(r.supplierName), esc(_exp), esc(_days), esc(r.quantity), esc(r.value), esc(_basis)].join(',')).append("\r\n")
                }
                ec.web.response.setContentType("text/csv; charset=UTF-8")
                ec.web.response.addHeader("Content-Disposition", "attachment; filename=\"expiry-risk-report.csv\"")
                def w = ec.web.response.getWriter(); w.write(sb.toString()); w.flush()
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <!-- ZE-INV-006 (IV-105) f/u: PDF export — redirect to the /fop print screen (XSL-FO -> PDF), carrying the
         current filter/sort. read-only so it accepts the GET URL params. -->
    <transition name="printExpiry" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/Inventory/ExpiryRiskPrint" url-type="plain">
            <parameter name="searchText"/>
            <parameter name="withinDays"/>
            <parameter name="orderByField"/>
            <parameter name="filename" value="expiry-risk-report.pdf"/>
        </default-response>
    </transition>

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <!-- ZE-INV-006 (IV-105): the list is built by the shared get#ExpiryRisk service (org isolation, value
             fallback, supplier, search+filter, sort) so the screen and the CSV export return the same data. -->
        <service-call name="zenith.inventory.InventoryServices.get#ExpiryRisk" out-map="expiryOut"
            in-map="[organizationPartyId: activeOrg,
                     searchText: ec.context.searchText, withinDays: ec.context.withinDays, orderByField: ec.context.orderByField]"/>
        <!-- ZE-INV-008 (IV-107): alert config + the live "expiring within your window" banner numbers -->
        <service-call name="zenith.inventory.InventoryAlertServices.get#ExpiryAlertConfig" out-map="alertCfg"
            in-map="[organizationPartyId: activeOrg]"/>
        <!-- ZE-INV-010 (IV-110): only users with WRITE (full) access to Inventory see the write features (Add /
             Edit / Alert Settings). View-only users get a read-only dashboard (list + export still available). -->
        <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
        <set field="invCanWrite" from="_wac?.canWrite ?: false"/>
        <script><![CDATA[
            def _ad = (alertCfg?.alertDays ?: 30) as Integer
            alertDays = _ad.toString()
            alertEnabled = alertCfg?.alertEnabled ?: 'Y'
            alertEmail = alertCfg?.alertEmail ?: 'N'
            def _items = (expiryOut?.expiringAssets ?: []).findAll { it.daysToExpiry != null && (it.daysToExpiry as Integer) <= _ad }
            alertCount = _items.size()
            def _av = BigDecimal.ZERO
            for (def r : _items) { _av = _av.add(r.value ?: BigDecimal.ZERO) }
            alertValue = _av
        ]]></script>
    </actions>

    <widgets>
        <!-- ZE-INV-001 (IV-100): direct entry to create expiry-tracked stock so the dashboard can be populated. -->
        <container style="row items-center justify-between q-mb-md">
            <label text="Track batches that will expire soon and act before they go to waste." type="span" style="text-grey-7 text-caption"/>
            <!-- ZE-INV-010 (IV-110): write features only for users with full Inventory access -->
            <section name="ExpiryWriteButtons">
              <condition><expression>invCanWrite</expression></condition>
              <widgets>
            <container style="row q-gutter-sm items-center">
            <!-- ZE-INV-008 (IV-107): configure the per-tenant expiry-alert threshold + on/off -->
            <container-dialog id="ExpiryAlertSettingsDialog" button-text="Alert Settings" button-icon="fa fa-bell"
                              button-class="q-btn bg-grey-3 text-dark text-weight-bold border-radius-md q-px-md">
                <form-single name="ExpiryAlertSettingsForm" transition="saveAlertSettings">
                    <field name="alertEnabled"><default-field title="Expiry alerts">
                        <drop-down allow-empty="false"><option key="Y" text="On — notify me"/><option key="N" text="Off"/></drop-down>
                    </default-field></field>
                    <field name="alertDays"><default-field title="Notify when a lot is expiring within">
                        <drop-down allow-empty="false"><option key="7" text="7 days"/><option key="15" text="15 days"/><option key="30" text="30 days"/><option key="60" text="60 days"/><option key="90" text="90 days"/></drop-down>
                    </default-field></field>
                    <field name="alertEmail"><default-field title="Also email a digest to my team">
                        <drop-down allow-empty="false"><option key="N" text="No — in-app only"/><option key="Y" text="Yes — email too"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title=""><submit text="Save Settings"/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="AddExpiryStockDialog" button-text="Add Expiring Stock" button-icon="fa fa-plus-circle"
                              button-class="q-btn bg-primary text-white text-weight-bold border-radius-md q-px-md">
                <form-single name="AddExpiryStockForm" transition="createExpiryStock">
                    <field name="productId"><default-field title="Product">
                        <drop-down allow-empty="false">
                            <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="productName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="batchNumber"><default-field title="Batch / Lot (Optional)"><text-line size="20"/></default-field></field>
                    <field name="quantity"><default-field title="Quantity"><text-line size="10"/></default-field></field>
                    <field name="unitValue"><default-field title="Value per Unit (${currSymbol})"><text-line size="10"/></default-field></field>
                    <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date"/></default-field></field>
                    <field name="facilityId"><default-field title="Store / Warehouse (Optional)">
                        <drop-down allow-empty="true">
                            <entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="facilityName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title=""><submit text="Add Stock"/></default-field></field>
                </form-single>
            </container-dialog>
            </container>
              </widgets>
            </section>
        </container>

        <container-row>
            <row-col lg="4" md="6">
                <container-box>
                    <box-header title="Risk Summary"/>
                    <box-body>
                        <label text="Value of stock expiring (next 90 days)" type="h5" style="text-muted"/>
                        <label text="${currSymbol}${ec.l10n.format(expiryOut.totalExpiryValue ?: 0, '#,##,##0.00')}" type="h2" style="text-danger"/>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="8" md="6">
                <container-box>
                    <box-header title="Action Required"/>
                    <box-body>
                        <!-- ZE-INV-008 (IV-107): live alert banner driven by the tenant's alert threshold/on-off -->
                        <section name="ExpiryAlertActive">
                            <condition><expression>alertEnabled == 'Y' &amp;&amp; alertCount &gt; 0</expression></condition>
                            <widgets>
                                <label text="⚠ ${alertCount} item(s) expiring within ${alertDays} days — ${currSymbol}${ec.l10n.format(alertValue ?: 0, '#,##,##0.00')} at risk. Sell them, run an offer, or return them to the supplier before they go to waste." type="p" style="text-danger text-weight-bold"/>
                                <!-- ZE-INV-010 (IV-110): the "adjust settings" hint only for users who can actually change settings -->
                                <section name="ExpiryAlertHint">
                                    <condition><expression>invCanWrite</expression></condition>
                                    <widgets><label text="Your team is notified in-app when the list of expiring lots changes. Adjust the window with “Alert Settings”." type="span" style="text-caption text-grey-7"/></widgets>
                                </section>
                            </widgets>
                            <fail-widgets>
                                <section name="ExpiryAlertOff">
                                    <condition><expression>alertEnabled != 'Y'</expression></condition>
                                    <widgets>
                                        <label text="Expiry alerts are OFF for your organization. Turn them on in “Alert Settings” to be notified about products nearing expiry." type="p" style="text-grey-7"/>
                                    </widgets>
                                    <fail-widgets>
                                        <label text="Nothing is expiring within your ${alertDays}-day alert window. The list below still shows everything within 90 days so you can plan ahead." type="p" style="text-positive"/>
                                    </fail-widgets>
                                </section>
                            </fail-widgets>
                        </section>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>

        <container-box><box-header title="Products expiring soon"/><box-body>
            <!-- ZE-INV-004 (IV-103): search + filter controls. Submits to filterExpiry (re-render); the actions
                 narrow the list by searchText (product / stock id / batch) and withinDays (remaining-days). -->
            <form-single name="ExpiryFilterForm" transition="filterExpiry">
                <field name="searchText"><default-field title="Search">
                    <text-line size="28" placeholder="Product, Stock ID, Batch or Supplier…"/>
                </default-field></field>
                <field name="withinDays"><default-field title="Expiring within">
                    <drop-down allow-empty="false" no-current-selected-key="">
                        <option key="" text="Next 90 days (all)"/>
                        <option key="7" text="7 days"/>
                        <option key="30" text="30 days"/>
                        <option key="60" text="60 days"/>
                        <option key="expired" text="Already expired"/>
                    </drop-down>
                </default-field></field>
                <field name="submitButton"><default-field title=""><submit text="Filter" icon="fa fa-filter"/></default-field></field>
                <field name="clearButton"><default-field title=""><link url="." text="Clear" style="q-btn--flat text-grey-8"/></default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="searchText"/><field-ref name="withinDays"/><field-ref name="submitButton"/><field-ref name="clearButton"/>
                    </field-row>
                </field-layout>
            </form-single>

            <!-- ZE-INV-006 (IV-105): export the current (org-scoped, filtered, sorted) list as CSV or PDF. Standalone
                 links (a <link> inside a form-single renders as a submit button, not a downloadable anchor). -->
            <container style="row justify-end q-gutter-sm q-mb-sm">
                <link url="/apps/zenith/Inventory/ExpiryDashboard/exportCsv?searchText=${java.net.URLEncoder.encode((ec.context.searchText ?: '').toString(), 'UTF-8')}&amp;withinDays=${ec.context.withinDays ?: ''}&amp;orderByField=${ec.context.orderByField ?: ''}"
                      url-type="plain" text="Export CSV" icon="fa fa-download"
                      style="q-btn bg-teal-7 text-white text-weight-bold border-radius-sm q-px-md"/>
                <link url="/apps/zenith/Inventory/ExpiryDashboard/printExpiry?searchText=${java.net.URLEncoder.encode((ec.context.searchText ?: '').toString(), 'UTF-8')}&amp;withinDays=${ec.context.withinDays ?: ''}&amp;orderByField=${ec.context.orderByField ?: ''}"
                      url-type="plain" text="Export PDF" icon="fa fa-file-pdf-o" target-window="_blank"
                      style="q-btn bg-red-7 text-white text-weight-bold border-radius-sm q-px-md"/>
            </container>

            <form-list name="ExpiringAssetsForm" list="expiryOut.expiringAssets" skip-form="true">
                <row-actions>
                    <script>
                        def nowLong = ec.user.nowTimestamp.getTime()
                        def expLong = expiryDate?.getTime() ?: 0
                        daysToExpiry = expLong > 0 ? (int)((expLong - nowLong) / (1000 * 60 * 60 * 24)) : 999
                        isExpired = daysToExpiry &lt;= 0
                    </script>
                </row-actions>
                <field name="assetId"><header-field title="Stock ID" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="productName"><header-field title="Product Name" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="batchNumber"><header-field title="Batch / Lot" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="supplierName"><header-field title="Supplier" show-order-by="true"/><default-field><label text="${supplierName ?: '—'}" type="span" style="text-dark"/></default-field></field>
                <field name="expiryDate">
                    <header-field title="Expiry Date" show-order-by="true"/>
                    <default-field>
                        <display format="yyyy-MM-dd"/>
                        <label text="${isExpired ? 'EXPIRED' : (daysToExpiry + ' days left')}" type="span" style="${isExpired ? 'text-danger text-weight-bold' : 'text-warning'}"/>
                    </default-field>
                </field>
                <field name="quantity"><header-field title="Quantity" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="value"><header-field title="Value at Risk (${currSymbol})" show-order-by="true"/><default-field>
                    <display format="#,##,##0.00"/>
                    <!-- ZE-INV-002 f/u: flag when a row is valued at retail (MRP) or has no valuation, so the mixed
                         basis is transparent; blank for the normal cost basis. -->
                    <label text="${valueBasis == 'MRP' ? '(at MRP)' : (valueBasis == 'unvalued' ? '(not valued)' : '')}" type="span" style="text-caption text-grey-6"/>
                </default-field></field>
                <!-- ZE-INV-007 (IV-106): per-row Edit — update this lot's expiry / quantity / value / batch. The
                     dialog id interpolates per row; the form name is STATIC so its action resolves to the transition
                     (a per-row ${}-name would leave the action pointing at the screen and the submit would no-op). -->
                <field name="editAction"><header-field title=""/>
                  <!-- ZE-INV-010 (IV-110): row Edit only for full-access users; view-only sees no edit control -->
                  <conditional-field name="editAvail" condition="invCanWrite">
                    <container-dialog id="EditExpiry_${assetId}" button-text="Edit" button-icon="fa fa-pencil"
                                      button-class="q-btn--flat text-primary text-caption q-px-sm">
                        <form-single name="EditExpiryForm" transition="updateExpiryStock">
                            <field name="assetId"><default-field><hidden default-value="${assetId}"/></default-field></field>
                            <field name="lotLabel"><default-field title="Editing"><display text="${productName} — ${assetId}"/></default-field></field>
                            <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date" default-value="${expiryDate ? ec.l10n.format(expiryDate, 'yyyy-MM-dd') : ''}"/></default-field></field>
                            <field name="quantity"><default-field title="Quantity"><text-line size="10" default-value="${quantity}"/></default-field></field>
                            <!-- ZE-INV-007 f/u: a quantity change is logged as an Inventory Adjustment with this reason -->
                            <field name="adjustReason"><default-field title="Reason (if quantity changed)">
                                <drop-down allow-empty="false">
                                    <option key="PhysicalCount" text="Physical count / recount"/>
                                    <option key="Damage" text="Damaged"/>
                                    <option key="Expiry" text="Expired / spoiled"/>
                                    <option key="WriteOff" text="Write-off"/>
                                </drop-down>
                            </default-field></field>
                            <field name="unitValue"><default-field title="Value per Unit (${currSymbol})"><text-line size="10" default-value="${valuationRate}"/></default-field></field>
                            <field name="batchNumber"><default-field title="Batch / Lot (Optional)"><text-line size="20" default-value="${batchNumber == 'N/A' ? '' : batchNumber}"/></default-field></field>
                            <field name="submitButton"><default-field title=""><submit text="Save Changes"/></default-field></field>
                        </form-single>
                    </container-dialog>
                  </conditional-field>
                  <default-field><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
