<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Adjustments" default-menu-index="5">

    <transition name="createAdjustment">
        <service-call name="zenith.inventory.InventoryServices.create#StockAdjustment"/>
        <default-response url="../EditStockAdjustment"><parameter name="stockAdjustmentId" from="stockAdjustmentId"/></default-response>
    </transition>
    <transition name="applyAdjustment">
        <actions>
            <!-- ZE-INV-IV-06A: same cross-tenant guard as the Edit screen — the list's Apply link posts a
                 stockAdjustmentId too, so it is an equally exploitable IDOR vector without this check -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock adjustment."/></if>
            <!-- XF-002 f/u: bare service-call inside <actions> doesn't see the posted params; the IDOR sweep
                 dropped the in-map, so the list's Apply button failed "Field cannot be empty". -->
            <service-call name="zenith.inventory.InventoryServices.apply#StockAdjustment" in-map="[stockAdjustmentId:stockAdjustmentId]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="approveAdjustment">
        <actions>
            <!-- ZE-INV-IV-06A: block approving another tenant's adjustment -->
            <service-call name="zenith.inventory.InventoryServices.assert#StockAdjustmentAccess" in-map="[stockAdjustmentId:stockAdjustmentId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this stock adjustment."/></if>
            <service-call name="update#zenith.erp.inventory.StockAdjustment" in-map="[stockAdjustmentId:stockAdjustmentId, statusId:'AdjApproved']"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.inventory.StockAdjustment" list="adjList">
            <search-form-inputs default-order-by="-adjustmentDate"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/></entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Stock Adjustments"/><box-toolbar>
            <!-- friendly intro shown in body below -->
            <!-- ZE-INV-010: New Adjustment only for full Inventory write access -->
            <section name="NewAdjWrite">
              <condition><expression>invCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewAdjDialog" button-text="New Adjustment">
                <form-single name="NewAdjForm" transition="createAdjustment">
                    <field name="facilityId"><default-field title="Warehouse">
                        <drop-down>
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="adjustmentType"><default-field title="Reason">
                        <drop-down>
                            <option key="PhysicalCount" text="Physical Count (recount the shelf)"/>
                            <option key="Damage" text="Damage/Breakage"/>
                            <option key="Expiry" text="Expiry"/>
                            <option key="WriteOff" text="Write Off"/>
                            <option key="Opening" text="Opening Stock"/>
                        </drop-down>
                    </default-field></field>
                    <field name="adjustmentDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </box-toolbar><box-body>
            <label text="Use this when your real shelf count is different from the system — e.g. after a stock-take, breakage, or expiry. Create one, add the items with their correct counts, then approve to update stock." type="p" style="text-grey-7 q-pa-sm q-mb-sm"/>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Adjustments..." style="display:none"></span>]]></text></render-mode>
            <form-list name="AdjListForm" list="adjList" skip-form="true" header-dialog="true"
                       show-page-size="true">
                <field name="stockAdjustmentId">
                    <default-field title="ID"><link url="../EditStockAdjustment" text="${stockAdjustmentId}" parameter-map="[stockAdjustmentId:stockAdjustmentId]" style="text-indigo-8 text-weight-bold"/></default-field>
                </field>
                <field name="adjustmentDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="facilityId">
                    <header-field title="Warehouse">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="adjustmentType">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="PhysicalCount" text="Physical Count"/>
                            <option key="Damage" text="Damage"/>
                            <option key="Expiry" text="Expiry"/>
                            <option key="WriteOff" text="Write Off"/>
                            <option key="Opening" text="Opening"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="AdjPending" text="Pending (Draft)"/>
                            <option key="AdjApproved" text="Approved"/>
                            <option key="AdjApplied" text="Applied"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="remarks">
                    <default-field><display/></default-field>
                </field>
                <field name="actions">
                    <!-- ZE-INV-010: Approve is a write action; the Open link stays (read/detail nav) -->
                    <conditional-field name="actionsWrite" condition="invCanWrite" title="">
                    <link url="approveAdjustment" text="Approve" parameter-map="[stockAdjustmentId:stockAdjustmentId]"
                          condition="statusId == 'AdjPending'" confirmation="Approve this adjustment?"/>
                    <link url="../EditStockAdjustment" text="Open / add items" parameter-map="[stockAdjustmentId:stockAdjustmentId]" condition="statusId != 'AdjApplied'"/>
                    </conditional-field>
                    <default-field title="">
                    <link url="../EditStockAdjustment" text="Open / add items" parameter-map="[stockAdjustmentId:stockAdjustmentId]" condition="statusId != 'AdjApplied'"/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
