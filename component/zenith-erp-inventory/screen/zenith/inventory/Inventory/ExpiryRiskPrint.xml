<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" standalone="true">

    <!-- ZE-INV-006 (IV-105) f/u: PDF print of the Expiry Risk report. Reuses the shared get#ExpiryRisk service
         (org isolation, value fallback, supplier, search+filter, sort) so the PDF, the CSV and the screen match. -->
    <parameter name="searchText"/>
    <parameter name="withinDays"/>
    <parameter name="categoryFilter"/>
    <parameter name="supplierFilter"/>
    <parameter name="daysBucket"/>
    <parameter name="orderByField"/>
    <parameter name="filename"/>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <service-call name="zenith.inventory.InventoryServices.get#ExpiryRisk" out-map="expiryOut"
            in-map="[organizationPartyId: activeOrgId, searchText: searchText, withinDays: withinDays, orderByField: orderByField,
                     categoryFilter: categoryFilter, supplierFilter: supplierFilter, daysBucket: daysBucket]"/>

        <entity-find-one entity-name="mantle.party.Organization" value-field="org">
            <field-map field-name="partyId" from="activeOrgId"/>
        </entity-find-one>
        <set field="orgName" from="org?.organizationName ?: 'All Organizations'"/>
        <set field="reportDate" from="ec.l10n.format(ec.user.nowTimestamp, 'dd-MMM-yyyy')"/>
        <set field="templateLocation" value="component://zenith-erp-inventory/template/inventory/ExpiryRiskPrint.xsl-fo.ftl"/>
    </actions>

    <widgets>
        <render-mode><text type="xsl-fo" location="${templateLocation}" template="true" encode="false" no-boundary-comment="true"/></render-mode>
    </widgets>
</screen>
