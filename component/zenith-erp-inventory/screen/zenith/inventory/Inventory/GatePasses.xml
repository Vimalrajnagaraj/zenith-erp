<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gate Passes" default-menu-index="4">

    <!-- Keep transitions discoverable to both native form renderers; enforce POST inside actions. -->
    <transition name="createGatePass">
        <actions>
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken">
                <return error="true" message="Submit the gate pass using the secure form."/>
            </if>
            <service-call name="zenith.inventory.GatePassServices.create#GatePass"
                          in-map="[passTypeEnumId:passTypeEnumId, facilityId:facilityId, partyId:partyId, issueDate:issueDate, expectedReturnDate:expectedReturnDate, vehicleNumber:vehicleNumber, transporterName:transporterName, remarks:remarks]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateGatePass">
        <actions>
            <if condition="ec.web.request.method != 'POST' || !ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken">
                <return error="true" message="Submit the gate pass using the secure form."/>
            </if>
            <service-call name="zenith.inventory.GatePassServices.update#GatePass"
                          in-map="[gatePassId:gatePassKey ?: gatePassId, statusId:statusId, vehicleNumber:vehicleNumber]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <always-actions><set field="partyPickerStrictOrg" from="true"/></always-actions>
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="activeOrgId" from="(!activeOrgId || activeOrgId == '_NA_') ? '__NO_ORGANIZATION__' : activeOrgId"/>
        <set field="newGatePassIssueDate" from="ec.l10n.format(ec.user.nowTimestamp,'yyyy-MM-dd HH:mm')"/>
        <entity-find entity-name="zenith.erp.inventory.GatePass" list="gatePassList">
            <search-form-inputs default-order-by="-issueDate,-lastUpdatedStamp,gatePassId"/>
            <econdition field-name="organizationPartyId" from="activeOrgId"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="activeOrgId"/>
            <order-by field-name="facilityName"/></entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt"><![CDATA[<link rel="stylesheet" href="/zenithstatic/css/gate-passes.css?v=12"/>]]></text></render-mode>
        <container id="gatePassesPage" style="gp-page">
        <container style="gp-header">
            <label text="Security Gate Passes" type="h1"/>
            <container style="gp-header-actions">
            <!-- ZE-INV-010 (IV-110): write features only for users with full Inventory access -->
            <section name="GatePassWriteToolbar">
              <condition><expression>invCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewGatePassDialog" button-text="Issue Gate Pass" width="620" button-style="gp-issue-button">
                <form-single name="NewGatePassForm" transition="createGatePass">
                    <field name="passTypeEnumId"><default-field title="Type" required="true">
                        <drop-down>
                            <option key="GptRgp" text="Returnable (RGP)"/>
                            <option key="GptNrgp" text="Non-Returnable (NRGP)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="facilityId"><default-field title="Facility" required="true">
                        <drop-down>
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="partyId"><default-field title="Vendor/Customer">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </default-field></field>
                    <field name="issueDate"><default-field title="Issue Date" required="true"><date-time type="date-time" default-value="${newGatePassIssueDate}"/></default-field></field>
                    <field name="expectedReturnDate"><default-field title="Expected Return"><date-time type="date"/></default-field></field>
                    <field name="vehicleNumber"><default-field title="Vehicle No"><text-line size="20"/></default-field></field>
                    <field name="transporterName"><default-field title="Transporter Name"><text-line size="30"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="2" cols="50"/></default-field></field>

                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        <render-mode><text type="html,qvt"><![CDATA[<button type="button" class="gp-collapse" aria-label="Collapse gate pass list" aria-expanded="true" aria-controls="gatePassCard" onclick="var p=document.getElementById('gatePassCard');p.hidden=!p.hidden;this.setAttribute('aria-expanded',String(!p.hidden));this.setAttribute('aria-label',p.hidden?'Expand gate pass list':'Collapse gate pass list');">⌃</button>]]></text></render-mode>
            </container>
        </container>
        <container id="gatePassCard" style="gp-card">
            <!-- IV-120 (ZE-INV-015): must NOT be skip-form - this list has INLINE-EDIT row fields (status/vehicle
                 drop-downs + per-row Update, added by ZE-INV-010) that reference the form's `formProps` slot scope.
                 skip-form removes the list's form, so once a row rendered the /qapps Vue template threw
                 "formProps is not defined" and the whole screen went blank. A normal form-list provides formProps;
                 native column sorting still works on this entity-value list. -->

            <form-list name="GatePassListForm" list="gatePassList" header-dialog="true" transition="updateGatePass" show-page-size="false">
                <row-actions>
                    <set field="gpPartyName" value=""/>
                    <if condition="partyId">
                        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="gpParty"><field-map field-name="partyId"/></entity-find-one>
                        <if condition="gpParty != null &amp;&amp; gpParty.ownerPartyId == activeOrgId">
                            <set field="gpPartyName" from="ec.resource.expand('PartyNameTemplate','',gpParty)"/>
                        </if>
                    </if>
                </row-actions>
                <field name="gatePassKey"><default-field><hidden default-value="${gatePassId}"/></default-field></field>
                <field name="gatePassId"><header-field title="GP ID"><text-find/></header-field><default-field title="GP ID"><link url="../PrintGatePass" text="${gatePassId}" parameter-map="[gatePassId:gatePassId]"/></default-field></field>
                <field name="passTypeEnumId">
                    <header-field title="Type" show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="GptRgp" text="RGP"/>
                            <option key="GptNrgp" text="NRGP"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${passTypeEnumId == 'GptRgp' ? 'Returnable' : (passTypeEnumId == 'GptNrgp' ? 'Non-Returnable' : 'Unknown type')}" style="gp-badge ${passTypeEnumId == 'GptRgp' ? 'gp-returnable' : (passTypeEnumId == 'GptNrgp' ? 'gp-nonreturnable' : '')}"/></default-field>
                </field>
                <field name="partyId">
                    <default-field title="Party">
                        <display text="${gpPartyName}"/>
                    </default-field>
                </field>
                <field name="issueDate">
                    <header-field title="Issued" show-order-by="true"><date-find type="date"/></header-field>
                    <default-field><display format="dd MMM yyyy HH:mm"/></default-field>
                </field>
                <field name="expectedReturnDate">
                    <header-field title="Expected Return"/>
                    <default-field>
                        <display format="dd MMM yyyy" condition="passTypeEnumId == 'GptRgp'"/>
                    </default-field>
                </field>
                <field name="vehicleNumber">
                    <!-- ZE-INV-010 (IV-110): inline vehicle edit only for full-access users; view-only sees the value -->
                    <conditional-field name="vehicleEdit_write" condition="invCanWrite" title="Vehicle"><text-line size="15" placeholder="Vehicle" maxlength="63"/></conditional-field>
                    <default-field title="Vehicle"><display/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="GpIssued" text="Issued"/>
                            <option key="GpReturned" text="Returned"/>
                            <option key="GpOverdue" text="Overdue"/>
                            <option key="GpClosed" text="Closed"/>
                        </drop-down>
                    </header-field>
                    <!-- ZE-INV-010 (IV-110): inline status edit only for full-access users; view-only sees the value read-only -->
                    <conditional-field name="statusEdit_write" condition="invCanWrite" title="Status ID">
                        <drop-down>
                            <option key="GpIssued" text="Issued"/>
                            <option key="GpReturned" text="Returned"/>
                            <option key="GpOverdue" text="Overdue"/>
                            <option key="GpClosed" text="Closed"/>
                        </drop-down>
                    </conditional-field>
                    <default-field>
                        <display text="${statusId == 'GpIssued' ? 'Issued' : (statusId == 'GpReturned' ? 'Returned' : (statusId == 'GpOverdue' ? 'Overdue' : (statusId == 'GpClosed' ? 'Closed' : statusId)))}"/>
                    </default-field>
                </field>
                <!-- Print Barcode Action -->
                <field name="printAction"><default-field title="">
                    <link url="../PrintGatePass" text="Print" icon="fa fa-print" parameter-map="[gatePassId:gatePassId, lastStandalone:true]" target="_blank" style="gp-print-button"/>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field>
                <!-- ZE-INV-010 (IV-110): row Update only for full-access users; view-only can still Find (search) but not save -->
                <conditional-field name="update_write" condition="invCanWrite"><submit text="Update" style="gp-update-button"/></conditional-field>
                <default-field><label text="" type="span"/></default-field></field>
            </form-list>
        <render-mode><text type="html"><![CDATA[
<#assign page=(gatePassListPageIndex)!0><#assign last=(gatePassListPageMaxIndex)!0>
<#assign count=(gatePassListCount)!0><#assign low=(gatePassListPageRangeLow)!0><#assign high=(gatePassListPageRangeHigh)!0>
<nav class="gp-bottom-pager" aria-label="Gate pass pages">
<#if page gt 0><a href="${sri.getScreenUrlInstance().cloneUrlInstance().addParameter('pageIndex',0).pathWithParams?html}" aria-label="First page">|‹</a><a href="${sri.getScreenUrlInstance().cloneUrlInstance().addParameter('pageIndex',page-1).pathWithParams?html}" aria-label="Previous page">«</a><#else><span aria-disabled="true">|‹</span><span aria-disabled="true">«</span></#if>
<span>${page+1} / ${last+1} (${low}-${high} / ${count})</span>
<#if page lt last><a href="${sri.getScreenUrlInstance().cloneUrlInstance().addParameter('pageIndex',page+1).pathWithParams?html}" aria-label="Next page">»</a><a href="${sri.getScreenUrlInstance().cloneUrlInstance().addParameter('pageIndex',last).pathWithParams?html}" aria-label="Last page">›|</a><#else><span aria-disabled="true">»</span><span aria-disabled="true">›|</span></#if>
</nav>
        ]]></text></render-mode>
        <section name="GatePassEmpty" condition="gatePassList.isEmpty()"><widgets>
            <container style="gp-empty"><label text="No gate passes found" type="h2"/><label text="Try different Find Options or issue a gate pass." type="p"/></container>
        </widgets></section>
        </container>
        <render-mode><text type="html,qvt"><![CDATA[<footer class="gp-footer"><span>© 2024-2026 ZetaERP · Cloud ERP Platform</span><a href="mailto:support@zetaclantech.com">Support</a></footer>]]></text></render-mode>
        </container>
    </widgets>
</screen>
