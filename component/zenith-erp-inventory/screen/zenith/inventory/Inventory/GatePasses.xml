<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gate Passes" default-menu-index="4">

    <transition name="createGatePass">
        <service-call name="create#zenith.erp.inventory.GatePass" in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="."/>
    </transition>
    <transition name="updateGatePass">
        <actions>
            <!-- ZE-INV-IV-06A: block editing another tenant's gate pass via a forged inline-edit POST -->
            <service-call name="zenith.inventory.InventoryServices.assert#GatePassAccess" in-map="[gatePassId:gatePassId]" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this gate pass."/></if>
            <service-call name="update#zenith.erp.inventory.GatePass" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition-include name="searchPartyList" location="component://SimpleScreens/template/party/PartyForms.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.inventory.GatePass" list="gatePassList">
            <search-form-inputs default-order-by="-issueDate"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/></entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Security Gate Passes"/><box-toolbar>
            <!-- ZE-INV-010 (IV-110): write features only for users with full Inventory access -->
            <section name="GatePassWriteToolbar">
              <condition><expression>invCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewGatePassDialog" button-text="Issue Gate Pass">
                <form-single name="NewGatePassForm" transition="createGatePass">
                    <field name="passTypeEnumId"><default-field title="Type">
                        <drop-down>
                            <option key="GptRgp" text="Returnable (RGP)"/>
                            <option key="GptNrgp" text="Non-Returnable (NRGP)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="facilityId"><default-field title="Facility">
                        <drop-down>
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="partyId"><default-field title="Vendor/Customer">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </default-field></field>
                    <field name="issueDate"><default-field title="Issue Date"><date-time type="date-time" default-value="${ec.user.nowTimestamp}"/></default-field></field>
                    <field name="expectedReturnDate"><default-field title="Expected Return"><date-time type="date"/></default-field></field>
                    <field name="vehicleNumber"><default-field title="Vehicle No"><text-line size="20"/></default-field></field>
                    <field name="transporterName"><default-field title="Transporter Name"><text-line size="30"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="statusId"><default-field><hidden default-value="GpIssued"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </box-toolbar><box-body>
            <!-- IV-120 (ZE-INV-015): must NOT be skip-form — this list has INLINE-EDIT row fields (status/vehicle
                 drop-downs + per-row Update, added by ZE-INV-010) that reference the form's `formProps` slot scope.
                 skip-form removes the list's form, so once a row rendered the /qapps Vue template threw
                 "formProps is not defined" and the whole screen went blank. A normal form-list provides formProps;
                 native column sorting still works on this entity-value list. -->
            <form-list name="GatePassListForm" list="gatePassList" header-dialog="true" transition="updateGatePass">
                <field name="gatePassId"><default-field title="GP ID"><display/></default-field></field>
                <field name="passTypeEnumId">
                    <header-field title="Type" show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="GptRgp" text="RGP"/>
                            <option key="GptNrgp" text="NRGP"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${passTypeEnumId == 'GptRgp' ? 'Returnable' : 'Non-Returnable'}"/></default-field>
                </field>
                <field name="partyId">
                    <default-field title="Party">
                        <display-entity entity-name="mantle.party.PartyDetail" text="${organizationName?:firstName} ${lastName?:''}"/>
                    </default-field>
                </field>
                <field name="issueDate">
                    <header-field title="Issued" show-order-by="true"/>
                    <default-field><display format="dd MMM yyyy HH:mm"/></default-field>
                </field>
                <field name="expectedReturnDate">
                    <header-field title="Expected Return"/>
                    <default-field>
                        <display format="dd MMM yyyy" condition="passTypeEnumId == 'GptRgp'"/>
                    </default-field>
                </field>
                <field name="vehicleNumber">
                    <!-- ZE-INV-010 (IV-110): inline vehicle edit only for full-access users; view-only sees the value -->
                    <conditional-field name="vehicleEdit_write" condition="invCanWrite" title="Vehicle"><text-line size="15"/></conditional-field>
                    <default-field title="Vehicle"><display/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="GpIssued" text="Issued"/>
                            <option key="GpReturned" text="Returned"/>
                            <option key="GpOverdue" text="Overdue"/>
                            <option key="GpClosed" text="Closed"/>
                        </drop-down>
                    </header-field>
                    <!-- ZE-INV-010 (IV-110): inline status edit only for full-access users; view-only sees the value read-only -->
                    <conditional-field name="statusEdit_write" condition="invCanWrite">
                        <drop-down>
                            <option key="GpIssued" text="Issued"/>
                            <option key="GpReturned" text="Returned"/>
                            <option key="GpOverdue" text="Overdue"/>
                            <option key="GpClosed" text="Closed"/>
                        </drop-down>
                    </conditional-field>
                    <default-field>
                        <display text="${statusId == 'GpIssued' ? 'Issued' : (statusId == 'GpReturned' ? 'Returned' : (statusId == 'GpOverdue' ? 'Overdue' : (statusId == 'GpClosed' ? 'Closed' : statusId)))}"/>
                    </default-field>
                </field>
                <!-- Print Barcode Action -->
                <field name="printAction"><default-field title="">
                    <container-dialog id="PrintDialog_${gatePassId}" button-text="Print" icon="glyphicon glyphicon-print">
                        <label text="Gate Pass Print Preview" type="h4"/>
                        <label text="GP ID: ${gatePassId}" type="h5"/>
                        <label text="Type: ${passTypeEnumId == 'GptRgp' ? 'Returnable' : 'Non-Returnable'}" type="p"/>
                        <label text="Vehicle: ${vehicleNumber}" type="p"/>
                        <!-- IV-120: removed a dead <image> placeholder (barcode-placeholder.png doesn't exist; the
                             <image> widget errored with "url-type of content is not yet supported" on the plain URL). -->
                    </container-dialog>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field>
                <!-- ZE-INV-010 (IV-110): row Update only for full-access users; view-only can still Find (search) but not save -->
                <conditional-field name="update_write" condition="invCanWrite"><submit text="Update"/></conditional-field>
                <default-field><label text="" type="span"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
