<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New Transfer" default-menu-include="false">

    <!-- stock-creation docs: the "New Stock Transfer" creation form is a full-page screen (breadcrumb + page
         header + a single 2-column form card + Cancel/Create footer) that precedes EditStockTransfer. It used to
         be a container-dialog on the StockTransfers list; promoted to its own page to match the mockup. The create
         path (transition + service + redirect to EditStockTransfer) is byte-identical to the old list dialog. -->

    <transition name="createTransfer">
        <actions>
            <!-- defense-in-depth: a page is directly URL-addressable, so gate write access here too. -->
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't create a transfer."/></if>
            <service-call name="zenith.inventory.InventoryServices.create#StockTransfer" in-map="context"/>
        </actions>
        <default-response url="../EditStockTransfer"><parameter name="stockTransferId" from="stockTransferId"/></default-response>
    </transition>
    <transition name="back"><default-response url="../StockTransfers"/></transition>

    <actions>
        <!-- ZE-INV-IV-070: the org is ALWAYS the tenant's own active org (a transfer is within one org). Auto-filled
             (hidden) — no user-facing org picker. Guard '_NA_' (a super-admin with no active org) down to null;
             create#StockTransfer also defaults it server-side. -->
        <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="organizationPartyId == '_NA_'"><set field="organizationPartyId" from="null"/></if>

        <!-- Warehouses for the From/To pickers, org-scoped (explicit ownerPartyId = primary guard; the
             MANTLE_ACTIVE_ORG entity filter is the defense-in-depth backstop). no-org admin sees all. -->
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="facilityName"/>
        </entity-find>
        <!-- Pre-fill the date with today (the mockup shows a filled date). -->
        <set field="transferDate" from="ec.user.nowTimestamp"/>
    </actions>

    <widgets>
        <!-- stock-creation §4: breadcrumb back-link in the brand primary colour (matches EditStockTransfer). -->
        <link url="back" text="← Back to Stock Transfers" link-type="anchor" style="text-primary text-weight-bold text-decoration-none"/>

        <!-- ZE-INV-010: creating a transfer is a write action — view-only users get a plain notice. -->
        <section name="ViewOnly">
            <condition><expression>!invCanWrite</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-lg q-mt-sm text-center">
                    <label text="You have view-only access to Inventory" type="h6" style="text-grey-8 q-mb-xs"/>
                    <label text="Ask an administrator for edit access to create stock transfers. Use “Back to Stock Transfers” above to return." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="CreateForm">
        <condition><expression>invCanWrite</expression></condition>
        <widgets>
            <!-- stock-creation §5: page header — title + subtitle, no action buttons (they live in the card footer). -->
            <container style="q-mt-sm q-mb-md">
                <label text="New Stock Transfer" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Move stock from one store/warehouse to another." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
            </container>

            <!-- stock-creation §6: single full-width form card, 2-column field grid + full-width remarks + footer. -->
            <container style="zenith-card bg-white shadow-2 border-radius-md q-pa-lg q-mb-md">
                <form-single name="NewTransferForm" transition="createTransfer">
                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                    <field name="fromFacilityId"><default-field title="From Warehouse (Sender)">
                        <drop-down><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down>
                    </default-field></field>
                    <field name="toFacilityId"><default-field title="To Warehouse (Receiver)">
                        <drop-down><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down>
                    </default-field></field>
                    <field name="transferDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <!-- E-Way Bill is DERIVED (value &gt; ₹50,000 OR an inter-state route), not a user choice — show a
                         read-only note in the mockup's slot rather than a fake editable select. -->
                    <field name="ewayInfo"><default-field title="E-Way Bill (optional)">
                        <label text="Set automatically from the transfer's value and route." type="span" style="text-grey-6 text-caption"/>
                    </default-field></field>
                    <field name="remarks"><default-field title="Remarks (optional)">
                        <text-area rows="3" cols="60"/>
                    </default-field></field>
                    <field name="cancelBtn"><default-field title="">
                        <link url="back" text="Cancel" link-type="anchor" style="zst-cancel-btn text-weight-bold"/>
                    </default-field></field>
                    <field name="submitButton"><default-field title="">
                        <submit text="Create Transfer" style="bg-primary text-white text-weight-bold border-radius-sm"/>
                    </default-field></field>
                    <field-layout>
                        <field-row><field-ref name="fromFacilityId"/><field-ref name="toFacilityId"/></field-row>
                        <field-row><field-ref name="transferDate"/><field-ref name="ewayInfo"/></field-row>
                        <field-row-big><field-ref name="remarks"/></field-row-big>
                        <field-row><field-ref name="cancelBtn"/><field-ref name="submitButton"/></field-row>
                    </field-layout>
                </form-single>
            </container>
        </widgets>
        </section>
    </widgets>
</screen>
