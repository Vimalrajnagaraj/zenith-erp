<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product Catalog" default-menu-index="1" default-menu-include="false">

    <parameter name="catalogSearch"/>

    <transition name="editProduct"><default-response url="../EditProduct"/></transition>

    <transition name="createProduct" method="post">
        <parameter name="openingStock"/>
        <parameter name="expiryDate"/>
        <actions>
            <script><![CDATA[
                _createOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
                productName = (productName ?: '').toString().trim()
                pseudoId = (pseudoId ?: '').toString().trim()
                _createError = null
                if (!_createOrg || _createOrg == '_NA_') _createError = 'Select an organization before creating a product.'
                else if (!productName) _createError = 'Product Name is required.'
                else if (!(productTypeEnumId in ['PtAsset','PtService','PtDigitalAsset'])) _createError = 'Choose a valid product type.'
                else if (enableBatchTracking && !(enableBatchTracking in ['Y','N'])) _createError = 'Choose Yes or No for batch tracking.'
                else if (isGstExempt && !(isGstExempt in ['Y','N'])) _createError = 'Choose a valid tax-free option.'
                if (!_createError && productCategoryId) {
                    def category = ec.entity.find('mantle.product.category.ProductCategory')
                        .condition('productCategoryId', productCategoryId).disableAuthz().one()
                    if (!category || category.ownerPartyId != _createOrg)
                        _createError = 'Choose a category from your active organization.'
                }
                if (!_createError && pseudoId) {
                    def _clash = ec.entity.find('mantle.product.Product').condition('ownerPartyId',_createOrg).condition('pseudoId',pseudoId).disableAuthz().count()
                    def _barcode = ec.entity.find('zenith.erp.barcode.ProductBarcode').condition('organizationPartyId',_createOrg).condition('barcodeValue',pseudoId).disableAuthz().count()
                    if (_clash || _barcode) _createError = 'This item code or barcode is already used by another product.'
                }
                ['mrpAmount','reorderPoint'].each { key ->
                    def raw = context.get(key)
                    if (raw != null && raw.toString().trim()) {
                        try { def number = new BigDecimal(raw.toString().trim()); if (number.signum()<0) throw new IllegalArgumentException(); context.put(key,number) }
                        catch (Exception ignored) { _createError = (key=='mrpAmount'?'Selling Price / MRP':'Reorder Point')+' must be 0 or a positive number.' }
                    }
                }
            ]]></script>
            <if condition="_createError"><return error="true" message="${_createError}"/></if>
            <!-- ZE-INV-001 f/u: reject a negative selling price at entry (a -10 typo would make stock value
                 negative everywhere). Blank stays allowed; non-numeric falls through to framework coercion. -->
            <script><![CDATA[
                mrpNegative = false
                if (mrpAmount != null && mrpAmount.toString().trim() != '') {
                    try { if ((mrpAmount.toString().trim() as BigDecimal) < 0G) mrpNegative = true } catch (ignored) {}
                }
                // IV-012: parse opening stock once. Only a POSITIVE quantity creates stock; 0/blank => the
                // product is created but NOT inventory-tracked and gets no asset (so it's not listed in Stock
                // Levels — matching the "zero opening stock => not tracked" expectation). A negative is a typo.
                _openQty = null; _openBad = false
                if (openingStock != null && openingStock.toString().trim() != '') {
                    try { _openQty = new BigDecimal(openingStock.toString().trim()) } catch (ignored) { _openBad = true }
                }
            ]]></script>
            <if condition="mrpNegative">
                <return error="true" message="Selling Price / MRP can't be negative — please enter 0 or a positive amount."/>
            </if>
            <!-- IV-019: MRP is mandatory when creating a product from the catalog (a priceless product bills
                 wrong at POS and skews valuation). Blank is rejected; 0 is allowed (free/complimentary items —
                 MARUTHI uses ₹0 products, and IV-018 keeps 0 valid). Create-only, so the existing null-MRP
                 products on test/demo orgs are grandfathered (they can still be edited). -->
            <if condition="mrpAmount == null || mrpAmount.toString().trim() == ''">
                <return error="true" message="Selling Price / MRP is required — please enter an amount (enter 0 for a free item)."/>
            </if>
            <if condition="_openBad || (_openQty != null &amp;&amp; _openQty.signum() &lt; 0)">
                <return error="true" message="Opening Stock must be 0 or a positive number."/>
            </if>
            <if condition="_openQty != null &amp;&amp; _openQty.signum() &gt; 0 &amp;&amp; productTypeEnumId != 'PtAsset'">
                <return error="true" message="Opening Stock is only available for physical products."/>
            </if>
            <service-call name="create#mantle.product.Product" out-map="createOut"
                          in-map="[productName:productName, pseudoId:pseudoId, productTypeEnumId:productTypeEnumId, description:description, hsnCode:(productTypeEnumId=='PtService'?null:hsnSacCode), sacCode:(productTypeEnumId=='PtService'?hsnSacCode:null), gstSlabId:gstSlabId, uqcEnumId:uqcEnumId, isGstExempt:isGstExempt, enableBatchTracking:enableBatchTracking, mrpAmount:mrpAmount, reorderPoint:reorderPoint, ownerPartyId:_createOrg]"/>
            <if condition="productCategoryId">
                <service-call name="zenith.inventory.CatalogueServices.add#CatalogueProduct"
                    in-map="[orgPartyId:_createOrg, productCategoryId:productCategoryId, productId:createOut.productId]"/>
            </if>
            <!-- IV-012: only POSITIVE opening stock creates the asset + marks the product inventory-tracked.
                 0/blank => the product exists but is untracked and absent from Stock Levels (the reported fix). -->
            <if condition="_openQty != null &amp;&amp; _openQty.signum() &gt; 0">
                <set field="_org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <!-- ZE-INV-004: pass the optional expiry date so opening stock is expiry-tracked (appears in
                     Expiry Risk); pass mrpAmount so the lot has a valuation basis (Expiry Risk values by
                     asset valuationRate -> acquireCost -> mrpAmount) instead of showing "(not valued)". -->
                <service-call name="zenith.inventory.InventoryStockServices.adjust#AssetOnHand"
                    in-map="[organizationPartyId:_org, productId:createOut.productId, quantityDiff:_openQty, reason:'Opening stock (new item)', expiryDate:expiryDate, mrpAmount:mrpAmount]"/>
                <service-call name="update#mantle.product.Product" in-map="[productId:createOut.productId, inventoryTracked:'Y']"/>
            </if>
        </actions>
        <!-- On a validation error (e.g. negative MRP) createOut is null, so re-render THIS screen with the
             message rather than the default-response, whose ${createOut.productId} would NPE (500). -->
        <conditional-response url=".">
            <condition><expression>ec.message.hasError()</expression></condition>
        </conditional-response>
        <default-response url="../EditProduct">
            <parameter name="productId" value="${createOut.productId}"/>
        </default-response>
    </transition>

    <actions>
        <script><![CDATA[
            catalogOrgId = ec.user.getPreference('ACTIVE_ORGANIZATION')
            if (!catalogOrgId || catalogOrgId=='_NA_') catalogOrgId = '__NO_ORGANIZATION__'
            def _currency = companyCurrency ?: ec.entity.find('zenith.erp.base.CompanySettings').condition('organizationPartyId',catalogOrgId)
                .condition('settingKey','CURRENCY_UOM_ID').disableAuthz().one()?.settingValue ?: 'INR'
            catalogCurrencySymbol = [INR:'₹',USD:'$',GBP:'£',AED:'AED',EUR:'€',JPY:'¥'][_currency] ?: _currency
            catalogSearch = (catalogSearch ?: '').toString().trim()
            catalogSearchCondition = null
            if (catalogSearch && catalogOrgId!='__NO_ORGANIZATION__') {
                def _cf=ec.entity.conditionFactory; def _EC=org.moqui.entity.EntityCondition
                def _like='%'+catalogSearch.replace('\\','\\\\').replace('%','\\%').replace('_','\\_')+'%'
                def _barcodeIds=ec.entity.find('zenith.erp.barcode.ProductBarcode').condition('organizationPartyId',catalogOrgId)
                    .condition('isActive','Y').condition(_cf.makeCondition('barcodeValue',_EC.LIKE,_like).ignoreCase()).selectField('productId').disableAuthz().list()*.productId
                def _parts=['pseudoId','productName','productId'].collect { _cf.makeCondition(it,_EC.LIKE,_like).ignoreCase() }
                if (_barcodeIds) _parts.add(_cf.makeCondition('productId',_EC.IN,_barcodeIds))
                catalogSearchCondition=_cf.makeCondition(_parts,_EC.OR)
            }
            catalogInputs = new HashMap(context)
            catalogFilterCondition = null
            def _badFilter = false
            [mrpAmount:'MRP',totalQoh:'In Stock',reorderPoint:'Reorder Point',gstRate:'GST',totalAtp:'Available Stock'].each { field, title ->
                ['', '_from', '_thru'].each { suffix ->
                    def key=field+suffix; def raw=catalogInputs[key]
                    if (raw!=null && raw.toString().trim()) {
                        // Keep a string: the framework treats a BigDecimal zero as an absent search value.
                        try { catalogInputs[key]=new BigDecimal(raw.toString().trim()).toPlainString() }
                        catch (Exception ignored) { catalogInputs.remove(key); _badFilter=true; ec.message.addError(title+' must contain valid numbers.') }
                    } else catalogInputs.remove(key)
                }
                if (catalogInputs[field+'_from']!=null && catalogInputs[field+'_thru']!=null && (catalogInputs[field+'_from'] as BigDecimal)>(catalogInputs[field+'_thru'] as BigDecimal)) {
                    _badFilter=true; ec.message.addError(title+' From must be less than or equal to Thru.')
                }
            }
            if (_badFilter) catalogFilterCondition=ec.entity.conditionFactory.makeCondition('productId',org.moqui.entity.EntityCondition.EQUALS,null)
            def _sorts=['pseudoId','productName','productId','description','catalogTaxCode','gstRate','uqcEnumId','isGstExempt','mrpAmount','totalQoh','reorderPoint','enableBatchTracking','productTypeEnumId'] as Set
            if (orderByField) {
                def _requestedSorts=(orderByField instanceof Collection ? orderByField : orderByField.toString().split(',').toList()).collect { it.toString().trim() }
                if (_requestedSorts.every { _sorts.contains(it.replaceFirst('^-','')) }) {
                    if (!_requestedSorts.any { it.replaceFirst('^-','')=='productId' }) _requestedSorts.add('productId')
                    catalogInputs.orderByField=_requestedSorts.join(',')
                } else catalogInputs.orderByField='productName,pseudoId,productId'
            }
            ['pageIndex':0,'pageSize':20].each { key, fallback ->
                try { def raw=ec.web?.parameters?.get(key); def number=raw ? Integer.parseInt(raw.toString()) : fallback
                    catalogInputs[key]=(key=='pageSize' ? (number>0 && number<=200 ? number : fallback) : Math.max(0,number)) }
                catch (Exception ignored) { catalogInputs[key]=fallback }
            }
            if (ec.web?.parameters?.renderMode=='csv') { catalogInputs.pageIndex=null; catalogInputs.pageSize=null; catalogInputs.pageNoLimit=true }
        ]]></script>
        <entity-find entity-name="mantle.product.category.ProductCategory" list="productCategoryList">
            <econdition field-name="ownerPartyId" from="catalogOrgId"/>
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container id="productCatalog" style="product-catalog">
        <section name="CatalogInteractive" condition="ec.web?.parameters?.renderMode != 'csv'"><widgets>
        <!-- ZE-INV-UIv2: page header per the v2 mockup — plain near-black title + grey subtitle +
             violet New Product CTA on the right (was a dark indigo banner). -->
        <container style="zc-page-head">
            <container style="zc-page-head__titles">
                <label text="Product Catalog" type="h4" style="prod-title text-weight-bolder q-my-none"/>
                <label text="Your full product list. Search for an item, add a new one, and see how many you have in stock." type="p" style="text-grey-7 q-mt-xs q-mb-none"/>
            </container>
            <container style="zc-page-head__actions">

            <section name="FindProductNewBtn"><condition><expression>invCanWrite</expression></condition><widgets>
            <container-dialog id="CreateProductDialog" button-text="New Product">
                <form-single name="CreateProductForm" transition="createProduct">
                    <field name="pseudoId"><default-field title="Item Code / Barcode"><text-line size="20"/>
                        <label text="Your own code or the barcode for this item. Used to find it fast." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <field name="productName"><default-field title="Product Name"><text-line size="60"/></default-field></field>
                    <field name="productCategoryId"><default-field title="POS Category (optional)">
                        <drop-down allow-empty="true">
                            <list-options list="productCategoryList" key="${productCategoryId}" text="${categoryName}"/>
                        </drop-down>
                        <label text="Physical products appear under this category's POS tab. Manage categories in Inventory → Catalogues." style="text-grey-6 text-caption" type="p"/>
                    </default-field></field>
                    <!-- ZE-INV-IV-013: allow entering the description at create time (was edit-only). -->
                    <field name="description"><default-field title="Description (optional)"><text-area rows="2" cols="58"/>
                        <label text="A short note about this item — shown in the Product Catalog." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <field name="productTypeEnumId">
                        <default-field title="Type">
                            <drop-down>
                                <option key="PtAsset" text="Physical product (something you stock &amp; count)"/>
                                <option key="PtService" text="Service (no stock, e.g. repair, delivery)"/>
                                <option key="PtDigitalAsset" text="Digital product (download / online)"/>
                            </drop-down>
                        </default-field>
                    </field>

                    <!-- Indian GST Compliance Fields -->
                    <field name="hsnSacCode"><default-field title="Tax Code (HSN / SAC)"><text-line size="10"/>
                        <label text="The government tax code for this item. Ask your accountant if unsure — you can leave it blank for now." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <field name="uqcEnumId">
                        <default-field title="Unit (how you sell it)">
                            <drop-down allow-empty="true">
                                <option key="NOS" text="NOS - Numbers"/>
                                <option key="KGS" text="KGS - Kilograms"/>
                                <option key="MTR" text="MTR - Meters"/>
                                <option key="PCS" text="PCS - Pieces"/>
                                <option key="LTR" text="LTR - Liters"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="gstSlabId">
                        <default-field title="GST Tax Rate">
                            <drop-down allow-empty="true">
                                <entity-options key="${gstSlabId}" text="${slabName} (${gstRate}%)">
                                    <entity-find entity-name="zenith.erp.india.IndiaGstSlab"/>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="isGstExempt">
                        <default-field title="Tax-free item?">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No (Taxable)"/>
                                <option key="Y" text="Yes (Nil-Rated/Exempt)"/>
                            </drop-down>
                        </default-field>
                    </field>

                    <field name="enableBatchTracking"><default-field title="Enable Batch Tracking">
                        <drop-down no-current-selected-key="N"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="mrpAmount"><default-field title="Selling Price / MRP (₹) *"><text-line size="10"/>
                        <label text="Required. The price shown and charged at the POS — enter 0 for a free item. You can change it anytime on the product page." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <field name="openingStock"><default-field title="Opening Stock (qty)"><text-line size="10"/>
                        <label text="Enter current quantity in hand to start tracking stock for this item. Leave blank to not track." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <!-- ZE-INV-004: reorder point drives the Dashboard "low on stock" count (flags the item when qty falls to/below it). -->
                    <field name="reorderPoint"><default-field title="Reorder Point (low-stock alert)"><text-line size="10"/>
                        <label text="Flag this item as low on stock when its quantity falls to this level or below. Leave blank for no alert." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <!-- ZE-INV-004: optional expiry so the opening stock shows in the Expiry Risk dashboard. -->
                    <field name="expiryDate"><default-field title="Expiry Date (optional)"><date-time type="date"/>
                        <label text="If this batch expires, set the date and it will appear in Expiry Risk. Leave blank if it doesn't expire." style="text-grey-6 text-caption" type="p"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Product"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
            </container>
        </container>

        <!-- ZE-INV-UIv2: FAST SCAN bar per the v2 mockup — white card with a violet border
             (was bg-indigo-1); same form, same behavior. -->
        <container style="prod-fastscan">
            <label text="FAST SCAN" type="strong" style="prod-fastscan-label"/>
            <container style="col-grow">
                <form-single name="BarcodeScannerForm" transition="." focus-field="catalogSearch">
                    <field-layout>
                        <field-row>
                            <field-ref name="catalogSearch"/>
                            <field-ref name="submitButton"/>
                        </field-row>
                    </field-layout>
                    <field name="catalogSearch">
                        <default-field title="">
                            <text-line size="40" placeholder="Search by item code, product name, barcode..."/>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Search"><submit/></default-field></field>
                </form-single>

            </container>
        </container>



        </widgets></section>
        <container style="catalog-list">
            <form-list name="FindProductList" list="productList" skip-form="true" header-dialog="true" show-csv-button="true">
                <entity-find entity-name="zenith.erp.inventory.ProductCatalogStockView" list="productList">
                    <search-form-inputs skip-fields="ownerPartyId" input-fields-map="catalogInputs" default-order-by="productName,pseudoId,productId"/>
                    <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
                    <econdition field-name="ownerPartyId" from="catalogOrgId"/>
                    <econdition-object field="catalogSearchCondition"/>
                    <econdition-object field="catalogFilterCondition"/>
                </entity-find>

                <field name="productId"><default-field><hidden/></default-field></field>
                <field name="catalogSearch"><header-field><hidden/></header-field><default-field><hidden/></default-field></field>

                <field name="pseudoId">
                    <header-field title="Item Code" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${pseudoId ?: productId}"/>
                    </conditional-field>
                    <default-field>
                        <!-- ZE-INV-UIv2: link-type="anchor" (was a Bootstrap btn-primary pill whose text-indigo-8
                             remap made it violet-on-violet = invisible since the rebrand); plain violet code link
                             per the mockup. -->
                        <link url="editProduct" text="${pseudoId ?: productId}" parameter-map="[productId:productId]" link-type="anchor" style="prod-code"/>
                    </default-field>
                </field>

                <field name="productName">
                    <header-field title="Product Name" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${productName}"/>
                    </conditional-field>
                    <default-field><label text="${productName}" type="span"/></default-field>
                </field>

                <field name="description">
                    <!-- ZE-INV-IV-013: was <ignored/> on screen (CSV-only) so the saved description never showed
                         in the catalog even though it's stored on the product. Display it on screen too. -->
                    <header-field title="Description" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${description ?: ''}"/>
                    </conditional-field>
                    <default-field><label text="${description ?: '-'}" type="span" style="text-grey-8"/></default-field>
                </field>

                <field name="catalogTaxCode">
                    <header-field title="Tax Code" show-order-by="true"><text-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${catalogTaxCode ?: ''}"/>
                    </conditional-field>
                    <!-- products-list §7: Tax Code is plain secondary text (not a badge — the mockup reserves the
                         only row badge for Batch Tracking). -->
                    <default-field><label text="${catalogTaxCode ?: '-'}" type="span" style="text-grey-7"/></default-field>
                </field>

                <field name="gstRate">
                    <!-- ZE-INV-IV-013 f/u: show the friendly GST rate (from the joined slab) instead of the raw
                         slab id, matching how EditProduct shows it ("slabName (gstRate%)"). -->
                    <header-field title="GST" show-order-by="true"/>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${gstRate != null ? ec.l10n.format(gstRate,'#0.##') + '%' : ''}"/>
                    </conditional-field>
                    <!-- products-list §7: GST % is plain secondary text (not a badge). -->
                    <default-field><label text="${gstRate != null ? ec.l10n.format(gstRate,'#0.##') + '%' : '-'}" type="span" style="text-grey-7"/></default-field>
                </field>

                <field name="uqcEnumId">
                    <header-field title="UQC">
                        <drop-down allow-empty="true">
                            <option key="NOS" text="NOS"/><option key="KGS" text="KGS"/><option key="MTR" text="MTR"/><option key="PCS" text="PCS"/><option key="LTR" text="LTR"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${uqcEnumId ?: '-'}"/></default-field>
                </field>

                <field name="isGstExempt">
                    <header-field title="Tax-free" show-order-by="true">
                        <drop-down allow-empty="true"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${isGstExempt == 'Y' ? 'Yes' : 'No'}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${isGstExempt == 'Y' ? 'Exempt' : '-'}" type="span" style="${isGstExempt == 'Y' ? 'text-success text-weight-bold' : 'text-grey'}"/>
                    </default-field>
                </field>

                <field name="mrpAmount">
                    <header-field title="MRP (${catalogCurrencySymbol})" show-order-by="true"><range-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${mrpAmount != null ? mrpAmount : ''}"/>
                    </conditional-field>
                    <default-field><label text="${mrpAmount != null ? zinr.inr(ec.l10n.format(mrpAmount, '#,##0.00')) : '-'}" type="span"/></default-field>
                </field>

                <field name="totalQoh">
                    <header-field title="In Stock" show-order-by="true"><range-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${totalQoh ?: 0}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${totalQoh ?: 0}" type="span" style="text-weight-bold ${((totalQoh ?: 0) &lt;= 0) ? 'text-danger' : 'text-success'}"/>
                    </default-field>
                </field>

                <!-- Read-only stock settings; colors follow the supplied catalog reference. -->
                <field name="reorderPoint">
                    <header-field title="Reorder Point" show-order-by="true"><range-find/></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${reorderPoint ?: 0}"/>
                    </conditional-field>
                    <default-field><label text="${reorderPoint != null ? reorderPoint : '-'}" type="span" style="text-grey-7"/></default-field>
                </field>

                <field name="enableBatchTracking">
                    <header-field title="Enable Batch Tracking"><drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${enableBatchTracking == 'Y' ? 'Yes' : 'No'}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${enableBatchTracking == 'Y' ? 'Yes' : 'No'}" type="span" style="sup-badge ${enableBatchTracking == 'Y' ? 'sup-b-green' : 'sup-b-red'}"/>
                    </default-field>
                </field>

                <!-- ZE-INV-0XX: the Type column only distinguished PtService; EVERY other type (incl.
                     PtDigitalAsset, PtVirtual, PtPickAssembly) fell through to "Physical" — so a Digital
                     product was mislabeled "Physical" in the catalog, disagreeing with Edit Product (which
                     offers Physical/Service/Digital). Map all real types; the filter offers Digital too.
                     Display-only — the saved product_type_enum_id is unchanged. -->
                <field name="productTypeEnumId">
                    <header-field title="Type" show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="PtAsset" text="Physical"/><option key="PtService" text="Service"/><option key="PtDigitalAsset" text="Digital"/>
                            <option key="PtVirtual" text="Virtual"/><option key="PtPickAssembly" text="Kit / Assembly"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="ec.web.parameters.renderMode == 'csv'">
                        <display text="${productTypeEnumId == 'PtService' ? 'Service' : (productTypeEnumId == 'PtDigitalAsset' ? 'Digital' : (productTypeEnumId == 'PtVirtual' ? 'Virtual' : (productTypeEnumId == 'PtPickAssembly' ? 'Kit / Assembly' : 'Physical')))}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${productTypeEnumId == 'PtService' ? 'Service' : (productTypeEnumId == 'PtDigitalAsset' ? 'Digital' : (productTypeEnumId == 'PtVirtual' ? 'Virtual' : (productTypeEnumId == 'PtPickAssembly' ? 'Kit / Assembly' : 'Physical')))}" type="span" style="text-grey-7"/>
                    </default-field>
                </field>

                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
