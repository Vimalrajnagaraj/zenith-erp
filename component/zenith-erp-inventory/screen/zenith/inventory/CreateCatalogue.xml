<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Catalogues" default-menu-index="2">

    <!-- Create & manage product catalogues (categories) = the filter tabs on the POS billing grid.
         Org scoping:
           * A tenant user (real ACTIVE_ORGANIZATION) is locked to their own org — everything they
             create/see/manage is their org's, they can never pick another tenant.
           * A platform admin (ec.user.isInGroup('ADMIN')) with no real active org — getPreference
             returns the literal '_NA_' / null — gets an ORGANIZATION PICKER and creates catalogues
             on behalf of the chosen tenant, so the catalogue actually appears on that tenant's grid. -->

    <parameter name="productCategoryId"/>
    <parameter name="orgPartyId"/>

    <!-- Admin org picker just reloads the screen scoped to the chosen org -->
    <transition name="selectOrg">
        <default-response url=".">
            <parameter name="orgPartyId"/>
        </default-response>
    </transition>

    <transition name="createCategory">
        <actions>
            <set field="_a" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="realOrg" from="(_a &amp;&amp; _a != '_NA_') ? _a : null"/>
            <set field="ownOrg" from="realOrg ?: ((orgPartyId &amp;&amp; orgPartyId != '_NA_') ? orgPartyId : null)"/>
            <if condition="!ownOrg"><return error="true" message="Choose an organization first."/></if>
            <set field="categoryName" from="categoryName?.toString()?.trim()"/>
            <if condition="!categoryName"><return error="true" message="Please enter a catalogue name."/></if>
            <service-call name="create#mantle.product.category.ProductCategory" out-map="catOut"
                in-map="[categoryName:categoryName, description:description, ownerPartyId:ownOrg]"/>
            <script>ec.message.addMessage("Catalogue \"${categoryName}\" created. Now add products to it.", "success")</script>
        </actions>
        <default-response url=".">
            <parameter name="productCategoryId" value="${catOut.productCategoryId}"/>
            <parameter name="orgPartyId" value="${ownOrg ?: ''}"/>
        </default-response>
    </transition>

    <transition name="addProduct">
        <actions>
            <set field="_a" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="realOrg" from="(_a &amp;&amp; _a != '_NA_') ? _a : null"/>
            <if condition="!productCategoryId || !productId"><return error="true" message="Pick a product to add."/></if>
            <!-- A tenant user may only touch a catalogue that belongs to their own org -->
            <entity-find-one entity-name="mantle.product.category.ProductCategory" value-field="_cat"/>
            <if condition="realOrg &amp;&amp; (_cat == null || _cat.ownerPartyId != realOrg)">
                <return error="true" message="That catalogue isn't in your organization."/></if>
            <entity-find entity-name="mantle.product.category.ProductCategoryMember" list="_dups">
                <econdition field-name="productCategoryId"/>
                <econdition field-name="productId"/>
                <date-filter/>
            </entity-find>
            <if condition="_dups">
                <script>ec.message.addMessage("That product is already in this catalogue.", "warning")</script>
            <else>
                <service-call name="create#mantle.product.category.ProductCategoryMember"
                    in-map="[productCategoryId:productCategoryId, productId:productId, fromDate:ec.user.nowTimestamp]"/>
                <script>ec.message.addMessage("Product added to the catalogue.", "success")</script>
            </else>
            </if>
        </actions>
        <default-response url=".">
            <parameter name="productCategoryId" value="${productCategoryId}"/>
            <parameter name="orgPartyId" value="${orgPartyId ?: ''}"/>
        </default-response>
    </transition>

    <transition name="removeProduct">
        <actions>
            <set field="_a" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="realOrg" from="(_a &amp;&amp; _a != '_NA_') ? _a : null"/>
            <entity-find-one entity-name="mantle.product.category.ProductCategory" value-field="_cat"/>
            <if condition="realOrg &amp;&amp; (_cat == null || _cat.ownerPartyId != realOrg)">
                <return error="true" message="That catalogue isn't in your organization."/></if>
            <entity-find entity-name="mantle.product.category.ProductCategoryMember" list="_ms">
                <econdition field-name="productCategoryId"/>
                <econdition field-name="productId"/>
                <date-filter/>
            </entity-find>
            <script>for (m in _ms) { m.delete() }</script>
            <script>ec.message.addMessage("Product removed from the catalogue.", "success")</script>
        </actions>
        <default-response url=".">
            <parameter name="productCategoryId" value="${productCategoryId}"/>
            <parameter name="orgPartyId" value="${orgPartyId ?: ''}"/>
        </default-response>
    </transition>

    <actions>
        <!-- Own-org picker options (org-isolation-safe, via disableAuthz): populates orgList. -->
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <script><![CDATA[
            def _activeOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
            if (_activeOrg == '_NA_') _activeOrg = null
            realOrg = _activeOrg ?: null
            isAdmin = ec.user.isInGroup('ADMIN')
            // The org this screen operates on. A tenant user is hard-locked to their own org; only an
            // admin with no real active org gets to use the picked orgPartyId.
            selOrg = realOrg ?: (isAdmin && orgPartyId && orgPartyId != '_NA_' ? orgPartyId : null)
            showOrgPicker = (realOrg == null) && isAdmin
            selOrgName = null
            if (selOrg) {
                def o = ec.entity.find("mantle.party.Organization").condition("partyId", selOrg).one()
                selOrgName = o?.organizationName ?: selOrg
            }
        ]]></script>

        <!-- Catalogues for the selected org, with a live item count -->
        <set field="catalogueRows" from="[]"/>
        <if condition="selOrg">
            <entity-find entity-name="mantle.product.category.ProductCategory" list="cats">
                <econdition field-name="ownerPartyId" from="selOrg"/>
                <order-by field-name="categoryName"/>
            </entity-find>
            <script><![CDATA[
                catalogueRows = []
                for (c in cats) {
                    def cnt = ec.entity.find("mantle.product.category.ProductCategoryMember")
                        .condition("productCategoryId", c.productCategoryId)
                        .conditionDate("fromDate", "thruDate", ec.user.nowTimestamp).count()
                    catalogueRows.add([productCategoryId: c.productCategoryId,
                        categoryName: c.categoryName ?: c.productCategoryId,
                        description: c.description ?: '', itemCount: cnt, orgPartyId: selOrg])
                }
            ]]></script>
        </if>

        <!-- Selected catalogue: load it + its current products (with an org-ownership guard) -->
        <if condition="productCategoryId">
            <entity-find-one entity-name="mantle.product.category.ProductCategory" value-field="selCat"/>
            <if condition="selCat &amp;&amp; selOrg &amp;&amp; selCat.ownerPartyId == selOrg">
                <entity-find entity-name="mantle.product.category.ProductCategoryMember" list="memberRows">
                    <econdition field-name="productCategoryId"/>
                    <date-filter/>
                    <order-by field-name="sequenceNum,productId"/>
                </entity-find>
                <script><![CDATA[
                    memberView = []
                    for (m in memberRows) {
                        def p = ec.entity.find("mantle.product.Product").condition("productId", m.productId).one()
                        memberView.add([productCategoryId: m.productCategoryId, productId: m.productId, orgPartyId: selOrg,
                            productName: (p?.productName ?: m.productId), pseudoId: (p?.pseudoId ?: '')])
                    }
                ]]></script>
            <else>
                <!-- not this org's catalogue: ignore -->
                <set field="selCat" from="null"/>
            </else>
            </if>
        </if>
    </actions>

    <widgets>
        <render-mode><text type="html"><![CDATA[
            <style>
                .zenith-card { border-radius: 12px; border: 1px solid #e2e8f0; }
                .q-field__control { min-height: 40px !important; }
                .q-field__native, .q-field__input { padding-top: 12px !important; }
                .q-field__label { top: 12px !important; }
            </style>
        ]]></text></render-mode>

        <!-- Header -->
        <container style="row items-center justify-between q-mb-lg bg-indigo-9 text-white q-pa-lg shadow-4 rounded-borders">
            <container>
                <label text="Catalogues" type="h4" style="text-white text-weight-bolder q-my-none"/>
                <label text="Group products into catalogues (categories). These become the filter tabs on the POS billing screen." type="p" style="text-indigo-2 q-mt-sm q-mb-none text-subtitle1"/>
                <section name="hdrOrgName" condition="selOrg">
                    <widgets>
                        <label text="Managing catalogues for: ${selOrgName}" type="p" style="text-white text-weight-bold q-mt-sm q-mb-none"/>
                    </widgets>
                </section>
            </container>
            <section name="newCatBtn" condition="selOrg">
                <widgets>
                    <section name="newCatWrite"><condition><expression>invCanWrite</expression></condition><widgets>
                    <container-dialog id="NewCatalogueDialog" button-text="New Catalogue">
                        <form-single name="NewCatalogueForm" transition="createCategory">
                            <field name="orgPartyId"><default-field><hidden/></default-field></field>
                            <field name="categoryName"><default-field title="Catalogue Name"><text-line size="40"/>
                                <label text="Shown as a filter tab on the POS grid, e.g. ‘Beverages’, ‘Snacks’." style="text-grey-6 text-caption" type="p"/></default-field></field>
                            <field name="description"><default-field title="Description (optional)"><text-line size="60"/></default-field></field>
                            <field name="submitButton"><default-field title="Create Catalogue"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </widgets>
            </section>
        </container>

        <!-- Admin organization picker (only when there is no real active org) -->
        <section name="orgPickerSec" condition="showOrgPicker">
            <widgets>
                <container style="zenith-card bg-amber-1 shadow-2 q-pa-md q-mb-lg">
                    <label text="${selOrg ? 'Switch organization' : 'Choose an organization'}" type="h6" style="text-orange-9 q-mb-sm"/>
                    <label text="You are a platform admin with no fixed organization. Pick the tenant whose catalogues you want to create or manage." type="p" style="text-grey-8 q-mb-sm"/>
                    <form-single name="OrgPickerForm" transition="selectOrg">
                        <field name="orgPartyId">
                            <default-field title="Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="orgList" key="${partyId}" text="${organizationName} [${partyId}]"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submitButton"><default-field title="Open"><submit/></default-field></field>
                    </form-single>
                </container>
            </widgets>
        </section>

        <!-- Prompt when an admin hasn't picked an org yet -->
        <section name="needOrgSec" condition="showOrgPicker &amp;&amp; !selOrg">
            <widgets>
                <label text="Select an organization above to see and create its catalogues." type="p" style="text-grey-6 q-pa-md"/>
            </widgets>
        </section>

        <!-- Main: list + manage (only once an org context exists) -->
        <section name="mainSec" condition="selOrg">
            <widgets>
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-lg">
                    <label text="Your Catalogues" type="h6" style="text-indigo-9 q-mb-sm"/>
                    <form-list name="CatalogueList" list="catalogueRows" skip-form="true">
                        <field name="categoryName">
                            <header-field title="Catalogue"/>
                            <default-field>
                                <link url="." text="${categoryName}" parameter-map="[productCategoryId:productCategoryId, orgPartyId:orgPartyId]"
                                      style="text-weight-bold text-indigo-8 text-decoration-none"/>
                            </default-field>
                        </field>
                        <field name="description"><header-field title="Description"/>
                            <default-field><label text="${description}" type="span" style="text-grey-7"/></default-field></field>
                        <field name="itemCount"><header-field title="Products"/>
                            <default-field><label text="${itemCount}" type="span" style="text-weight-bold"/></default-field></field>
                        <field name="manageBtn">
                            <default-field title="">
                                <link url="." text="Manage products" parameter-map="[productCategoryId:productCategoryId, orgPartyId:orgPartyId]"
                                      btn-type="primary" style="q-btn--dense"/>
                            </default-field>
                        </field>
                    </form-list>
                    <section name="noCats" condition="!catalogueRows">
                        <widgets>
                            <label text="No catalogues yet — click ‘New Catalogue’ above to create your first one." type="p" style="text-grey-6 q-pa-md"/>
                        </widgets>
                    </section>
                </container>

                <section name="manageCat" condition="productCategoryId &amp;&amp; selCat">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 q-pa-md">
                            <label text="Products in: ${selCat.categoryName ?: selCat.productCategoryId}" type="h6" style="text-indigo-9 q-mb-sm"/>
                            <section name="addProductWrite"><condition><expression>invCanWrite</expression></condition><widgets>
                            <form-single name="AddProductForm" transition="addProduct">
                                <field name="productCategoryId"><default-field><hidden/></default-field></field>
                                <field name="orgPartyId"><default-field><hidden/></default-field></field>
                                <field name="productId">
                                    <default-field title="Add a product">
                                        <drop-down>
                                            <entity-options key="${productId}" text="${productName}">
                                                <entity-find entity-name="mantle.product.Product">
                                                    <econdition field-name="ownerPartyId" from="selOrg"/>
                                                    <econdition field-name="productTypeEnumId" value="PtAsset"/>
                                                    <order-by field-name="productName"/>
                                                </entity-find>
                                            </entity-options>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="submitButton"><default-field title="Add to catalogue"><submit/></default-field></field>
                            </form-single>
                            </widgets></section>

                            <form-list name="MemberList" list="memberView" skip-form="true">
                                <field name="productName"><header-field title="Product"/>
                                    <default-field><label text="${productName}" type="strong" style="text-dark"/></default-field></field>
                                <field name="pseudoId"><header-field title="Code"/>
                                    <default-field><label text="${pseudoId ?: '-'}" type="span" style="text-grey-7"/></default-field></field>
                                <field name="removeBtn">
                                    <conditional-field name="remove_write" condition="invCanWrite" title="">
                                        <link url="removeProduct" text="Remove"
                                              parameter-map="[productCategoryId:productCategoryId, productId:productId, orgPartyId:orgPartyId]"
                                              btn-type="danger" style="q-btn--dense"
                                              confirmation="Remove this product from the catalogue?"/>
                                    </conditional-field>
                                    <default-field><label text="" type="span"/></default-field>
                                </field>
                            </form-list>
                            <section name="noMembers" condition="!memberView">
                                <widgets>
                                    <label text="No products in this catalogue yet — use the dropdown above to add some." type="p" style="text-grey-6 q-pa-sm"/>
                                </widgets>
                            </section>
                        </container>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
