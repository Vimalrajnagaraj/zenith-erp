<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product Details" default-menu-include="false">

    <parameter name="productId" required="true"/>

    <transition name="findProduct"><default-response url="../FindProduct"/></transition>
    
    <transition name="updateProduct">
        <service-call name="update#mantle.product.Product"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.product.Product" value-field="product"/>
        
        <entity-find entity-name="zenith.erp.inventory.StockByFacilityView" list="stockList">
            <econdition field-name="productId"/>
        </entity-find>
        
        <set field="totalQoh" from="0"/>
        <script>
            for (def stock : stockList) {
                totalQoh += (stock.totalQoh ?: 0)
            }
        </script>
    </actions>

    <widgets>
        <!-- Quasar input-sizing fix. /qapps strips both literal <style> AND inline <script> tags from
             screen content, but inline event attributes survive, so inject the CSS from an <img onload>. -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="display:none" onload="if(!document.getElementById('zEpInputFix')){var s=document.createElement('style');s.id='zEpInputFix';s.textContent='.q-field__control{min-height:40px !important}.q-field__native,.q-field__input{padding-top:12px !important}.q-field__label{top:12px !important}';document.head.appendChild(s);}"/>
        ]]></text></render-mode>
        <link url="findProduct" text="Back to Catalog" link-type="anchor"/>
        
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white rounded-borders bg-teal-8 q-pa-md flex flex-center">
                        <label text="PRD" type="span" style="text-weight-bold text-h6"/>
                    </container>
                    <container style="column">
                        <label text="${product?.productName} [${product?.pseudoId ?: productId}]" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="${product?.productTypeEnumId == 'PtService' ? 'Service' : 'Physical Asset'}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="column items-end text-right">
                    <label text="Total In Stock" type="span" style="text-grey-7"/>
                    <label text="${totalQoh}" type="strong" style="text-h4 text-dark"/>
                </container>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <!-- Core Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Basic Information" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="ProductBasicForm" transition="updateProduct" map="product">
                        <field name="productId"><default-field><hidden/></default-field></field>
                        
                        <field name="pseudoId"><default-field title="Item Code / Barcode"><text-line size="30"/>
                            <label text="The product's barcode or short code. Type it here, or click the box and scan the barcode with a scanner gun. At billing, scanning (or typing) this code instantly adds this product to the cart — so any item you want to scan needs a code here." style="text-grey-6 text-caption" type="p"/></default-field></field>
                        <field name="productName"><default-field title="Product Name"><text-line size="60"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3"/></default-field></field>
                        
                        <field name="productTypeEnumId">
                            <default-field title="Product Type">
                                <drop-down>
                                    <option key="PtAsset" text="Physical product (something you stock &amp; count)"/>
                                    <option key="PtService" text="Service (no stock, e.g. repair, delivery)"/>
                                    <option key="PtDigitalAsset" text="Digital product (download / online)"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="submitButton"><default-field title="Save Basic Info"><submit/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Indian Statutory Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md border-left border-indigo">
                    <label text="Tax Details (GST)" type="h5" style="text-indigo-8 text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="ProductTaxForm" transition="updateProduct" map="product">
                        <field name="productId"><default-field><hidden/></default-field></field>
                        
                        <field name="hsnCode"><default-field title="Tax Code – HSN (for products)"><text-line size="10"/></default-field></field>
                        <field name="sacCode"><default-field title="Tax Code – SAC (for services)"><text-line size="10"/></default-field></field>
                        
                        <field name="uqcEnumId">
                            <default-field title="Unit (how you sell it)">
                                <drop-down allow-empty="true">
                                    <option key="NOS" text="NOS - Numbers"/>
                                    <option key="KGS" text="KGS - Kilograms"/>
                                    <option key="MTR" text="MTR - Meters"/>
                                    <option key="PCS" text="PCS - Pieces"/>
                                    <option key="LTR" text="LTR - Liters"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="gstSlabId">
                            <default-field title="GST Tax Rate">
                                <drop-down allow-empty="true">
                                    <entity-options key="${gstSlabId}" text="${slabName} (${gstRate}%)">
                                        <entity-find entity-name="zenith.erp.india.IndiaGstSlab"/>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="isGstExempt">
                            <default-field title="Tax-free item?">
                                <drop-down no-current-selected-key="N">
                                    <option key="N" text="No (Taxable)"/>
                                    <option key="Y" text="Yes (Nil-Rated/Exempt)"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="mrpAmount"><default-field title="Selling Price (MRP)"><text-line size="10"/>
                            <label text="The price you charge customers. This is what shows up at the POS and on bills." style="text-grey-6 text-caption" type="p"/></default-field></field>
                        
                        <field name="enableBatchTracking">
                            <default-field title="Track by batch / lot?">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field>
                        </field>
                        
                        <field name="submitButton"><default-field title="Save Tax Info"><submit/></default-field></field>
                    </form-single>
                </container>
            </row-col>
        </container-row>

        <!-- Stock by Facility -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg" condition="product?.productTypeEnumId != 'PtService'">
            <label text="Stock by Store / Warehouse" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
            <form-list name="FacilityStockList" list="stockList" skip-form="true">
                <field name="facilityName"><default-field title="Store / Warehouse"><label text="${facilityName}" type="strong" style="text-dark"/></default-field></field>
                <field name="totalQoh"><default-field title="Quantity on Hand"><label text="${totalQoh}" type="span" style="text-weight-bold"/></default-field></field>
                <field name="totalAtp"><default-field title="Free to Sell"><label text="${totalAtp}" type="span"/></default-field></field>
                <field name="totalValue"><default-field title="Stock Value (${currSymbol})"><label text="${ec.l10n.format(totalValue ?: 0, '#,##,##0.00')}" type="span"/></default-field></field>
            </form-list>
        </container>

    </widgets>
</screen>
