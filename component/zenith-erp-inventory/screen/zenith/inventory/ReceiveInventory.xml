<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Receive Inventory" default-menu-include="false">

    <parameter name="orderId" required="true"/>

    <transition name="findReceipt"><default-response url="../FindReceipt"/></transition>
    
    <!-- The GET-time Quasar renderer must discover this as an action form; writes remain POST-only. -->
    <transition name="receiveItem">
        <actions>
            <if condition="ec.web.request.method != 'POST'"><return error="true" message="Receiving stock requires a form submission."/></if>
            <if condition="!ec.web.parameters.moquiSessionToken || ec.web.parameters.moquiSessionToken != ec.web.sessionToken"><return error="true" message="Your session expired. Reload Receiving and try again."/></if>
            <service-call name="zenith.inventory.ReceiptServices.receive#Stock"
                in-map="[orderId:orderId, orderItemSeqId:orderItemSeqId, facilityId:facilityId,
                    quantityAccepted:quantityAccepted, batchNumber:batchNumber, mrpAmount:mrpAmount,
                    manufacturingDate:manufacturingDate, expiryDate:expiryDate]"/>
        </actions><default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-INV-IV-06A: org-isolation guard — don't render another tenant's PO (items/vendor/costs).
             A PO's owner is OrderPart.customerPartyId; block unless it's the caller's active org. -->
        <service-call name="zenith.inventory.ReceiptServices.get#PurchaseOrderAccess" in-map="[orderId:orderId]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>

        <entity-find entity-name="mantle.order.OrderPart" list="orderParts">
            <econdition field-name="orderId"/>
        </entity-find>
        <set field="orderPart" from="orderParts?.getFirst()"/>

        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/>
            <econdition field-name="productId" operator="is-not-null"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>

        <service-call name="zenith.inventory.ReceiptServices.get#OrderReceiptQuantities" in-map="[orderId:orderId]" out-map="receiptTotals"/>
        <!-- Only destinations in the active organization may receive its goods. -->
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <order-by field-name="facilityName"/>
        </entity-find>
        </if>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt,vuet"><![CDATA[<link rel="stylesheet" href="/zenithstatic/css/receiving-stock.css?v=14"/>]]></text></render-mode>
        <container id="receivingStockDetail" style="receiving-page">
        <container style="receiving-detail-back">
            <link url="findReceipt" text="← Back to Receiving List" link-type="anchor"/>
            <label text="Received items go straight into stock and are ready to sell." type="span" style="text-grey-7 text-caption"/>
        </container>

        <!-- ZE-INV-IV-06A: cross-tenant / missing PO — plain notice, never another org's PO -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md text-center">
                    <label text="That purchase order isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Receiving List” above to return." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheReceipt">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <!-- Header Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white; border-radius:12px; background:linear-gradient(135deg, #0ea5e9, #0284c7);">
                        <label text="GRN" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="Receive Goods for Order #${orderId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Supplier: ${vendor?.organizationName ?: vendor?.firstName + ' ' + vendor?.lastName}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
            </container>
        </container>

        <!-- Items to Receive -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <label text="Items to Receive" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
            <label text="For each item, enter how many actually arrived and which store to put them in, then press Confirm." type="p" style="text-grey-7 q-mb-md"/>
            
            <form-list name="ReceiveItemsForm" list="orderItems" skip-form="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.product.Product" value-field="product">
                        <field-map field-name="productId"/>
                    </entity-find-one>
                    
                    <set field="qtyReceived" from="receiptTotals.receivedByItem[orderItemSeqId] ?: 0G"/>
                    <set field="qtyRemaining" from="((quantity ?: 0G) - (quantityCancelled ?: 0G) - qtyReceived).max(0G)"/>
                    <set field="canReceiveLine" from="qtyRemaining > 0 &amp;&amp; (order.statusId in ['OrderApproved','OrderCompleted'])"/>
                </row-actions>

                <field name="orderItemSeqId"><default-field title="#"><label text="${orderItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                
                <field name="productInfo"><default-field title="Product">
                    <label text="${product?.pseudoId ?: productId}" type="strong" style="block text-indigo-8"/>
                    <label text="${itemDescription ?: product?.productName}" type="span" style="block text-dark"/>
                </default-field></field>

                <field name="quantities"><default-field title="Order vs Received">
                    <label text="Ordered: ${quantity ?: 0}" type="span" style="block text-dark"/>
                    <label text="Received: ${qtyReceived}" type="span" style="block text-success text-weight-bold"/>
                    <label text="Pending: ${qtyRemaining}" type="span" style="block text-warning text-weight-bold"/>
                </default-field></field>
                
                <field name="receiveAction">
                    <header-field title="Receive"/>
                    <!-- ZE-INV-010 (IV-110): the receive form only for users with full Inventory write access; the
                         "Fully Received" status stays visible to everyone (read-only). Form name/transition untouched. -->
                    <conditional-field name="receive_write" condition="invCanWrite" title="Receive">
                        <container-dialog id="ReceiveDialog_${orderItemSeqId}" button-text="Process Receipt" button-class="q-btn--flat bg-primary text-white border-radius-md" condition="canReceiveLine">
                            <!-- ZE-INV-001 f/u: form-single name must be a STATIC identifier — Moqui does NOT
                                 interpolate ${} in it (the container-dialog id above does), so the old
                                 name="ReceiveForm_${orderItemSeqId}" left moquiFormName as that literal string and
                                 the submit re-rendered the screen instead of invoking receiveItem (0 PO receipts
                                 ever). Per-row values come from the hidden fields below, so a static name is fine. -->
                            <form-single name="ReceiveForm" transition="receiveItem">
                                <field name="orderId"><default-field><hidden/></default-field></field>
                                <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                
                                <field name="facilityId">
                                    <default-field title="Put stock into (store / warehouse)">
                                        <drop-down allow-empty="false">
                                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                
                                <field name="quantityAccepted">
                                    <default-field title="Quantity Received">
                                        <text-line size="10" default-value="${qtyRemaining}"/>
                                    </default-field>
                                </field>
                                
                                <field name="batchNumber">
                                    <default-field title="Batch / Lot Number (Optional)">
                                        <text-line size="20"/>
                                    </default-field>
                                </field>
                                
                                <field name="manufacturingDate">
                                    <default-field title="Manufacturing Date"><date-time type="date"/></default-field>
                                </field>
                                
                                <field name="expiryDate">
                                    <default-field title="Expiry Date"><date-time type="date"/></default-field>
                                </field>
                                
                                <field name="mrpAmount">
                                    <default-field title="Batch MRP (Optional)">
                                        <text-line size="10" default-value="${product?.mrpAmount ?: ''}"/>
                                    </default-field>
                                </field>
                                
                                <field name="submitButton"><default-field title="Confirm Receipt"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>

                        <label text="Fully Received" type="span" style="zenith-badge success" condition="qtyRemaining &lt;= 0"/>
                    </conditional-field>
                    <default-field title="Receive">
                        <label text="Fully Received" type="span" style="zenith-badge success" condition="qtyRemaining &lt;= 0"/>
                    </default-field>
                </field>
            </form-list>
        </container>
        </widgets>
        </section>

        <container style="receiving-footer">
            <label text="© 2024-${ec.l10n.format(ec.user.nowTimestamp, 'yyyy')} ZetaERP · Cloud ERP Platform" type="span"/>
            <render-mode><text type="html,qvt,vuet"><![CDATA[<a href="mailto:support@zetaclantech.com">Support</a>]]></text></render-mode>
        </container>
        </container>
    </widgets>
</screen>
