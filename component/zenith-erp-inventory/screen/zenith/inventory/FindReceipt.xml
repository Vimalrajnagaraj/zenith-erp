<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Receiving" default-menu-index="3">

    <transition name="receiveInventory"><default-response url="../ReceiveInventory"/></transition>

    <actions>
        <entity-find entity-name="mantle.party.PartyRole" list="internalOrgRoles">
            <econdition field-name="roleTypeId" value="InternalOrganization"/>
        </entity-find>
        <set field="internalOrgIdList" from="internalOrgRoles.partyId"/>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: (internalOrgIdList ? internalOrgIdList[0] : null)"/>

        <set field="statusColorMap" from="[
            'OrderApproved': 'primary',
            'OrderCompleted': 'success'
        ]"/>

        <!-- XF-001: lift the search out of the form-list into actions so `poList` is available for
             the empty-state below (an empty list otherwise just showed a bare filter with no cue). -->
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="poList">
            <econdition field-name="customerPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <econdition field-name="vendorPartyId" operator="is-not-null"/>
            <econdition field-name="statusId" operator="in" value="OrderApproved,OrderCompleted"/>
            <search-form-inputs default-order-by="-orderDate,orderId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Receiving (Incoming Stock)" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="When goods arrive from a supplier, open the matching purchase order here and record what came in." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <label text="Orders waiting to be received" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
            
            <form-list name="FindPendingReceiptsList" list="poList" skip-form="true" show-csv-button="false">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="Order #" show-order-by="true"><text-find hide-options="true" size="12"/></header-field>
                    <default-field><label text="${orderId}" type="strong"/></default-field>
                </field>

                <!-- XF-001: Receive action promoted to column 2 so it is ALWAYS visible. The wide
                     filter header made the table overflow, pushing the last column (the action) off
                     the right edge — which is why testers reported "no Save/Receive action". -->
                <field name="receiveAction">
                    <header-field title="Action"/>
                    <!-- ZE-INV-010 (IV-110): the Receive action only for users with full Inventory write access;
                         XF-001: was a faint flat text link that testers missed — now a solid, labelled button. -->
                    <conditional-field name="receive_write" condition="invCanWrite">
                        <link url="receiveInventory" text="Receive Stock" parameter-map="[orderId:orderId]" icon="login" btn-type="primary" style="text-weight-bold"/>
                    </conditional-field>
                    <default-field><label text="View only" type="span" style="text-grey-6 text-caption"/></default-field>
                </field>

                <field name="orderDate">
                    <header-field title="Order Date" show-order-by="true"><date-find/></header-field>
                    <default-field><label text="${ec.l10n.format(orderDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="vendorPartyId">
                    <header-field title="Supplier">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                    <econdition field-name="roleTypeId" value="Supplier"/>
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <default-field><label text="${vendorParty?.organizationName ?: (vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Order', '') : 'Approved'}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>

            <!-- XF-001: guide the user when nothing is waiting, instead of a bare filter with no visible action. -->
            <section name="NoOrdersWaiting">
                <condition><expression>!poList</expression></condition>
                <widgets>
                    <container style="text-center q-pa-xl">
                        <label text="No orders are waiting to be received right now." type="h6" style="text-grey-8 text-weight-bold q-mb-xs"/>
                        <label text="When you approve a purchase order in the Purchase module, it shows up here — then use the Receive Stock button to record what actually arrived." type="p" style="text-grey-6 q-mb-none"/>
                    </container>
                </widgets>
            </section>
        </container>
    </widgets>
</screen>
