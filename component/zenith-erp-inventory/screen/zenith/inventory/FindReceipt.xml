<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Receiving" default-menu-index="3">

    <transition name="receiveInventory"><default-response url="../ReceiveInventory"/></transition>

    <!-- XF-002: receive incoming stock DIRECTLY, without a purchase order (opening stock, walk-in
         supplier delivery, or a branch transfer). Adds the qty to the chosen store via the canonical
         adjust#AssetOnHand (find-or-create org asset + on-hand + AssetDetail ledger). Does NOT flip
         Product.inventoryTracked, so it never changes POS depletion for non-tracking tenants (MARUTHI-safe). -->
    <transition name="receiveDirectStock">
        <actions>
            <!-- ZE-INV-010: enforce Inventory write access (defense-in-depth; the central gate is fail-open) -->
            <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" out-map="_wac" in-map="[moduleId:'inventory']"/>
            <if condition="!(_wac?.canWrite)"><return error="true" message="You have view-only access to Inventory — you can't receive stock here."/></if>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!productId"><return error="true" message="Please select a product to receive."/></if>
            <if condition="!facilityId"><return error="true" message="Please choose the store / warehouse to receive into."/></if>
            <script><![CDATA[
                def _numOk = { v -> v != null && v.toString().trim() != '' && (v.toString().trim() ==~ /\d*\.?\d+/) }
                if (!_numOk(quantityDiff)) { ec.message.addError("Quantity received must be a number greater than zero."); return }
                def _qty = new BigDecimal(quantityDiff.toString().trim())
                if (_qty.signum() <= 0) { ec.message.addError("Quantity received must be greater than zero."); return }
                def _org = (activeOrg && activeOrg != '_NA_') ? activeOrg : null
                if (!_org) { ec.message.addError("No active organization is selected — cannot receive stock."); return }
                def inMap = [organizationPartyId:_org, productId:productId, quantityDiff:_qty,
                             facilityId:facilityId, reason:'Direct goods receipt']
                if (batchNumber) inMap.batchNumber = batchNumber
                if (expiryDate) inMap.expiryDate = expiryDate
                if (manufacturingDate) inMap.manufacturingDate = manufacturingDate
                if (_numOk(mrpAmount)) inMap.mrpAmount = new BigDecimal(mrpAmount.toString().trim())
                if (_numOk(valuationRate)) inMap.valuationRate = new BigDecimal(valuationRate.toString().trim())
                ec.service.sync().name("zenith.inventory.InventoryStockServices.adjust#AssetOnHand").parameters(inMap).call()
                if (!ec.message.hasError()) ec.message.addMessage("Received ${_qty} units into stock. Open Stock Levels to verify the updated quantity.")
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- XF-002 f/u: receive an in-transit stock transfer straight from Receiving (mirrors the
         StockTransfers screen's receiveTransfer) so branch / inter-state transfers are received
         from the same "incoming stock" place, not only under the Stock Transfers menu. -->
    <transition name="receiveTransfer">
        <service-call name="zenith.inventory.InventoryServices.receive#StockTransfer"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="mantle.party.PartyRole" list="internalOrgRoles">
            <econdition field-name="roleTypeId" value="InternalOrganization"/>
        </entity-find>
        <set field="internalOrgIdList" from="internalOrgRoles.partyId"/>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: (internalOrgIdList ? internalOrgIdList[0] : null)"/>

        <set field="statusColorMap" from="[
            'OrderApproved': 'primary',
            'OrderCompleted': 'success'
        ]"/>

        <!-- XF-001: lift the search out of the form-list into actions so `poList` is available for
             the empty-state below (an empty list otherwise just showed a bare filter with no cue). -->
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="poList">
            <econdition field-name="customerPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <econdition field-name="vendorPartyId" operator="is-not-null"/>
            <econdition field-name="statusId" operator="in" value="OrderApproved,OrderCompleted"/>
            <search-form-inputs default-order-by="-orderDate,orderId"/>
        </entity-find>

        <!-- XF-002: options for the direct-receive dialog (org-scoped). -->
        <entity-find entity-name="mantle.product.Product" list="prodList">
            <econdition field-name="ownerPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <econdition field-name="ownerPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <order-by field-name="facilityName"/>
        </entity-find>

        <!-- XF-002 f/u: stock transfers shipped to this org's stores and awaiting receipt (incoming stock). -->
        <entity-find entity-name="zenith.erp.inventory.StockTransferView" list="inTransitList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="statusId" value="StxInTransit"/>
            <order-by field-name="-transferDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Receiving (Incoming Stock)" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Receive against a purchase order below, or use Receive Stock Directly for goods that arrived without one." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <!-- XF-002: always-available Save/Receive action (no PO required). -->
            <section name="DirectReceiveToolbar">
                <condition><expression>invCanWrite</expression></condition>
                <widgets>
                    <container-dialog id="DirectReceiveDialog" button-text="Receive Stock Directly" button-class="btn btn-success text-weight-bold">
                        <label text="Receive Stock Directly (no purchase order)" type="h5" style="text-primary text-weight-bold q-mb-xs"/>
                        <label text="Use this when goods arrive without a matching purchase order — opening stock, a walk-in supplier delivery, or a branch transfer. The quantity is added to the chosen store and shows immediately in Stock Levels." type="p" style="text-grey-7 q-mb-md"/>
                        <form-single name="DirectReceiveForm" transition="receiveDirectStock">
                            <field name="productId"><default-field title="Product">
                                <drop-down><list-options list="prodList" key="${productId}" text="${pseudoId ? (pseudoId + ' — ') : ''}${productName}"/></drop-down>
                            </default-field></field>
                            <field name="facilityId"><default-field title="Store / Warehouse to receive into">
                                <drop-down allow-empty="false"><list-options list="facilityList" key="${facilityId}" text="${facilityName}"/></drop-down>
                            </default-field></field>
                            <field name="quantityDiff"><default-field title="Quantity Received"><text-line size="10"/></default-field></field>
                            <field name="valuationRate"><default-field title="Unit Cost (optional)"><text-line size="10"/></default-field></field>
                            <field name="batchNumber"><default-field title="Batch / Lot Number (optional)"><text-line size="20"/></default-field></field>
                            <field name="manufacturingDate"><default-field title="Manufacturing Date (optional)"><date-time type="date"/></default-field></field>
                            <field name="expiryDate"><default-field title="Expiry Date (optional)"><date-time type="date"/></default-field></field>
                            <field name="mrpAmount"><default-field title="Batch MRP (optional)"><text-line size="10"/></default-field></field>
                            <field name="submitButton"><default-field title="Receive into stock"><submit text="Receive Stock" icon="login"/></default-field></field>
                        </form-single>
                    </container-dialog>
                </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <label text="Orders waiting to be received" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
            
            <form-list name="FindPendingReceiptsList" list="poList" skip-form="true" show-csv-button="false">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="Order #" show-order-by="true"><text-find hide-options="true" size="12"/></header-field>
                    <default-field><label text="${orderId}" type="strong"/></default-field>
                </field>

                <!-- XF-001: Receive action promoted to column 2 so it is ALWAYS visible. The wide
                     filter header made the table overflow, pushing the last column (the action) off
                     the right edge — which is why testers reported "no Save/Receive action". -->
                <field name="receiveAction">
                    <header-field title="Action"/>
                    <!-- ZE-INV-010 (IV-110): the Receive action only for users with full Inventory write access;
                         XF-001: was a faint flat text link that testers missed — now a solid, labelled button. -->
                    <conditional-field name="receive_write" condition="invCanWrite">
                        <link url="receiveInventory" text="Receive Stock" parameter-map="[orderId:orderId]" icon="login" btn-type="primary" style="text-weight-bold"/>
                    </conditional-field>
                    <default-field><label text="View only" type="span" style="text-grey-6 text-caption"/></default-field>
                </field>

                <field name="orderDate">
                    <header-field title="Order Date" show-order-by="true"><date-find/></header-field>
                    <default-field><label text="${ec.l10n.format(orderDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="vendorPartyId">
                    <header-field title="Supplier">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                    <econdition field-name="roleTypeId" value="Supplier"/>
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <default-field><label text="${vendorParty?.organizationName ?: (vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Order', '') : 'Approved'}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>

            <!-- XF-001: guide the user when nothing is waiting, instead of a bare filter with no visible action. -->
            <section name="NoOrdersWaiting">
                <condition><expression>!poList</expression></condition>
                <widgets>
                    <container style="text-center q-pa-xl">
                        <label text="No purchase orders are waiting to be received right now." type="h6" style="text-grey-8 text-weight-bold q-mb-xs"/>
                        <label text="Approve a purchase order in the Purchase module and it shows up here — or use Receive Stock Directly (top right) to record incoming goods that have no purchase order." type="p" style="text-grey-6 q-mb-none"/>
                    </container>
                </widgets>
            </section>
        </container>

        <!-- XF-002 f/u: incoming STOCK TRANSFERS (branch / inter-state moves) awaiting receipt at this org's
             stores — shown here so all "incoming stock" lives in one place, with a Receive action + a link
             to the full Stock Transfers screen. Section only renders when something is actually in transit. -->
        <section name="InTransitTransfers">
            <condition><expression>inTransitList</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mt-lg">
                    <label text="Stock transfers on the way to your stores" type="h5" style="text-primary text-weight-bold q-mb-xs border-bottom q-pb-sm"/>
                    <label text="These were shipped from another of your warehouses (a branch or inter-state move) and are waiting to be received. Receiving adds the stock to the destination store." type="p" style="text-grey-7 q-mb-md"/>
                    <form-list name="InTransitList" list="inTransitList" skip-form="true" show-csv-button="false">
                        <field name="transferNumber">
                            <default-field title="Transfer #">
                                <link url="../EditStockTransfer" text="${transferNumber ?: stockTransferId}" parameter-map="[stockTransferId:stockTransferId]" style="text-indigo-8 text-weight-bold"/>
                            </default-field>
                        </field>
                        <field name="recvAction">
                            <header-field title="Action"/>
                            <conditional-field name="recv_write" condition="invCanWrite">
                                <link url="receiveTransfer" text="Receive Transfer" parameter-map="[stockTransferId:stockTransferId]" icon="login"
                                      btn-type="primary" style="text-weight-bold"
                                      confirmation="Receive this transfer? The stock will be added to the destination store."/>
                            </conditional-field>
                            <default-field><label text="View only" type="span" style="text-grey-6 text-caption"/></default-field>
                        </field>
                        <field name="fromFacilityName"><default-field title="From"><display/></default-field></field>
                        <field name="toFacilityName"><default-field title="To (destination)"><display/></default-field></field>
                        <field name="transferDate"><default-field title="Shipped"><display format="dd MMM yyyy"/></default-field></field>
                        <field name="totalValue"><default-field title="Value"><display format="#,##,##0.00"/></default-field></field>
                        <field name="igstInvoiceId"><default-field title="Inter-state">
                            <label text="IGST ${igstInvoiceId}" type="span" style="zenith-badge warning" condition="igstInvoiceId"/>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>

        <!-- Always-visible pointer so the transfer-receive path is discoverable even with nothing in transit. -->
        <container style="q-mt-md q-mb-lg">
            <link url="../StockTransfers" text="Receiving a branch or inter-state transfer? Open Stock Transfers →" link-type="anchor" style="text-primary text-weight-bold"/>
        </container>
    </widgets>
</screen>
