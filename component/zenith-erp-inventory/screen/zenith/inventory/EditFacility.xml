<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Facility Details" default-menu-include="false">

    <parameter name="facilityId" required="true"/>

    <transition name="findFacility"><default-response url="../FindFacility"/></transition>
    
    <transition name="updateFacility">
        <service-call name="update#mantle.facility.Facility"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.facility.Facility" value-field="facility"/>
        
        <entity-find entity-name="zenith.erp.inventory.StockByFacilityView" list="stockList">
            <econdition field-name="facilityId"/>
            <order-by field-name="productName"/>
        </entity-find>
        
        <set field="totalValuation" from="0"/>
        <script>
            for (def stock : stockList) {
                totalValuation += (stock.totalValue ?: 0)
            }
        </script>
        
        <entity-find-one entity-name="moqui.basic.Enumeration" value-field="facTypeEnum">
            <field-map field-name="enumId" from="facility?.facilityTypeEnumId"/>
        </entity-find-one>
    </actions>

    <widgets>
        <render-mode><text type="html"><![CDATA[
            <style>
                /* Fix Quasar text inputs getting squashed */
                .q-field__control { min-height: 40px !important; }
                .q-field__native, .q-field__input { padding-top: 12px !important; }
                .q-field__label { top: 12px !important; }
            </style>
        ]]></text></render-mode>
        <link url="findFacility" text="Back to Warehouses &amp; Facilities" link-type="anchor"/>
        
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white rounded-borders bg-indigo-8 q-pa-md flex flex-center">
                        <label text="FAC" type="span" style="text-weight-bold text-h6"/>
                    </container>
                    <container style="column">
                        <label text="${facility?.facilityName}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Facility ID: ${facilityId} | Type: ${facTypeEnum?.description ?: 'Warehouse'}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="column items-end text-right">
                    <label text="Total Stock Value" type="span" style="text-grey-7"/>
                    <label text="${currSymbol}${ec.l10n.format(totalValuation ?: 0, '#,##,##0.00')}" type="strong" style="text-h4 text-indigo-8"/>
                </container>
            </container>
        </container>

        <container-row>
            <row-col lg="5">
                <!-- Facility Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Location Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="FacilityForm" transition="updateFacility" map="facility">
                        <field name="facilityId"><default-field><hidden/></default-field></field>
                        
                        <field name="facilityName"><default-field title="Facility Name"><text-line size="60"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2"/></default-field></field>
                        
                        <field name="facilityTypeEnumId">
                            <default-field title="Facility Type">
                                <drop-down>
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="FacilityType"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="gstStateCode">
                            <default-field title="GST State Code (India)">
                                <text-line size="2"/>
                            </default-field>
                        </field>
                        
                        <field name="facilityGstin">
                            <default-field title="Facility GSTIN">
                                <text-line size="20"/>
                            </default-field>
                        </field>

                        <field name="pincode">
                            <default-field title="Pincode"><text-line size="10"/></default-field>
                        </field>
                        
                        <!-- ZE-INV-010 (IV-110): save disabled for view-only users -->
                        <field name="submitButton">
                            <conditional-field name="save_write" condition="invCanWrite" title="Save Configuration"><submit/></conditional-field>
                            <default-field><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="7">
                <!-- Stock Listing -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
                    <label text="Stock at This Location" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-list name="FacilityStockList" list="stockList" skip-form="true">
                        <field name="pseudoId"><default-field title="Item Code"><label text="${pseudoId}" type="strong" style="text-indigo-8"/></default-field></field>
                        <field name="productName"><default-field title="Product"><label text="${productName}" type="span" style="text-dark"/></default-field></field>
                        <field name="hsnCode"><default-field title="HSN"><label text="${hsnCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                        
                        <field name="totalQoh">
                            <default-field title="Qty on Hand">
                                <label text="${totalQoh}" type="span" style="text-weight-bold ${totalQoh &lt; 0 ? 'text-danger' : 'text-success'}"/>
                            </default-field>
                        </field>
                        
                        <field name="totalValue">
                            <default-field title="Stock Value (${currSymbol})">
                                <label text="${ec.l10n.format(totalValue ?: 0, '#,##,##0.00')}" type="span"/>
                            </default-field>
                        </field>
                    </form-list>
                </container>
            </row-col>
        </container-row>

    </widgets>
</screen>
