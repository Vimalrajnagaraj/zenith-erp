<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Certificates" default-menu-index="5">

    <transition name="createCert" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): stamp the certificate's org. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.quality.QualityCertificate" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateCert" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update a certificate your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.quality.QualityCertificate', idField:'certificateId', idValue:certificateId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Certificate not found for your account."/></if>
            <service-call name="update#zenith.erp.quality.QualityCertificate" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.quality.QualityCertificate" list="certList">
            <!-- ZE-SB-013 (Tier 4): only this org's certificates. -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="expiryDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Quality Certificates (BIS / FSSAI / ISO)"/>
            <box-toolbar>
                <section name="qual_cert_add_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCertDialog" button-text="Add Certificate">
                    <form-single name="CreateCertForm" transition="createCert">
                        <field name="certificateId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="certificateType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="QcCertType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="certificateNumber"><default-field title="Certificate No"><text-line size="25"/></default-field></field>
                        <field name="issuingBody"><default-field title="Issuing Body"><text-line size="25"/></default-field></field>
                        <field name="issueDate"><default-field title="Issue Date"><date-time type="date"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date"/></default-field></field>
                        <field name="scope"><default-field title="Scope"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="productId"><default-field title="Product (optional)"><text-line size="15"/></default-field></field>
                        <field name="facilityId"><default-field title="Facility (optional)"><text-line size="15"/></default-field></field>
                        <field name="remarks"><default-field title="Remarks"><text-line size="30"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CertList" list="certList" transition="updateCert">
                    <field name="certificateId"><default-field title="ID"><display/></default-field></field>
                    <field name="certificateType"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="QcCertType"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="certificateNumber"><default-field title="Number"><text-line size="18"/></default-field></field>
                    <field name="issuingBody"><default-field title="Issuer"><text-line size="18"/></default-field></field>
                    <field name="issueDate"><default-field title="Issued"><date-time type="date"/></default-field></field>
                    <field name="expiryDate"><default-field title="Expires"><date-time type="date"/></default-field></field>
                    <field name="scope"><default-field title="Scope"><text-line size="20"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="cert_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
