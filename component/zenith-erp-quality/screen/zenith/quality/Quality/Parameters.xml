<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Parameters" default-menu-index="3">

    <transition name="createParam" begin-transaction="true">
        <service-call name="create#zenith.erp.quality.QualityParameter"/>
        <default-response url="."/>
    </transition>
    <transition name="updateParam" begin-transaction="true">
        <service-call name="update#zenith.erp.quality.QualityParameter"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.quality.QualityParameter" list="paramList">
            <order-by field-name="parameterGroup,parameterName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Quality Parameters"/>
            <box-toolbar>
                <section name="qual_param_create_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateParamDialog" button-text="New Parameter">
                    <form-single name="CreateParamForm" transition="createParam">
                        <field name="parameterId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="parameterName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="parameterGroup"><default-field title="Group">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="QcParamGroup"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="unit"><default-field title="Unit"><text-line size="10"/></default-field></field>
                        <field name="targetValue"><default-field title="Target"><text-line size="8"/></default-field></field>
                        <field name="minValue"><default-field title="Min"><text-line size="8"/></default-field></field>
                        <field name="maxValue"><default-field title="Max"><text-line size="8"/></default-field></field>
                        <field name="inspectionMethod"><default-field title="Method"><text-line size="25"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="ParamList" list="paramList" transition="updateParam">
                    <field name="parameterId"><default-field title="ID"><display/></default-field></field>
                    <field name="parameterName"><default-field title="Name"><text-line size="18"/></default-field></field>
                    <field name="parameterGroup"><default-field title="Group">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="QcParamGroup"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="unit"><default-field title="Unit"><text-line size="6"/></default-field></field>
                    <field name="targetValue"><default-field title="Target"><text-line size="6"/></default-field></field>
                    <field name="minValue"><default-field title="Min"><text-line size="6"/></default-field></field>
                    <field name="maxValue"><default-field title="Max"><text-line size="6"/></default-field></field>
                    <field name="inspectionMethod"><default-field title="Method"><text-line size="18"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="param_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
