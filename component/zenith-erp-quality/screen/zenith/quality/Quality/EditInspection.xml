<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inspection Detail" default-menu-include="false">

    <parameter name="inspectionId" required="true"/>

    <transition name="updateInspection" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update an inspection your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ia"
                          in-map="[entityName:'zenith.erp.quality.QualityInspection', idField:'inspectionId', idValue:inspectionId, orgField:'organizationPartyId']"/>
            <if condition="!_ia.allowed"><return error="true" message="Inspection not found for your account."/></if>
            <service-call name="update#zenith.erp.quality.QualityInspection" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="recordReading" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.record#InspectionReading"/>
        <default-response url="."/>
    </transition>
    <transition name="completeInspection" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.complete#Inspection"/>
        <default-response url="."/>
    </transition>
    <transition name="addReading" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): readings may only be added to an inspection your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ia"
                          in-map="[entityName:'zenith.erp.quality.QualityInspection', idField:'inspectionId', idValue:inspectionId, orgField:'organizationPartyId']"/>
            <if condition="!_ia.allowed"><return error="true" message="Inspection not found for your account."/></if>
            <service-call name="create#zenith.erp.quality.InspectionReading" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="raiseNcr" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.create#NonConformance"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SB-013 (Tier 4): block rendering another org's inspection + its readings. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ia"
                      in-map="[entityName:'zenith.erp.quality.QualityInspection', idField:'inspectionId', idValue:inspectionId, orgField:'organizationPartyId']"/>
        <if condition="!_ia.allowed"><script>ec.web.sendRedirectAndStopRender('/apps/zenith/quality/Inspections')</script></if>
        <entity-find-one entity-name="zenith.erp.quality.QualityInspection" value-field="inspection"/>
        <entity-find entity-name="zenith.erp.quality.InspectionReading" list="readingList">
            <econdition field-name="inspectionId"/>
            <order-by field-name="readingSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box><box-header title="${inspection.inspectionNumber}"/>
                <box-body>
                    <form-single name="InspForm" transition="updateInspection" map="inspection">
                        <field name="inspectionId"><default-field><hidden/></default-field></field>
                        <field name="inspectionNumber"><default-field title="QC #"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="overallResult"><default-field title="Result"><display/></default-field></field>
                        <field name="inspectionType"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="productId"><default-field title="Product"><text-line size="15"/></default-field></field>
                        <field name="batchNumber"><default-field title="Batch/Lot"><text-line size="15"/></default-field></field>
                        <field name="sampleSize"><default-field title="Sample Size"><text-line size="6"/></default-field></field>
                        <field name="inspectedQuantity"><default-field title="Inspected Qty"><text-line size="8"/></default-field></field>
                        <field name="acceptedQuantity"><default-field title="Accepted Qty"><text-line size="8"/></default-field></field>
                        <field name="rejectedQuantity"><default-field title="Rejected Qty"><text-line size="8"/></default-field></field>
                        <field name="inspectionDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="remarks"><default-field title="Remarks"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="insp_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Actions -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="qual_insp_actions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="CompleteDialog" button-text="Complete Inspection">
                        <form-single name="CompleteForm" transition="completeInspection">
                            <field name="inspectionId"><default-field><hidden/></default-field></field>
                            <field name="acceptedQuantity"><default-field title="Accepted Qty"><text-line size="8"/></default-field></field>
                            <field name="rejectedQuantity"><default-field title="Rejected Qty"><text-line size="8"/></default-field></field>
                            <field name="submitButton"><default-field title="Complete"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="NcrDialog" button-text="Raise NCR">
                        <form-single name="NcrForm" transition="raiseNcr">
                            <field name="inspectionId"><default-field><hidden/></default-field></field>
                            <field name="productId"><default-field><hidden default-value="${inspection?.productId}"/></default-field></field>
                            <field name="batchNumber"><default-field><hidden default-value="${inspection?.batchNumber}"/></default-field></field>
                            <field name="ncType"><default-field title="NC Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="NcType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="severity"><default-field title="Severity">
                                <drop-down><option key="Critical"/><option key="Major"/><option key="Minor"/><option key="Observation"/></drop-down></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="dispositionAction"><default-field title="Disposition">
                                <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="NcDisposition"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="affectedQuantity"><default-field title="Affected Qty"><text-line size="8"/></default-field></field>
                            <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                            <field name="submitButton"><default-field title="Raise NCR"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Readings -->
                <container-box><box-header title="Inspection Readings"/>
                <box-toolbar>
                    <section name="qual_insp_addreading_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddReadingDialog" button-text="Add Parameter">
                        <form-single name="AddReadingForm" transition="addReading">
                            <field name="inspectionId"><default-field><hidden/></default-field></field>
                            <field name="readingSeqId"><default-field title="Seq ID"><text-line size="6"/></default-field></field>
                            <field name="parameterId"><default-field title="Parameter">
                                <drop-down><entity-options key="${parameterId}" text="${parameterName} (${unit})">
                                    <entity-find entity-name="zenith.erp.quality.QualityParameter">
                                        <econdition field-name="isActive" value="Y"/>
                                        <!-- ZE-SB-013 (Tier 4): own parameters + global shared seeds. -->
                                        <econditions combine="or">
                                            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                            <econdition field-name="organizationPartyId" operator="is-null"/>
                                        </econditions>
                                        <order-by field-name="parameterName"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="parameterName"><default-field title="Name (override)"><text-line size="20"/></default-field></field>
                            <field name="targetValue"><default-field title="Target"><text-line size="8"/></default-field></field>
                            <field name="minValue"><default-field title="Min"><text-line size="8"/></default-field></field>
                            <field name="maxValue"><default-field title="Max"><text-line size="8"/></default-field></field>
                            <field name="unit"><default-field title="Unit"><text-line size="8"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="ReadingList" list="readingList" transition="recordReading">
                        <field name="inspectionId"><default-field><hidden/></default-field></field>
                        <field name="readingSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="parameterName"><default-field title="Parameter"><display/></default-field></field>
                        <field name="unit"><default-field title="Unit"><display/></default-field></field>
                        <field name="minValue"><default-field title="Min"><display/></default-field></field>
                        <field name="targetValue"><default-field title="Target"><display/></default-field></field>
                        <field name="maxValue"><default-field title="Max"><display/></default-field></field>
                        <field name="actualValue"><default-field title="Actual"><text-line size="8"/></default-field></field>
                        <field name="result"><default-field title="Result"><display/></default-field></field>
                        <field name="remarks"><default-field title="Remarks"><text-line size="15"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="reading_record_write" condition="modCanWrite" title="Record"><submit/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
