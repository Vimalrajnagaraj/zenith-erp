<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="NCR Detail" default-menu-include="false">

    <parameter name="ncId" required="true"/>

    <transition name="updateNcr" begin-transaction="true">
        <service-call name="update#zenith.erp.quality.NonConformance"/>
        <default-response url="."/>
    </transition>
    <transition name="resolveNcr" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.resolve#NonConformance"/>
        <default-response url="."/>
    </transition>
    <transition name="createCapa" begin-transaction="true">
        <service-call name="create#zenith.erp.quality.CorrectiveAction"/>
        <default-response url="."/>
    </transition>
    <transition name="updateCapa" begin-transaction="true">
        <service-call name="update#zenith.erp.quality.CorrectiveAction"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.quality.NonConformance" value-field="ncr"/>
        <entity-find entity-name="zenith.erp.quality.CorrectiveAction" list="capaList">
            <econdition field-name="ncId"/>
            <order-by field-name="capaId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6" md="12">
                <container-box><box-header title="${ncr.ncNumber}"/>
                <box-body>
                    <form-single name="NcrForm" transition="updateNcr" map="ncr">
                        <field name="ncId"><default-field><hidden/></default-field></field>
                        <field name="ncNumber"><default-field title="NCR #"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="ncType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="NcType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="severity"><default-field title="Severity">
                            <drop-down><option key="Critical"/><option key="Major"/><option key="Minor"/><option key="Observation"/></drop-down></default-field></field>
                        <field name="productId"><default-field title="Product"><text-line size="15"/></default-field></field>
                        <field name="batchNumber"><default-field title="Batch"><text-line size="15"/></default-field></field>
                        <field name="affectedQuantity"><default-field title="Affected Qty"><text-line size="8"/></default-field></field>
                        <field name="dispositionAction"><default-field title="Disposition">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="NcDisposition"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="4" cols="40"/></default-field></field>
                        <field name="reportedDate"><default-field title="Reported"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assigned To"><text-line size="15"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="ncr_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Resolution -->
                <container-box><box-header title="Root Cause &amp; Resolution"/>
                <box-body>
                    <form-single name="ResolveForm" transition="resolveNcr" map="ncr">
                        <field name="ncId"><default-field><hidden/></default-field></field>
                        <field name="rootCause"><default-field title="Root Cause"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="correctiveAction"><default-field title="Corrective Action"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="preventiveAction"><default-field title="Preventive Action"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="statusId"><default-field title="Update Status">
                            <drop-down><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="NonConformance"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="ncr_resolve_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>
            </row-col>

            <row-col lg="6" md="12">
                <!-- CAPA -->
                <container-box><box-header title="Corrective &amp; Preventive Actions (CAPA)"/>
                <box-toolbar>
                    <section name="qual_ncr_addcapa_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddCapaDialog" button-text="Add CAPA">
                        <form-single name="AddCapaForm" transition="createCapa">
                            <field name="ncId"><default-field><hidden/></default-field></field>
                            <field name="capaType"><default-field title="Type">
                                <drop-down><option key="Corrective" text="Corrective Action"/>
                                    <option key="Preventive" text="Preventive Action"/></drop-down></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                            <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                            <field name="statusId"><default-field><hidden default-value="CaOpen"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="CapaList" list="capaList" transition="updateCapa">
                        <field name="capaId"><default-field title="ID"><display/></default-field></field>
                        <field name="capaType"><default-field title="Type"><display/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="30"/></default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assigned"><text-line size="10"/></default-field></field>
                        <field name="dueDate"><default-field title="Due"><date-time type="date"/></default-field></field>
                        <field name="completedDate"><default-field title="Completed"><date-time type="date"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="CorrectiveAction"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="effectivenessCheck"><default-field title="Effectiveness"><text-line size="20"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="capa_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
