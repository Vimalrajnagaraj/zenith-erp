<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inspections" default-menu-index="1">

    <transition name="createInspection" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.create#Inspection"/>
        <default-response url="."/>
    </transition>
    <transition name="editInspection"><default-response url="../EditInspection"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.quality.InspectionView" list="inspectionList">
            <search-form-inputs default-order-by="-inspectionDate"/>
            <order-by field-name="-inspectionDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Quality Inspections"/>
            <box-toolbar>
                <container-dialog id="CreateInspDialog" button-text="New Inspection">
                    <form-single name="CreateInspForm" transition="createInspection">
                        <field name="inspectionType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="InspectionType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="templateId"><default-field title="Template">
                            <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}">
                                <entity-find entity-name="zenith.erp.quality.InspectionTemplate">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="referenceType"><default-field title="Reference Type">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="QcReferenceType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="referenceId"><default-field title="Reference ID"><text-line size="15"/></default-field></field>
                        <field name="productId"><default-field title="Product ID"><text-line size="15"/></default-field></field>
                        <field name="batchNumber"><default-field title="Batch/Lot No"><text-line size="15"/></default-field></field>
                        <field name="sampleSize"><default-field title="Sample Size"><text-line size="6"/></default-field></field>
                        <field name="inspectedQuantity"><default-field title="Inspected Qty"><text-line size="8"/></default-field></field>
                        <field name="remarks"><default-field title="Remarks"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="InspectionList" list="inspectionList" skip-form="true">
                    <field name="inspectionNumber"><default-field title="QC #"><display/></default-field></field>
                    <field name="inspectionType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="templateName"><default-field title="Template"><display/></default-field></field>
                    <field name="productId"><default-field title="Product"><display/></default-field></field>
                    <field name="batchNumber"><default-field title="Batch"><display/></default-field></field>
                    <field name="inspectionDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="overallResult"><default-field title="Result"><display/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editInspection" text="Detail" parameter-map="[inspectionId:inspectionId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
