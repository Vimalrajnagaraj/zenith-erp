<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="NCRs" default-menu-index="2">

    <transition name="createNcr" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.create#NonConformance"/>
        <default-response url="."/>
    </transition>
    <transition name="editNcr"><default-response url="../EditNcr"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.quality.NonConformance" list="ncrList">
            <search-form-inputs default-order-by="-reportedDate"/>
            <order-by field-name="-reportedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Non-Conformance Reports"/>
            <box-toolbar>
                <section name="qual_ncr_create_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateNcrDialog" button-text="New NCR">
                    <form-single name="CreateNcrForm" transition="createNcr">
                        <field name="ncType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="NcType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="severity"><default-field title="Severity">
                            <drop-down><option key="Critical"/><option key="Major"/><option key="Minor"/><option key="Observation"/></drop-down></default-field></field>
                        <field name="productId"><default-field title="Product ID"><text-line size="15"/></default-field></field>
                        <field name="batchNumber"><default-field title="Batch/Lot No"><text-line size="15"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="4" cols="45"/></default-field></field>
                        <field name="dispositionAction"><default-field title="Disposition">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="NcDisposition"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="affectedQuantity"><default-field title="Affected Qty"><text-line size="8"/></default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                        <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                        <field name="submitButton"><default-field title="Create NCR"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="NcrList" list="ncrList" skip-form="true">
                    <field name="ncNumber"><default-field title="NCR #"><display/></default-field></field>
                    <field name="ncType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="severity"><default-field title="Severity"><display/></default-field></field>
                    <field name="productId"><default-field title="Product"><display/></default-field></field>
                    <field name="batchNumber"><default-field title="Batch"><display/></default-field></field>
                    <field name="description"><default-field title="Description"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="reportedDate"><default-field title="Reported"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="dispositionAction"><default-field title="Disposition">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editNcr" text="Detail" parameter-map="[ncId:ncId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
