<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Templates" default-menu-index="4">

    <transition name="createTemplate" begin-transaction="true">
        <service-call name="create#zenith.erp.quality.InspectionTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate" begin-transaction="true">
        <service-call name="update#zenith.erp.quality.InspectionTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="addParam" begin-transaction="true">
        <service-call name="zenith.quality.QualityServices.add#TemplateParameter"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteParam" begin-transaction="true">
        <service-call name="delete#zenith.erp.quality.InspectionTemplateParam"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.quality.InspectionTemplate" list="templateList">
            <order-by field-name="templateName"/>
        </entity-find>
        <set field="selectedTemplateId" from="ec.web?.requestParameters?.templateId ?: (templateList ? templateList[0].templateId : null)"/>
        <entity-find entity-name="zenith.erp.quality.InspectionTemplateParam" list="templateParamList">
            <econdition field-name="templateId" from="selectedTemplateId" ignore-if-empty="true"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box>
                    <box-header title="Inspection Templates"/>
                    <box-toolbar>
                        <section name="qual_tmpl_create_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="CreateTemplateDialog" button-text="New Template">
                            <form-single name="CreateTemplateForm" transition="createTemplate">
                                <field name="templateId"><default-field title="ID"><text-line size="15"/></default-field></field>
                                <field name="templateName"><default-field title="Name"><text-line size="25"/></default-field></field>
                                <field name="inspectionType"><default-field title="Type">
                                    <drop-down><entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="InspectionType"/>
                                        </entity-find></entity-options></drop-down></default-field></field>
                                <field name="productId"><default-field title="Product (optional)"><text-line size="15"/></default-field></field>
                                <field name="description"><default-field title="Description"><text-area rows="2" cols="35"/></default-field></field>
                                <field name="isActive"><default-field title="Active">
                                    <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </box-toolbar>
                    <box-body>
                        <form-list name="TemplateList" list="templateList" transition="updateTemplate">
                            <field name="templateId"><default-field title="ID"><display/></default-field></field>
                            <field name="templateName"><default-field title="Name"><text-line size="18"/></default-field></field>
                            <field name="inspectionType"><default-field title="Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="InspectionType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton">
                                <conditional-field name="tmpl_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>

            <row-col lg="7" md="12">
                <container-box>
                    <box-header title="Template Parameters"/>
                    <box-toolbar>
                        <section name="qual_tmplparam_add_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="AddParamDialog" button-text="Add Parameter">
                            <form-single name="AddParamForm" transition="addParam">
                                <field name="templateId"><default-field title="Template ID"><text-line size="15"/></default-field></field>
                                <field name="parameterId"><default-field title="Parameter">
                                    <drop-down><entity-options key="${parameterId}" text="${parameterName} (${unit})">
                                        <entity-find entity-name="zenith.erp.quality.QualityParameter">
                                            <econdition field-name="isActive" value="Y"/>
                                            <order-by field-name="parameterName"/>
                                        </entity-find></entity-options></drop-down></default-field></field>
                                <field name="isMandatory"><default-field title="Mandatory">
                                    <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </box-toolbar>
                    <box-body>
                        <form-list name="TemplateParamList" list="templateParamList" skip-form="true">
                            <field name="parameterSeqId"><default-field title="#"><display/></default-field></field>
                            <field name="parameterId"><default-field title="Parameter">
                                <display-entity entity-name="zenith.erp.quality.QualityParameter" text="${parameterName}"/></default-field></field>
                            <field name="isMandatory"><default-field title="Mandatory"><display/></default-field></field>
                            <field name="deleteBtn">
                                <conditional-field name="tmplparam_delete_write" condition="modCanWrite" title="">
                                <link url="deleteParam" text="X"
                                      parameter-map="[templateId:templateId, parameterSeqId:parameterSeqId]"
                                      confirmation="Remove this parameter?"/></conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
