<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Quality Parameter (master) ========== -->
    <entity entity-name="QualityParameter" package="zenith.erp.quality" short-alias="QualityParameters">
        <field name="parameterId" type="id" is-pk="true"/>
        <field name="parameterName" type="text-medium"/>
        <field name="parameterGroup" type="text-short"/>
        <field name="unit" type="text-short"/>
        <field name="minValue" type="number-decimal"/>
        <field name="maxValue" type="number-decimal"/>
        <field name="targetValue" type="number-decimal"/>
        <field name="inspectionMethod" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): NULL = global shared parameter; a tenant-created parameter is stamped with its org. -->
        <field name="organizationPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="QcParamGroup" description="Quality Parameter Group"/>
            <moqui.basic.Enumeration enumId="QpgDimensional" enumTypeId="QcParamGroup" description="Dimensional" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="QpgVisual" enumTypeId="QcParamGroup" description="Visual/Appearance" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="QpgMechanical" enumTypeId="QcParamGroup" description="Mechanical" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="QpgChemical" enumTypeId="QcParamGroup" description="Chemical" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="QpgElectrical" enumTypeId="QcParamGroup" description="Electrical" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="QpgFunctional" enumTypeId="QcParamGroup" description="Functional" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="QpgPackaging" enumTypeId="QcParamGroup" description="Packaging" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="QpgMicrobiological" enumTypeId="QcParamGroup" description="Microbiological" sequenceNum="8"/>
        </seed-data>
    </entity>

    <!-- ========== Inspection Template ========== -->
    <entity entity-name="InspectionTemplate" package="zenith.erp.quality" short-alias="InspectionTemplates">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="templateName" type="text-medium"/>
        <field name="inspectionType" type="id"/>
        <field name="productId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): an inspection template is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="InspectionType" description="Quality Inspection Type"/>
            <moqui.basic.Enumeration enumId="QitIncoming" enumTypeId="InspectionType" description="Incoming Material" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="QitInProcess" enumTypeId="InspectionType" description="In-Process" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="QitFinal" enumTypeId="InspectionType" description="Final/Outgoing" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="QitRandom" enumTypeId="InspectionType" description="Random Sampling" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="QitPeriodic" enumTypeId="InspectionType" description="Periodic/Scheduled" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== Inspection Template Parameter ========== -->
    <entity entity-name="InspectionTemplateParam" package="zenith.erp.quality" short-alias="InspectionTemplateParams">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="parameterSeqId" type="id" is-pk="true"/>
        <field name="parameterId" type="id"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="isMandatory" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.quality.InspectionTemplate"/>
        <relationship type="one" related="zenith.erp.quality.QualityParameter"/>
    </entity>

    <!-- ========== Quality Inspection ========== -->
    <entity entity-name="QualityInspection" package="zenith.erp.quality" short-alias="QualityInspections">
        <field name="inspectionId" type="id" is-pk="true"/>
        <field name="inspectionNumber" type="text-short"/>
        <field name="inspectionType" type="id"/>
        <field name="templateId" type="id"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="productId" type="id"/>
        <field name="batchNumber" type="text-short"/>
        <field name="sampleSize" type="number-integer"/>
        <field name="inspectedQuantity" type="number-decimal"/>
        <field name="acceptedQuantity" type="number-decimal"/>
        <field name="rejectedQuantity" type="number-decimal"/>
        <field name="inspectionDate" type="date-time"/>
        <field name="inspectorPartyId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="overallResult" type="text-short"/>
        <field name="remarks" type="text-long"/>
        <!-- ZE-SB-013 (Tier 4): a quality inspection is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.quality.InspectionTemplate"/>
        <relationship type="one" title="QualityInspection" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="QualityInspection" description="Quality Inspection"/>
            <moqui.basic.StatusItem statusId="QiDraft" statusTypeId="QualityInspection" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="QiInProgress" statusTypeId="QualityInspection" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="QiPassed" statusTypeId="QualityInspection" description="Passed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="QiFailed" statusTypeId="QualityInspection" description="Failed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="QiPartialPass" statusTypeId="QualityInspection" description="Partial Pass" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="QiDraft" toStatusId="QiInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="QiInProgress" toStatusId="QiPassed" transitionName="Pass"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="QiInProgress" toStatusId="QiFailed" transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="QiInProgress" toStatusId="QiPartialPass" transitionName="Partial Pass"/>

            <moqui.basic.EnumerationType enumTypeId="QcReferenceType" description="Inspection Reference Type"/>
            <moqui.basic.Enumeration enumId="QrtPurchaseOrder" enumTypeId="QcReferenceType" description="Purchase Order" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="QrtWorkOrder" enumTypeId="QcReferenceType" description="Work Order" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="QrtSalesOrder" enumTypeId="QcReferenceType" description="Sales Order" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="QrtStockTransfer" enumTypeId="QcReferenceType" description="Stock Transfer" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="QrtStandalone" enumTypeId="QcReferenceType" description="Standalone" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== Inspection Reading ========== -->
    <entity entity-name="InspectionReading" package="zenith.erp.quality" short-alias="InspectionReadings">
        <field name="inspectionId" type="id" is-pk="true"/>
        <field name="readingSeqId" type="id" is-pk="true"/>
        <field name="parameterId" type="id"/>
        <field name="parameterName" type="text-medium"/>
        <field name="targetValue" type="number-decimal"/>
        <field name="minValue" type="number-decimal"/>
        <field name="maxValue" type="number-decimal"/>
        <field name="actualValue" type="number-decimal"/>
        <field name="textValue" type="text-medium"/>
        <field name="unit" type="text-short"/>
        <field name="result" type="text-short"/>
        <field name="remarks" type="text-medium"/>
        <relationship type="one" related="zenith.erp.quality.QualityInspection"/>
    </entity>

    <!-- ========== Non-Conformance Report (NCR) ========== -->
    <entity entity-name="NonConformance" package="zenith.erp.quality" short-alias="NonConformances">
        <field name="ncId" type="id" is-pk="true"/>
        <field name="ncNumber" type="text-short"/>
        <field name="inspectionId" type="id"/>
        <field name="productId" type="id"/>
        <field name="batchNumber" type="text-short"/>
        <field name="ncType" type="id"/>
        <field name="severity" type="text-short"/>
        <field name="description" type="text-very-long"/>
        <field name="rootCause" type="text-long"/>
        <field name="correctiveAction" type="text-long"/>
        <field name="preventiveAction" type="text-long"/>
        <field name="statusId" type="id"/>
        <field name="reportedDate" type="date-time"/>
        <field name="reportedByPartyId" type="id"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="dueDate" type="date"/>
        <field name="closedDate" type="date-time"/>
        <field name="dispositionAction" type="text-short"/>
        <field name="affectedQuantity" type="number-decimal"/>
        <!-- ZE-SB-013 (Tier 4): a non-conformance report is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.quality.QualityInspection"/>
        <relationship type="one" title="NonConformance" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="NonConformance" description="Non-Conformance Report"/>
            <moqui.basic.StatusItem statusId="NcOpen" statusTypeId="NonConformance" description="Open" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="NcUnderReview" statusTypeId="NonConformance" description="Under Review" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="NcActionTaken" statusTypeId="NonConformance" description="Action Taken" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="NcVerified" statusTypeId="NonConformance" description="Verified" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="NcClosed" statusTypeId="NonConformance" description="Closed" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="NcOpen" toStatusId="NcUnderReview" transitionName="Review"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="NcUnderReview" toStatusId="NcActionTaken" transitionName="Record Action"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="NcActionTaken" toStatusId="NcVerified" transitionName="Verify"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="NcVerified" toStatusId="NcClosed" transitionName="Close"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="NcOpen" toStatusId="NcClosed" transitionName="Close (No Action)"/>

            <moqui.basic.EnumerationType enumTypeId="NcType" description="Non-Conformance Type"/>
            <moqui.basic.Enumeration enumId="NctMaterial" enumTypeId="NcType" description="Raw Material" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NctProcess" enumTypeId="NcType" description="Process" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NctProduct" enumTypeId="NcType" description="Finished Product" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NctSupplier" enumTypeId="NcType" description="Supplier" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="NctCustomer" enumTypeId="NcType" description="Customer Complaint" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="NctEquipment" enumTypeId="NcType" description="Equipment" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="NcDisposition" description="NCR Disposition Action"/>
            <moqui.basic.Enumeration enumId="NcdUseAsIs" enumTypeId="NcDisposition" description="Use As-Is" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NcdRework" enumTypeId="NcDisposition" description="Rework" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NcdRepair" enumTypeId="NcDisposition" description="Repair" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NcdScrap" enumTypeId="NcDisposition" description="Scrap" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="NcdReturn" enumTypeId="NcDisposition" description="Return to Supplier" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="NcdDowngrade" enumTypeId="NcDisposition" description="Downgrade" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== CAPA (Corrective & Preventive Action) ========== -->
    <entity entity-name="CorrectiveAction" package="zenith.erp.quality" short-alias="CorrectiveActions">
        <field name="capaId" type="id" is-pk="true"/>
        <field name="ncId" type="id"/>
        <field name="capaType" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="dueDate" type="date"/>
        <field name="completedDate" type="date"/>
        <field name="statusId" type="id"/>
        <field name="verifiedByPartyId" type="id"/>
        <field name="verifiedDate" type="date"/>
        <field name="effectivenessCheck" type="text-long"/>
        <relationship type="one" related="zenith.erp.quality.NonConformance"/>
        <relationship type="one" title="CorrectiveAction" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="CorrectiveAction" description="CAPA Status"/>
            <moqui.basic.StatusItem statusId="CaOpen" statusTypeId="CorrectiveAction" description="Open" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="CaInProgress" statusTypeId="CorrectiveAction" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="CaCompleted" statusTypeId="CorrectiveAction" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="CaVerified" statusTypeId="CorrectiveAction" description="Verified" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CaOpen" toStatusId="CaInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CaInProgress" toStatusId="CaCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CaCompleted" toStatusId="CaVerified" transitionName="Verify"/>
        </seed-data>
    </entity>

    <!-- ========== Quality Certificate (BIS/FSSAI/ISO) ========== -->
    <entity entity-name="QualityCertificate" package="zenith.erp.quality" short-alias="QualityCertificates">
        <field name="certificateId" type="id" is-pk="true"/>
        <field name="certificateType" type="id"/>
        <field name="certificateNumber" type="text-medium"/>
        <field name="issuingBody" type="text-medium"/>
        <field name="issueDate" type="date"/>
        <field name="expiryDate" type="date"/>
        <field name="scope" type="text-long"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="remarks" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): a quality certificate is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="QcCertType" description="Quality Certificate Type"/>
            <moqui.basic.Enumeration enumId="QctBis" enumTypeId="QcCertType" description="BIS (Bureau of Indian Standards)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="QctFssai" enumTypeId="QcCertType" description="FSSAI (Food Safety)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="QctIso9001" enumTypeId="QcCertType" description="ISO 9001 (Quality Management)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="QctIso14001" enumTypeId="QcCertType" description="ISO 14001 (Environmental)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="QctIso22000" enumTypeId="QcCertType" description="ISO 22000 (Food Safety Mgmt)" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="QctIso45001" enumTypeId="QcCertType" description="ISO 45001 (Occupational H&amp;S)" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="QctHaccp" enumTypeId="QcCertType" description="HACCP (Hazard Analysis)" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="QctGmp" enumTypeId="QcCertType" description="GMP (Good Manufacturing Practice)" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="QctNabl" enumTypeId="QcCertType" description="NABL (Lab Accreditation)" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="QctAgmark" enumTypeId="QcCertType" description="AGMARK (Agricultural Produce)" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="QctHallmark" enumTypeId="QcCertType" description="BIS Hallmark (Gold/Silver)" sequenceNum="11"/>
            <moqui.basic.Enumeration enumId="QctCe" enumTypeId="QcCertType" description="CE Marking (Export)" sequenceNum="12"/>
            <moqui.basic.Enumeration enumId="QctCustom" enumTypeId="QcCertType" description="Custom/Other" sequenceNum="13"/>
        </seed-data>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="InspectionView" package="zenith.erp.quality">
        <member-entity entity-alias="QI" entity-name="zenith.erp.quality.QualityInspection"/>
        <member-entity entity-alias="IT" entity-name="zenith.erp.quality.InspectionTemplate" join-from-alias="QI" join-optional="true">
            <key-map field-name="templateId"/></member-entity>
        <alias-all entity-alias="QI"/>
        <alias entity-alias="IT" name="templateName"/>
    </view-entity>
</entities>
