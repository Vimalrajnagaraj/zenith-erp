<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Leave Type -->
    <entity entity-name="LeaveType" package="zenith.erp.timeoff" short-alias="LeaveTypes">
        <field name="leaveTypeId" type="id" is-pk="true"/>
        <field name="leaveTypeName" type="text-medium"/>
        <field name="leaveCode" type="text-short"/>
        <field name="description" type="text-medium"/>
        <field name="annualEntitlement" type="number-decimal"/>
        <field name="maxAccumulation" type="number-decimal"/>
        <field name="carryForwardLimit" type="number-decimal"/>
        <field name="encashmentAllowed" type="text-indicator" default="'N'"/>
        <field name="maxEncashmentDays" type="number-decimal"/>
        <field name="isPaid" type="text-indicator" default="'Y'"/>
        <field name="requiresDocument" type="text-indicator" default="'N'"/>
        <field name="minDaysBeforeApply" type="number-integer" default="0"/>
        <field name="maxConsecutiveDays" type="number-integer"/>
        <field name="applicableGender" type="text-short"/>
        <field name="minServiceMonths" type="number-integer" default="0"/>
        <field name="accrualFrequency" type="id"/>
        <field name="negativeBalanceAllowed" type="text-indicator" default="'N'"/>
        <field name="halfDayAllowed" type="text-indicator" default="'Y'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AccrualFrequency" description="Leave Accrual Frequency"/>
            <moqui.basic.Enumeration enumId="Accr_ANNUAL" enumTypeId="AccrualFrequency" description="Annual (credited at start of year)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="Accr_MONTHLY" enumTypeId="AccrualFrequency" description="Monthly (accrued per month)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="Accr_QUARTERLY" enumTypeId="AccrualFrequency" description="Quarterly" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- Leave Policy (links leave types to groups/departments) -->
    <entity entity-name="LeavePolicy" package="zenith.erp.timeoff" short-alias="LeavePolicies">
        <field name="policyId" type="id" is-pk="true"/>
        <field name="policyName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="financialYearStart" type="text-short" default="'April'"/>
        <field name="probationLeaveAllowed" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- Policy-LeaveType mapping with overrides -->
    <entity entity-name="LeavePolicyType" package="zenith.erp.timeoff" short-alias="LeavePolicyTypes">
        <field name="policyId" type="id" is-pk="true"/>
        <field name="leaveTypeId" type="id" is-pk="true"/>
        <field name="entitlementOverride" type="number-decimal"/>
        <field name="carryForwardOverride" type="number-decimal"/>
        <relationship type="one" related="zenith.erp.timeoff.LeavePolicy"/>
        <relationship type="one" related="zenith.erp.timeoff.LeaveType"/>
    </entity>

    <!-- Employee Leave Balance -->
    <entity entity-name="LeaveBalance" package="zenith.erp.timeoff" short-alias="LeaveBalances">
        <field name="balanceId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="leaveTypeId" type="id"/>
        <field name="financialYear" type="text-short"/>
        <field name="openingBalance" type="number-decimal" default="0"/>
        <field name="entitlement" type="number-decimal" default="0"/>
        <field name="taken" type="number-decimal" default="0"/>
        <field name="adjustment" type="number-decimal" default="0"/>
        <field name="encashed" type="number-decimal" default="0"/>
        <field name="lapsed" type="number-decimal" default="0"/>
        <field name="closingBalance" type="number-decimal" default="0"/>
        <relationship type="one" related="zenith.erp.timeoff.LeaveType"/>
    </entity>

    <!-- Leave Application -->
    <entity entity-name="LeaveApplication" package="zenith.erp.timeoff" table-name="ZENITH_TIMEOFF_LEAVE_APP" short-alias="LeaveApplications">
        <field name="applicationId" type="id" is-pk="true"/>
        <field name="applicationNumber" type="text-short"/>
        <field name="employeePartyId" type="id"/>
        <field name="leaveTypeId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="toDate" type="date-time"/>
        <field name="totalDays" type="number-decimal"/>
        <field name="isHalfDay" type="text-indicator" default="'N'"/>
        <field name="halfDayDate" type="date-time"/>
        <field name="halfDaySession" type="id"/>
        <field name="reason" type="text-long"/>
        <field name="contactDuringLeave" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="appliedDate" type="date-time"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="approvedDate" type="date-time"/>
        <field name="rejectionReason" type="text-medium"/>
        <field name="cancelReason" type="text-medium"/>
        <field name="documentFileName" type="text-medium"/>
        <relationship type="one" related="zenith.erp.timeoff.LeaveType"/>
        <relationship type="one" title="LeaveApplication" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="LeaveApplication" description="Leave Application"/>
            <moqui.basic.StatusItem statusId="LvDraft" statusTypeId="LeaveApplication" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="LvApplied" statusTypeId="LeaveApplication" description="Applied" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="LvApproved" statusTypeId="LeaveApplication" description="Approved" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="LvRejected" statusTypeId="LeaveApplication" description="Rejected" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="LvCancelled" statusTypeId="LeaveApplication" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="LvCancelReq" statusTypeId="LeaveApplication" description="Cancellation Requested" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvDraft" toStatusId="LvApplied" transitionName="Apply"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvApplied" toStatusId="LvApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvApplied" toStatusId="LvRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvApproved" toStatusId="LvCancelReq" transitionName="Request Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvCancelReq" toStatusId="LvCancelled" transitionName="Confirm Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvCancelReq" toStatusId="LvApproved" transitionName="Deny Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvDraft" toStatusId="LvCancelled" transitionName="Discard"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LvRejected" toStatusId="LvDraft" transitionName="Revise"/>

            <moqui.basic.EnumerationType enumTypeId="HalfDaySession" description="Half Day Session"/>
            <moqui.basic.Enumeration enumId="HdSes_FIRST" enumTypeId="HalfDaySession" description="First Half (Morning)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="HdSes_SECOND" enumTypeId="HalfDaySession" description="Second Half (Afternoon)" sequenceNum="2"/>
        </seed-data>
    </entity>

    <!-- Comp Off Record -->
    <entity entity-name="CompOffRecord" package="zenith.erp.timeoff" short-alias="CompOffRecords">
        <field name="compOffId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="workedDate" type="date-time"/>
        <field name="reason" type="text-medium"/>
        <field name="expiryDate" type="date-time"/>
        <field name="isUsed" type="text-indicator" default="'N'"/>
        <field name="usedOnDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="approvedByPartyId" type="id"/>
        <relationship type="one" title="CompOffRecord" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="CompOffRecord" description="Comp Off Record"/>
            <moqui.basic.StatusItem statusId="CoPending" statusTypeId="CompOffRecord" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="CoApproved" statusTypeId="CompOffRecord" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="CoRejected" statusTypeId="CompOffRecord" description="Rejected" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="CoUsed" statusTypeId="CompOffRecord" description="Used" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="CoExpired" statusTypeId="CompOffRecord" description="Expired" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CoPending" toStatusId="CoApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CoPending" toStatusId="CoRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CoApproved" toStatusId="CoUsed" transitionName="Use"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CoApproved" toStatusId="CoExpired" transitionName="Expire"/>
        </seed-data>
    </entity>

    <!-- Leave Encashment -->
    <entity entity-name="LeaveEncashment" package="zenith.erp.timeoff" short-alias="LeaveEncashments">
        <field name="encashmentId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="leaveTypeId" type="id"/>
        <field name="financialYear" type="text-short"/>
        <field name="daysEncashed" type="number-decimal"/>
        <field name="dailyRate" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="encashmentDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.timeoff.LeaveType"/>
    </entity>

    <!-- View -->
    <view-entity entity-name="LeaveApplicationView" package="zenith.erp.timeoff">
        <member-entity entity-alias="LA" entity-name="zenith.erp.timeoff.LeaveApplication"/>
        <member-entity entity-alias="LT" entity-name="zenith.erp.timeoff.LeaveType" join-from-alias="LA">
            <key-map field-name="leaveTypeId"/></member-entity>
        <alias-all entity-alias="LA"/>
        <alias entity-alias="LT" name="leaveTypeName"/>
        <alias entity-alias="LT" name="leaveCode"/>
        <alias entity-alias="LT" name="isPaid"/>
    </view-entity>
</entities>
