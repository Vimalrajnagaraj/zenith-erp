<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Balances" default-menu-index="4">

    <transition name="initBalance" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.initialize#LeaveBalance"/>
        <default-response url="."/>
    </transition>
    <transition name="updateBalance" begin-transaction="true">
        <service-call name="update#zenith.erp.timeoff.LeaveBalance"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="now" from="ec.user.nowTimestamp"/>
        <set field="cal" from="java.util.Calendar.getInstance()"/>
        <script>cal.setTime(now)</script>
        <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="month &gt;= 4 ? year : year - 1"/>
        <set field="currentFy" from="String.format('%04d-%02d', fyStart, (fyStart + 1) % 100)"/>

        <entity-find entity-name="zenith.erp.timeoff.LeaveBalance" list="balanceList">
            <search-form-inputs default-order-by="employeePartyId,leaveTypeId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Initialize Leave Balances"/>
            <box-toolbar>
                <container-dialog id="InitBalDialog" button-text="Initialize Balance">
                    <form-single name="InitBalForm" transition="initBalance">
                        <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="financialYear"><default-field title="Financial Year"><text-line size="10" default-value="${currentFy}"/></default-field></field>
                        <field name="policyId"><default-field title="Leave Policy"><drop-down>
                            <entity-options key="${policyId}" text="${policyName}">
                                <entity-find entity-name="zenith.erp.timeoff.LeavePolicy">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Initialize"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="BalanceListForm" list="balanceList" transition="updateBalance" header-dialog="true">
                    <field name="balanceId"><default-field><hidden/></default-field></field>
                    <field name="employeePartyId"><header-field title="Employee"><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="Employee"><display/></default-field></field>
                    <field name="leaveTypeId"><header-field title="Leave Type"><drop-down allow-empty="true">
                            <entity-options key="${leaveTypeId}" text="${leaveTypeName}">
                                <entity-find entity-name="zenith.erp.timeoff.LeaveType">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options></drop-down></header-field>
                        <default-field title="Leave Type">
                            <display-entity entity-name="zenith.erp.timeoff.LeaveType" text="${leaveTypeName} (${leaveCode})"/>
                        </default-field>
                    </field>
                    <field name="financialYear"><header-field><text-find size="10" hide-options="true"/></header-field>
                        <default-field title="FY"><display/></default-field></field>
                    <field name="openingBalance"><default-field title="Opening"><display format="0.#"/></default-field></field>
                    <field name="entitlement"><default-field title="Entitled"><display format="0.#"/></default-field></field>
                    <field name="taken"><default-field title="Taken"><display format="0.#"/></default-field></field>
                    <field name="adjustment"><default-field title="Adjust"><text-line size="4"/></default-field></field>
                    <field name="encashed"><default-field title="Encashed"><display format="0.#"/></default-field></field>
                    <field name="lapsed"><default-field title="Lapsed"><text-line size="4"/></default-field></field>
                    <field name="closingBalance"><default-field title="Closing"><display format="0.#"/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
