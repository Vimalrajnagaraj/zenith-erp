<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Leave Types" default-menu-index="5">

    <transition name="createLeaveType" begin-transaction="true">
        <service-call name="create#zenith.erp.timeoff.LeaveType"/>
        <default-response url="."/>
    </transition>
    <transition name="updateLeaveType" begin-transaction="true">
        <service-call name="update#zenith.erp.timeoff.LeaveType"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timeoff.LeaveType" list="leaveTypes">
            <order-by field-name="leaveTypeName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Leave Types"/>
            <box-toolbar>
                <container-dialog id="CreateLtDialog" button-text="New Leave Type">
                    <form-single name="CreateLtForm" transition="createLeaveType">
                        <field name="leaveTypeName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="leaveCode"><default-field title="Code"><text-line size="5"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="annualEntitlement"><default-field title="Annual Entitlement"><text-line size="5"/></default-field></field>
                        <field name="maxAccumulation"><default-field title="Max Accumulation"><text-line size="5"/></default-field></field>
                        <field name="carryForwardLimit"><default-field title="Carry Forward Limit"><text-line size="5"/></default-field></field>
                        <field name="encashmentAllowed"><default-field title="Encashment"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                        <field name="maxEncashmentDays"><default-field title="Max Encashment Days"><text-line size="5"/></default-field></field>
                        <field name="isPaid"><default-field title="Paid Leave"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="requiresDocument"><default-field title="Requires Document"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                        <field name="minDaysBeforeApply"><default-field title="Min Days Before Apply"><text-line size="4" default-value="0"/></default-field></field>
                        <field name="maxConsecutiveDays"><default-field title="Max Consecutive Days"><text-line size="4"/></default-field></field>
                        <field name="applicableGender"><default-field title="Gender"><drop-down allow-empty="true">
                            <option key="Male" text="Male Only"/><option key="Female" text="Female Only"/>
                        </drop-down></default-field></field>
                        <field name="minServiceMonths"><default-field title="Min Service Months"><text-line size="4" default-value="0"/></default-field></field>
                        <field name="accrualFrequency"><default-field title="Accrual"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="AccrualFrequency"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="negativeBalanceAllowed"><default-field title="Negative Balance"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                        <field name="halfDayAllowed"><default-field title="Half Day"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="LeaveTypeList" list="leaveTypes" transition="updateLeaveType">
                    <field name="leaveTypeId"><default-field><hidden/></default-field></field>
                    <field name="leaveTypeName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="leaveCode"><default-field title="Code"><display/></default-field></field>
                    <field name="annualEntitlement"><default-field title="Entitlement"><text-line size="4"/></default-field></field>
                    <field name="carryForwardLimit"><default-field title="Carry Fwd"><text-line size="4"/></default-field></field>
                    <field name="encashmentAllowed"><default-field title="Encash"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                    <field name="isPaid"><default-field title="Paid"><display/></default-field></field>
                    <field name="halfDayAllowed"><default-field title="Half Day"><display/></default-field></field>
                    <field name="negativeBalanceAllowed"><default-field title="Negative"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
