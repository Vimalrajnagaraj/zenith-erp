<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Policies" default-menu-index="6">

    <transition name="createPolicy" begin-transaction="true">
        <service-call name="create#zenith.erp.timeoff.LeavePolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicy" begin-transaction="true">
        <service-call name="update#zenith.erp.timeoff.LeavePolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="createPolicyType" begin-transaction="true">
        <service-call name="create#zenith.erp.timeoff.LeavePolicyType"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicyType" begin-transaction="true">
        <service-call name="update#zenith.erp.timeoff.LeavePolicyType"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timeoff.LeavePolicy" list="policies">
            <order-by field-name="policyName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.timeoff.LeavePolicyType" list="policyTypes">
            <order-by field-name="policyId,leaveTypeId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5">
                <container-box>
                    <box-header title="Leave Policies"/>
                    <box-toolbar>
                        <container-dialog id="CreatePolicyDialog" button-text="New Policy">
                            <form-single name="CreatePolicyForm" transition="createPolicy">
                                <field name="policyName"><default-field title="Name"><text-line size="25"/></default-field></field>
                                <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                                <field name="financialYearStart"><default-field title="FY Start"><drop-down>
                                    <option key="April" text="April"/><option key="January" text="January"/>
                                </drop-down></default-field></field>
                                <field name="probationLeaveAllowed"><default-field title="Probation Leave"><drop-down>
                                    <option key="N" text="No"/><option key="Y" text="Yes"/>
                                </drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="PolicyList" list="policies" transition="updatePolicy">
                            <field name="policyId"><default-field><hidden/></default-field></field>
                            <field name="policyName"><default-field title="Name"><text-line size="15"/></default-field></field>
                            <field name="financialYearStart"><default-field title="FY Start"><display/></default-field></field>
                            <field name="probationLeaveAllowed"><default-field title="Probation"><display/></default-field></field>
                            <field name="isActive"><default-field title="Active"><drop-down>
                                <option key="Y" text="Yes"/><option key="N" text="No"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="7">
                <container-box>
                    <box-header title="Policy — Leave Type Mappings"/>
                    <box-toolbar>
                        <container-dialog id="CreatePtDialog" button-text="Add Leave Type to Policy">
                            <form-single name="CreatePtForm" transition="createPolicyType">
                                <field name="policyId"><default-field title="Policy"><drop-down>
                                    <entity-options key="${policyId}" text="${policyName}">
                                        <entity-find entity-name="zenith.erp.timeoff.LeavePolicy">
                                            <econdition field-name="isActive" value="Y"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="leaveTypeId"><default-field title="Leave Type"><drop-down>
                                    <entity-options key="${leaveTypeId}" text="${leaveTypeName} (${leaveCode})">
                                        <entity-find entity-name="zenith.erp.timeoff.LeaveType">
                                            <econdition field-name="isActive" value="Y"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="entitlementOverride"><default-field title="Entitlement Override"><text-line size="5"/></default-field></field>
                                <field name="carryForwardOverride"><default-field title="Carry Forward Override"><text-line size="5"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="PolicyTypeList" list="policyTypes" transition="updatePolicyType">
                            <field name="policyId"><default-field title="Policy">
                                <display-entity entity-name="zenith.erp.timeoff.LeavePolicy" text="${policyName}"/>
                            </default-field></field>
                            <field name="leaveTypeId"><default-field title="Leave Type">
                                <display-entity entity-name="zenith.erp.timeoff.LeaveType" text="${leaveTypeName} (${leaveCode})"/>
                            </default-field></field>
                            <field name="entitlementOverride"><default-field title="Entitlement Override"><text-line size="5"/></default-field></field>
                            <field name="carryForwardOverride"><default-field title="Carry Fwd Override"><text-line size="5"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
