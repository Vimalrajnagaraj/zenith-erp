<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Leave Detail" default-menu-index="3" default-menu-include="false">

    <parameter name="applicationId" required="true"/>

    <transition name="approveLeave" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.approve#Leave"/>
        <default-response url="."/>
    </transition>
    <transition name="rejectLeave" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.reject#Leave"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelLeave" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.cancel#Leave"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.timeoff.LeaveApplication" value-field="app"/>
        <entity-find-one entity-name="zenith.erp.timeoff.LeaveType" value-field="leaveType">
            <field-map field-name="leaveTypeId" from="app.leaveTypeId"/>
        </entity-find-one>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box>
                    <box-header title="Leave Application — ${app.applicationNumber}"/>
                    <box-body>
                        <form-single name="LeaveDetailForm" map="app">
                            <field name="applicationId"><default-field><hidden/></default-field></field>
                            <field name="applicationNumber"><default-field title="Application #"><display/></default-field></field>
                            <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                            <field name="leaveTypeId"><default-field title="Leave Type">
                                <display-entity entity-name="zenith.erp.timeoff.LeaveType" text="${leaveTypeName} (${leaveCode})"/>
                            </default-field></field>
                            <field name="fromDate"><default-field title="From Date"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="toDate"><default-field title="To Date"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="totalDays"><default-field title="Total Days"><display format="0.#"/></default-field></field>
                            <field name="isHalfDay"><default-field title="Half Day"><display/></default-field></field>
                            <field name="halfDaySession"><default-field title="Session">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="reason"><default-field title="Reason"><display/></default-field></field>
                            <field name="contactDuringLeave"><default-field title="Contact"><display/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/>
                            </default-field></field>
                            <field name="appliedDate"><default-field title="Applied Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                            <field name="approvedByPartyId"><default-field title="Approved By"><display/></default-field></field>
                            <field name="approvedDate"><default-field title="Approved Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                            <field name="rejectionReason"><default-field title="Rejection Reason"><display/></default-field></field>
                            <field name="cancelReason"><default-field title="Cancel Reason"><display/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6">
                <container-box>
                    <box-header title="Actions"/>
                    <box-body>
                        <section name="ApproveSection" condition="app.statusId == 'LvApplied'">
                            <widgets>
                                <form-single name="ApproveForm" transition="approveLeave">
                                    <field name="applicationId"><default-field><hidden/></default-field></field>
                                    <field name="submitButton"><default-field title="Approve Leave"><submit type="success"/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>

                        <section name="RejectSection" condition="app.statusId == 'LvApplied'">
                            <widgets>
                                <container-dialog id="RejectDialog" button-text="Reject Leave">
                                    <form-single name="RejectForm" transition="rejectLeave">
                                        <field name="applicationId"><default-field><hidden/></default-field></field>
                                        <field name="rejectionReason"><default-field title="Reason for Rejection"><text-area rows="3" cols="40"/></default-field></field>
                                        <field name="submitButton"><default-field title="Reject"><submit type="danger"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>

                        <section name="CancelSection" condition="app.statusId == 'LvApplied' || app.statusId == 'LvApproved' || app.statusId == 'LvCancelReq'">
                            <widgets>
                                <container-dialog id="CancelDialog" button-text="Cancel Leave">
                                    <form-single name="CancelForm" transition="cancelLeave">
                                        <field name="applicationId"><default-field><hidden/></default-field></field>
                                        <field name="cancelReason"><default-field title="Reason for Cancellation"><text-area rows="3" cols="40"/></default-field></field>
                                        <field name="submitButton"><default-field title="Cancel Leave"><submit type="danger"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>

                        <section name="NoActionsSection" condition="app.statusId == 'LvRejected' || app.statusId == 'LvCancelled'">
                            <widgets><label text="No actions available for this application." type="p"/></widgets>
                        </section>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Leave Type Details"/>
                    <box-body>
                        <form-single name="LeaveTypeInfo" map="leaveType">
                            <field name="leaveTypeName"><default-field title="Type"><display/></default-field></field>
                            <field name="annualEntitlement"><default-field title="Annual Entitlement"><display format="0.#"/></default-field></field>
                            <field name="carryForwardLimit"><default-field title="Carry Forward Limit"><display format="0.#"/></default-field></field>
                            <field name="maxConsecutiveDays"><default-field title="Max Consecutive Days"><display/></default-field></field>
                            <field name="encashmentAllowed"><default-field title="Encashment"><display/></default-field></field>
                            <field name="isPaid"><default-field title="Paid Leave"><display/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
