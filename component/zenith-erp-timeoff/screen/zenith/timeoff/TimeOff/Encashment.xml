<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Encashment" default-menu-index="8">

    <transition name="encashLeave" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.encash#Leave"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timeoff.LeaveEncashment" list="encashments">
            <order-by field-name="-encashmentDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Leave Encashment"/>
            <box-toolbar>
                <container-dialog id="EncashDialog" button-text="Encash Leave">
                    <form-single name="EncashForm" transition="encashLeave">
                        <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="leaveTypeId"><default-field title="Leave Type"><drop-down>
                            <entity-options key="${leaveTypeId}" text="${leaveTypeName} (${leaveCode})">
                                <entity-find entity-name="zenith.erp.timeoff.LeaveType">
                                    <econdition field-name="encashmentAllowed" value="Y"/>
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="daysToEncash"><default-field title="Days to Encash"><text-line size="5"/></default-field></field>
                        <field name="dailyRate"><default-field title="Daily Rate (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="submitButton"><default-field title="Encash"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="EncashmentList" list="encashments" skip-form="true">
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="leaveTypeId"><default-field title="Leave Type">
                        <display-entity entity-name="zenith.erp.timeoff.LeaveType" text="${leaveTypeName}"/>
                    </default-field></field>
                    <field name="financialYear"><default-field title="FY"><display/></default-field></field>
                    <field name="daysEncashed"><default-field title="Days"><display format="0.#"/></default-field></field>
                    <field name="dailyRate"><default-field title="Rate"><display format="#,##0.00"/></default-field></field>
                    <field name="totalAmount"><default-field title="Amount (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="encashmentDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/>
                    </default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
