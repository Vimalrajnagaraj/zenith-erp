<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Leaves" default-menu-index="1">

    <transition name="applyLeave" begin-transaction="true">
        <service-call name="zenith.timeoff.TimeOffServices.apply#Leave"/>
        <default-response url="."/>
    </transition>
    <transition name="editLeave"><default-response url="../EditLeave"/></transition>

    <actions>
        <set field="empId" from="ec.user.userAccount?.partyId"/>

        <!-- Current FY -->
        <set field="now" from="ec.user.nowTimestamp"/>
        <set field="cal" from="java.util.Calendar.getInstance()"/>
        <script>cal.setTime(now)</script>
        <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="month &gt;= 4 ? year : year - 1"/>
        <set field="currentFy" from="String.format('%04d-%02d', fyStart, (fyStart + 1) % 100)"/>

        <!-- My balances -->
        <entity-find entity-name="zenith.erp.timeoff.LeaveBalance" list="balanceList">
            <econdition field-name="employeePartyId" from="empId"/>
            <econdition field-name="financialYear" from="currentFy"/>
        </entity-find>

        <!-- My applications -->
        <entity-find entity-name="zenith.erp.timeoff.LeaveApplicationView" list="myLeaves">
            <econdition field-name="employeePartyId" from="empId"/>
            <order-by field-name="-appliedDate"/>
        </entity-find>

        <!-- Leave types for dropdown -->
        <entity-find entity-name="zenith.erp.timeoff.LeaveType" list="leaveTypes">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="leaveTypeName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box>
                    <box-header title="Leave Balances — FY ${currentFy}"/>
                    <box-body>
                        <form-list name="BalanceList" list="balanceList" skip-form="true">
                            <field name="leaveTypeId"><default-field title="Leave Type">
                                <display-entity entity-name="zenith.erp.timeoff.LeaveType" text="${leaveTypeName} (${leaveCode})"/>
                            </default-field></field>
                            <field name="entitlement"><default-field title="Entitled"><display format="0.#"/></default-field></field>
                            <field name="openingBalance"><default-field title="Carried"><display format="0.#"/></default-field></field>
                            <field name="taken"><default-field title="Taken"><display format="0.#"/></default-field></field>
                            <field name="closingBalance"><default-field title="Available"><display format="0.#"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6">
                <container-box>
                    <box-header title="Apply for Leave"/>
                    <box-body>
                        <form-single name="ApplyLeaveForm" transition="applyLeave">
                            <field name="leaveTypeId"><default-field title="Leave Type"><drop-down>
                                <list-options list="leaveTypes" key="${leaveTypeId}" text="${leaveTypeName} (${leaveCode})"/>
                            </drop-down></default-field></field>
                            <field name="fromDate"><default-field title="From Date"><date-time type="date"/></default-field></field>
                            <field name="toDate"><default-field title="To Date"><date-time type="date"/></default-field></field>
                            <field name="isHalfDay"><default-field title="Half Day"><drop-down>
                                <option key="N" text="No"/>
                                <option key="Y" text="Yes"/>
                            </drop-down></default-field></field>
                            <field name="halfDayDate"><default-field title="Half Day Date"><date-time type="date"/></default-field></field>
                            <field name="halfDaySession"><default-field title="Session"><drop-down allow-empty="true">
                                <option key="HdSes_FIRST" text="First Half (Morning)"/>
                                <option key="HdSes_SECOND" text="Second Half (Afternoon)"/>
                            </drop-down></default-field></field>
                            <field name="reason"><default-field title="Reason"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="contactDuringLeave"><default-field title="Contact During Leave"><text-line size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Apply"><submit/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>

        <container-box>
            <box-header title="My Leave Applications"/>
            <box-body>
                <form-list name="MyLeaveList" list="myLeaves" skip-form="true">
                    <field name="applicationNumber"><default-field title="Application #">
                        <link url="editLeave" text="${applicationNumber}" link-type="anchor">
                            <parameter name="applicationId"/>
                        </link>
                    </default-field></field>
                    <field name="leaveTypeName"><default-field title="Type"><display/></default-field></field>
                    <field name="fromDate"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="toDate"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="totalDays"><default-field title="Days"><display format="0.#"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/>
                    </default-field></field>
                    <field name="appliedDate"><default-field title="Applied"><display format="dd-MM-yyyy"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
