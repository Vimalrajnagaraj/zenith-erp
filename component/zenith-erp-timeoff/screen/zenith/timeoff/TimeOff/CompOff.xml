<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Comp Off" default-menu-index="7">

    <transition name="createCompOff" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 5): only bank comp-off for an employee of your own org. -->
            <if condition="employeePartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ea" in-map="[partyId:employeePartyId]"/>
                <if condition="!_ea.allowed"><return error="true" message="That employee isn't part of your organization."/></if>
            </if>
            <service-call name="create#zenith.erp.timeoff.CompOffRecord" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateCompOff" begin-transaction="true">
        <service-call name="update#zenith.erp.timeoff.CompOffRecord"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.timeoff.CompOffRecord" list="compOffList">
            <order-by field-name="-workedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Compensatory Off Records"/>
            <box-toolbar>
                <container-dialog id="CreateCoDialog" button-text="Request Comp Off">
                    <form-single name="CreateCoForm" transition="createCompOff">
                        <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="workedDate"><default-field title="Worked On Date"><date-time type="date"/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date"/></default-field></field>
                        <field name="statusId"><default-field><hidden default-value="CoPending"/></default-field></field>
                        <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="CompOffListForm" list="compOffList" transition="updateCompOff">
                    <field name="compOffId"><default-field><hidden/></default-field></field>
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="workedDate"><default-field title="Worked Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                    <field name="expiryDate"><default-field title="Expires"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="isUsed"><default-field title="Used"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down><entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="CompOffRecord"/>
                            </entity-find>
                        </entity-options></drop-down>
                    </default-field></field>
                    <field name="approvedByPartyId"><default-field title="Approved By"><display/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
