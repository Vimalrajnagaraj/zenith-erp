<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Leaves" default-menu-index="2">

    <transition name="editLeave"><default-response url="../EditLeave"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.timeoff.LeaveApplicationView" list="allLeaves">
            <search-form-inputs default-order-by="-appliedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Leave Applications"/>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search All Leaves..." style="display:none"></span>]]></text></render-mode>
            <form-list name="AllLeaveList" list="allLeaves" skip-form="true" header-dialog="true">
                    <field name="applicationNumber"><header-field show-order-by="true"/>
                        <default-field title="Application #">
                            <link url="editLeave" text="${applicationNumber}" link-type="anchor">
                                <parameter name="applicationId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="employeePartyId"><header-field title="Employee" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="Employee"><display/></default-field></field>
                    <field name="leaveTypeName"><default-field title="Type"><display/></default-field></field>
                    <field name="fromDate"><header-field show-order-by="true"/>
                        <default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="toDate"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="totalDays"><default-field title="Days"><display format="0.#"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="LeaveApplication"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field>
                    </field>
                    <field name="appliedDate"><header-field show-order-by="true"/>
                        <default-field title="Applied"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
