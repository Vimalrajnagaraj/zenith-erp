<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Time Off" default-menu-index="22">

    <always-actions>
        <set field="html_title" value="Time Off"/>
    </always-actions>

    <subscreens default-item="MyLeaves"/>

    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goPayroll"><default-response url="../payroll/PayrollRuns"/></transition>
    <transition name="goAttendance"><default-response url="../attendance/AllAttendance"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_hr_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('hr'))"><widgets><link url="goHr" text="HR" icon="fa fa-users" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_payroll_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('payroll'))"><widgets><link url="goPayroll" text="Payroll" icon="fa fa-money" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_attendance_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('attendance'))"><widgets><link url="goAttendance" text="Attendance" icon="fa fa-calendar-check-o" btn-type="warning" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
