<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="init" noun="Sequences">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
        </in-parameters>
        <actions>
            <set field="sequences" from="[
                [sequenceType:'INVOICE', prefix:'INV/', padLength:5],
                [sequenceType:'SALES_ORDER', prefix:'SO/', padLength:5],
                [sequenceType:'PURCHASE_ORDER', prefix:'PO/', padLength:5],
                [sequenceType:'QUOTATION', prefix:'QTN/', padLength:5],
                [sequenceType:'CREDIT_NOTE', prefix:'CN/', padLength:5],
                [sequenceType:'DEBIT_NOTE', prefix:'DN/', padLength:5],
                [sequenceType:'DELIVERY_CHALLAN', prefix:'DC/', padLength:5],
                [sequenceType:'PAYMENT_RECEIPT', prefix:'RCT/', padLength:5],
                [sequenceType:'PAYMENT_VOUCHER', prefix:'PV/', padLength:5],
                [sequenceType:'JOURNAL_ENTRY', prefix:'JV/', padLength:5],
                [sequenceType:'GRN', prefix:'GRN/', padLength:5],
                [sequenceType:'STOCK_TRANSFER', prefix:'ST/', padLength:5]
            ]"/>
            <iterate list="sequences" entry="seq">
                <service-call name="store#zenith.erp.base.SystemSequence"
                              in-map="[organizationPartyId:organizationPartyId,
                                       sequenceType:seq.sequenceType, prefix:seq.prefix,
                                       padLength:seq.padLength, nextValue:1,
                                       includeFinancialYear:'Y']"/>
            </iterate>
        </actions>
    </service>

    <service verb="get" noun="NextSequence">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="sequenceType" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sequenceValue"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.base.SystemSequence" value-field="seqRecord" for-update="true"/>
            <if condition="!seqRecord">
                <return error="true" message="Sequence ${sequenceType} not configured for organization ${organizationPartyId}"/>
            </if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="cal" from="java.util.Calendar.getInstance()"/>
            <script>cal.setTime(now)</script>
            <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
            <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>

            <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="fyStartSetting">
                <field-map field-name="organizationPartyId"/>
                <field-map field-name="settingKey" value="FY_START_MONTH"/>
            </entity-find-one>
            <set field="fyStartMonth" from="fyStartSetting ? (fyStartSetting.settingValue as int) : 4"/>

            <set field="fyYear" from="month &gt;= fyStartMonth ? year : year - 1"/>
            <set field="fyLabel" from="seqRecord.includeFinancialYear == 'Y' ? (fyYear.toString().substring(2) + '-' + ((fyYear+1).toString().substring(2)) + '/') : ''"/>

            <set field="numStr" from="seqRecord.nextValue.toString().padLeft(seqRecord.padLength as int, '0')"/>
            <set field="sequenceValue" from="(seqRecord.prefix ?: '') + fyLabel + numStr + (seqRecord.suffix ?: '')"/>

            <set field="seqRecord.nextValue" from="seqRecord.nextValue + 1"/>
            <entity-update value-field="seqRecord"/>
        </actions>
    </service>

</services>
