<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Send Notification -->
    <service verb="send" noun="Notification">
        <in-parameters>
            <parameter name="eventTypeEnumId" required="true"/>
            <parameter name="recipientPartyId" required="true"/>
            <parameter name="recipientAddress" required="true"/>
            <parameter name="referenceId"/>
            <parameter name="templateVars" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="notificationLogId"/></out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.base.NotificationTemplate" list="templates">
                <econdition field-name="eventTypeEnumId"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            <iterate list="templates" entry="template">
                <set field="messageBody" from="template.messageTemplate"/>
                <if condition="templateVars">
                    <iterate list="templateVars" entry="val" key="key">
                        <set field="messageBody" from="messageBody?.replace('{{' + key + '}}', val?.toString() ?: '')"/>
                    </iterate>
                </if>
                <service-call name="create#zenith.erp.base.NotificationLog"
                              in-map="[notificationTemplateId:template.notificationTemplateId,
                                       recipientPartyId:recipientPartyId, recipientAddress:recipientAddress,
                                       channelEnumId:template.channelEnumId, messageBody:messageBody,
                                       statusId:'NsQueued', sentDate:ec.user.nowTimestamp,
                                       referenceId:referenceId]"
                              out-map="logResult"/>
                <set field="notificationLogId" from="logResult.notificationLogId"/>
            </iterate>
        </actions>
    </service>

    <!-- Create Company Group -->
    <service verb="create" noun="CompanyGroup">
        <in-parameters>
            <parameter name="groupName" required="true"/>
            <parameter name="description"/>
            <parameter name="parentGroupId"/>
        </in-parameters>
        <out-parameters><parameter name="companyGroupId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.base.CompanyGroup" in-map="context" out-map="context"/>
        </actions>
    </service>

    <!-- Add Member to Company Group -->
    <service verb="add" noun="CompanyGroupMember">
        <in-parameters>
            <parameter name="companyGroupId" required="true"/>
            <parameter name="partyId" required="true"/>
            <parameter name="roleEnumId" required="true"/>
            <parameter name="fromDate" type="Date" default="ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        </in-parameters>
        <actions>
            <service-call name="create#zenith.erp.base.CompanyGroupMember" in-map="context"/>
        </actions>
    </service>

    <!-- Execute Backup -->
    <service verb="execute" noun="Backup">
        <in-parameters>
            <parameter name="backupScheduleId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="backupLogId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.base.BackupSchedule" value-field="schedule"/>
            <service-call name="create#zenith.erp.base.BackupLog"
                          in-map="[backupScheduleId:backupScheduleId,
                                   backupTypeEnumId:schedule.backupTypeEnumId,
                                   startTime:ec.user.nowTimestamp, statusId:'BkRunning']"
                          out-map="context"/>
            <!-- Actual backup logic would be implemented via a scheduled job or external script -->
        </actions>
    </service>

    <!-- Complete Backup -->
    <service verb="complete" noun="Backup">
        <in-parameters>
            <parameter name="backupLogId" required="true"/>
            <parameter name="filePath"/>
            <parameter name="backupSize" type="Long"/>
            <parameter name="success" type="Boolean" default-value="true"/>
            <parameter name="errorMessage"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.base.BackupLog" value-field="log" for-update="true"/>
            <set field="log.endTime" from="ec.user.nowTimestamp"/>
            <set field="log.filePath" from="filePath"/>
            <set field="log.backupSize" from="backupSize"/>
            <set field="log.statusId" from="success ? 'BkSuccess' : 'BkFailed'"/>
            <set field="log.errorMessage" from="errorMessage"/>
            <entity-update value-field="log"/>
        </actions>
    </service>

    <!-- Check User Access -->
    <service verb="check" noun="UserAccess">
        <in-parameters>
            <parameter name="userId" required="true"/>
            <parameter name="ipAddress"/>
            <parameter name="deviceId"/>
        </in-parameters>
        <out-parameters><parameter name="accessAllowed" type="Boolean"/></out-parameters>
        <actions>
            <set field="accessAllowed" from="true"/>
            <entity-find entity-name="zenith.erp.base.UserAccessControl" list="controls">
                <econdition field-name="userId"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            <iterate list="controls" entry="ctrl">
                <if condition="ctrl.accessTypeEnumId == 'UacBlacklist'">
                    <if condition="(ipAddress &amp;&amp; ctrl.ipAddress == ipAddress) || (deviceId &amp;&amp; ctrl.deviceIdentifier == deviceId)">
                        <set field="accessAllowed" from="false"/>
                    </if>
                <else-if condition="ctrl.accessTypeEnumId == 'UacWhitelist'">
                    <set field="accessAllowed" from="false"/>
                    <if condition="(ipAddress &amp;&amp; ctrl.ipAddress == ipAddress) || (deviceId &amp;&amp; ctrl.deviceIdentifier == deviceId)">
                        <set field="accessAllowed" from="true"/>
                    </if>
                </else-if></if>
            </iterate>
        </actions>
    </service>

</services>
