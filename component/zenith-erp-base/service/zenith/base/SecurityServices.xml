<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ZE-INV-010 (IV-110): does the current user have WRITE (full) access to a module? Mirrors the central write
         gate in ZenithApp.xml so screens can HIDE write features and transitions can ENFORCE them (the gate is
         fail-open; these explicit checks are the robust half). canWrite = ADMIN / ZENITH_ADMIN, OR a POS-cashier-only
         user (posOnly is exempt from the gate), OR any of the user's groups holds AUTHZA_ALL on the module's Z_<MOD>
         artifact group. View-only (AUTHZA_VIEW) or no grant => canWrite = false. -->
    <service verb="check" noun="ModuleWriteAccess" authenticate="true">
        <in-parameters><parameter name="moduleId" required="true"/></in-parameters>
        <out-parameters><parameter name="canWrite" type="Boolean"/></out-parameters>
        <actions>
            <script><![CDATA[
                canWrite = false
                if (ec.user.userId == null) { return }
                if (ec.user.isInGroup("ADMIN") || ec.user.isInGroup("ZENITH_ADMIN")) { canWrite = true; return }
                def _zr = (ec.user.userGroupIdSet ?: []).findAll { it?.startsWith("ZENITH_") && it != "ZENITH_ALL" }
                if (_zr.size() == 1 && _zr.contains("ZENITH_CASHIER")) { canWrite = true; return }   // posOnly: gate-exempt
                def _myG = (ec.user.userGroupIdSet ?: []) as List
                if (!_myG) { return }
                boolean _dz = ec.artifactExecution.disableAuthz()
                try {
                    canWrite = ec.entity.find("moqui.security.ArtifactAuthz")
                            .condition("artifactGroupId", "Z_" + moduleId.toString().toUpperCase())
                            .condition("userGroupId", "in", _myG)
                            .condition("authzActionEnumId", "AUTHZA_ALL")
                            .condition("authzTypeEnumId", "in", ["AUTHZT_ALLOW", "AUTHZT_ALWAYS"])
                            .count() > 0
                } finally { if (!_dz) ec.artifactExecution.enableAuthz() }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-INV-IV-031: reusable "your own organization(s)" list for the many org pickers across modules.
         Those pickers were EMPTY for every tenant: they query mantle.party.PartyDetailAndRole (which drags in
         mantle.party.Party), and the MANTLE_ACTIVE_ORG entity filter scopes Party by ownerPartyId=activeOrg —
         but a tenant's OWN org party has ownerPartyId='_NA_' (an org isn't owned by itself), so the active org
         is filtered out of its own picker. This bypasses that filter with disableAuthz, staying safe by scoping
         to partyId=activeOrg: a tenant sees ONLY their own org (no cross-tenant leak); an admin with no active
         org (getPreference null/'_NA_') sees all internal orgs, as those pickers intend. Excludes disabled orgs.
         Returns PartyDetailAndRole rows (use .partyId / .organizationName in list-options). -->
    <service verb="get" noun="ActiveOrgList" authenticate="true">
        <out-parameters><parameter name="orgList" type="List"/></out-parameters>
        <actions>
            <script><![CDATA[
                def _ao = ec.user.getPreference('ACTIVE_ORGANIZATION')
                def _q = ec.entity.find('mantle.party.PartyDetailAndRole')
                            .condition('roleTypeId', 'OrgInternal').disableAuthz()
                if (_ao && _ao != '_NA_') _q.condition('partyId', _ao)
                orgList = _q.list().findAll { it.disabled != 'Y' }
            ]]></script>
        </actions>
    </service>

</services>
