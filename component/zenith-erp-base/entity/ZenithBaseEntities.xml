<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="CompanySettings" package="zenith.erp.base" short-alias="CompanySettings">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="settingKey" type="text-medium" is-pk="true"/>
        <field name="settingValue" type="text-long"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <entity entity-name="CompanyBranch" package="zenith.erp.base" short-alias="CompanyBranch">
        <field name="branchId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="branchName" type="text-medium"/>
        <field name="facilityId" type="id"/>
        <field name="isHeadOffice" type="text-indicator" default="'N'"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="taxRegistrationNumber" type="text-short"/>
        <field name="currencyUomId" type="id"/>
        <field name="stateCode" type="text-short"><description>Deprecated: use regionGeoId instead</description></field>
        <field name="gstin" type="text-short"><description>Deprecated: use taxRegistrationNumber instead</description></field>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="Country" related="moqui.basic.Geo">
            <key-map field-name="countryGeoId" related="geoId"/>
        </relationship>
        <relationship type="one" title="Region" related="moqui.basic.Geo">
            <key-map field-name="regionGeoId" related="geoId"/>
        </relationship>
    </entity>

    <entity entity-name="SystemSequence" package="zenith.erp.base" short-alias="SystemSequence">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="sequenceType" type="text-medium" is-pk="true"/>
        <field name="prefix" type="text-short"/>
        <field name="suffix" type="text-short"/>
        <field name="nextValue" type="number-integer" default="1"/>
        <field name="padLength" type="number-integer" default="4"/>
        <field name="includeFinancialYear" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <entity entity-name="ZenithAiConfiguration" package="zenith.erp.base" short-alias="AiConfiguration">
        <field name="configId" type="id" is-pk="true"/>
        <field name="providerName" type="text-medium"/>
        <field name="endpointUrl" type="text-long"/>
        <field name="apiKey" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== COUNTRY CONFIGURATION ========== -->
    <entity entity-name="CountryConfiguration" package="zenith.erp.base" short-alias="CountryConfiguration">
        <field name="countryGeoId" type="id" is-pk="true"/>
        <field name="countryName" type="text-medium"/>
        <field name="fiscalYearStartMonth" type="number-integer" default="1">
            <description>Month when fiscal year starts (1=Jan, 4=Apr for India, etc.)</description>
        </field>
        <field name="dateFormatPattern" type="text-short" default="'yyyy-MM-dd'"/>
        <field name="numberFormatPattern" type="text-short" default="'###,###.##'"/>
        <field name="defaultCurrencyUomId" type="id"/>
        <field name="defaultLanguageLocale" type="text-short"/>
        <field name="taxSystemType" type="text-short">
            <description>GST, VAT, SalesTax, Mixed, None</description>
        </field>
        <field name="addressFormatTemplate" type="text-long"/>
        <field name="amountToWordsServiceName" type="text-medium">
            <description>Service to convert amount to words for this country's locale</description>
        </field>
        <relationship type="one" related="moqui.basic.Geo">
            <key-map field-name="countryGeoId" related="geoId"/>
        </relationship>
        <seed-data>
            <zenith.erp.base.CountryConfiguration countryGeoId="IND" countryName="India"
                fiscalYearStartMonth="4" dateFormatPattern="dd/MM/yyyy"
                numberFormatPattern="##,##,###.##" defaultCurrencyUomId="INR"
                defaultLanguageLocale="en_IN" taxSystemType="GST"
                amountToWordsServiceName="zenith.india.GstServices.convert#AmountToIndianWords"/>
            <zenith.erp.base.CountryConfiguration countryGeoId="USA" countryName="United States"
                fiscalYearStartMonth="1" dateFormatPattern="MM/dd/yyyy"
                numberFormatPattern="###,###.##" defaultCurrencyUomId="USD"
                defaultLanguageLocale="en_US" taxSystemType="SalesTax"/>
            <zenith.erp.base.CountryConfiguration countryGeoId="GBR" countryName="United Kingdom"
                fiscalYearStartMonth="4" dateFormatPattern="dd/MM/yyyy"
                numberFormatPattern="###,###.##" defaultCurrencyUomId="GBP"
                defaultLanguageLocale="en_GB" taxSystemType="VAT"/>
            <zenith.erp.base.CountryConfiguration countryGeoId="ARE" countryName="United Arab Emirates"
                fiscalYearStartMonth="1" dateFormatPattern="dd/MM/yyyy"
                numberFormatPattern="###,###.##" defaultCurrencyUomId="AED"
                defaultLanguageLocale="en_AE" taxSystemType="VAT"/>
        </seed-data>
    </entity>

    <!-- ========== REGION CONFIGURATION ========== -->
    <entity entity-name="RegionConfiguration" package="zenith.erp.base" short-alias="RegionConfiguration">
        <field name="countryGeoId" type="id" is-pk="true"/>
        <field name="regionGeoId" type="id" is-pk="true"/>
        <field name="regionName" type="text-medium"/>
        <field name="regionCode" type="text-short"/>
        <field name="hasTaxJurisdiction" type="text-indicator" default="'Y'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.base.CountryConfiguration"/>
        <relationship type="one" title="Region" related="moqui.basic.Geo">
            <key-map field-name="regionGeoId" related="geoId"/>
        </relationship>
    </entity>

    <!-- ========== GROUP COMPANY (multi-company management) ========== -->
    <entity entity-name="CompanyGroup" package="zenith.erp.base" short-alias="CompanyGroup">
        <field name="companyGroupId" type="id" is-pk="true"/>
        <field name="groupName" type="text-medium"/>
        <field name="parentPartyId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" title="Parent" related="mantle.party.Party" short-alias="parentCompany">
            <key-map field-name="parentPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="CompanyGroupMember" package="zenith.erp.base" short-alias="CompanyGroupMember">
        <field name="companyGroupId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="roleEnumId" type="id"/>
        <relationship type="one" related="zenith.erp.base.CompanyGroup" short-alias="group"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="GroupMemberRole" description="Group Member Role"/>
            <moqui.basic.Enumeration enumId="GmrHolding" enumTypeId="GroupMemberRole" description="Holding Company" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="GmrSubsidiary" enumTypeId="GroupMemberRole" description="Subsidiary" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="GmrAssociate" enumTypeId="GroupMemberRole" description="Associate" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="GmrBranch" enumTypeId="GroupMemberRole" description="Branch" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== NOTIFICATION TEMPLATE (WhatsApp / SMS / Email) ========== -->
    <entity entity-name="NotificationTemplate" package="zenith.erp.base" short-alias="NotificationTemplate">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="templateName" type="text-medium"/>
        <field name="channelEnumId" type="id"/>
        <field name="eventTypeEnumId" type="id"/>
        <field name="subject" type="text-medium"/>
        <field name="bodyTemplate" type="text-very-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="NotificationChannel" description="Notification Channel"/>
            <moqui.basic.Enumeration enumId="NcWhatsApp" enumTypeId="NotificationChannel" description="WhatsApp" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NcSms" enumTypeId="NotificationChannel" description="SMS" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NcEmail" enumTypeId="NotificationChannel" description="Email" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NcPush" enumTypeId="NotificationChannel" description="Push Notification" sequenceNum="4"/>

            <moqui.basic.EnumerationType enumTypeId="NotificationEvent" description="Notification Event"/>
            <moqui.basic.Enumeration enumId="NeInvoiceCreated" enumTypeId="NotificationEvent" description="Invoice Created" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NePaymentReceived" enumTypeId="NotificationEvent" description="Payment Received" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NePaymentDue" enumTypeId="NotificationEvent" description="Payment Due Reminder" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NeStatementGenerated" enumTypeId="NotificationEvent" description="Statement Generated" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="NeOrderConfirmed" enumTypeId="NotificationEvent" description="Order Confirmed" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="NeShipmentDispatched" enumTypeId="NotificationEvent" description="Shipment Dispatched" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="NePdcReminder" enumTypeId="NotificationEvent" description="PDC Maturity Reminder" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="NeLoyaltyPoints" enumTypeId="NotificationEvent" description="Loyalty Points Update" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="NePickupReady" enumTypeId="NotificationEvent" description="Pickup Ready" sequenceNum="9"/>
        </seed-data>
    </entity>

    <entity entity-name="NotificationLog" package="zenith.erp.base" short-alias="NotificationLog">
        <field name="notificationLogId" type="id" is-pk="true"/>
        <field name="templateId" type="id"/>
        <field name="channelEnumId" type="id"/>
        <field name="recipientPartyId" type="id"/>
        <field name="recipientAddress" type="text-medium"/>
        <field name="subject" type="text-medium"/>
        <field name="body" type="text-very-long"/>
        <field name="sentDate" type="date-time"/>
        <field name="statusEnumId" type="id"/>
        <field name="externalMessageId" type="text-medium"/>
        <field name="errorMessage" type="text-long"/>
        <relationship type="one" related="zenith.erp.base.NotificationTemplate" short-alias="template"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="NotificationStatus" description="Notification Status"/>
            <moqui.basic.Enumeration enumId="NsPending" enumTypeId="NotificationStatus" description="Pending" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NsSent" enumTypeId="NotificationStatus" description="Sent" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NsDelivered" enumTypeId="NotificationStatus" description="Delivered" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NsFailed" enumTypeId="NotificationStatus" description="Failed" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== DIGITAL SIGNATURE ========== -->
    <entity entity-name="DigitalSignature" package="zenith.erp.base" short-alias="DigitalSignature">
        <field name="signatureId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="signatureName" type="text-medium"/>
        <field name="signatureImageLocation" type="text-long"/>
        <field name="certificateLocation" type="text-long"/>
        <field name="certificateExpiry" type="date"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== BACKUP MANAGEMENT ========== -->
    <entity entity-name="BackupSchedule" package="zenith.erp.base" short-alias="BackupSchedule">
        <field name="scheduleId" type="id" is-pk="true"/>
        <field name="scheduleName" type="text-medium"/>
        <field name="backupTypeEnumId" type="id"/>
        <field name="frequencyEnumId" type="id"/>
        <field name="timeOfDay" type="time"/>
        <field name="retentionDays" type="number-integer" default="30"/>
        <field name="destinationPath" type="text-long"/>
        <field name="isCloudBackup" type="text-indicator" default="'N'"/>
        <field name="cloudProvider" type="text-short"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="lastRunDate" type="date-time"/>
        <field name="lastRunStatus" type="text-short"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="BackupType" description="Backup Type"/>
            <moqui.basic.Enumeration enumId="BtFull" enumTypeId="BackupType" description="Full Backup" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BtIncremental" enumTypeId="BackupType" description="Incremental" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BtDataOnly" enumTypeId="BackupType" description="Data Only" sequenceNum="3"/>

            <moqui.basic.EnumerationType enumTypeId="BackupFrequency" description="Backup Frequency"/>
            <!-- ZE-SALES-025 f/u: use a Bkf* prefix (was Bf*, which collided with BillingFrequency's BfMonthly —
                 enumeration.enumId is a GLOBAL single-column PK, so a shared id can only live under one type). -->
            <moqui.basic.Enumeration enumId="BkfHourly" enumTypeId="BackupFrequency" description="Hourly" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BkfDaily" enumTypeId="BackupFrequency" description="Daily" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BkfWeekly" enumTypeId="BackupFrequency" description="Weekly" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="BkfMonthly" enumTypeId="BackupFrequency" description="Monthly" sequenceNum="4"/>
        </seed-data>
    </entity>

    <entity entity-name="BackupLog" package="zenith.erp.base" short-alias="BackupLog">
        <field name="backupLogId" type="id" is-pk="true"/>
        <field name="scheduleId" type="id"/>
        <field name="startTime" type="date-time"/>
        <field name="endTime" type="date-time"/>
        <field name="backupSize" type="number-integer"/>
        <field name="filePath" type="text-long"/>
        <field name="statusEnumId" type="id"/>
        <field name="errorMessage" type="text-long"/>
        <relationship type="one" related="zenith.erp.base.BackupSchedule" short-alias="schedule"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="BackupStatus" description="Backup Status"/>
            <moqui.basic.Enumeration enumId="BsRunning" enumTypeId="BackupStatus" description="Running" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BsSuccess" enumTypeId="BackupStatus" description="Success" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BsFailed" enumTypeId="BackupStatus" description="Failed" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- ========== USER ACCESS CONTROL (Blacklist/Whitelist) ========== -->
    <entity entity-name="UserAccessControl" package="zenith.erp.base" short-alias="UserAccessControl">
        <field name="accessControlId" type="id" is-pk="true"/>
        <field name="userId" type="id"/>
        <field name="controlType" type="text-short"/>
        <field name="ipAddress" type="text-short"/>
        <field name="deviceId" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="reason" type="text-medium"/>
        <field name="createdDate" type="date-time"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AccessControlType" description="Access Control Type"/>
            <moqui.basic.Enumeration enumId="ActBlacklist" enumTypeId="AccessControlType" description="Blacklist" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="ActWhitelist" enumTypeId="AccessControlType" description="Whitelist" sequenceNum="2"/>
        </seed-data>
    </entity>

    <!-- ========== CURRENCY EXCHANGE RATE ========== -->
    <entity entity-name="CurrencyExchangeRate" package="zenith.erp.base" short-alias="CurrencyExchangeRate">
        <field name="exchangeRateId" type="id" is-pk="true"/>
        <field name="fromCurrencyUomId" type="id"/>
        <field name="toCurrencyUomId" type="id"/>
        <field name="exchangeRate" type="number-decimal"/>
        <field name="effectiveDate" type="date"/>
        <field name="rateSource" type="text-short" default="'Manual'">
            <description>Manual, API, Bank, etc.</description>
        </field>
        <index name="IDX_EXCHRATE_CURR">
            <index-field name="fromCurrencyUomId"/>
            <index-field name="toCurrencyUomId"/>
            <index-field name="effectiveDate"/>
        </index>
    </entity>

</entities>
