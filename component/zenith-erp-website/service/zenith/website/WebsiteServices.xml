<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Page Management ========== -->

    <service verb="create" noun="WebPage">
        <in-parameters>
            <parameter name="siteId" required="true"/>
            <parameter name="title" required="true"/>
            <parameter name="slug"/>
            <parameter name="pageType" default-value="WptPage"/>
            <parameter name="content"/>
            <parameter name="metaTitle"/>
            <parameter name="metaDescription"/>
            <parameter name="locale" default-value="en"/>
            <parameter name="templateId"/>
            <parameter name="parentPageId"/>
            <parameter name="blogCategoryId"/>
            <parameter name="featuredImageUrl"/>
            <parameter name="tags"/>
            <parameter name="allowComments" default-value="N"/>
        </in-parameters>
        <out-parameters><parameter name="pageId"/></out-parameters>
        <actions>
            <!-- Auto-generate slug from title if not provided -->
            <if condition="!slug">
                <script><![CDATA[
                    slug = title.toLowerCase()
                        .replaceAll('[^a-z0-9\\s-]', '')
                        .replaceAll('\\s+', '-')
                        .replaceAll('-+', '-')
                        .trim()
                    if (slug.length() > 80) slug = slug.substring(0, 80)
                ]]></script>
            </if>
            <if condition="!metaTitle"><set field="metaTitle" from="title"/></if>

            <service-call name="create#zenith.erp.website.WebPage" out-map="context"
                in-map="[siteId:siteId, title:title, slug:slug, pageType:pageType,
                         content:content, metaTitle:metaTitle, metaDescription:metaDescription,
                         locale:locale, templateId:templateId, parentPageId:parentPageId,
                         blogCategoryId:blogCategoryId, featuredImageUrl:featuredImageUrl,
                         tags:tags, allowComments:allowComments,
                         authorPartyId:ec.user.userAccount?.partyId,
                         isPublished:'N', viewCount:0, lastUpdated:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="publish" noun="WebPage">
        <in-parameters><parameter name="pageId" required="true"/></in-parameters>
        <actions>
            <service-call name="update#zenith.erp.website.WebPage"
                in-map="[pageId:pageId, isPublished:'Y', publishDate:ec.user.nowTimestamp,
                         lastUpdated:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="unpublish" noun="WebPage">
        <in-parameters><parameter name="pageId" required="true"/></in-parameters>
        <actions>
            <service-call name="update#zenith.erp.website.WebPage"
                in-map="[pageId:pageId, isPublished:'N', lastUpdated:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="duplicate" noun="WebPage">
        <in-parameters><parameter name="pageId" required="true"/></in-parameters>
        <out-parameters><parameter name="newPageId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.website.WebPage" value-field="original"/>
            <service-call name="zenith.website.WebsiteServices.create#WebPage" out-map="newPage"
                in-map="[siteId:original.siteId, title:original.title + ' (Copy)',
                         pageType:original.pageType, content:original.content,
                         metaTitle:original.metaTitle, metaDescription:original.metaDescription,
                         locale:original.locale, templateId:original.templateId,
                         blogCategoryId:original.blogCategoryId, tags:original.tags]"/>
            <set field="newPageId" from="newPage.pageId"/>

            <!-- Copy blocks -->
            <entity-find entity-name="zenith.erp.website.WebBlock" list="blocks">
                <econdition field-name="pageId"/></entity-find>
            <iterate list="blocks" entry="block">
                <service-call name="create#zenith.erp.website.WebBlock"
                    in-map="[pageId:newPageId, blockType:block.blockType, blockOrder:block.blockOrder,
                             title:block.title, content:block.content, imageUrl:block.imageUrl,
                             linkUrl:block.linkUrl, linkText:block.linkText,
                             settings:block.settings, isActive:block.isActive]"/>
            </iterate>
        </actions>
    </service>

    <!-- ========== Contact Form Submission ========== -->

    <service verb="submit" noun="ContactForm">
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="name" required="true"/>
            <parameter name="email" required="true"/>
            <parameter name="phone"/>
            <parameter name="company"/>
            <parameter name="subject"/>
            <parameter name="message" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="submissionId"/>
            <parameter name="leadId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.website.WebContactSubmission" out-map="context"
                in-map="[formId:formId, name:name, email:email, phone:phone, company:company,
                         subject:subject, message:message, submittedDate:ec.user.nowTimestamp,
                         isRead:'N']"/>

            <!-- Auto-create CRM lead if configured -->
            <entity-find-one entity-name="zenith.erp.website.WebContactForm" value-field="form"/>
            <if condition="form?.createLeadInCrm == 'Y'">
                <service-call name="create#zenith.erp.crm.Lead" out-map="leadResult"
                    in-map="[firstName:name, companyName:company ?: name,
                             email:email, phone:phone, leadSource:'Website',
                             description:subject ? (subject + ': ' + message) : message,
                             statusId:'LdNew']"/>
                <set field="leadId" from="leadResult.leadId"/>
                <service-call name="update#zenith.erp.website.WebContactSubmission"
                    in-map="[submissionId:submissionId, leadId:leadId]"/>
            </if>
        </actions>
    </service>

    <service verb="markRead" noun="ContactSubmission">
        <in-parameters><parameter name="submissionId" required="true"/></in-parameters>
        <actions>
            <service-call name="update#zenith.erp.website.WebContactSubmission"
                in-map="[submissionId:submissionId, isRead:'Y']"/>
        </actions>
    </service>

    <!-- ========== Menu Management ========== -->

    <service verb="reorder" noun="MenuItems">
        <description>Reorder menu items by setting menuOrder sequentially</description>
        <in-parameters>
            <parameter name="menuId" required="true"/>
            <parameter name="itemSeqIds" type="List" required="true"/>
        </in-parameters>
        <actions>
            <script><![CDATA[
                itemSeqIds.eachWithIndex { seqId, idx ->
                    ec.service.sync().name("update#zenith.erp.website.WebMenuItem")
                        .parameters([menuId:menuId, itemSeqId:seqId, menuOrder:idx + 1]).call()
                }
            ]]></script>
        </actions>
    </service>

</services>
