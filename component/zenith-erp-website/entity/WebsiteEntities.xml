<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Web Site ========== -->
    <entity entity-name="WebSite" package="zenith.erp.website" short-alias="WebSites">
        <field name="siteId" type="id" is-pk="true"/>
        <field name="siteName" type="text-medium"/>
        <field name="domain" type="text-medium"/>
        <field name="organizationPartyId" type="id"/>
        <field name="themeId" type="id"/>
        <field name="defaultLocale" type="text-short"/>
        <field name="metaTitle" type="text-medium"/>
        <field name="metaDescription" type="text-long"/>
        <field name="logoUrl" type="text-medium"/>
        <field name="faviconUrl" type="text-medium"/>
        <field name="headerScript" type="text-very-long"/>
        <field name="footerScript" type="text-very-long"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebTheme"/>
    </entity>

    <!-- ========== Theme ========== -->
    <entity entity-name="WebTheme" package="zenith.erp.website" short-alias="WebThemes">
        <field name="themeId" type="id" is-pk="true"/>
        <field name="themeName" type="text-medium"/>
        <field name="primaryColor" type="text-short"/>
        <field name="secondaryColor" type="text-short"/>
        <field name="accentColor" type="text-short"/>
        <field name="fontFamily" type="text-medium"/>
        <field name="headingFont" type="text-medium"/>
        <field name="customCss" type="text-very-long"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Web Page ========== -->
    <entity entity-name="WebPage" package="zenith.erp.website" short-alias="WebPages">
        <field name="pageId" type="id" is-pk="true"/>
        <field name="siteId" type="id"/>
        <field name="title" type="text-medium"/>
        <field name="slug" type="text-medium"/>
        <field name="pageType" type="text-short"/>
        <field name="content" type="text-very-long"/>
        <field name="metaTitle" type="text-medium"/>
        <field name="metaDescription" type="text-long"/>
        <field name="metaKeywords" type="text-medium"/>
        <field name="locale" type="text-short"/>
        <field name="templateId" type="text-short"/>
        <field name="parentPageId" type="id"/>
        <field name="menuOrder" type="number-integer"/>
        <field name="authorPartyId" type="id"/>
        <field name="isPublished" type="text-indicator"/>
        <field name="publishDate" type="date-time"/>
        <field name="featuredImageUrl" type="text-medium"/>
        <field name="blogCategoryId" type="id"/>
        <field name="tags" type="text-medium"/>
        <field name="allowComments" type="text-indicator"/>
        <field name="viewCount" type="number-integer"/>
        <field name="lastUpdated" type="date-time"/>
        <relationship type="one" related="zenith.erp.website.WebSite"/>
        <relationship type="one" related="zenith.erp.website.BlogCategory"><key-map field-name="blogCategoryId" related="categoryId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="WebPageType" description="Web Page Type"/>
            <moqui.basic.Enumeration enumId="WptPage" enumTypeId="WebPageType" description="Page" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="WptBlog" enumTypeId="WebPageType" description="Blog Post" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="WptLanding" enumTypeId="WebPageType" description="Landing Page" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- ========== Content Block ========== -->
    <entity entity-name="WebBlock" package="zenith.erp.website" short-alias="WebBlocks">
        <field name="blockId" type="id" is-pk="true"/>
        <field name="pageId" type="id"/>
        <field name="blockType" type="text-short"/>
        <field name="blockOrder" type="number-integer"/>
        <field name="title" type="text-medium"/>
        <field name="content" type="text-very-long"/>
        <field name="imageUrl" type="text-medium"/>
        <field name="linkUrl" type="text-medium"/>
        <field name="linkText" type="text-short"/>
        <field name="settings" type="text-very-long"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebPage"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="WebBlockType" description="Web Block Type"/>
            <moqui.basic.Enumeration enumId="WbtHero" enumTypeId="WebBlockType" description="Hero Banner" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="WbtText" enumTypeId="WebBlockType" description="Text/Rich Content" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="WbtImage" enumTypeId="WebBlockType" description="Image" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="WbtGallery" enumTypeId="WebBlockType" description="Image Gallery" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="WbtCta" enumTypeId="WebBlockType" description="Call to Action" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="WbtForm" enumTypeId="WebBlockType" description="Contact Form" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="WbtVideo" enumTypeId="WebBlockType" description="Video Embed" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="WbtTestimonial" enumTypeId="WebBlockType" description="Testimonial" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="WbtHtml" enumTypeId="WebBlockType" description="Raw HTML" sequenceNum="9"/>
        </seed-data>
    </entity>

    <!-- ========== Navigation Menu ========== -->
    <entity entity-name="WebMenu" package="zenith.erp.website" short-alias="WebMenus">
        <field name="menuId" type="id" is-pk="true"/>
        <field name="siteId" type="id"/>
        <field name="menuName" type="text-medium"/>
        <field name="menuLocation" type="text-short"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebSite"/>
    </entity>

    <entity entity-name="WebMenuItem" package="zenith.erp.website" short-alias="WebMenuItems">
        <field name="menuId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="title" type="text-medium"/>
        <field name="url" type="text-medium"/>
        <field name="pageId" type="id"/>
        <field name="parentItemSeqId" type="id"/>
        <field name="menuOrder" type="number-integer"/>
        <field name="openInNewTab" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebMenu"/>
    </entity>

    <!-- ========== Blog Category ========== -->
    <entity entity-name="BlogCategory" package="zenith.erp.website" short-alias="BlogCategories">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="siteId" type="id"/>
        <field name="categoryName" type="text-medium"/>
        <field name="slug" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="parentCategoryId" type="id"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebSite"/>
    </entity>

    <!-- ========== Contact Form ========== -->
    <entity entity-name="WebContactForm" package="zenith.erp.website" short-alias="WebContactForms">
        <field name="formId" type="id" is-pk="true"/>
        <field name="siteId" type="id"/>
        <field name="formName" type="text-medium"/>
        <field name="emailTo" type="text-medium"/>
        <field name="successMessage" type="text-long"/>
        <field name="createLeadInCrm" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.website.WebSite"/>
    </entity>

    <entity entity-name="WebContactSubmission" package="zenith.erp.website" short-alias="WebContactSubmissions">
        <field name="submissionId" type="id" is-pk="true"/>
        <field name="formId" type="id"/>
        <field name="name" type="text-medium"/>
        <field name="email" type="text-medium"/>
        <field name="phone" type="text-short"/>
        <field name="company" type="text-medium"/>
        <field name="subject" type="text-medium"/>
        <field name="message" type="text-long"/>
        <field name="submittedDate" type="date-time"/>
        <field name="isRead" type="text-indicator"/>
        <field name="leadId" type="id"/>
        <relationship type="one" related="zenith.erp.website.WebContactForm"/>
    </entity>

    <!-- ========== Media Library ========== -->
    <entity entity-name="WebMedia" package="zenith.erp.website" short-alias="WebMediaFiles">
        <field name="mediaId" type="id" is-pk="true"/>
        <field name="siteId" type="id"/>
        <field name="fileName" type="text-medium"/>
        <field name="fileUrl" type="text-medium"/>
        <field name="fileType" type="text-short"/>
        <field name="fileSizeBytes" type="number-integer"/>
        <field name="altText" type="text-medium"/>
        <field name="caption" type="text-medium"/>
        <field name="folder" type="text-medium"/>
        <field name="uploadDate" type="date-time"/>
        <field name="uploadedByPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.website.WebSite"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="WebPageView" package="zenith.erp.website">
        <member-entity entity-alias="WP" entity-name="zenith.erp.website.WebPage"/>
        <member-entity entity-alias="WS" entity-name="zenith.erp.website.WebSite" join-from-alias="WP">
            <key-map field-name="siteId"/></member-entity>
        <member-entity entity-alias="BC" entity-name="zenith.erp.website.BlogCategory" join-from-alias="WP" join-optional="true">
            <key-map field-name="blogCategoryId" related="categoryId"/></member-entity>
        <alias-all entity-alias="WP"/>
        <alias entity-alias="WS" name="siteName"/>
        <alias entity-alias="BC" name="categoryName"/>
    </view-entity>

    <view-entity entity-name="WebContactSubmissionView" package="zenith.erp.website">
        <member-entity entity-alias="CS" entity-name="zenith.erp.website.WebContactSubmission"/>
        <member-entity entity-alias="CF" entity-name="zenith.erp.website.WebContactForm" join-from-alias="CS">
            <key-map field-name="formId"/></member-entity>
        <alias-all entity-alias="CS"/>
        <alias entity-alias="CF" name="formName"/>
    </view-entity>
</entities>
