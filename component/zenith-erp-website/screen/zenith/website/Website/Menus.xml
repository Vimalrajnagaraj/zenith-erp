<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Menus" default-menu-index="5">

    <transition name="createMenu" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebMenu"/>
        <default-response url="."/>
    </transition>
    <transition name="updateMenu" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebMenu"/>
        <default-response url="."/>
    </transition>
    <transition name="createMenuItem" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebMenuItem"/>
        <default-response url="."/>
    </transition>
    <transition name="updateMenuItem" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebMenuItem"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteMenuItem" begin-transaction="true">
        <service-call name="delete#zenith.erp.website.WebMenuItem"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.website.WebMenu" list="menuList">
            <order-by field-name="menuName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.website.WebMenuItem" list="menuItemList">
            <order-by field-name="menuId,menuOrder"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Navigation Menus"/>
            <box-toolbar>
                <section name="CreateMenu_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateMenuDialog" button-text="New Menu">
                    <form-single name="CreateMenuForm" transition="createMenu">
                        <field name="menuId"><default-field title="Menu ID"><text-line size="15"/></default-field></field>
                        <field name="siteId"><default-field title="Site">
                            <drop-down><entity-options key="${siteId}" text="${siteName}">
                                <entity-find entity-name="zenith.erp.website.WebSite">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="menuName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="menuLocation"><default-field title="Location">
                            <drop-down><option key="Header"/><option key="Footer"/><option key="Sidebar"/></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="MenuList" list="menuList" transition="updateMenu">
                    <field name="menuId"><default-field title="ID"><display/></default-field></field>
                    <field name="menuName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="siteId"><default-field title="Site">
                        <display-entity entity-name="zenith.erp.website.WebSite" text="${siteName}"/></default-field></field>
                    <field name="menuLocation"><default-field title="Location">
                        <drop-down><option key="Header"/><option key="Footer"/><option key="Sidebar"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="menu_update_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title="Update"><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Menu Items"/>
            <box-toolbar>
                <section name="AddMenuItem_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddMenuItemDialog" button-text="Add Item">
                    <form-single name="AddMenuItemForm" transition="createMenuItem">
                        <field name="menuId"><default-field title="Menu">
                            <drop-down><entity-options key="${menuId}" text="${menuName}">
                                <entity-find entity-name="zenith.erp.website.WebMenu"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="itemSeqId"><default-field title="Seq ID"><text-line size="8"/></default-field></field>
                        <field name="title"><default-field title="Title"><text-line size="25"/></default-field></field>
                        <field name="url"><default-field title="URL (or select page)"><text-line size="40"/></default-field></field>
                        <field name="pageId"><default-field title="Page">
                            <drop-down allow-empty="true"><entity-options key="${pageId}" text="${title}">
                                <entity-find entity-name="zenith.erp.website.WebPage">
                                    <econdition field-name="isPublished" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="parentItemSeqId"><default-field title="Parent Item Seq"><text-line size="8"/></default-field></field>
                        <field name="menuOrder"><default-field title="Order"><text-line size="4" default-value="10"/></default-field></field>
                        <field name="openInNewTab"><default-field title="New Tab">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="MenuItemList" list="menuItemList" transition="updateMenuItem">
                    <field name="menuId"><default-field title="Menu">
                        <display-entity entity-name="zenith.erp.website.WebMenu" text="${menuName}"/></default-field></field>
                    <field name="itemSeqId"><default-field title="Seq"><display/></default-field></field>
                    <field name="title"><default-field title="Title"><text-line size="20"/></default-field></field>
                    <field name="url"><default-field title="URL"><text-line size="25"/></default-field></field>
                    <field name="menuOrder"><default-field title="Order"><text-line size="3"/></default-field></field>
                    <field name="parentItemSeqId"><default-field title="Parent"><text-line size="6"/></default-field></field>
                    <field name="openInNewTab"><default-field title="New Tab">
                        <drop-down><option key="Y"/><option key="N"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="menuitem_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title="Save"><label text="" type="span"/></default-field>
                    </field>
                    <field name="deleteBtn">
                        <conditional-field name="menuitem_delete_write" condition="modCanWrite" title="">
                        <link url="deleteMenuItem" text="X"
                              parameter-map="[menuId:menuId, itemSeqId:itemSeqId]"
                              confirmation="Delete this menu item?"/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
