<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Page" default-menu-index="4" default-menu-include="false">

    <parameter name="pageId" required="true"/>

    <transition name="updatePage" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="publishPage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.publish#WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="unpublishPage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.unpublish#WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="createBlock" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebBlock"/>
        <default-response url="."/>
    </transition>
    <transition name="updateBlock" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebBlock"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteBlock" begin-transaction="true">
        <service-call name="delete#zenith.erp.website.WebBlock"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.website.WebPage" value-field="page"/>
        <entity-find entity-name="zenith.erp.website.WebBlock" list="blockList">
            <econdition field-name="pageId"/>
            <order-by field-name="blockOrder"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="8" md="12">
                <!-- Page Content -->
                <container-box><box-header title="Page: ${page.title}"/>
                <box-body>
                    <form-single name="PageForm" transition="updatePage" map="page">
                        <field name="pageId"><default-field><hidden/></default-field></field>
                        <field name="title"><default-field title="Title"><text-line size="50"/></default-field></field>
                        <field name="slug"><default-field title="URL Slug"><text-line size="50"/></default-field></field>
                        <field name="content"><default-field title="Content"><text-area rows="15" cols="70"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="page_save_write" condition="modCanWrite" title="Save Page"><submit/></conditional-field>
                            <default-field title="Save Page"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Content Blocks -->
                <container-box>
                    <box-header title="Content Blocks"/>
                    <box-toolbar>
                        <section name="AddBlock_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="AddBlockDialog" button-text="Add Block">
                            <form-single name="AddBlockForm" transition="createBlock">
                                <field name="pageId"><default-field><hidden/></default-field></field>
                                <field name="blockType"><default-field title="Type">
                                    <drop-down><entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="WebBlockType"/>
                                            <order-by field-name="sequenceNum"/>
                                        </entity-find></entity-options></drop-down></default-field></field>
                                <field name="blockOrder"><default-field title="Order"><text-line size="4" default-value="10"/></default-field></field>
                                <field name="title"><default-field title="Block Title"><text-line size="40"/></default-field></field>
                                <field name="content"><default-field title="Content"><text-area rows="6" cols="50"/></default-field></field>
                                <field name="imageUrl"><default-field title="Image URL"><text-line size="60"/></default-field></field>
                                <field name="linkUrl"><default-field title="Link URL"><text-line size="60"/></default-field></field>
                                <field name="linkText"><default-field title="Link Text"><text-line size="20"/></default-field></field>
                                <field name="isActive"><default-field title="Active">
                                    <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add Block"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </box-toolbar>
                    <box-body>
                        <form-list name="BlockList" list="blockList" transition="updateBlock">
                            <field name="blockId"><default-field title="ID"><display/></default-field></field>
                            <field name="blockType"><default-field title="Type">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                            <field name="blockOrder"><default-field title="Order"><text-line size="3"/></default-field></field>
                            <field name="title"><default-field title="Title"><text-line size="20"/></default-field></field>
                            <field name="content"><default-field title="Content"><text-area rows="3" cols="30"/></default-field></field>
                            <field name="imageUrl"><default-field title="Image"><text-line size="25"/></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton">
                                <conditional-field name="block_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                                <default-field title="Save"><label text="" type="span"/></default-field>
                            </field>
                            <field name="deleteBtn">
                                <conditional-field name="block_delete_write" condition="modCanWrite" title="">
                                <link url="deleteBlock" text="X" parameter-map="[blockId:blockId]"
                                      confirmation="Delete this block?"/></conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>

            <row-col lg="4" md="12">
                <!-- SEO & Meta -->
                <container-box><box-header title="SEO &amp; Settings"/>
                <box-body>
                    <form-single name="SeoForm" transition="updatePage" map="page">
                        <field name="pageId"><default-field><hidden/></default-field></field>
                        <field name="metaTitle"><default-field title="SEO Title"><text-line size="35"/></default-field></field>
                        <field name="metaDescription"><default-field title="SEO Description"><text-area rows="3" cols="35"/></default-field></field>
                        <field name="metaKeywords"><default-field title="Keywords"><text-line size="35"/></default-field></field>
                        <field name="tags"><default-field title="Tags"><text-line size="35"/></default-field></field>
                        <field name="featuredImageUrl"><default-field title="Featured Image URL"><text-line size="35"/></default-field></field>
                        <field name="templateId"><default-field title="Template">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="WebPageTemplate"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="locale"><default-field title="Language">
                            <drop-down>
                                <option key="en" text="English"/><option key="hi" text="Hindi"/>
                                <option key="ta" text="Tamil"/><option key="te" text="Telugu"/>
                            </drop-down></default-field></field>
                        <field name="pageType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="WebPageType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="blogCategoryId"><default-field title="Blog Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.website.BlogCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="allowComments"><default-field title="Allow Comments">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="seo_save_write" condition="modCanWrite" title="Save SEO"><submit/></conditional-field>
                            <default-field title="Save SEO"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Publish Actions -->
                <container-box><box-header title="Publish"/>
                <box-body>
                    <form-single name="PublishInfo" map="page">
                        <field name="isPublished"><default-field title="Status"><display text="${isPublished == 'Y' ? 'Published' : 'Draft'}"/></default-field></field>
                        <field name="publishDate"><default-field title="Published"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="viewCount"><default-field title="Views"><display/></default-field></field>
                    </form-single>
                    <section name="PublishActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <section name="PublishActions" condition="page.isPublished != 'Y'"><widgets>
                        <link url="publishPage" text="Publish Now" parameter-map="[pageId:pageId]"
                              confirmation="Publish this page?"/>
                    </widgets><fail-widgets>
                        <link url="unpublishPage" text="Unpublish" parameter-map="[pageId:pageId]"
                              confirmation="Unpublish this page?"/>
                    </fail-widgets></section>
                    </widgets></section>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
