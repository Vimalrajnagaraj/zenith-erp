<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Site" default-menu-index="2" default-menu-include="false">

    <parameter name="siteId" required="true"/>

    <transition name="updateSite" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebSite"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTheme" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebTheme"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.website.WebSite" value-field="site"/>
        <entity-find-one entity-name="zenith.erp.website.WebTheme" value-field="theme">
            <field-map field-name="themeId" from="site.themeId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.website.WebPage" list="pageCount">
            <econdition field-name="siteId"/></entity-find>
        <entity-find entity-name="zenith.erp.website.WebMenu" list="menuCount">
            <econdition field-name="siteId"/></entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6" md="12">
                <container-box><box-header title="Site Settings"/>
                <box-body>
                    <form-single name="SiteForm" transition="updateSite" map="site">
                        <field name="siteId"><default-field><hidden/></default-field></field>
                        <field name="siteName"><default-field title="Site Name"><text-line size="30"/></default-field></field>
                        <field name="domain"><default-field title="Domain"><text-line size="40"/></default-field></field>
                        <field name="organizationPartyId"><default-field title="Organization">
                            <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName}">
                                <entity-find entity-name="mantle.party.Organization"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="themeId"><default-field title="Theme">
                            <drop-down><entity-options key="${themeId}" text="${themeName}">
                                <entity-find entity-name="zenith.erp.website.WebTheme">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="defaultLocale"><default-field title="Default Language">
                            <drop-down>
                                <option key="en" text="English"/><option key="hi" text="Hindi"/>
                                <option key="ta" text="Tamil"/><option key="te" text="Telugu"/>
                                <option key="kn" text="Kannada"/><option key="mr" text="Marathi"/>
                                <option key="bn" text="Bengali"/><option key="gu" text="Gujarati"/>
                            </drop-down></default-field></field>
                        <field name="metaTitle"><default-field title="SEO Title"><text-line size="50"/></default-field></field>
                        <field name="metaDescription"><default-field title="SEO Description"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="logoUrl"><default-field title="Logo URL"><text-line size="60"/></default-field></field>
                        <field name="faviconUrl"><default-field title="Favicon URL"><text-line size="60"/></default-field></field>
                        <field name="headerScript"><default-field title="Header Script"><text-area rows="4" cols="50"/></default-field></field>
                        <field name="footerScript"><default-field title="Footer Script"><text-area rows="4" cols="50"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="site_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="6" md="12">
                <container-box><box-header title="Theme: ${theme?.themeName ?: 'None'}"/>
                <box-body>
                    <section name="ThemeSection" condition="theme">
                        <widgets>
                            <form-single name="ThemeForm" transition="updateTheme" map="theme">
                                <field name="themeId"><default-field><hidden/></default-field></field>
                                <field name="themeName"><default-field title="Theme Name"><text-line size="25"/></default-field></field>
                                <field name="primaryColor"><default-field title="Primary Color"><text-line size="10"/></default-field></field>
                                <field name="secondaryColor"><default-field title="Secondary Color"><text-line size="10"/></default-field></field>
                                <field name="accentColor"><default-field title="Accent Color"><text-line size="10"/></default-field></field>
                                <field name="fontFamily"><default-field title="Body Font"><text-line size="30"/></default-field></field>
                                <field name="headingFont"><default-field title="Heading Font"><text-line size="30"/></default-field></field>
                                <field name="customCss"><default-field title="Custom CSS"><text-area rows="6" cols="45"/></default-field></field>
                                <field name="submitButton">
                                    <conditional-field name="theme_save_write" condition="modCanWrite" title="Save Theme"><submit/></conditional-field>
                                    <default-field title="Save Theme"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                                </field>
                            </form-single>
                        </widgets>
                    </section>
                </box-body></container-box>

                <container-box><box-header title="Statistics"/>
                <box-body>
                    <form-single name="StatsForm">
                        <field name="pages"><default-field title="Total Pages"><display text="${pageCount?.size() ?: 0}"/></default-field></field>
                        <field name="menus"><default-field title="Menus"><display text="${menuCount?.size() ?: 0}"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
