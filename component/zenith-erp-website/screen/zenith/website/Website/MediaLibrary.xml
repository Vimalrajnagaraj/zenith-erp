<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Media Library" default-menu-index="8">

    <transition name="createMedia" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebMedia"/>
        <default-response url="."/>
    </transition>
    <transition name="updateMedia" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebMedia"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteMedia" begin-transaction="true">
        <service-call name="delete#zenith.erp.website.WebMedia"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning WebSite -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.website.WebSite" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="siteId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.siteId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.website.WebMedia" list="mediaList">
            <search-form-inputs default-order-by="-uploadDate"/>
            <econdition field-name="siteId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Media Library"/>
            <box-toolbar>
                <container-dialog id="AddMediaDialog" button-text="Add Media">
                    <form-single name="AddMediaForm" transition="createMedia">
                        <field name="siteId"><default-field title="Site">
                            <drop-down><entity-options key="${siteId}" text="${siteName}">
                                <entity-find entity-name="zenith.erp.website.WebSite">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fileName"><default-field title="File Name"><text-line size="30"/></default-field></field>
                        <field name="fileUrl"><default-field title="File URL"><text-line size="60"/></default-field></field>
                        <field name="fileType"><default-field title="File Type">
                            <drop-down>
                                <option key="image/jpeg" text="JPEG Image"/>
                                <option key="image/png" text="PNG Image"/>
                                <option key="image/svg+xml" text="SVG Image"/>
                                <option key="image/webp" text="WebP Image"/>
                                <option key="application/pdf" text="PDF Document"/>
                                <option key="video/mp4" text="MP4 Video"/>
                                <option key="other" text="Other"/>
                            </drop-down></default-field></field>
                        <field name="fileSizeBytes"><default-field title="Size (bytes)"><text-line size="10"/></default-field></field>
                        <field name="altText"><default-field title="Alt Text"><text-line size="40"/></default-field></field>
                        <field name="caption"><default-field title="Caption"><text-line size="40"/></default-field></field>
                        <field name="folder"><default-field title="Folder"><text-line size="20" default-value="/"/></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="MediaList" list="mediaList" transition="updateMedia"
                           header-dialog="true" select-columns="true" saved-finds="true"
                           show-csv-button="true">
                    <field name="mediaId"><default-field title="ID"><display/></default-field></field>
                    <field name="fileName"><header-field title="File Name" show-order-by="true"><text-find/></header-field>
                        <default-field><text-line size="20"/></default-field></field>
                    <field name="fileUrl"><default-field title="URL"><text-line size="30"/></default-field></field>
                    <field name="fileType"><header-field title="Type">
                            <drop-down allow-empty="true">
                                <option key="image/jpeg" text="JPEG"/><option key="image/png" text="PNG"/>
                                <option key="image/svg+xml" text="SVG"/><option key="application/pdf" text="PDF"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="fileSizeBytes"><default-field title="Size"><display/></default-field></field>
                    <field name="altText"><default-field title="Alt Text"><text-line size="20"/></default-field></field>
                    <field name="folder"><header-field title="Folder"><text-find/></header-field>
                        <default-field><text-line size="10"/></default-field></field>
                    <field name="siteId"><default-field title="Site">
                        <display-entity entity-name="zenith.erp.website.WebSite" text="${siteName}"/></default-field></field>
                    <field name="uploadDate"><header-field title="Uploaded" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="submitButton"><header-field title="Find"><submit/></header-field>
                        <default-field title="Save"><submit/></default-field></field>
                    <field name="deleteBtn"><default-field title="">
                        <link url="deleteMedia" text="X" parameter-map="[mediaId:mediaId]"
                              confirmation="Delete this media?"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
