<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sites" default-menu-index="1">

    <transition name="createSite" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebSite"/>
        <default-response url="."/>
    </transition>
    <transition name="updateSite" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebSite"/>
        <default-response url="."/>
    </transition>
    <transition name="editSite"><default-response url="../EditSite"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.website.WebSite" list="siteList">
            <order-by field-name="siteName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Web Sites"/>
            <box-toolbar>
                <container-dialog id="CreateSiteDialog" button-text="New Site">
                    <form-single name="CreateSiteForm" transition="createSite">
                        <field name="siteId"><default-field title="Site ID"><text-line size="15"/></default-field></field>
                        <field name="siteName"><default-field title="Site Name"><text-line size="30"/></default-field></field>
                        <field name="domain"><default-field title="Domain"><text-line size="40"/></default-field></field>
                        <field name="organizationPartyId"><default-field title="Organization">
                            <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName}">
                                <entity-find entity-name="mantle.party.Organization"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="themeId"><default-field title="Theme">
                            <drop-down no-current-selected-key="THEME_DEFAULT">
                                <entity-options key="${themeId}" text="${themeName}">
                                    <entity-find entity-name="zenith.erp.website.WebTheme">
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                        <field name="defaultLocale"><default-field title="Default Language">
                            <drop-down no-current-selected-key="en">
                                <option key="en" text="English"/>
                                <option key="hi" text="Hindi"/>
                                <option key="ta" text="Tamil"/>
                                <option key="te" text="Telugu"/>
                                <option key="kn" text="Kannada"/>
                                <option key="mr" text="Marathi"/>
                                <option key="bn" text="Bengali"/>
                                <option key="gu" text="Gujarati"/>
                            </drop-down></default-field></field>
                        <field name="metaTitle"><default-field title="SEO Title"><text-line size="50"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="SiteList" list="siteList" skip-form="true">
                    <field name="siteId"><default-field title="ID">
                        <link url="editSite" text="${siteId}" link-type="anchor"
                              parameter-map="[siteId:siteId]"/></default-field></field>
                    <field name="siteName"><default-field title="Name"><display/></default-field></field>
                    <field name="domain"><default-field title="Domain"><display/></default-field></field>
                    <field name="themeId"><default-field title="Theme">
                        <display-entity entity-name="zenith.erp.website.WebTheme" text="${themeName}"/></default-field></field>
                    <field name="defaultLocale"><default-field title="Language"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><display/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
