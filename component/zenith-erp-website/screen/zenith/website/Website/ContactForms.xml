<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact Forms" default-menu-index="7">

    <transition name="createForm" begin-transaction="true">
        <service-call name="create#zenith.erp.website.WebContactForm"/>
        <default-response url="."/>
    </transition>
    <transition name="updateForm" begin-transaction="true">
        <service-call name="update#zenith.erp.website.WebContactForm"/>
        <default-response url="."/>
    </transition>
    <transition name="markRead" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.markRead#ContactSubmission"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.website.WebContactForm" list="formList">
            <order-by field-name="formName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.website.WebContactSubmissionView" list="submissionList">
            <search-form-inputs default-order-by="-submittedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Contact Forms -->
        <container-box>
            <box-header title="Contact Forms"/>
            <box-toolbar>
                <container-dialog id="CreateFormDialog" button-text="New Form">
                    <form-single name="CreateFormForm" transition="createForm">
                        <field name="formId"><default-field title="Form ID"><text-line size="15"/></default-field></field>
                        <field name="siteId"><default-field title="Site">
                            <drop-down><entity-options key="${siteId}" text="${siteName}">
                                <entity-find entity-name="zenith.erp.website.WebSite">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="formName"><default-field title="Form Name"><text-line size="25"/></default-field></field>
                        <field name="emailTo"><default-field title="Send To Email"><text-line size="35"/></default-field></field>
                        <field name="successMessage"><default-field title="Success Message">
                            <text-area rows="2" cols="40" default-value="Thank you for contacting us!"/></default-field></field>
                        <field name="createLeadInCrm"><default-field title="Auto-Create CRM Lead">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="FormList" list="formList" transition="updateForm">
                    <field name="formId"><default-field title="ID"><display/></default-field></field>
                    <field name="formName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="siteId"><default-field title="Site">
                        <display-entity entity-name="zenith.erp.website.WebSite" text="${siteName}"/></default-field></field>
                    <field name="emailTo"><default-field title="Email To"><text-line size="25"/></default-field></field>
                    <field name="createLeadInCrm"><default-field title="CRM Lead">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Submissions -->
        <container-box>
            <box-header title="Contact Submissions"/>
            <box-body>
                <form-list name="SubmissionList" list="submissionList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true">
                    <field name="submissionId"><default-field title="ID"><display/></default-field></field>
                    <field name="formName"><header-field title="Form" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="name"><header-field title="Name"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="email"><header-field title="Email"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="company"><default-field title="Company"><display/></default-field></field>
                    <field name="subject"><default-field title="Subject"><display/></default-field></field>
                    <field name="message"><default-field title="Message"><display/></default-field></field>
                    <field name="submittedDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="isRead"><header-field title="Read">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="leadId"><default-field title="CRM Lead"><display/></default-field></field>
                    <field name="actions"><default-field title="">
                        <link url="markRead" text="Mark Read" parameter-map="[submissionId:submissionId]"
                              condition="isRead != 'Y'"/>
                    </default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
