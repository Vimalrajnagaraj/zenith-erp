<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Blog" default-menu-index="6">

    <transition name="createCategory" begin-transaction="true">
        <service-call name="create#zenith.erp.website.BlogCategory"/>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <service-call name="update#zenith.erp.website.BlogCategory"/>
        <default-response url="."/>
    </transition>
    <transition name="editPage"><default-response url="../EditPage"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.website.BlogCategory" list="categoryList">
            <order-by field-name="categoryName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.website.WebPageView" list="blogPosts">
            <econdition field-name="pageType" value="WptBlog"/>
            <search-form-inputs default-order-by="-publishDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Blog Categories -->
        <container-box>
            <box-header title="Blog Categories"/>
            <box-toolbar>
                <section name="CreateCategory_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCategoryDialog" button-text="New Category">
                    <form-single name="CreateCategoryForm" transition="createCategory">
                        <field name="categoryId"><default-field title="Category ID"><text-line size="15"/></default-field></field>
                        <field name="siteId"><default-field title="Site">
                            <drop-down><entity-options key="${siteId}" text="${siteName}">
                                <entity-find entity-name="zenith.erp.website.WebSite">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="categoryName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="slug"><default-field title="Slug"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CategoryList" list="categoryList" transition="updateCategory">
                    <field name="categoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="slug"><default-field title="Slug"><text-line size="20"/></default-field></field>
                    <field name="siteId"><default-field title="Site">
                        <display-entity entity-name="zenith.erp.website.WebSite" text="${siteName}"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="cat_update_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title="Update"><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Blog Posts -->
        <container-box>
            <box-header title="Blog Posts"/>
            <box-body>
                <form-list name="BlogPostList" list="blogPosts" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <field name="pageId"><default-field title="ID">
                        <link url="editPage" text="${pageId}" link-type="anchor"
                              parameter-map="[pageId:pageId]"/></default-field></field>
                    <field name="title"><header-field title="Title" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="slug"><default-field title="Slug"><display/></default-field></field>
                    <field name="categoryName"><header-field title="Category" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="siteName"><default-field title="Site"><display/></default-field></field>
                    <field name="locale"><default-field title="Lang"><display/></default-field></field>
                    <field name="tags"><default-field title="Tags"><display/></default-field></field>
                    <field name="isPublished"><header-field title="Published">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="publishDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="viewCount"><default-field title="Views"><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
