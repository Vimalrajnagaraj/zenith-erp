<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pages" default-menu-index="3">

    <transition name="createPage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.create#WebPage"/>
        <default-response url="../EditPage"/>
    </transition>
    <transition name="publishPage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.publish#WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="unpublishPage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.unpublish#WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="duplicatePage" begin-transaction="true">
        <service-call name="zenith.website.WebsiteServices.duplicate#WebPage"/>
        <default-response url="."/>
    </transition>
    <transition name="editPage"><default-response url="../EditPage"/></transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning WebSite -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.website.WebSite" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="siteId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.siteId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.website.WebPageView" list="pageList">
            <search-form-inputs default-order-by="-lastUpdated"/>
            <econdition field-name="siteId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Web Pages"/>
            <box-toolbar>
                <section name="CreatePage_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreatePageDialog" button-text="New Page">
                    <form-single name="CreatePageForm" transition="createPage">
                        <field name="siteId"><default-field title="Site">
                            <drop-down><entity-options key="${siteId}" text="${siteName}">
                                <entity-find entity-name="zenith.erp.website.WebSite">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="title"><default-field title="Title"><text-line size="40"/></default-field></field>
                        <field name="slug"><default-field title="Slug (auto if blank)"><text-line size="40"/></default-field></field>
                        <field name="pageType"><default-field title="Type">
                            <drop-down no-current-selected-key="WptPage"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="WebPageType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="locale"><default-field title="Language">
                            <drop-down no-current-selected-key="en">
                                <option key="en" text="English"/><option key="hi" text="Hindi"/>
                            </drop-down></default-field></field>
                        <field name="templateId"><default-field title="Template">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="WebPageTemplate"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="blogCategoryId"><default-field title="Blog Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.website.BlogCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Pages..." style="display:none"></span>]]></text></render-mode>
            <form-list name="PageList" list="pageList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true">
                    <field name="pageId"><default-field title="ID">
                        <link url="editPage" text="${pageId}" link-type="anchor"
                              parameter-map="[pageId:pageId]"/></default-field></field>
                    <field name="title"><header-field title="Title" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="slug"><default-field title="Slug"><display/></default-field></field>
                    <field name="siteName"><header-field title="Site" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="pageType"><header-field title="Type">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="WebPageType"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="locale"><default-field title="Lang"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Category"><display/></default-field></field>
                    <field name="isPublished"><header-field title="Published">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="publishDate"><header-field title="Published Date" show-order-by="true"/>
                        <default-field><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="lastUpdated"><header-field title="Updated" show-order-by="true"/>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="viewCount"><default-field title="Views"><display/></default-field></field>
                    <field name="actions">
                        <conditional-field name="page_actions_write" condition="modCanWrite" title="Actions">
                        <link url="publishPage" text="Publish" parameter-map="[pageId:pageId]"
                              condition="isPublished != 'Y'"/>
                        <link url="unpublishPage" text="Unpublish" parameter-map="[pageId:pageId]"
                              condition="isPublished == 'Y'"/>
                        <link url="duplicatePage" text="Copy" parameter-map="[pageId:pageId]"/>
                        </conditional-field>
                        <default-field title="Actions"><label text="" type="span"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
