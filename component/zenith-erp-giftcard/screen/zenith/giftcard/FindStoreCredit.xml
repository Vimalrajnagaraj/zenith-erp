<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Store Credits" default-menu-index="3">

    <transition name="issueStoreCredit">
        <service-call name="zenith.giftcard.GiftCardServices.issue#StoreCredit"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.giftcard.StoreCredit" list="credits">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-createdDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Store Credits" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="IssueCredit" button-text="Issue Store Credit" type="success">
                <form-single name="IssueCreditForm" transition="issueStoreCredit">
                    <field name="partyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName} ${lastName}">
                            <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                <econdition field-name="roleTypeId" value="Customer"/>
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="amount"><default-field title="Amount"><text-line size="12"/></default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <drop-down><entity-options key="${uomId}" text="${abbreviation}">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                <order-by field-name="abbreviation"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="reasonEnumId"><default-field title="Reason">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="StoreCreditReason"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="expiryDays"><default-field title="Expiry (days)"><text-line size="8"/></default-field></field>
                    <field name="submitBtn"><default-field title="Issue Credit"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="StoreCreditsForm" list="credits" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="creditId"><default-field title="ID"><display/></default-field></field>
                <field name="partyId"><header-field show-order-by="true"><text-find size="12"/></header-field>
                    <default-field title="Customer">
                        <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                        text="${organizationName}${firstName} ${lastName}"/>
                    </default-field></field>
                <field name="balance"><header-field show-order-by="true"/>
                    <default-field><display format="#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Cur"><display/></default-field></field>
                <field name="reasonEnumId"><header-field title="Reason">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="StoreCreditReason"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Reason">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="createdDate"><default-field title="Issued"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="expiryDate"><default-field title="Expires"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
