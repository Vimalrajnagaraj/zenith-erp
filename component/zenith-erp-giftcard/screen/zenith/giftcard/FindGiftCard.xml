<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gift Cards" default-menu-index="2">

    <transition name="editGiftCard"><default-response url="../EditGiftCard"/></transition>
    <transition name="issueGiftCard">
        <service-call name="zenith.giftcard.GiftCardServices.issue#GiftCard"/>
        <default-response url="../EditGiftCard"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.giftcard.GiftCard" list="giftCards">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-issuedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Gift Cards" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="IssueCard" button-text="Issue Gift Card" type="success">
                <form-single name="IssueCardForm" transition="issueGiftCard">
                    <field name="initialBalance"><default-field title="Amount"><text-line size="12"/></default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <drop-down><entity-options key="${uomId}" text="${abbreviation}">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                <order-by field-name="abbreviation"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="issuedToPartyId"><default-field title="Issue To">
                        <drop-down allow-empty="true"><entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}">
                            <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                <econdition field-name="roleTypeId" value="Customer"/>
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="isPhysical"><default-field title="Physical Card?">
                        <drop-down><option key="N" text="Digital"/><option key="Y" text="Physical"/></drop-down>
                    </default-field></field>
                    <field name="expiryDays"><default-field title="Expiry (days)"><text-line size="8"/></default-field></field>
                    <field name="notes"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Issue"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="GiftCardsForm" list="giftCards" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="cardNumber"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Card #">
                        <link url="editGiftCard" text="${cardNumber}" parameter-map="[giftCardId:giftCardId]"/>
                    </default-field></field>
                <field name="initialBalance"><default-field title="Initial"><display format="#,##0.00"/></default-field></field>
                <field name="currentBalance"><header-field show-order-by="true"/>
                    <default-field title="Balance"><display format="#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Cur"><display/></default-field></field>
                <field name="isPhysical"><default-field title="Type">
                    <display text="${isPhysical == 'Y' ? 'Physical' : 'Digital'}"/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="GcActive" text="Active"/><option key="GcUsed" text="Used"/>
                        <option key="GcExpired" text="Expired"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
                <field name="issuedDate"><default-field title="Issued"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="expiryDate"><default-field title="Expires"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
