<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gift Card Detail" default-menu-include="false">

    <parameter name="giftCardId" required="true"/>

    <transition name="updateGiftCard">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (prevent cross-tenant IDOR edit) -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="zenith.erp.giftcard.GiftCard" value-field="curCard"/>
            <if condition="curCard == null || (activeOrg &amp;&amp; curCard.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Gift card not found for your account."/>
            </if>
            <service-call name="update#zenith.erp.giftcard.GiftCard" in-map="[giftCardId:giftCardId, cardNumber:cardNumber, pin:pin, initialBalance:initialBalance, currentBalance:currentBalance, currencyUomId:currencyUomId, isPhysical:isPhysical, issuedToPartyId:issuedToPartyId, issuedDate:issuedDate, expiryDate:expiryDate, statusId:statusId, notes:notes]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="loadGiftCard">
        <service-call name="zenith.giftcard.GiftCardServices.load#GiftCard"/>
        <default-response url="."/>
    </transition>
    <transition name="redeemGiftCard">
        <service-call name="zenith.giftcard.GiftCardServices.redeem#GiftCard"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.giftcard.GiftCard" value-field="card"/>
        <!-- Org ownership check: do not reveal PIN/balance of another org's card -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="!card || (activeOrg &amp;&amp; card.organizationPartyId != activeOrg)">
            <script>sri.sendRedirectAndStopRender("/apps/zenith/giftcard/FindGiftCard")</script>
            <return/>
        </if>
        <entity-find entity-name="zenith.erp.giftcard.GiftCardTransaction" list="transactions">
            <econdition field-name="giftCardId"/>
            <order-by field-name="-transactionDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Gift Card: ${card.cardNumber}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <!-- Card Details -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Card Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="CardForm" map="card" transition="updateGiftCard">
                        <field name="giftCardId"><default-field><hidden/></default-field></field>
                        <field name="cardNumber"><default-field title="Card Number"><display/></default-field></field>
                        <field name="pin"><default-field title="PIN"><display/></default-field></field>
                        <field name="initialBalance"><default-field title="Initial Balance"><display format="#,##0.00"/></default-field></field>
                        <field name="currentBalance"><default-field title="Current Balance"><display format="#,##0.00"/></default-field></field>
                        <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                        <field name="isPhysical"><default-field title="Type">
                            <display text="${isPhysical == 'Y' ? 'Physical' : 'Digital'}"/></default-field></field>
                        <field name="issuedToPartyId"><default-field title="Issued To">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}"/>
                        </default-field></field>
                        <field name="issuedDate"><default-field title="Issued Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expiry Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <entity-options key="${toStatusId}" text="${transitionName}">
                                    <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                        <econdition field-name="statusFlowId" value="Default"/>
                                        <econdition field-name="statusId" from="card.statusId"/>
                                    </entity-find>
                                </entity-options>
                                <option key="${card.statusId}" text="${card.statusId}"/>
                            </drop-down></default-field></field>
                        <field name="notes"><default-field><text-area rows="2" cols="50"/></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <!-- Transaction History -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Transaction History" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="TransactionsList" list="transactions" skip-form="true">
                        <field name="transactionDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="transactionTypeEnumId"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="amount"><default-field><display format="#,##0.00"/></default-field></field>
                        <field name="balanceAfter"><default-field title="Balance After"><display format="#,##0.00"/></default-field></field>
                        <field name="referenceType"><default-field title="Ref Type"><display/></default-field></field>
                        <field name="referenceId"><default-field title="Ref #"><display/></default-field></field>
                        <field name="notes"><default-field><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <!-- Balance Card -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Current Balance" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(card.currentBalance, '#,##0.00')} ${card.currencyUomId}" type="h3"
                           style="text-positive text-weight-bold q-my-sm"/>
                    <label text="Status: ${card.statusId}" type="p" style="q-mt-sm"/>
                </container>

                <!-- Quick Actions -->
                <section name="ActiveActionsSection" condition="card.statusId == 'GcActive'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <label text="Top-up Card" type="h6" style="text-weight-bold q-mb-md"/>
                            <form-single name="LoadForm" transition="loadGiftCard">
                                <field name="giftCardId" from="card.giftCardId"><default-field><hidden/></default-field></field>
                                <field name="amount"><default-field title="Amount"><text-line size="10"/></default-field></field>
                                <field name="notes"><default-field><text-area rows="2" cols="30"/></default-field></field>
                                <field name="submitBtn"><default-field title="Load Balance"><submit type="success"/></default-field></field>
                            </form-single>
                        </container>

                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                            <label text="Redeem" type="h6" style="text-weight-bold q-mb-md"/>
                            <form-single name="RedeemForm" transition="redeemGiftCard">
                                <field name="giftCardId" from="card.giftCardId"><default-field><hidden/></default-field></field>
                                <field name="amount"><default-field title="Amount"><text-line size="10"/></default-field></field>
                                <field name="referenceType"><default-field title="Ref Type"><text-line size="15"/></default-field></field>
                                <field name="referenceId"><default-field title="Ref #"><text-line size="15"/></default-field></field>
                                <field name="submitBtn"><default-field title="Redeem"><submit type="warning"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>
            </row-col>
        </container-row>
    </widgets>
</screen>
