<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-count entity-name="zenith.erp.giftcard.GiftCard" count-field="activeCards">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <econdition field-name="statusId" value="GcActive"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.giftcard.GiftCard" count-field="totalCards">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.giftcard.StoreCredit" count-field="activeCredits">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <econdition field-name="balance" operator="greater" from="0"/>
        </entity-find-count>
        <entity-find entity-name="zenith.erp.giftcard.GiftCardTransaction" list="recentTxns" limit="10">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <order-by field-name="-transactionDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Gift Cards &amp; Store Credit" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Issue gift cards, manage store credits, and track balances." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Gift Cards" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${activeCards}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-pink-1 border-radius-md text-pink-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="card_giftcard" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Total Issued" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalCards}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="inventory_2" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Store Credits" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${activeCredits}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-teal-1 border-radius-md text-teal-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="account_balance_wallet" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Transactions" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentTxns" list="recentTxns" skip-form="true">
                <field name="giftCardId"><default-field title="Card"><display/></default-field></field>
                <field name="transactionTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="amount"><default-field><display format="#,##0.00"/></default-field></field>
                <field name="balanceAfter"><default-field title="Balance"><display format="#,##0.00"/></default-field></field>
                <field name="transactionDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
