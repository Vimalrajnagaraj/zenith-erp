<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Gift Card ========== -->
    <entity entity-name="GiftCard" package="zenith.erp.giftcard" table-name="ZENITH_GIFT_CARD" short-alias="GiftCards">
        <field name="giftCardId" type="id" is-pk="true"/>
        <field name="cardNumber" type="text-short"/>
        <field name="pin" type="text-short"/>
        <field name="initialBalance" type="currency-precise"/>
        <field name="currentBalance" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="issuedDate" type="date-time"/>
        <field name="expiryDate" type="date-time"/>
        <field name="isPhysical" type="text-indicator" default="'N'"/>
        <field name="issuedToPartyId" type="id"/>
        <field name="purchasedByPartyId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="statusId" type="id" default="'GcActive'"/>
        <field name="notes" type="text-long"/>
        <index name="GC_NUMBER" unique="true">
            <index-field name="cardNumber"/>
        </index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="GiftCard" description="Gift Card"/>
            <moqui.basic.StatusItem statusId="GcActive" statusTypeId="GiftCard" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="GcUsed" statusTypeId="GiftCard" description="Fully Used" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="GcExpired" statusTypeId="GiftCard" description="Expired" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="GcSuspended" statusTypeId="GiftCard" description="Suspended" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="GcCancelled" statusTypeId="GiftCard" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcActive" toStatusId="GcUsed" transitionName="Fully Used"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcActive" toStatusId="GcExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcActive" toStatusId="GcSuspended" transitionName="Suspend"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcActive" toStatusId="GcCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcSuspended" toStatusId="GcActive" transitionName="Reactivate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GcSuspended" toStatusId="GcCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== Gift Card Transaction ========== -->
    <entity entity-name="GiftCardTransaction" package="zenith.erp.giftcard" short-alias="GiftCardTransactions">
        <field name="transactionId" type="id" is-pk="true"/>
        <field name="giftCardId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="transactionTypeEnumId" type="id"/>
        <field name="amount" type="currency-precise"/>
        <field name="balanceAfter" type="currency-precise"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="transactionDate" type="date-time"/>
        <field name="performedByUserId" type="id"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.giftcard.GiftCard"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="GiftCardTxnType" description="Gift Card Transaction Type"/>
            <moqui.basic.Enumeration enumId="GctLoad" enumTypeId="GiftCardTxnType" description="Load/Top-up" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="GctRedeem" enumTypeId="GiftCardTxnType" description="Redeem" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="GctRefund" enumTypeId="GiftCardTxnType" description="Refund" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="GctExpire" enumTypeId="GiftCardTxnType" description="Expiry" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="GctAdjust" enumTypeId="GiftCardTxnType" description="Adjustment" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== Store Credit ========== -->
    <entity entity-name="StoreCredit" package="zenith.erp.giftcard" short-alias="StoreCredits">
        <field name="creditId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="balance" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="reasonEnumId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="expiryDate" type="date-time"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="mantle.party.Party"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="StoreCreditReason" description="Store Credit Reason"/>
            <moqui.basic.Enumeration enumId="ScrReturn" enumTypeId="StoreCreditReason" description="Return/Exchange" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="ScrGoodwill" enumTypeId="StoreCreditReason" description="Goodwill/Compensation" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="ScrPromotion" enumTypeId="StoreCreditReason" description="Promotional" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="ScrOverpayment" enumTypeId="StoreCreditReason" description="Overpayment" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== Store Credit Transaction ========== -->
    <entity entity-name="StoreCreditTransaction" package="zenith.erp.giftcard" short-alias="StoreCreditTransactions">
        <field name="transactionId" type="id" is-pk="true"/>
        <field name="creditId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="transactionTypeEnumId" type="id"/>
        <field name="amount" type="currency-precise"/>
        <field name="balanceAfter" type="currency-precise"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="transactionDate" type="date-time"/>
        <field name="performedByUserId" type="id"/>
        <relationship type="one" related="zenith.erp.giftcard.StoreCredit"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="StoreCreditTxnType" description="Store Credit Transaction Type"/>
            <moqui.basic.Enumeration enumId="SctCredit" enumTypeId="StoreCreditTxnType" description="Credit" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SctDebit" enumTypeId="StoreCreditTxnType" description="Debit/Use" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SctRefund" enumTypeId="StoreCreditTxnType" description="Refund to Credit" sequenceNum="3"/>
        </seed-data>
    </entity>

</entities>
