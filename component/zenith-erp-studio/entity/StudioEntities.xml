<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Custom Field Definition -->
    <entity entity-name="CustomFieldDef" package="zenith.erp.studio" short-alias="CustomFieldDefs">
        <field name="fieldDefId" type="id" is-pk="true"/>
        <field name="targetEntity" type="text-medium"/>
        <field name="fieldName" type="text-short"/>
        <field name="fieldLabel" type="text-medium"/>
        <field name="fieldType" type="id"/>
        <field name="defaultValue" type="text-medium"/>
        <field name="isRequired" type="text-indicator" default="'N'"/>
        <field name="dropdownOptions" type="text-long"/>
        <field name="validationRegex" type="text-medium"/>
        <field name="helpText" type="text-medium"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdByPartyId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="CustomFieldType" description="Custom Field Type"/>
            <moqui.basic.Enumeration enumId="CfText" enumTypeId="CustomFieldType" description="Text" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CfTextArea" enumTypeId="CustomFieldType" description="Text Area" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CfNumber" enumTypeId="CustomFieldType" description="Number" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CfDecimal" enumTypeId="CustomFieldType" description="Decimal" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="CfDate" enumTypeId="CustomFieldType" description="Date" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="CfDateTime" enumTypeId="CustomFieldType" description="Date-Time" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="CfDropdown" enumTypeId="CustomFieldType" description="Dropdown" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="CfCheckbox" enumTypeId="CustomFieldType" description="Checkbox (Y/N)" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="CfEmail" enumTypeId="CustomFieldType" description="Email" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="CfPhone" enumTypeId="CustomFieldType" description="Phone" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="CfUrl" enumTypeId="CustomFieldType" description="URL" sequenceNum="11"/>
            <moqui.basic.Enumeration enumId="CfCurrency" enumTypeId="CustomFieldType" description="Currency (INR)" sequenceNum="12"/>
        </seed-data>
    </entity>

    <!-- Custom Field Value (EAV pattern) -->
    <entity entity-name="CustomFieldValue" package="zenith.erp.studio" short-alias="CustomFieldValues">
        <field name="fieldValueId" type="id" is-pk="true"/>
        <field name="fieldDefId" type="id"/>
        <field name="entityId" type="id"/>
        <field name="textValue" type="text-long"/>
        <field name="numberValue" type="number-decimal"/>
        <field name="dateValue" type="date-time"/>
        <relationship type="one" related="zenith.erp.studio.CustomFieldDef"/>
    </entity>

    <!-- Custom Entity (user-created data structures) -->
    <entity entity-name="CustomEntity" package="zenith.erp.studio" short-alias="CustomEntities">
        <field name="customEntityId" type="id" is-pk="true"/>
        <field name="entityLabel" type="text-medium"/>
        <field name="entityCode" type="text-short"/>
        <field name="description" type="text-medium"/>
        <field name="iconName" type="text-short"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdByPartyId" type="id"/>
        <field name="createdDate" type="date-time"/>
    </entity>

    <!-- Custom Entity Field -->
    <entity entity-name="CustomEntityField" package="zenith.erp.studio" short-alias="CustomEntityFields">
        <field name="entityFieldId" type="id" is-pk="true"/>
        <field name="customEntityId" type="id"/>
        <field name="fieldName" type="text-short"/>
        <field name="fieldLabel" type="text-medium"/>
        <field name="fieldType" type="id"/>
        <field name="isRequired" type="text-indicator" default="'N'"/>
        <field name="defaultValue" type="text-medium"/>
        <field name="dropdownOptions" type="text-long"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.studio.CustomEntity"/>
    </entity>

    <!-- Custom Entity Record -->
    <entity entity-name="CustomEntityRecord" package="zenith.erp.studio" short-alias="CustomEntityRecords">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="customEntityId" type="id"/>
        <field name="createdByPartyId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.studio.CustomEntity"/>
    </entity>

    <!-- Custom Entity Record Value -->
    <entity entity-name="CustomEntityRecordValue" package="zenith.erp.studio" short-alias="CustomEntityRecordValues">
        <field name="recordValueId" type="id" is-pk="true"/>
        <field name="recordId" type="id"/>
        <field name="entityFieldId" type="id"/>
        <field name="textValue" type="text-long"/>
        <field name="numberValue" type="number-decimal"/>
        <field name="dateValue" type="date-time"/>
        <relationship type="one" related="zenith.erp.studio.CustomEntityRecord"/>
        <relationship type="one" related="zenith.erp.studio.CustomEntityField"/>
    </entity>

    <!-- Saved Filter -->
    <entity entity-name="SavedFilter" package="zenith.erp.studio" short-alias="SavedFilters">
        <field name="filterId" type="id" is-pk="true"/>
        <field name="filterName" type="text-medium"/>
        <field name="screenPath" type="text-medium"/>
        <field name="filterCriteria" type="text-long"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isShared" type="text-indicator" default="'N'"/>
        <field name="ownerPartyId" type="id"/>
        <field name="createdDate" type="date-time"/>
    </entity>

    <!-- Dashboard Widget -->
    <entity entity-name="DashboardWidget" package="zenith.erp.studio" short-alias="DashboardWidgets">
        <field name="widgetId" type="id" is-pk="true"/>
        <field name="widgetName" type="text-medium"/>
        <field name="widgetType" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="dataSource" type="text-medium"/>
        <field name="entityName" type="text-medium"/>
        <field name="queryFilter" type="text-long"/>
        <field name="chartType" type="id"/>
        <field name="displayConfig" type="text-long"/>
        <field name="refreshInterval" type="number-integer" default="300"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdByPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="WidgetType" description="Dashboard Widget Type"/>
            <moqui.basic.Enumeration enumId="WtCounter" enumTypeId="WidgetType" description="Counter / KPI" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="WtChart" enumTypeId="WidgetType" description="Chart" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="WtTable" enumTypeId="WidgetType" description="Data Table" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="WtList" enumTypeId="WidgetType" description="Recent List" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="WtCalendar" enumTypeId="WidgetType" description="Calendar" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="WtHtml" enumTypeId="WidgetType" description="Custom HTML" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="ChartType" description="Chart Type"/>
            <moqui.basic.Enumeration enumId="CtBar" enumTypeId="ChartType" description="Bar Chart" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CtLine" enumTypeId="ChartType" description="Line Chart" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CtPie" enumTypeId="ChartType" description="Pie Chart" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CtDonut" enumTypeId="ChartType" description="Donut Chart" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="CtArea" enumTypeId="ChartType" description="Area Chart" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="CtRadar" enumTypeId="ChartType" description="Radar Chart" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- User Dashboard Layout -->
    <entity entity-name="UserDashboard" package="zenith.erp.studio" short-alias="UserDashboards">
        <field name="userDashboardId" type="id" is-pk="true"/>
        <field name="dashboardName" type="text-medium"/>
        <field name="ownerPartyId" type="id"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isShared" type="text-indicator" default="'N'"/>
        <field name="layoutConfig" type="text-long"/>
        <field name="createdDate" type="date-time"/>
    </entity>

    <!-- Dashboard-Widget Placement -->
    <entity entity-name="DashboardWidgetPlacement" package="zenith.erp.studio" short-alias="DashboardWidgetPlacements">
        <field name="placementId" type="id" is-pk="true"/>
        <field name="userDashboardId" type="id"/>
        <field name="widgetId" type="id"/>
        <field name="positionRow" type="number-integer" default="1"/>
        <field name="positionCol" type="number-integer" default="1"/>
        <field name="widthCols" type="number-integer" default="4"/>
        <field name="heightRows" type="number-integer" default="2"/>
        <field name="sequenceNum" type="number-integer"/>
        <relationship type="one" related="zenith.erp.studio.UserDashboard"/>
        <relationship type="one" related="zenith.erp.studio.DashboardWidget"/>
    </entity>

    <!-- Print Template -->
    <entity entity-name="PrintTemplate" package="zenith.erp.studio" short-alias="PrintTemplates">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="templateName" type="text-medium"/>
        <field name="targetEntity" type="text-medium"/>
        <field name="templateType" type="id"/>
        <field name="templateContent" type="text-very-long"/>
        <field name="headerContent" type="text-long"/>
        <field name="footerContent" type="text-long"/>
        <field name="paperSize" type="text-short" default="'A4'"/>
        <field name="orientation" type="text-short" default="'Portrait'"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdByPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PrintTemplateType" description="Print Template Type"/>
            <moqui.basic.Enumeration enumId="PtInvoice" enumTypeId="PrintTemplateType" description="Invoice" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PtQuotation" enumTypeId="PrintTemplateType" description="Quotation" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PtPurchaseOrder" enumTypeId="PrintTemplateType" description="Purchase Order" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PtDeliveryChallan" enumTypeId="PrintTemplateType" description="Delivery Challan" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PtPayslip" enumTypeId="PrintTemplateType" description="Payslip" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PtReceipt" enumTypeId="PrintTemplateType" description="Receipt" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="PtReport" enumTypeId="PrintTemplateType" description="Report" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="PtLetter" enumTypeId="PrintTemplateType" description="Letter" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="PtCustom" enumTypeId="PrintTemplateType" description="Custom" sequenceNum="9"/>
        </seed-data>
    </entity>

    <!-- Automation Rule (simple workflow triggers) -->
    <entity entity-name="AutomationRule" package="zenith.erp.studio" short-alias="AutomationRules">
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="ruleName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="triggerEntity" type="text-medium"/>
        <field name="triggerEvent" type="id"/>
        <field name="conditionExpression" type="text-long"/>
        <field name="actionType" type="id"/>
        <field name="actionConfig" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="executionCount" type="number-integer" default="0"/>
        <field name="lastExecutedDate" type="date-time"/>
        <field name="createdByPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TriggerEvent" description="Automation Trigger Event"/>
            <moqui.basic.Enumeration enumId="TeOnCreate" enumTypeId="TriggerEvent" description="On Create" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TeOnUpdate" enumTypeId="TriggerEvent" description="On Update" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TeOnStatusChange" enumTypeId="TriggerEvent" description="On Status Change" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TeScheduled" enumTypeId="TriggerEvent" description="Scheduled" sequenceNum="4"/>

            <moqui.basic.EnumerationType enumTypeId="AutomationAction" description="Automation Action Type"/>
            <moqui.basic.Enumeration enumId="AaSendEmail" enumTypeId="AutomationAction" description="Send Email" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AaUpdateField" enumTypeId="AutomationAction" description="Update Field" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="AaCreateRecord" enumTypeId="AutomationAction" description="Create Record" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="AaCallService" enumTypeId="AutomationAction" description="Call Service" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="AaWebhook" enumTypeId="AutomationAction" description="Send Webhook" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="AaNotification" enumTypeId="AutomationAction" description="Send Notification" sequenceNum="6"/>
        </seed-data>
    </entity>

</entities>
