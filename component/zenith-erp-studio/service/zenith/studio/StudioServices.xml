<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="CustomField">
        <in-parameters>
            <parameter name="targetEntity" required="true"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="fieldLabel" required="true"/>
            <parameter name="fieldType" required="true"/>
            <parameter name="defaultValue"/>
            <parameter name="isRequired" default-value="N"/>
            <parameter name="dropdownOptions"/>
            <parameter name="validationRegex"/>
            <parameter name="helpText"/>
            <parameter name="sequenceNum" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fieldDefId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.studio.CustomFieldDef"
                          in-map="[fieldDefId:fieldDefId, targetEntity:targetEntity, fieldName:fieldName,
                                   fieldLabel:fieldLabel, fieldType:fieldType, defaultValue:defaultValue,
                                   isRequired:isRequired, dropdownOptions:dropdownOptions,
                                   validationRegex:validationRegex, helpText:helpText,
                                   sequenceNum:sequenceNum, isActive:'Y',
                                   createdByPartyId:ec.user.userAccount?.partyId,
                                   createdDate:ec.user.nowTimestamp]"
                          out-map="createOut"/>
            <set field="fieldDefId" from="createOut.fieldDefId"/>
        </actions>
    </service>

    <service verb="save" noun="CustomFieldValue">
        <in-parameters>
            <parameter name="fieldDefId" required="true"/>
            <parameter name="entityId" required="true"/>
            <parameter name="textValue"/>
            <parameter name="numberValue" type="BigDecimal"/>
            <parameter name="dateValue" type="Timestamp"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.studio.CustomFieldValue" list="existing">
                <econdition field-name="fieldDefId"/>
                <econdition field-name="entityId"/>
                <limit count="1"/>
            </entity-find>
            <if condition="existing">
                <set field="val" from="existing[0]"/>
                <set field="val.textValue" from="textValue"/>
                <set field="val.numberValue" from="numberValue"/>
                <set field="val.dateValue" from="dateValue"/>
                <entity-update value-field="val"/>
            <else>
                <service-call name="create#zenith.erp.studio.CustomFieldValue"
                              in-map="[fieldDefId:fieldDefId, entityId:entityId,
                                       textValue:textValue, numberValue:numberValue, dateValue:dateValue]"/>
            </else>
            </if>
        </actions>
    </service>

    <service verb="create" noun="CustomEntityWithFields">
        <in-parameters>
            <parameter name="entityLabel" required="true"/>
            <parameter name="entityCode" required="true"/>
            <parameter name="description"/>
            <parameter name="iconName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="customEntityId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.studio.CustomEntity"
                          in-map="[customEntityId:customEntityId, entityLabel:entityLabel,
                                   entityCode:entityCode, description:description, iconName:iconName,
                                   isActive:'Y', createdByPartyId:ec.user.userAccount?.partyId,
                                   createdDate:ec.user.nowTimestamp]"
                          out-map="createOut"/>
            <set field="customEntityId" from="createOut.customEntityId"/>
        </actions>
    </service>

    <service verb="addRecord" noun="CustomEntity">
        <in-parameters>
            <parameter name="customEntityId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.studio.CustomEntityRecord"
                          in-map="[customEntityId:customEntityId,
                                   createdByPartyId:ec.user.userAccount?.partyId,
                                   createdDate:ec.user.nowTimestamp]"
                          out-map="createOut"/>
            <set field="recordId" from="createOut.recordId"/>
        </actions>
    </service>

    <service verb="create" noun="DashboardWithWidgets">
        <in-parameters>
            <parameter name="dashboardName" required="true"/>
            <parameter name="isDefault" default-value="N"/>
            <parameter name="isShared" default-value="N"/>
        </in-parameters>
        <out-parameters>
            <parameter name="userDashboardId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.studio.UserDashboard"
                          in-map="[dashboardName:dashboardName, isDefault:isDefault, isShared:isShared,
                                   ownerPartyId:ec.user.userAccount?.partyId,
                                   createdDate:ec.user.nowTimestamp]"
                          out-map="createOut"/>
            <set field="userDashboardId" from="createOut.userDashboardId"/>
        </actions>
    </service>

</services>
