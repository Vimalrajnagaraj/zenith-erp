<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Custom Fields" default-menu-index="1">

    <transition name="createField" begin-transaction="true">
        <service-call name="zenith.studio.StudioServices.create#CustomField"/>
        <default-response url="."/>
    </transition>
    <transition name="updateField" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.CustomFieldDef"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.CustomFieldDef" list="fieldList">
            <search-form-inputs default-order-by="targetEntity,sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Custom Field Definitions"/>
            <box-toolbar>
                <container-dialog id="CreateFieldDialog" button-text="New Custom Field">
                    <form-single name="CreateFieldForm" transition="createField">
                        <field name="targetEntity"><default-field title="Target Entity"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TargetEntity"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="fieldName"><default-field title="Field Name (code)"><text-line size="20"/></default-field></field>
                        <field name="fieldLabel"><default-field title="Display Label"><text-line size="25"/></default-field></field>
                        <field name="fieldType"><default-field title="Field Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="CustomFieldType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="defaultValue"><default-field title="Default Value"><text-line size="20"/></default-field></field>
                        <field name="isRequired"><default-field title="Required"><drop-down>
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down></default-field></field>
                        <field name="dropdownOptions"><default-field title="Dropdown Options (comma-separated)"><text-line size="40"/></default-field></field>
                        <field name="validationRegex"><default-field title="Validation Regex"><text-line size="30"/></default-field></field>
                        <field name="helpText"><default-field title="Help Text"><text-line size="40"/></default-field></field>
                        <field name="sequenceNum"><default-field title="Order"><text-line size="3"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="FieldList" list="fieldList" transition="updateField" header-dialog="true">
                    <field name="fieldDefId"><default-field><hidden/></default-field></field>
                    <field name="targetEntity"><header-field title="Entity"><drop-down allow-empty="true">
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TargetEntity"/>
                                </entity-find>
                            </entity-options></drop-down></header-field>
                        <default-field title="Entity">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field>
                    </field>
                    <field name="fieldName"><default-field title="Name"><display/></default-field></field>
                    <field name="fieldLabel"><default-field title="Label"><text-line size="15"/></default-field></field>
                    <field name="fieldType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="isRequired"><default-field title="Req"><display/></default-field></field>
                    <field name="sequenceNum"><default-field title="#"><text-line size="3"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
