<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Entity Detail" default-menu-index="3" default-menu-include="false">

    <parameter name="customEntityId" required="true"/>

    <transition name="updateEntity" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.CustomEntity"/>
        <default-response url="."/>
    </transition>
    <transition name="addField" begin-transaction="true">
        <service-call name="create#zenith.erp.studio.CustomEntityField"/>
        <default-response url="."/>
    </transition>
    <transition name="updateField" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.CustomEntityField"/>
        <default-response url="."/>
    </transition>
    <transition name="addRecord" begin-transaction="true">
        <service-call name="zenith.studio.StudioServices.addRecord#CustomEntity"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.studio.CustomEntity" value-field="ce"/>
        <entity-find entity-name="zenith.erp.studio.CustomEntityField" list="fields">
            <econdition field-name="customEntityId"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.studio.CustomEntityRecord" list="records">
            <econdition field-name="customEntityId"/>
            <order-by field-name="-createdDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5">
                <container-box>
                    <box-header title="Entity — ${ce.entityLabel}"/>
                    <box-body>
                        <form-single name="EntityForm" map="ce" transition="updateEntity">
                            <field name="customEntityId"><default-field><hidden/></default-field></field>
                            <field name="entityLabel"><default-field title="Label"><text-line size="20"/></default-field></field>
                            <field name="entityCode"><default-field title="Code"><display/></default-field></field>
                            <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                            <field name="iconName"><default-field title="Icon"><text-line size="10"/></default-field></field>
                            <field name="isActive"><default-field title="Active"><drop-down>
                                <option key="Y" text="Yes"/><option key="N" text="No"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Fields"/>
                    <box-toolbar>
                        <container-dialog id="AddFieldDialog" button-text="Add Field">
                            <form-single name="AddFieldForm" transition="addField">
                                <field name="customEntityId"><default-field><hidden/></default-field></field>
                                <field name="fieldName"><default-field title="Field Name"><text-line size="20"/></default-field></field>
                                <field name="fieldLabel"><default-field title="Label"><text-line size="20"/></default-field></field>
                                <field name="fieldType"><default-field title="Type"><drop-down>
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="CustomFieldType"/>
                                            <order-by field-name="sequenceNum"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="isRequired"><default-field title="Required"><drop-down>
                                    <option key="N" text="No"/><option key="Y" text="Yes"/>
                                </drop-down></default-field></field>
                                <field name="defaultValue"><default-field title="Default"><text-line size="15"/></default-field></field>
                                <field name="dropdownOptions"><default-field title="Options (comma-separated)"><text-line size="30"/></default-field></field>
                                <field name="sequenceNum"><default-field title="Order"><text-line size="3"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="FieldsList" list="fields" transition="updateField">
                            <field name="entityFieldId"><default-field><hidden/></default-field></field>
                            <field name="customEntityId"><default-field><hidden/></default-field></field>
                            <field name="sequenceNum"><default-field title="#"><text-line size="2"/></default-field></field>
                            <field name="fieldLabel"><default-field title="Label"><text-line size="12"/></default-field></field>
                            <field name="fieldType"><default-field title="Type">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="isRequired"><default-field title="Req"><display/></default-field></field>
                            <field name="isActive"><default-field title="Active"><drop-down>
                                <option key="Y" text="Yes"/><option key="N" text="No"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="7">
                <container-box>
                    <box-header title="Records (${records.size()})"/>
                    <box-toolbar>
                        <form-single name="AddRecordForm" transition="addRecord">
                            <field name="customEntityId"><default-field><hidden/></default-field></field>
                            <field name="submitButton"><default-field title="Add Record"><submit/></default-field></field>
                        </form-single>
                    </box-toolbar>
                    <box-body>
                        <form-list name="RecordList" list="records" skip-form="true">
                            <field name="recordId"><default-field title="Record ID"><display/></default-field></field>
                            <field name="createdByPartyId"><default-field title="Created By"><display/></default-field></field>
                            <field name="createdDate"><default-field title="Created"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
