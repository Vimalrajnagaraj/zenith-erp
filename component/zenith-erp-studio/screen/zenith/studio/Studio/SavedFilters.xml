<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Saved Filters" default-menu-index="7">

    <transition name="createFilter" begin-transaction="true">
        <service-call name="create#zenith.erp.studio.SavedFilter"/>
        <default-response url="."/>
    </transition>
    <transition name="updateFilter" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.SavedFilter"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.SavedFilter" list="filters">
            <order-by field-name="screenPath,filterName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Saved Filters"/>
            <box-toolbar>
                <container-dialog id="CreateFilterDialog" button-text="New Filter">
                    <form-single name="CreateFilterForm" transition="createFilter">
                        <field name="filterName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="screenPath"><default-field title="Screen Path"><text-line size="30"/></default-field></field>
                        <field name="filterCriteria"><default-field title="Criteria (JSON)"><text-area rows="5" cols="50"/></default-field></field>
                        <field name="isDefault"><default-field title="Default"><drop-down>
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down></default-field></field>
                        <field name="isShared"><default-field title="Shared"><drop-down>
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down></default-field></field>
                        <field name="ownerPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                        <field name="createdDate"><default-field><hidden default-value="${ec.user.nowTimestamp}"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="FilterList" list="filters" transition="updateFilter">
                    <field name="filterId"><default-field><hidden/></default-field></field>
                    <field name="filterName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="screenPath"><default-field title="Screen"><display/></default-field></field>
                    <field name="isDefault"><default-field title="Default"><drop-down>
                        <option key="N" text="No"/><option key="Y" text="Yes"/>
                    </drop-down></default-field></field>
                    <field name="isShared"><default-field title="Shared"><drop-down>
                        <option key="N" text="No"/><option key="Y" text="Yes"/>
                    </drop-down></default-field></field>
                    <field name="ownerPartyId"><default-field title="Owner"><display/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
