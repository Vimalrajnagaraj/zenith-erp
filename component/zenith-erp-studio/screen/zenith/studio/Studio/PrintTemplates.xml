<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Print Templates" default-menu-index="5">

    <transition name="createTemplate" begin-transaction="true">
        <service-call name="create#zenith.erp.studio.PrintTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.PrintTemplate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.PrintTemplate" list="templates">
            <order-by field-name="templateType,templateName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Print / PDF Templates"/>
            <box-toolbar>
                <container-dialog id="CreateTplDialog" button-text="New Template">
                    <form-single name="CreateTplForm" transition="createTemplate">
                        <field name="templateName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="targetEntity"><default-field title="Target"><drop-down allow-empty="true">
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TargetEntity"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="templateType"><default-field title="Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PrintTemplateType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="paperSize"><default-field title="Paper Size"><drop-down>
                            <option key="A4" text="A4"/>
                            <option key="A5" text="A5"/>
                            <option key="Letter" text="Letter"/>
                            <option key="Legal" text="Legal"/>
                            <option key="Thermal" text="Thermal (80mm)"/>
                        </drop-down></default-field></field>
                        <field name="orientation"><default-field title="Orientation"><drop-down>
                            <option key="Portrait" text="Portrait"/>
                            <option key="Landscape" text="Landscape"/>
                        </drop-down></default-field></field>
                        <field name="headerContent"><default-field title="Header"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="templateContent"><default-field title="Body Template"><text-area rows="10" cols="50"/></default-field></field>
                        <field name="footerContent"><default-field title="Footer"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="isDefault"><default-field title="Default"><drop-down>
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="TemplateList" list="templates" transition="updateTemplate">
                    <field name="templateId"><default-field><hidden/></default-field></field>
                    <field name="templateName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="templateType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="targetEntity"><default-field title="Target">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="paperSize"><default-field title="Paper"><display/></default-field></field>
                    <field name="orientation"><default-field title="Orient"><display/></default-field></field>
                    <field name="isDefault"><default-field title="Default"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
