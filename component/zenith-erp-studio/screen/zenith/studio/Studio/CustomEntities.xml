<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Custom Entities" default-menu-index="2">

    <transition name="createEntity" begin-transaction="true">
        <service-call name="zenith.studio.StudioServices.create#CustomEntityWithFields"/>
        <default-response url="../EditCustomEntity"/>
    </transition>
    <transition name="editEntity"><default-response url="../EditCustomEntity"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.CustomEntity" list="entityList">
            <order-by field-name="entityLabel"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Custom Entities"/>
            <box-toolbar>
                <container-dialog id="CreateEntityDialog" button-text="New Custom Entity">
                    <form-single name="CreateEntityForm" transition="createEntity">
                        <field name="entityLabel"><default-field title="Label"><text-line size="25"/></default-field></field>
                        <field name="entityCode"><default-field title="Code"><text-line size="15"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="iconName"><default-field title="Icon"><text-line size="15"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="EntityList" list="entityList" skip-form="true">
                    <field name="entityLabel"><default-field title="Name">
                        <link url="editEntity" text="${entityLabel}" link-type="anchor">
                            <parameter name="customEntityId"/>
                        </link>
                    </default-field></field>
                    <field name="entityCode"><default-field title="Code"><display/></default-field></field>
                    <field name="description"><default-field title="Description"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><display/></default-field></field>
                    <field name="createdDate"><default-field title="Created"><display format="dd-MM-yyyy"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
