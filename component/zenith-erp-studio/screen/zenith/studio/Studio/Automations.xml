<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Automations" default-menu-index="6">

    <transition name="createRule" begin-transaction="true">
        <service-call name="create#zenith.erp.studio.AutomationRule"/>
        <default-response url="."/>
    </transition>
    <transition name="updateRule" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.AutomationRule"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.AutomationRule" list="rules">
            <order-by field-name="ruleName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Automation Rules"/>
            <box-toolbar>
                <container-dialog id="CreateRuleDialog" button-text="New Rule">
                    <form-single name="CreateRuleForm" transition="createRule">
                        <field name="ruleName"><default-field title="Rule Name"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="triggerEntity"><default-field title="Trigger Entity"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TargetEntity"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="triggerEvent"><default-field title="Trigger Event"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TriggerEvent"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="conditionExpression"><default-field title="Condition"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="actionType"><default-field title="Action"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="AutomationAction"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="actionConfig"><default-field title="Action Config (JSON)"><text-area rows="4" cols="50"/></default-field></field>
                        <field name="createdByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="RuleList" list="rules" transition="updateRule">
                    <field name="ruleId"><default-field><hidden/></default-field></field>
                    <field name="ruleName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="triggerEntity"><default-field title="Entity">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="triggerEvent"><default-field title="Event">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="actionType"><default-field title="Action">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="executionCount"><default-field title="Runs"><display/></default-field></field>
                    <field name="lastExecutedDate"><default-field title="Last Run"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
