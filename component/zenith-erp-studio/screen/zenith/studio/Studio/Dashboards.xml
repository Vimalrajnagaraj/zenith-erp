<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboards" default-menu-index="4">

    <transition name="createDashboard" begin-transaction="true">
        <service-call name="zenith.studio.StudioServices.create#DashboardWithWidgets"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDashboard" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.UserDashboard"/>
        <default-response url="."/>
    </transition>
    <transition name="createWidget" begin-transaction="true">
        <service-call name="create#zenith.erp.studio.DashboardWidget"/>
        <default-response url="."/>
    </transition>
    <transition name="updateWidget" begin-transaction="true">
        <service-call name="update#zenith.erp.studio.DashboardWidget"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.studio.UserDashboard" list="dashboards">
            <order-by field-name="dashboardName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.studio.DashboardWidget" list="widgets">
            <order-by field-name="widgetName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5">
                <container-box>
                    <box-header title="Dashboards"/>
                    <box-toolbar>
                        <container-dialog id="CreateDashDialog" button-text="New Dashboard">
                            <form-single name="CreateDashForm" transition="createDashboard">
                                <field name="dashboardName"><default-field title="Name"><text-line size="25"/></default-field></field>
                                <field name="isDefault"><default-field title="Default"><drop-down>
                                    <option key="N" text="No"/><option key="Y" text="Yes"/>
                                </drop-down></default-field></field>
                                <field name="isShared"><default-field title="Shared"><drop-down>
                                    <option key="N" text="No"/><option key="Y" text="Yes"/>
                                </drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="DashList" list="dashboards" transition="updateDashboard">
                            <field name="userDashboardId"><default-field><hidden/></default-field></field>
                            <field name="dashboardName"><default-field title="Name"><text-line size="15"/></default-field></field>
                            <field name="isDefault"><default-field title="Default"><display/></default-field></field>
                            <field name="isShared"><default-field title="Shared"><display/></default-field></field>
                            <field name="ownerPartyId"><default-field title="Owner"><display/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="7">
                <container-box>
                    <box-header title="Widgets"/>
                    <box-toolbar>
                        <container-dialog id="CreateWidgetDialog" button-text="New Widget">
                            <form-single name="CreateWidgetForm" transition="createWidget">
                                <field name="widgetName"><default-field title="Name"><text-line size="25"/></default-field></field>
                                <field name="widgetType"><default-field title="Type"><drop-down>
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="WidgetType"/>
                                            <order-by field-name="sequenceNum"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="entityName"><default-field title="Data Source Entity"><text-line size="30"/></default-field></field>
                                <field name="chartType"><default-field title="Chart Type"><drop-down allow-empty="true">
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="ChartType"/>
                                            <order-by field-name="sequenceNum"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                                <field name="refreshInterval"><default-field title="Refresh (sec)"><text-line size="5" default-value="300"/></default-field></field>
                                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="WidgetList" list="widgets" transition="updateWidget">
                            <field name="widgetId"><default-field><hidden/></default-field></field>
                            <field name="widgetName"><default-field title="Name"><text-line size="12"/></default-field></field>
                            <field name="widgetType"><default-field title="Type">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="chartType"><default-field title="Chart">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="refreshInterval"><default-field title="Refresh"><display/></default-field></field>
                            <field name="isActive"><default-field title="Active"><drop-down>
                                <option key="Y" text="Yes"/><option key="N" text="No"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
