<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Studio" default-menu-index="25">

    <always-actions>
        <set field="html_title" value="Studio"/>
    </always-actions>

    <subscreens default-item="CustomFields"/>

    <transition name="goSettings"><default-response url="/apps/zenith/settings/Users"/></transition>
    <transition name="goIntegrations"><default-response url="/apps/zenith/integrations/PortalConfig"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goSettings" text="Settings" icon="fa fa-cog" btn-type="primary" style="q-btn--dense"/>
            <section name="gate_integrations_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('integrations'))"><widgets><link url="goIntegrations" text="Integrations" icon="fa fa-plug" btn-type="info" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
