<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== MAIN TAX CALCULATION SERVICE (DISPATCHER) ========== -->
    <service verb="calculate" noun="Tax">
        <description>Generic tax calculation that dispatches to country-specific tax service.
            Reads TAX_CALCULATION_SERVICE from CompanySettings to find the country plugin.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="customerPartyId"/>
            <parameter name="items" type="List" required="true">
                <parameter name="itemEntry" type="Map">
                    <parameter name="productId"/>
                    <parameter name="productTaxCode"/>
                    <parameter name="taxCategoryId"/>
                    <parameter name="quantity" type="BigDecimal" required="true"/>
                    <parameter name="unitAmount" type="BigDecimal" required="true"/>
                    <parameter name="discountAmount" type="BigDecimal"/>
                    <parameter name="isTaxInclusive" default-value="N"/>
                </parameter>
            </parameter>
            <parameter name="originRegionGeoId"/>
            <parameter name="destinationRegionGeoId"/>
            <parameter name="originCountryGeoId"/>
            <parameter name="destinationCountryGeoId"/>
            <parameter name="currencyUomId"/>
            <parameter name="transactionDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="transactionType" default-value="SALE"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taxedItems" type="List">
                <parameter name="taxedItem" type="Map">
                    <parameter name="itemIndex" type="Integer"/>
                    <parameter name="taxableAmount" type="BigDecimal"/>
                    <parameter name="totalTaxAmount" type="BigDecimal"/>
                    <parameter name="taxBreakdowns" type="List">
                        <parameter name="breakdown" type="Map">
                            <parameter name="taxAuthorityId"/>
                            <parameter name="taxRateId"/>
                            <parameter name="taxName"/>
                            <parameter name="taxRate" type="BigDecimal"/>
                            <parameter name="taxableAmount" type="BigDecimal"/>
                            <parameter name="taxAmount" type="BigDecimal"/>
                            <parameter name="isIncludedInPrice"/>
                            <parameter name="countryGeoId"/>
                            <parameter name="regionGeoId"/>
                        </parameter>
                    </parameter>
                </parameter>
            </parameter>
            <parameter name="totalTaxableAmount" type="BigDecimal"/>
            <parameter name="totalTaxAmount" type="BigDecimal"/>
            <parameter name="totalAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <set field="taxSetting" from="null"/>
            <if condition="organizationPartyId">
                <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="taxSetting">
                    <field-map field-name="organizationPartyId"/>
                    <field-map field-name="settingKey" value="TAX_CALCULATION_SERVICE"/>
                </entity-find-one>
            </if>

            <if condition="taxSetting?.settingValue">
                <service-call name="${taxSetting.settingValue}"
                              in-map="context" out-map="context"/>
            <else>
                <set field="taxedItems" from="[]"/>
                <set field="totalTaxableAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
                <set field="totalTaxAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
                <set field="totalAmount" from="BigDecimal.ZERO" type="BigDecimal"/>

                <set field="itemIndex" from="0" type="Integer"/>
                <iterate list="items" entry="item">
                    <set field="lineAmount" from="((item.quantity ?: 0) as BigDecimal) * ((item.unitAmount ?: 0) as BigDecimal)"/>
                    <set field="lineDiscount" from="(item.discountAmount ?: 0) as BigDecimal"/>
                    <set field="taxableAmt" from="lineAmount - lineDiscount"/>

                    <set field="taxedItem" from="[itemIndex:itemIndex, taxableAmount:taxableAmt, totalTaxAmount:BigDecimal.ZERO, taxBreakdowns:[]]"/>
                    <script>taxedItems.add(taxedItem)</script>

                    <set field="totalTaxableAmount" from="totalTaxableAmount + taxableAmt"/>
                    <set field="totalAmount" from="totalAmount + taxableAmt"/>
                    <set field="itemIndex" from="itemIndex + 1"/>
                </iterate>
            </else>
            </if>
        </actions>
    </service>

    <!-- ========== GLOBAL TAX CALCULATION (AVALARA / TAXJAR) ========== -->
    <service verb="calculate" noun="GlobalTax">
        <description>
            Adapter pattern for Global Tax Engines (Avalara, TaxJar).
            Queries the Tenant's TaxEngineConfig and dispatches to the correct external API.
        </description>
        <in-parameters>
            <parameter name="tenantId" required="true"/>
            <parameter name="items" type="List" required="true"/>
            <parameter name="destinationCountryGeoId"/>
            <parameter name="destinationRegionGeoId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taxBreakdowns" type="List"/>
            <parameter name="totalTaxAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.tax.TaxEngineConfig" list="configs">
                <econdition field-name="tenantId"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            
            <script><![CDATA[
                import org.slf4j.LoggerFactory
                def logger = LoggerFactory.getLogger("GlobalTaxServices")
                
                taxBreakdowns = []
                totalTaxAmount = 0.0
                
                if (configs) {
                    def activeConfig = configs[0]
                    String provider = activeConfig.providerEnumId
                    
                    logger.info("Routing Global Tax Calculation via Provider: [${provider}] for Tenant: [${tenantId}]")
                    
                    // Mock API Dispatch to Avalara / TaxJar
                    // In production, this fires a REST request via HTTP client using apiKey/apiSecret
                    
                    BigDecimal simulatedTaxRate = 0.085 // e.g. 8.5%
                    
                    for (item in items) {
                        BigDecimal lineAmount = ((item.quantity ?: 1.0) as BigDecimal) * ((item.unitAmount ?: 0.0) as BigDecimal)
                        BigDecimal itemTax = lineAmount * simulatedTaxRate
                        
                        taxBreakdowns.add([
                            taxName: provider == 'TpAvalara' ? 'AvaTax Sales Tax' : 'TaxJar Sales Tax',
                            taxRate: simulatedTaxRate,
                            taxableAmount: lineAmount,
                            taxAmount: itemTax,
                            countryGeoId: destinationCountryGeoId,
                            regionGeoId: destinationRegionGeoId
                        ])
                        
                        totalTaxAmount += itemTax
                    }
                    
                    logger.info("Successfully calculated [${totalTaxAmount}] total tax via ${provider}.")
                } else {
                    logger.warn("No active Global Tax Engine configured for Tenant [${tenantId}]. Falling back to local tax engine.")
                }
            ]]></script>
        </actions>
    </service>

    <!-- ========== SAVE (VALIDATED) GLOBAL TAX ENGINE CONFIG ========== -->
    <!-- ZE-TAX-011: the config screen saved via the auto create# with NO validation, so an empty or
         malformed config (blank endpoint/key/secret, wrong provider URL) was accepted. Validate the
         inputs here. NOTE: the live secret cannot be authenticated because calculate#GlobalTax is a
         mock (no real Avalara/TaxJar client yet) — so this checks presence, https URL format, and
         provider/endpoint plausibility, not live credential auth (a go-live dependency). -->
    <service verb="save" noun="TaxEngineConfig">
        <description>Create a Global Tax Engine config with input validation.</description>
        <in-parameters>
            <parameter name="tenantId"/>
            <parameter name="providerEnumId"/>
            <parameter name="apiEndpoint"/>
            <parameter name="apiKey"/>
            <parameter name="apiSecret"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters><parameter name="configId"/></out-parameters>
        <actions>
            <set field="missing" from="[]"/>
            <if condition="!providerEnumId"><script>missing.add('Tax Provider')</script></if>
            <if condition="!apiEndpoint"><script>missing.add('API Endpoint URL')</script></if>
            <if condition="!apiKey"><script>missing.add('API Key / Account ID')</script></if>
            <if condition="!apiSecret"><script>missing.add('API Secret / License Key')</script></if>
            <if condition="missing">
                <return error="true" message="Please fill the required field(s): ${missing.join(', ')}."/>
            </if>
            <set field="ep" from="apiEndpoint.trim()"/>
            <if condition="!(ep.toLowerCase().startsWith('https://') &amp;&amp; ep.length() &gt; 10 &amp;&amp; ep.substring(8).contains('.'))">
                <return error="true" message="API Endpoint must be a valid https:// URL (e.g. https://rest.avatax.com)."/>
            </if>
            <set field="host" from="ep.toLowerCase()"/>
            <if condition="providerEnumId == 'TpAvalara' &amp;&amp; !(host.contains('avatax') || host.contains('avalara'))">
                <return error="true" message="For Avalara AvaTax the endpoint should be an Avalara URL (e.g. https://rest.avatax.com or https://sandbox-rest.avatax.com)."/>
            </if>
            <if condition="providerEnumId == 'TpTaxJar' &amp;&amp; !host.contains('taxjar')">
                <return error="true" message="For TaxJar the endpoint should be a TaxJar URL (e.g. https://api.taxjar.com)."/>
            </if>
            <!-- ZE-TAX-012: one configuration per provider per tenant (no duplicates). -->
            <entity-find-count entity-name="zenith.erp.tax.TaxEngineConfig" count-field="dupCount">
                <econdition field-name="tenantId"/>
                <econdition field-name="providerEnumId"/>
            </entity-find-count>
            <if condition="dupCount &gt; 0">
                <entity-find-one entity-name="moqui.basic.Enumeration" value-field="_prov">
                    <field-map field-name="enumId" from="providerEnumId"/>
                </entity-find-one>
                <return error="true" message="A configuration for ${_prov?.description ?: 'this provider'} already exists. Delete the existing one before adding a new configuration."/>
            </if>
            <service-call name="create#zenith.erp.tax.TaxEngineConfig" out-map="context"
                in-map="[tenantId:tenantId, providerEnumId:providerEnumId, apiEndpoint:ep,
                         apiKey:apiKey, apiSecret:apiSecret, isActive:(isActive ?: 'Y')]"/>
        </actions>
    </service>

    <!-- ========== DELETE (ORG-GUARDED) GLOBAL TAX ENGINE CONFIG ========== -->
    <!-- ZE-TAX-012: the screen had no delete, so a duplicate-block would trap the user. This lets a
         tenant remove its own config (to replace it); ADMIN exempt. -->
    <service verb="delete" noun="TaxEngineConfig">
        <description>Delete a Tax Engine config, enforcing tenant ownership.</description>
        <in-parameters><parameter name="configId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.tax.TaxEngineConfig" value-field="cfg"/>
            <if condition="!cfg"><return error="true" message="Tax engine config not found."/></if>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <if condition="!activeOrg || activeOrg == '_NA_' || cfg.tenantId != activeOrg">
                    <return error="true" message="You do not have access to this tax engine config."/>
                </if>
            </if>
            <entity-delete value-field="cfg"/>
        </actions>
    </service>

    <!-- ========== STORE TAX LINE DETAILS ========== -->
    <service verb="store" noun="TaxLineDetails">
        <description>Persists tax breakdown into TaxLineDetail records. Called after tax calculation.</description>
        <in-parameters>
            <parameter name="referenceType" required="true"/>
            <parameter name="referenceId" required="true"/>
            <parameter name="referenceSeqId"/>
            <parameter name="parentReferenceType"/>
            <parameter name="parentReferenceId"/>
            <parameter name="currencyUomId"/>
            <parameter name="taxBreakdowns" type="List" required="true">
                <parameter name="breakdown" type="Map">
                    <parameter name="taxAuthorityId"/>
                    <parameter name="taxRateId"/>
                    <parameter name="taxCategoryId"/>
                    <parameter name="taxName"/>
                    <parameter name="taxRate" type="BigDecimal"/>
                    <parameter name="taxableAmount" type="BigDecimal"/>
                    <parameter name="taxAmount" type="BigDecimal"/>
                    <parameter name="isIncludedInPrice"/>
                    <parameter name="countryGeoId"/>
                    <parameter name="regionGeoId"/>
                </parameter>
            </parameter>
        </in-parameters>
        <actions>
            <entity-delete-by-condition entity-name="zenith.erp.tax.TaxLineDetail">
                <econdition field-name="referenceType"/>
                <econdition field-name="referenceId"/>
                <econdition field-name="referenceSeqId" ignore-if-empty="true"/>
            </entity-delete-by-condition>

            <set field="seq" from="1" type="Integer"/>
            <iterate list="taxBreakdowns" entry="bd">
                <service-call name="create#zenith.erp.tax.TaxLineDetail"
                              in-map="[referenceType:referenceType, referenceId:referenceId,
                                       referenceSeqId:referenceSeqId,
                                       parentReferenceType:parentReferenceType, parentReferenceId:parentReferenceId,
                                       taxAuthorityId:bd.taxAuthorityId, taxRateId:bd.taxRateId,
                                       taxCategoryId:bd.taxCategoryId, taxName:bd.taxName,
                                       taxRate:bd.taxRate, taxableAmount:bd.taxableAmount,
                                       taxAmount:bd.taxAmount, currencyUomId:currencyUomId,
                                       isIncludedInPrice:bd.isIncludedInPrice ?: 'N',
                                       countryGeoId:bd.countryGeoId, regionGeoId:bd.regionGeoId,
                                       sequenceNum:seq]"/>
                <set field="seq" from="seq + 1"/>
            </iterate>
        </actions>
    </service>

    <!-- ========== GET TAX LINE DETAILS ========== -->
    <service verb="get" noun="TaxLineDetails">
        <description>Retrieves persisted tax details for a line item</description>
        <in-parameters>
            <parameter name="referenceType" required="true"/>
            <parameter name="referenceId" required="true"/>
            <parameter name="referenceSeqId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taxDetails" type="List"/>
            <parameter name="totalTaxAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.tax.TaxLineDetail" list="taxDetails">
                <econdition field-name="referenceType"/>
                <econdition field-name="referenceId"/>
                <econdition field-name="referenceSeqId" ignore-if-empty="true"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>

            <set field="totalTaxAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <iterate list="taxDetails" entry="td">
                <set field="totalTaxAmount" from="totalTaxAmount + (td.taxAmount ?: BigDecimal.ZERO)"/>
            </iterate>
        </actions>
    </service>

    <!-- ========== GET TAX SUMMARY FOR DOCUMENT ========== -->
    <service verb="get" noun="TaxSummary">
        <description>Aggregates tax by authority/type for a full document</description>
        <in-parameters>
            <parameter name="referenceType" required="true"/>
            <parameter name="referenceId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taxSummary" type="List"/>
            <parameter name="grandTotalTax" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.tax.TaxLineSummaryView" list="summaryList">
                <econdition field-name="referenceType"/>
                <econdition field-name="referenceId"/>
            </entity-find>

            <set field="taxSummary" from="[]"/>
            <set field="grandTotalTax" from="BigDecimal.ZERO" type="BigDecimal"/>
            <iterate list="summaryList" entry="row">
                <script>taxSummary.add([taxName:row.taxName, taxAuthorityId:row.taxAuthorityId,
                    taxRate:row.taxRate, totalTaxable:row.totalTaxableAmount,
                    totalTax:row.totalTaxAmount, lineCount:row.lineCount])</script>
                <set field="grandTotalTax" from="grandTotalTax + (row.totalTaxAmount ?: BigDecimal.ZERO)"/>
            </iterate>
        </actions>
    </service>

    <!-- ========== GET PARTY TAX REGISTRATION ========== -->
    <service verb="get" noun="PartyTaxRegistration">
        <description>Gets the default tax registration for a party</description>
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="countryGeoId"/>
            <parameter name="registrationTypeEnumId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="registrationNumber"/>
            <parameter name="registrationId"/>
            <parameter name="regionGeoId"/>
            <parameter name="taxAuthorityId"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.tax.TaxRegistration" list="registrations">
                <econdition field-name="partyId"/>
                <econdition field-name="registrationTypeEnumId" ignore-if-empty="true"/>
                <econdition field-name="isActive" value="Y"/>
                <order-by field-name="-isDefault,-isPrimary"/>
            </entity-find>

            <if condition="countryGeoId &amp;&amp; registrations">
                <set field="filtered" from="registrations.findAll { reg ->
                    reg.countryGeoId == countryGeoId || (!reg.countryGeoId &amp;&amp;
                        ec.entity.find('zenith.erp.tax.TaxAuthority').condition('taxAuthorityId', reg.taxAuthorityId).one()?.countryGeoId == countryGeoId)
                }"/>
                <set field="registrations" from="filtered ?: registrations"/>
            </if>

            <if condition="registrations">
                <set field="reg" from="registrations[0]"/>
                <set field="registrationNumber" from="reg.registrationNumber"/>
                <set field="registrationId" from="reg.registrationId"/>
                <set field="regionGeoId" from="reg.regionGeoId"/>
                <set field="taxAuthorityId" from="reg.taxAuthorityId"/>
            </if>

            <!-- ZE-SALES-0306: the GST split (CGST+SGST intra-state vs IGST inter-state) keys off regionGeoId,
                 but in practice many parties have a GSTIN with NO explicit regionGeoId: the seller's own
                 registration was migrated with a blank region, and customers hold only an IndiaGstin (no
                 TaxRegistration at all). Since the GST state code IS the first two digits of the GSTIN — and
                 the regionGeoId in this system is exactly that state code (e.g. 33 = Tamil Nadu) — derive it,
                 so the engine can compare states instead of defaulting everyone to IGST.
                 (a) no TaxRegistration found -> fall back to the party's IndiaGstin (state code + number);
                 (b) a registration whose regionGeoId is blank -> take the registration number's first 2 digits. -->
            <if condition="!registrationNumber">
                <script><![CDATA[
                    try {
                        def _g = ec.entity.find("zenith.erp.india.IndiaGstin").condition("partyId", partyId)
                                    .condition("isActive", "Y").orderBy("-lastUpdatedStamp").limit(1).disableAuthz().list()
                        if (_g) { registrationNumber = _g[0].gstin; if (!regionGeoId) regionGeoId = _g[0].stateCode }
                    } catch (Exception e) { /* india component / entity absent -> skip */ }
                ]]></script>
            </if>
            <if condition="!regionGeoId &amp;&amp; registrationNumber &amp;&amp; registrationNumber.length() &gt;= 2 &amp;&amp; registrationNumber.substring(0,2) ==~ /[0-9]{2}/">
                <set field="regionGeoId" from="registrationNumber.substring(0,2)"/>
            </if>
        </actions>
    </service>

    <!-- ========== CREATE TAX REGISTRATION ========== -->
    <service verb="create" noun="TaxRegistration">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="taxAuthorityId" required="true"/>
            <parameter name="registrationTypeEnumId" required="true"/>
            <parameter name="registrationNumber" required="true"/>
            <parameter name="organizationPartyId"/>
            <parameter name="isDefault" default-value="Y"/>
            <parameter name="isPrimary" default-value="N"/>
            <parameter name="countryGeoId"/>
            <parameter name="regionGeoId"/>
            <parameter name="issuingAuthority"/>
            <parameter name="effectiveFrom"/>
            <parameter name="effectiveThru"/>
        </in-parameters>
        <out-parameters>
            <parameter name="registrationId"/>
        </out-parameters>
        <actions>
            <!-- ZE-TAX-007: reject a malformed GSTIN when the registration type is GSTIN (India);
                 normalise to upper-case. Other registration types are not pattern-checked. -->
            <if condition="registrationTypeEnumId == 'TrtGstin' &amp;&amp; registrationNumber">
                <set field="registrationNumber" from="registrationNumber.trim().toUpperCase()"/>
                <if condition="!registrationNumber.matches('[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]')">
                    <return error="true" message="That GSTIN doesn't look valid. A GSTIN is 15 characters, e.g. 29ABCDE1234F1Z5."/>
                </if>
            </if>
            <set field="organizationPartyId" from="organizationPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.tax.TaxRegistration" out-map="context"
                          in-map="[organizationPartyId:organizationPartyId, partyId:partyId, taxAuthorityId:taxAuthorityId,
                                   registrationTypeEnumId:registrationTypeEnumId,
                                   registrationNumber:registrationNumber, isDefault:isDefault,
                                   isPrimary:isPrimary, countryGeoId:countryGeoId,
                                   regionGeoId:regionGeoId, issuingAuthority:issuingAuthority,
                                   effectiveFrom:effectiveFrom, effectiveThru:effectiveThru,
                                   isActive:'Y']"/>
        </actions>
    </service>

    <!-- ========== UPDATE (VALIDATED, ORG-GUARDED) TAX REGISTRATION ========== -->
    <!-- ZE-TAX-006: the Registrations list had no edit/delete. This backs the new EditTaxRegistration
         screen: validates mandatory fields and enforces org ownership before updating, and never
         touches organizationPartyId / isDefault / isPrimary. Shares the GSTIN format check with
         create#TaxRegistration (ZE-TAX-007). -->
    <service verb="store" noun="TaxRegistration">
        <description>Update a Tax Registration with validation + org-ownership check.</description>
        <in-parameters>
            <parameter name="registrationId" required="true"/>
            <parameter name="partyId"/>
            <parameter name="taxAuthorityId"/>
            <parameter name="registrationTypeEnumId"/>
            <parameter name="registrationNumber"/>
            <parameter name="countryGeoId"/>
            <parameter name="regionGeoId"/>
            <parameter name="effectiveFrom" type="Date"/>
            <parameter name="effectiveThru" type="Date"/>
            <parameter name="isActive"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.tax.TaxRegistration" value-field="reg"/>
            <if condition="!reg"><return error="true" message="Tax registration not found."/></if>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <if condition="!activeOrg || activeOrg == '_NA_' || reg.organizationPartyId != activeOrg">
                    <return error="true" message="You do not have access to this tax registration."/>
                </if>
            </if>
            <set field="missing" from="[]"/>
            <if condition="!partyId"><script>missing.add('Party')</script></if>
            <if condition="!taxAuthorityId"><script>missing.add('Tax Authority')</script></if>
            <if condition="!registrationTypeEnumId"><script>missing.add('Registration Type')</script></if>
            <if condition="!registrationNumber"><script>missing.add('Registration Number')</script></if>
            <if condition="missing">
                <return error="true" message="Please fill the required field(s): ${missing.join(', ')}."/>
            </if>
            <!-- ZE-TAX-007: GSTIN format check (India) on edit too; normalise to upper-case. -->
            <if condition="registrationTypeEnumId == 'TrtGstin' &amp;&amp; registrationNumber">
                <set field="registrationNumber" from="registrationNumber.trim().toUpperCase()"/>
                <if condition="!registrationNumber.matches('[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]Z[0-9A-Z]')">
                    <return error="true" message="That GSTIN doesn't look valid. A GSTIN is 15 characters, e.g. 29ABCDE1234F1Z5."/>
                </if>
            </if>
            <if condition="effectiveFrom &amp;&amp; effectiveThru &amp;&amp; effectiveThru &lt; effectiveFrom">
                <return error="true" message="Effective Thru cannot be before Effective From."/>
            </if>
            <service-call name="update#zenith.erp.tax.TaxRegistration"
                in-map="[registrationId:registrationId, partyId:partyId, taxAuthorityId:taxAuthorityId,
                         registrationTypeEnumId:registrationTypeEnumId, registrationNumber:registrationNumber,
                         countryGeoId:countryGeoId, regionGeoId:regionGeoId,
                         effectiveFrom:effectiveFrom, effectiveThru:effectiveThru, isActive:isActive]"/>
        </actions>
    </service>

    <!-- ========== DELETE (ORG-GUARDED) TAX REGISTRATION ========== -->
    <service verb="delete" noun="TaxRegistration">
        <description>Delete a Tax Registration, enforcing that it belongs to the caller's active org. ADMIN exempt.</description>
        <in-parameters><parameter name="registrationId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.tax.TaxRegistration" value-field="reg"/>
            <if condition="!reg"><return error="true" message="Tax registration not found."/></if>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <if condition="!activeOrg || activeOrg == '_NA_' || reg.organizationPartyId != activeOrg">
                    <return error="true" message="You do not have access to this tax registration."/>
                </if>
            </if>
            <entity-delete value-field="reg"/>
        </actions>
    </service>

    <!-- ========== SAVE (VALIDATED) TAX EXEMPTION ========== -->
    <!-- ZE-TAX-002: EditTaxExemption/FindTaxExemption called the auto entity CrUD (update#/create#)
         directly, so a blank submit nulled every field and still reported "Submit successful".
         This wrapper enforces the mandatory set before create-or-update: a Tax Authority, an
         Exemption Type, and at least one subject (Party and/or Product) — matching how
         check#TaxExemption actually keys the lookup. The update path deliberately omits
         organizationPartyId so editing never wipes the exemption's org tag. -->
    <service verb="store" noun="TaxExemption">
        <description>Create or update a Tax Exemption with mandatory-field validation.</description>
        <in-parameters>
            <parameter name="exemptionId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="partyId"/>
            <parameter name="productId"/>
            <parameter name="taxAuthorityId"/>
            <parameter name="exemptionTypeEnumId"/>
            <parameter name="exemptionNumber"/>
            <parameter name="effectiveFrom" type="Date"/>
            <parameter name="effectiveThru" type="Date"/>
            <parameter name="description"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters>
            <parameter name="exemptionId"/>
        </out-parameters>
        <actions>
            <set field="missing" from="[]"/>
            <if condition="!taxAuthorityId"><script>missing.add('Tax Authority')</script></if>
            <if condition="!exemptionTypeEnumId"><script>missing.add('Exemption Type')</script></if>
            <if condition="!partyId &amp;&amp; !productId"><script>missing.add('Party or Product')</script></if>
            <if condition="missing">
                <return error="true" message="Please fill the required field(s): ${missing.join(', ')}."/>
            </if>
            <if condition="effectiveFrom &amp;&amp; effectiveThru &amp;&amp; effectiveThru &lt; effectiveFrom">
                <return error="true" message="Effective Thru cannot be before Effective From."/>
            </if>

            <if condition="exemptionId">
                <service-call name="update#zenith.erp.tax.TaxExemption"
                    in-map="[exemptionId:exemptionId, partyId:partyId, productId:productId,
                             taxAuthorityId:taxAuthorityId, exemptionTypeEnumId:exemptionTypeEnumId,
                             exemptionNumber:exemptionNumber, effectiveFrom:effectiveFrom,
                             effectiveThru:effectiveThru, description:description, isActive:isActive]"/>
                <else>
                    <service-call name="create#zenith.erp.tax.TaxExemption" out-map="context"
                        in-map="[organizationPartyId:organizationPartyId, partyId:partyId, productId:productId,
                                 taxAuthorityId:taxAuthorityId, exemptionTypeEnumId:exemptionTypeEnumId,
                                 exemptionNumber:exemptionNumber, effectiveFrom:effectiveFrom,
                                 effectiveThru:effectiveThru, description:description, isActive:isActive]"/>
                </else>
            </if>
        </actions>
    </service>

    <!-- ========== DELETE (ORG-GUARDED) TAX EXEMPTION ========== -->
    <!-- ZE-TAX-004: FindTaxExemption had no delete at all; adding a raw delete# keyed only by the
         PK would let any tenant delete another tenant's exemption by id (IDOR). This wrapper checks
         the record belongs to the caller's active org before deleting. Super-admins (ADMIN) exempt. -->
    <service verb="delete" noun="TaxExemption">
        <description>Delete a Tax Exemption, enforcing that it belongs to the caller's active org.</description>
        <in-parameters><parameter name="exemptionId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.tax.TaxExemption" value-field="ex"/>
            <if condition="!ex"><return error="true" message="Tax exemption not found."/></if>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <if condition="!activeOrg || activeOrg == '_NA_' || ex.organizationPartyId != activeOrg">
                    <return error="true" message="You do not have access to this tax exemption."/>
                </if>
            </if>
            <entity-delete value-field="ex"/>
        </actions>
    </service>

    <!-- ========== TAX MASTER DATA (PLATFORM ADMIN ONLY) — ZE-TAX sweep ========== -->
    <!-- TaxAuthority + TaxRate are GLOBAL master data (no organizationPartyId): the authorities
         drive GST for every tenant and are referenced by live tax lines. So create/update/delete
         are restricted to platform super-admins (ADMIN); tenants get a read-only view. Delete is
         additionally refused while the record is still referenced anywhere (deactivate instead). -->
    <service verb="store" noun="TaxAuthority">
        <description>Create or update a Tax Authority (platform-admin only).</description>
        <in-parameters>
            <parameter name="taxAuthorityId" required="true"/>
            <parameter name="description"/>
            <parameter name="taxAuthorityTypeEnumId"/>
            <parameter name="countryGeoId"/>
            <parameter name="regionGeoId"/>
            <parameter name="parentTaxAuthorityId"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters><parameter name="taxAuthorityId"/></out-parameters>
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <return error="true" message="Only a platform administrator can manage tax authorities."/>
            </if>
            <if condition="!description"><return error="true" message="Description is required."/></if>
            <if condition="parentTaxAuthorityId &amp;&amp; parentTaxAuthorityId == taxAuthorityId">
                <return error="true" message="A tax authority cannot be its own parent."/>
            </if>
            <service-call name="store#zenith.erp.tax.TaxAuthority" out-map="context"
                in-map="[taxAuthorityId:taxAuthorityId, description:description,
                         taxAuthorityTypeEnumId:taxAuthorityTypeEnumId, countryGeoId:countryGeoId,
                         regionGeoId:regionGeoId, parentTaxAuthorityId:parentTaxAuthorityId, isActive:isActive]"/>
        </actions>
    </service>

    <service verb="delete" noun="TaxAuthority">
        <description>Delete a Tax Authority (platform-admin only; blocked while referenced).</description>
        <in-parameters><parameter name="taxAuthorityId" required="true"/></in-parameters>
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <return error="true" message="Only a platform administrator can delete tax authorities."/>
            </if>
            <entity-find-one entity-name="zenith.erp.tax.TaxAuthority" value-field="auth"/>
            <if condition="!auth"><return error="true" message="Tax authority not found."/></if>
            <entity-find-count entity-name="zenith.erp.tax.TaxRate" count-field="c1"><econdition field-name="taxAuthorityId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxRegistration" count-field="c2"><econdition field-name="taxAuthorityId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxExemption" count-field="c3"><econdition field-name="taxAuthorityId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxLineDetail" count-field="c4"><econdition field-name="taxAuthorityId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxRule" count-field="c5"><econdition field-name="taxAuthorityId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxAuthority" count-field="c6"><econdition field-name="parentTaxAuthorityId" from="taxAuthorityId"/></entity-find-count>
            <set field="refs" from="(c1?:0)+(c2?:0)+(c3?:0)+(c4?:0)+(c5?:0)+(c6?:0)"/>
            <if condition="refs &gt; 0">
                <return error="true" message="Cannot delete: this tax authority is used by ${refs} record(s) (rates, registrations, exemptions, tax lines, rules, or child authorities). Deactivate it instead."/>
            </if>
            <entity-delete value-field="auth"/>
        </actions>
    </service>

    <service verb="store" noun="TaxRate">
        <description>Create or update a Tax Rate (platform-admin only).</description>
        <in-parameters>
            <parameter name="taxRateId"/>
            <parameter name="taxName"/>
            <parameter name="taxAuthorityId"/>
            <parameter name="taxCategoryId"/>
            <parameter name="taxTypeEnumId"/>
            <parameter name="rate" type="BigDecimal"/>
            <parameter name="rateTypeEnumId"/>
            <parameter name="effectiveFrom" type="Date"/>
            <parameter name="effectiveThru" type="Date"/>
            <parameter name="minTaxableAmount" type="BigDecimal"/>
            <parameter name="maxTaxableAmount" type="BigDecimal"/>
            <parameter name="isCompound"/>
            <parameter name="countryGeoId"/>
            <parameter name="regionGeoId"/>
            <parameter name="description"/>
            <parameter name="isActive"/>
        </in-parameters>
        <out-parameters><parameter name="taxRateId"/></out-parameters>
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <return error="true" message="Only a platform administrator can manage tax rates."/>
            </if>
            <if condition="!taxName"><return error="true" message="Tax Name is required."/></if>
            <if condition="effectiveFrom &amp;&amp; effectiveThru &amp;&amp; effectiveThru &lt; effectiveFrom">
                <return error="true" message="Effective Thru cannot be before Effective From."/>
            </if>
            <if condition="taxRateId">
                <service-call name="update#zenith.erp.tax.TaxRate" in-map="context"/>
                <else>
                    <!-- omit taxRateId so the auto-create sequences a fresh PK (a null PK in the map blocks the insert) -->
                    <service-call name="create#zenith.erp.tax.TaxRate" out-map="context"
                        in-map="[taxName:taxName, taxAuthorityId:taxAuthorityId, taxCategoryId:taxCategoryId,
                                 taxTypeEnumId:taxTypeEnumId, rate:rate, rateTypeEnumId:rateTypeEnumId,
                                 effectiveFrom:effectiveFrom, effectiveThru:effectiveThru,
                                 minTaxableAmount:minTaxableAmount, maxTaxableAmount:maxTaxableAmount,
                                 isCompound:isCompound, countryGeoId:countryGeoId, regionGeoId:regionGeoId,
                                 description:description, isActive:isActive]"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="delete" noun="TaxRate">
        <description>Delete a Tax Rate (platform-admin only; blocked while referenced).</description>
        <in-parameters><parameter name="taxRateId" required="true"/></in-parameters>
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <return error="true" message="Only a platform administrator can delete tax rates."/>
            </if>
            <entity-find-one entity-name="zenith.erp.tax.TaxRate" value-field="txr"/>
            <if condition="!txr"><return error="true" message="Tax rate not found."/></if>
            <entity-find-count entity-name="zenith.erp.tax.TaxRule" count-field="c1"><econdition field-name="taxRateId"/></entity-find-count>
            <entity-find-count entity-name="zenith.erp.tax.TaxLineDetail" count-field="c2"><econdition field-name="taxRateId"/></entity-find-count>
            <set field="refs" from="(c1?:0)+(c2?:0)"/>
            <if condition="refs &gt; 0">
                <return error="true" message="Cannot delete: this tax rate is used by ${refs} record(s). Deactivate it instead."/>
            </if>
            <entity-delete value-field="txr"/>
        </actions>
    </service>

    <!-- ========== CHECK TAX EXEMPTION ========== -->
    <service verb="check" noun="TaxExemption">
        <description>Checks if a party or product has a tax exemption</description>
        <in-parameters>
            <parameter name="partyId"/>
            <parameter name="productId"/>
            <parameter name="taxAuthorityId"/>
            <parameter name="transactionDate" type="Date" default="ec.user.nowTimestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="isExempt" type="Boolean"/>
            <parameter name="exemptionType"/>
            <parameter name="exemption" type="Map"/>
        </out-parameters>
        <actions>
            <set field="isExempt" from="false"/>
            <entity-find entity-name="zenith.erp.tax.TaxExemption" list="exemptions" limit="1">
                <econdition field-name="partyId" ignore-if-empty="true"/>
                <econdition field-name="productId" ignore-if-empty="true"/>
                <econdition field-name="taxAuthorityId" ignore-if-empty="true"/>
                <econdition field-name="isActive" value="Y"/>
                <econdition field-name="effectiveFrom" operator="less-equals" from="transactionDate" ignore-if-empty="true"/>
                <econditions combine="or">
                    <econdition field-name="effectiveThru" operator="is-null"/>
                    <econdition field-name="effectiveThru" operator="greater-equals" from="transactionDate"/>
                </econditions>
            </entity-find>
            <if condition="exemptions">
                <set field="isExempt" from="true"/>
                <set field="exemption" from="exemptions[0]"/>
                <set field="exemptionType" from="exemptions[0].exemptionTypeEnumId"/>
            </if>
        </actions>
    </service>

    <!-- ========== DELETE TAX LINE DETAILS FOR DOCUMENT ========== -->
    <service verb="delete" noun="TaxLineDetailsForDocument">
        <description>Clears all tax details for an entire document</description>
        <in-parameters>
            <parameter name="referenceType" required="true"/>
            <parameter name="referenceId" required="true"/>
        </in-parameters>
        <actions>
            <entity-delete-by-condition entity-name="zenith.erp.tax.TaxLineDetail">
                <econdition field-name="referenceType"/>
                <econdition field-name="referenceId"/>
            </entity-delete-by-condition>
        </actions>
    </service>

</services>
