<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Tax Registration" default-menu-include="false">

    <parameter name="registrationId" required="true"/>

    <transition name="updateTaxRegistration">
        <service-call name="zenith.tax.TaxServices.store#TaxRegistration"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-TAX security: cross-tenant IDOR render guard — only the owning org (super-admins exempt)
             may open a tax registration. Load NOTHING when blocked; widgets show a plain no-access panel. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_acc"
                      in-map="[entityName:'zenith.erp.tax.TaxRegistration', idField:'registrationId', idValue:registrationId, orgField:'organizationPartyId']"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.tax.TaxRegistration" value-field="taxRegistration"/>
        <!-- ZE-TAX-008: build the Region list for this registration's country (server-side; depends-on
             does not refetch on /qapps). Falls back to the tenant's country, then India. -->
        <set field="_activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="regCountry" from="taxRegistration?.countryGeoId"/>
        <if condition="!regCountry &amp;&amp; _activeOrg &amp;&amp; _activeOrg != '_NA_'">
            <entity-find entity-name="zenith.erp.base.CompanySettings" list="_cs">
                <econdition field-name="organizationPartyId" from="_activeOrg"/>
                <econdition field-name="settingKey" value="COUNTRY_GEO_ID"/>
            </entity-find>
            <if condition="_cs &amp;&amp; _cs[0].settingValue"><set field="regCountry" from="_cs[0].settingValue"/></if>
        </if>
        <set field="regCountry" from="regCountry ?: 'IND'"/>
        <set field="regionList" from="[]"/>
        <entity-find entity-name="moqui.basic.GeoAssoc" list="_ra">
            <econdition field-name="geoId" from="regCountry"/>
            <econdition field-name="geoAssocTypeEnumId" value="GAT_REGIONS"/>
        </entity-find>
        <set field="_rIds" from="_ra.collect{ it.toGeoId }"/>
        <if condition="_rIds">
            <entity-find entity-name="moqui.basic.Geo" list="regionList">
                <econdition field-name="geoId" operator="in" from="_rIds"/>
                <order-by field-name="geoName"/>
            </entity-find>
        </if>
        </if>
    </actions>

    <widgets>
        <!-- back link stays reachable even when blocked -->
        <container style="q-mb-md">
            <link url="../FindTaxRegistration" text="Back to List" style="text-primary"/>
        </container>

        <!-- cross-tenant / missing registration — plain notice, never another org's tax data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That tax registration isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to List” above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Tax Registration: ${taxRegistration.registrationNumber ?: taxRegistration.registrationId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <label text="Registration Details" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="UpdateTaxRegistration" transition="updateTaxRegistration" map="taxRegistration">
                <field name="registrationId"><default-field><hidden/></default-field></field>
                <field name="partyId"><default-field title="Party *">
                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName ? organizationName : (firstName + ' ' + lastName)}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="taxAuthorityId"><default-field title="Tax Authority *">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                            <order-by field-name="description"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="registrationTypeEnumId"><default-field title="Registration Type *">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxRegistrationType"/>
                            <order-by field-name="sequenceNum"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="registrationNumber"><default-field title="Registration Number *"><text-line size="25"/></default-field></field>
                <field name="countryGeoId"><default-field title="Country">
                    <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                        <entity-find entity-name="moqui.basic.Geo">
                            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                            <order-by field-name="geoName"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="regionGeoId"><default-field title="Region">
                    <!-- ZE-TAX-008: Region filtered to this registration's country (regionList, computed in
                         actions). Server-side filter — no depends-on (which doesn't refetch on /qapps). -->
                    <drop-down allow-empty="true">
                        <list-options list="regionList" key="${geoId}" text="${geoName}"/>
                    </drop-down></default-field></field>
                <field name="effectiveFrom"><default-field title="Effective From"><date-time type="date"/></default-field></field>
                <field name="effectiveThru"><default-field title="Effective Thru"><date-time type="date"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><conditional-field name="save_write" condition="modCanWrite" title="Update"><submit/></conditional-field><default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
            </form-single>
        </container>
        </widgets>
        </section>
    </widgets>
</screen>
