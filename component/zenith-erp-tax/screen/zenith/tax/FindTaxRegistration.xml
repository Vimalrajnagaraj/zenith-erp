<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Registrations" default-menu-index="5">

    <transition name="createTaxRegistration">
        <actions>
            <!-- the restyled modal submits ISO yyyy-MM-dd; parse explicitly so locale parsing can't mangle it -->
            <script><![CDATA[
                try {
                    if (effectiveFrom) effectiveFrom = java.sql.Date.valueOf(java.time.LocalDate.parse(effectiveFrom.toString()))
                    if (effectiveThru) effectiveThru = java.sql.Date.valueOf(java.time.LocalDate.parse(effectiveThru.toString()))
                } catch (Exception ignored) { ec.message.addError('Enter valid dates in YYYY-MM-DD format.'); }
            ]]></script>
            <service-call name="zenith.tax.TaxServices.create#TaxRegistration" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="editTaxRegistration"><default-response url="../EditTaxRegistration"/></transition>
    <!-- ZE-TAX-008 (live refilter): country->region options-url for the dependent Region drop-down.
         Returns GLOBAL geo reference data only (states of a country) — no tenant/org data, so no
         org-scoping needed (cf. ZE-SEC-JSON, which applies to tenant-data JSON lookups). -->
    <transition name="getRegionsForCountry" read-only="true">
        <service-call name="org.moqui.impl.BasicServices.get#GeoRegionsForDropDown"
                      in-map="[geoId:countryGeoId, term:term]" web-send-json-response="resultList"/>
        <default-response type="none"/>
    </transition>
    <!-- ZE-TAX-006: delete routed through the org-guarded service (never the auto delete# keyed by PK). -->
    <transition name="deleteTaxRegistration" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxRegistration"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-TAX-006: scope the list to the active org (was unfiltered → cross-tenant leak).
             Super-admins (ADMIN, no active org) still see every tenant's registrations. -->
        <set field="_org" from="ec.user.isInGroup('ADMIN') ? null : (ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId ?: '_NA_')"/>
        <entity-find entity-name="zenith.erp.tax.TaxRegistration" list="taxRegistrations">
            <search-form-inputs default-order-by="-registrationId"/>
            <econdition field-name="organizationPartyId" from="_org" ignore-if-empty="true"/>
            <!-- ZE-SALES-0306 f/u: exclude region-only "place of supply" rows (numberless tax registrations
                 recorded for no-GSTIN customers) - those are managed on the contact profile, not here, and
                 would otherwise show as confusing blank-number registrations. -->
            <econdition field-name="registrationNumber" operator="is-not-null"/>
        </entity-find>

        <!-- ZE-TAX-008: default the create form's Country to the tenant's country (CompanySettings
             COUNTRY_GEO_ID, fallback India) so Region loads in-country regions on first open. The
             Region drop-down itself refetches per Country via the getRegionsForCountry options-url. -->
        <set field="_activeOrg" from="ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId"/>
        <set field="regCountry" from="'IND'"/>
        <if condition="_activeOrg &amp;&amp; _activeOrg != '_NA_'">
            <entity-find entity-name="zenith.erp.base.CompanySettings" list="_cs">
                <econdition field-name="organizationPartyId" from="_activeOrg"/>
                <econdition field-name="settingKey" value="COUNTRY_GEO_ID"/>
            </entity-find>
            <if condition="_cs &amp;&amp; _cs[0].settingValue"><set field="regCountry" from="_cs[0].settingValue"/></if>
        </if>

        <script><![CDATA[
            // Option lists for the New Registration modal
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/'); appBase = _zi > 0 ? _uri.substring(0, _zi) : ''
            def _o = ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId ?: '_NA_'
            def _pf = ec.entity.find("mantle.party.PartyDetail"); if (_o) _pf.condition("ownerPartyId", _o)
            parties = _pf.orderBy("organizationName,lastName,firstName").limit(1000).list().collect { p -> def nm = p.organizationName ?: ((((p.firstName ?: '') + ' ' + (p.lastName ?: '')).trim()) ?: p.partyId); [id: p.partyId, label: nm] }
            taxAuthorities = ec.entity.find("zenith.erp.tax.TaxAuthority").condition("isActive", "Y").orderBy("description").list().collect { a -> [id: a.taxAuthorityId, label: a.description ?: a.taxAuthorityId] }
            regTypes = ec.entity.find("moqui.basic.Enumeration").condition("enumTypeId", "TaxRegistrationType").orderBy("sequenceNum").list().collect { e -> [id: e.enumId, label: e.description ?: e.enumId] }
            countries = ec.entity.find("moqui.basic.Geo").condition("geoTypeEnumId", "GEOT_COUNTRY").orderBy("geoName").list().collect { g -> [id: g.geoId, label: g.geoName ?: g.geoId] }
            regions = []
            if (regCountry) { try { def rr = ec.service.sync().name("org.moqui.impl.BasicServices.get#GeoRegionsForDropDown").parameters([geoId: regCountry]).call(); regions = (rr?.resultList ?: []).collect { [id: (it.geoId ?: it.value), label: (it.label ?: it.geoName ?: it.geoId)] } } catch (e) {} }
            // id → label maps for the table (Type short + Authority badge come from the registration type; Country from geo)
            regTypeMap = [:]; regTypes.each { regTypeMap[it.id] = it.label }
            countryMap = [:]; countries.each { countryMap[it.id] = it.label }
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
<div class="zc-tax-meta" data-screen="FindTaxRegistration" style="display:none"></div>
        <img alt="" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" onload="if(window.zcTaxInit){window.zcTaxInit();}else if(!window.zcTaxBoot){window.zcTaxBoot=1;var s=document.createElement('script');s.src='/zenithstatic/js/tax-forms.js?v=3';document.body.appendChild(s);}"/>

            <div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px">
                <div><div style="font-size:24px;font-weight:700;line-height:1.2;color:var(--z-text-main,#111827)">Tax Registrations</div><div style="font-size:13px;margin-top:5px;color:var(--z-text-muted,#6B7280)">View and manage tax registrations for compliance and reporting.</div></div>
                <#if (modCanWrite!false)>
                <button type="button" onclick="var o=document.getElementById('nr-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:19px">add</span>New Registration</button>
                </#if>
            </div>
        ]]></text></render-mode>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search tax registrations..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TaxRegistrationsForm" list="taxRegistrations" list-entry="tr" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true">
                <row-actions><script><![CDATA[
                    def td = (regTypeMap[tr.registrationTypeEnumId] ?: tr.registrationTypeEnumId ?: '').toString()
                    authBadge = td ?: '—'
                    def _pi = td.indexOf(' (')
                    typeShort = (_pi > 0) ? td.substring(0, _pi) : (td ?: '—')
                    activeBadge = (tr.isActive == 'Y') ? 'success' : 'danger'
                    activeText = tr.isActive ?: 'N'
                    countryStr = (countryMap[tr.countryGeoId] ?: tr.countryGeoId) ?: '—'
                    fromStr = (tr.effectiveFrom != null) ? ec.l10n.format(tr.effectiveFrom, 'dd MMM yyyy') : '—'
                    thruStr = (tr.effectiveThru != null) ? ec.l10n.format(tr.effectiveThru, 'dd MMM yyyy') : '—'
                ]]></script></row-actions>
                <field name="registrationId"><header-field title="ID" show-order-by="true"/>
                    <default-field title="ID">
                        <link url="editTaxRegistration" text="${tr.registrationId}" parameter-map="[registrationId:tr.registrationId]" style="z-idchip"/>
                    </default-field></field>
                <field name="partyId"><header-field title="Party" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName ? organizationName : (firstName + ' ' + lastName)}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="ownerPartyId" from="ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId ?: '_NA_'"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Party">
                        <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                        text="${organizationName ? organizationName : (firstName + ' ' + lastName)}"/>
                    </default-field></field>
                <field name="registrationNumber"><header-field title="Registration No." show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Registration No."><label text="${tr.registrationNumber ?: '—'}" type="span" style="text-dark"/></default-field></field>
                <field name="registrationTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxRegistrationType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type"><label text="${typeShort}" type="span" style="text-dark"/></default-field></field>
                <field name="taxAuthorityId"><header-field title="Authority" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Authority"><display-entity entity-name="zenith.erp.tax.TaxAuthority" key-field-name="taxAuthorityId" text="${description}"/></default-field></field>
                <field name="countryGeoId"><header-field title="Country" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                        <entity-find entity-name="moqui.basic.Geo">
                            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                            <order-by field-name="geoName"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Country"><label text="${countryStr}" type="span" style="text-grey-6"/></default-field></field>
                <field name="effectiveFrom"><header-field title="From" show-order-by="true"/>
                    <default-field title="From"><label text="${fromStr}" type="span" style="text-grey-6"/></default-field></field>
                <field name="effectiveThru"><header-field title="Thru" show-order-by="true"/>
                    <default-field title="Thru"><label text="${thruStr}" type="span" style="text-grey-6"/></default-field></field>
                <field name="isActive"><header-field title="Active" show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><label text="${activeText}" type="span" style="zenith-badge nd ${activeBadge}"/></default-field></field>
                <field name="editBtn"><default-field title="Actions">
                    <link url="editTaxRegistration" icon="fa fa-pencil" text="" parameter-map="[registrationId:tr.registrationId]" style="z-vlink" condition="modCanWrite"/>
                </default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteTaxRegistration" icon="fa fa-trash" text="" parameter-map="[registrationId:tr.registrationId]"
                          confirmation="Delete this tax registration? This cannot be undone." style="z-redlink" condition="modCanWrite"/>
                </default-field></field>
                <field name="kebabBtn"><default-field title="">
                    <link url="editTaxRegistration" text="⋮" parameter-map="[registrationId:tr.registrationId]" style="z-kebab"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>

        <!-- New Registration modal (custom; posts to the byte-identical createTaxRegistration transition). -->
        <section name="NewRegistrationModal"><condition><expression>modCanWrite</expression></condition><widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign nrRow="display:flex;align-items:center;gap:18px;margin-bottom:16px">
        <#assign nrLbl="width:180px;flex:0 0 auto;text-align:right;font-size:14px;font-weight:500;color:#111827">
        <#assign nrSelWhite="width:100%;box-sizing:border-box;height:48px;padding:0 52px 0 16px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;outline:none;background:#fff">
        <#assign nrSelLav="width:100%;box-sizing:border-box;height:48px;padding:0 52px 0 16px;border:1px solid transparent;border-radius:8px;font-size:14px;outline:none;background:#F5F3FF">
        <#assign nrInp="flex:1;min-width:0;height:48px;box-sizing:border-box;padding:0 16px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <#assign nrClr="position:absolute;right:34px;top:50%;transform:translateY(-50%);width:20px;height:20px;border-radius:50%;background:#9CA3AF;color:#fff;display:none;align-items:center;justify-content:center;font-size:15px;line-height:1;cursor:pointer;z-index:2">
        <#assign nrDwrap="position:relative;flex:0 0 340px">
        <#assign nrDico="position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:18px;color:#6B7280;pointer-events:none;z-index:1">
        <#assign nrDtxt="width:100%;box-sizing:border-box;height:48px;padding:0 16px 0 44px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;pointer-events:none">
        <#assign nrDnat="position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:2">
        <div id="nr-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.45);z-index:12000;align-items:flex-start;justify-content:center;padding:36px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <div style="background:#fff;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.25);width:100%;max-width:900px;max-height:92vh;overflow-y:auto">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:22px 28px;border-bottom:1px solid #E5E7EB">
                    <div style="font-size:22px;font-weight:700;color:#111827">New Registration</div>
                    <button type="button" onclick="document.getElementById('nr-overlay').style.display='none'" title="Close" style="width:34px;height:34px;border:none;background:transparent;color:#6B7280;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons">close</span></button>
                </div>
                <form class="zc-tax-form" method="post" action="${(appBase!'')}/zenith/tax/FindTaxRegistration/createTaxRegistration"><input type="hidden" name="moquiSessionToken" value="${(ec.web.sessionToken!'')?html}"/>
                    <div style="${nrRow}"><label for="nr-party" style="${nrLbl}">Party <span style="color:#EF4444">*</span></label>
                        <div style="position:relative;flex:1;min-width:0"><select required="required" id="nr-party" name="partyId" style="${nrSelWhite}"><option value="">Select party</option><#list (parties![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select><span class="nr-clear" data-for="nr-party" style="${nrClr}">&times;</span></div></div>
                    <div style="${nrRow}"><label for="nr-auth" style="${nrLbl}">Tax Authority <span style="color:#EF4444">*</span></label>
                        <select required="required" id="nr-auth" name="taxAuthorityId" style="${nrSelLav}"><option value="">Select tax authority</option><#list (taxAuthorities![]) as a><option value="${(a.id)?html}">${(a.label)?html}</option></#list></select></div>
                    <div style="${nrRow}"><label for="nr-regtype" style="${nrLbl}">Registration Type <span style="color:#EF4444">*</span></label>
                        <select required="required" id="nr-regtype" name="registrationTypeEnumId" style="${nrSelLav}"><option value="">Select registration type</option><#list (regTypes![]) as e><option value="${(e.id)?html}">${(e.label)?html}</option></#list></select></div>
                    <div style="${nrRow}"><label for="nr-regnumber" style="${nrLbl}">Registration Number</label>
                        <input required="required" id="nr-regnumber" name="registrationNumber" type="text" placeholder="Enter registration number" style="${nrInp}"/></div>
                    <div style="${nrRow}"><label for="nr-country" style="${nrLbl}">Country <span style="color:#EF4444">*</span></label>
                        <div style="position:relative;flex:1;min-width:0"><select id="nr-country" name="countryGeoId" style="${nrSelLav}"><option value="">Select country</option><#list (countries![]) as c><option value="${(c.id)?html}"<#if (regCountry!'') == c.id> selected</#if>>${(c.label)?html}</option></#list></select><span class="nr-clear" data-for="nr-country" style="${nrClr}">&times;</span></div></div>
                    <div style="${nrRow}"><label for="nr-region" style="${nrLbl}">Region</label>
                        <div style="position:relative;flex:1;min-width:0"><select id="nr-region" name="regionGeoId" style="${nrSelWhite}"><option value="">Select region</option><#list (regions![]) as r><option value="${(r.id)?html}">${(r.label)?html}</option></#list></select><span class="nr-clear" data-for="nr-region" style="${nrClr}">&times;</span></div></div>
                    <div style="${nrRow}"><label for="nr-efffrom-disp" style="${nrLbl}">Effective From (optional)</label>
                        <div style="${nrDwrap}"><span class="material-icons" style="${nrDico}">event</span><input id="nr-efffrom-disp" type="text" readonly placeholder="DD - MM - YYYY" style="${nrDtxt}"/><input id="nr-efffrom" name="effectiveFrom" type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" style="${nrDnat}"/></div></div>
                    <div style="${nrRow}"><label for="nr-effthru-disp" style="${nrLbl}">Effective Thru (optional)</label>
                        <div style="${nrDwrap}"><span class="material-icons" style="${nrDico}">event</span><input id="nr-effthru-disp" type="text" readonly placeholder="DD - MM - YYYY" style="${nrDtxt}"/><input id="nr-effthru" name="effectiveThru" type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" style="${nrDnat}"/></div></div>
                    <div style="display:flex;align-items:center;gap:14px;margin-top:4px">
                        <button type="submit" id="nr-create" style="display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:20px">add_circle</span>Create</button>
                        <span id="nr-result" style="font-size:13px"></span>
                    </div>
                </form>
            </div>
        </div>

        ]]></text></render-mode>
        </widgets></section>
    </widgets>
</screen>
