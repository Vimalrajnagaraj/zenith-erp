<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Rates" default-menu-index="3">

    <transition name="editTaxRate"><default-response url="../EditTaxRate"/></transition>
    <transition name="createTaxRate">
        <service-call name="zenith.tax.TaxServices.store#TaxRate"/>
        <default-response url="../EditTaxRate"/>
    </transition>
    <!-- ZE-TAX sweep: platform-admin-only delete; refuses if the rate is referenced anywhere. -->
    <transition name="deleteTaxRate" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxRate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Tax rates are GLOBAL master data (no org). Only platform super-admins may
             create/edit/delete; tenants get a read-only view (real GST rates are the statutory
             IndiaGstSlab list shown below). -->
        <set field="isSuperAdmin" from="ec.user.isInGroup('ADMIN')"/>
        <entity-find entity-name="zenith.erp.tax.TaxRate" list="taxRates">
            <search-form-inputs default-order-by="taxName"/>
        </entity-find>
        <set field="gstSlabs" from="[]"/>
        <script>try { gstSlabs = ec.entity.find("zenith.erp.india.IndiaGstSlab").condition("isActive","Y").orderBy("gstRate").list() } catch (Exception e) {}</script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Tax Rates" type="h4" style="text-weight-bold q-my-none"/>
            <section name="RateCreate">
                <condition><expression>isSuperAdmin &amp;&amp; modCanWrite</expression></condition>
                <widgets>
            <container-dialog id="CreateTaxRate" button-text="New Tax Rate" type="success">
                <form-single name="CreateTaxRateForm" transition="createTaxRate">
                    <field name="taxName"><default-field title="Tax Name"><text-line size="30"/></default-field></field>
                    <field name="taxAuthorityId"><default-field title="Tax Authority">
                        <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                            <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                                <econdition field-name="isActive" value="Y"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="taxCategoryId"><default-field title="Tax Category">
                        <drop-down allow-empty="true"><entity-options key="${taxCategoryId}" text="${categoryName}">
                            <entity-find entity-name="zenith.erp.tax.TaxCategory">
                                <econdition field-name="isActive" value="Y"/>
                                <order-by field-name="categoryName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="taxTypeEnumId"><default-field title="Tax Type">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="TaxType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="rate"><default-field title="Rate"><text-line size="10"/></default-field></field>
                    <field name="rateTypeEnumId"><default-field title="Rate Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="TaxRateType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="effectiveFrom"><default-field title="Effective From"><date-time type="date"/></default-field></field>
                    <field name="effectiveThru"><default-field title="Effective Thru"><date-time type="date"/></default-field></field>
                    <field name="countryGeoId"><default-field title="Country">
                        <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                            <entity-find entity-name="moqui.basic.Geo">
                                <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                                <order-by field-name="geoName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="regionGeoId"><default-field title="Region">
                        <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                            <entity-find entity-name="moqui.basic.Geo">
                                <econdition field-name="geoTypeEnumId" operator="in" value="GEOT_STATE,GEOT_PROVINCE,GEOT_TERRITORY"/>
                                <order-by field-name="geoName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
                </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="TaxRatesForm" list="taxRates" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true">
                <field name="taxName"><header-field title="Tax Name" show-order-by="true"><text-find size="20"/></header-field>
                    <conditional-field name="taxName" title="Tax Name"><condition><expression>isSuperAdmin</expression></condition>
                        <link url="editTaxRate" text="${taxName}" parameter-map="[taxRateId:taxRateId]"/>
                    </conditional-field>
                    <default-field title="Tax Name"><display/></default-field></field>
                <field name="taxAuthorityId"><header-field title="Authority" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Authority">
                        <display-entity entity-name="zenith.erp.tax.TaxAuthority" key-field-name="taxAuthorityId" text="${description}"/>
                    </default-field></field>
                <field name="taxTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="rate"><header-field show-order-by="true"/>
                    <default-field title="Rate"><display format="#0.####"/></default-field></field>
                <field name="rateTypeEnumId">
                    <default-field title="Rate Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="effectiveFrom"><header-field show-order-by="true"/>
                    <default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="effectiveThru"><header-field show-order-by="true"/>
                    <default-field title="Thru"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><display/></default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="deleteBtn" title="Actions"><condition><expression>isSuperAdmin &amp;&amp; modCanWrite</expression></condition>
                        <link url="deleteTaxRate" text="Delete" parameter-map="[taxRateId:taxRateId]"
                              confirmation="Delete this tax rate? Only allowed if it is not used anywhere." style="text-negative"/>
                    </conditional-field>
                    <default-field title=""><label text=""/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="GST Rate Slabs (India)" type="h6" style="text-weight-bold q-mb-xs"/>
            <label text="Statutory GST slabs used by the tax engine for billing. Assign a slab to each product under Inventory." type="p" style="text-grey-7 q-mb-md"/>
            <form-list name="GstSlabList" list="gstSlabs" skip-form="true">
                <field name="slabName"><default-field title="Slab"><display/></default-field></field>
                <field name="gstRate"><default-field title="GST %"><display format="#0.##"/></default-field></field>
                <field name="cgstRate"><default-field title="CGST %"><display format="#0.##"/></default-field></field>
                <field name="sgstRate"><default-field title="SGST %"><display format="#0.##"/></default-field></field>
                <field name="igstRate"><default-field title="IGST %"><display format="#0.##"/></default-field></field>
                <field name="cessRate"><default-field title="Cess %"><display format="#0.##"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
