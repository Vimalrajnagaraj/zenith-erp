<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Tax Authority" default-menu-include="false">

    <parameter name="taxAuthorityId" required="true"/>

    <transition name="updateTaxAuthority">
        <service-call name="update#zenith.erp.tax.TaxAuthority"/>
        <default-response url="."/>
    </transition>
    <transition name="editTaxRate"><default-response url="../EditTaxRate"/></transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.tax.TaxAuthority" value-field="taxAuthority"/>

        <entity-find entity-name="zenith.erp.tax.TaxRate" list="taxRates">
            <econdition field-name="taxAuthorityId"/>
            <order-by field-name="taxName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Tax Authority: ${taxAuthority.description}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="../FindTaxAuthority" text="Back to List" style="text-primary"/>
        </container>

        <!-- Tax Authority Details -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Tax Authority Details" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="UpdateTaxAuthority" transition="updateTaxAuthority" map="taxAuthority">
                <field name="taxAuthorityId"><default-field title="ID"><display/></default-field></field>
                <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                <field name="taxAuthorityTypeEnumId"><default-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxAuthorityType"/>
                            <order-by field-name="sequenceNum"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="countryGeoId"><default-field title="Country">
                    <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                        <entity-find entity-name="moqui.basic.Geo">
                            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                            <order-by field-name="geoName"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="regionGeoId"><default-field title="Region">
                    <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                        <entity-find entity-name="moqui.basic.Geo">
                            <econdition field-name="geoTypeEnumId" operator="in" value="GEOT_STATE,GEOT_PROVINCE,GEOT_TERRITORY"/>
                            <order-by field-name="geoName"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="parentTaxAuthorityId"><default-field title="Parent Authority">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                            <econdition field-name="taxAuthorityId" operator="not-equals" from="taxAuthorityId"/>
                            <order-by field-name="description"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-single>
        </container>

        <!-- Related Tax Rates -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Tax Rates" type="h5" style="text-weight-bold q-my-none"/>
            </container>
            <form-list name="TaxRatesForm" list="taxRates" skip-form="true" show-csv-button="true" show-xlsx-button="true">
                <field name="taxName"><default-field title="Tax Name">
                    <link url="editTaxRate" text="${taxName}" parameter-map="[taxRateId:taxRateId]"/>
                </default-field></field>
                <field name="taxTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="rate"><default-field title="Rate">
                    <display format="#0.####"/></default-field></field>
                <field name="rateTypeEnumId"><default-field title="Rate Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="effectiveFrom"><default-field title="From">
                    <display format="dd-MMM-yyyy"/></default-field></field>
                <field name="effectiveThru"><default-field title="Thru">
                    <display format="dd-MMM-yyyy"/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
