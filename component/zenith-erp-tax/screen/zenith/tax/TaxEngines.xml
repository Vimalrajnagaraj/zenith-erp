<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Global Tax Engines" default-menu-index="50">

    <transition name="saveConfig">
        <service-call name="zenith.tax.TaxServices.save#TaxEngineConfig" in-map="context"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteConfig" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxEngineConfig"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.tax.TaxEngineConfig" list="configs">
            <econdition field-name="tenantId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Global Tax Engines" type="h4" style="text-weight-bold q-my-none"/>
            <section name="AddConfig_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="AddConfigDialog" button-text="Add Tax Engine" type="primary">
                <form-single name="AddConfigForm" transition="saveConfig">
                    <field name="tenantId"><default-field><hidden default-value="${ec.user.getPreference('ACTIVE_ORGANIZATION')}"/></default-field></field>
                    <field name="providerEnumId"><default-field title="Tax Provider *">
                        <drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TaxProvider"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="apiEndpoint"><default-field title="API Endpoint URL *"><text-line size="50"/></default-field></field>
                    <field name="apiKey"><default-field title="API Key / Account ID *"><text-line size="50"/></default-field></field>
                    <field name="apiSecret"><default-field title="API Secret / License Key *"><password size="50"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="_note"><default-field>
                        <label text="Credentials are checked for format and matched to the provider before saving. Live authentication with the provider is verified when the integration goes live." style="text-caption text-grey-7"/>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Save Config"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <form-list name="ConfigList" list="configs" skip-form="true">
                        <field name="providerEnumId"><default-field title="Provider">
                            <display-entity entity-name="moqui.basic.Enumeration"/>
                        </default-field></field>
                        <field name="apiEndpoint"><default-field title="API Endpoint"><display/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <display text="${isActive == 'Y' ? 'Yes' : 'No'}" style="${isActive == 'Y' ? 'text-success' : 'text-danger'} text-weight-bold"/>
                        </default-field></field>
                        <field name="deleteBtn"><default-field title="Actions">
                            <link url="deleteConfig" text="Delete" parameter-map="[configId:configId]"
                                  confirmation="Delete this tax engine configuration?" style="text-negative" condition="modCanWrite"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
