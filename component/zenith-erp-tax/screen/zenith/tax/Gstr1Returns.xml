<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GST Returns" default-menu-index="6">

    <parameter name="filingId"/>

    <transition name="generateGstr1">
        <!-- ZE-TAX-009: validate prerequisites and never surface a raw 500. The service requires a
             non-empty organizationPartyId + returnPeriod; a super-admin (no active org) previously
             hit "Field cannot be empty" → 500. Check the prereqs with friendly messages, and wrap
             the call so any other failure is shown gracefully instead of a stack trace. -->
        <actions>
            <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!orgId || orgId == '_NA_'">
                <return error="true" message="Select a company before generating GSTR-1. (Super-admins: switch to a specific tenant first.)"/>
            </if>
            <if condition="!ec.web.parameters.returnPeriod">
                <return error="true" message="Enter a Return Period in MMYYYY format (e.g. 072026)."/>
            </if>
            <script><![CDATA[
                try {
                    genOut = ec.service.sync().name("zenith.india.Gstr1Services.extract#Gstr1Data")
                        .parameters([organizationPartyId: orgId,
                                     returnPeriod: ec.web.parameters.returnPeriod,
                                     financialYear: ec.web.parameters.financialYear]).call()
                } catch (Exception e) {
                    ec.message.addError("Could not generate GSTR-1 for this period. " + (e.getMessage() ?: "Please check the period and try again."))
                }
            ]]></script>
        </actions>
        <default-response url="." parameter-map="[filingId:genOut?.filingId]"/>
        <error-response url="."/>
    </transition>
    <transition name="downloadGstr1Json" read-only="true">
        <parameter name="filingId" required="true"/>
        <actions>
            <entity-find-one entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="filing"/>
            <if condition="filing != null &amp;&amp; filing.jsonPayload != null">
                <script>ec.web.sendTextResponse(filing.jsonPayload, "application/json", "GSTR1_" + filing.returnPeriod + ".json")</script>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="mn &gt;= 4 ? yr : yr - 1"/>
        <set field="currentFy" value="${fyStart}-${fyStart + 1}"/>
        <set field="mnStr" from="mn &lt; 10 ? '0' + mn : '' + mn"/>
        <set field="currentPeriod" value="${mnStr}${yr}"/>

        <entity-find entity-name="zenith.erp.india.gstr1.Gstr1Filing" list="filingList">
            <econdition field-name="organizationPartyId" from="orgId"/>
            <order-by field-name="-filingDate"/>
        </entity-find>

        <set field="b2csList" from="[]"/><set field="b2bRecList" from="[]"/><set field="hsnList" from="[]"/>
        <if condition="filingId">
            <entity-find-one entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="curFiling"/>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1B2csRecord" list="b2csList"><econdition field-name="filingId"/><order-by field-name="rate"/></entity-find>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1B2bRecord" list="b2bRecList"><econdition field-name="filingId"/></entity-find>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1HsnSummary" list="hsnList"><econdition field-name="filingId"/></entity-find>
            <script>
                totB2cs = b2csList.sum { ((it.taxableValue ?: 0) as BigDecimal) } ?: 0
                totTax = (b2csList.sum { (((it.cgstAmount?:0)+(it.sgstAmount?:0)+(it.igstAmount?:0)) as BigDecimal) } ?: 0) + (b2bRecList.sum { (((it.cgstAmount?:0)+(it.sgstAmount?:0)+(it.igstAmount?:0)) as BigDecimal) } ?: 0)
            </script>
        </if>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <label text="GST Returns — GSTR-1" type="h4" style="text-weight-bold q-my-none"/>
            <label text="Generate the outward-supply (GSTR-1) return from your POS sales and invoices for a period." type="p" style="text-grey-7 q-mt-xs"/>
        </container>
        <container-row>
            <row-col lg="5" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Generate Return" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-single name="GenForm" transition="generateGstr1">
                        <field name="returnPeriod"><default-field title="Return Period (MMYYYY)"><text-line size="6" default-value="${currentPeriod}"/></default-field></field>
                        <field name="financialYear"><default-field title="Financial Year"><text-line size="9" default-value="${currentFy}"/></default-field></field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite" title=""><submit text="Generate GSTR-1" icon="fa fa-cogs"/></conditional-field><default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            <row-col lg="7" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Saved Filings" type="h6" style="text-weight-bold q-mb-sm"/>
                    <form-list name="FilingList" list="filingList" skip-form="true">
                        <field name="returnPeriod"><default-field title="Period"><link url="." text="${returnPeriod}" parameter-map="[filingId:filingId]"/></default-field></field>
                        <field name="financialYear"><default-field title="FY"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display/></default-field></field>
                        <field name="filingDate"><default-field title="Generated"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="dl"><default-field title="JSON"><link url="downloadGstr1Json" text="Download" parameter-map="[filingId:filingId]" link-type="anchor"/></default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>

        <section name="FilingDetail" condition="curFiling">
            <widgets>
                <container-row>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Period" style="text-grey-7 text-caption"/><label text="${curFiling.returnPeriod}" type="h5" style="text-weight-bold text-primary"/></container></row-col>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Taxable Value (B2CS)" style="text-grey-7 text-caption"/><label text="₹${ec.l10n.format(totB2cs, '#,##,##0.00')}" type="h5" style="text-weight-bold text-positive"/></container></row-col>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Total Tax" style="text-grey-7 text-caption"/><label text="₹${ec.l10n.format(totTax, '#,##,##0.00')}" type="h5" style="text-weight-bold text-teal-8"/></container></row-col>
                </container-row>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="B2C (Small) — by Place of Supply &amp; Rate" type="h6" style="text-weight-bold q-mb-sm"/>
                    <form-list name="B2csTable" list="b2csList" skip-form="true">
                        <field name="placeOfSupply"><default-field title="Place of Supply"><display/></default-field></field>
                        <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                        <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                    </form-list>
                </container>
                <section name="B2bSec" condition="b2bRecList">
                    <widgets>
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                        <label text="B2B — Registered Buyers" type="h6" style="text-weight-bold q-mb-sm"/>
                        <form-list name="B2bTable" list="b2bRecList" skip-form="true">
                            <field name="buyerGstin"><default-field title="Buyer GSTIN"><display/></default-field></field>
                            <field name="invoiceNumber"><default-field title="Invoice"><display/></default-field></field>
                            <field name="placeOfSupply"><default-field title="POS"><display/></default-field></field>
                            <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                            <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                            <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                            <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                            <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                        </form-list>
                    </container>
                    </widgets>
                </section>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="HSN / SAC Summary" type="h6" style="text-weight-bold q-mb-sm"/>
                    <form-list name="HsnTable" list="hsnList" skip-form="true">
                        <field name="hsnSacCode"><default-field title="HSN/SAC"><display/></default-field></field>
                        <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                        <field name="totalQuantity"><default-field title="Qty"><display format="#,##0.###"/></default-field></field>
                        <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
