<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GST Returns" default-menu-index="6">

    <parameter name="filingId"/>

    <transition name="generateGstr1">
        <!-- ZE-TAX-009: validate prerequisites and never surface a raw 500. The service requires a
             non-empty organizationPartyId + returnPeriod; a super-admin (no active org) previously
             hit "Field cannot be empty" → 500. Check the prereqs with friendly messages, and wrap
             the call so any other failure is shown gracefully instead of a stack trace. -->
        <actions>
            <set field="orgId" from="ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId"/>
            <if condition="!orgId || orgId == '_NA_'">
                <return error="true" message="Select a company before generating GSTR-1. (Super-admins: switch to a specific tenant first.)"/>
            </if>
            <if condition="!ec.web.parameters.returnPeriod">
                <return error="true" message="Enter a Return Period in MMYYYY format (e.g. 072026)."/>
            </if>
            <script><![CDATA[
                try {
                    genOut = ec.service.sync().name("zenith.india.Gstr1Services.extract#Gstr1Data")
                        .parameters([organizationPartyId: orgId,
                                     returnPeriod: ec.web.parameters.returnPeriod,
                                     financialYear: ec.web.parameters.financialYear]).call()
                } catch (Exception e) {
                    ec.message.addError("Could not generate GSTR-1 for this period. " + (e.getMessage() ?: "Please check the period and try again."))
                }
            ]]></script>
        </actions>
        <default-response url="." parameter-map="[filingId:genOut?.filingId]"/>
        <error-response url="."/>
    </transition>
    <transition name="downloadGstr1Json" read-only="true">
        <parameter name="filingId" required="true"/>
        <actions>
            <entity-find-one entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="filing"/>
            <if condition="!filing"><return error="true" message="GST filing not found."/></if>
            <service-call name="zenith.tax.TaxAccessServices.assert#Organization" in-map="[organizationPartyId:filing.organizationPartyId]"/>
            <if condition="filing != null &amp;&amp; filing.jsonPayload != null">
                <script>ec.web.sendTextResponse(filing.jsonPayload, "application/json", "GSTR1_" + filing.returnPeriod + ".json")</script>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="orgId" from="ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId"/>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="mn &gt;= 4 ? yr : yr - 1"/>
        <set field="currentFy" value="${fyStart}-${fyStart + 1}"/>
        <set field="mnStr" from="mn &lt; 10 ? '0' + mn : '' + mn"/>
        <set field="currentPeriod" value="${mnStr}${yr}"/>

        <entity-find entity-name="zenith.erp.india.gstr1.Gstr1Filing" list="filingList">
            <econdition field-name="organizationPartyId" from="orgId"/>
            <order-by field-name="-filingDate"/>
        </entity-find>

        <set field="b2csList" from="[]"/><set field="b2bRecList" from="[]"/><set field="hsnList" from="[]"/>
        <if condition="filingId">
            <service-call name="zenith.tax.TaxAccessServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.india.gstr1.Gstr1Filing',idField:'filingId',idValue:filingId,orgField:'organizationPartyId']" out-map="filingAccess"/>
            <if condition="!filingAccess.allowed"><return error="true" message="GST filing is unavailable for this organization."/></if>
            <entity-find-one entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="curFiling"/>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1B2csRecord" list="b2csList"><econdition field-name="filingId"/><order-by field-name="rate"/></entity-find>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1B2bRecord" list="b2bRecList"><econdition field-name="filingId"/></entity-find>
            <entity-find entity-name="zenith.erp.india.gstr1.Gstr1HsnSummary" list="hsnList"><econdition field-name="filingId"/></entity-find>
            <script>
                totB2cs = b2csList.sum { ((it.taxableValue ?: 0) as BigDecimal) } ?: 0
                def returnRows = ['Gstr1B2csRecord','Gstr1B2bRecord','Gstr1B2clRecord','Gstr1ExportRecord','Gstr1CdnrRecord'].collectMany { ec.entity.find('zenith.erp.india.gstr1.'+it).condition('filingId',filingId).list().collect { value -> def r=value.getMap(); [tax:((r.cgstAmount?:0)+(r.sgstAmount?:0)+(r.igstAmount?:0)+(r.cessAmount?:0)),sign:(it == 'Gstr1CdnrRecord' &amp;&amp; r.noteType == 'C' ? -1 : 1)] } }
                totTax = returnRows.sum { r -> (r.tax as BigDecimal) * r.sign } ?: 0
            </script>
        </if>

        <script><![CDATA[
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/'); appBase = _zi > 0 ? _uri.substring(0, _zi) : ''
            // Return-period options: last 24 months (value MMYYYY, display MM/YYYY)
            periodOpts = []
            def _c = new java.util.GregorianCalendar()
            for (int i = 0; i < 24; i++) { def _m = _c.get(java.util.Calendar.MONTH) + 1; def _y = _c.get(java.util.Calendar.YEAR); def _mm = _m < 10 ? ('0' + _m) : ('' + _m); periodOpts.add([val: _mm + '' + _y, disp: _mm + '/' + _y]); _c.add(java.util.Calendar.MONTH, -1) }
            // Financial-year options (current + 4 back)
            fyOpts = []
            def _fs = (fyStart as int)
            for (int i = 0; i < 5; i++) { def _s = _fs - i; fyOpts.add([val: _s + '-' + (_s + 1), disp: _s + '-' + (_s + 1)]) }
            // Saved filings, formatted for the table
            def _statusDesc = { sid -> ec.entity.find("moqui.basic.StatusItem").condition("statusId", sid).useCache(true).one()?.description ?: sid }
            def _badgeOf = { desc -> def _d = (desc ?: '').toString().toLowerCase(); _d.contains('draft') ? 'warning' : ((_d.contains('fil') || _d.contains('submit')) ? 'success' : 'grey') }
            filings = (filingList ?: []).collect { f ->
                def _rp = (f.returnPeriod ?: '').toString(); def _rpd = (_rp.length() == 6) ? (_rp.substring(0, 2) + '/' + _rp.substring(2)) : _rp
                def _sd = _statusDesc(f.statusId)
                [id: f.filingId, period: _rpd, fy: (f.financialYear ?: ''), status: _sd, badge: _badgeOf(_sd),
                 gen: (f.filingDate ? ec.l10n.format(f.filingDate, 'dd MMM yyyy, hh:mm a') : '')]
            }
            filingCount = filings.size()
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <input id="gstr1-token" type="hidden" value="${(ec.web.sessionToken!'')?html}"/>
        <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="display:none" onload="if(window.__gstr1Init){window.__gstr1Init();}else if(!window.__gstr1Boot){window.__gstr1Boot=1;var s=document.createElement('script');s.src='/zenithstatic/js/gstr1-returns.js?v=3';document.body.appendChild(s);}"/>
        <div style="padding:16px 16px 0;font-family:'Segoe UI',Arial,sans-serif">
            <div style="font-size:12.5px;color:#6B7280;margin-bottom:12px"><a href="${(appBase!'')}/zenith/tax/TaxDashboard" style="color:#6B7280;text-decoration:none">Tax</a> <span style="color:#9CA3AF">&rsaquo;</span> <a href="." style="color:#6B7280;text-decoration:none">GST Returns</a> <span style="color:#9CA3AF">&rsaquo;</span> GSTR-1</div>

            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px;flex-wrap:wrap">
                <div style="min-width:0">
                    <div style="font-size:24px;font-weight:800;color:#111827;line-height:1.2">GST Returns &mdash; GSTR-1</div>
                    <div style="font-size:13px;color:#6B7280;margin-top:4px">Generate the outward-supply return from your POS sales and invoices.</div>
                </div>
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
                    <button type="button" id="gstr1-guide-btn" style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 18px;background:#fff;color:#111827;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px;color:#6B7280">menu_book</span>Guide</button>
                    <#if (modCanWrite!false)><button type="button" id="gstr1-gen-hdr" style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 20px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">description</span>Generate GSTR-1</button></#if>
                </div>
            </div>

            <details id="gstr1-guide" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:10px 16px;margin-bottom:16px">
                <summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128220; GSTR-1 &mdash; quick guide</summary>
                <div style="font-size:13px;color:#202124;line-height:1.85;margin-top:8px">GSTR-1 is your monthly/quarterly return of outward supplies (sales). <b>1</b>&nbsp;Pick the <b>Return Period</b> and <b>Financial Year</b>. <b>2</b>&nbsp;Click <b>Generate GSTR-1</b> &mdash; it reads your POS sales and invoices for that period and builds the B2C, B2B and HSN sections. <b>3</b>&nbsp;Open a saved filing to review it, then <b>Download</b> the draft JSON for reconciliation and schema validation before uploading on the GST portal. Always reconcile against your books before filing.</div>
            </details>

            <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">
                <!-- Generate Return -->
                <section style="flex:1 1 340px;min-width:0;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:24px;box-shadow:0 1px 3px rgba(17,24,39,.06)">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px"><span class="z-icobadge primary"><span class="material-icons">description</span></span><span style="font-size:15px;font-weight:700;color:#111827">Generate Return</span></div>
                    <div style="margin-bottom:16px">
                        <label for="gstr1-period" style="display:block;font-size:12.5px;font-weight:600;color:#6B7280;margin-bottom:6px">Return Period (MM/YYYY)</label>
                        <div style="position:relative"><span class="material-icons" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:18px;color:#9CA3AF;pointer-events:none">calendar_today</span>
                            <select id="gstr1-period" style="width:100%;box-sizing:border-box;height:46px;padding:0 12px 0 40px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff"><#list (periodOpts![]) as p><option value="${(p.val)?html}"<#if (currentPeriod!'') == p.val> selected</#if>>${(p.disp)?html}</option></#list></select></div>
                    </div>
                    <div style="margin-bottom:20px">
                        <label for="gstr1-fy" style="display:block;font-size:12.5px;font-weight:600;color:#6B7280;margin-bottom:6px">Financial Year</label>
                        <div style="position:relative"><span class="material-icons" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:18px;color:#9CA3AF;pointer-events:none">calendar_today</span>
                            <select disabled="disabled" id="gstr1-fy" style="width:100%;box-sizing:border-box;height:46px;padding:0 12px 0 40px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff"><#list (fyOpts![]) as fy><option value="${(fy.val)?html}"<#if (currentFy!'') == fy.val> selected</#if>>${(fy.disp)?html}</option></#list></select></div>
                    </div>
                    <#if (modCanWrite!false)>
                    <button type="button" id="gstr1-gen" style="width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">auto_awesome</span>Generate GSTR-1</button>
                    <#else><div style="font-size:12.5px;color:#6B7280">You have view-only access &mdash; changes are disabled.</div></#if>
                </section>

                <!-- Saved Filings -->
                <section style="flex:1.5 1 500px;min-width:0;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:24px;box-shadow:0 1px 3px rgba(17,24,39,.06)">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px"><span class="z-icobadge primary"><span class="material-icons">description</span></span><span style="font-size:15px;font-weight:700;color:#111827">Saved Filings</span></div>
                    <div style="overflow-x:auto">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:560px">
                        <thead><tr style="text-align:left;color:#6B7280;border-bottom:1px solid #E5E7EB">
                            <th style="padding:10px 12px;font-weight:600;font-size:12px">Period</th>
                            <th style="padding:10px 12px;font-weight:600;font-size:12px">Financial Year</th>
                            <th style="padding:10px 12px;font-weight:600;font-size:12px">Status</th>
                            <th style="padding:10px 12px;font-weight:600;font-size:12px">Generated On</th>
                            <th style="padding:10px 12px;font-weight:600;font-size:12px">Action</th>
                        </tr></thead>
                        <tbody id="gstr1-tbody">
                            <#list (filings![]) as f>
                            <tr class="gstr1-row" style="border-bottom:1px solid #F1F1F4">
                                <td style="padding:12px"><a href="${(appBase!'')}/zenith/tax/Gstr1Returns?filingId=${(f.id)?html}" style="display:inline-block;padding:4px 12px;border:1px solid #7C3AED;border-radius:8px;color:#7C3AED;font-weight:600;font-size:12.5px;text-decoration:none">${(f.period)?html}</a></td>
                                <td style="padding:12px;color:#111827">${(f.fy)?html}</td>
                                <td style="padding:12px"><span class="zenith-badge ${f.badge} nd">${(f.status)?upper_case?html}</span></td>
                                <td style="padding:12px;color:#6B7280">${(f.gen)?html}</td>
                                <td style="padding:12px"><a href="${(appBase!'')}/zenith/tax/Gstr1Returns/downloadGstr1Json?filingId=${(f.id)?html}" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:#F5F3FF;border:1px solid #DDD6FE;border-radius:8px;color:#7C3AED;font-weight:600;font-size:12.5px;text-decoration:none"><span class="material-icons" style="font-size:15px">download</span>Download</a></td>
                            </tr>
                            </#list>
                        </tbody>
                    </table>
                    </div>
                    <#if (filingCount!0) == 0><div style="padding:32px 12px;text-align:center;color:#9CA3AF;font-size:13px">No GSTR-1 filings yet. Generate one on the left.</div></#if>
                </section>
            </div>

            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:16px 20px;margin-top:20px;box-shadow:0 1px 3px rgba(17,24,39,.06)">
                <span id="gstr1-showing" style="font-size:12.5px;color:#6B7280"></span>
                <div style="display:flex;align-items:center;gap:12px">
                    <select id="gstr1-perpage" style="height:34px;padding:0 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:12.5px;color:#111827;background:#fff"><option value="10">10 per page</option><option value="25">25 per page</option><option value="50">50 per page</option></select>
                    <nav id="gstr1-pager" style="display:flex;align-items:center;gap:6px"></nav>
                </div>
            </div>
        </div>
        ]]></text></render-mode>

        <section name="FilingDetail" condition="curFiling">
            <widgets>
                <container-row>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Period" style="text-grey-7 text-caption"/><label text="${curFiling.returnPeriod}" type="h5" style="text-weight-bold text-primary"/></container></row-col>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Taxable Value (B2CS)" style="text-grey-7 text-caption"/><label text="₹${zinr.inr(ec.l10n.format(totB2cs, '#,##,##0.00'))}" type="h5" style="text-weight-bold text-positive"/></container></row-col>
                    <row-col lg="4"><container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center"><label text="Total Tax" style="text-grey-7 text-caption"/><label text="₹${zinr.inr(ec.l10n.format(totTax, '#,##,##0.00'))}" type="h5" style="text-weight-bold text-teal-8"/></container></row-col>
                </container-row>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="B2C (Small) — by Place of Supply &amp; Rate" type="h6" style="text-weight-bold q-mb-sm"/>
                    <form-list name="B2csTable" list="b2csList" skip-form="true">
                        <field name="placeOfSupply"><default-field title="Place of Supply"><display/></default-field></field>
                        <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                        <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                    </form-list>
                </container>
                <section name="B2bSec" condition="b2bRecList">
                    <widgets>
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                        <label text="B2B — Registered Buyers" type="h6" style="text-weight-bold q-mb-sm"/>
                        <form-list name="B2bTable" list="b2bRecList" skip-form="true">
                            <field name="buyerGstin"><default-field title="Buyer GSTIN"><display/></default-field></field>
                            <field name="invoiceNumber"><default-field title="Invoice"><display/></default-field></field>
                            <field name="placeOfSupply"><default-field title="POS"><display/></default-field></field>
                            <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                            <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                            <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                            <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                            <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                        </form-list>
                    </container>
                    </widgets>
                </section>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="HSN / SAC Summary" type="h6" style="text-weight-bold q-mb-sm"/>
                    <form-list name="HsnTable" list="hsnList" skip-form="true">
                        <field name="hsnSacCode"><default-field title="HSN/SAC"><display/></default-field></field>
                        <field name="rate"><default-field title="Rate %"><display format="#0.##"/></default-field></field>
                        <field name="totalQuantity"><default-field title="Qty"><display format="#,##0.###"/></default-field></field>
                        <field name="taxableValue"><default-field title="Taxable"><display format="₹#,##,##0.00"/></default-field></field>
                        <field name="cgstAmount"><default-field title="CGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="sgstAmount"><default-field title="SGST"><display format="₹#,##0.00"/></default-field></field>
                        <field name="igstAmount"><default-field title="IGST"><display format="₹#,##0.00"/></default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
