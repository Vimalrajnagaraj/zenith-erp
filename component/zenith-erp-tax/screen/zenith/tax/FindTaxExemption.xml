<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Exemptions" default-menu-index="4">

    <transition name="editTaxExemption"><default-response url="../EditTaxExemption"/></transition>
    <transition name="createTaxExemption">
        <actions>
            <!-- the restyled modal submits ISO yyyy-MM-dd; parse explicitly so locale parsing can't mangle it -->
            <script><![CDATA[
                if (effectiveFrom) effectiveFrom = ec.l10n.parseDate(effectiveFrom.toString(), 'yyyy-MM-dd')
                if (effectiveThru) effectiveThru = ec.l10n.parseDate(effectiveThru.toString(), 'yyyy-MM-dd')
            ]]></script>
            <service-call name="zenith.tax.TaxServices.store#TaxExemption" out-map="context" in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        </actions>
        <default-response url="../EditTaxExemption" parameter-map="[exemptionId:exemptionId]"/>
    </transition>
    <!-- ZE-TAX-004: delete routed through the org-guarded service (never the auto delete# keyed by PK). -->
    <transition name="deleteTaxExemption" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxExemption"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-TAX-004: scope the list to the active org (was unfiltered → cross-tenant leak).
             Super-admins (ADMIN, no active org) still see every tenant's exemptions. -->
        <set field="_org" from="ec.user.isInGroup('ADMIN') ? null : (ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '_NA_')"/>
        <entity-find entity-name="zenith.erp.tax.TaxExemption" list="taxExemptions">
            <search-form-inputs default-order-by="-exemptionId"/>
            <econdition field-name="organizationPartyId" from="_org" ignore-if-empty="true"/>
        </entity-find>

        <script><![CDATA[
            // Option lists for the New Tax Exemption modal
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/'); appBase = _zi > 0 ? _uri.substring(0, _zi) : ''
            def _o = ec.user.getPreference('ACTIVE_ORGANIZATION')
            def _pf = ec.entity.find("mantle.party.PartyDetail"); if (_o) _pf.condition("ownerPartyId", _o)
            parties = _pf.orderBy("organizationName,lastName,firstName").limit(1000).list().collect { p -> def nm = p.organizationName ?: ((((p.firstName ?: '') + ' ' + (p.lastName ?: '')).trim()) ?: p.partyId); [id: p.partyId, label: nm] }
            def _prf = ec.entity.find("mantle.product.Product"); if (_o) _prf.condition("ownerPartyId", _o)
            products = _prf.orderBy("pseudoId").limit(1000).list().collect { pr -> [id: pr.productId, label: ((pr.pseudoId ?: '') + ' - ' + (pr.productName ?: ''))] }
            taxAuthorities = ec.entity.find("zenith.erp.tax.TaxAuthority").condition("isActive", "Y").orderBy("description").list().collect { a -> [id: a.taxAuthorityId, label: a.description ?: a.taxAuthorityId] }
            exemptionTypes = ec.entity.find("moqui.basic.Enumeration").condition("enumTypeId", "TaxExemptionType").orderBy("sequenceNum").list().collect { e -> [id: e.enumId, label: e.description ?: e.enumId] }
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Tax Exemptions" type="h4" style="text-weight-bold q-my-none"/>
            <section name="CreateTaxExemption_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <render-mode><text type="html,qvt" template="true"><![CDATA[
                <button type="button" onclick="var o=document.getElementById('te-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">add</span>New Tax Exemption</button>
            ]]></text></render-mode>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search tax exemptions..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TaxExemptionsForm" list="taxExemptions" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true">
                <field name="exemptionId"><header-field title="ID" show-order-by="true"/>
                    <default-field title="ID">
                        <link url="editTaxExemption" text="${exemptionId}" parameter-map="[exemptionId:exemptionId]"/>
                    </default-field></field>
                <field name="partyId"><header-field title="Party" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName ? organizationName : (firstName + ' ' + lastName)}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Party">
                        <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                        text="${organizationName ? organizationName : (firstName + ' ' + lastName)}"/>
                    </default-field></field>
                <field name="productId"><header-field title="Product" show-order-by="true"/>
                    <default-field title="Product">
                        <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${pseudoId} - ${productName}"/>
                    </default-field></field>
                <field name="taxAuthorityId"><header-field title="Authority" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Authority">
                        <display-entity entity-name="zenith.erp.tax.TaxAuthority" key-field-name="taxAuthorityId" text="${description}"/>
                    </default-field></field>
                <field name="exemptionTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxExemptionType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="exemptionNumber"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Number"><display/></default-field></field>
                <field name="effectiveFrom"><header-field show-order-by="true"/>
                    <default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="effectiveThru"><header-field show-order-by="true"/>
                    <default-field title="Thru"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><display/></default-field></field>
                <field name="editBtn"><default-field title="Actions">
                    <link url="editTaxExemption" text="Edit" parameter-map="[exemptionId:exemptionId]" style="text-primary" condition="modCanWrite"/>
                </default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteTaxExemption" text="Delete" parameter-map="[exemptionId:exemptionId]"
                          confirmation="Delete this tax exemption? This cannot be undone." style="text-negative" condition="modCanWrite"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>

        <!-- New Tax Exemption modal (custom; posts to the byte-identical createTaxExemption transition). -->
        <section name="NewTaxExemptionModal"><condition><expression>modCanWrite</expression></condition><widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign teRow="display:flex;align-items:center;gap:18px;margin-bottom:16px">
        <#assign teLbl="width:170px;flex:0 0 auto;text-align:right;font-size:14px;font-weight:500;color:#111827">
        <#assign teSelWhite="width:100%;box-sizing:border-box;height:48px;padding:0 52px 0 16px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;outline:none;background:#fff">
        <#assign teSelLav="width:100%;box-sizing:border-box;height:48px;padding:0 52px 0 16px;border:1px solid transparent;border-radius:8px;font-size:14px;outline:none;background:#F5F3FF">
        <#assign teInp="flex:1;min-width:0;height:48px;box-sizing:border-box;padding:0 16px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <#assign teClr="position:absolute;right:34px;top:50%;transform:translateY(-50%);width:20px;height:20px;border-radius:50%;background:#9CA3AF;color:#fff;display:none;align-items:center;justify-content:center;font-size:15px;line-height:1;cursor:pointer;z-index:2">
        <#assign teDwrap="position:relative;flex:0 0 340px">
        <#assign teDico="position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:18px;color:#6B7280;pointer-events:none;z-index:1">
        <#assign teDtxt="width:100%;box-sizing:border-box;height:48px;padding:0 16px 0 44px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;pointer-events:none">
        <#assign teDnat="position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:2">
        <div id="te-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.45);z-index:12000;align-items:flex-start;justify-content:center;padding:36px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <div style="background:#fff;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.25);width:100%;max-width:880px;max-height:92vh;overflow-y:auto">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:22px 28px;border-bottom:1px solid #E5E7EB">
                    <div style="font-size:22px;font-weight:700;color:#111827">New Tax Exemption</div>
                    <button type="button" onclick="document.getElementById('te-overlay').style.display='none'" title="Close" style="width:34px;height:34px;border:none;background:transparent;color:#6B7280;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons">close</span></button>
                </div>
                <div style="padding:28px 28px 20px">
                    <div style="${teRow}"><label style="${teLbl}">Party <span style="color:#DC2626">*</span></label>
                        <div style="position:relative;flex:1;min-width:0"><select id="te-party" style="${teSelWhite}"><option value="">Select party</option><#list (parties![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select><span class="te-clear" data-for="te-party" style="${teClr}">&times;</span></div></div>
                    <div style="${teRow}"><label style="${teLbl}">Product</label>
                        <div style="position:relative;flex:1;min-width:0"><select id="te-product" style="${teSelLav}"><option value="">Select product</option><#list (products![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select><span class="te-clear" data-for="te-product" style="${teClr}">&times;</span></div></div>
                    <div style="${teRow}"><label style="${teLbl}">Tax Authority <span style="color:#DC2626">*</span></label>
                        <div style="position:relative;flex:1;min-width:0"><select id="te-auth" style="${teSelLav}"><option value="">Select tax authority</option><#list (taxAuthorities![]) as a><option value="${(a.id)?html}">${(a.label)?html}</option></#list></select><span class="te-clear" data-for="te-auth" style="${teClr}">&times;</span></div></div>
                    <div style="${teRow}"><label style="${teLbl}">Exemption Type <span style="color:#DC2626">*</span></label>
                        <div style="position:relative;flex:1;min-width:0"><select id="te-type" style="${teSelLav}"><option value="">Select exemption type</option><#list (exemptionTypes![]) as e><option value="${(e.id)?html}">${(e.label)?html}</option></#list></select><span class="te-clear" data-for="te-type" style="${teClr}">&times;</span></div></div>
                    <div style="${teRow}"><label style="${teLbl}">Exemption Number</label>
                        <input id="te-number" type="text" placeholder="Enter exemption number" style="${teInp}"/></div>
                    <div style="${teRow}"><label style="${teLbl}">Effective From <span style="color:#DC2626">*</span></label>
                        <div style="${teDwrap}"><span class="material-icons" style="${teDico}">event</span><input id="te-efffrom-disp" type="text" readonly placeholder="DD - MM - YYYY" style="${teDtxt}"/><input id="te-efffrom" type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" style="${teDnat}"/></div></div>
                    <div style="${teRow}"><label style="${teLbl}">Effective Thru <span style="color:#DC2626">*</span></label>
                        <div style="${teDwrap}"><span class="material-icons" style="${teDico}">event</span><input id="te-effthru-disp" type="text" readonly placeholder="DD - MM - YYYY" style="${teDtxt}"/><input id="te-effthru" type="date" onclick="if(this.showPicker){try{this.showPicker();}catch(e){}}" style="${teDnat}"/></div></div>
                    <div style="display:flex;align-items:flex-start;gap:18px;margin-bottom:20px"><label style="${teLbl};padding-top:10px">Description</label>
                        <textarea id="te-desc" rows="3" placeholder="Enter description (optional)" style="flex:1;min-width:0;box-sizing:border-box;padding:12px 16px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;resize:vertical;outline:none"></textarea></div>
                    <div style="display:flex;align-items:center;gap:14px">
                        <button type="button" id="te-create" style="display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:20px">add_circle</span>Create</button>
                        <span id="te-result" style="font-size:13px"></span>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function(){
            var APPBASE='${(appBase!'')}';
            function setColor(s){ s.style.color = s.value ? '#111827' : '#9CA3AF'; }
            function fmtDisp(iso){ if(!iso) return ''; var p=iso.split('-'); return (p.length===3) ? (p[2]+' - '+p[1]+' - '+p[0]) : iso; }
            ['te-efffrom','te-effthru'].forEach(function(id){ var h=document.getElementById(id), d=document.getElementById(id+'-disp'); if(h && d){ h.addEventListener('change', function(){ d.value=fmtDisp(h.value); }); } });
            function toggleClear(sel){ var c=document.querySelector('.te-clear[data-for="'+sel.id+'"]'); if(c) c.style.display = sel.value ? 'flex' : 'none'; }
            Array.prototype.forEach.call(document.querySelectorAll('select[id^="te-"]'), function(s){ setColor(s); toggleClear(s); s.addEventListener('change', function(){ setColor(s); toggleClear(s); }); });
            document.addEventListener('click', function(ev){ var c=ev.target.closest ? ev.target.closest('.te-clear') : null; if(!c) return; var sel=document.getElementById(c.getAttribute('data-for')); if(sel){ sel.value=''; setColor(sel); toggleClear(sel); } });
            var btn=document.getElementById('te-create');
            if(btn && !btn.__w){ btn.__w=1; btn.addEventListener('click', function(){
                var g=function(id){ var e=document.getElementById(id); return e ? (e.value||'').trim() : ''; };
                var party=g('te-party'), prod=g('te-product'), auth=g('te-auth'), type=g('te-type');
                if(!auth){ alert('Tax Authority is required.'); return; }
                if(!type){ alert('Exemption Type is required.'); return; }
                if(!party && !prod){ alert('Select a Party or a Product.'); return; }
                var tok=''; try{ tok=window.moqui.webrootVue.moquiSessionToken; }catch(e){}
                btn.disabled=true; var ot=btn.innerHTML; btn.textContent='Creating...';
                var body=new URLSearchParams({ partyId:party, productId:prod, taxAuthorityId:auth, exemptionTypeEnumId:type,
                    exemptionNumber:g('te-number'), effectiveFrom:g('te-efffrom'), effectiveThru:g('te-effthru'),
                    description:g('te-desc'), moquiSessionToken:tok });
                fetch(APPBASE+'/zenith/tax/FindTaxExemption/createTaxExemption',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                    .then(function(r){ var u=r.url||''; if(u.indexOf('EditTaxExemption')>=0 && u.indexOf('exemptionId')>=0){ location.href=u; } else { location.reload(); } })
                    .catch(function(){ btn.disabled=false; btn.innerHTML=ot; var rr=document.getElementById('te-result'); if(rr){ rr.textContent='Create failed — please try again.'; rr.style.color='#DC2626'; } });
            }); }
        })();
        </script>
        ]]></text></render-mode>
        </widgets></section>
    </widgets>
</screen>
