<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Exemptions" default-menu-index="4">

    <transition name="editTaxExemption"><default-response url="../EditTaxExemption"/></transition>
    <transition name="createTaxExemption">
        <service-call name="zenith.tax.TaxServices.store#TaxExemption" in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="../EditTaxExemption"/>
    </transition>
    <!-- ZE-TAX-004: delete routed through the org-guarded service (never the auto delete# keyed by PK). -->
    <transition name="deleteTaxExemption" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxExemption"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-TAX-004: scope the list to the active org (was unfiltered → cross-tenant leak).
             Super-admins (ADMIN, no active org) still see every tenant's exemptions. -->
        <set field="_org" from="ec.user.isInGroup('ADMIN') ? null : (ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '_NA_')"/>
        <entity-find entity-name="zenith.erp.tax.TaxExemption" list="taxExemptions">
            <search-form-inputs default-order-by="-exemptionId"/>
            <econdition field-name="organizationPartyId" from="_org" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Tax Exemptions" type="h4" style="text-weight-bold q-my-none"/>
            <section name="CreateTaxExemption_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="CreateTaxExemption" button-text="New Tax Exemption" type="success">
                <form-single name="CreateTaxExemptionForm" transition="createTaxExemption">
                    <field name="partyId"><default-field title="Party">
                        <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName ? organizationName : (firstName + ' ' + lastName)}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down allow-empty="true"><entity-options key="${productId}" text="${pseudoId} - ${productName}">
                            <entity-find entity-name="mantle.product.Product">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                <order-by field-name="pseudoId"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="taxAuthorityId"><default-field title="Tax Authority *">
                        <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                            <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                                <econdition field-name="isActive" value="Y"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="exemptionTypeEnumId"><default-field title="Exemption Type *">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="TaxExemptionType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="exemptionNumber"><default-field title="Exemption Number"><text-line size="20"/></default-field></field>
                    <field name="effectiveFrom"><default-field title="Effective From"><date-time type="date"/></default-field></field>
                    <field name="effectiveThru"><default-field title="Effective Thru"><date-time type="date"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="TaxExemptionsForm" list="taxExemptions" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true">
                <field name="exemptionId"><header-field title="ID" show-order-by="true"/>
                    <default-field title="ID">
                        <link url="editTaxExemption" text="${exemptionId}" parameter-map="[exemptionId:exemptionId]"/>
                    </default-field></field>
                <field name="partyId"><header-field title="Party" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName ? organizationName : (firstName + ' ' + lastName)}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Party">
                        <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                        text="${organizationName ? organizationName : (firstName + ' ' + lastName)}"/>
                    </default-field></field>
                <field name="productId"><header-field title="Product" show-order-by="true"/>
                    <default-field title="Product">
                        <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${pseudoId} - ${productName}"/>
                    </default-field></field>
                <field name="taxAuthorityId"><header-field title="Authority" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                        <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                            <econdition field-name="isActive" value="Y"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Authority">
                        <display-entity entity-name="zenith.erp.tax.TaxAuthority" key-field-name="taxAuthorityId" text="${description}"/>
                    </default-field></field>
                <field name="exemptionTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxExemptionType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="exemptionNumber"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Number"><display/></default-field></field>
                <field name="effectiveFrom"><header-field show-order-by="true"/>
                    <default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="effectiveThru"><header-field show-order-by="true"/>
                    <default-field title="Thru"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><display/></default-field></field>
                <field name="editBtn"><default-field title="Actions">
                    <link url="editTaxExemption" text="Edit" parameter-map="[exemptionId:exemptionId]" style="text-primary" condition="modCanWrite"/>
                </default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteTaxExemption" text="Delete" parameter-map="[exemptionId:exemptionId]"
                          confirmation="Delete this tax exemption? This cannot be undone." style="text-negative" condition="modCanWrite"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
