<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Authorities" default-menu-index="2">

    <transition name="editTaxAuthority"><default-response url="../EditTaxAuthority"/></transition>
    <transition name="createTaxAuthority">
        <service-call name="zenith.tax.TaxServices.store#TaxAuthority"/>
        <default-response url="../EditTaxAuthority"/>
    </transition>
    <!-- ZE-TAX sweep: platform-admin-only delete; refuses if the authority is referenced anywhere. -->
    <transition name="deleteTaxAuthority" begin-transaction="true">
        <service-call name="zenith.tax.TaxServices.delete#TaxAuthority"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Tax authorities are GLOBAL master data (no org) — shared by all tenants. Only platform
             super-admins may create/edit/delete; tenants get a read-only view (the row edit/⋮ links reach
             EditTaxAuthority, which is view-only for non-admins). -->
        <set field="isSuperAdmin" from="ec.user.isInGroup('ADMIN')"/>

        <!-- Type enum → description map for the per-row Type pill. -->
        <entity-find entity-name="moqui.basic.Enumeration" list="typeEnums">
            <econdition field-name="enumTypeId" value="TaxAuthorityType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <script>typeDescMap = [:]; typeEnums.each { typeDescMap[it.enumId] = it.description }</script>

        <!-- Default the list to Active authorities (matches the mockup: the 2 live GST authorities). Override
             with ?isActive=N (inactive) or ?isActive= (empty → all). Filtered via an explicit econdition so it
             does not surface as a removable "Active: Active" find-chip the mockup doesn't have. -->
        <entity-find entity-name="zenith.erp.tax.TaxAuthority" list="taxAuthorities">
            <search-form-inputs default-order-by="description"/>
            <econdition field-name="isActive" from="ec.web.parameters.isActive ?: 'Y'" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Page header: title + subtitle. render-mode so the 24px title and muted subtitle match the mockup
             identically on /apps and /qapps (only <style>/<script> ELEMENTS are stripped on /qapps; inline
             style attributes render on both). The super-admin "New" button sits on the right; a tenant sees
             only the title+subtitle, exactly like the mockup. -->
        <container style="row items-center justify-between q-mb-lg">
            <render-mode><text type="html,qvt"><![CDATA[
                <div>
                    <div style="font-size:24px;font-weight:700;line-height:1.2;color:var(--z-text-main,#111827)">Tax Authorities</div>
                    <div style="font-size:13px;margin-top:5px;color:var(--z-text-muted,#6B7280)">Manage and configure tax authorities, rates, exemptions, and registrations across your organization.</div>
                </div>
            ]]></text></render-mode>
            <section name="AuthCreate">
                <condition><expression>isSuperAdmin &amp;&amp; modCanWrite</expression></condition>
                <widgets>
                <container style="z-newbtn-wrap">
                <container-dialog id="CreateTaxAuthority" button-text="New Tax Authority">
                    <form-single name="CreateTaxAuthorityForm" transition="createTaxAuthority">
                        <field name="taxAuthorityId"><default-field title="ID"><text-line size="20"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="taxAuthorityTypeEnumId"><default-field title="Type">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="TaxAuthorityType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="countryGeoId"><default-field title="Country">
                            <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                                <entity-find entity-name="moqui.basic.Geo">
                                    <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                                    <order-by field-name="geoName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="regionGeoId"><default-field title="Region">
                            <drop-down allow-empty="true"><entity-options key="${geoId}" text="${geoName}">
                                <entity-find entity-name="moqui.basic.Geo">
                                    <econdition field-name="geoTypeEnumId" operator="in" value="GEOT_STATE,GEOT_PROVINCE,GEOT_TERRITORY"/>
                                    <order-by field-name="geoName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="parentTaxAuthorityId"><default-field title="Parent Authority">
                            <drop-down allow-empty="true"><entity-options key="${taxAuthorityId}" text="${description}">
                                <entity-find entity-name="zenith.erp.tax.TaxAuthority">
                                    <econdition field-name="isActive" value="Y"/>
                                    <order-by field-name="description"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Create"><submit icon="fa fa-plus-circle"/></default-field></field>
                    </form-single>
                </container-dialog>
                </container>
                </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-txntable z-listchrome">
            <!-- z-listchrome.js reads this placeholder marker (Moqui <container> can't carry a data- attr). -->
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search tax authorities..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TaxAuthoritiesForm" list="taxAuthorities" list-entry="ta" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true">
                <row-actions><script><![CDATA[
                    // Per-row: form-list conditional-field CONDITIONS can't see screen/row-actions vars, but
                    // ${..} interpolation in a default-field CAN — so compute everything here and interpolate.
                    def typeDesc = (typeDescMap[ta.taxAuthorityTypeEnumId] ?: '').toString()
                    hasType = (typeDesc != '')
                    typeLabel = hasType ? typeDesc : '-'
                    def _t = typeDesc.toLowerCase()
                    typeBadge = !hasType ? 'grey' : ((_t.contains('state') || _t.contains('province')) ? 'success' : 'info')
                    activeClass = (ta.isActive == 'Y') ? 'z-rotoggle on' : 'z-rotoggle'
                ]]></script></row-actions>
                <field name="taxAuthorityId"><header-field title="ID" show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="ID">
                        <link url="editTaxAuthority" text="${ta.taxAuthorityId}" parameter-map="[taxAuthorityId:ta.taxAuthorityId]" style="z-vlink"/>
                    </default-field></field>
                <field name="description"><header-field show-order-by="true"><text-find size="25"/></header-field>
                    <default-field title="Description"><label text="${ta.description ?: '-'}" type="span" style="text-dark"/></default-field></field>
                <field name="taxAuthorityTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="TaxAuthorityType"/>
                            <order-by field-name="sequenceNum"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type"><label text="${typeLabel}" type="span" style="zenith-badge nd ${typeBadge}"/></default-field></field>
                <!-- Rate / Rate Type / From / Thru are not attributes of a tax AUTHORITY (they live on its rates);
                     shown as muted placeholders to match the mockup's column layout. -->
                <field name="rateCol"><default-field title="Rate"><label text="-" type="span" style="text-grey-6"/></default-field></field>
                <field name="rateTypeCol"><default-field title="Rate Type"><label text="-" type="span" style="text-grey-6"/></default-field></field>
                <field name="fromCol"><default-field title="From"><label text="-" type="span" style="text-grey-6"/></default-field></field>
                <field name="thruCol"><default-field title="Thru"><label text="-" type="span" style="text-grey-6"/></default-field></field>
                <field name="isActive"><header-field title="Active" show-order-by="true"/>
                    <!-- Read-only visual toggle (mirrors isActive). Active-state is changed via Edit, super-admin
                         only — this is NOT an interactive write path on global master data. -->
                    <default-field title="Active"><label text="&#9679;" type="span" style="${activeClass}"/></default-field></field>
                <field name="rowMenu"><default-field title="">
                    <link url="editTaxAuthority" text="⋮" parameter-map="[taxAuthorityId:ta.taxAuthorityId]" style="z-kebab"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
