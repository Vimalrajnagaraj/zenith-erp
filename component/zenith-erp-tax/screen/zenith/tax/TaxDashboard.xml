<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <transition name="findTaxAuthority"><default-response url="../FindTaxAuthority"/></transition>
    <transition name="findTaxRate"><default-response url="../FindTaxRate"/></transition>
    <transition name="findTaxExemption"><default-response url="../FindTaxExemption"/></transition>
    <transition name="findTaxRegistration"><default-response url="../FindTaxRegistration"/></transition>

    <actions>
        <entity-find-count entity-name="zenith.erp.tax.TaxAuthority" count-field="totalAuthorities">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <!-- Real tax rates for India tenants live in the GST slab table -->
        <set field="totalRates" from="0"/>
        <script>try { totalRates = ec.entity.find("zenith.erp.india.IndiaGstSlab").condition("isActive","Y").count() as int } catch (Exception e) { try { totalRates = ec.entity.find("zenith.erp.tax.TaxRate").condition("isActive","Y").count() as int } catch (Exception e2) {} }</script>

        <entity-find-count entity-name="zenith.erp.tax.TaxCategory" count-field="totalCategories"/>

        <entity-find-count entity-name="zenith.erp.tax.TaxExemption" count-field="totalExemptions">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <entity-find-count entity-name="zenith.erp.tax.TaxRegistration" count-field="totalRegistrations">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <!-- Recent tax lines scoped to THIS tenant's transactions (PosTransaction is org-filtered) -->
        <script><![CDATA[
            def raw = ec.entity.find("zenith.erp.tax.TaxLineDetail").orderBy("-taxLineDetailId").limit(60).list()
            def refIds = raw.collect { it.referenceId }.findAll { it }.unique()
            def orgSet = [] as Set
            if (refIds) orgSet = (ec.entity.find("zenith.erp.pos.PosTransaction").condition("transactionId","in",refIds).selectField("transactionId").list()*.transactionId) as Set
            recentTaxLines = raw.findAll { orgSet.contains(it.referenceId) }.take(10)
        ]]></script>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Tax Overview" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage tax authorities, rates, exemptions, and registrations across your organization." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <!-- Metrics Row -->
        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Tax Authorities" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalAuthorities}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="account_balance" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Tax Rates" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalRates}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="percent" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Tax Categories" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalCategories}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-orange-1 border-radius-md text-orange-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="category" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Exemptions" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalExemptions}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-red-1 border-radius-md text-red-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="block" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Registrations" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalRegistrations}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-purple-1 border-radius-md text-purple-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="how_to_reg" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Recent Tax Line Details -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <container style="row items-center justify-between q-mb-md">
                <label text="Recent Tax Line Details" type="h5" style="text-weight-bold q-my-none"/>
            </container>
            <form-list name="RecentTaxLines" list="recentTaxLines" skip-form="true">
                <field name="taxLineDetailId"><default-field title="ID">
                    <display/></default-field></field>
                <field name="referenceType"><default-field title="Ref Type">
                    <display/></default-field></field>
                <field name="referenceId"><default-field title="Ref ID">
                    <display/></default-field></field>
                <field name="taxName"><default-field title="Tax">
                    <display/></default-field></field>
                <field name="taxRate"><default-field title="Rate">
                    <display format="#0.##"/></default-field></field>
                <field name="taxableAmount"><default-field title="Taxable Amount">
                    <display format="₹#,##0.00"/></default-field></field>
                <field name="taxAmount"><default-field title="Tax Amount">
                    <display format="₹#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Currency">
                    <display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
