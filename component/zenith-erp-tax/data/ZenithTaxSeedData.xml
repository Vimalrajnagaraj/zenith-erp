<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <!-- Tax module multi-tenant isolation: tenant-specific tax data scoped to active organization -->
    <moqui.security.EntityFilter entityFilterId="ZTF_TAXEXEMPT" entityFilterSetId="MANTLE_ACTIVE_ORG"
        entityName="zenith.erp.tax.TaxExemption" filterMap="[organizationPartyId: ec.user.getPreference('ACTIVE_ORGANIZATION') ?: null]"/>
    <moqui.security.EntityFilter entityFilterId="ZTF_TAXREG" entityFilterSetId="MANTLE_ACTIVE_ORG"
        entityName="zenith.erp.tax.TaxRegistration" filterMap="[organizationPartyId: ec.user.getPreference('ACTIVE_ORGANIZATION') ?: null]"/>
    <moqui.security.EntityFilter entityFilterId="ZTF_TAXENGINE" entityFilterSetId="MANTLE_ACTIVE_ORG"
        entityName="zenith.erp.tax.TaxEngineConfig" filterMap="[tenantId: ec.user.getPreference('ACTIVE_ORGANIZATION') ?: null]"/>
</entity-facade-xml>
