<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ================================================================== -->
    <!-- Pluggable Tax Engine — Country-agnostic tax infrastructure         -->
    <!-- Country plugins (India, US, UK, UAE) implement tax calculation     -->
    <!-- and store results generically via TaxLineDetail.                   -->
    <!-- ================================================================== -->

    <!-- ========== TAX AUTHORITY ========== -->
    <entity entity-name="TaxAuthority" package="zenith.erp.tax" table-name="ZENITH_TAX_AUTHORITY" short-alias="TaxAuthority">
        <field name="taxAuthorityId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="taxAuthorityTypeEnumId" type="id"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="parentTaxAuthorityId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" title="TaxAuthorityType" related="moqui.basic.Enumeration">
            <key-map field-name="taxAuthorityTypeEnumId" related="enumId"/>
        </relationship>
        <relationship type="one" title="Country" related="moqui.basic.Geo">
            <key-map field-name="countryGeoId" related="geoId"/>
        </relationship>
        <relationship type="one" title="Region" related="moqui.basic.Geo">
            <key-map field-name="regionGeoId" related="geoId"/>
        </relationship>
        <relationship type="one" title="Parent" related="zenith.erp.tax.TaxAuthority">
            <key-map field-name="parentTaxAuthorityId" related="taxAuthorityId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TaxAuthorityType" description="Tax Authority Type"/>
            <moqui.basic.Enumeration enumId="TatNational" enumTypeId="TaxAuthorityType" description="National/Federal" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TatState" enumTypeId="TaxAuthorityType" description="State/Province" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TatCounty" enumTypeId="TaxAuthorityType" description="County/District" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TatCity" enumTypeId="TaxAuthorityType" description="City/Municipal" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="TatSpecial" enumTypeId="TaxAuthorityType" description="Special Tax Zone" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== TAX CATEGORY ========== -->
    <entity entity-name="TaxCategory" package="zenith.erp.tax" short-alias="TaxCategory">
        <field name="taxCategoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="countryGeoId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" title="Country" related="moqui.basic.Geo">
            <key-map field-name="countryGeoId" related="geoId"/>
        </relationship>
    </entity>

    <!-- ========== TAX RATE ========== -->
    <entity entity-name="TaxRate" package="zenith.erp.tax" short-alias="TaxRate">
        <field name="taxRateId" type="id" is-pk="true"/>
        <field name="taxAuthorityId" type="id"/>
        <field name="taxCategoryId" type="id"/>
        <field name="taxName" type="text-medium"/>
        <field name="taxTypeEnumId" type="id"/>
        <field name="rate" type="number-decimal"/>
        <field name="rateTypeEnumId" type="id"/>
        <field name="effectiveFrom" type="date"/>
        <field name="effectiveThru" type="date"/>
        <field name="minTaxableAmount" type="currency-precise"/>
        <field name="maxTaxableAmount" type="currency-precise"/>
        <field name="isCompound" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="zenith.erp.tax.TaxAuthority"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxCategory"/>
        <relationship type="one" title="TaxType" related="moqui.basic.Enumeration">
            <key-map field-name="taxTypeEnumId" related="enumId"/>
        </relationship>
        <relationship type="one" title="RateType" related="moqui.basic.Enumeration">
            <key-map field-name="rateTypeEnumId" related="enumId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TaxType" description="Tax Type"/>
            <moqui.basic.Enumeration enumId="TtVat" enumTypeId="TaxType" description="Value Added Tax (VAT)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TtSalesTax" enumTypeId="TaxType" description="Sales Tax" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TtGst" enumTypeId="TaxType" description="Goods and Services Tax (GST)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TtExcise" enumTypeId="TaxType" description="Excise Duty" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="TtCustoms" enumTypeId="TaxType" description="Customs Duty" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="TtWithholding" enumTypeId="TaxType" description="Withholding Tax" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="TtCess" enumTypeId="TaxType" description="Cess/Surcharge" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="TtServiceTax" enumTypeId="TaxType" description="Service Tax" sequenceNum="8"/>

            <moqui.basic.EnumerationType enumTypeId="TaxRateType" description="Tax Rate Type"/>
            <moqui.basic.Enumeration enumId="TrtPercentage" enumTypeId="TaxRateType" description="Percentage" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TrtFixed" enumTypeId="TaxRateType" description="Fixed Amount" sequenceNum="2"/>
        </seed-data>
    </entity>

    <!-- ========== TAX RULE ========== -->
    <entity entity-name="TaxRule" package="zenith.erp.tax" short-alias="TaxRule">
        <field name="taxRuleId" type="id" is-pk="true"/>
        <field name="taxAuthorityId" type="id"/>
        <field name="taxRateId" type="id"/>
        <field name="taxCategoryId" type="id"/>
        <field name="ruleName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="priority" type="number-integer" default="10"/>
        <field name="countryGeoId" type="id"/>
        <field name="conditionsJson" type="text-very-long">
            <description>JSON conditions: productCategory, customerType, originRegion, destinationRegion,
                transactionType, dateRange, etc. Interpreted by country-specific tax services.</description>
        </field>
        <field name="resultAction" type="text-short">
            <description>APPLY_RATE, EXEMPT, ZERO_RATE, REVERSE_CHARGE, USE_SERVICE</description>
        </field>
        <field name="customServiceName" type="text-medium">
            <description>For USE_SERVICE action: fully-qualified service name to call</description>
        </field>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="effectiveFrom" type="date"/>
        <field name="effectiveThru" type="date"/>
        <relationship type="one" related="zenith.erp.tax.TaxAuthority"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxRate"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxCategory"/>
    </entity>

    <!-- ========== TAX LINE DETAIL — THE KEY ABSTRACTION ========== -->
    <entity entity-name="TaxLineDetail" package="zenith.erp.tax" short-alias="TaxLineDetail">
        <field name="taxLineDetailId" type="id" is-pk="true"/>
        <field name="referenceType" type="text-short">
            <description>Entity type: OrderItem, InvoiceItem, PosTransactionItem</description>
        </field>
        <field name="referenceId" type="id">
            <description>Primary key of the parent record (orderId, invoiceId, posTransactionId)</description>
        </field>
        <field name="referenceSeqId" type="id">
            <description>Sequence key for composite PKs (orderItemSeqId, invoiceItemSeqId, itemSeqId)</description>
        </field>
        <field name="parentReferenceType" type="text-short">
            <description>Document type: Invoice, OrderHeader, PosTransaction — for document-level queries</description>
        </field>
        <field name="parentReferenceId" type="id"/>
        <field name="taxAuthorityId" type="id"/>
        <field name="taxRateId" type="id"/>
        <field name="taxCategoryId" type="id"/>
        <field name="taxName" type="text-medium">
            <description>Display name: "CGST@9%", "CA State Tax@7.25%", "VAT@20%"</description>
        </field>
        <field name="taxRate" type="number-decimal"/>
        <field name="taxableAmount" type="currency-precise"/>
        <field name="taxAmount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="isIncludedInPrice" type="text-indicator" default="'N'"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="sequenceNum" type="number-integer" default="1"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxAuthority"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxRate"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxCategory"/>
        <index name="IDX_TAXLINE_REF">
            <index-field name="referenceType"/>
            <index-field name="referenceId"/>
            <index-field name="referenceSeqId"/>
        </index>
        <index name="IDX_TLD_PARENT">
            <index-field name="parentReferenceType"/>
            <index-field name="parentReferenceId"/>
        </index>
    </entity>

    <!-- ========== TAX EXEMPTION ========== -->
    <entity entity-name="TaxExemption" package="zenith.erp.tax" short-alias="TaxExemption">
        <field name="exemptionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="taxAuthorityId" type="id"/>
        <field name="exemptionTypeEnumId" type="id"/>
        <field name="exemptionNumber" type="text-short"/>
        <field name="effectiveFrom" type="date"/>
        <field name="effectiveThru" type="date"/>
        <field name="description" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one-nofk" related="mantle.party.Party"/>
        <relationship type="one-nofk" related="mantle.product.Product"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxAuthority"/>
        <relationship type="one" title="TaxExemptionType" related="moqui.basic.Enumeration">
            <key-map field-name="exemptionTypeEnumId" related="enumId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TaxExemptionType" description="Tax Exemption Type"/>
            <moqui.basic.Enumeration enumId="TexFull" enumTypeId="TaxExemptionType" description="Fully Exempt" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TexPartial" enumTypeId="TaxExemptionType" description="Partially Exempt" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TexZeroRated" enumTypeId="TaxExemptionType" description="Zero-Rated" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TexReverseCharge" enumTypeId="TaxExemptionType" description="Reverse Charge" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="TexGovernment" enumTypeId="TaxExemptionType" description="Government Entity" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="TexNonProfit" enumTypeId="TaxExemptionType" description="Non-Profit Organization" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="TexExport" enumTypeId="TaxExemptionType" description="Export" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="TexReseller" enumTypeId="TaxExemptionType" description="Reseller/Wholesale" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="TexSez" enumTypeId="TaxExemptionType" description="Special Economic Zone" sequenceNum="9"/>
        </seed-data>
    </entity>

    <!-- ========== TAX REGISTRATION ========== -->
    <entity entity-name="TaxRegistration" package="zenith.erp.tax" short-alias="TaxRegistration">
        <field name="registrationId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="taxAuthorityId" type="id"/>
        <field name="registrationTypeEnumId" type="id"/>
        <field name="registrationNumber" type="text-short"/>
        <field name="isDefault" type="text-indicator" default="'Y'"/>
        <field name="isPrimary" type="text-indicator" default="'N'"/>
        <field name="countryGeoId" type="id"/>
        <field name="regionGeoId" type="id"/>
        <field name="issuingAuthority" type="text-medium"/>
        <field name="effectiveFrom" type="date"/>
        <field name="effectiveThru" type="date"/>
        <field name="verificationStatus" type="text-short"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxAuthority"/>
        <relationship type="one" title="RegistrationType" related="moqui.basic.Enumeration">
            <key-map field-name="registrationTypeEnumId" related="enumId"/>
        </relationship>
        <index name="IDX_TAXREG_NUM" unique="true">
            <index-field name="registrationNumber"/>
            <index-field name="registrationTypeEnumId"/>
        </index>
        <index name="IDX_TAXREG_PARTY">
            <index-field name="partyId"/>
        </index>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TaxRegistrationType" description="Tax Registration Type"/>
            <moqui.basic.Enumeration enumId="TrtGstin" enumTypeId="TaxRegistrationType" description="GSTIN (India)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TrtPan" enumTypeId="TaxRegistrationType" description="PAN (India)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TrtTan" enumTypeId="TaxRegistrationType" description="TAN (India)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TrtCin" enumTypeId="TaxRegistrationType" description="CIN (India)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="TrtVatReg" enumTypeId="TaxRegistrationType" description="VAT Registration" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="TrtEin" enumTypeId="TaxRegistrationType" description="EIN (US)" sequenceNum="20"/>
            <moqui.basic.Enumeration enumId="TrtSalesTax" enumTypeId="TaxRegistrationType" description="Sales Tax Permit (US)" sequenceNum="21"/>
            <moqui.basic.Enumeration enumId="TrtTrn" enumTypeId="TaxRegistrationType" description="TRN (UAE)" sequenceNum="30"/>
            <moqui.basic.Enumeration enumId="TrtAbn" enumTypeId="TaxRegistrationType" description="ABN (Australia)" sequenceNum="40"/>
        </seed-data>
    </entity>

    <!-- ========== TAX SUMMARY VIEW ========== -->
    <view-entity entity-name="TaxLineSummaryView" package="zenith.erp.tax">
        <member-entity entity-alias="TLD" entity-name="zenith.erp.tax.TaxLineDetail"/>
        <alias entity-alias="TLD" name="referenceType"/>
        <alias entity-alias="TLD" name="referenceId"/>
        <alias entity-alias="TLD" name="taxName"/>
        <alias entity-alias="TLD" name="taxRate"/>
        <alias entity-alias="TLD" name="currencyUomId"/>
        <alias entity-alias="TLD" name="taxAuthorityId"/>
        <alias entity-alias="TLD" name="totalTaxableAmount" field="taxableAmount" function="sum"/>
        <alias entity-alias="TLD" name="totalTaxAmount" field="taxAmount" function="sum"/>
        <alias entity-alias="TLD" name="lineCount" field="taxLineDetailId" function="count"/>
    </view-entity>

    <!-- ========== PARTY TAX REGISTRATION VIEW ========== -->
    <view-entity entity-name="PartyTaxRegistrationView" package="zenith.erp.tax">
        <member-entity entity-alias="TR" entity-name="zenith.erp.tax.TaxRegistration"/>
        <member-entity entity-alias="TA" entity-name="zenith.erp.tax.TaxAuthority" join-from-alias="TR">
            <key-map field-name="taxAuthorityId"/>
        </member-entity>
        <alias entity-alias="TR" name="registrationId"/>
        <alias entity-alias="TR" name="partyId"/>
        <alias entity-alias="TR" name="registrationNumber"/>
        <alias entity-alias="TR" name="registrationTypeEnumId"/>
        <alias entity-alias="TR" name="isDefault"/>
        <alias entity-alias="TR" name="isPrimary"/>
        <alias entity-alias="TR" name="countryGeoId" field="countryGeoId"/>
        <alias entity-alias="TR" name="regionGeoId"/>
        <alias entity-alias="TR" name="isActive"/>
        <alias entity-alias="TA" name="taxAuthorityId"/>
        <alias entity-alias="TA" name="taxAuthorityCountryGeoId" field="countryGeoId"/>
        <alias entity-alias="TA" name="taxAuthorityDescription" field="description"/>
    </view-entity>

    <!-- ========== PRODUCT — Generic Tax Fields Extension ========== -->
    <extend-entity entity-name="Product" package="mantle.product">
        <field name="productTaxCode" type="text-short">
            <description>Generic tax classification code (HSN, UPC tax class, VAT code)</description>
        </field>
        <field name="taxCategoryId" type="id"/>
        <relationship type="one-nofk" related="zenith.erp.tax.TaxCategory">
            <key-map field-name="taxCategoryId"/>
        </relationship>
    </extend-entity>

    <!-- ========== FACILITY — Generic Tax Fields Extension ========== -->
    <extend-entity entity-name="Facility" package="mantle.facility">
        <field name="taxRegistrationNumber" type="text-short"/>
        <field name="taxRegionGeoId" type="id"/>
        <field name="taxCountryGeoId" type="id"/>
    </extend-entity>
    <!-- ========== GLOBAL COMPLIANCE & LOCALIZATION ========== -->
    <entity entity-name="TaxEngineConfig" package="zenith.erp.tax">
        <field name="configId" type="id" is-pk="true"/>
        <field name="tenantId" type="id"/> <!-- Tenant isolation -->
        <field name="providerEnumId" type="id"/> <!-- Avalara, TaxJar, StripeTax -->
        <field name="apiKey" type="text-long"/>
        <field name="apiSecret" type="text-long"/>
        <field name="apiEndpoint" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="TaxProvider" description="Global Tax Provider"/>
            <moqui.basic.Enumeration enumId="TpAvalara" enumTypeId="TaxProvider" description="Avalara AvaTax" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TpTaxJar" enumTypeId="TaxProvider" description="TaxJar" sequenceNum="2"/>
        </seed-data>
    </entity>

    <entity entity-name="TenantEInvoiceConfig" package="zenith.erp.tax">
        <field name="configId" type="id" is-pk="true"/>
        <field name="tenantId" type="id"/>
        <field name="countryGeoId" type="id"/> <!-- e.g., DEU, FRA, IND -->
        <field name="eInvoiceStandardEnumId" type="id"/> <!-- PEPPOL_UBL, FACTURAE, GST_JSON -->
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="EInvoiceStandard" description="E-Invoicing Standard"/>
            <moqui.basic.Enumeration enumId="EisPeppolUbl" enumTypeId="EInvoiceStandard" description="PEPPOL UBL 2.1 (Europe)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="EisFacturae" enumTypeId="EInvoiceStandard" description="Facturae (Spain/LATAM)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="EisGstJson" enumTypeId="EInvoiceStandard" description="GST e-Invoice JSON (India)" sequenceNum="3"/>
        </seed-data>
    </entity>

</entities>
