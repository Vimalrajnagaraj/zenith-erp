# =============================================================================
# ZenithERP Production Environment Configuration
# Copy this file to .env and fill in all values before deploying
# =============================================================================

# ---------- Database ----------
DB_NAME=zenith_saas
DB_USER=zenith
DB_PASSWORD=replace-with-a-strong-db-password

# ---------- Application ----------
CRYPT_PASS=replace-with-a-32char-random-string
JAVA_XMS=512m                   # JVM minimum heap
JAVA_XMX=2g                    # JVM maximum heap (increase for >50 tenants)

# ---------- Domain ----------
DOMAIN=erp.example.com
ADMIN_EMAIL=admin@example.com

# ---------- Razorpay (Payment Gateway) ----------
# Set these via Settings > SaaS Admin > Settings in the UI, or seed in CompanySettings
# RAZORPAY_KEY_ID=rzp_live_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# RAZORPAY_WEBHOOK_SECRET=xxxx

# ---------- Email (SMTP for renewal reminders) ----------
# Set these via Settings > SaaS Admin > Settings in the UI, or seed in CompanySettings
# SAAS_SMTP_HOST=smtp.gmail.com
# SAAS_SMTP_PORT=587
# SAAS_SMTP_USER=noreply@zenitherp.com
# SAAS_SMTP_PASSWORD=xxxx
# SAAS_FROM_EMAIL=noreply@zenitherp.com
# SAAS_FROM_NAME=ZenithERP

# ---------- Backup ----------
BACKUP_RETAIN_DAYS=30           # Number of days to keep backups
