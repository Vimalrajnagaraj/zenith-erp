<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="check" noun="ModuleAccess">
        <description>Check if current tenant's plan grants access to a module. Returns allowed=true/false.</description>
        <in-parameters>
            <parameter name="moduleId" required="true"><description>Module key: pos, sales, purchase, accounting, crm, hr, etc.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="allowed" type="Boolean"/>
            <parameter name="planName"/>
            <parameter name="upgradeRequired" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="allowed" from="true"/>
            <set field="upgradeRequired" from="false"/>

            <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!orgId"><return/></if>

            <!-- Find tenant for this org -->
            <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenants" limit="1">
                <econdition field-name="organizationPartyId" from="orgId"/>
            </entity-find>
            <if condition="!tenants"><return/></if>

            <set field="tenant" from="tenants[0]"/>
            <set field="planId" from="tenant.planId"/>

            <entity-find-one entity-name="zenith.erp.saas.SaasPlan" value-field="plan">
                <field-map field-name="planId"/>
            </entity-find-one>
            <set field="planName" from="plan?.planName ?: ''"/>

            <!-- Check if plan includes "ALL" modules -->
            <entity-find-count entity-name="zenith.erp.saas.SaasPlanModule" count-field="allCount">
                <econdition field-name="planId"/>
                <econdition field-name="moduleId" value="ALL"/>
            </entity-find-count>
            <if condition="allCount > 0"><return/></if>

            <!-- Check specific module -->
            <entity-find-count entity-name="zenith.erp.saas.SaasPlanModule" count-field="modCount">
                <econdition field-name="planId"/>
                <econdition field-name="moduleId"/>
            </entity-find-count>
            <if condition="modCount == 0">
                <set field="allowed" from="false"/>
                <set field="upgradeRequired" from="true"/>
            </if>
        </actions>
    </service>

    <service verb="get" noun="TenantForOrg">
        <description>Get SaasTenant record for the current ACTIVE_ORGANIZATION</description>
        <out-parameters>
            <parameter name="tenant" type="Map"/>
            <parameter name="plan" type="Map"/>
            <parameter name="subscription" type="Map"/>
            <parameter name="isSaasManaged" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="isSaasManaged" from="false"/>
            <set field="orgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!orgId"><return/></if>

            <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenants" limit="1">
                <econdition field-name="organizationPartyId" from="orgId"/>
            </entity-find>
            <if condition="!tenants"><return/></if>

            <set field="tenant" from="tenants[0]"/>
            <set field="isSaasManaged" from="true"/>

            <entity-find-one entity-name="zenith.erp.saas.SaasPlan" value-field="plan">
                <field-map field-name="planId" from="tenant.planId"/>
            </entity-find-one>

            <entity-find entity-name="zenith.erp.saas.SaasSubscription" list="subs" limit="1">
                <econdition field-name="tenantId" from="tenant.tenantId"/>
                <econdition field-name="statusId" operator="in" value="SubActive,SubTrial"/>
                <order-by field-name="-startDate"/>
            </entity-find>
            <set field="subscription" from="subs ? subs[0] : null"/>
        </actions>
    </service>

</services>
