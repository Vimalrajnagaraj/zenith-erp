<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="create" noun="Workspace" authenticate="true" transaction="force-new" transaction-timeout="600" no-tx-cache="true">
        <description>Platform-admin preview/apply of a catalog-only migration into a NEW workspace. Never clears or adopts an existing organization.</description>
        <in-parameters>
            <parameter name="bundleJson" required="true" allow-html="any"/>
            <parameter name="apply" type="Boolean" default-value="false"/>
            <parameter name="confirmationDigest"/>
            <parameter name="adminPassword"/>
            <parameter name="cashierOnePassword"/>
            <parameter name="cashierTwoPassword"/>
        </in-parameters>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            ec.resource.script('component://zenith-erp-saas/script/zenith/saas/CleanWorkspace.groovy', null)
        ]]></script></actions>
    </service>
</services>
