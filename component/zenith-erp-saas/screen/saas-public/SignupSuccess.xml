<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">

    <widgets>
        <container style="text-center" style-sm="max-width:600px;margin:60px auto;padding:0 20px">
            <container style="bg-white shadow-2 border-radius-lg q-pa-xl">
                <render-mode><text type="html"><![CDATA[<q-icon name="check_circle" class="text-positive"/>]]></text></render-mode>
                <label text="Account Created Successfully!" type="h4" style="text-weight-bold q-mt-md"/>
                <label text="Your ZetaERP account is ready." type="p" style="text-grey-7 q-mt-sm text-body1"/>

                <container style="bg-blue-1 border-radius-md q-pa-lg q-mt-lg text-left">
                    <label text="Your Login Details" type="h6" style="text-weight-bold q-mb-md"/>
                    <container style="q-mb-sm">
                        <label text="Organization ID: " style="text-grey-7"/>
                        <label text="${orgCode ?: ''}" style="text-weight-bold text-primary text-h6" id="org-code-display"/>
                    </container>
                    <container style="q-mb-sm">
                        <label text="Username: " style="text-grey-7"/>
                        <label text="${adminEmail ?: ''}" style="text-weight-bold"/>
                    </container>
                    <container style="q-mb-sm">
                        <label text="Subdomain: " style="text-grey-7"/>
                        <label text="${subdomain ?: ''}.zetaclantech.com" style="text-weight-bold"/>
                    </container>
                </container>

                <container style="bg-amber-1 border-radius-md q-pa-md q-mt-md">
                    <render-mode><text type="html"><![CDATA[<q-icon name="info" class="text-warning q-mr-sm"/>]]></text></render-mode>
                    <label text="Please save your Organization ID — you'll need it every time you log in." style="text-weight-bold text-body2"/>
                </container>

                <container style="q-mt-lg">
                    <link url="/Login" text="Go to Login" btn-type="primary" icon="fa fa-sign-in"/>
                </container>
            </container>
        </container>
    </widgets>
</screen>
