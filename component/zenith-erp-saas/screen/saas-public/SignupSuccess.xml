<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">

    <!-- ZE-ONB-002: after an email/password signup the account is created UNVERIFIED and cannot log in until
         the emailed link is clicked. verify=1 -> show the "verify your email" state (with a resend). -->
    <actions>
        <set field="needVerify" from="verify == '1'"/>
        <set field="pendingEmail" from="ec.web.session.getAttribute('pendingVerifyEmail')"/>
        <set field="verifyMsg" from="'We have sent a verification link' + (pendingEmail ? (' to ' + pendingEmail) : '') + '. Click it to activate your ZetaERP account, then sign in.'"/>
    </actions>

    <widgets>
        <container style="text-center" style-sm="max-width:600px;margin:60px auto;padding:0 20px">
            <container style="bg-white shadow-2 border-radius-lg q-pa-xl">

                <section name="VerifyPendingSection">
                    <condition><expression>needVerify</expression></condition>
                    <widgets>
                        <render-mode><text type="html"><![CDATA[<q-icon name="mark_email_unread" class="text-primary" style="font-size:56px"/>]]></text></render-mode>
                        <label text="Verify your email to activate your account" type="h4" style="text-weight-bold q-mt-md"/>
                        <label text="${verifyMsg}" type="p" style="text-grey-7 q-mt-sm text-body1"/>
                        <container style="bg-amber-1 border-radius-md q-pa-md q-mt-md">
                            <render-mode><text type="html"><![CDATA[<q-icon name="info" class="text-warning q-mr-sm"/>]]></text></render-mode>
                            <label text="Didn't get it? Check your spam folder, then resend the link." style="text-weight-bold text-body2"/>
                        </container>
                        <container style="q-mt-lg">
                            <link url="/Login/resendVerification" text="Resend verification email" btn-type="secondary" icon="fa fa-envelope"/>
                            <link url="/Login" text="Go to Login" btn-type="primary" icon="fa fa-sign-in"/>
                        </container>
                    </widgets>
                </section>

                <section name="PlainSuccessSection">
                    <condition><expression>!needVerify</expression></condition>
                    <widgets>
                        <render-mode><text type="html"><![CDATA[<q-icon name="check_circle" class="text-positive"/>]]></text></render-mode>
                        <label text="Account Created Successfully!" type="h4" style="text-weight-bold q-mt-md"/>
                        <label text="Your ZetaERP account is ready." type="p" style="text-grey-7 q-mt-sm text-body1"/>

                        <container style="bg-blue-1 border-radius-md q-pa-lg q-mt-lg text-left">
                            <label text="Your Login Details" type="h6" style="text-weight-bold q-mb-md"/>
                            <container style="q-mb-sm">
                                <label text="Organization ID: " style="text-grey-7"/>
                                <label text="${orgCode ?: ''}" style="text-weight-bold text-primary text-h6" id="org-code-display"/>
                            </container>
                            <container style="q-mb-sm">
                                <label text="Username: " style="text-grey-7"/>
                                <label text="${adminEmail ?: ''}" style="text-weight-bold"/>
                            </container>
                            <container style="q-mb-sm">
                                <label text="Subdomain: " style="text-grey-7"/>
                                <label text="${subdomain ?: ''}.zetaclantech.com" style="text-weight-bold"/>
                            </container>
                        </container>

                        <container style="bg-amber-1 border-radius-md q-pa-md q-mt-md">
                            <render-mode><text type="html"><![CDATA[<q-icon name="info" class="text-warning q-mr-sm"/>]]></text></render-mode>
                            <label text="Please save your Organization ID — you'll need it every time you log in." style="text-weight-bold text-body2"/>
                        </container>

                        <container style="q-mt-lg">
                            <link url="/Login" text="Go to Login" btn-type="primary" icon="fa fa-sign-in"/>
                        </container>
                    </widgets>
                </section>

            </container>
        </container>
    </widgets>
</screen>
