<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">

    <transition name="register" require-session-token="true">
        <actions>
            <script><![CDATA[
                def gstinClean = gstin?.trim()?.toUpperCase()
                if (gstinClean && gstinClean.length() != 15) {
                    ec.message.addError("GSTIN must be exactly 15 characters, or leave it blank.")
                    return
                }
                boolean alreadyDisabled = ec.artifactExecution.disableAuthz()
                try {
                    def result = ec.service.sync().name("zenith.saas.SaasServices.provision#Tenant")
                        .parameter("tenantName", tenantName)
                        .parameter("subdomain", subdomain)
                        .parameter("countryGeoId", countryGeoId)
                        .parameter("industryEnumId", industryEnumId)
                        .parameter("adminFirstName", adminFirstName)
                        .parameter("adminLastName", adminLastName)
                        .parameter("adminEmail", adminEmail)
                        .parameter("adminPhone", adminPhone)
                        .parameter("adminPassword", adminPassword)
                        .parameter("planId", planId)
                        .parameter("gstin", gstinClean)
                        .disableAuthz().requireNewTransaction(true).call()
                    if (ec.message.hasError()) {
                        return
                    }
                    context.putAll(result)
                } finally {
                    if (!alreadyDisabled) ec.artifactExecution.enableAuthz()
                }
            ]]></script>
        </actions>
        <default-response url="/signup-success">
            <parameter name="orgCode" from="subdomain?.toUpperCase()"/>
            <parameter name="adminEmail"/>
            <parameter name="subdomain"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="checkSubdomain" read-only="true" require-session-token="false">
        <actions>
            <script>ec.artifactExecution.disableAuthz()</script>
            <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="cnt">
                <econdition field-name="subdomain" from="sub"/>
            </entity-find-count>
            <script>ec.web.sendJsonResponse([available: cnt == 0])</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            boolean alreadyDisabled = ec.artifactExecution.disableAuthz()
            try {
                planList = ec.entity.find("zenith.erp.saas.SaasPlan")
                    .condition("isActive", "Y").orderBy("sortOrder").list()
                countryList = ec.entity.find("zenith.erp.base.CountryConfiguration")
                    .orderBy("countryName").list()
                industryList = ec.entity.find("moqui.basic.Enumeration")
                    .condition("enumTypeId", "TenantIndustry").orderBy("sequenceNum").list()
            } finally {
                if (!alreadyDisabled) ec.artifactExecution.enableAuthz()
            }
        ]]></script>
    </actions>

    <widgets>
        <label text="Create Your ZetaERP Account" type="h4" style="q-mb-none text-weight-bold"/>
        <label text="Start your 14-day free trial. No credit card needed." type="p" style="text-grey-7 q-mt-xs q-mb-lg"/>

        <container style="row q-gutter-lg">
            <!-- Left: Signup Form -->
            <container style="col-7">
                <container style="bg-white shadow-2 border-radius-lg q-pa-xl">
                    <form-single name="SignupForm" transition="register">
                        <field name="hdr1"><default-field title="">
                            <label text="Business Details" type="h6" style="text-weight-bold text-primary"/>
                        </default-field></field>
                        <field name="tenantName"><default-field title="Business Name">
                            <text-line size="40"/>
                        </default-field></field>
                        <field name="subdomain"><default-field title="Subdomain (.zetaclantech.com)">
                            <text-line size="25"/>
                            <label text="This will also be your Organization ID for login (uppercase)." style="text-grey-6 text-caption" type="p"/>
                        </default-field></field>
                        <field name="countryGeoId"><default-field title="Country">
                            <drop-down no-current-selected-key="IND">
                                <list-options list="countryList" key="${countryGeoId}" text="${countryName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="industryEnumId"><default-field title="Industry">
                            <drop-down no-current-selected-key="TiRetailGeneral">
                                <list-options list="industryList" key="${enumId}" text="${description}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="gstin"><default-field title="GSTIN (optional)">
                            <text-line size="20"/>
                            <label text="Your 15-character GST number (India). Sets your state for CGST/SGST vs IGST. Leave blank if not GST-registered." style="text-grey-6 text-caption" type="p"/>
                        </default-field></field>

                        <field name="hdr2"><default-field title="">
                            <label text="Admin Account" type="h6" style="text-weight-bold text-primary q-mt-md"/>
                        </default-field></field>
                        <field name="adminFirstName"><default-field title="First Name">
                            <text-line size="20"/>
                        </default-field></field>
                        <field name="adminLastName"><default-field title="Last Name">
                            <text-line size="20"/>
                        </default-field></field>
                        <field name="adminEmail"><default-field title="Email (this will be your login)">
                            <text-line size="30"/>
                        </default-field></field>
                        <field name="adminPhone"><default-field title="Phone">
                            <text-line size="15"/>
                        </default-field></field>
                        <field name="adminPassword"><default-field title="Password (min 8 characters)">
                            <password size="20"/>
                        </default-field></field>

                        <field name="hdr3"><default-field title="">
                            <label text="Choose Plan" type="h6" style="text-weight-bold text-primary q-mt-md"/>
                        </default-field></field>
                        <field name="planId"><default-field title="Plan">
                            <drop-down no-current-selected-key="STARTER">
                                <list-options list="planList" key="${planId}"
                                    text="${planName} (${maxUsers} users, ${maxPosTerminals} POS)"/>
                            </drop-down>
                        </default-field></field>

                        <field name="submitBtn"><default-field title="">
                            <submit text="Start Free Trial" type="success" icon="fa fa-rocket"/>
                        </default-field></field>
                    </form-single>
                </container>
            </container>

            <!-- Right: Features -->
            <container style="col-5">
                <container style="bg-white shadow-2 border-radius-lg q-pa-xl">
                    <label text="What You Get" type="h5" style="text-weight-bold q-mb-lg"/>

                    <container style="q-mb-lg">
                        <container style="row items-center q-mb-sm">
                            <render-mode><text type="html"><![CDATA[<q-icon name="point_of_sale" class="text-primary q-mr-sm"/>]]></text></render-mode>
                            <label text="POS Billing" style="text-weight-bold"/>
                        </container>
                        <label text="Fast checkout, barcode scanning, split payments, WhatsApp receipts" style="text-grey-7" type="p"/>
                    </container>
                    <container style="q-mb-lg">
                        <container style="row items-center q-mb-sm">
                            <render-mode><text type="html"><![CDATA[<q-icon name="inventory_2" class="text-primary q-mr-sm"/>]]></text></render-mode>
                            <label text="Inventory Management" style="text-weight-bold"/>
                        </container>
                        <label text="Real-time stock, batch tracking, reorder alerts, multi-warehouse" style="text-grey-7" type="p"/>
                    </container>
                    <container style="q-mb-lg">
                        <container style="row items-center q-mb-sm">
                            <render-mode><text type="html"><![CDATA[<q-icon name="receipt_long" class="text-primary q-mr-sm"/>]]></text></render-mode>
                            <label text="Sales &amp; Invoicing" style="text-weight-bold"/>
                        </container>
                        <label text="Quotations, invoices, purchase orders, GST/VAT compliant" style="text-grey-7" type="p"/>
                    </container>
                    <container style="q-mb-lg">
                        <container style="row items-center q-mb-sm">
                            <render-mode><text type="html"><![CDATA[<q-icon name="account_balance" class="text-primary q-mr-sm"/>]]></text></render-mode>
                            <label text="Accounting" style="text-weight-bold"/>
                        </container>
                        <label text="General ledger, bank reconciliation, financial reports" style="text-grey-7" type="p"/>
                    </container>
                    <container style="q-mb-lg">
                        <container style="row items-center q-mb-sm">
                            <render-mode><text type="html"><![CDATA[<q-icon name="people" class="text-primary q-mr-sm"/>]]></text></render-mode>
                            <label text="CRM &amp; Contacts" style="text-weight-bold"/>
                        </container>
                        <label text="Customer management, credit tracking, price lists" style="text-grey-7" type="p"/>
                    </container>

                    <container style="q-pa-md bg-green-1 border-radius-md q-mt-lg">
                        <render-mode><text type="html"><![CDATA[<q-icon name="check_circle" class="text-positive q-mr-sm"/>]]></text></render-mode>
                        <label text="14-day free trial" style="text-weight-bold"/>
                        <label text=" — No credit card required. Cancel anytime." style="text-grey-7"/>
                    </container>
                </container>

                <container style="text-center q-mt-lg">
                    <label text="Already have an account? " style="text-grey-7"/>
                    <link url="/Login" text="Log in" link-type="anchor"/>
                </container>
            </container>
        </container>
    </widgets>
</screen>
