<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" require-authentication="true">

    <transition name="saveSetting">
        <actions>
            <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="existing">
                <field-map field-name="organizationPartyId" value="ZETAERP"/>
                <field-map field-name="settingKey"/>
            </entity-find-one>
            <if condition="existing">
                <service-call name="update#zenith.erp.base.CompanySettings"
                    in-map="[organizationPartyId:'ZETAERP', settingKey:settingKey, settingValue:settingValue]"/>
                <else>
                    <service-call name="create#zenith.erp.base.CompanySettings"
                        in-map="[organizationPartyId:'ZETAERP', settingKey:settingKey, settingValue:settingValue]"/>
                </else>
            </if>
            <message type="success">Setting '${settingKey}' saved.</message>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-SUB-008 (MS-048): set ZETAERP's own GSTIN so SaaS invoices itemize CGST/SGST (intra-state) or IGST
         (inter-state) instead of a flat GST line. State code is derived from the GSTIN (first 2 digits). Stored
         in zenith.erp.india.IndiaGstin (what calculate#SubscriptionTax reads), NOT company_settings. -->
    <transition name="saveGstin">
        <actions>
            <script><![CDATA[
                def _g = (gstin ?: '').toString().trim().toUpperCase()
                if (_g.length() != 15) { ec.message.addError("A GSTIN is 15 characters (e.g. 29ABCDE1234F1Z5). Got ${_g.length()}."); return }
                def _state = _g.substring(0, 2)
                def existing = ec.entity.find("zenith.erp.india.IndiaGstin")
                    .condition("partyId", "ZETAERP").condition("isActive", "Y").disableAuthz().list()
                if (existing) {
                    ec.service.sync().name("update#zenith.erp.india.IndiaGstin")
                        .parameters([gstinId: existing[0].gstinId, gstin: _g, stateCode: _state, isActive: 'Y']).disableAuthz().call()
                } else {
                    ec.service.sync().name("create#zenith.erp.india.IndiaGstin")
                        .parameters([partyId: 'ZETAERP', gstin: _g, stateCode: _state, isActive: 'Y',
                                     gstRegistrationType: 'Regular']).disableAuthz().call()
                }
                ec.message.addMessage("ZETAERP GSTIN saved: ${_g} (state ${_state}). New SaaS invoices will itemize CGST/SGST or IGST by the tenant's state.")
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            def settingKeys = [
                'RAZORPAY_KEY_ID', 'RAZORPAY_KEY_SECRET', 'RAZORPAY_WEBHOOK_SECRET',
                'SAAS_SMTP_HOST', 'SAAS_SMTP_PORT', 'SAAS_SMTP_USER', 'SAAS_SMTP_PASSWORD',
                'SAAS_FROM_EMAIL', 'SAAS_FROM_NAME',
                'SAAS_OVERDUE_GRACE_DAYS', 'SAAS_TRIAL_REMINDER_DAYS', 'SAAS_RENEWAL_REMINDER_DAYS',
                'GOOGLE_CLIENT_ID'
            ]
            context.settings = [:]
            settingKeys.each { key ->
                def rec = ec.entity.find("zenith.erp.base.CompanySettings")
                    .condition("organizationPartyId", "ZETAERP")
                    .condition("settingKey", key).one()
                context.settings[key] = rec?.settingValue ?: ''
            }
            context.zetaerpGstin = ec.entity.find("zenith.erp.india.IndiaGstin")
                .condition("partyId", "ZETAERP").condition("isActive", "Y").disableAuthz().one()?.gstin ?: ''
        ]]></script>
    </actions>

    <widgets>
        <label text="SaaS Configuration" type="h5" style="text-weight-bold q-mb-lg"/>

        <!-- Payment Gateway -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center q-mb-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="payment" class="text-primary q-mr-sm"/>]]></text></render-mode>
                <label text="Payment Gateway (Razorpay)" type="h6" style="text-weight-bold"/>
            </container>
            <form-single name="RazorpayForm" transition="saveSetting" map="[settingKey:'RAZORPAY_KEY_ID']">
                <field name="settingKey"><default-field><hidden default-value="RAZORPAY_KEY_ID"/></default-field></field>
                <field name="settingValue"><default-field title="Razorpay Key ID">
                    <text-line size="40" default-value="${settings['RAZORPAY_KEY_ID']}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="RazorpaySecretForm" transition="saveSetting" map="[settingKey:'RAZORPAY_KEY_SECRET']">
                <field name="settingKey"><default-field><hidden default-value="RAZORPAY_KEY_SECRET"/></default-field></field>
                <field name="settingValue"><default-field title="Razorpay Key Secret">
                    <text-line size="40" default-value="${settings['RAZORPAY_KEY_SECRET'] ? '••••••••' : ''}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="WebhookSecretForm" transition="saveSetting" map="[settingKey:'RAZORPAY_WEBHOOK_SECRET']">
                <field name="settingKey"><default-field><hidden default-value="RAZORPAY_WEBHOOK_SECRET"/></default-field></field>
                <field name="settingValue"><default-field title="Webhook Secret">
                    <text-line size="40" default-value="${settings['RAZORPAY_WEBHOOK_SECRET'] ? '••••••••' : ''}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <container style="q-mt-md q-pa-md bg-blue-1 border-radius-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="info" class="text-info q-mr-sm"/>]]></text></render-mode>
                <label text="Webhook URL: " style="text-weight-bold"/>
                <label text="https://yourdomain.com/razorpay-webhook" style="text-body2"/>
                <label text="  — Configure this in your Razorpay Dashboard → Webhooks" style="text-grey-6 text-caption" type="p"/>
            </container>
        </container>

        <!-- GST Registration (ZE-SUB-008 / MS-048) -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center q-mb-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="receipt_long" class="text-primary q-mr-sm"/>]]></text></render-mode>
                <label text="GST Registration (ZetaERP)" type="h6" style="text-weight-bold"/>
            </container>
            <label type="p" style="text-grey-7 text-caption q-mb-sm"
                   text="The platform's own GSTIN. Once set, SaaS invoices itemize CGST/SGST (same-state tenant) or IGST (other-state tenant) instead of a flat GST line — the state is taken from the GSTIN's first 2 digits. Until then the total tax is correct at a flat 18%, just not split."/>
            <label text="Current GSTIN: ${zetaerpGstin ?: '— not set —'}" type="p" style="text-weight-bold q-mb-sm"/>
            <form-single name="ZetaGstinForm" transition="saveGstin">
                <field name="gstin"><default-field title="GSTIN (15 characters)">
                    <text-line size="24" default-value="${zetaerpGstin}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save GSTIN"/></default-field></field>
            </form-single>
        </container>

        <!-- Email Settings -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center q-mb-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="email" class="text-primary q-mr-sm"/>]]></text></render-mode>
                <label text="Email Notifications" type="h6" style="text-weight-bold"/>
            </container>
            <form-single name="SmtpHostForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_SMTP_HOST"/></default-field></field>
                <field name="settingValue"><default-field title="SMTP Host">
                    <text-line size="30" default-value="${settings['SAAS_SMTP_HOST']}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="SmtpPortForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_SMTP_PORT"/></default-field></field>
                <field name="settingValue"><default-field title="SMTP Port">
                    <text-line size="6" default-value="${settings['SAAS_SMTP_PORT'] ?: '587'}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="SmtpUserForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_SMTP_USER"/></default-field></field>
                <field name="settingValue"><default-field title="SMTP Username">
                    <text-line size="30" default-value="${settings['SAAS_SMTP_USER']}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="SmtpPasswordForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_SMTP_PASSWORD"/></default-field></field>
                <field name="settingValue"><default-field title="SMTP Password">
                    <text-line size="30" default-value="${settings['SAAS_SMTP_PASSWORD'] ? '••••••••' : ''}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="FromEmailForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_FROM_EMAIL"/></default-field></field>
                <field name="settingValue"><default-field title="From Email">
                    <text-line size="30" default-value="${settings['SAAS_FROM_EMAIL'] ?: 'noreply@zenitherp.com'}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="FromNameForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_FROM_NAME"/></default-field></field>
                <field name="settingValue"><default-field title="From Name">
                    <text-line size="30" default-value="${settings['SAAS_FROM_NAME'] ?: 'ZenithERP'}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
        </container>

        <!-- Lifecycle Configuration -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center q-mb-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="settings" class="text-primary q-mr-sm"/>]]></text></render-mode>
                <label text="Lifecycle Policies" type="h6" style="text-weight-bold"/>
            </container>
            <form-single name="GraceDaysForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_OVERDUE_GRACE_DAYS"/></default-field></field>
                <field name="settingValue"><default-field title="Overdue Grace Period (days)">
                    <text-line size="5" default-value="${settings['SAAS_OVERDUE_GRACE_DAYS'] ?: '7'}"/>
                    <label text="Days after due date before auto-suspend kicks in" style="text-grey-6 text-caption" type="p"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="TrialReminderForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_TRIAL_REMINDER_DAYS"/></default-field></field>
                <field name="settingValue"><default-field title="Trial Expiry Reminder (days before)">
                    <text-line size="5" default-value="${settings['SAAS_TRIAL_REMINDER_DAYS'] ?: '3'}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
            <form-single name="RenewalReminderForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="SAAS_RENEWAL_REMINDER_DAYS"/></default-field></field>
                <field name="settingValue"><default-field title="Renewal Reminder (days before)">
                    <text-line size="5" default-value="${settings['SAAS_RENEWAL_REMINDER_DAYS'] ?: '7'}"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
        </container>

        <!-- Google Sign-In -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center q-mb-md">
                <render-mode><text type="html"><![CDATA[<q-icon name="login" class="text-primary q-mr-sm"/>]]></text></render-mode>
                <label text="Google Sign-In" type="h6" style="text-weight-bold"/>
            </container>
            <form-single name="GoogleClientIdForm" transition="saveSetting">
                <field name="settingKey"><default-field><hidden default-value="GOOGLE_CLIENT_ID"/></default-field></field>
                <field name="settingValue"><default-field title="Google OAuth Client ID">
                    <text-line size="60" default-value="${settings['GOOGLE_CLIENT_ID']}"/>
                    <label text="Web client ID from Google Cloud Console (ends in .apps.googleusercontent.com). Public-safe. No client secret needed." style="text-grey-6 text-caption" type="p"/>
                </default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-single>
        </container>
    </widgets>
</screen>
