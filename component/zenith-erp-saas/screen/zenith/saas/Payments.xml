<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Payments" require-authentication="true">

    <transition name="recordManualPayment">
        <service-call name="create#zenith.erp.saas.SaasPayment"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="paymentList">
            <search-form-inputs default-order-by="-paymentDate"/>
        </entity-find>
        <!-- Totals -->
        <script><![CDATA[
            import java.time.LocalDate
            def now = LocalDate.now()
            def monthStart = java.sql.Date.valueOf(now.withDayOfMonth(1))
        ]]></script>
        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="monthPayments">
            <econdition field-name="paymentDate" operator="greater-equals" from="monthStart"/>
            <econdition field-name="statusId" value="SpSuccess"/>
        </entity-find>
        <set field="monthTotal" from="monthPayments?.sum { it.amount ?: 0 } ?: 0"/>
        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="allSuccessPayments">
            <econdition field-name="statusId" value="SpSuccess"/>
        </entity-find>
        <set field="totalCollected" from="allSuccessPayments?.sum { it.amount ?: 0 } ?: 0"/>
        <entity-find-count entity-name="zenith.erp.saas.SaasPayment" count-field="failedCount">
            <econdition field-name="statusId" value="SpFailed"/>
        </entity-find-count>
        <!-- Tenant lookup -->
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenantsList"/>
        <script>
            tenantNames = [:]
            tenantsList?.each { t -> tenantNames[t.tenantId] = t.tenantName }
        </script>
        <entity-find entity-name="zenith.erp.saas.SaasInvoice" list="unpaidInvoices">
            <econdition field-name="statusId" operator="in" value="SiSent,SiOverdue"/>
            <order-by field-name="tenantId"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="row justify-between items-center q-mb-md">
            <label text="SaaS Payments" type="h5" style="text-weight-bold q-my-none"/>
            <container-dialog id="ManualPaymentDialog" button-text="+ Record Manual Payment" type="success">
                <form-single name="ManualPaymentForm" transition="recordManualPayment">
                    <field name="tenantId"><default-field title="Tenant">
                        <drop-down>
                            <list-options list="tenantsList" key="${tenantId}" text="${tenantName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="saasInvoiceId"><default-field title="Invoice (optional)">
                        <drop-down allow-empty="true">
                            <list-options list="unpaidInvoices" key="${saasInvoiceId}"
                                text="INV-${saasInvoiceId} (${tenantNames?.get(tenantId) ?: tenantId} - ₹${totalAmount})"/>
                        </drop-down>
                    </default-field></field>
                    <field name="paymentDate"><default-field title="Payment Date">
                        <date-time type="date-time"/>
                    </default-field></field>
                    <field name="amount"><default-field title="Amount">
                        <text-line size="10" input-type="number"/>
                    </default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <text-line size="5" default-value="INR"/>
                    </default-field></field>
                    <field name="paymentGateway"><default-field title="Gateway/Method">
                        <drop-down no-current-selected-key="Manual">
                            <option key="Manual" text="Manual / Bank Transfer"/>
                            <option key="Cash" text="Cash"/>
                            <option key="Cheque" text="Cheque"/>
                            <option key="Razorpay" text="Razorpay"/>
                        </drop-down>
                    </default-field></field>
                    <field name="gatewayPaymentId"><default-field title="Reference / Txn ID">
                        <text-line size="30"/>
                    </default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="SpSuccess">
                            <option key="SpSuccess" text="Success"/>
                            <option key="SpPending" text="Pending"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Record Payment"/>
                    </default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- Summary Cards -->
        <container style="row q-gutter-md q-mb-lg">
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="₹${zinr.inr(ec.l10n.format(monthTotal, '#,##0'))}" type="h4" style="text-weight-bold text-positive"/>
                    <label text="This Month" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="₹${zinr.inr(ec.l10n.format(totalCollected, '#,##0'))}" type="h4" style="text-weight-bold text-primary"/>
                    <label text="All Time" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${paymentList?.size() ?: 0}" type="h4" style="text-weight-bold text-info"/>
                    <label text="Total Transactions" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${failedCount}" type="h4" style="text-weight-bold ${failedCount > 0 ? 'text-negative' : 'text-grey-6'}"/>
                    <label text="Failed" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PaymentListForm" list="paymentList" skip-form="true"
                       header-dialog="true" show-csv-button="true" show-xlsx-button="true"
                       select-columns="true" saved-finds="true">
                <field name="saasPaymentId"><default-field title="ID"><display/></default-field></field>
                <field name="tenantId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Tenant"><display text="${tenantNames?.get(tenantId) ?: tenantId}"/></default-field></field>
                <field name="saasInvoiceId"><default-field title="Invoice"><display/></default-field></field>
                <field name="amount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                <field name="paymentGateway"><default-field title="Gateway"><display/></default-field></field>
                <field name="paymentMethod"><default-field title="Method"><display/></default-field></field>
                <field name="gatewayPaymentId"><default-field title="Txn ID"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="paymentDate"><header-field show-order-by="true"/>
                    <default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
