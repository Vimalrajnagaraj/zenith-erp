<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Plans" require-authentication="true">
    <transition name="updatePlan"><service-call name="update#zenith.erp.saas.SaasPlan"/>
        <default-response url="."/></transition>
    <transition name="createPlan"><service-call name="create#zenith.erp.saas.SaasPlan"/>
        <default-response url="."/></transition>
    <transition name="addModule"><service-call name="create#zenith.erp.saas.SaasPlanModule"/>
        <default-response url="."/></transition>
    <transition name="removeModule">
        <service-call name="delete#zenith.erp.saas.SaasPlanModule"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasPlan" list="planList">
            <order-by field-name="sortOrder"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasPlanModule" list="planModules">
            <order-by field-name="planId,moduleId"/>
        </entity-find>
        <set field="availableModules" from="[
            [key:'accounting', label:'Accounting'],
            [key:'analytics', label:'Analytics'],
            [key:'app', label:'App'],
            [key:'approvals', label:'Approvals'],
            [key:'assets', label:'Assets'],
            [key:'attendance', label:'Attendance'],
            [key:'barcode', label:'Barcode'],
            [key:'base', label:'Base'],
            [key:'contacts', label:'Contacts'],
            [key:'crm', label:'CRM'],
            [key:'discuss', label:'Discuss'],
            [key:'distribution', label:'Distribution'],
            [key:'documents', label:'Documents'],
            [key:'ecommerce', label:'Ecommerce'],
            [key:'events', label:'Events'],
            [key:'expenses', label:'Expenses'],
            [key:'fieldservice', label:'Field Service'],
            [key:'fleet', label:'Fleet'],
            [key:'franchise', label:'Franchise'],
            [key:'giftcard', label:'Gift Card'],
            [key:'helpdesk', label:'Helpdesk'],
            [key:'hr', label:'HR'],
            [key:'india', label:'India'],
            [key:'integrations', label:'Integrations'],
            [key:'inventory', label:'Inventory'],
            [key:'loyalty', label:'Loyalty'],
            [key:'maintenance', label:'Maintenance'],
            [key:'manufacturing', label:'Manufacturing'],
            [key:'marketing', label:'Marketing'],
            [key:'omnichannel', label:'Omnichannel'],
            [key:'payroll', label:'Payroll'],
            [key:'plm', label:'PLM'],
            [key:'pos', label:'POS'],
            [key:'pricing', label:'Pricing'],
            [key:'project', label:'Project'],
            [key:'promotions', label:'Promotions'],
            [key:'purchase', label:'Purchase'],
            [key:'quality', label:'Quality'],
            [key:'recruitment', label:'Recruitment'],
            [key:'rental', label:'Rental'],
            [key:'returns', label:'Returns'],
            [key:'saas', label:'SaaS'],
            [key:'sales', label:'Sales'],
            [key:'settings', label:'Settings'],
            [key:'sign', label:'Sign'],
            [key:'stores', label:'Stores'],
            [key:'studio', label:'Studio'],
            [key:'subscriptions', label:'Subscriptions'],
            [key:'tax', label:'Tax'],
            [key:'timeoff', label:'Time Off'],
            [key:'timesheets', label:'Timesheets'],
            [key:'uae', label:'UAE'],
            [key:'uk', label:'UK'],
            [key:'us', label:'US'],
            [key:'website', label:'Website'],
            [key:'workshop', label:'Workshop'],
            [key:'ALL', label:'ALL']
        ]"/>
    </actions>
    <widgets>
        <container style="row justify-between items-center q-mb-md">
            <label text="Subscription Plans" type="h5" style="text-weight-bold q-my-none"/>
            <container-dialog id="NewPlanDialog" button-text="+ New Plan" type="success">
                <form-single name="NewPlanForm" transition="createPlan">
                    <field name="planId"><default-field title="Plan ID (e.g. BASIC)">
                        <text-line size="15"/>
                    </default-field></field>
                    <field name="planName"><default-field title="Plan Name">
                        <text-line size="20"/>
                    </default-field></field>
                    <field name="planCode"><default-field title="Plan Code">
                        <text-line size="15"/>
                    </default-field></field>
                    <field name="description"><default-field title="Description">
                        <text-line size="40"/>
                    </default-field></field>
                    <field name="monthlyPrice"><default-field title="Monthly Price">
                        <text-line size="8" input-type="number" default-value="0"/>
                    </default-field></field>
                    <field name="yearlyPrice"><default-field title="Yearly Price">
                        <text-line size="8" input-type="number" default-value="0"/>
                    </default-field></field>
                    <field name="maxUsers"><default-field title="Max Users (0=unlimited)">
                        <text-line size="5" input-type="number" default-value="1"/>
                    </default-field></field>
                    <field name="maxPosTerminals"><default-field title="Max POS Terminals">
                        <text-line size="5" input-type="number" default-value="1"/>
                    </default-field></field>
                    <field name="maxProductsSku"><default-field title="Max Products">
                        <text-line size="8" input-type="number" default-value="500"/>
                    </default-field></field>
                    <field name="maxMonthlyTransactions"><default-field title="Max Transactions/Month">
                        <text-line size="8" input-type="number" default-value="1000"/>
                    </default-field></field>
                    <field name="maxStores"><default-field title="Max Stores (0=unlimited)">
                        <text-line size="5" input-type="number" default-value="1"/>
                    </default-field></field>
                    <field name="maxLoyaltyMembers"><default-field title="Max Loyalty Members (0=unlimited)">
                        <text-line size="8" input-type="number" default-value="0"/>
                    </default-field></field>
                    <field name="maxPromotions"><default-field title="Max Active Promotions (0=unlimited)">
                        <text-line size="5" input-type="number" default-value="5"/>
                    </default-field></field>
                    <field name="trialDays"><default-field title="Trial Days">
                        <text-line size="5" input-type="number" default-value="14"/>
                    </default-field></field>
                    <field name="sortOrder"><default-field title="Sort Order">
                        <text-line size="3" input-type="number" default-value="10"/>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Create Plan"/>
                    </default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- Plans Table (editable inline) -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="PlanListForm" list="planList" transition="updatePlan">
                <field name="planId"><default-field title="ID"><display/></default-field></field>
                <field name="planName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="monthlyPrice"><default-field title="Monthly (₹)"><text-line size="8" input-type="number"/></default-field></field>
                <field name="yearlyPrice"><default-field title="Yearly (₹)"><text-line size="8" input-type="number"/></default-field></field>
                <field name="maxUsers"><default-field title="Users"><text-line size="4" input-type="number"/></default-field></field>
                <field name="maxPosTerminals"><default-field title="POS"><text-line size="4" input-type="number"/></default-field></field>
                <field name="maxProductsSku"><default-field title="Products"><text-line size="6" input-type="number"/></default-field></field>
                <field name="maxMonthlyTransactions"><default-field title="Txns/Mo"><text-line size="6" input-type="number"/></default-field></field>
                <field name="maxStores"><default-field title="Stores"><text-line size="4" input-type="number"/></default-field></field>
                <field name="maxLoyaltyMembers"><default-field title="Loyalty"><text-line size="6" input-type="number"/></default-field></field>
                <field name="maxPromotions"><default-field title="Promos"><text-line size="4" input-type="number"/></default-field></field>
                <field name="trialDays"><default-field title="Trial"><text-line size="3" input-type="number"/></default-field></field>
                <field name="sortOrder"><default-field title="Order"><text-line size="3" input-type="number"/></default-field></field>
                <field name="isActive"><default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                <field name="submitBtn"><default-field title=""><submit text="Save"/></default-field></field>
            </form-list>
        </container>

        <!-- Plan Modules Management -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row justify-between items-center q-mb-md">
                <label text="Plan → Module Access" type="h6" style="text-weight-bold q-my-none"/>
                <container-dialog id="AddModuleDialog" button-text="+ Add Module" type="primary">
                    <form-single name="AddModuleForm" transition="addModule">
                        <field name="planId"><default-field title="Plan">
                            <drop-down>
                                <list-options list="planList" key="${planId}" text="${planName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="moduleId"><default-field title="Module">
                            <drop-down>
                                <list-options list="availableModules" key="${it.key}" text="${it.label}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="">
                            <submit text="Add Module"/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <form-list name="PlanModulesForm" list="planModules" skip-form="true">
                <field name="planId"><default-field title="Plan"><display/></default-field></field>
                <field name="moduleId"><default-field title="Module"><display/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="removeModule" text="Remove" btn-type="danger" icon="fa fa-trash"
                          parameter-map="[planId:planId, moduleId:moduleId]"
                          confirmation="Remove ${moduleId} from ${planId}?"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
