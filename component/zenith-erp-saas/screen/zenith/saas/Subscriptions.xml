<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Subscriptions" require-authentication="true">
    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasSubscription" list="subList">
            <search-form-inputs default-order-by="-startDate"/>
        </entity-find>
        <!-- Summary counts -->
        <entity-find-count entity-name="zenith.erp.saas.SaasSubscription" count-field="activeCount">
            <econdition field-name="statusId" value="SubActive"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.saas.SaasSubscription" count-field="trialCount">
            <econdition field-name="statusId" value="SubTrial"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.saas.SaasSubscription" count-field="pastDueCount">
            <econdition field-name="statusId" value="SubPastDue"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.saas.SaasSubscription" count-field="cancelledCount">
            <econdition field-name="statusId" value="SubCancelled"/>
        </entity-find-count>
        <!-- Tenant lookup map -->
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenantsList"/>
        <script>
            tenantNames = [:]
            tenantsList?.each { t -> tenantNames[t.tenantId] = t.tenantName }
        </script>
    </actions>
    <widgets>
        <label text="Subscriptions" type="h5" style="text-weight-bold q-mb-md"/>

        <!-- Summary -->
        <container style="row q-gutter-md q-mb-lg">
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${activeCount}" type="h4" style="text-weight-bold text-positive"/>
                    <label text="Active" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${trialCount}" type="h4" style="text-weight-bold text-warning"/>
                    <label text="Trial" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${pastDueCount}" type="h4" style="text-weight-bold text-negative"/>
                    <label text="Past Due" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md text-center">
                    <label text="${cancelledCount}" type="h4" style="text-weight-bold text-grey-6"/>
                    <label text="Cancelled" style="text-grey-7 text-caption" type="p"/>
                </container>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="SubscriptionListForm" list="subList" skip-form="true"
                       header-dialog="true" show-csv-button="true" show-xlsx-button="true"
                       select-columns="true" saved-finds="true">
                <field name="subscriptionId"><default-field title="ID"><display/></default-field></field>
                <field name="tenantId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Tenant"><display text="${tenantNames?.get(tenantId) ?: tenantId}"/></default-field></field>
                <field name="planId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Plan"><display/></default-field></field>
                <field name="billingCycle"><default-field title="Cycle"><display/></default-field></field>
                <field name="amount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="startDate"><header-field show-order-by="true"/>
                    <default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="renewalDate"><default-field title="Renewal"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="trialEndDate"><default-field title="Trial Ends"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="autoRenew"><default-field title="Auto"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
