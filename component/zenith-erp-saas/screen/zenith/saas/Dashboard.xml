<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" require-authentication="true">
    <actions>
        <!-- Platform SaaS billing is INR. currencySymbol was never assigned, so ${currencySymbol} rendered the
             literal "null" before the MRR / Revenue / outstanding figures on this dashboard. -->
        <set field="currencySymbol" value="&#8377;"/>
        <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="totalTenants"/>
        <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="activeTenants">
            <econdition field-name="statusId" value="SaasTenantActive"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="trialTenants">
            <econdition field-name="statusId" value="SaasTenantTrial"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="suspendedTenants">
            <econdition field-name="statusId" value="SaasTenantSuspended"/>
        </entity-find-count>

        <!-- Revenue this month -->
        <script><![CDATA[
            import java.time.LocalDate
            def now = LocalDate.now()
            def monthStart = java.sql.Date.valueOf(now.withDayOfMonth(1))
            def monthEnd = java.sql.Date.valueOf(now.withDayOfMonth(now.lengthOfMonth()))

            // Previous month for comparison
            def prevMonth = now.minusMonths(1)
            def prevMonthStart = java.sql.Date.valueOf(prevMonth.withDayOfMonth(1))
            def prevMonthEnd = java.sql.Date.valueOf(prevMonth.withDayOfMonth(prevMonth.lengthOfMonth()))
        ]]></script>
        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="monthPayments">
            <econdition field-name="paymentDate" operator="greater-equals" from="monthStart"/>
            <econdition field-name="paymentDate" operator="less-equals" from="monthEnd"/>
            <econdition field-name="statusId" value="SpSuccess"/>
        </entity-find>
        <set field="monthlyRevenue" from="monthPayments?.sum { it.amount ?: 0 } ?: 0"/>

        <entity-find entity-name="zenith.erp.saas.SaasPayment" list="prevMonthPayments">
            <econdition field-name="paymentDate" operator="greater-equals" from="prevMonthStart"/>
            <econdition field-name="paymentDate" operator="less-equals" from="prevMonthEnd"/>
            <econdition field-name="statusId" value="SpSuccess"/>
        </entity-find>
        <set field="prevMonthRevenue" from="prevMonthPayments?.sum { it.amount ?: 0 } ?: 0"/>

        <!-- MRR from active subscriptions -->
        <entity-find entity-name="zenith.erp.saas.SaasSubscription" list="activeSubscriptions">
            <econdition field-name="statusId" operator="in" value="SubActive,SubTrial"/>
        </entity-find>
        <set field="mrr" from="activeSubscriptions?.sum { (it.billingCycle == 'Yearly') ? ((it.amount ?: 0) / 12.0) : (it.amount ?: 0) } ?: 0"/>

        <!-- Overdue invoices -->
        <entity-find entity-name="zenith.erp.saas.SaasInvoice" list="overdueInvoices">
            <econdition field-name="statusId" operator="in" value="SiSent,SiOverdue"/>
            <econdition field-name="dueDate" operator="less" from="ec.user.nowTimestamp"/>
            <order-by field-name="dueDate"/>
        </entity-find>
        <set field="overdueAmount" from="overdueInvoices?.sum { it.totalAmount ?: 0 } ?: 0"/>

        <!-- Plan distribution -->
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="allActiveTenants">
            <econdition field-name="statusId" operator="in" value="SaasTenantActive,SaasTenantTrial"/>
        </entity-find>
        <script><![CDATA[
            planDistribution = [:]
            allActiveTenants?.each { t ->
                def p = t.planId ?: 'Unknown'
                planDistribution[p] = (planDistribution[p] ?: 0) + 1
            }
        ]]></script>

        <!-- Recent tenants (last 7 days) -->
        <script>
            def sevenDaysAgo = java.sql.Timestamp.valueOf(java.time.LocalDate.now().minusDays(7).atStartOfDay())
        </script>
        <entity-find-count entity-name="zenith.erp.saas.SaasTenant" count-field="newThisWeek">
            <econdition field-name="registeredDate" operator="greater-equals" from="sevenDaysAgo"/>
        </entity-find-count>

        <!-- Recent tenants list -->
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="recentTenants" limit="10">
            <order-by field-name="-registeredDate"/>
        </entity-find>

        <!-- Recent audit -->
        <entity-find entity-name="zenith.erp.saas.SaasAuditLog" list="recentAudit" limit="15">
            <order-by field-name="-eventDate"/>
        </entity-find>

        <!-- Plans for reference -->
        <entity-find entity-name="zenith.erp.saas.SaasPlan" list="planList">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="sortOrder"/>
        </entity-find>
    </actions>
    <widgets>
        <label text="SaaS Admin Dashboard" type="h4" style="q-mb-md text-weight-bold"/>

        <!-- Row 1: KPI Cards -->
        <container style="row q-gutter-md q-mb-lg">
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <render-mode><text type="html"><![CDATA[<q-icon name="storefront" class="text-h3 text-primary"/>]]></text></render-mode>
                    <label text="${totalTenants}" type="h3" style="text-weight-bold q-my-sm"/>
                    <label text="Total Tenants" style="text-grey-7"/>
                    <label text="+${newThisWeek} this week" style="text-caption text-positive" type="p"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <render-mode><text type="html"><![CDATA[<q-icon name="check_circle" class="text-h3 text-positive"/>]]></text></render-mode>
                    <label text="${activeTenants}" type="h3" style="text-weight-bold q-my-sm"/>
                    <label text="Active" style="text-grey-7"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <render-mode><text type="html"><![CDATA[<q-icon name="block" class="text-h3 text-negative"/>]]></text></render-mode>
                    <label text="${suspendedTenants}" type="h3" style="text-weight-bold q-my-sm"/>
                    <label text="Suspended" style="text-grey-7"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <render-mode><text type="html"><![CDATA[<q-icon name="trending_up" class="text-h3 text-info"/>]]></text></render-mode>
                    <label text="${currencySymbol}${zinr.inr(ec.l10n.format(mrr, '#,##0'))}" type="h3" style="text-weight-bold q-my-sm"/>
                    <label text="Monthly Recurring Revenue" style="text-grey-7"/>
                </container>
            </container>
            <container style="col">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <render-mode><text type="html"><![CDATA[<q-icon name="payments" class="text-h3 text-positive"/>]]></text></render-mode>
                    <label text="${currencySymbol}${zinr.inr(ec.l10n.format(monthlyRevenue, '#,##0'))}" type="h3" style="text-weight-bold q-my-sm"/>
                    <label text="Revenue This Month" style="text-grey-7"/>
                </container>
            </container>
        </container>

        <!-- Row 2: Alerts + Plan Distribution -->
        <container style="row q-gutter-md q-mb-lg">
            <!-- Overdue Alert -->
            <container style="col-6">
                <section name="OverdueSection">
                    <condition><expression>overdueInvoices</expression></condition>
                    <widgets>
                        <container style="zenith-card bg-red-1 shadow-2 border-radius-lg q-pa-lg">
                            <container style="row items-center q-mb-md">
                                <render-mode><text type="html"><![CDATA[<q-icon name="warning" class="text-negative q-mr-sm"/>]]></text></render-mode>
                                <label text="Overdue Invoices (${overdueInvoices.size()})" type="h6" style="text-weight-bold text-negative q-my-none"/>
                                <label text=" — ${currencySymbol}${zinr.inr(ec.l10n.format(overdueAmount, '#,##0'))} outstanding" style="text-grey-8 q-ml-sm"/>
                            </container>
                            <form-list name="OverdueInvoicesForm" list="overdueInvoices" skip-form="true" list-entry-limit="5">
                                <field name="tenantId"><default-field title="Tenant"><display/></default-field></field>
                                <field name="totalAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                                <field name="dueDate"><default-field title="Due Date"><display format="dd-MMM-yyyy"/></default-field></field>
                                <field name="actions"><default-field title="">
                                    <link url="../Invoices" text="View" btn-type="warning" icon="fa fa-eye"/>
                                </default-field></field>
                            </form-list>
                        </container>
                    </widgets>
                    <fail-widgets>
                        <container style="zenith-card bg-green-1 shadow-2 border-radius-lg q-pa-lg">
                            <container style="row items-center">
                                <render-mode><text type="html"><![CDATA[<q-icon name="check_circle" class="text-positive q-mr-sm"/>]]></text></render-mode>
                                <label text="No Overdue Invoices" type="h6" style="text-weight-bold text-positive q-my-none"/>
                            </container>
                            <label text="All invoices are current. Great!" style="text-grey-7 q-mt-sm" type="p"/>
                        </container>
                    </fail-widgets>
                </section>
            </container>

            <!-- Plan Distribution -->
            <container style="col-6">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Plan Distribution" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-list name="PlanDistForm" list="planList" skip-form="true">
                        <field name="planName"><default-field title="Plan"><display/></default-field></field>
                        <field name="monthlyPrice"><default-field title="Price/mo"><display format="₹#,##0"/></default-field></field>
                        <field name="tenantCount"><default-field title="Tenants">
                            <display text="${planDistribution?.get(planId) ?: 0}"/>
                        </default-field></field>
                    </form-list>
                </container>
            </container>
        </container>

        <!-- Recent Signups -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row justify-between items-center q-mb-md">
                <label text="Recent Signups" type="h6" style="text-weight-bold q-my-none"/>
                <link url="../Tenants" text="View All →" link-type="anchor" style="text-primary"/>
            </container>
            <form-list name="RecentTenantsForm" list="recentTenants" skip-form="true">
                <field name="tenantName"><default-field title="Business"><display/></default-field></field>
                <field name="subdomain"><default-field title="Subdomain"><display/></default-field></field>
                <field name="planId"><default-field title="Plan"><display/></default-field></field>
                <field name="adminEmail"><default-field title="Admin Email"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="registeredDate"><default-field title="Registered"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="../TenantDetail" text="View" btn-type="primary" icon="fa fa-eye"
                          parameter-map="[tenantId:tenantId]"/>
                </default-field></field>
            </form-list>
        </container>

        <!-- Recent Activity -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row justify-between items-center q-mb-md">
                <label text="Recent Activity" type="h6" style="text-weight-bold q-my-none"/>
            </container>
            <form-list name="AuditLogForm" list="recentAudit" skip-form="true">
                <field name="eventDate"><default-field title="Date"><display format="dd-MMM HH:mm"/></default-field></field>
                <field name="eventType"><default-field title="Event"><display/></default-field></field>
                <field name="tenantId"><default-field title="Tenant"><display/></default-field></field>
                <field name="description"><default-field title="Details"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
