<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices" require-authentication="true">

    <transition name="markPaid">
        <actions>
            <service-call name="update#zenith.erp.saas.SaasInvoice"
                in-map="[saasInvoiceId:saasInvoiceId, statusId:'SiPaid', paidDate:ec.user.nowTimestamp]"/>
            <entity-find-one entity-name="zenith.erp.saas.SaasInvoice" value-field="inv"/>
            <if condition="inv?.tenantId">
                <entity-find-one entity-name="zenith.erp.saas.SaasTenant" value-field="tenant">
                    <field-map field-name="tenantId" from="inv.tenantId"/>
                </entity-find-one>
                <if condition="tenant?.statusId == 'SaasTenantSuspended'">
                    <service-call name="zenith.saas.SaasLifecycleServices.reactivate#AfterPayment"
                        in-map="[tenantId:inv.tenantId, paymentId:'MANUAL']"/>
                </if>
            </if>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-SUB-008 (MS-048): a manual invoice must be GST-correct + auditable. Old version entity-auto-created
         with a flat, hand-typed taxAmount and NO invoice number and NO CGST/SGST/IGST split. Now: number it in
         the shared SAAS-yyyyMM-NNNN series, and route the tax through the SAME India GST engine the renewal cron
         uses (calculate#SubscriptionTax, ZETAERP supplier) so the head-split is computed. The split is populated
         once ZETAERP's GSTIN/state + the tenant's state are configured; until then the engine returns a correct
         flat 18% total. Admin enters the taxable Subtotal + GST% only. -->
    <transition name="createInvoice">
        <actions>
            <script><![CDATA[
                import java.time.LocalDate
                import java.math.BigDecimal
                def _tenant = ec.entity.find("zenith.erp.saas.SaasTenant").condition("tenantId", tenantId).disableAuthz().one()
                if (_tenant == null) { ec.message.addError("Select a tenant."); return }
                def _sub = (subtotal ?: 0) as BigDecimal
                if (_sub.signum() <= 0) { ec.message.addError("Enter a Subtotal greater than 0."); return }
                def _rate = (gstRate != null && gstRate.toString().trim()) ? (gstRate as BigDecimal) : new BigDecimal(18)
                def taxOut = ec.service.sync().name("zenith.subscriptions.SubscriptionServices.calculate#SubscriptionTax")
                    .parameters([organizationPartyId:'ZETAERP', customerPartyId:_tenant.organizationPartyId,
                                 taxableAmount:_sub, gstRate:_rate]).disableAuthz().call()
                def _prefix = 'SAAS-' + LocalDate.now().toString().substring(0,7).replace('-','') + '-'
                def _last = ec.entity.find("zenith.erp.saas.SaasInvoice").condition("invoiceNumber","like",_prefix+'%')
                    .orderBy("-invoiceNumber").disableAuthz().list()
                int _seq = 1
                if (_last) { try { _seq = (_last[0].invoiceNumber.toString().substring(_prefix.length()) as Integer) + 1 } catch (Exception e) { _seq = _last.size() + 1 } }
                def _invNo = _prefix + String.format('%04d', _seq)
                ec.service.sync().name("create#zenith.erp.saas.SaasInvoice").parameters([
                    tenantId:tenantId, invoiceNumber:_invNo, invoiceDate:invoiceDate, dueDate:dueDate,
                    periodFrom:periodFrom, periodTo:periodTo, subtotal:_sub, taxAmount:(taxOut?.taxAmount ?: 0),
                    cgstAmount:taxOut?.cgstAmount, sgstAmount:taxOut?.sgstAmount, igstAmount:taxOut?.igstAmount,
                    placeOfSupply:taxOut?.placeOfSupply, totalAmount:(taxOut?.totalAmount ?: _sub),
                    currencyUomId:(currencyUomId ?: 'INR'), statusId:(statusId ?: 'SiSent'), notes:notes
                ]).disableAuthz().call()
                ec.message.addMessage("Invoice ${_invNo} created for ${_tenant.tenantName} — subtotal ${_sub} + GST ${(taxOut?.taxAmount ?: 0)} = ${(taxOut?.totalAmount ?: _sub)}.")
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.saas.SaasInvoice" list="invoiceList">
            <search-form-inputs default-order-by="-invoiceDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.saas.SaasTenant" list="tenantOptions">
            <econdition field-name="statusId" operator="in" value="SaasTenantActive,SaasTenantSuspended"/>
            <order-by field-name="tenantName"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="row justify-between items-center q-mb-md">
            <label text="SaaS Invoices" type="h5" style="text-weight-bold q-my-none"/>
            <container-dialog id="NewInvoiceDialog" button-text="+ New Invoice" type="success">
                <form-single name="NewInvoiceForm" transition="createInvoice">
                    <field name="tenantId"><default-field title="Tenant">
                        <drop-down>
                            <list-options list="tenantOptions" key="${tenantId}" text="${tenantName} (${subdomain})"/>
                        </drop-down>
                    </default-field></field>
                    <field name="invoiceDate"><default-field title="Invoice Date">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="dueDate"><default-field title="Due Date">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="periodFrom"><default-field title="Period From">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="periodTo"><default-field title="Period To">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="subtotal"><default-field title="Subtotal (taxable, ex-GST)">
                        <text-line size="10" input-type="number"/>
                    </default-field></field>
                    <field name="gstRate"><default-field title="GST %">
                        <text-line size="5" input-type="number" default-value="18"/>
                        <label text="Tax, CGST/SGST or IGST split, and Total are computed automatically." style="text-grey-6 text-caption" type="p"/>
                    </default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <text-line size="5" default-value="INR"/>
                    </default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="SiSent">
                            <option key="SiDraft" text="Draft"/>
                            <option key="SiSent" text="Sent"/>
                        </drop-down>
                    </default-field></field>
                    <field name="notes"><default-field title="Notes">
                        <text-line size="40"/>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Create Invoice"/>
                    </default-field></field>
                </form-single>
            </container-dialog>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Invoices..." style="display:none"></span>]]></text></render-mode>
            <form-list name="InvoiceListForm" list="invoiceList" skip-form="true"
                       header-dialog="true" show-csv-button="true" show-xlsx-button="true">
                <field name="saasInvoiceId"><default-field title="ID"><display/></default-field></field>
                <field name="tenantId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Tenant"><display/></default-field></field>
                <field name="invoiceDate"><header-field show-order-by="true"/>
                    <default-field title="Invoice Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="dueDate"><default-field title="Due Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="periodFrom"><default-field title="From"><display format="dd-MMM"/></default-field></field>
                <field name="periodTo"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true"><text-find/></header-field>
                    <default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                <field name="paidDate"><default-field title="Paid"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="../InvoiceDetail" text="View" btn-type="info" icon="fa fa-eye"
                          parameter-map="[saasInvoiceId:saasInvoiceId]"/>
                    <link url="markPaid" text="Mark Paid" btn-type="success" icon="fa fa-check"
                          parameter-map="[saasInvoiceId:saasInvoiceId]"
                          condition="statusId == 'SiSent' || statusId == 'SiOverdue'"
                          confirmation="Mark invoice ${saasInvoiceId} as paid?"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
