<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="App Marketplace" default-menu-index="80">

    <transition name="installPlugin">
        <service-call name="zenith.saas.MarketplaceServices.install#Plugin" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Mock App Marketplace Catalog -->
        <script>
            marketplaceApps = [
                [pluginId: 'salesforce-sync', name: 'Salesforce CRM Sync', category: 'CRM', price: 'Free', icon: 'glyphicon glyphicon-cloud', description: 'Bi-directional sync between Zenith ERP and Salesforce.'],
                [pluginId: 'mailchimp-marketing', name: 'Mailchimp Automations', category: 'Marketing', price: '$15/mo', icon: 'glyphicon glyphicon-envelope', description: 'Trigger targeted email campaigns based on ERP events.'],
                [pluginId: 'autocad-connector', name: 'AutoCAD BOM Importer', category: 'Manufacturing', price: '$99/mo', icon: 'glyphicon glyphicon-wrench', description: 'Import Bill of Materials directly from AutoCAD files.']
            ]
            
            def orgId = ec.user.getPreference("ACTIVE_ORGANIZATION")
            def tenant = ec.entity.find("zenith.erp.saas.SaasTenant").condition("organizationPartyId", orgId).one()
            currentTenantId = tenant?.tenantId ?: 'UNKNOWN'
        </script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Zenith App Marketplace" type="h4" style="text-weight-bold q-my-none"/>
            <label text="Extend your ERP with third-party plugins and partner integrations." type="p" style="text-subtitle1 text-grey-7 q-mb-none"/>
        </container>

        <container-row>
            <iterate list="marketplaceApps" entry="app">
                <row-col lg="4" md="6" sm="12">
                    <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                        <container style="row items-center justify-between q-mb-sm">
                            <container style="row items-center">
                                <label text="" icon="${app.icon}" type="i" style="text-primary q-mr-sm" size="24"/>
                                <label text="${app.name}" type="h5" style="text-weight-bold q-my-none"/>
                            </container>
                            <label text="${app.price}" type="span" style="text-success text-weight-bold"/>
                        </container>
                        <label text="${app.category}" type="p" style="text-grey-6 text-uppercase q-mb-md"/>
                        <label text="${app.description}" type="p" style="q-mb-lg"/>
                        
                        <container-dialog id="InstallDialog_${app.pluginId}" button-text="Install App" type="primary" button-class="full-width">
                            <form-single name="InstallForm_${app.pluginId}" transition="installPlugin">
                                <field name="pluginId"><default-field><hidden/></default-field></field>
                                <field name="tenantId"><default-field><hidden default-value="${currentTenantId}"/></default-field></field>
                                
                                <!-- Conditional API Key Field for Salesforce -->
                                <field name="apiKey"><default-field title="API Key / Token (if required)">
                                    <text-line size="40"/>
                                </default-field></field>
                                
                                <field name="submitBtn"><default-field title="Confirm Installation"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                </row-col>
            </iterate>
        </container-row>
    </widgets>
</screen>
