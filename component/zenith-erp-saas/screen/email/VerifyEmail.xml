<?xml version="1.0" encoding="UTF-8"?>
<!-- ZE-ONB-002: HTML body for the EMAIL_VERIFY email template (send#EmailTemplate renders this).
     Body parameters supplied by send#SignupVerification: verifyUrl, firstName. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[
        <div style="font-family:Arial,Helvetica,sans-serif;max-width:480px;margin:0 auto;color:#212121;line-height:1.5">
            <h2 style="color:#1565c0;margin:0 0 12px">Verify your ZetaERP email</h2>
            <p>Hi ${(firstName?has_content)?then(firstName,'there')},</p>
            <p>Thanks for signing up for ZetaERP. Please confirm this email address to activate your account.</p>
            <p style="text-align:center;margin:28px 0">
                <a href="${verifyUrl!''}" style="background:#1565c0;color:#ffffff;padding:12px 30px;border-radius:6px;text-decoration:none;font-weight:600;display:inline-block">Verify my email</a>
            </p>
            <p style="font-size:13px;color:#757575">Or paste this link into your browser:<br/>
                <span style="word-break:break-all">${verifyUrl!''}</span></p>
            <p style="font-size:12px;color:#9e9e9e">If you didn't create a ZetaERP account, you can safely ignore this email.</p>
        </div>
        ]]></text></render-mode>
    </widgets>
</screen>
