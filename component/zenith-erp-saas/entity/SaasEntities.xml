    <!-- ========== SCHEDULED JOBS ========== -->
    <entity entity-name="SaasJobSeed" package="zenith.erp.saas" short-alias="SaasJobSeed">
        <description>Placeholder entity for SaaS scheduled job seed data</description>
        <field name="seedId" type="id" is-pk="true"/>
        <seed-data>
            <!-- Daily at 2:00 AM: check trial expiry -->
            <moqui.service.job.ServiceJob jobName="SaasCheckTrialExpiry"
                description="Check and suspend expired SaaS trials"
                serviceName="zenith.saas.SaasLifecycleServices.check#TrialExpiry"
                cronExpression="0 0 2 * * ?" paused="N"/>

            <!-- Daily at 2:15 AM: check subscription renewals and create invoices -->
            <moqui.service.job.ServiceJob jobName="SaasCheckRenewal"
                description="Check subscription renewals and create invoices"
                serviceName="zenith.saas.SaasLifecycleServices.check#SubscriptionRenewal"
