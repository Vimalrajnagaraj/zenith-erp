        <field name="organizationPartyId" type="id"><description>Maps to the Moqui Organization party</description></field>
        <field name="tenantName" type="text-medium"><description>Business/company name</description></field>
        <field name="subdomain" type="text-short"><description>e.g. jeyaastore → jeyaastore.zenitherp.com</description></field>
        <field name="adminUserId" type="id"><description>Primary admin user account</description></field>
        <field name="adminEmail" type="text-medium"/>
        <field name="adminPhone" type="text-short"/>
        <field name="countryGeoId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="industryEnumId" type="id"/>
        <field name="statusId" type="id" default="'SaasTenantActive'"/>
        <field name="planId" type="id"/>
        <field name="registeredDate" type="date-time"/>
        <field name="logoUrl" type="text-medium"/>
        <field name="primaryColor" type="text-short" default="'#0a2a7a'"/>
