<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== SaaS PLAN ========== -->
    <entity entity-name="SaasPlan" package="zenith.erp.saas" short-alias="SaasPlan">
        <field name="planId" type="id" is-pk="true"/>
        <field name="planName" type="text-medium"/>
        <field name="planCode" type="text-short"><description>STARTER, GROWTH, PROFESSIONAL, ENTERPRISE</description></field>
        <field name="description" type="text-long"/>
        <field name="monthlyPrice" type="currency-amount"/>
        <field name="yearlyPrice" type="currency-amount"/>
        <field name="currencyUomId" type="id" default="'INR'"/>
        <field name="maxUsers" type="number-integer" default="1"/>
        <field name="maxPosTerminals" type="number-integer" default="1"/>
        <field name="maxProductsSku" type="number-integer" default="500"/>
        <field name="maxMonthlyTransactions" type="number-integer" default="1000"/>
        <field name="maxStorageMb" type="number-integer" default="500"/>
        <field name="maxStores" type="number-integer" default="1"/>
        <field name="maxLoyaltyMembers" type="number-integer" default="0"><description>0 = unlimited or N/A</description></field>
        <field name="maxPromotions" type="number-integer" default="5"/>
        <field name="trialDays" type="number-integer" default="14"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="sortOrder" type="number-integer" default="10"/>
        <seed-data>
            <zenith.erp.saas.SaasPlan planId="STARTER" planName="Starter" planCode="STARTER"
                description="Perfect for small shops getting started"
                monthlyPrice="0" yearlyPrice="0" currencyUomId="INR"
                maxUsers="2" maxPosTerminals="1" maxProductsSku="500"
                maxMonthlyTransactions="1000" maxStorageMb="500"
                maxStores="1" maxLoyaltyMembers="0" maxPromotions="3"
                trialDays="0" sortOrder="1"/>
            <zenith.erp.saas.SaasPlan planId="GROWTH" planName="Growth" planCode="GROWTH"
                description="For growing retail businesses"
                monthlyPrice="999" yearlyPrice="9999" currencyUomId="INR"
                maxUsers="5" maxPosTerminals="3" maxProductsSku="5000"
                maxMonthlyTransactions="10000" maxStorageMb="2000"
                maxStores="3" maxLoyaltyMembers="5000" maxPromotions="20"
                trialDays="14" sortOrder="2"/>
            <zenith.erp.saas.SaasPlan planId="PROFESSIONAL" planName="Professional" planCode="PROFESSIONAL"
                description="For multi-store retail and wholesale"
                monthlyPrice="2499" yearlyPrice="24999" currencyUomId="INR"
                maxUsers="15" maxPosTerminals="10" maxProductsSku="50000"
                maxMonthlyTransactions="100000" maxStorageMb="10000"
                maxStores="25" maxLoyaltyMembers="50000" maxPromotions="100"
                trialDays="14" sortOrder="3"/>
            <zenith.erp.saas.SaasPlan planId="ENTERPRISE" planName="Enterprise" planCode="ENTERPRISE"
                description="Unlimited access for large operations and franchise"
                monthlyPrice="4999" yearlyPrice="49999" currencyUomId="INR"
                maxUsers="0" maxPosTerminals="0" maxProductsSku="0"
                maxMonthlyTransactions="0" maxStorageMb="0"
                maxStores="0" maxLoyaltyMembers="0" maxPromotions="0"
                trialDays="14" sortOrder="4"/>
        </seed-data>
    </entity>

