    <!-- ========== SaaS SUBSCRIPTION ========== -->
    <entity entity-name="SaasSubscription" package="zenith.erp.saas" short-alias="SaasSubscription">
        <field name="subscriptionId" type="id" is-pk="true"/>
        <field name="tenantId" type="id"/>
        <field name="planId" type="id"/>
        <field name="statusId" type="id" default="'SubActive'"/>
        <field name="billingCycle" type="text-short" default="'Monthly'"><description>Monthly, Yearly</description></field>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="renewalDate" type="date"/>
        <field name="trialEndDate" type="date"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="gatewayCustomerId" type="text-medium"><description>Razorpay/Stripe customer ID</description></field>
        <field name="gatewaySubscriptionId" type="text-medium"><description>Razorpay/Stripe subscription ID</description></field>
        <field name="autoRenew" type="text-indicator" default="'Y'"/>
        <field name="cancelledDate" type="date"/>
        <field name="cancelReason" type="text-medium"/>
        <relationship type="one" related="zenith.erp.saas.SaasTenant"/>
        <relationship type="one" related="zenith.erp.saas.SaasPlan"/>
        <!-- ZE-SUBLC-03: the Sub* status definitions are NOT here. This file once seeded a 'SaasSubscription'
             StatusType + StatusFlow, but zenith-erp-subscriptions/entity/SubscriptionEntities.xml declares the
             SAME status IDs (SubTrial/SubActive/… statusType='Subscription', flow='Default') and loads first, so
             those StatusItems won the PK and this seed was DEAD (it only ever left an orphan 'SaasSubscription'
             StatusType row nothing referenced). Removed so it stops misleading readers into the wrong flow — the
             live transitions (incl. SubTrial→SubExpired, added in ZE-SUBLC-02) are the 'Default' flow rows in
             SubscriptionEntities.xml. -->
    </entity>

