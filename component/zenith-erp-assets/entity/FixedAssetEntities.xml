<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Fixed Asset Category ========== -->
    <entity entity-name="FixedAssetCategory" package="zenith.erp.assets" short-alias="FixedAssetCategory">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="parentCategoryId" type="id"/>
        <field name="depreciationMethodEnumId" type="id"/>
        <field name="defaultUsefulLifeMonths" type="number-integer"/>
        <field name="defaultSalvagePercent" type="number-decimal"/>
        <field name="glAssetAccountId" type="id"/>
        <field name="glDepreciationAccountId" type="id"/>
        <field name="glAccumulatedDepAccountId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" title="Parent" related="zenith.erp.assets.FixedAssetCategory">
            <key-map field-name="parentCategoryId" related="categoryId"/></relationship>
        <relationship type="one" title="Asset" related="mantle.ledger.account.GlAccount">
            <key-map field-name="glAssetAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="Depreciation" related="mantle.ledger.account.GlAccount">
            <key-map field-name="glDepreciationAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="AccumulatedDep" related="mantle.ledger.account.GlAccount">
            <key-map field-name="glAccumulatedDepAccountId" related="glAccountId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="DepreciationMethod" description="Depreciation Method"/>
            <moqui.basic.Enumeration enumId="DmStraightLine" enumTypeId="DepreciationMethod" description="Straight Line (SLM)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="DmWrittenDown" enumTypeId="DepreciationMethod" description="Written Down Value (WDV)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="DmDoubleDeclining" enumTypeId="DepreciationMethod" description="Double Declining Balance" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="DmSumOfYears" enumTypeId="DepreciationMethod" description="Sum of Years Digits" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="DmUnitsOfProduction" enumTypeId="DepreciationMethod" description="Units of Production" sequenceNum="5"/>

            <!-- Default Categories -->
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_LAND" categoryName="Land" depreciationMethodEnumId="" defaultUsefulLifeMonths="0" defaultSalvagePercent="100"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_BUILDING" categoryName="Buildings" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="360" defaultSalvagePercent="10"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_PLANT" categoryName="Plant &amp; Machinery" depreciationMethodEnumId="DmWrittenDown" defaultUsefulLifeMonths="180" defaultSalvagePercent="5"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_FURNITURE" categoryName="Furniture &amp; Fixtures" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="120" defaultSalvagePercent="10"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_VEHICLE" categoryName="Motor Vehicles" depreciationMethodEnumId="DmWrittenDown" defaultUsefulLifeMonths="96" defaultSalvagePercent="5"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_COMPUTER" categoryName="Computers &amp; IT Equipment" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="36" defaultSalvagePercent="5"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_OFFICE" categoryName="Office Equipment" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="60" defaultSalvagePercent="10"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_INTANGIBLE" categoryName="Intangible Assets" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="60" defaultSalvagePercent="0"/>
            <zenith.erp.assets.FixedAssetCategory categoryId="FAC_ELECTRICAL" categoryName="Electrical Installations" depreciationMethodEnumId="DmStraightLine" defaultUsefulLifeMonths="120" defaultSalvagePercent="5"/>
        </seed-data>
    </entity>

    <!-- ========== Fixed Asset ========== -->
    <entity entity-name="FixedAsset" package="zenith.erp.assets" short-alias="FixedAsset">
        <field name="fixedAssetId" type="id" is-pk="true"/>
        <field name="assetName" type="text-medium"/>
        <field name="assetCode" type="text-short"/>
        <field name="categoryId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="purchaseDate" type="date"/>
        <field name="purchaseAmount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="vendorPartyId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="serialNumber" type="text-short"/>
        <field name="modelNumber" type="text-short"/>
        <field name="manufacturer" type="text-medium"/>
        <field name="warrantyExpiryDate" type="date"/>
        <field name="depreciationMethodEnumId" type="id"/>
        <field name="usefulLifeMonths" type="number-integer"/>
        <field name="salvageValue" type="currency-amount"/>
        <field name="depreciationStartDate" type="date"/>
        <field name="accumulatedDepreciation" type="currency-amount" default="0"/>
        <field name="currentBookValue" type="currency-amount"/>
        <field name="disposalDate" type="date"/>
        <field name="disposalAmount" type="currency-amount"/>
        <field name="disposalMethod" type="text-short"/>
        <field name="disposalGainLoss" type="currency-amount"/>
        <field name="location" type="text-medium"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="lastDepreciationDate" type="date"/>
        <relationship type="one" related="zenith.erp.assets.FixedAssetCategory" short-alias="category"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <relationship type="one" title="Vendor" related="mantle.party.Party">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
        <relationship type="one" title="AssignedTo" related="mantle.party.Party">
            <key-map field-name="assignedToPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="FixedAsset" description="Fixed Asset Status"/>
            <moqui.basic.StatusItem statusId="FaActive" statusTypeId="FixedAsset" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="FaUnderMaintenance" statusTypeId="FixedAsset" description="Under Maintenance" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="FaFullyDepreciated" statusTypeId="FixedAsset" description="Fully Depreciated" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="FaDisposed" statusTypeId="FixedAsset" description="Disposed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="FaScrapped" statusTypeId="FixedAsset" description="Scrapped" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaUnderMaintenance" transitionName="Send for Maintenance"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaUnderMaintenance" toStatusId="FaActive" transitionName="Back to Active"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaFullyDepreciated" transitionName="Fully Depreciated"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaDisposed" transitionName="Dispose"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaScrapped" transitionName="Scrap"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaFullyDepreciated" toStatusId="FaDisposed" transitionName="Dispose"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaFullyDepreciated" toStatusId="FaScrapped" transitionName="Scrap"/>
        </seed-data>
    </entity>

    <!-- ========== Depreciation Schedule Entry ========== -->
    <entity entity-name="DepreciationEntry" package="zenith.erp.assets" short-alias="DepreciationEntry">
        <field name="depreciationEntryId" type="id" is-pk="true"/>
        <field name="fixedAssetId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="openingBookValue" type="currency-amount"/>
        <field name="depreciationAmount" type="currency-amount"/>
        <field name="accumulatedDepreciation" type="currency-amount"/>
        <field name="closingBookValue" type="currency-amount"/>
        <field name="depreciationRate" type="number-decimal"/>
        <field name="isPostedToGl" type="text-indicator" default="'N'"/>
        <field name="glJournalEntryId" type="id"/>
        <field name="calculatedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.assets.FixedAsset" short-alias="fixedAsset"/>
    </entity>

    <!-- ========== Asset Maintenance Log ========== -->
    <entity entity-name="AssetMaintenanceLog" package="zenith.erp.assets" short-alias="AssetMaintenanceLog">
        <field name="maintenanceLogId" type="id" is-pk="true"/>
        <field name="fixedAssetId" type="id"/>
        <field name="maintenanceDate" type="date"/>
        <field name="maintenanceType" type="text-short"/>
        <field name="description" type="text-medium"/>
        <field name="cost" type="currency-amount"/>
        <field name="vendorPartyId" type="id"/>
        <field name="nextMaintenanceDate" type="date"/>
        <relationship type="one" related="zenith.erp.assets.FixedAsset" short-alias="fixedAsset"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="FixedAssetView" package="zenith.erp.assets">
        <member-entity entity-alias="FA" entity-name="zenith.erp.assets.FixedAsset"/>
        <member-entity entity-alias="CAT" entity-name="zenith.erp.assets.FixedAssetCategory" join-from-alias="FA">
            <key-map field-name="categoryId"/></member-entity>
        <member-entity entity-alias="FAC" entity-name="mantle.facility.Facility" join-from-alias="FA" join-optional="true">
            <key-map field-name="facilityId"/></member-entity>
        <alias entity-alias="FA" name="fixedAssetId"/>
        <alias entity-alias="FA" name="assetName"/>
        <alias entity-alias="FA" name="assetCode"/>
        <alias entity-alias="FA" name="categoryId"/>
        <alias entity-alias="FA" name="statusId"/>
        <alias entity-alias="FA" name="purchaseDate"/>
        <alias entity-alias="FA" name="purchaseAmount"/>
        <alias entity-alias="FA" name="currentBookValue"/>
        <alias entity-alias="FA" name="accumulatedDepreciation"/>
        <alias entity-alias="FA" name="serialNumber"/>
        <alias entity-alias="FA" name="location"/>
        <alias entity-alias="FA" name="depreciationMethodEnumId"/>
        <alias entity-alias="FA" name="usefulLifeMonths"/>
        <alias entity-alias="FA" name="lastDepreciationDate"/>
        <alias entity-alias="CAT" name="categoryName"/>
        <alias entity-alias="FAC" name="facilityName"/>
    </view-entity>

</entities>
