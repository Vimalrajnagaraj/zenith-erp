<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Asset Detail" default-menu-index="3">

    <parameter name="fixedAssetId" required="true"/>

    <transition name="updateAsset"><service-call name="zenith.assets.FixedAssetServices.update#FixedAsset"/>
        <default-response url="."/></transition>
    <transition name="disposeAsset"><service-call name="zenith.assets.FixedAssetServices.dispose#FixedAsset"/>
        <default-response url="."/></transition>
    <transition name="calcDep"><service-call name="zenith.assets.FixedAssetServices.calculate#Depreciation"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.assets.FixedAsset" value-field="fa"/>
        <entity-find-one entity-name="zenith.erp.assets.FixedAssetCategory" value-field="cat">
            <field-map field-name="categoryId" from="fa.categoryId"/>
        </entity-find-one>

        <!-- Depreciation history -->
        <entity-find entity-name="zenith.erp.assets.DepreciationEntry" list="depHistory">
            <econdition field-name="fixedAssetId"/>
            <order-by field-name="-periodEnd"/>
        </entity-find>

        <!-- Maintenance history -->
        <entity-find entity-name="zenith.erp.assets.AssetMaintenanceLog" list="maintenanceLogs">
            <econdition field-name="fixedAssetId"/>
            <order-by field-name="-maintenanceDate"/>
        </entity-find>

        <set field="depPercent" from="fa.purchaseAmount ? ((fa.accumulatedDepreciation ?: 0) / fa.purchaseAmount * 100).intValue() : 0"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="${fa.assetName}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="${fa.assetCode ?: ''} | ${cat?.categoryName ?: ''}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-sm">
                <link url="../FindFixedAsset" text="Back to Register" icon="fa fa-arrow-left" btn-type="info" style="q-btn--dense"/>
            </container>
        </container>

        <!-- Status & Summary Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Status" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="" style="q-badge bg-${fa.statusId == 'FaActive' ? 'positive' : fa.statusId == 'FaFullyDepreciated' ? 'warning' : 'negative'} text-white q-pa-sm text-weight-bold"/>
                    <render-mode><text type="html,vuet,qvt"><![CDATA[
                        <div class="q-badge bg-${fa.statusId == 'FaActive' ? 'positive' : fa.statusId == 'FaFullyDepreciated' ? 'warning' : 'negative'} text-white q-pa-sm text-weight-bold q-mt-sm" style="font-size: 1rem;">
                            ${ec.entity.find('moqui.basic.StatusItem').condition('statusId', fa.statusId).one()?.description ?: fa.statusId}
                        </div>
                    ]]></text></render-mode>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Purchase Cost" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(fa.purchaseAmount ?: 0, '#,##,##0.00'))}" type="h4" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Book Value" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(fa.currentBookValue ?: 0, '#,##,##0.00'))}" type="h4" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Depreciated" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${depPercent}%" type="h4" style="${depPercent >= 100 ? 'text-negative' : depPercent >= 75 ? 'text-warning' : 'text-positive'} text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="8">
                <!-- Asset Details Form -->
                <container-box><box-header title="Asset Details"/><box-body>
                    <form-single name="UpdateAssetForm" transition="updateAsset" map="fa">
                        <field name="fixedAssetId"><default-field><hidden/></default-field></field>
                        <field name="assetName"><default-field title="Asset Name"><text-line size="40"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="false">
                                <entity-options key="${categoryId}" text="${categoryName}">
                                    <entity-find entity-name="zenith.erp.assets.FixedAssetCategory">
                                        <econdition field-name="isActive" value="Y"/>
                                        <order-by field-name="categoryName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="serialNumber"><default-field title="Serial Number"><text-line size="20"/></default-field></field>
                        <field name="modelNumber"><default-field title="Model"><text-line size="20"/></default-field></field>
                        <field name="manufacturer"><default-field title="Manufacturer"><text-line size="30"/></default-field></field>
                        <field name="warrantyExpiryDate"><default-field title="Warranty Expiry"><date-time type="date"/></default-field></field>
                        <field name="location"><default-field title="Location"><text-line size="30"/></default-field></field>
                        <field name="facilityId"><default-field title="Facility">
                            <drop-down allow-empty="true">
                                <entity-options key="${facilityId}" text="${facilityName}">
                                    <entity-find entity-name="mantle.facility.Facility">
                                        <order-by field-name="facilityName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Notes"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down allow-empty="false">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="FixedAsset"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Update Asset"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>

            <row-col lg="4">
                <!-- Depreciation Info -->
                <container-box><box-header title="Depreciation Configuration"/><box-body>
                    <container style="q-pa-sm">
                        <label text="Method:" style="text-weight-bold"/> <label text=" "/>
                        <label text="" style=""/>
                        <render-mode><text type="html,vuet,qvt"><![CDATA[
                            <div class="q-mb-sm"><strong>Method:</strong> ${ec.entity.find('moqui.basic.Enumeration').condition('enumId', fa.depreciationMethodEnumId).one()?.description ?: 'N/A'}</div>
                            <div class="q-mb-sm"><strong>Useful Life:</strong> ${fa.usefulLifeMonths ?: 0} months (${((fa.usefulLifeMonths ?: 0) / 12.0).setScale(1, java.math.RoundingMode.HALF_UP)} years)</div>
                            <div class="q-mb-sm"><strong>Salvage Value:</strong> ${currSymbol}${zinr.inr(ec.l10n.format(fa.salvageValue ?: 0, '#,##0.00'))}</div>
                            <div class="q-mb-sm"><strong>Start Date:</strong> ${fa.depreciationStartDate ? ec.l10n.format(fa.depreciationStartDate, 'dd-MMM-yyyy') : 'N/A'}</div>
                            <div class="q-mb-sm"><strong>Last Run:</strong> ${fa.lastDepreciationDate ? ec.l10n.format(fa.lastDepreciationDate, 'dd-MMM-yyyy') : 'Never'}</div>
                            <div class="q-mb-sm"><strong>Acc. Depreciation:</strong> ${currSymbol}${zinr.inr(ec.l10n.format(fa.accumulatedDepreciation ?: 0, '#,##0.00'))}</div>
                        ]]></text></render-mode>
                    </container>
                </box-body></container-box>

                <!-- Quick Actions -->
                <section name="ActiveActions" condition="fa.statusId == 'FaActive' || fa.statusId == 'FaUnderMaintenance'"><widgets>
                    <container-box><box-header title="Actions"/><box-body>
                        <container-dialog id="CalcDepDialog" button-text="Calculate Depreciation" width="400"
                                          button-class="full-width q-mb-sm q-btn q-btn--standard bg-warning text-white text-weight-bold">
                            <form-single name="CalcDepForm" transition="calcDep">
                                <field name="fixedAssetId"><default-field><hidden/></default-field></field>
                                <field name="periodEnd"><default-field title="Period End Date"><date-time type="date"/></default-field></field>
                                <field name="submitButton"><default-field title="Calculate"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>

                        <container-dialog id="DisposeDialog" button-text="Dispose Asset" width="400"
                                          button-class="full-width q-btn q-btn--standard bg-negative text-white text-weight-bold">
                            <form-single name="DisposeForm" transition="disposeAsset">
                                <field name="fixedAssetId"><default-field><hidden/></default-field></field>
                                <field name="disposalDate"><default-field title="Disposal Date"><date-time type="date"/></default-field></field>
                                <field name="disposalAmount"><default-field title="Sale Amount"><text-line size="15"/></default-field></field>
                                <field name="disposalMethod"><default-field title="Method">
                                    <drop-down allow-empty="false">
                                        <option key="Sold" text="Sold"/>
                                        <option key="Scrapped" text="Scrapped"/>
                                        <option key="Donated" text="Donated"/>
                                        <option key="TradeIn" text="Trade-In"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="submitButton"><default-field title="Dispose"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-body></container-box>
                </widgets></section>
            </row-col>
        </container-row>

        <!-- Depreciation History -->
        <container-box><box-header title="Depreciation History"/><box-body>
            <form-list name="DepHistoryList" list="depHistory" skip-form="true" show-csv-button="true">
                <field name="periodEnd"><default-field title="Period End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="openingBookValue"><default-field title="Opening Value"><display format="#,##,##0.00"/></default-field></field>
                <field name="depreciationAmount"><default-field title="Depreciation"><display format="#,##,##0.00"/></default-field></field>
                <field name="accumulatedDepreciation"><default-field title="Acc. Dep."><display format="#,##,##0.00"/></default-field></field>
                <field name="closingBookValue"><default-field title="Closing Value"><display format="#,##,##0.00"/></default-field></field>
                <field name="depreciationRate"><default-field title="Rate %"><display format="#0.00"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
