<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <!-- Count assets by status -->
        <entity-find-count entity-name="zenith.erp.assets.FixedAsset" count-field="totalAssets"/>
        <entity-find-count entity-name="zenith.erp.assets.FixedAsset" count-field="activeAssets">
            <econdition field-name="statusId" value="FaActive"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.assets.FixedAsset" count-field="depreciatedAssets">
            <econdition field-name="statusId" value="FaFullyDepreciated"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.assets.FixedAsset" count-field="disposedAssets">
            <econdition field-name="statusId" operator="in" value="FaDisposed,FaScrapped"/></entity-find-count>

        <!-- Total purchase value & book value -->
        <entity-find entity-name="zenith.erp.assets.FixedAsset" list="allAssets">
            <econdition field-name="statusId" operator="in" value="FaActive,FaUnderMaintenance,FaFullyDepreciated"/>
        </entity-find>
        <set field="totalPurchaseValue" from="0" type="BigDecimal"/>
        <set field="totalBookValue" from="0" type="BigDecimal"/>
        <set field="totalAccDep" from="0" type="BigDecimal"/>
        <script>
            for (def a : allAssets) {
                totalPurchaseValue += (a.purchaseAmount ?: 0)
                totalBookValue += (a.currentBookValue ?: 0)
                totalAccDep += (a.accumulatedDepreciation ?: 0)
            }
        </script>

        <!-- Recent depreciation entries -->
        <entity-find entity-name="zenith.erp.assets.DepreciationEntry" list="recentDepEntries" limit="5">
            <order-by field-name="-calculatedDate"/>
        </entity-find>

        <!-- Assets needing maintenance (warranty expiring soon) -->
        <set field="thirtyDaysLater" from="new java.sql.Date(System.currentTimeMillis() + (30L * 86400000L))"/>
        <entity-find entity-name="zenith.erp.assets.FixedAsset" list="warrantyExpiring">
            <econdition field-name="statusId" value="FaActive"/>
            <econdition field-name="warrantyExpiryDate" operator="less-equals" from="thirtyDaysLater"/>
            <econdition field-name="warrantyExpiryDate" operator="greater-equals" from="new java.sql.Date(System.currentTimeMillis())"/>
            <order-by field-name="warrantyExpiryDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Fixed Assets Dashboard" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Capital asset management &amp; depreciation tracking" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-sm">
                <link url="../FindFixedAsset" text="Asset Register" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
                <link url="../DepreciationRegister" text="Run Depreciation" icon="fa fa-calculator" btn-type="warning" style="q-btn--dense"/>
            </container>
        </container>

        <!-- KPI Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-xl q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="TOTAL ASSETS" type="p" style="text-grey-7 q-my-none text-weight-bold text-caption"/>
                            <label text="${totalAssets ?: 0}" type="h3" style="text-primary text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <render-mode><text type="html"><![CDATA[<q-icon name="account_balance" class="text-h2 text-primary"/>]]></text></render-mode>
                    </container>
                    <label text="Active: ${activeAssets ?: 0}" type="p" style="text-grey-6 q-mb-none q-mt-sm"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-xl q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="GROSS VALUE" type="p" style="text-grey-7 q-my-none text-weight-bold text-caption"/>
                            <label text="${currSymbol}${zinr.inr(ec.l10n.format(totalPurchaseValue, '#,##,##0'))}" type="h4" style="text-positive text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <render-mode><text type="html"><![CDATA[<q-icon name="paid" class="text-h2 text-positive"/>]]></text></render-mode>
                    </container>
                    <label text="Original purchase value" type="p" style="text-grey-6 q-mb-none q-mt-sm"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-xl q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="NET BOOK VALUE" type="p" style="text-grey-7 q-my-none text-weight-bold text-caption"/>
                            <label text="${currSymbol}${zinr.inr(ec.l10n.format(totalBookValue, '#,##,##0'))}" type="h4" style="text-info text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <render-mode><text type="html"><![CDATA[<q-icon name="trending_down" class="text-h2 text-info"/>]]></text></render-mode>
                    </container>
                    <label text="After depreciation" type="p" style="text-grey-6 q-mb-none q-mt-sm"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-xl q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="TOTAL DEPRECIATION" type="p" style="text-grey-7 q-my-none text-weight-bold text-caption"/>
                            <label text="${currSymbol}${zinr.inr(ec.l10n.format(totalAccDep, '#,##,##0'))}" type="h4" style="text-warning text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <render-mode><text type="html"><![CDATA[<q-icon name="schedule" class="text-h2 text-warning"/>]]></text></render-mode>
                    </container>
                    <label text="Accumulated to date" type="p" style="text-grey-6 q-mb-none q-mt-sm"/>
                </container>
            </row-col>
        </container-row>

        <!-- Warranty Expiring Soon -->
        <section name="WarrantySection" condition="warrantyExpiring"><widgets>
            <container-box><box-header title="Warranty Expiring Soon"/><box-body>
                <form-list name="WarrantyList" list="warrantyExpiring" skip-form="true">
                    <field name="assetCode"><default-field title="Code"><display/></default-field></field>
                    <field name="assetName"><default-field title="Asset"><display/></default-field></field>
                    <field name="warrantyExpiryDate"><default-field title="Warranty Expires"><display format="dd-MMM-yyyy"/></default-field></field>
                </form-list>
            </box-body></container-box>
        </widgets></section>

        <container style="q-mt-lg bg-indigo-9 text-white shadow-6 text-center q-pa-xl">
            <label text="Manage Your Capital Assets" type="h4" style="text-weight-bold q-mb-md text-indigo-1"/>
            <label text="Track purchases, calculate depreciation (SLM/WDV), manage disposals, and generate compliance-ready asset registers." type="p" style="text-subtitle1 text-indigo-2 q-mb-xl"/>
            <link url="../FindFixedAsset" text="View Asset Register" style="q-btn q-btn--standard bg-white text-indigo-9 text-weight-bold q-px-xl q-py-sm"/>
        </container>
    </widgets>
</screen>
