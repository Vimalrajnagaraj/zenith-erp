<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Asset Register" default-menu-index="2">

    <transition name="createAsset"><service-call name="zenith.assets.FixedAssetServices.create#FixedAsset"/>
        <default-response url="../EditFixedAsset"/></transition>
    <transition name="editAsset"><default-response url="../EditFixedAsset"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.assets.FixedAssetView" list="assetList">
            <search-form-inputs default-order-by="-purchaseDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Fixed Asset Register" type="h3" style="text-primary text-weight-bold q-my-none"/>
            </container>
            <container-dialog id="CreateAssetDialog" button-text="Add Asset" width="800"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="CreateAssetForm" transition="createAsset">
                    <field name="assetName"><default-field title="Asset Name"><text-line size="40"/></default-field></field>
                    <field name="categoryId"><default-field title="Category">
                        <drop-down allow-empty="false">
                            <entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.assets.FixedAssetCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                    <order-by field-name="categoryName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="purchaseDate"><default-field title="Purchase Date"><date-time type="date"/></default-field></field>
                    <field name="purchaseAmount"><default-field title="Purchase Amount"><text-line size="15"/></default-field></field>
                    <field name="serialNumber"><default-field title="Serial Number"><text-line size="20"/></default-field></field>
                    <field name="manufacturer"><default-field title="Manufacturer"><text-line size="30"/></default-field></field>
                    <field name="location"><default-field title="Location"><text-line size="30"/></default-field></field>
                    <field name="facilityId"><default-field title="Facility">
                        <drop-down allow-empty="true">
                            <entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility">
                                    <order-by field-name="facilityName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field title="Description"><text-area rows="3" cols="50"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Asset"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="AssetListForm" list="assetList" transition="editAsset" skip-form="true"
                       header-dialog="true" select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true"
                       show-all-button="true">
                <field name="fixedAssetId"><header-field show-order-by="true"/>
                    <default-field><hidden/></default-field></field>
                <field name="assetCode"><header-field title="Code" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field title="Code"><link url="editAsset" text="${assetCode}" link-type="anchor"
                                                      parameter-map="[fixedAssetId:fixedAssetId]"/></default-field></field>
                <field name="assetName"><header-field title="Asset Name" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field title="Asset Name"><display/></default-field></field>
                <field name="categoryName"><header-field title="Category" show-order-by="true"/>
                    <default-field title="Category"><display/></default-field></field>
                <field name="statusId"><header-field title="Status" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                        <entity-find entity-name="moqui.basic.StatusItem">
                            <econdition field-name="statusTypeId" value="FixedAsset"/></entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem" text="${description}"/></default-field></field>
                <field name="purchaseDate"><header-field title="Purchase Date" show-order-by="true"><date-period/></header-field>
                    <default-field title="Purchased"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="purchaseAmount"><header-field title="Cost" show-order-by="true"/>
                    <default-field title="Cost"><display format="#,##,##0.00"/></default-field></field>
                <field name="currentBookValue"><header-field title="Book Value" show-order-by="true"/>
                    <default-field title="Book Value"><display format="#,##,##0.00"/></default-field></field>
                <field name="accumulatedDepreciation"><header-field title="Acc. Dep." show-order-by="true"/>
                    <default-field title="Acc. Dep."><display format="#,##,##0.00"/></default-field></field>
                <field name="facilityName"><header-field title="Location"/>
                    <default-field title="Location"><display/></default-field></field>
                <field name="searchButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
