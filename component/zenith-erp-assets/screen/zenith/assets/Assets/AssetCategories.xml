<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Categories" default-menu-index="5">

    <transition name="createCategory"><service-call name="create#zenith.erp.assets.FixedAssetCategory"/>
        <default-response url="."/></transition>
    <transition name="updateCategory"><service-call name="update#zenith.erp.assets.FixedAssetCategory"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.assets.FixedAssetCategory" list="categoryList">
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Asset Categories" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <container-dialog id="CreateCatDialog" button-text="Add Category" width="600"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="CreateCatForm" transition="createCategory">
                    <field name="categoryName"><default-field title="Category Name"><text-line size="30"/></default-field></field>
                    <field name="depreciationMethodEnumId"><default-field title="Depreciation Method">
                        <drop-down allow-empty="true">
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="DepreciationMethod"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="defaultUsefulLifeMonths"><default-field title="Useful Life (Months)"><text-line size="8"/></default-field></field>
                    <field name="defaultSalvagePercent"><default-field title="Salvage Value %"><text-line size="8"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="CategoryListForm" list="categoryList" transition="updateCategory" multi="true">
                <field name="categoryId"><default-field><hidden/></default-field></field>
                <field name="categoryName"><default-field title="Category"><text-line size="20"/></default-field></field>
                <field name="depreciationMethodEnumId"><default-field title="Method">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="DepreciationMethod"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="defaultUsefulLifeMonths"><default-field title="Life (Months)"><text-line size="6"/></default-field></field>
                <field name="defaultSalvagePercent"><default-field title="Salvage %"><text-line size="6"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down allow-empty="false"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
