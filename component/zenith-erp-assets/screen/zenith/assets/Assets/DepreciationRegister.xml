<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Depreciation Register" default-menu-index="4">

    <transition name="runDepreciation">
        <service-call name="zenith.assets.FixedAssetServices.run#MonthlyDepreciation"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Get all depreciation entries -->
        <entity-find entity-name="zenith.erp.assets.DepreciationEntry" list="allEntries">
            <order-by field-name="-periodEnd,-calculatedDate"/>
        </entity-find>

        <!-- Summary by category -->
        <entity-find entity-name="zenith.erp.assets.FixedAsset" list="activeAssets">
            <econdition field-name="statusId" operator="in" value="FaActive,FaUnderMaintenance,FaFullyDepreciated"/>
        </entity-find>

        <script><![CDATA[
            def catSummary = [:]
            for (def a : activeAssets) {
                def cId = a.categoryId ?: 'Uncategorized'
                if (!catSummary[cId]) {
                    def catName = cId
                    try {
                        def catEntity = ec.entity.find("zenith.erp.assets.FixedAssetCategory").condition("categoryId", cId).one()
                        catName = catEntity?.categoryName ?: cId
                    } catch (Exception e) {}
                    catSummary[cId] = [categoryName: catName, count: 0, grossValue: 0.0, accDep: 0.0, bookValue: 0.0]
                }
                catSummary[cId].count++
                catSummary[cId].grossValue += (a.purchaseAmount ?: 0)
                catSummary[cId].accDep += (a.accumulatedDepreciation ?: 0)
                catSummary[cId].bookValue += (a.currentBookValue ?: 0)
            }
            categorySummaryList = catSummary.values().toList().sort { a, b -> b.grossValue <=> a.grossValue }
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Depreciation Register" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Monthly depreciation calculation &amp; history" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container-dialog id="RunDepDialog" button-text="Run Monthly Depreciation" width="500"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-warning text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="RunDepForm" transition="runDepreciation">
                    <field name="periodEnd"><default-field title="Period End Date">
                        <date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Run Depreciation for All Assets"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- Category-wise Summary -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg">
            <label text="Depreciation Summary by Category" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="CategorySummaryList" list="categorySummaryList" skip-form="true" show-csv-button="true">
                <field name="categoryName"><default-field title="Category"><display/></default-field></field>
                <field name="count"><default-field title="Assets"><display/></default-field></field>
                <field name="grossValue"><default-field title="Gross Value"><display format="#,##,##0.00"/></default-field></field>
                <field name="accDep"><default-field title="Acc. Depreciation"><display format="#,##,##0.00"/></default-field></field>
                <field name="bookValue"><default-field title="Net Book Value"><display format="#,##,##0.00"/></default-field></field>
            </form-list>
        </container>

        <!-- Depreciation Entries -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <label text="Depreciation Entries" type="h5" style="text-weight-bold q-mb-md"/>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Depreciation Register..." style="display:none"></span>]]></text></render-mode>
            <form-list name="DepEntriesList" list="allEntries" skip-form="true"
                       header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-all-button="true">
                <field name="fixedAssetId"><header-field title="Asset" show-order-by="true"/>
                    <default-field title="Asset">
                        <display-entity entity-name="zenith.erp.assets.FixedAsset" text="${assetCode} - ${assetName}"/>
                    </default-field></field>
                <field name="periodEnd"><header-field title="Period End" show-order-by="true"><date-period/></header-field>
                    <default-field title="Period End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="openingBookValue"><default-field title="Opening"><display format="#,##,##0.00"/></default-field></field>
                <field name="depreciationAmount"><default-field title="Depreciation"><display format="#,##,##0.00"/></default-field></field>
                <field name="accumulatedDepreciation"><default-field title="Acc. Dep."><display format="#,##,##0.00"/></default-field></field>
                <field name="closingBookValue"><default-field title="Closing"><display format="#,##,##0.00"/></default-field></field>
                <field name="depreciationRate"><default-field title="Rate %"><display format="#0.00"/></default-field></field>
                <field name="searchButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
