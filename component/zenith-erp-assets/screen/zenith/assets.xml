<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Fixed Assets" default-menu-index="20">

    <always-actions>
        <set field="html_title" value="Fixed Assets"/>
    </always-actions>

    <subscreens default-item="AssetDashboard">
        <subscreens-item name="AssetDashboard" location="component://zenith-erp-assets/screen/zenith/assets/Assets/AssetDashboard.xml"/>
        <subscreens-item name="FindFixedAsset" location="component://zenith-erp-assets/screen/zenith/assets/Assets/FindFixedAsset.xml" menu-title="Asset Register"/>
        <subscreens-item name="EditFixedAsset" location="component://zenith-erp-assets/screen/zenith/assets/Assets/EditFixedAsset.xml" menu-title="Asset Detail" menu-include="false"/>
        <subscreens-item name="DepreciationRegister" location="component://zenith-erp-assets/screen/zenith/assets/Assets/DepreciationRegister.xml" menu-title="Depreciation Register"/>
        <subscreens-item name="AssetCategories" location="component://zenith-erp-assets/screen/zenith/assets/Assets/AssetCategories.xml" menu-title="Categories"/>
    </subscreens>

    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
