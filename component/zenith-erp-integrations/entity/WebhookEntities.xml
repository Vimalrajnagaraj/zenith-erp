<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="WebhookSubscription" package="zenith.erp.integrations.webhook">
        <field name="subscriptionId" type="id" is-pk="true"/>
        <field name="topic" type="text-medium"/>
        <field name="endpointUrl" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
        <field name="secretKey" type="text-medium"/>
    </entity>

    <entity entity-name="WebhookLog" package="zenith.erp.integrations.webhook">
        <field name="logId" type="id" is-pk="true"/>
        <field name="subscriptionId" type="id"/>
        <field name="topic" type="text-medium"/>
        <field name="endpointUrl" type="text-medium"/>
        <field name="payload" type="text-long"/>
        <field name="responseCode" type="number-integer"/>
        <field name="responseMessage" type="text-long"/>
        <field name="isSuccess" type="text-indicator"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.integrations.webhook.WebhookSubscription"/>
    </entity>

</entities>
