        <field name="cancelReason" type="text-medium"/>
        <field name="generatedDate" type="date-time"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Ewaybill" description="E-Way Bill"/>
            <moqui.basic.StatusItem statusId="EwPending" statusTypeId="Ewaybill" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EwGenerated" statusTypeId="Ewaybill" description="Generated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EwCancelled" statusTypeId="Ewaybill" description="Cancelled" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EwExpired" statusTypeId="Ewaybill" description="Expired" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="EwFailed" statusTypeId="Ewaybill" description="Failed" sequenceNum="5"/>
