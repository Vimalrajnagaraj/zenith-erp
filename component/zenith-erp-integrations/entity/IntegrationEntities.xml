<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- API Portal Configuration -->
    <entity entity-name="ApiPortalConfig" package="zenith.erp.integrations" short-alias="ApiPortalConfigs">
        <field name="portalConfigId" type="id" is-pk="true"/>
        <field name="portalType" type="id"/>
        <field name="portalName" type="text-medium"/>
        <field name="environment" type="id"/>
        <field name="baseUrl" type="text-medium"/>
        <field name="authUrl" type="text-medium"/>
        <field name="clientId" type="text-medium"/>
        <field name="clientSecret" type="text-medium"/>
        <field name="username" type="text-medium"/>
        <field name="password" type="text-medium"/>
        <field name="gstin" type="text-short"/>
        <field name="organizationPartyId" type="id"/>
        <field name="apiVersion" type="text-short"/>
        <field name="timeoutMs" type="number-integer" default="30000"/>
        <field name="retryCount" type="number-integer" default="3"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="lastTestedDate" type="date-time"/>
        <field name="lastTestResult" type="text-medium"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ApiPortalType" description="API Portal Type"/>
            <moqui.basic.Enumeration enumId="ApGstEinvoice" enumTypeId="ApiPortalType" description="GST E-Invoice (IRP/NIC)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="ApGstEwaybill" enumTypeId="ApiPortalType" description="GST E-Way Bill (NIC)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="ApGstReturns" enumTypeId="ApiPortalType" description="GST Returns Portal" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="ApGstinVerify" enumTypeId="ApiPortalType" description="GSTIN Verification" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="ApIncomeTax" enumTypeId="ApiPortalType" description="Income Tax (TDS/TCS)" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="ApEpfo" enumTypeId="ApiPortalType" description="EPFO (Provident Fund)" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="ApEsic" enumTypeId="ApiPortalType" description="ESIC (Employee Insurance)" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="ApRazorpay" enumTypeId="ApiPortalType" description="Razorpay Payment Gateway" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="ApBankApi" enumTypeId="ApiPortalType" description="Banking API" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="ApSmsGateway" enumTypeId="ApiPortalType" description="SMS Gateway" sequenceNum="10"/>

            <moqui.basic.EnumerationType enumTypeId="ApiEnvironment" description="API Environment"/>
            <moqui.basic.Enumeration enumId="EnvSandbox" enumTypeId="ApiEnvironment" description="Sandbox / Testing" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="EnvProduction" enumTypeId="ApiEnvironment" description="Production" sequenceNum="2"/>
        </seed-data>
    </entity>

    <!-- API Auth Token (OAuth/session tokens) -->
    <entity entity-name="ApiAuthToken" package="zenith.erp.integrations" short-alias="ApiAuthTokens">
        <field name="tokenId" type="id" is-pk="true"/>
        <field name="portalConfigId" type="id"/>
        <field name="tokenType" type="text-short"/>
        <field name="accessToken" type="text-long"/>
        <field name="refreshToken" type="text-long"/>
        <field name="tokenExpiry" type="date-time"/>
        <field name="sessionId" type="text-medium"/>
        <field name="issuedDate" type="date-time"/>
        <field name="isValid" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.integrations.ApiPortalConfig"/>
    </entity>

    <!-- API Request Log -->
    <entity entity-name="ApiRequestLog" package="zenith.erp.integrations" short-alias="ApiRequestLogs">
        <field name="requestLogId" type="id" is-pk="true"/>
        <field name="portalConfigId" type="id"/>
        <field name="requestType" type="id"/>
        <field name="httpMethod" type="text-short"/>
        <field name="requestUrl" type="text-medium"/>
        <field name="requestHeaders" type="text-long"/>
        <field name="requestBody" type="text-very-long"/>
        <field name="responseCode" type="number-integer"/>
        <field name="responseHeaders" type="text-long"/>
        <field name="responseBody" type="text-very-long"/>
        <field name="responseTimeMs" type="number-integer"/>
        <field name="statusId" type="id"/>
        <field name="errorMessage" type="text-long"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="requestDate" type="date-time"/>
        <field name="requestByPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.integrations.ApiPortalConfig"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ApiRequestType" description="API Request Type"/>
            <moqui.basic.Enumeration enumId="RtAuth" enumTypeId="ApiRequestType" description="Authentication" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RtEinvGenerate" enumTypeId="ApiRequestType" description="E-Invoice Generate IRN" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RtEinvCancel" enumTypeId="ApiRequestType" description="E-Invoice Cancel" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RtEinvGetByIrn" enumTypeId="ApiRequestType" description="E-Invoice Get by IRN" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RtEwbGenerate" enumTypeId="ApiRequestType" description="E-Way Bill Generate" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="RtEwbCancel" enumTypeId="ApiRequestType" description="E-Way Bill Cancel" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="RtEwbUpdate" enumTypeId="ApiRequestType" description="E-Way Bill Update Vehicle" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="RtEwbConsolidate" enumTypeId="ApiRequestType" description="E-Way Bill Consolidate" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="RtGstr1Upload" enumTypeId="ApiRequestType" description="GSTR-1 Upload" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="RtGstr1File" enumTypeId="ApiRequestType" description="GSTR-1 File" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="RtGstr3bUpload" enumTypeId="ApiRequestType" description="GSTR-3B Upload" sequenceNum="11"/>
            <moqui.basic.Enumeration enumId="RtGstr3bFile" enumTypeId="ApiRequestType" description="GSTR-3B File" sequenceNum="12"/>
            <moqui.basic.Enumeration enumId="RtGstr2bDownload" enumTypeId="ApiRequestType" description="GSTR-2B Download" sequenceNum="13"/>
            <moqui.basic.Enumeration enumId="RtGstinVerify" enumTypeId="ApiRequestType" description="GSTIN Verify" sequenceNum="14"/>
            <moqui.basic.Enumeration enumId="RtPanVerify" enumTypeId="ApiRequestType" description="PAN Verify" sequenceNum="15"/>
            <moqui.basic.Enumeration enumId="RtTdsReturn" enumTypeId="ApiRequestType" description="TDS Return Filing" sequenceNum="16"/>
            <moqui.basic.Enumeration enumId="RtEpfEcr" enumTypeId="ApiRequestType" description="EPF ECR Upload" sequenceNum="17"/>
            <moqui.basic.Enumeration enumId="RtEsiReturn" enumTypeId="ApiRequestType" description="ESI Return Filing" sequenceNum="18"/>
            <moqui.basic.Enumeration enumId="RtPayment" enumTypeId="ApiRequestType" description="Payment Gateway" sequenceNum="19"/>

            <moqui.basic.StatusType statusTypeId="ApiRequest" description="API Request"/>
            <moqui.basic.StatusItem statusId="ArqPending" statusTypeId="ApiRequest" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="ArqSuccess" statusTypeId="ApiRequest" description="Success" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="ArqFailed" statusTypeId="ApiRequest" description="Failed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="ArqTimeout" statusTypeId="ApiRequest" description="Timeout" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="ArqRetrying" statusTypeId="ApiRequest" description="Retrying" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- E-Invoice Record (extends india component conceptually) -->
    <entity entity-name="EinvoiceRecord" package="zenith.erp.integrations" short-alias="EinvoiceRecords">
        <field name="einvoiceId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="gstin" type="text-short"/>
        <field name="irn" type="text-long"/>
        <field name="ackNumber" type="text-medium"/>
        <field name="ackDate" type="date-time"/>
        <field name="signedQrCode" type="text-very-long"/>
        <field name="signedInvoice" type="text-very-long"/>
        <field name="requestPayload" type="text-very-long"/>
        <field name="responsePayload" type="text-very-long"/>
        <field name="statusId" type="id"/>
        <field name="cancelReason" type="text-medium"/>
        <field name="cancelDate" type="date-time"/>
        <field name="errorCode" type="text-short"/>
        <field name="errorMessage" type="text-long"/>
        <field name="generatedDate" type="date-time"/>
        <field name="generatedByPartyId" type="id"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Einvoice" description="E-Invoice"/>
            <moqui.basic.StatusItem statusId="EiPending" statusTypeId="Einvoice" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EiGenerated" statusTypeId="Einvoice" description="IRN Generated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EiCancelled" statusTypeId="Einvoice" description="Cancelled" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EiFailed" statusTypeId="Einvoice" description="Failed" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EiPending" toStatusId="EiGenerated" transitionName="Generate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EiPending" toStatusId="EiFailed" transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EiGenerated" toStatusId="EiCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EiFailed" toStatusId="EiPending" transitionName="Retry"/>
        </seed-data>
    </entity>

    <!-- E-Way Bill Record -->
