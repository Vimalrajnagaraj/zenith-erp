            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EwGenerated" toStatusId="EwCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EwGenerated" toStatusId="EwExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EwPending" toStatusId="EwFailed" transitionName="Fail"/>
        </seed-data>
    </entity>

    <!-- GST Return Filing Record -->
    <entity entity-name="GstReturnFiling" package="zenith.erp.integrations" short-alias="GstReturnFilings">
        <field name="filingId" type="id" is-pk="true"/>
        <field name="gstin" type="text-short"/>
        <field name="returnType" type="id"/>
        <field name="financialYear" type="text-short"/>
        <field name="returnPeriod" type="text-short"/>
        <field name="filingDate" type="date-time"/>
        <field name="referenceNumber" type="text-medium"/>
        <field name="jsonPayload" type="text-very-long"/>
        <field name="uploadResponse" type="text-very-long"/>
        <field name="filingResponse" type="text-very-long"/>
        <field name="statusId" type="id"/>
        <field name="errorMessage" type="text-long"/>
        <field name="filedByPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="GstReturnType" description="GST Return Type"/>
            <moqui.basic.Enumeration enumId="GrGstr1" enumTypeId="GstReturnType" description="GSTR-1 (Outward Supplies)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="GrGstr3b" enumTypeId="GstReturnType" description="GSTR-3B (Summary Return)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="GrGstr2b" enumTypeId="GstReturnType" description="GSTR-2B (Auto-drafted ITC)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="GrGstr9" enumTypeId="GstReturnType" description="GSTR-9 (Annual Return)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="GrGstr9c" enumTypeId="GstReturnType" description="GSTR-9C (Reconciliation)" sequenceNum="5"/>

            <moqui.basic.StatusType statusTypeId="GstFiling" description="GST Return Filing"/>
            <moqui.basic.StatusItem statusId="GfDraft" statusTypeId="GstFiling" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="GfGenerated" statusTypeId="GstFiling" description="JSON Generated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="GfUploaded" statusTypeId="GstFiling" description="Uploaded to Portal" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="GfFiled" statusTypeId="GstFiling" description="Filed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="GfFailed" statusTypeId="GstFiling" description="Failed" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GfDraft" toStatusId="GfGenerated" transitionName="Generate JSON"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GfGenerated" toStatusId="GfUploaded" transitionName="Upload"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GfUploaded" toStatusId="GfFiled" transitionName="File"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="GfGenerated" toStatusId="GfFailed" transitionName="Fail"/>
        </seed-data>
    </entity>

    <!-- GSTIN Verification Cache -->
    <entity entity-name="GstinVerification" package="zenith.erp.integrations" short-alias="GstinVerifications">
        <field name="verificationId" type="id" is-pk="true"/>
        <field name="gstin" type="text-short"/>
        <field name="tradeName" type="text-medium"/>
        <field name="legalName" type="text-medium"/>
        <field name="registrationType" type="text-short"/>
        <field name="registrationDate" type="date-time"/>
        <field name="cancelDate" type="date-time"/>
        <field name="gstStatus" type="text-short"/>
        <field name="stateCode" type="text-short"/>
        <field name="principalAddress" type="text-long"/>
        <field name="verifiedDate" type="date-time"/>
        <field name="rawResponse" type="text-very-long"/>
        <field name="isValid" type="text-indicator"/>
    </entity>

