<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Portal Config" default-menu-index="1">

    <transition name="createConfig" begin-transaction="true">
        <service-call name="create#zenith.erp.integrations.ApiPortalConfig"/>
        <default-response url="."/>
    </transition>
    <transition name="updateConfig" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.ApiPortalConfig"/>
        <default-response url="."/>
    </transition>
    <transition name="testConnection" begin-transaction="true">
        <service-call name="zenith.integrations.IntegrationServices.test#PortalConnection"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.ApiPortalConfig" list="configs">
            <order-by field-name="portalType,environment"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="API Portal Configurations"/>
            <box-toolbar>
                <container-dialog id="CreateConfigDialog" button-text="New Configuration">
                    <form-single name="CreateConfigForm" transition="createConfig">
                        <field name="portalType"><default-field title="Portal Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApiPortalType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="portalName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="environment"><default-field title="Environment"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApiEnvironment"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="baseUrl"><default-field title="Base URL"><text-line size="40"/></default-field></field>
                        <field name="authUrl"><default-field title="Auth URL"><text-line size="40"/></default-field></field>
                        <field name="clientId"><default-field title="Client ID"><text-line size="30"/></default-field></field>
                        <field name="clientSecret"><default-field title="Client Secret"><text-line size="30"/></default-field></field>
                        <field name="username"><default-field title="Username"><text-line size="20"/></default-field></field>
                        <field name="gstin"><default-field title="GSTIN"><text-line size="15"/></default-field></field>
                        <field name="apiVersion"><default-field title="API Version"><text-line size="8"/></default-field></field>
                        <field name="timeoutMs"><default-field title="Timeout (ms)"><text-line size="8" default-value="30000"/></default-field></field>
                        <field name="retryCount"><default-field title="Retry Count"><text-line size="3" default-value="3"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="ConfigList" list="configs" transition="updateConfig">
                    <field name="portalConfigId"><default-field><hidden/></default-field></field>
                    <field name="portalType"><default-field title="Portal">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="portalName"><default-field title="Name"><text-line size="12"/></default-field></field>
                    <field name="environment"><default-field title="Env">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="baseUrl"><default-field title="Base URL"><text-line size="20"/></default-field></field>
                    <field name="gstin"><default-field title="GSTIN"><text-line size="15"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="lastTestResult"><default-field title="Last Test"><display/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
