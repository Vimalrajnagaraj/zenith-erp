<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Outbound Webhooks" default-menu-index="40">

    <transition name="createSubscription">
        <service-call name="create#zenith.erp.integrations.webhook.WebhookSubscription" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.webhook.WebhookSubscription" list="subscriptions">
            <order-by field-name="topic"/>
        </entity-find>
        
        <!-- Load last 10 webhook logs for debugging -->
        <entity-find entity-name="zenith.erp.integrations.webhook.WebhookLog" list="webhookLogs">
            <order-by field-name="-createdDate"/>
            <limit count="10"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Outbound Webhooks" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="AddSubscription" button-text="Add Webhook" type="success">
                <form-single name="CreateSubForm" transition="createSubscription">
                    <field name="topic"><default-field title="Topic/Event">
                        <drop-down>
                            <option key="OrderCreated" text="OrderCreated"/>
                            <option key="InvoiceGenerated" text="InvoiceGenerated"/>
                            <option key="InventoryShipped" text="InventoryShipped"/>
                            <option key="CustomerCreated" text="CustomerCreated"/>
                        </drop-down>
                    </default-field></field>
                    <field name="endpointUrl"><default-field title="Endpoint URL"><text-line size="50"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down no-current-selected-key="Y"><option key="Y"/><option key="N"/></drop-down>
                    </default-field></field>
                    <field name="secretKey"><default-field title="Secret Key (for HMAC)"><text-line size="30"/></default-field></field>
                    <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container-row>
            <!-- Subscriptions List -->
            <row-col lg="6">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Active Subscriptions" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-list name="SubscriptionList" list="subscriptions" skip-form="true">
                        <field name="topic"><default-field title="Event Topic"><display/></default-field></field>
                        <field name="endpointUrl"><default-field title="Endpoint URL"><display/></default-field></field>
                        <field name="isActive"><default-field title="Active"><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>
            
            <!-- Failure Logging & Debugging -->
            <row-col lg="6">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Recent Webhook Logs (Debugging)" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-list name="LogList" list="webhookLogs" skip-form="true">
                        <field name="topic"><default-field title="Topic"><display/></default-field></field>
                        <field name="responseCode"><default-field title="HTTP Code">
                            <display text="${responseCode}" style="${responseCode &lt; 300 ? 'text-success' : 'text-danger'}"/>
                        </default-field></field>
                        <field name="isSuccess"><default-field title="Success"><display/></default-field></field>
                        <field name="createdDate"><default-field title="Timestamp"><display format="yyyy-MM-dd HH:mm:ss"/></default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
