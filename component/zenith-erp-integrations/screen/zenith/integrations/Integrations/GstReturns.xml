<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GST Returns" default-menu-index="4">

    <transition name="generateGstr1" begin-transaction="true">
        <service-call name="zenith.integrations.IntegrationServices.generate#Gstr1Json"/>
        <default-response url="."/>
    </transition>
    <transition name="updateFiling" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.GstReturnFiling"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.GstReturnFiling" list="filings">
            <search-form-inputs default-order-by="-filingDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="GST Return Filings"/>
            <box-toolbar>
                <container-dialog id="GenGstr1Dialog" button-text="Generate GSTR-1">
                    <form-single name="GenGstr1Form" transition="generateGstr1">
                        <field name="gstin"><default-field title="GSTIN"><text-line size="15"/></default-field></field>
                        <field name="financialYear"><default-field title="Financial Year"><text-line size="10"/></default-field></field>
                        <field name="returnPeriod"><default-field title="Period (MMYYYY)"><text-line size="8"/></default-field></field>
                        <field name="submitButton"><default-field title="Generate"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search GST Returns..." style="display:none"></span>]]></text></render-mode>
            <form-list name="FilingList" list="filings" transition="updateFiling" header-dialog="true">
                    <field name="filingId"><default-field><hidden/></default-field></field>
                    <field name="gstin"><header-field><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="GSTIN"><display/></default-field></field>
                    <field name="returnType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="financialYear"><default-field title="FY"><display/></default-field></field>
                    <field name="returnPeriod"><default-field title="Period"><display/></default-field></field>
                    <field name="referenceNumber"><default-field title="Ref #"><text-line size="15"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="GstFiling"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status"><drop-down>
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="GstFiling"/>
                                </entity-find></entity-options>
                        </drop-down></default-field>
                    </field>
                    <field name="filingDate"><default-field title="Filed"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
