<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Statutory Filings" default-menu-index="5">

    <transition name="generateEcr" begin-transaction="true">
        <service-call name="zenith.integrations.IntegrationServices.generate#EpfEcr"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTds" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.TdsReturnFiling"/>
        <default-response url="."/>
    </transition>
    <transition name="updateEpf" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.EpfEcrFiling"/>
        <default-response url="."/>
    </transition>
    <transition name="updateEsi" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.EsiFiling"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.TdsReturnFiling" list="tdsFilings">
            <order-by field-name="-financialYear,-quarter"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.integrations.EpfEcrFiling" list="epfFilings">
            <order-by field-name="-wageMonth"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.integrations.EsiFiling" list="esiFilings">
            <order-by field-name="-contributionPeriod"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- TDS Returns -->
        <container-box>
            <box-header title="TDS Return Filings (Form 24Q/26Q)"/>
            <box-body>
                <form-list name="TdsList" list="tdsFilings" transition="updateTds">
                    <field name="tdsFilingId"><default-field><hidden/></default-field></field>
                    <field name="tan"><default-field title="TAN"><display/></default-field></field>
                    <field name="formType"><default-field title="Form">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="quarter"><default-field title="Quarter"><display/></default-field></field>
                    <field name="financialYear"><default-field title="FY"><display/></default-field></field>
                    <field name="totalDeductions"><default-field title="Deductions"><display/></default-field></field>
                    <field name="totalTaxDeducted"><default-field title="Tax Deducted (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="provisionalReceiptNumber"><default-field title="PRN"><text-line size="15"/></default-field></field>
                    <field name="statusId"><default-field title="Status"><drop-down>
                        <entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="TdsFiling"/>
                            </entity-find></entity-options>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- EPF ECR -->
        <container-box>
            <box-header title="EPF ECR Filings"/>
            <box-toolbar>
                <container-dialog id="GenEcrDialog" button-text="Generate ECR">
                    <form-single name="GenEcrForm" transition="generateEcr">
                        <field name="establishmentCode"><default-field title="Establishment Code"><text-line size="15"/></default-field></field>
                        <field name="wageMonth"><default-field title="Wage Month (MM-YYYY)"><text-line size="10"/></default-field></field>
                        <field name="financialYear"><default-field title="Financial Year"><text-line size="10"/></default-field></field>
                        <field name="submitButton"><default-field title="Generate"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="EpfList" list="epfFilings" transition="updateEpf">
                    <field name="ecrFilingId"><default-field><hidden/></default-field></field>
                    <field name="establishmentCode"><default-field title="Est. Code"><display/></default-field></field>
                    <field name="wageMonth"><default-field title="Month"><display/></default-field></field>
                    <field name="totalEmployees"><default-field title="Employees"><display/></default-field></field>
                    <field name="totalEpfContribution"><default-field title="EPF (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalEpsContribution"><default-field title="EPS (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="challanNumber"><default-field title="Challan #"><text-line size="15"/></default-field></field>
                    <field name="statusId"><default-field title="Status"><drop-down>
                        <entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="EpfEcr"/>
                            </entity-find></entity-options>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- ESI -->
        <container-box>
            <box-header title="ESI Filings"/>
            <box-body>
                <form-list name="EsiList" list="esiFilings" transition="updateEsi">
                    <field name="esiFilingId"><default-field><hidden/></default-field></field>
                    <field name="employerCode"><default-field title="Employer Code"><display/></default-field></field>
                    <field name="contributionPeriod"><default-field title="Period"><display/></default-field></field>
                    <field name="totalEmployees"><default-field title="Employees"><display/></default-field></field>
                    <field name="employerContribution"><default-field title="Employer (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="employeeContribution"><default-field title="Employee (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalContribution"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="challanNumber"><default-field title="Challan #"><text-line size="15"/></default-field></field>
                    <field name="statusId"><default-field title="Status"><drop-down>
                        <entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="EsiFiling"/>
                            </entity-find></entity-options>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
