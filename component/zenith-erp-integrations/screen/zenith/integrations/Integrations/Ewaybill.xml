<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="E-Way Bill" default-menu-index="3">

    <transition name="updateEwaybill" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.EwaybillRecord"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.EwaybillRecord" list="ewaybills">
            <search-form-inputs default-order-by="-generatedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="E-Way Bills"/>
            <box-body>
                <form-list name="EwaybillList" list="ewaybills" transition="updateEwaybill" header-dialog="true">
                    <field name="ewaybillId"><default-field><hidden/></default-field></field>
                    <field name="ewaybillNumber"><header-field show-order-by="true"/>
                        <default-field title="EWB #"><display/></default-field></field>
                    <field name="referenceId"><default-field title="Ref ID"><display/></default-field></field>
                    <field name="fromGstin"><default-field title="From GSTIN"><display/></default-field></field>
                    <field name="toStateCode"><default-field title="To State"><display/></default-field></field>
                    <field name="totalValue"><default-field title="Value (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="vehicleNumber"><default-field title="Vehicle"><text-line size="10"/></default-field></field>
                    <field name="transDistance"><default-field title="Dist (km)"><display/></default-field></field>
                    <field name="validUpto"><default-field title="Valid Upto"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Ewaybill"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status"><drop-down>
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Ewaybill"/>
                                </entity-find></entity-options>
                        </drop-down></default-field>
                    </field>
                    <field name="generatedDate"><default-field title="Generated"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
