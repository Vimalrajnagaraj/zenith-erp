<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GSTIN Lookup" default-menu-index="6">

    <transition name="verifyGstin" begin-transaction="true">
        <service-call name="zenith.integrations.IntegrationServices.verify#Gstin"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.GstinVerification" list="verifications">
            <order-by field-name="-verifiedDate"/>
            <limit count="50"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="GSTIN Verification"/>
            <box-toolbar>
                <container-dialog id="VerifyDialog" button-text="Verify GSTIN">
                    <form-single name="VerifyForm" transition="verifyGstin">
                        <field name="gstin"><default-field title="GSTIN (15 digits)"><text-line size="15"/></default-field></field>
                        <field name="submitButton"><default-field title="Verify"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="VerifyList" list="verifications" skip-form="true">
                    <field name="gstin"><default-field title="GSTIN"><display/></default-field></field>
                    <field name="tradeName"><default-field title="Trade Name"><display/></default-field></field>
                    <field name="legalName"><default-field title="Legal Name"><display/></default-field></field>
                    <field name="registrationType"><default-field title="Reg Type"><display/></default-field></field>
                    <field name="gstStatus"><default-field title="Status"><display/></default-field></field>
                    <field name="stateCode"><default-field title="State"><display/></default-field></field>
                    <field name="isValid"><default-field title="Valid"><display/></default-field></field>
                    <field name="verifiedDate"><default-field title="Verified"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
