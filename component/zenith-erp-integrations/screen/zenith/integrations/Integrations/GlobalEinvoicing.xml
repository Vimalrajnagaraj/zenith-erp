<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Global E-Invoicing" default-menu-index="40">

    <transition name="dispatchEinvoice">
        <service-call name="zenith.integrations.GlobalEinvoiceServices.dispatch#ElectronicInvoice" in-map="context"/>
        <default-response url="."/>
    </transition>
    
    <transition name="saveConfig">
        <service-call name="create#zenith.erp.tax.TenantEInvoiceConfig" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.tax.TenantEInvoiceConfig" list="configs">
            <econdition field-name="tenantId" from="ec.tenant.getTenantId()"/>
        </entity-find>
        
        <entity-find entity-name="mantle.account.invoice.Invoice" list="recentInvoices" limit="20">
            <econdition field-name="fromPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Global E-Invoicing Center" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="ConfigDialog" button-text="Configure Local Format" type="primary">
                <form-single name="ConfigForm" transition="saveConfig">
                    <field name="tenantId"><default-field><hidden default-value="${ec.tenant.getTenantId()}"/></default-field></field>
                    <field name="eInvoiceStandardEnumId"><default-field title="E-Invoicing Standard">
                        <drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="EInvoiceStandard"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="countryGeoId"><default-field title="Country"><drop-down allow-empty="true">
                        <entity-options key="${geoId}" text="${geoName}">
                            <entity-find entity-name="moqui.basic.Geo"><econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/></entity-find>
                        </entity-options>
                    </drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Save Config"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Active Tenant E-Invoice Formats" type="h6" style="text-primary q-mb-md"/>
                    <form-list name="ConfigList" list="configs" skip-form="true">
                        <field name="eInvoiceStandardEnumId"><default-field title="Required Format">
                            <display-entity entity-name="moqui.basic.Enumeration"/>
                        </default-field></field>
                        <field name="countryGeoId"><default-field title="Country">
                            <display-entity entity-name="moqui.basic.Geo"/>
                        </default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <display text="${isActive == 'Y' ? 'Yes' : 'No'}" style="${isActive == 'Y' ? 'text-success' : 'text-danger'} text-weight-bold"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
        
        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-lg">
                    <label text="Recent Invoices (Dispatch to Government Portal)" type="h6" style="text-primary q-mb-md"/>
                    <form-list name="InvoiceList" list="recentInvoices" transition="dispatchEinvoice">
                        <field name="tenantId"><default-field><hidden default-value="${ec.tenant.getTenantId()}"/></default-field></field>
                        <field name="invoiceId"><default-field title="Invoice ID"><display/></default-field></field>
                        <field name="invoiceDate"><default-field title="Date"><display format="yyyy-MM-dd"/></default-field></field>
                        <field name="invoiceTotal"><default-field title="Total"><display currency-unit-field="currencyUomId"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field></field>
                        <field name="dispatchBtn"><default-field title="Compliance Action">
                            <submit text="Dispatch XML/JSON" type="success" confirmation="Submit electronic invoice payload to government portal/middleware?"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>

    </widgets>
</screen>
