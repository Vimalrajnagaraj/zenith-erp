<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="E-Invoice" default-menu-index="2">

    <transition name="generateEinvoice" begin-transaction="true">
        <service-call name="zenith.integrations.IntegrationServices.generate#Einvoice"/>
        <default-response url="."/>
    </transition>
    <transition name="updateEinvoice" begin-transaction="true">
        <service-call name="update#zenith.erp.integrations.EinvoiceRecord"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.integrations.EinvoiceRecord" list="einvoices">
            <search-form-inputs default-order-by="-generatedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="E-Invoice (IRP)"/>
            <box-toolbar>
                <container-dialog id="GenEiDialog" button-text="Generate E-Invoice">
                    <form-single name="GenEiForm" transition="generateEinvoice">
                        <field name="invoiceId"><default-field title="Invoice ID"><text-line size="15"/></default-field></field>
                        <field name="portalConfigId"><default-field title="Portal"><drop-down>
                            <entity-options key="${portalConfigId}" text="${portalName} (${environment})">
                                <entity-find entity-name="zenith.erp.integrations.ApiPortalConfig">
                                    <econdition field-name="portalType" value="ApGstEinvoice"/>
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Generate"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search E-Invoice..." style="display:none"></span>]]></text></render-mode>
            <form-list name="EinvoiceList" list="einvoices" transition="updateEinvoice" header-dialog="true">
                    <field name="einvoiceId"><default-field><hidden/></default-field></field>
                    <field name="invoiceId"><header-field title="Invoice"><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="Invoice"><display/></default-field></field>
                    <field name="gstin"><default-field title="GSTIN"><display/></default-field></field>
                    <field name="irn"><default-field title="IRN"><display/></default-field></field>
                    <field name="ackNumber"><default-field title="Ack #"><display/></default-field></field>
                    <field name="ackDate"><default-field title="Ack Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Einvoice"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status"><drop-down>
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Einvoice"/>
                                </entity-find></entity-options>
                        </drop-down></default-field>
                    </field>
                    <field name="generatedDate"><default-field title="Generated"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="errorMessage"><default-field title="Error"><display/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
