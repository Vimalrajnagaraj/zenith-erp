<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Price List ========== -->
    <entity entity-name="PriceList" package="zenith.erp.pricing" short-alias="PriceLists">
        <field name="priceListId" type="id" is-pk="true"/>
        <field name="priceListName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="priceListTypeEnumId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="parentPriceListId" type="id"/>
        <field name="isDefault" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <field name="roundingMode" type="text-short" default="'HALF_UP'"/>
        <field name="roundingPrecision" type="number-integer" default="2"/>
        <relationship type="one" title="PriceListType" related="moqui.basic.Enumeration">
            <key-map field-name="priceListTypeEnumId" related="enumId"/>
        </relationship>
        <relationship type="one" title="Parent" related="zenith.erp.pricing.PriceList">
            <key-map field-name="parentPriceListId" related="priceListId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PriceListType" description="Price List Type"/>
            <moqui.basic.Enumeration enumId="PltSelling" enumTypeId="PriceListType" description="Selling Price List" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PltBuying" enumTypeId="PriceListType" description="Buying/Purchase Price List" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PltWholesale" enumTypeId="PriceListType" description="Wholesale Price List" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PltRetail" enumTypeId="PriceListType" description="Retail/MRP Price List" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PltEmployee" enumTypeId="PriceListType" description="Employee Price List" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PltPromotion" enumTypeId="PriceListType" description="Promotional Price List" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Price List Item ========== -->
    <entity entity-name="PriceListItem" package="zenith.erp.pricing" short-alias="PriceListItems">
        <field name="priceListItemId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="priceListId" type="id"/>
        <field name="productId" type="id"/>
        <field name="productCategoryId" type="id"/>
        <field name="unitPrice" type="currency-precise"/>
        <field name="minQuantity" type="number-decimal" default="1"/>
        <field name="maxQuantity" type="number-decimal"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <field name="priceTypeEnumId" type="id" default="'PtpFixed'"/>
        <field name="discountPercent" type="number-decimal"/>
        <field name="marginPercent" type="number-decimal"/>
        <relationship type="one" related="zenith.erp.pricing.PriceList"/>
        <relationship type="one" related="mantle.product.Product"/>
        <index name="PLI_PRODUCT" unique="false">
            <index-field name="priceListId"/>
            <index-field name="productId"/>
        </index>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PriceType" description="Price Type"/>
            <moqui.basic.Enumeration enumId="PtpFixed" enumTypeId="PriceType" description="Fixed Price" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PtpDiscount" enumTypeId="PriceType" description="Discount from List" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PtpMargin" enumTypeId="PriceType" description="Margin on Cost" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- ========== Volume Pricing (quantity breaks) ========== -->
    <entity entity-name="VolumePricing" package="zenith.erp.pricing" short-alias="VolumePricings">
        <field name="volumePricingId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="priceListId" type="id"/>
        <field name="productId" type="id"/>
        <field name="productCategoryId" type="id"/>
        <field name="minQuantity" type="number-decimal" required="true"/>
        <field name="maxQuantity" type="number-decimal"/>
        <field name="unitPrice" type="currency-precise"/>
        <field name="discountPercent" type="number-decimal"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.pricing.PriceList"/>
        <relationship type="one" related="mantle.product.Product"/>
        <index name="VP_LOOKUP" unique="false">
            <index-field name="priceListId"/>
            <index-field name="productId"/>
            <index-field name="minQuantity"/>
        </index>
    </entity>

    <!-- ========== Customer Price List Assignment ========== -->
    <entity entity-name="CustomerPriceList" package="zenith.erp.pricing" short-alias="CustomerPriceLists">
        <field name="customerPriceListId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="customerGroupId" type="id"/>
        <field name="priceListId" type="id" required="true"/>
        <field name="priority" type="number-integer" default="10"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.pricing.PriceList"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ========== Pricing Rule ========== -->
    <entity entity-name="PricingRule" package="zenith.erp.pricing" short-alias="PricingRules">
        <field name="pricingRuleId" type="id" is-pk="true"/>
        <field name="ruleName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="priority" type="number-integer" default="10"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="isStackable" type="text-indicator" default="'N'"/>
        <field name="organizationPartyId" type="id"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <field name="actionType" type="id"/>
        <field name="actionValue" type="number-decimal"/>
        <field name="maxDiscount" type="currency-precise"/>
        <field name="minimumPrice" type="currency-precise"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PricingActionType" description="Pricing Rule Action"/>
            <moqui.basic.Enumeration enumId="PatDiscountPercent" enumTypeId="PricingActionType" description="Discount Percentage" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PatDiscountAmount" enumTypeId="PricingActionType" description="Discount Amount" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PatFixedPrice" enumTypeId="PricingActionType" description="Set Fixed Price" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PatMarginPercent" enumTypeId="PricingActionType" description="Margin on Cost" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== Pricing Rule Condition ========== -->
    <entity entity-name="PricingRuleCondition" package="zenith.erp.pricing" short-alias="PricingRuleConditions">
        <field name="conditionId" type="id" is-pk="true"/>
        <field name="pricingRuleId" type="id"/>
        <field name="conditionTypeEnumId" type="id"/>
        <field name="operator" type="text-short" default="'equals'"/>
        <field name="fieldValue" type="text-medium"/>
        <field name="fieldValueTo" type="text-medium"/>
        <relationship type="one" related="zenith.erp.pricing.PricingRule"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PricingConditionType" description="Pricing Rule Condition Type"/>
            <moqui.basic.Enumeration enumId="PctProduct" enumTypeId="PricingConditionType" description="Product" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PctProductCategory" enumTypeId="PricingConditionType" description="Product Category" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PctCustomerGroup" enumTypeId="PricingConditionType" description="Customer Group" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PctMinQuantity" enumTypeId="PricingConditionType" description="Minimum Quantity" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PctMinAmount" enumTypeId="PricingConditionType" description="Minimum Order Amount" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PctDayOfWeek" enumTypeId="PricingConditionType" description="Day of Week" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="PctTimeRange" enumTypeId="PricingConditionType" description="Time Range" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="PctChannel" enumTypeId="PricingConditionType" description="Sales Channel (POS/Web/B2B)" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="PctRegion" enumTypeId="PricingConditionType" description="Region/Location" sequenceNum="9"/>
        </seed-data>
    </entity>

    <!-- ========== Price Change Log (audit trail) ========== -->
    <entity entity-name="PriceChangeLog" package="zenith.erp.pricing" short-alias="PriceChangeLogs">
        <field name="logId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="priceListId" type="id"/>
        <field name="productId" type="id"/>
        <field name="previousPrice" type="currency-precise"/>
        <field name="newPrice" type="currency-precise"/>
        <field name="changeReason" type="text-medium"/>
        <field name="changedByUserId" type="id"/>
        <field name="changeDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.pricing.PriceList"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="PriceListItemDetail" package="zenith.erp.pricing">
        <member-entity entity-alias="PLI" entity-name="zenith.erp.pricing.PriceListItem"/>
        <member-entity entity-alias="PL" entity-name="zenith.erp.pricing.PriceList" join-from-alias="PLI">
            <key-map field-name="priceListId"/>
        </member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="PLI" join-optional="true">
            <key-map field-name="productId"/>
        </member-entity>
        <alias entity-alias="PLI" name="priceListItemId"/>
        <alias entity-alias="PLI" name="priceListId"/>
        <alias entity-alias="PLI" name="productId"/>
        <alias entity-alias="PLI" name="unitPrice"/>
        <alias entity-alias="PLI" name="minQuantity"/>
        <alias entity-alias="PLI" name="maxQuantity"/>
        <alias entity-alias="PLI" name="validFromDate" field="validFromDate"/>
        <alias entity-alias="PLI" name="validThruDate" field="validThruDate"/>
        <alias entity-alias="PLI" name="priceTypeEnumId"/>
        <alias entity-alias="PLI" name="discountPercent"/>
        <alias entity-alias="PLI" name="organizationPartyId"/>
        <alias entity-alias="PL" name="priceListName"/>
        <alias entity-alias="PL" name="priceListTypeEnumId"/>
        <alias entity-alias="PL" name="currencyUomId"/>
        <alias entity-alias="PL" name="isActive" field="isActive"/>
        <alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="pseudoId"/>
    </view-entity>

</entities>
