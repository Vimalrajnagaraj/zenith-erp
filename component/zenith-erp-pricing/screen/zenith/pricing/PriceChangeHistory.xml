<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Price History" default-menu-index="4">

    <transition name="findPriceList"><default-response url="../FindPriceList"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pricing.PriceChangeLog" list="changeLogs">
            <search-form-inputs default-order-by="-changeDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Price Change History" type="h4" style="text-weight-bold q-my-none"/>
            <link url="findPriceList" text="+ New Price List" btn-type="primary" style="z-solid"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-txntable">
            <form-list name="ChangeLogsForm" list="changeLogs" list-entry="cl" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <row-actions><script><![CDATA[
                    def z = com.zenith.Fmt.INSTANCE
                    oldStr = '₹' + z.inr(ec.l10n.format((cl.previousPrice ?: 0) as BigDecimal, '#,##0.00'))
                    newStr = '₹' + z.inr(ec.l10n.format((cl.newPrice ?: 0) as BigDecimal, '#,##0.00'))
                    def r = (cl.changeReason ?: '').toLowerCase()
                    reasonBadge = r.contains('initial') ? 'success' : (r ? 'info' : 'grey')
                    reasonStr = cl.changeReason ?: '—'
                    prodStr = cl.productId ?: '—'
                    plStr = cl.priceListId ?: '—'
                    byStr = cl.changedByUserId ?: '—'
                    dateStr = cl.changeDate ? ec.l10n.format(cl.changeDate, 'dd-MMM-yyyy HH:mm') : '—'
                ]]></script></row-actions>
                <field name="productId"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Product"><label text="${prodStr}" type="span" style="z-txt-primary text-weight-medium"/></default-field></field>
                <field name="priceListId"><header-field show-order-by="true"/>
                    <default-field title="Price List"><label text="${plStr}" type="span" style="text-dark"/></default-field></field>
                <field name="previousPrice"><default-field title="Old Price"><label text="${oldStr}" type="span" style="text-dark"/></default-field></field>
                <field name="newPrice"><default-field title="New Price"><label text="${newStr}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                <field name="changeReason"><header-field><text-find size="20"/></header-field>
                    <default-field title="Reason"><label text="${reasonStr}" type="span" style="zenith-badge nd ${reasonBadge}"/></default-field></field>
                <field name="changedByUserId"><default-field title="Changed By"><label text="${byStr}" type="span" style="text-dark"/></default-field></field>
                <field name="changeDate"><header-field show-order-by="true"/>
                    <default-field title="Date"><label text="${dateStr}" type="span" style="text-grey-7"/></default-field></field>
                <!-- ZE-PRC-017: header-dialog had Product/Reason text-find inputs but no submit button to apply them.
                     A submit field with only a header-field renders the "Find" button in the Find Options dialog
                     (standard Moqui find-screen pattern, cf. FindContact) without adding a grid column. -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
