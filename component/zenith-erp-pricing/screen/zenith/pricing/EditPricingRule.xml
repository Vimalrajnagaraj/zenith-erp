<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Pricing Rule" default-menu-include="false">

    <parameter name="pricingRuleId" required="true"/>

    <transition name="updateRule">
        <service-call name="update#zenith.erp.pricing.PricingRule"/>
        <default-response url="."/>
    </transition>
    <transition name="addCondition">
        <service-call name="create#zenith.erp.pricing.PricingRuleCondition"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteCondition">
        <service-call name="delete#zenith.erp.pricing.PricingRuleCondition"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.pricing.PricingRule" value-field="rule"/>
        <entity-find entity-name="zenith.erp.pricing.PricingRuleCondition" list="conditions">
            <econdition field-name="pricingRuleId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Rule: ${rule?.ruleName}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="../FindPricingRule" text="Back to Rules" style="text-primary"/>
        </container>

        <!-- Rule Details -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Rule Details" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="UpdateRuleForm" transition="updateRule" map="rule">
                <field name="pricingRuleId"><default-field><hidden/></default-field></field>
                <field name="ruleName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                <field name="priority"><default-field title="Priority"><text-line size="5"/></default-field></field>
                <field name="actionType"><default-field title="Action">
                    <drop-down><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PricingActionType"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="actionValue"><default-field title="Value"><text-line size="10"/></default-field></field>
                <field name="maxDiscount"><default-field title="Max Discount"><text-line size="10"/></default-field></field>
                <field name="minimumPrice"><default-field title="Price Floor"><text-line size="10"/></default-field></field>
                <field name="isStackable"><default-field title="Stackable?">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="isActive"><default-field title="Active?">
                    <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </default-field></field>
                <field name="validFromDate"><default-field title="Valid From"><date-time type="date"/></default-field></field>
                <field name="validThruDate"><default-field title="Valid Thru"><date-time type="date"/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-single>
        </container>

        <!-- Conditions -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Conditions (ALL must match)" type="h5" style="text-weight-bold q-my-none"/>
                <container-dialog id="AddCondition" button-text="Add Condition" type="success">
                    <form-single name="AddConditionForm" transition="addCondition">
                        <field name="pricingRuleId"><default-field><hidden default-value="${pricingRuleId}"/></default-field></field>
                        <field name="conditionTypeEnumId"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PricingConditionType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="operator"><default-field>
                            <drop-down>
                                <option key="equals" text="Equals"/>
                                <option key="not-equals" text="Not Equals"/>
                                <option key="greater-than" text="Greater Than"/>
                                <option key="less-than" text="Less Than"/>
                                <option key="in" text="In List"/>
                                <option key="between" text="Between"/>
                            </drop-down></default-field></field>
                        <field name="fieldValue"><default-field title="Value"><text-line size="30"/></default-field></field>
                        <field name="fieldValueTo"><default-field title="Value To (for between)"><text-line size="30"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <form-list name="ConditionsForm" list="conditions" skip-form="true">
                <field name="conditionTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="operator"><default-field><display/></default-field></field>
                <field name="fieldValue"><default-field title="Value"><display/></default-field></field>
                <field name="fieldValueTo"><default-field title="To"><display/></default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteCondition" text="Remove" parameter-map="[conditionId:conditionId]"
                          confirmation="Remove this condition?" style="text-negative"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
