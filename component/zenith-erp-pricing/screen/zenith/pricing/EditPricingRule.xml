<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Pricing Rule" default-menu-include="false">

    <parameter name="pricingRuleId" required="true"/>

    <!-- ZE-PRC-016: every mutation is org-guarded (screen actions don't run for transitions, and the IDs are
         attacker-controllable form/link params). deleteCondition resolves the parent pricingRuleId from the row. -->
    <transition name="updateRule">
        <actions>
            <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:pricingRuleId]" out-map="_acc"/>
            <if condition="_acc.allowed"><service-call name="update#zenith.erp.pricing.PricingRule" in-map="context"/></if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="addCondition">
        <actions>
            <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:pricingRuleId]" out-map="_acc"/>
            <!-- ZE-PRC-075: go through add#PricingRuleCondition so a 'between' operator is rejected unless
                 BOTH Value and Value To are provided (was the raw entity create -> blank "To" saved silently). -->
            <if condition="_acc.allowed"><service-call name="zenith.pricing.PricingServices.add#PricingRuleCondition" in-map="context"/></if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteCondition">
        <actions>
            <entity-find-one entity-name="zenith.erp.pricing.PricingRuleCondition" value-field="_cond"/>
            <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:_cond?.pricingRuleId]" out-map="_acc"/>
            <if condition="_cond != null &amp;&amp; _acc.allowed"><service-call name="delete#zenith.erp.pricing.PricingRuleCondition" in-map="context"/></if>
        </actions>
        <default-response url="."/>
    </transition>
    <!-- ZE-PRC redesign: Delete Rule (conditions first to clear FK) + Duplicate, both org-guarded. -->
    <transition name="deleteRule">
        <actions>
            <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:pricingRuleId]" out-map="_acc"/>
            <if condition="_acc.allowed"><script><![CDATA[
                ec.entity.find("zenith.erp.pricing.PricingRuleCondition").condition("pricingRuleId", pricingRuleId).deleteAll()
                ec.entity.find("zenith.erp.pricing.PricingRule").condition("pricingRuleId", pricingRuleId).deleteAll()
            ]]></script></if>
        </actions>
        <default-response url="../FindPricingRule"/>
    </transition>
    <transition name="duplicateRule">
        <actions>
            <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:pricingRuleId]" out-map="_acc"/>
            <set field="newRuleId" from="null"/>
            <if condition="_acc.allowed"><script><![CDATA[
                def src = ec.entity.find("zenith.erp.pricing.PricingRule").condition("pricingRuleId", pricingRuleId).one()
                if (src) {
                    def created = ec.service.sync().name("create#zenith.erp.pricing.PricingRule").parameters([
                        ruleName: ((src.ruleName ?: 'Rule') + ' (copy)'), description: src.description,
                        priority: src.priority, isActive: 'N', isStackable: src.isStackable,
                        organizationPartyId: src.organizationPartyId,
                        validFromDate: src.validFromDate, validThruDate: src.validThruDate,
                        actionType: src.actionType, actionValue: src.actionValue,
                        maxDiscount: src.maxDiscount, minimumPrice: src.minimumPrice]).call()
                    newRuleId = created?.pricingRuleId
                }
            ]]></script></if>
        </actions>
        <default-response url="../EditPricingRule"><parameter name="pricingRuleId" from="newRuleId ?: pricingRuleId"/></default-response>
    </transition>

    <actions>
        <!-- ZE-PRC-016 (XF-021): assert the rule belongs to this tenant BEFORE loading it. -->
        <service-call name="zenith.pricing.PricingServices.assert#PricingRuleAccess" in-map="[pricingRuleId:pricingRuleId]" out-map="_acc"/>
        <set field="noAccess" from="!(_acc.allowed)"/>
        <if condition="!noAccess">
            <entity-find-one entity-name="zenith.erp.pricing.PricingRule" value-field="rule"/>
            <entity-find entity-name="zenith.erp.pricing.PricingRuleCondition" list="conditions">
                <econdition field-name="pricingRuleId"/>
                <order-by field-name="conditionId"/>
            </entity-find>

            <script><![CDATA[
                def z = com.zenith.Fmt.INSTANCE
                def fmtN = { v -> v == null ? '' : ec.l10n.format(v, '0.##') }
                def fmtM = { v -> v == null ? '' : z.inr(ec.l10n.format(v, '#,##0.##')) }
                // action type
                def actEnum = ec.entity.find("moqui.basic.Enumeration").condition("enumId", rule.actionType).one()
                actionLabel = actEnum?.description ?: (rule.actionType ?: '—')
                def actShortMap = [PatDiscountPercent:'Discount %', PatDiscountAmount:'Discount ₹', PatFixedPrice:'Fixed Price', PatMarginPercent:'Markup %']
                actionShort = actShortMap[rule.actionType] ?: actionLabel
                def isPct = (rule.actionType in ['PatDiscountPercent','PatMarginPercent'])
                def isMarkup = (rule.actionType in ['PatMarginPercent'])
                actionSub = isPct ? 'Percentage-based' : 'Amount-based'
                priorityVal = (rule.priority != null ? rule.priority : 10)
                statusActive = (rule.isActive == 'Y')
                statusLabel = statusActive ? 'Active' : 'Inactive'
                condCount = conditions.size()
                condMatchWord = 'ALL must match'
                // discount value stat
                def avStr = fmtN(rule.actionValue)
                discountValueStr = isPct ? (avStr + '%') : ('₹' + fmtM(rule.actionValue))
                discBadgeText = isPct ? (avStr + '% ' + (isMarkup ? 'markup' : 'discount')) : ('₹' + fmtM(rule.actionValue) + (isMarkup ? ' markup' : ''))
                maxCapStr = (rule.maxDiscount != null) ? ('Max cap: ₹' + fmtM(rule.maxDiscount)) : 'No cap set'
                // validity
                def dfShort = new java.text.SimpleDateFormat('dd MMM'); def dfFull = new java.text.SimpleDateFormat('dd MMM yyyy')
                def vf = rule.validFromDate; def vt = rule.validThruDate
                if (vf && vt) {
                    validRangeStr = dfShort.format(vf) + ' – ' + dfShort.format(vt)
                    def days = ((vt.getTime() - vf.getTime()) / 86400000L) as long
                    validSubStr = new java.text.SimpleDateFormat('yyyy').format(vt) + ' · ' + days + ' days'
                    validFullStr = dfFull.format(vf) + ' – ' + dfFull.format(vt)
                } else { validRangeStr = '—'; validSubStr = 'No date range'; validFullStr = 'no fixed dates' }
                stackableStr = (rule.isStackable == 'Y') ? 'Stackable with other rules' : 'Not stackable with other rules'

                // condition type labels + operator words for table + summary
                def condEnums = ec.entity.find("moqui.basic.Enumeration").condition("enumTypeId", "PricingConditionType").list()
                condTypeMap = [:]; condEnums.each { condTypeMap[it.enumId] = it.description }
                def opWord = { op -> [equals:'equals','not-equals':'not equals','greater-than':'greater than','less-than':'less than','in':'in','between':'between'][op] ?: (op ?: '') }
                // build summary condition phrases
                def phrases = conditions.collect { c ->
                    def tl = (condTypeMap[c.conditionTypeEnumId] ?: c.conditionTypeEnumId ?: '')
                    def vv = (c.fieldValue ?: '')
                    def vTo = c.fieldValueTo ? (' and ' + c.fieldValueTo) : ''
                    tl + ' ' + opWord(c.operator) + ' ' + vv + vTo
                }
                condSummaryStr = phrases ? phrases.join(' AND ') : 'no conditions'
                // action phrase for summary
                def actPhrase
                if (rule.actionType == 'PatDiscountPercent') actPhrase = 'Apply a ' + avStr + '% discount'
                else if (rule.actionType == 'PatDiscountAmount') actPhrase = 'Apply a ₹' + fmtM(rule.actionValue) + ' discount'
                else if (rule.actionType == 'PatFixedPrice') actPhrase = 'Set a fixed price of ₹' + fmtM(rule.actionValue)
                else if (rule.actionType == 'PatMarginPercent') actPhrase = 'Apply a ' + avStr + '% markup'
                else actPhrase = 'Apply ' + actionLabel
                capPhrase = (rule.maxDiscount != null) ? (', capped at ₹' + fmtM(rule.maxDiscount) + ' maximum') : ''
                summaryActionStr = actPhrase + capPhrase
                summaryMetaStr = 'Valid ' + validFullStr + ' · ' + stackableStr + ' · Priority ' + priorityVal
            ]]></script>
        </if>
    </actions>

    <widgets>
        <section name="prc_noAccess" condition="noAccess"><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                <label text="This pricing rule was not found or you do not have access to it." type="h6" style="text-negative text-weight-bold"/>
                <link url="../FindPricingRule" text="Back to Rules" btn-type="primary" icon="fa fa-arrow-left"/>
            </container>
        </widgets></section>
        <section name="prc_hasAccess" condition="!noAccess"><widgets>
        <!-- cross-surface interaction bootstrap: tab switching, add-condition toggle, Update-button forwarding -->
        <render-mode><text type="html,qvt"><![CDATA[<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" style="display:none" onload="(function(){if(window.__prrInit)return;window.__prrInit=1;document.addEventListener('click',function(ev){var t=ev.target.closest?ev.target.closest('.prr-tab,.prr-addcond-toggle,.prr-addcond-cancel,.prr-update-btn,.prr-dup-btn'):null;if(!t)return;if(t.classList.contains('prr-tab')){var n=t.getAttribute('data-tab');[].forEach.call(document.querySelectorAll('.prr-tab'),function(x){if(x===t)x.classList.add('prr-active');else x.classList.remove('prr-active');});[].forEach.call(document.querySelectorAll('.prr-panel'),function(p){if(p.className.indexOf('prr-panel-'+n)>=0)p.classList.add('prr-active');else p.classList.remove('prr-active');});}else if(t.classList.contains('prr-addcond-toggle')){var f=document.querySelector('.prr-addform');if(f)f.classList.toggle('prr-show');}else if(t.classList.contains('prr-addcond-cancel')){var f=document.querySelector('.prr-addform');if(f)f.classList.remove('prr-show');}else if(t.classList.contains('prr-update-btn')){var s=document.getElementById('UpdateRuleForm_submitBtn');if(s)s.click();}else if(t.classList.contains('prr-dup-btn')){var d=document.querySelector('.prr-dup-real');if(d)d.click();}},true);})()"/>]]></text></render-mode>
        <link url="duplicateRule" text="Duplicate" parameter-map="[pricingRuleId:rule.pricingRuleId]" style="prr-dup-real"/>

        <container style="prr-wrap">
            <!-- Breadcrumb + Header + Quick stats + Tab nav (pure display) -->
            <render-mode><text type="html,qvt" template="true"><![CDATA[
<div class="prr-breadcrumb"><a href="../FindPricingRule">Pricing</a><span>/</span><a href="../FindPricingRule">Pricing Rules</a><span>/</span><span class="prr-bc-cur">${rule.ruleName!"Rule"}</span></div>
<div class="prr-header">
  <div class="prr-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
  <div class="prr-hmeta">
    <h1>${rule.ruleName!"Rule"}</h1>
    <div class="prr-metarow">
      <span>${actionLabel}</span><span class="prr-sep">|</span><span>Priority ${priorityVal}</span>
      <span class="prr-badge ${statusActive?string('prr-badge-green','prr-badge-grey')}">${statusLabel}</span>
      <span class="prr-badge prr-badge-orange">${discBadgeText}</span>
      <span class="prr-badge prr-badge-purple">${condCount} Condition${(condCount==1)?string('','s')}</span>
    </div>
  </div>
  <div class="prr-hactions">
    <button type="button" class="prr-btn prr-btn-outline prr-dup-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Duplicate</button>
    <button type="button" class="prr-btn prr-btn-primary prr-update-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Update Rule</button>
  </div>
</div>
<div class="prr-stats">
  <div class="prr-stat"><div class="prr-stat-label">Action</div><div class="prr-stat-value" style="font-size:16px">${actionShort}</div><div class="prr-stat-sub">${actionSub}</div></div>
  <div class="prr-stat"><div class="prr-stat-label">Discount Value</div><div class="prr-stat-value" style="color:#D97706">${discountValueStr}</div><div class="prr-stat-sub">${maxCapStr}</div></div>
  <div class="prr-stat"><div class="prr-stat-label">Conditions</div><div class="prr-stat-value" style="color:#7C3AED">${condCount}</div><div class="prr-stat-sub">${condMatchWord}</div></div>
  <div class="prr-stat"><div class="prr-stat-label">Validity</div><div class="prr-stat-value" style="font-size:14px">${validRangeStr}</div><div class="prr-stat-sub">${validSubStr}</div></div>
</div>
<div class="prr-tabs"><button type="button" class="prr-tab prr-active" data-tab="details">Rule Details</button><button type="button" class="prr-tab" data-tab="conditions">Conditions</button></div>
            ]]></text></render-mode>

            <container style="prr-tabbody">
                <!-- ===== Rule Details panel ===== -->
                <container style="prr-panel prr-panel-details prr-active">
                    <form-single name="UpdateRuleForm" transition="updateRule" map="rule">
                        <field name="pricingRuleId"><default-field><hidden/></default-field></field>
                        <field name="ruleName"><default-field title="Rule Name"><text-line size="40"/></default-field></field>
                        <field name="priority"><default-field title="Priority"><text-line size="8"/></default-field></field>
                        <field name="isActive"><default-field title="Status">
                            <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="60"/></default-field></field>
                        <field name="actionType"><default-field title="Action Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PricingActionType"/><order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="actionValue"><default-field title="Value"><text-line size="10"/></default-field></field>
                        <field name="maxDiscount"><default-field title="Max Discount (₹)"><text-line size="10"/></default-field></field>
                        <field name="minimumPrice"><default-field title="Price Floor (₹)"><text-line size="10"/></default-field></field>
                        <field name="isStackable"><default-field title="Stackable?">
                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                        <field name="validFromDate"><default-field title="Valid From"><date-time type="date"/></default-field></field>
                        <field name="validThruDate"><default-field title="Valid Thru"><date-time type="date"/></default-field></field>
                        <field name="submitBtn">
                            <conditional-field name="prc_rule_save_write" condition="modCanWrite" title=""><submit text="Update Rule"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                        <field-layout>
                            <field-group title="Basic Information">
                                <field-row><field-ref name="ruleName"/><field-ref name="priority"/><field-ref name="isActive"/></field-row>
                                <field-ref name="description"/>
                            </field-group>
                            <field-group title="Pricing Action">
                                <field-row><field-ref name="actionType"/><field-ref name="actionValue"/><field-ref name="maxDiscount"/></field-row>
                                <field-row><field-ref name="minimumPrice"/><field-ref name="isStackable"/></field-row>
                            </field-group>
                            <field-group title="Validity Period">
                                <field-row><field-ref name="validFromDate"/><field-ref name="validThruDate"/></field-row>
                            </field-group>
                            <field-ref name="pricingRuleId"/>
                            <field-ref name="submitBtn"/>
                        </field-layout>
                    </form-single>
                </container>

                <!-- ===== Conditions panel ===== -->
                <container style="prr-panel prr-panel-conditions">
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
<div class="prr-sectitle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Conditions<span class="prr-sec-note">ALL must match for this rule to apply</span></div>
<div class="prr-condtoolbar"><p>Define the criteria that must be met for this pricing rule to trigger.</p><button type="button" class="prr-btn prr-btn-outline prr-addcond-toggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Add Condition</button></div>
                    ]]></text></render-mode>

                    <section name="prc_AddCondition_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container style="prr-addform">
                        <form-single name="AddConditionForm" transition="addCondition">
                            <field name="pricingRuleId"><default-field><hidden default-value="${pricingRuleId}"/></default-field></field>
                            <field name="conditionTypeEnumId"><default-field title="Condition Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="PricingConditionType"/><order-by field-name="sequenceNum"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="operator"><default-field title="Operator">
                                <drop-down>
                                    <option key="equals" text="equals"/><option key="not-equals" text="not-equals"/>
                                    <option key="greater-than" text="greater-than"/><option key="less-than" text="less-than"/>
                                    <option key="between" text="between"/><option key="in" text="in"/>
                                </drop-down></default-field></field>
                            <field name="fieldValue"><default-field title="Value"><text-line size="20"/></default-field></field>
                            <field name="fieldValueTo"><default-field title="To (for range)"><text-line size="20"/></default-field></field>
                            <field name="cancelBtn"><default-field title="">
                                <render-mode><text type="html,qvt"><![CDATA[<button type="button" class="prr-btn prr-btn-ghost prr-addcond-cancel">Cancel</button>]]></text></render-mode></default-field></field>
                            <field name="submitBtn"><default-field title=""><submit text="Add Condition"/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="conditionTypeEnumId"/><field-ref name="operator"/><field-ref name="fieldValue"/><field-ref name="fieldValueTo"/></field-row>
                                <field-ref name="pricingRuleId"/>
                                <field-row><field-ref name="cancelBtn"/><field-ref name="submitBtn"/></field-row>
                            </field-layout>
                        </form-single>
                    </container>
                    </widgets></section>

                    <container style="prr-condtable">
                        <form-list name="ConditionsForm" list="conditions" list-entry="c" skip-form="true">
                            <row-actions><script><![CDATA[
                                condTypeLabel = condTypeMap[c.conditionTypeEnumId] ?: (c.conditionTypeEnumId ?: '—')
                                opLabel = c.operator ?: '—'
                                valStr = (c.fieldValue != null) ? c.fieldValue.toString() : '—'
                                toStr = (c.fieldValueTo != null && c.fieldValueTo != '') ? c.fieldValueTo.toString() : '—'
                            ]]></script></row-actions>
                            <field name="conditionTypeEnumId"><header-field title="Type"/>
                                <default-field><label text="${condTypeLabel}" type="span" style="text-weight-bold text-dark"/></default-field></field>
                            <field name="operator"><header-field title="Operator"/>
                                <default-field><label text="${opLabel}" type="span" style="prr-condbadge"/></default-field></field>
                            <field name="fieldValue"><header-field title="Value"/>
                                <default-field><label text="${valStr}" type="span" style="text-weight-bold text-dark"/></default-field></field>
                            <field name="fieldValueTo"><header-field title="To"/>
                                <default-field><label text="${toStr}" type="span" style="text-grey-6"/></default-field></field>
                            <field name="deleteBtn">
                                <conditional-field name="prc_cond_del_write" condition="modCanWrite" title="">
                                    <link url="deleteCondition" text="Remove" icon="fa fa-trash" parameter-map="[conditionId:c.conditionId]"
                                          confirmation="Remove this condition?" style="prr-btn-danger-sm"/>
                                </conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field></field>
                        </form-list>
                    </container>

                    <render-mode><text type="html,qvt" template="true"><![CDATA[
<div class="prr-summary">
  <div class="prr-summary-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Rule Summary</div>
  <div class="prr-summary-body"><strong>When</strong> ${condSummaryStr}: <br><strong>${summaryActionStr}</strong>.<br><span class="prr-summary-meta">${summaryMetaStr}</span></div>
</div>
                    ]]></text></render-mode>
                </container>

                <!-- ===== Save bar (always visible) ===== -->
                <container style="prr-savebar">
                    <link url="deleteRule" text="Delete Rule" parameter-map="[pricingRuleId:rule.pricingRuleId]"
                          confirmation="Delete this rule and all its conditions? This cannot be undone." style="prr-btn-danger"/>
                    <container style="prr-savebar-spacer"/>
                    <link url="." text="Discard Changes" style="prr-btn-outline"/>
                    <render-mode><text type="html,qvt"><![CDATA[<button type="button" class="prr-btn prr-btn-primary prr-update-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Update Rule</button>]]></text></render-mode>
                </container>
            </container>
        </container>
        </widgets></section>
    </widgets>
</screen>
