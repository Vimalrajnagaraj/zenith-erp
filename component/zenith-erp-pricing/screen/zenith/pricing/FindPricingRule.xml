<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pricing Rules" default-menu-index="3">

    <transition name="editPricingRule"><default-response url="../EditPricingRule"/></transition>
    <transition name="createPricingRule">
        <service-call name="zenith.pricing.PricingServices.create#PricingRule"/>
        <default-response url="../EditPricingRule"/>
    </transition>
    <transition name="toggleRule">
        <service-call name="update#zenith.erp.pricing.PricingRule"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="moqui.basic.Enumeration" list="actEnums">
            <econdition field-name="enumTypeId" value="PricingActionType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <script>actionDescMap = [:]; actEnums.each { actionDescMap[it.enumId] = it.description }</script>

        <entity-find entity-name="zenith.erp.pricing.PricingRule" list="rules">
            <search-form-inputs default-order-by="priority,ruleName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Pricing Rules" type="h4" style="text-weight-bold q-my-none"/>
            <section name="prc_CreateRule_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container style="z-newbtn-wrap">
            <container-dialog id="CreateRule" button-text="+ New Rule">
                <form-single name="CreateRuleForm" transition="createPricingRule">
                    <field name="ruleName"><default-field title="Rule Name"><text-line size="40"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="priority"><default-field title="Priority (lower = first)">
                        <text-line size="5" default-value="10"/></default-field></field>
                    <field name="actionType"><default-field title="Action">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="PricingActionType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="actionValue"><default-field title="Value"><text-line size="10"/></default-field></field>
                    <field name="maxDiscount"><default-field title="Max Discount"><text-line size="10"/></default-field></field>
                    <field name="isStackable"><default-field title="Stackable?">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="validFromDate"><default-field title="Valid From"><date-time type="date"/></default-field></field>
                    <field name="validThruDate"><default-field title="Valid Thru"><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </container>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-txntable">
            <form-list name="RulesForm" list="rules" list-entry="pr" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <row-actions><script><![CDATA[
                    def act = pr.actionType ?: ''
                    actLabel = actionDescMap[act] ?: (act ?: '—')
                    def h = Math.abs((pr.pricingRuleId ?: pr.ruleName ?: '').toString().hashCode())
                    actBadge = (act == 'PatFixedPrice') ? 'info' : (['success','warning','primary'][h % 3])
                    activeLabel = (pr.isActive == 'Y') ? 'Yes' : 'No'
                    activeBadge = (pr.isActive == 'Y') ? 'success' : 'danger'
                    actValStr = (pr.actionValue != null) ? ec.l10n.format(pr.actionValue, '0.##') : '—'
                    stackStr = pr.isStackable ?: 'N'
                    fromStr = pr.validFromDate ? ec.l10n.format(pr.validFromDate, 'dd-MMM-yyyy') : '—'
                    toStr = pr.validThruDate ? ec.l10n.format(pr.validThruDate, 'dd-MMM-yyyy') : '—'
                    fromStyle = pr.validFromDate ? 'text-dark' : 'text-grey-6'
                    toStyle = pr.validThruDate ? 'text-dark' : 'text-grey-6'
                ]]></script></row-actions>
                <field name="ruleName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Rule">
                        <link url="editPricingRule" text="${pr.ruleName}" parameter-map="[pricingRuleId:pr.pricingRuleId]" style="z-vlink"/>
                    </default-field></field>
                <field name="priority"><header-field show-order-by="true"/>
                    <default-field title="Priority"><label text="${pr.priority}" type="span" style="text-dark"/></default-field></field>
                <field name="actionType"><header-field show-order-by="true"/>
                    <default-field title="Action"><label text="${actLabel}" type="span" style="zenith-badge nd ${actBadge}"/></default-field></field>
                <field name="actionValue"><default-field title="Value"><label text="${actValStr}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                <field name="isStackable"><default-field title="Stack"><label text="${stackStr}" type="span" style="text-grey-8"/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><label text="${activeLabel}" type="span" style="zenith-badge nd ${activeBadge}"/></default-field></field>
                <field name="validFromDate"><default-field title="From"><label text="${fromStr}" type="span" style="${fromStyle}"/></default-field></field>
                <field name="validThruDate"><default-field title="To"><label text="${toStr}" type="span" style="${toStyle}"/></default-field></field>
                <field name="rowMenu"><default-field title="">
                    <link url="editPricingRule" text="⋮" parameter-map="[pricingRuleId:pr.pricingRuleId]" style="z-kebab"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
