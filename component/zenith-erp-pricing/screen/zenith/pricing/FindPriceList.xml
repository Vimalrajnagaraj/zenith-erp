<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Price Lists" default-menu-index="2">

    <transition name="editPriceList"><default-response url="../EditPriceList"/></transition>
    <transition name="createPriceList">
        <service-call name="zenith.pricing.PricingServices.create#PriceList"/>
        <default-response url="../EditPriceList"/>
    </transition>

    <actions>
        <entity-find entity-name="moqui.basic.Enumeration" list="pltEnums">
            <econdition field-name="enumTypeId" value="PriceListType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <script><![CDATA[
            typeDescMap = [:]; pltEnums.each { typeDescMap[it.enumId] = it.description }
            // colour keyed by price-list type (design-system doc), reusing existing zenith-badge tokens (no pink/teal token exists)
            typeBadgeMap = [PltSelling:'success', PltRetail:'info', PltWholesale:'warning',
                            PltBuying:'primary', PltEmployee:'info', PltPromotion:'danger']
        ]]></script>

        <entity-find entity-name="zenith.erp.pricing.PriceList" list="priceLists">
            <search-form-inputs default-order-by="-isDefault,priceListName" skip-fields="organizationPartyId"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zppl-page">
        <!-- ZE-PRC placeholder shim (see FindPricingRule): Moqui macros never emit the XML `placeholder` attr;
             set the CreatePriceListForm placeholders by field name via the cross-surface <img onload> bootstrap. -->
        <render-mode><text type="html,qvt"><![CDATA[<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" style="display:none" onload="(function(){var p={priceListName:'Enter price list name',description:'Enter description (optional)'};function a(){for(var n in p){var e=document.getElementsByName(n);for(var i=0;i<e.length;i++){var el=e[i];if(el&&(el.tagName=='INPUT'||el.tagName=='TEXTAREA')&&!el.getAttribute('placeholder')){el.setAttribute('placeholder',p[n]);}}}}a();document.addEventListener('click',function(ev){var t=ev.target;if(t&&(t.id=='CreatePriceList-button'||(t.closest&&t.closest('#CreatePriceList-button'))||/new price list/i.test(t.textContent||''))){setTimeout(a,120);setTimeout(a,450);setTimeout(a,950);}},true);})()"/>]]></text></render-mode>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Price Lists" type="h4" style="text-weight-bold q-my-none" condition="!(sri.getRenderMode() in ['csv', 'xlsx'])"/>
            <section name="prc_CreatePriceList_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container style="z-newbtn-wrap">
            <container-dialog id="CreatePriceList" button-text="New Price List">
                <form-single name="CreatePriceListForm" transition="createPriceList">
                    <field name="priceListName"><default-field title="Name"><text-line size="40" placeholder="Enter price list name"/></default-field></field>
                    <field name="priceListTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="PriceListType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <drop-down><entity-options key="${uomId}" text="${abbreviation} - ${description}">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                <order-by field-name="abbreviation"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="organizationPartyId"><default-field><hidden default-value="${ec.user.getPreference('ACTIVE_ORGANIZATION')}"/></default-field></field>
                    <field name="isDefault"><default-field title="Default?">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="description"><default-field><text-area rows="3" cols="50" placeholder="Enter description (optional)"/></default-field></field>
                    <!-- ZE-PRC-022: rounding config at creation (defaults HALF_UP / 2 if left as-is). -->
                    <field name="roundingMode"><default-field title="Rounding Mode">
                        <drop-down no-current-selected-key="HALF_UP">
                            <option key="HALF_UP" text="Half Up (.5 away from zero)"/>
                            <option key="HALF_DOWN" text="Half Down (.5 toward zero)"/>
                            <option key="HALF_EVEN" text="Half Even (banker's rounding)"/>
                            <option key="UP" text="Up (away from zero)"/>
                            <option key="DOWN" text="Down (toward zero / truncate)"/>
                            <option key="CEILING" text="Ceiling (toward +infinity)"/>
                            <option key="FLOOR" text="Floor (toward -infinity)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="roundingPrecision"><default-field title="Rounding Precision (decimals)">
                        <drop-down no-current-selected-key="2">
                            <option key="0" text="0"/><option key="1" text="1"/><option key="2" text="2"/>
                            <option key="3" text="3"/><option key="4" text="4"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit icon="fa fa-plus-circle"/></default-field></field>
                </form-single>
            </container-dialog>
            </container>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-txntable z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search price lists..." style="display:none"></span>]]></text></render-mode>
            <form-list name="PriceListsForm" list="priceLists" list-entry="pl" skip-form="true" header-dialog="true"
                       select-columns="true" saved-finds="true" show-csv-button="true" show-xlsx-button="true">
                <row-actions><script><![CDATA[
                    def t = pl.priceListTypeEnumId ?: ''
                    typeLabel = typeDescMap[t] ?: (t ?: '—')
                    typeBadge = typeBadgeMap[t] ?: 'info'
                    defLabel = (pl.isDefault == 'Y') ? 'Yes' : 'No'
                    defBadge = (pl.isDefault == 'Y') ? 'success' : 'danger'
                    actLabel = (pl.isActive == 'Y') ? 'Yes' : 'No'
                    actBadge = (pl.isActive == 'Y') ? 'success' : 'danger'
                ]]></script></row-actions>
                <field name="priceListName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv', 'xlsx']"><display text="${pl.priceListName}"/></conditional-field>
                    <default-field title="Name">
                        <link url="editPriceList" text="${pl.priceListName}" parameter-map="[priceListId:pl.priceListId]" style="z-vlink"/>
                    </default-field></field>
                <field name="priceListTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PriceListType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type"><label text="${typeLabel}" type="span" style="zenith-badge nd ${typeBadge}"/></default-field></field>
                <field name="currencyUomId"><default-field title="Currency"><label text="${pl.currencyUomId}" type="span" style="text-dark"/></default-field></field>
                <field name="isDefault"><header-field show-order-by="true"/>
                    <default-field title="Default"><label text="${defLabel}" type="span" style="zenith-badge nd ${defBadge}"/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><label text="${actLabel}" type="span" style="zenith-badge nd ${actBadge}"/></default-field></field>
                <field name="rowMenu"><default-field title="">
                    <link url="editPriceList" text="⋮" parameter-map="[priceListId:pl.priceListId]" style="z-kebab"/>
                </default-field><conditional-field condition="sri.getRenderMode() in ['csv', 'xlsx']"><ignored/></conditional-field></field>
                <!-- ZE-PRC-004: the header-dialog had Name/Type/Active filter inputs but no submit button to apply them.
                     A submit field with only a header-field renders the "Find" button in the Find Options dialog
                     (standard Moqui find-screen pattern, cf. FindContact / ZE-PRC-017) without adding a grid column. -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
