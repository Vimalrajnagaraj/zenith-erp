<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Price List" default-menu-include="false">

    <parameter name="priceListId" required="true"/>

    <transition name="updatePriceList">
        <service-call name="update#zenith.erp.pricing.PriceList"/>
        <default-response url="."/>
    </transition>
    <transition name="setPriceItem">
        <service-call name="zenith.pricing.PricingServices.set#PriceListItem"/>
        <default-response url="."/>
    </transition>
    <transition name="deletePriceItem">
        <service-call name="delete#zenith.erp.pricing.PriceListItem"/>
        <default-response url="."/>
    </transition>
    <transition name="setVolumePricing">
        <service-call name="zenith.pricing.PricingServices.set#VolumePricing"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteVolumePricing">
        <service-call name="delete#zenith.erp.pricing.VolumePricing"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.pricing.PriceList" value-field="priceList"/>

        <entity-find entity-name="zenith.erp.pricing.PriceListItemDetail" list="priceItems">
            <econdition field-name="priceListId"/>
            <order-by field-name="productName,minQuantity"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.pricing.VolumePricing" list="volumePrices">
            <econdition field-name="priceListId"/>
            <order-by field-name="productId,minQuantity"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Price List: ${priceList?.priceListName}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="../FindPriceList" text="Back to List" style="text-primary"/>
        </container>

        <!-- Price List Details -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Price List Details" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="UpdatePriceList" transition="updatePriceList" map="priceList">
                <field name="priceListId"><default-field><hidden/></default-field></field>
                <field name="priceListName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                <field name="priceListTypeEnumId"><default-field title="Type">
                    <drop-down><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PriceListType"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="currencyUomId"><default-field title="Currency">
                    <drop-down><entity-options key="${uomId}" text="${abbreviation} - ${description}">
                        <entity-find entity-name="moqui.basic.Uom">
                            <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="parentPriceListId"><default-field title="Fallback Price List">
                    <drop-down allow-empty="true"><entity-options key="${priceListId}" text="${priceListName}">
                        <entity-find entity-name="zenith.erp.pricing.PriceList">
                            <econdition field-name="isActive" value="Y"/>
                            <econdition field-name="priceListId" operator="not-equals" from="priceListId"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="isDefault"><default-field title="Default?">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="isActive"><default-field title="Active?">
                    <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </default-field></field>
                <field name="validFromDate"><default-field title="Valid From"><date-time type="date"/></default-field></field>
                <field name="validThruDate"><default-field title="Valid Thru"><date-time type="date"/></default-field></field>
                <field name="submitBtn">
                    <conditional-field name="prc_plist_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                    <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                </field>
            </form-single>
        </container>

        <!-- Price List Items -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Price Items" type="h5" style="text-weight-bold q-my-none"/>
                <section name="prc_AddPriceItem_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddPriceItem" button-text="Add Item" type="success">
                    <form-single name="AddPriceItemForm" transition="setPriceItem">
                        <field name="priceListId"><default-field><hidden default-value="${priceListId}"/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <drop-down><entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="pseudoId"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="unitPrice"><default-field title="Unit Price"><text-line size="12" format="₹#,##0.00"/></default-field></field>
                        <field name="minQuantity"><default-field title="Min Qty"><text-line size="8" default-value="1"/></default-field></field>
                        <field name="maxQuantity"><default-field title="Max Qty"><text-line size="8"/></default-field></field>
                        <field name="changeReason"><default-field title="Reason"><text-line size="30"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>
            <form-list name="PriceItemsForm" list="priceItems" skip-form="true" show-csv-button="true" show-xlsx-button="true">
                <field name="pseudoId"><default-field title="SKU"><display/></default-field></field>
                <field name="productName"><default-field title="Product"><display/></default-field></field>
                <field name="unitPrice"><default-field title="Price"><display format="₹#,##0.00"/></default-field></field>
                <field name="minQuantity"><default-field title="Min Qty"><display/></default-field></field>
                <field name="maxQuantity"><default-field title="Max Qty"><display/></default-field></field>
                <field name="priceTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="prc_pitem_del_write" condition="modCanWrite" title="">
                    <link url="deletePriceItem" text="Remove" parameter-map="[priceListItemId:priceListItemId]"
                          confirmation="Remove this price item?" style="text-negative"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>

        <!-- Volume Pricing -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Volume / Quantity Break Pricing" type="h5" style="text-weight-bold q-my-none"/>
                <section name="prc_AddVolumePricing_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddVolumePricing" button-text="Add Volume Price" type="success">
                    <form-single name="AddVolumePricingForm" transition="setVolumePricing">
                        <field name="priceListId"><default-field><hidden default-value="${priceListId}"/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <drop-down><entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="pseudoId"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="minQuantity"><default-field title="Min Qty"><text-line size="8"/></default-field></field>
                        <field name="maxQuantity"><default-field title="Max Qty"><text-line size="8"/></default-field></field>
                        <field name="unitPrice"><default-field title="Unit Price"><text-line size="12" format="₹#,##0.00"/></default-field></field>
                        <field name="discountPercent"><default-field title="Or Discount %"><text-line size="8"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>
            <form-list name="VolumePricesForm" list="volumePrices" skip-form="true">
                <field name="productId"><default-field title="Product"><display/></default-field></field>
                <field name="minQuantity"><default-field title="Min Qty"><display/></default-field></field>
                <field name="maxQuantity"><default-field title="Max Qty"><display/></default-field></field>
                <field name="unitPrice"><default-field title="Price"><display format="₹#,##0.00"/></default-field></field>
                <field name="discountPercent"><default-field title="Discount %"><display format="#0.##"/></default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="prc_vol_del_write" condition="modCanWrite" title="">
                    <link url="deleteVolumePricing" text="Remove" parameter-map="[volumePricingId:volumePricingId]"
                          confirmation="Remove this volume price?" style="text-negative"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
