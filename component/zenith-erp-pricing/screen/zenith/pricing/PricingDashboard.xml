<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <transition name="findPriceList"><default-response url="../FindPriceList"/></transition>
    <transition name="editPriceList"><default-response url="../EditPriceList"/></transition>
    <transition name="findPricingRule"><default-response url="../FindPricingRule"/></transition>

    <actions>
        <entity-find-count entity-name="zenith.erp.pricing.PriceList" count-field="totalPriceLists">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <entity-find-count entity-name="zenith.erp.pricing.PriceListItem" count-field="totalPriceItems"/>

        <entity-find-count entity-name="zenith.erp.pricing.PricingRule" count-field="totalRules">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <entity-find-count entity-name="zenith.erp.pricing.VolumePricing" count-field="totalVolumePrices"/>

        <entity-find entity-name="zenith.erp.pricing.PriceChangeLog" list="recentChanges" limit="10">
            <order-by field-name="-changeDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Pricing Overview" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage price lists, volume pricing, and pricing rules across your organization." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <!-- Metrics Row -->
        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Price Lists" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalPriceLists}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="list_alt" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Priced Items" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalPriceItems}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="sell" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Pricing Rules" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalRules}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-orange-1 border-radius-md text-orange-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="rule" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>

            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Volume Prices" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalVolumePrices}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-purple-1 border-radius-md text-purple-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="trending_down" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Recent Price Changes -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <container style="row items-center justify-between q-mb-md">
                <label text="Recent Price Changes" type="h5" style="text-weight-bold q-my-none"/>
                <link url="PriceChangeHistory" text="View All" style="text-primary"/>
            </container>
            <form-list name="RecentChanges" list="recentChanges" skip-form="true">
                <field name="productId"><default-field title="Product">
                    <display/></default-field></field>
                <field name="previousPrice"><default-field title="Old Price">
                    <display format="₹#,##0.00"/></default-field></field>
                <field name="newPrice"><default-field title="New Price">
                    <display format="₹#,##0.00"/></default-field></field>
                <field name="changeReason"><default-field title="Reason">
                    <display/></default-field></field>
                <field name="changeDate"><default-field title="Changed">
                    <display format="dd-MMM-yyyy HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
