<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Recruitment" default-menu-index="6">

    <always-actions>
        <set field="html_title" value="Recruitment"/>
    </always-actions>

    <subscreens default-item="Applications"/>

    <transition name="goHr"><default-response url="/apps/zenith/Hr/Employees"/></transition>
    <transition name="goContacts"><default-response url="/apps/zenith/Contacts/FindContact"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_hr_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('hr'))"><widgets><link url="goHr" text="HR" icon="fa fa-users" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_contacts_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="goContacts" text="Contacts" icon="fa fa-address-book" btn-type="info" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
