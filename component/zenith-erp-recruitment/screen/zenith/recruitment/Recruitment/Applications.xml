<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Applications" default-menu-index="1">

    <transition name="createApplication">
        <service-call name="create#zenith.erp.recruitment.JobApplication"/>
        <default-response url="."/>
    </transition>

    <transition name="updateApplication">
        <service-call name="update#zenith.erp.recruitment.JobApplication"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Org isolation: JobApplication has no org column, so scope it via its parent JobRequisition's org.
             Mirrors the analytics _expOwnerIds pattern (empty set -> '__none__' sentinel so no cross-tenant leak;
             null when no active org -> ignore-if-empty leaves admins/no-org users seeing all). -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expReqIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.recruitment.JobRequisition" list="_expReqRows">
                <econdition field-name="organizationPartyId" from="_expOrg"/>
                <select-field field-name="requisitionId"/>
            </entity-find>
            <set field="_expReqIds" from="_expReqRows ? _expReqRows.collect{it.requisitionId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.recruitment.JobApplication" list="applicationList">
            <search-form-inputs default-order-by="-applicationDate"/>
            <econdition field-name="requisitionId" operator="in" from="_expReqIds" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.recruitment.JobRequisition" list="requisitionList">
            <order-by field-name="jobTitle"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <condition name="statusTypeId" value="JobApplication"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Candidate Applications"/><box-toolbar>
            <container-dialog id="NewApplicationDialog" button-text="New Application">
                <form-single name="NewApplicationForm" transition="createApplication">
                    <field name="candidateName"><default-field title="Candidate Name"><text-line size="40"/></default-field></field>
                    <field name="requisitionId"><default-field title="Applied Job">
                        <drop-down allow-empty="true">
                            <list-options list="requisitionList" key="${requisitionId}" text="${jobTitle}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                    <field name="phoneNumber"><default-field title="Phone"><text-line size="20"/></default-field></field>
                    <field name="source"><default-field title="Source"><text-line size="20"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="AppApplied">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="applicationDate"><default-field title="Application Date"><date-time/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <!-- High-volume Data Grid tuned for mass-hiring -->
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Applications..." style="display:none"></span>]]></text></render-mode>
            <form-list name="ApplicationListForm" list="applicationList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="applicationId">
                    <header-field title="App ID" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="candidateName">
                    <header-field title="Name" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="requisitionId">
                    <header-field title="Job">
                        <drop-down allow-empty="true">
                            <list-options list="requisitionList" key="${requisitionId}" text="${jobTitle}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display-entity entity-name="zenith.erp.recruitment.JobRequisition" text="${jobTitle}"/>
                    </default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                    </default-field>
                </field>
                <field name="source">
                    <header-field title="Source" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="applicationDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd HH:mm"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
