<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job Requisitions" default-menu-index="2">

    <transition name="createRequisition">
        <service-call name="create#zenith.erp.recruitment.JobRequisition"/>
        <default-response url="."/>
    </transition>

    <transition name="updateRequisition">
        <service-call name="update#zenith.erp.recruitment.JobRequisition"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.recruitment.JobRequisition" list="requisitionList">
            <search-form-inputs default-order-by="-targetHireDate"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <condition name="statusTypeId" value="JobRequisition"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Job Requisitions"/><box-toolbar>
            <container-dialog id="NewRequisitionDialog" button-text="New Requisition">
                <form-single name="NewRequisitionForm" transition="createRequisition">
                    <field name="jobTitle"><default-field title="Job Title"><text-line size="40"/></default-field></field>
                    <field name="openings"><default-field title="Openings"><text-line size="10"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="ReqDraft">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="targetHireDate"><default-field title="Target Hire Date"><date-time type="date"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="RequisitionListForm" list="requisitionList" skip-form="true" header-dialog="true">
                <field name="requisitionId">
                    <header-field title="ID" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="jobTitle">
                    <header-field title="Title" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="openings">
                    <header-field title="Openings" show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="targetHireDate">
                    <header-field title="Target Date" show-order-by="true"><date-find type="date"/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
