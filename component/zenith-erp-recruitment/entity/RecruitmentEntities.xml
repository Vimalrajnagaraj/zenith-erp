<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="JobRequisition" package="zenith.erp.recruitment">
        <field name="requisitionId" type="id" is-pk="true"/>
        <field name="jobTitle" type="text-short"/>
        <field name="departmentId" type="id"/>
        <field name="locationId" type="id"/>
        <field name="openings" type="number-integer"/>
        <field name="statusId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="requirements" type="text-long"/>
        <field name="targetHireDate" type="date"/>
        <relationship type="one" title="Department" related="mantle.party.Party">
            <key-map field-name="departmentId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="JobRequisition" description="Job Requisition Status"/>
            <moqui.basic.StatusItem statusId="ReqDraft" statusTypeId="JobRequisition" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="ReqOpen" statusTypeId="JobRequisition" description="Open" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="ReqClosed" statusTypeId="JobRequisition" description="Closed" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ReqDraft" toStatusId="ReqOpen" transitionName="Open"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ReqOpen" toStatusId="ReqClosed" transitionName="Close"/>
        </seed-data>
    </entity>

    <entity entity-name="JobApplication" package="zenith.erp.recruitment">
        <field name="applicationId" type="id" is-pk="true"/>
        <field name="requisitionId" type="id"/>
        <field name="candidateName" type="text-medium"/>
        <field name="emailAddress" type="text-short"/>
        <field name="phoneNumber" type="text-short"/>
        <field name="statusId" type="id"/>
        <field name="applicationDate" type="date-time"/>
        <field name="resumeUrl" type="text-medium"/>
        <field name="notes" type="text-long"/>
        <field name="source" type="text-short"><description>e.g., Naukri, LinkedIn, Walk-in</description></field>
        <relationship type="one" related="zenith.erp.recruitment.JobRequisition"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="JobApplication" description="Job Application Status"/>
            <moqui.basic.StatusItem statusId="AppApplied" statusTypeId="JobApplication" description="Applied" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="AppScreening" statusTypeId="JobApplication" description="Screening" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="AppInterview" statusTypeId="JobApplication" description="Interviewing" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="AppOffered" statusTypeId="JobApplication" description="Offered" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="AppHired" statusTypeId="JobApplication" description="Hired" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="AppRejected" statusTypeId="JobApplication" description="Rejected" sequenceNum="6"/>
        </seed-data>
    </entity>

</entities>
