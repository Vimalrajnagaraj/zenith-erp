<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ============================================================================
         Shared India-GST calculator for subscription billing.
         Resolves the supplier (tenant org) state vs the buyer (customer) state and routes the
         tax through the canonical engine zenith.india.GstServices.calculate#Gst, returning the
         CGST/SGST (intra-state) or IGST (inter-state) split plus place-of-supply.

         TAX MODEL: prices are treated as tax-EXCLUSIVE (tax is ADDED on top of taxableAmount),
         exactly as the original flat calc did. We only SPLIT that tax into heads + add a
         place-of-supply; totalAmount stays = taxableAmount + tax. The returned taxAmount equals
         the sum of the heads, so totals are preserved.
         >>> If subscription prices are ever meant to be GST-INCLUSIVE, this must be revisited
             (e.g. back the base out first via zenith.india.GstServices.calculate#TaxInclusive). <<<

         STATE RESOLUTION (flagged assumptions, see report):
           supplier state = IndiaGstConfig[org].stateCode, else the org's active IndiaGstin.
           buyer state    = the customer's active IndiaGstin.stateCode (or GSTIN's first 2 digits).
           If the buyer has no GSTIN on file we ASSUME an intra-state supply in the supplier's own
           state (the common B2C / same-state case) -> CGST+SGST.
         FALLBACK: if supplier state, buyer state, or a matching GST slab is not configured, we fall
         back to the original flat exclusive calc (single tax, no head split) so this latent module
         never errors. -->
    <service verb="calculate" noun="SubscriptionTax">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/> <!-- supplier (tenant) org -->
            <parameter name="customerPartyId"/>                      <!-- buyer -->
            <parameter name="taxableAmount" type="BigDecimal" required="true"/>
            <parameter name="gstRate" type="BigDecimal"/>
            <parameter name="productTaxCode"/>                       <!-- optional HSN/SAC for slab lookup -->
        </in-parameters>
        <out-parameters>
            <parameter name="taxAmount" type="BigDecimal"/>
            <parameter name="cgstAmount" type="BigDecimal"/>
            <parameter name="sgstAmount" type="BigDecimal"/>
            <parameter name="igstAmount" type="BigDecimal"/>
            <parameter name="totalAmount" type="BigDecimal"/>
            <parameter name="placeOfSupply"/>
            <parameter name="supplyType"/>
        </out-parameters>
        <actions>
            <set field="gstRate" from="gstRate ?: 18" type="BigDecimal"/>

            <!-- Supplier (tenant org) state: GST config first, else its active GSTIN -->
            <set field="supplierStateCode" from="null"/>
            <entity-find-one entity-name="zenith.erp.india.IndiaGstConfig" value-field="supCfg">
                <field-map field-name="organizationPartyId"/>
            </entity-find-one>
            <if condition="supCfg?.stateCode"><set field="supplierStateCode" from="supCfg.stateCode"/></if>
            <if condition="!supplierStateCode">
                <entity-find entity-name="zenith.erp.india.IndiaGstin" list="supGstins">
                    <econdition field-name="partyId" from="organizationPartyId"/>
                    <econdition field-name="isActive" value="Y"/>
                    <order-by field-name="-lastUpdatedStamp"/>
                    <limit count="1"/>
                </entity-find>
                <if condition="supGstins">
                    <set field="supplierStateCode" from="supGstins[0].stateCode ?: (supGstins[0].gstin ? supGstins[0].gstin.substring(0,2) : null)"/>
                </if>
            </if>

            <!-- Buyer (customer) state: its active GSTIN -->
            <set field="buyerStateCode" from="null"/>
            <if condition="customerPartyId">
                <entity-find entity-name="zenith.erp.india.IndiaGstin" list="buyGstins">
                    <econdition field-name="partyId" from="customerPartyId"/>
                    <econdition field-name="isActive" value="Y"/>
                    <order-by field-name="-lastUpdatedStamp"/>
                    <limit count="1"/>
                </entity-find>
                <if condition="buyGstins">
                    <set field="buyerStateCode" from="buyGstins[0].stateCode ?: (buyGstins[0].gstin ? buyGstins[0].gstin.substring(0,2) : null)"/>
                </if>
            </if>

            <!-- Resolve GST slab: HSN/SAC default first, else exact rate match
                 (exclude cess and composition slabs so the base GST_x slab wins). -->
            <set field="gstSlabId" from="null"/>
            <if condition="productTaxCode">
                <entity-find-one entity-name="zenith.erp.india.IndiaHsnCode" value-field="hsn">
                    <field-map field-name="hsnCode" from="productTaxCode"/>
                </entity-find-one>
                <if condition="hsn?.defaultGstSlabId"><set field="gstSlabId" from="hsn.defaultGstSlabId"/></if>
            </if>
            <if condition="!gstSlabId">
                <entity-find entity-name="zenith.erp.india.IndiaGstSlab" list="slabs">
                    <econdition field-name="gstRate" from="gstRate"/>
                    <econdition field-name="cessRate" from="0"/>
                    <econdition field-name="isActive" value="Y"/>
                    <econdition field-name="gstSlabId" operator="not-like" value="COMP%"/>
                    <order-by field-name="gstSlabId"/>
                    <limit count="1"/>
                </entity-find>
                <if condition="slabs"><set field="gstSlabId" from="slabs[0].gstSlabId"/></if>
            </if>

            <!-- Buyer state unknown -> assume intra-state supply in the supplier's state (FLAGGED). -->
            <if condition="supplierStateCode &amp;&amp; !buyerStateCode"><set field="buyerStateCode" from="supplierStateCode"/></if>

            <if condition="supplierStateCode &amp;&amp; buyerStateCode &amp;&amp; gstSlabId">
                <then>
                    <service-call name="zenith.india.GstServices.calculate#Gst"
                                  in-map="[supplierStateCode:supplierStateCode, buyerStateCode:buyerStateCode,
                                           gstSlabId:gstSlabId, taxableAmount:taxableAmount]"
                                  out-map="gstOut"/>
                    <set field="cgstAmount" from="gstOut.cgstAmount"/>
                    <set field="sgstAmount" from="gstOut.sgstAmount"/>
                    <set field="igstAmount" from="gstOut.igstAmount"/>
                    <set field="taxAmount" from="gstOut.totalTaxAmount"/>
                    <set field="totalAmount" from="gstOut.totalAmount"/>
                    <set field="placeOfSupply" from="buyerStateCode"/>
                    <set field="supplyType" from="gstOut.supplyType"/>
                </then>
                <else>
                    <!-- Fallback: original flat, tax-EXCLUSIVE calc, no head split. -->
                    <set field="taxAmount" from="(taxableAmount * gstRate / 100).setScale(2, java.math.RoundingMode.HALF_UP)"/>
                    <set field="totalAmount" from="taxableAmount + taxAmount"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="create" noun="Subscription">
        <in-parameters>
            <parameter name="customerPartyId" required="true"/>
            <parameter name="planId" required="true"/>
            <parameter name="paymentMethodId"/>
            <parameter name="discountCode"/>
            <parameter name="notes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="subscriptionId"/>
            <parameter name="subscriptionNumber"/>
        </out-parameters>
        <actions>
            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <!-- A subscription is a tenant-owned billing record: refuse to create an orphan (no active org).
                 Tenant users always have a valid active org; super-admins must switch into an org first. -->
            <if condition="!organizationPartyId">
                <return error="true" message="No active organization is selected. Please switch to the organization that should own this subscription before creating it, so it is billed under the correct tenant."/>
            </if>
            <!-- ZE-SB-013 (multi-tenant isolation): the customer must belong to THIS org. customerPartyId is a
                 free-text field, so a foreign-tenant (or mistyped) partyId would otherwise be billed as the
                 tenant's own customer — a cross-tenant isolation failure (wrong party's GST/place-of-supply, and
                 it stamps another tenant's customer onto this org's billing records). Read with disableAuthz so
                 a foreign party is visible for the ownership check; reject unless owned by the active org.
                 Super-admin (ADMIN) is exempt — they manage across orgs (a no-org admin was already refused). -->
            <if condition="!ec.user.isInGroup('ADMIN')">
                <set field="_custOwner" from="ec.entity.find('mantle.party.Party').condition('partyId', customerPartyId).disableAuthz().one()?.ownerPartyId"/>
                <if condition="_custOwner != organizationPartyId">
                    <return error="true" message="That customer isn't part of your organization. Choose one of your own customers."/>
                </if>
            </if>
            <entity-find-one entity-name="zenith.erp.subscriptions.SubscriptionPlan" value-field="plan"/>
            <if condition="!plan"><return error="true" message="Plan not found"/></if>
            <!-- ZE-SB-013 f/u: same isolation guard on the plan — the plan dropdown is org-scoped, but a forged
                 planId must not slip another tenant's plan/pricing onto this subscription. (Global org=NULL seed
                 plans are platform-only and not tenant-billable, so a tenant plan must be its own org's.) -->
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; plan.organizationPartyId != organizationPartyId">
                <return error="true" message="That plan isn't part of your organization."/>
            </if>

            <!-- Generate SUB/FY/SEQ number -->
            <set field="cal" from="java.util.Calendar.getInstance()"/>
            <script>cal.setTime(now)</script>
            <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
            <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>
            <set field="fyStart" from="month &gt;= 4 ? year : year - 1"/>
            <set field="fyStr" from="String.format('%02d-%02d', fyStart % 100, (fyStart + 1) % 100)"/>

            <!-- Per-tenant consecutive series: scope the max-suffix lookup to THIS supplier org so each
                 tenant gets its own SUB/FY/NNNNN sequence (GST consecutiveness; no cross-tenant leakage). -->
            <entity-find entity-name="zenith.erp.subscriptions.Subscription" list="existing">
                <econdition field-name="organizationPartyId" from="organizationPartyId"/>
                <econdition field-name="subscriptionNumber" operator="like" value="SUB/${fyStr}/%"/>
                <order-by field-name="-subscriptionNumber"/>
                <limit count="1"/>
            </entity-find>
            <set field="seq" from="1"/>
            <if condition="existing">
                <set field="lastNum" from="existing[0].subscriptionNumber"/>
                <set field="seq" from="(lastNum.substring(lastNum.lastIndexOf('/') + 1) as Integer) + 1"/>
            </if>
            <set field="subscriptionNumber" from="'SUB/' + fyStr + '/' + String.format('%05d', seq)"/>

            <!-- Calculate dates -->
            <set field="startDate" from="now"/>
            <set field="trialDays" from="plan.trialDays ?: 0" type="Integer"/>
            <set field="hasTrial" from="trialDays &gt; 0" type="Boolean"/>

            <set field="calEnd" from="java.util.Calendar.getInstance()"/>
            <script>calEnd.setTime(now)</script>
            <if condition="hasTrial">
                <script>calEnd.add(java.util.Calendar.DAY_OF_MONTH, trialDays as int)</script>
                <set field="trialEndDate" from="new java.sql.Timestamp(calEnd.getTimeInMillis())"/>
            </if>

            <!-- Calculate end date based on billing frequency -->
            <set field="calBill" from="java.util.Calendar.getInstance()"/>
            <script>calBill.setTime(hasTrial ? trialEndDate : now)</script>
            <if condition="plan.billingFrequency == 'BfMonthly'">
                <script>calBill.add(java.util.Calendar.MONTH, 1)</script>
                <else-if condition="plan.billingFrequency == 'BfQuarterly'">
                    <script>calBill.add(java.util.Calendar.MONTH, 3)</script>
                </else-if>
                <else-if condition="plan.billingFrequency == 'BfHalfYearly'">
                    <script>calBill.add(java.util.Calendar.MONTH, 6)</script>
                </else-if>
                <else-if condition="plan.billingFrequency == 'BfAnnually'">
                    <script>calBill.add(java.util.Calendar.YEAR, 1)</script>
                </else-if>
            </if>
            <set field="nextBillingDate" from="hasTrial ? trialEndDate : new java.sql.Timestamp(calBill.getTimeInMillis())"/>
            <set field="endDate" from="new java.sql.Timestamp(calBill.getTimeInMillis())"/>

            <!-- Calculate GST (split into CGST/SGST/IGST via the India engine; tax-EXCLUSIVE total preserved) -->
            <set field="billingAmount" from="plan.billingAmount"/>
            <set field="gstRate" from="plan.taxRate ?: 18"/>
            <service-call name="zenith.subscriptions.SubscriptionServices.calculate#SubscriptionTax"
                          in-map="[organizationPartyId:organizationPartyId, customerPartyId:customerPartyId,
                                   taxableAmount:billingAmount, gstRate:gstRate, productTaxCode:plan.productTaxCode]"
                          out-map="taxOut"/>
            <set field="gstAmount" from="taxOut.taxAmount"/>
            <set field="cgstAmount" from="taxOut.cgstAmount"/>
            <set field="sgstAmount" from="taxOut.sgstAmount"/>
            <set field="igstAmount" from="taxOut.igstAmount"/>
            <set field="placeOfSupply" from="taxOut.placeOfSupply"/>
            <set field="totalAmount" from="taxOut.totalAmount"/>

            <!-- Apply discount if any (only within validity window and use limit, scoped to this tenant) -->
            <if condition="discountCode">
                <entity-find entity-name="zenith.erp.subscriptions.SubscriptionDiscount" list="discList">
                    <econdition field-name="discountCode"/>
                    <econdition field-name="isActive" value="Y"/>
                    <econdition field-name="organizationPartyId" from="organizationPartyId" ignore-if-empty="true"/>
                    <limit count="1"/>
                </entity-find>
                <if condition="discList">
                    <set field="disc" from="discList[0]"/>
                    <set field="discValid" from="true" type="Boolean"/>
                    <if condition="disc.validFrom != null &amp;&amp; now.before(disc.validFrom)"><set field="discValid" from="false" type="Boolean"/></if>
                    <if condition="disc.validTo != null &amp;&amp; now.after(disc.validTo)"><set field="discValid" from="false" type="Boolean"/></if>
                    <if condition="disc.maxUses != null &amp;&amp; (disc.usedCount ?: 0) &gt;= disc.maxUses"><set field="discValid" from="false" type="Boolean"/></if>
                    <if condition="!discValid">
                        <return error="true" message="Discount code '${discountCode}' is not valid (expired, not yet active, or usage limit reached)."/>
                    </if>
                    <if condition="disc.discountType == 'DtPercentage'">
                        <set field="discAmt" from="(billingAmount * disc.discountValue / 100).setScale(2, java.math.RoundingMode.HALF_UP)"/>
                        <set field="billingAmount" from="billingAmount - discAmt"/>
                        <else-if condition="disc.discountType == 'DtFlat'">
                            <set field="billingAmount" from="billingAmount - disc.discountValue"/>
                        </else-if>
                    </if>
                    <!-- Recompute the GST split on the discounted base (still tax-EXCLUSIVE) -->
                    <service-call name="zenith.subscriptions.SubscriptionServices.calculate#SubscriptionTax"
                                  in-map="[organizationPartyId:organizationPartyId, customerPartyId:customerPartyId,
                                           taxableAmount:billingAmount, gstRate:gstRate, productTaxCode:plan.productTaxCode]"
                                  out-map="taxOut"/>
                    <set field="gstAmount" from="taxOut.taxAmount"/>
                    <set field="cgstAmount" from="taxOut.cgstAmount"/>
                    <set field="sgstAmount" from="taxOut.sgstAmount"/>
                    <set field="igstAmount" from="taxOut.igstAmount"/>
                    <set field="placeOfSupply" from="taxOut.placeOfSupply"/>
                    <set field="totalAmount" from="taxOut.totalAmount"/>
                    <set field="disc.usedCount" from="(disc.usedCount ?: 0) + 1"/>
                    <entity-update value-field="disc"/>
                </if>
            </if>

            <set field="statusId" from="hasTrial ? 'SubTrial' : 'SubActive'"/>

            <service-call name="create#zenith.erp.subscriptions.Subscription"
                          in-map="[subscriptionId:subscriptionId, subscriptionNumber:subscriptionNumber,
                                   customerPartyId:customerPartyId, planId:planId, statusId:statusId,
                                   organizationPartyId:organizationPartyId,
                                   startDate:startDate, endDate:endDate, trialEndDate:trialEndDate,
                                   nextBillingDate:nextBillingDate, billingAmount:billingAmount,
                                   currencyUomId:(plan.currencyUomId ?: 'USD'), gstAmount:gstAmount,
                                   cgstAmount:cgstAmount, sgstAmount:sgstAmount, igstAmount:igstAmount, placeOfSupply:placeOfSupply,
                                   totalAmount:totalAmount,
                                   paymentMethodId:paymentMethodId, autoRenew:plan.autoRenew, notes:notes]"
                          out-map="createOut"/>
            <set field="subscriptionId" from="createOut.subscriptionId"/>

            <!-- Log activity -->
            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaCreated',
                                   activityDate:now, description:'Subscription created on plan ' + plan.planName,
                                   performedByPartyId:ec.user.userAccount?.partyId]"/>
        </actions>
    </service>

    <service verb="activate" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <!-- Ownership guard: a tenant user may only mutate subscriptions owned by their active org (ADMIN exempt).
                 Same generic message whether missing or cross-tenant, to avoid leaking existence across tenants. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found"/>
            </if>
            <if condition="sub.statusId != 'SubTrial'">
                <return error="true" message="Only trial subscriptions can be activated"/>
            </if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="sub.statusId" value="SubActive"/>
            <entity-update value-field="sub"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaActivated',
                                   activityDate:now, description:'Subscription activated from trial',
                                   performedByPartyId:ec.user.userAccount?.partyId,
                                   oldValue:'SubTrial', newValue:'SubActive']"/>
        </actions>
    </service>

    <service verb="pause" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
            <parameter name="reason"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found"/>
            </if>
            <if condition="sub.statusId != 'SubActive'">
                <return error="true" message="Only active subscriptions can be paused"/>
            </if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="sub.statusId" value="SubPaused"/>
            <entity-update value-field="sub"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaPaused',
                                   activityDate:now, description:reason ?: 'Subscription paused',
                                   performedByPartyId:ec.user.userAccount?.partyId,
                                   oldValue:'SubActive', newValue:'SubPaused']"/>
        </actions>
    </service>

    <service verb="resume" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found"/>
            </if>
            <if condition="sub.statusId != 'SubPaused'">
                <return error="true" message="Only paused subscriptions can be resumed"/>
            </if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="sub.statusId" value="SubActive"/>
            <entity-update value-field="sub"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaResumed',
                                   activityDate:now, description:'Subscription resumed',
                                   performedByPartyId:ec.user.userAccount?.partyId,
                                   oldValue:'SubPaused', newValue:'SubActive']"/>
        </actions>
    </service>

    <service verb="cancel" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
            <parameter name="cancelReason" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found"/>
            </if>
            <if condition="sub.statusId == 'SubCancelled' || sub.statusId == 'SubExpired'">
                <return error="true" message="Subscription is already cancelled or expired"/>
            </if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="oldStatus" from="sub.statusId"/>
            <set field="sub.statusId" value="SubCancelled"/>
            <set field="sub.cancelReason" from="cancelReason"/>
            <set field="sub.cancelDate" from="now"/>
            <entity-update value-field="sub"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaCancelled',
                                   activityDate:now, description:cancelReason,
                                   performedByPartyId:ec.user.userAccount?.partyId,
                                   oldValue:oldStatus, newValue:'SubCancelled']"/>
        </actions>
    </service>

    <service verb="renew" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <!-- Org-isolation: only the owning tenant (or an ADMIN, or an un-scoped billing job) may act on
                 this subscription — block cross-tenant view/mutate/bill via a guessed id. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found for your account."/>
            </if>
            <entity-find-one entity-name="zenith.erp.subscriptions.SubscriptionPlan" value-field="plan">
                <field-map field-name="planId" from="sub.planId"/>
            </entity-find-one>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="sub.lastBillingDate" from="now"/>
            <set field="sub.statusId" value="SubActive"/>

            <!-- Advance end date and next billing -->
            <set field="calNext" from="java.util.Calendar.getInstance()"/>
            <script>calNext.setTime(sub.endDate ?: now)</script>
            <if condition="plan.billingFrequency == 'BfMonthly'">
                <script>calNext.add(java.util.Calendar.MONTH, 1)</script>
                <else-if condition="plan.billingFrequency == 'BfQuarterly'">
                    <script>calNext.add(java.util.Calendar.MONTH, 3)</script>
                </else-if>
                <else-if condition="plan.billingFrequency == 'BfHalfYearly'">
                    <script>calNext.add(java.util.Calendar.MONTH, 6)</script>
                </else-if>
                <else-if condition="plan.billingFrequency == 'BfAnnually'">
                    <script>calNext.add(java.util.Calendar.YEAR, 1)</script>
                </else-if>
            </if>
            <set field="sub.endDate" from="new java.sql.Timestamp(calNext.getTimeInMillis())"/>
            <set field="sub.nextBillingDate" from="new java.sql.Timestamp(calNext.getTimeInMillis())"/>
            <entity-update value-field="sub"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId, activityType:'SaRenewed',
                                   activityDate:now, description:'Subscription renewed',
                                   performedByPartyId:ec.user.userAccount?.partyId]"/>
        </actions>
    </service>

    <service verb="generate" noun="Invoice">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="subInvoiceId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <!-- Org-isolation: only the owning tenant (or an ADMIN, or an un-scoped billing job) may act on
                 this subscription — block cross-tenant view/mutate/bill via a guessed id. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found for your account."/>
            </if>
            <entity-find-one entity-name="zenith.erp.subscriptions.SubscriptionPlan" value-field="plan">
                <field-map field-name="planId" from="sub.planId"/>
            </entity-find-one>

            <set field="now" from="ec.user.nowTimestamp"/>

            <!-- Generate invoice number: SINV/FY/SEQ -->
            <set field="cal" from="java.util.Calendar.getInstance()"/>
            <script>cal.setTime(now)</script>
            <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
            <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>
            <set field="fyStart" from="month &gt;= 4 ? year : year - 1"/>
            <set field="fyStr" from="String.format('%02d-%02d', fyStart % 100, (fyStart + 1) % 100)"/>

            <!-- Per-tenant consecutive series: scope to THIS supplier org so each tenant gets its own
                 SINV/FY/NNNNN sequence (GST consecutiveness; no cross-tenant number leakage), like SUB. -->
            <entity-find entity-name="zenith.erp.subscriptions.SubscriptionInvoice" list="existingInv">
                <econdition field-name="organizationPartyId" from="sub.organizationPartyId"/>
                <econdition field-name="invoiceNumber" operator="like" value="SINV/${fyStr}/%"/>
                <order-by field-name="-invoiceNumber"/>
                <limit count="1"/>
            </entity-find>
            <set field="seq" from="1"/>
            <if condition="existingInv">
                <set field="lastNum" from="existingInv[0].invoiceNumber"/>
                <set field="seq" from="(lastNum.substring(lastNum.lastIndexOf('/') + 1) as Integer) + 1"/>
            </if>
            <set field="invoiceNumber" from="'SINV/' + fyStr + '/' + String.format('%05d', seq)"/>

            <!-- One-time setup fee is charged on the FIRST invoice only -->
            <entity-find entity-name="zenith.erp.subscriptions.SubscriptionInvoice" list="priorInv">
                <econdition field-name="subscriptionId"/>
                <limit count="1"/>
            </entity-find>
            <set field="setupFee" from="!priorInv ? (plan.setupFee ?: 0) : 0"/>
            <set field="baseAmount" from="(sub.billingAmount ?: 0) + setupFee"/>
            <set field="taxableAmount" from="baseAmount"/>
            <!-- Proper GST head split (CGST+SGST intra vs IGST inter) via the same India engine used at
                 create time, so the ISSUED invoice carries cgst/sgst/igst + place of supply, not a flat lump. -->
            <service-call name="zenith.subscriptions.SubscriptionServices.calculate#SubscriptionTax"
                          in-map="[organizationPartyId:sub.organizationPartyId, customerPartyId:sub.customerPartyId,
                                   taxableAmount:taxableAmount, gstRate:(plan.taxRate ?: 18),
                                   productTaxCode:plan.productTaxCode]" out-map="taxOut"/>
            <set field="taxAmount" from="taxOut.taxAmount"/>
            <set field="totalAmount" from="(taxableAmount + taxAmount).setScale(2, java.math.RoundingMode.HALF_UP)"/>

            <set field="periodFrom" from="sub.lastBillingDate ?: sub.startDate"/>
            <set field="periodTo" from="sub.nextBillingDate ?: sub.endDate"/>

            <service-call name="create#zenith.erp.subscriptions.SubscriptionInvoice"
                          in-map="[subscriptionId:subscriptionId, invoiceNumber:invoiceNumber,
                                   invoiceDate:now, periodFrom:periodFrom, periodTo:periodTo,
                                   baseAmount:baseAmount, discountAmount:0, taxableAmount:taxableAmount,
                                   totalTaxAmount:taxAmount, cgstAmount:taxOut.cgstAmount, sgstAmount:taxOut.sgstAmount,
                                   igstAmount:taxOut.igstAmount, placeOfSupply:taxOut.placeOfSupply,
                                   supplyType:taxOut.supplyType, totalAmount:totalAmount, currencyUomId:sub.currencyUomId,
                                   organizationPartyId:sub.organizationPartyId, statusId:'SiDraft']"
                          out-map="invOut"/>
            <set field="subInvoiceId" from="invOut.subInvoiceId"/>
        </actions>
    </service>

    <service verb="changePlan" noun="Subscription">
        <in-parameters>
            <parameter name="subscriptionId" required="true"/>
            <parameter name="newPlanId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
            <!-- Org-isolation: only the owning tenant (or an ADMIN, or an un-scoped billing job) may act on
                 this subscription — block cross-tenant view/mutate/bill via a guessed id. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="sub == null || (activeOrg &amp;&amp; sub.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Subscription not found for your account."/>
            </if>
            <entity-find-one entity-name="zenith.erp.subscriptions.SubscriptionPlan" value-field="newPlan">
                <field-map field-name="planId" from="newPlanId"/>
            </entity-find-one>
            <if condition="!newPlan"><return error="true" message="New plan not found"/></if>

            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="oldPlanId" from="sub.planId"/>
            <set field="oldBillingAmount" from="sub.billingAmount ?: 0"/>
            <set field="sub.planId" from="newPlanId"/>
            <set field="sub.billingAmount" from="newPlan.billingAmount"/>
            <set field="gstRate" from="newPlan.taxRate ?: 18"/>
            <set field="sub.gstAmount" from="(newPlan.billingAmount * gstRate / 100).setScale(2, java.math.RoundingMode.HALF_UP)"/>
            <set field="sub.totalAmount" from="sub.billingAmount + sub.gstAmount"/>
            <entity-update value-field="sub"/>

            <set field="isUpgrade" from="newPlan.billingAmount &gt; oldBillingAmount" type="Boolean"/>
            <service-call name="create#zenith.erp.subscriptions.SubscriptionActivity"
                          in-map="[subscriptionId:subscriptionId,
                                   activityType:isUpgrade ? 'SaUpgraded' : 'SaDowngraded',
                                   activityDate:now, description:'Plan changed to ' + newPlan.planName,
                                   performedByPartyId:ec.user.userAccount?.partyId,
                                   oldValue:oldPlanId, newValue:newPlanId]"/>
        </actions>
    </service>

    <!-- ===== Recurring billing: bill + advance every DUE Active subscription in one call =====
         Unifies the two previously-manual, decoupled steps (Generate Invoice + Renew). Idempotent
         (skips a period already invoiced) and org-agnostic (bills every tenant's due subs), so it is
         safe to run repeatedly and can be wired to a scheduled ServiceJob to automate recurring billing.
         Left MANUAL-run by default (no live cron seeded) — enabling automatic billing is a go-live
         decision for the dev. Run on demand: zenith.subscriptions.SubscriptionServices.process#DueSubscriptions -->
    <service verb="process" noun="DueSubscriptions" authenticate="anonymous-all">
        <in-parameters>
            <parameter name="organizationPartyId"/> <!-- optional: restrict to one tenant (else all) -->
        </in-parameters>
        <out-parameters>
            <parameter name="billedCount" type="Integer"/>
            <parameter name="skippedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <script>ec.user.loginAnonymousIfNoUser()</script>
            <set field="billedCount" from="0" type="Integer"/>
            <set field="skippedCount" from="0" type="Integer"/>
            <set field="today" from="ec.user.nowTimestamp"/>
            <entity-find entity-name="zenith.erp.subscriptions.Subscription" list="dueList">
                <econdition field-name="statusId" value="SubActive"/>
                <econdition field-name="nextBillingDate" operator="less-equals" from="today"/>
                <econdition field-name="organizationPartyId" from="organizationPartyId" ignore-if-empty="true"/>
            </entity-find>
            <iterate list="dueList" entry="dueSub">
                <!-- Idempotent: skip if the current period (periodTo == this next-billing date) is already invoiced. -->
                <entity-find entity-name="zenith.erp.subscriptions.SubscriptionInvoice" list="periodInv">
                    <econdition field-name="subscriptionId" from="dueSub.subscriptionId"/>
                    <econdition field-name="periodTo" from="dueSub.nextBillingDate"/>
                    <limit count="1"/>
                </entity-find>
                <if condition="periodInv">
                    <then><set field="skippedCount" from="skippedCount + 1"/></then>
                    <else>
                        <service-call name="zenith.subscriptions.SubscriptionServices.generate#Invoice"
                                      in-map="[subscriptionId:dueSub.subscriptionId]"/>
                        <service-call name="zenith.subscriptions.SubscriptionServices.renew#Subscription"
                                      in-map="[subscriptionId:dueSub.subscriptionId]"/>
                        <set field="billedCount" from="billedCount + 1"/>
                    </else>
                </if>
            </iterate>
        </actions>
    </service>

</services>
