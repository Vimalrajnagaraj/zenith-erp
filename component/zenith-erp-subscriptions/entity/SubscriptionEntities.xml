<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Subscription Plan -->
    <entity entity-name="SubscriptionPlan" package="zenith.erp.subscriptions" short-alias="SubscriptionPlans">
        <field name="planId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="planName" type="text-medium"/>
        <field name="planCode" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="productId" type="id"/>
        <field name="billingFrequency" type="id"/>
        <field name="billingAmount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="setupFee" type="currency-precise" default="0"/>
        <field name="trialDays" type="number-integer" default="0"/>
        <field name="taxRate" type="number-decimal"/>
        <field name="productTaxCode" type="text-short"/>
        <field name="maxUsers" type="number-integer"/>
        <field name="maxStorage" type="text-short"/>
        <field name="features" type="text-long"/>
        <field name="autoRenew" type="text-indicator" default="'Y'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="BillingFrequency" description="Billing Frequency"/>
            <moqui.basic.Enumeration enumId="BfMonthly" enumTypeId="BillingFrequency" description="Monthly" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BfQuarterly" enumTypeId="BillingFrequency" description="Quarterly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BfHalfYearly" enumTypeId="BillingFrequency" description="Half-Yearly" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="BfAnnually" enumTypeId="BillingFrequency" description="Annually" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="BfOneTime" enumTypeId="BillingFrequency" description="One-Time" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- Plan Tier (volume/usage-based pricing) -->
    <entity entity-name="PlanTier" package="zenith.erp.subscriptions" short-alias="PlanTiers">
        <field name="planTierId" type="id" is-pk="true"/>
        <field name="planId" type="id"/>
        <field name="tierName" type="text-medium"/>
        <field name="fromQuantity" type="number-integer"/>
        <field name="toQuantity" type="number-integer"/>
        <field name="unitPrice" type="currency-precise"/>
        <field name="flatPrice" type="currency-precise"/>
        <field name="sequenceNum" type="number-integer"/>
        <relationship type="one" related="zenith.erp.subscriptions.SubscriptionPlan"/>
    </entity>

    <!-- Subscription (customer's active subscription) -->
    <entity entity-name="Subscription" package="zenith.erp.subscriptions" table-name="ZENITH_SUBSCRIPTION" short-alias="Subscriptions">
        <field name="subscriptionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="subscriptionNumber" type="text-short"/>
        <field name="customerPartyId" type="id"/>
        <field name="planId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="startDate" type="date-time"/>
        <field name="endDate" type="date-time"/>
        <field name="trialEndDate" type="date-time"/>
        <field name="nextBillingDate" type="date-time"/>
        <field name="lastBillingDate" type="date-time"/>
        <field name="billingAmount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="gstAmount" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="paymentMethodId" type="id"/>
        <field name="externalSubscriptionId" type="text-medium"/>
        <field name="autoRenew" type="text-indicator" default="'Y'"/>
        <field name="cancelReason" type="text-medium"/>
        <field name="cancelDate" type="date-time"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.subscriptions.SubscriptionPlan"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Subscription" description="Subscription"/>
            <moqui.basic.StatusItem statusId="SubTrial" statusTypeId="Subscription" description="Trial" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SubActive" statusTypeId="Subscription" description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SubPastDue" statusTypeId="Subscription" description="Past Due" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SubPaused" statusTypeId="Subscription" description="Paused" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="SubCancelled" statusTypeId="Subscription" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="SubExpired" statusTypeId="Subscription" description="Expired" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubTrial" toStatusId="SubActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubTrial" toStatusId="SubCancelled" transitionName="Cancel Trial"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubActive" toStatusId="SubPaused" transitionName="Pause"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubActive" toStatusId="SubCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubActive" toStatusId="SubPastDue" transitionName="Payment Failed"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubActive" toStatusId="SubExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubPaused" toStatusId="SubActive" transitionName="Resume"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubPaused" toStatusId="SubCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubPastDue" toStatusId="SubActive" transitionName="Payment Received"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SubPastDue" toStatusId="SubCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- Subscription Invoice -->
    <entity entity-name="SubscriptionInvoice" package="zenith.erp.subscriptions" short-alias="SubscriptionInvoices">
        <field name="subInvoiceId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="subscriptionId" type="id"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="invoiceDate" type="date-time"/>
        <field name="periodFrom" type="date-time"/>
        <field name="periodTo" type="date-time"/>
        <field name="baseAmount" type="currency-precise"/>
        <field name="discountAmount" type="currency-precise" default="0"/>
        <field name="taxableAmount" type="currency-precise"/>
        <field name="totalTaxAmount" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="paidDate" type="date-time"/>
        <field name="paymentReference" type="text-medium"/>
        <field name="paymentMethod" type="id"/>
        <relationship type="one" related="zenith.erp.subscriptions.Subscription"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="SubInvoice" description="Subscription Invoice"/>
            <moqui.basic.StatusItem statusId="SiDraft" statusTypeId="SubInvoice" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SiSent" statusTypeId="SubInvoice" description="Sent" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SiPaid" statusTypeId="SubInvoice" description="Paid" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SiOverdue" statusTypeId="SubInvoice" description="Overdue" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="SiCancelled" statusTypeId="SubInvoice" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="SiRefunded" statusTypeId="SubInvoice" description="Refunded" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiDraft" toStatusId="SiSent" transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiSent" toStatusId="SiPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiSent" toStatusId="SiOverdue" transitionName="Mark Overdue"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiOverdue" toStatusId="SiPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiPaid" toStatusId="SiRefunded" transitionName="Refund"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SiDraft" toStatusId="SiCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- Subscription Usage (metered billing) -->
    <entity entity-name="SubscriptionUsage" package="zenith.erp.subscriptions" short-alias="SubscriptionUsages">
        <field name="usageId" type="id" is-pk="true"/>
        <field name="subscriptionId" type="id"/>
        <field name="usageType" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="usageDate" type="date-time"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="zenith.erp.subscriptions.Subscription"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="UsageType" description="Subscription Usage Type"/>
            <moqui.basic.Enumeration enumId="UsUsers" enumTypeId="UsageType" description="Active Users" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="UsStorage" enumTypeId="UsageType" description="Storage (GB)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="UsApiCalls" enumTypeId="UsageType" description="API Calls" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="UsTransactions" enumTypeId="UsageType" description="Transactions" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- Discount / Coupon -->
    <entity entity-name="SubscriptionDiscount" package="zenith.erp.subscriptions" short-alias="SubscriptionDiscounts">
        <field name="discountId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="discountCode" type="text-short"/>
        <field name="discountName" type="text-medium"/>
        <field name="discountType" type="id"/>
        <field name="discountValue" type="number-decimal"/>
        <field name="maxUses" type="number-integer"/>
        <field name="usedCount" type="number-integer" default="0"/>
        <field name="validFrom" type="date-time"/>
        <field name="validTo" type="date-time"/>
        <field name="applicablePlanId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.subscriptions.SubscriptionPlan" fk-name="FK_DISC_PLAN">
            <key-map field-name="applicablePlanId" related="planId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="DiscountType" description="Discount Type"/>
            <moqui.basic.Enumeration enumId="DtPercentage" enumTypeId="DiscountType" description="Percentage" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="DtFlat" enumTypeId="DiscountType" description="Flat Amount" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="DtTrialExtend" enumTypeId="DiscountType" description="Trial Extension (Days)" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- Subscription Activity Log -->
    <entity entity-name="SubscriptionActivity" package="zenith.erp.subscriptions" short-alias="SubscriptionActivities">
        <field name="activityId" type="id" is-pk="true"/>
        <field name="subscriptionId" type="id"/>
        <field name="activityType" type="id"/>
        <field name="activityDate" type="date-time"/>
        <field name="description" type="text-medium"/>
        <field name="performedByPartyId" type="id"/>
        <field name="oldValue" type="text-medium"/>
        <field name="newValue" type="text-medium"/>
        <relationship type="one" related="zenith.erp.subscriptions.Subscription"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SubActivityType" description="Subscription Activity Type"/>
            <moqui.basic.Enumeration enumId="SaCreated" enumTypeId="SubActivityType" description="Created" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SaActivated" enumTypeId="SubActivityType" description="Activated" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SaRenewed" enumTypeId="SubActivityType" description="Renewed" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SaUpgraded" enumTypeId="SubActivityType" description="Upgraded" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="SaDowngraded" enumTypeId="SubActivityType" description="Downgraded" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="SaPaused" enumTypeId="SubActivityType" description="Paused" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="SaResumed" enumTypeId="SubActivityType" description="Resumed" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="SaCancelled" enumTypeId="SubActivityType" description="Cancelled" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="SaPayment" enumTypeId="SubActivityType" description="Payment" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="SaPlanChange" enumTypeId="SubActivityType" description="Plan Changed" sequenceNum="10"/>
        </seed-data>
    </entity>

    <!-- View: Subscription with Plan -->
    <view-entity entity-name="SubscriptionView" package="zenith.erp.subscriptions">
        <member-entity entity-alias="SB" entity-name="zenith.erp.subscriptions.Subscription"/>
        <member-entity entity-alias="SP" entity-name="zenith.erp.subscriptions.SubscriptionPlan" join-from-alias="SB">
            <key-map field-name="planId"/>
        </member-entity>
        <alias-all entity-alias="SB"/>
        <alias entity-alias="SP" name="planName"/>
        <alias entity-alias="SP" name="planCode"/>
        <alias entity-alias="SP" name="billingFrequency"/>
    </view-entity>

</entities>
