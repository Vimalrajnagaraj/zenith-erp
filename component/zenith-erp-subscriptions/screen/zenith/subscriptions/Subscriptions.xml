<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Subscriptions" default-menu-index="23">

    <always-actions>
        <set field="html_title" value="Subscriptions"/>
    </always-actions>

    <subscreens default-item="AllSubscriptions"/>

    <transition name="goSales"><default-response url="/apps/zenith/sales/SalesDashboard"/></transition>
    <transition name="goContacts"><default-response url="/apps/zenith/Contacts/Customers"/></transition>
    <transition name="goAccounting"><default-response url="/apps/zenith/Accounting/Invoices"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_sales_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('sales'))"><widgets><link url="goSales" text="Sales" icon="fa fa-line-chart" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_contacts_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="goContacts" text="Customers" icon="fa fa-users" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_accounting_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('accounting'))"><widgets><link url="goAccounting" text="Accounting" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
