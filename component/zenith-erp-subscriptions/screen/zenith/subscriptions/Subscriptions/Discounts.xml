<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Discounts" default-menu-index="4">

    <transition name="createDiscount" begin-transaction="true">
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.subscriptions.SubscriptionDiscount" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateDiscount" begin-transaction="true">
        <service-call name="update#zenith.erp.subscriptions.SubscriptionDiscount"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionDiscount" list="discounts">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="discountCode"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Discount Codes / Coupons"/>
            <box-toolbar>
                <container-dialog id="CreateDiscDialog" button-text="New Discount">
                    <form-single name="CreateDiscForm" transition="createDiscount">
                        <field name="discountCode"><default-field title="Code"><text-line size="15"/></default-field></field>
                        <field name="discountName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="discountType"><default-field title="Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="DiscountType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="discountValue"><default-field title="Value"><text-line size="8"/></default-field></field>
                        <field name="maxUses"><default-field title="Max Uses"><text-line size="5"/></default-field></field>
                        <field name="validFrom"><default-field title="Valid From"><date-time type="date"/></default-field></field>
                        <field name="validTo"><default-field title="Valid To"><date-time type="date"/></default-field></field>
                        <field name="applicablePlanId"><default-field title="Applicable Plan"><drop-down allow-empty="true">
                            <entity-options key="${planId}" text="${planName}">
                                <entity-find entity-name="zenith.erp.subscriptions.SubscriptionPlan">
                                    <econdition field-name="isActive" value="Y"/>
                                    <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <section name="DiscountsEmptyState" condition="!discounts"><widgets>
                    <render-mode><text type="html"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">🏷️</div>
  <h3 style="margin:0 0 8px; color:#333;">No discount codes yet</h3>
  <p style="max-width:540px; margin:0 auto;">Discount codes (coupons) let you offer your customers a percentage or flat-amount off when they subscribe. Set an optional validity window and usage limit. Click <b>“New Discount”</b> above to create one.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="DiscountsListSection" condition="discounts"><widgets>
                <form-list name="DiscountList" list="discounts" transition="updateDiscount">
                    <field name="discountId"><default-field><hidden/></default-field></field>
                    <field name="discountCode"><default-field title="Code"><display/></default-field></field>
                    <field name="discountName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="discountType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="discountValue"><default-field title="Value"><display/></default-field></field>
                    <field name="maxUses"><default-field title="Max"><display/></default-field></field>
                    <field name="usedCount"><default-field title="Used"><display/></default-field></field>
                    <field name="validFrom"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="validTo"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
                </widgets></section>
            </box-body>
        </container-box>
    </widgets>
</screen>
