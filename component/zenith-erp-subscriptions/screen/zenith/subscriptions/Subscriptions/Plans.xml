<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Plans" default-menu-index="3">

    <transition name="createPlan" begin-transaction="true">
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.subscriptions.SubscriptionPlan" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updatePlan" begin-transaction="true">
        <service-call name="update#zenith.erp.subscriptions.SubscriptionPlan"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionPlan" list="plans">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="billingAmount"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Subscription Plans"/>
            <box-toolbar>
                <container-dialog id="CreatePlanDialog" button-text="New Plan">
                    <form-single name="CreatePlanForm" transition="createPlan">
                        <field name="planName"><default-field title="Name"><text-line size="20"/></default-field></field>
                        <field name="planCode"><default-field title="Code"><text-line size="8"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="billingFrequency"><default-field title="Frequency"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="BillingFrequency"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="billingAmount"><default-field title="Amount (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="setupFee"><default-field title="Setup Fee (${currSymbol})"><text-line size="10" default-value="0"/></default-field></field>
                        <field name="trialDays"><default-field title="Trial Days"><text-line size="4" default-value="14"/></default-field></field>
                        <field name="taxRate"><default-field title="GST Rate (%)"><text-line size="4" default-value="18"/></default-field></field>
                        <field name="productTaxCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="maxUsers"><default-field title="Max Users"><text-line size="5"/></default-field></field>
                        <field name="maxStorage"><default-field title="Max Storage"><text-line size="10"/></default-field></field>
                        <field name="features"><default-field title="Features"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="autoRenew"><default-field title="Auto Renew"><drop-down>
                            <option key="Y" text="Yes"/><option key="N" text="No"/>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <section name="PlansEmptyState" condition="!plans"><widgets>
                    <render-mode><text type="html"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">📋</div>
  <h3 style="margin:0 0 8px; color:#333;">No subscription plans yet</h3>
  <p style="max-width:540px; margin:0 auto;">A plan defines what you charge a customer on a recurring basis — price, billing frequency (monthly / annual), GST rate, free-trial days and setup fee. Create plans for the services <b>you</b> sell to your customers. Click <b>“New Plan”</b> above to add your first one.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="PlansListSection" condition="plans"><widgets>
                <form-list name="PlanList" list="plans" transition="updatePlan">
                    <field name="planId"><default-field><hidden/></default-field></field>
                    <field name="planName"><default-field title="Name"><text-line size="12"/></default-field></field>
                    <field name="planCode"><default-field title="Code"><display/></default-field></field>
                    <field name="billingFrequency"><default-field title="Frequency">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="billingAmount"><default-field title="Amount (${currSymbol})"><text-line size="8"/></default-field></field>
                    <field name="setupFee"><default-field title="Setup (${currSymbol})"><display format="#,##0"/></default-field></field>
                    <field name="trialDays"><default-field title="Trial"><display/></default-field></field>
                    <field name="taxRate"><default-field title="GST %"><display/></default-field></field>
                    <field name="maxUsers"><default-field title="Users"><display/></default-field></field>
                    <field name="autoRenew"><default-field title="Renew"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
                </widgets></section>
            </box-body>
        </container-box>
    </widgets>
</screen>
