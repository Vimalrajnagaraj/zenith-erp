<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices" default-menu-index="5">

    <transition name="updateInvoice" begin-transaction="true">
        <service-call name="zenith.subscriptions.CatalogServices.update#SubscriptionInvoiceStatus"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionInvoice" list="invoiceList">
            <econdition field-name="organizationPartyId" from="subscriptionOrgId"/>
            <search-form-inputs default-order-by="-invoiceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Subscription Invoices"/>
            <box-body>
                <section name="InvoicesNoMatch" condition="!invoiceList &amp;&amp; (subscriptionId || statusId)"><widgets>
                    <render-mode><text type="html"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">🔍</div>
  <h3 style="margin:0 0 8px; color:#333;">No invoices match your search</h3>
  <p style="max-width:540px; margin:0 auto;">Nothing matches the current filter. Clear the search fields above and click <b>Find</b> again to see all your invoices.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="InvoicesEmptyState" condition="!invoiceList &amp;&amp; !(subscriptionId || statusId)"><widgets>
                    <render-mode><text type="html"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">💳</div>
  <h3 style="margin:0 0 8px; color:#333;">No invoices yet</h3>
  <p style="max-width:540px; margin:0 auto;">Invoices are generated from active subscriptions — open a subscription and use <b>“Generate Invoice”</b>, and it will appear here with its GST and total. Each invoice can then be marked Sent / Paid.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="InvoicesListSection" condition="invoiceList"><widgets>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Invoices..." style="display:none"></span>]]></text></render-mode>
            <form-list name="InvoiceListForm" list="invoiceList" transition="updateInvoice" header-dialog="true">
                    <field name="subInvoiceId"><default-field><hidden/></default-field></field>
                    <field name="invoiceNumber"><header-field show-order-by="true"/>
                        <default-field title="Invoice #"><display/></default-field></field>
                    <field name="subscriptionId"><header-field title="Subscription"><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="Subscription">
                            <display-entity entity-name="zenith.erp.subscriptions.Subscription" text="${subscriptionNumber}"/>
                        </default-field>
                    </field>
                    <field name="invoiceDate"><header-field show-order-by="true"/>
                        <default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="periodFrom"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="periodTo"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="taxableAmount"><default-field title="Taxable (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalTaxAmount"><default-field title="GST (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="SubInvoice"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status"><drop-down>
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="SubInvoice"/>
                                </entity-find></entity-options>
                        </drop-down></default-field>
                    </field>
                    <field name="paymentReference"><default-field title="Payment Ref"><text-line size="15"/></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="sub_inv_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </widgets></section>
            </box-body>
        </container-box>
    </widgets>
</screen>
