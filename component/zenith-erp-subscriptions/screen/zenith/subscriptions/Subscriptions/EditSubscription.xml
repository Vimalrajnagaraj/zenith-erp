<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Subscription Detail" default-menu-index="2" default-menu-include="false">

    <parameter name="subscriptionId" required="true"/>

    <transition name="activateSub" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.activate#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="pauseSub" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.pause#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="resumeSub" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.resume#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelSub" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.cancel#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="renewSub" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.renew#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="changePlan" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.changePlan#Subscription"/>
        <default-response url="."/>
    </transition>
    <transition name="generateInvoice" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.generate#Invoice"/>
        <default-response url="."/>
    </transition>

    <!-- Org-isolation: a tenant must not VIEW another tenant's subscription/invoices/activity by guessing
         the id. Bounce a non-owner (ADMIN exempt) back to the list before any data renders. -->
    <pre-actions>
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="_gSub"><field-map field-name="subscriptionId"/></entity-find-one>
        <if condition="_ao &amp;&amp; _gSub != null &amp;&amp; _gSub.organizationPartyId != _ao &amp;&amp; !ec.user.isInGroup('ADMIN')">
            <script>ec.web.sendRedirectAndStopRender("/apps/zenith/subscriptions")</script>
        </if>
    </pre-actions>

    <actions>
        <entity-find-one entity-name="zenith.erp.subscriptions.Subscription" value-field="sub"/>
        <entity-find-one entity-name="zenith.erp.subscriptions.SubscriptionPlan" value-field="plan">
            <field-map field-name="planId" from="sub.planId"/>
        </entity-find-one>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionInvoice" list="invoices">
            <econdition field-name="subscriptionId"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionActivity" list="activities">
            <econdition field-name="subscriptionId"/>
            <order-by field-name="-activityDate"/>
            <limit count="20"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box>
                    <box-header title="Subscription — ${sub.subscriptionNumber}"/>
                    <box-body>
                        <form-single name="SubDetailForm" map="sub">
                            <field name="subscriptionId"><default-field><hidden/></default-field></field>
                            <field name="subscriptionNumber"><default-field title="Sub #"><display/></default-field></field>
                            <field name="customerPartyId"><default-field title="Customer"><display/></default-field></field>
                            <field name="planId"><default-field title="Plan">
                                <display-entity entity-name="zenith.erp.subscriptions.SubscriptionPlan" text="${planName} (${planCode})"/>
                            </default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/>
                            </default-field></field>
                            <field name="startDate"><default-field title="Start"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="endDate"><default-field title="End"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="trialEndDate"><default-field title="Trial Ends"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="nextBillingDate"><default-field title="Next Billing"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="billingAmount"><default-field title="Base (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                            <field name="gstAmount"><default-field title="GST (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                            <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                            <field name="autoRenew"><default-field title="Auto Renew"><display/></default-field></field>
                            <field name="cancelReason"><default-field title="Cancel Reason"><display/></default-field></field>
                            <field name="notes"><default-field title="Notes"><display/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>

                <!-- Invoices -->
                <container-box>
                    <box-header title="Invoices"/>
                    <box-toolbar>
                        <section name="GenInvSection" condition="sub.statusId == 'SubActive'">
                            <widgets>
                                <form-single name="GenInvForm" transition="generateInvoice">
                                    <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                    <field name="submitButton"><default-field title="Generate Invoice"><submit/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                    </box-toolbar>
                    <box-body>
                        <form-list name="InvoiceList" list="invoices" skip-form="true">
                            <field name="invoiceNumber"><default-field title="Invoice #"><display/></default-field></field>
                            <field name="invoiceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="periodFrom"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="periodTo"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/>
                            </default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6">
                <!-- Actions -->
                <container-box>
                    <box-header title="Actions"/>
                    <box-body>
                        <section name="ActivateSection" condition="sub.statusId == 'SubTrial'">
                            <widgets>
                                <form-single name="ActivateForm" transition="activateSub">
                                    <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                    <field name="submitButton"><default-field title="Activate"><submit type="success"/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                        <section name="PauseSection" condition="sub.statusId == 'SubActive'">
                            <widgets>
                                <container-dialog id="PauseDialog" button-text="Pause Subscription">
                                    <form-single name="PauseForm" transition="pauseSub">
                                        <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                        <field name="reason"><default-field title="Reason"><text-area rows="2" cols="40"/></default-field></field>
                                        <field name="submitButton"><default-field title="Pause"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                        <section name="ResumeSection" condition="sub.statusId == 'SubPaused'">
                            <widgets>
                                <form-single name="ResumeForm" transition="resumeSub">
                                    <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                    <field name="submitButton"><default-field title="Resume"><submit type="success"/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                        <section name="RenewSection" condition="sub.statusId == 'SubActive' || sub.statusId == 'SubPastDue'">
                            <widgets>
                                <form-single name="RenewForm" transition="renewSub">
                                    <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                    <field name="submitButton"><default-field title="Renew Now"><submit type="success"/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                        <section name="CancelSection" condition="sub.statusId != 'SubCancelled' &amp;&amp; sub.statusId != 'SubExpired'">
                            <widgets>
                                <container-dialog id="CancelDialog" button-text="Cancel Subscription">
                                    <form-single name="CancelForm" transition="cancelSub">
                                        <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                        <field name="cancelReason"><default-field title="Reason"><text-area rows="2" cols="40"/></default-field></field>
                                        <field name="submitButton"><default-field title="Cancel"><submit type="danger"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                        <section name="ChangePlanSection" condition="sub.statusId == 'SubActive' || sub.statusId == 'SubTrial'">
                            <widgets>
                                <container-dialog id="ChangePlanDialog" button-text="Change Plan">
                                    <form-single name="ChangePlanForm" transition="changePlan">
                                        <field name="subscriptionId"><default-field><hidden/></default-field></field>
                                        <field name="newPlanId"><default-field title="New Plan"><drop-down>
                                            <entity-options key="${planId}" text="${planName} — ₹${billingAmount}">
                                                <entity-find entity-name="zenith.erp.subscriptions.SubscriptionPlan">
                                                    <econdition field-name="isActive" value="Y"/>
                                                    <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                                    <order-by field-name="billingAmount"/>
                                                </entity-find>
                                            </entity-options>
                                        </drop-down></default-field></field>
                                        <field name="submitButton"><default-field title="Change"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>

                <!-- Activity Log -->
                <container-box>
                    <box-header title="Activity Log"/>
                    <box-body>
                        <form-list name="ActivityList" list="activities" skip-form="true">
                            <field name="activityDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                            <field name="activityType"><default-field title="Type">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="description"><default-field title="Details"><display/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
