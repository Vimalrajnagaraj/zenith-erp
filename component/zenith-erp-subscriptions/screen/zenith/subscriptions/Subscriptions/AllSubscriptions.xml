<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Subscriptions" default-menu-index="1">

    <transition name="createSubscription" begin-transaction="true">
        <service-call name="zenith.subscriptions.SubscriptionServices.create#Subscription"/>
        <default-response url="../EditSubscription"/>
        <!-- On validation error (e.g. no active org, invalid discount) stay on the list and show the message. -->
        <error-response url="."/>
    </transition>
    <transition name="editSubscription"><default-response url="../EditSubscription"/></transition>
    <!-- ZE-SB-013 f/u: org-scoped party picker (ownerPartyId==active org) for the customer field. -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <entity-find entity-name="zenith.erp.subscriptions.SubscriptionView" list="subList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-startDate"/>
        </entity-find>
        <!-- ZE-SUB-004: does THIS tenant have any plan to enrol a customer into? -->
        <entity-find-count entity-name="zenith.erp.subscriptions.SubscriptionPlan" count-field="planCount">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find-count>
        <set field="hasPlans" from="planCount > 0"/>

        <!-- KPI cards + pill maps (unfiltered org totals, so they don't shrink with the table's search filter) -->
        <script><![CDATA[
            def z = com.zenith.Fmt.INSTANCE
            def _org = ec.user.getPreference('ACTIVE_ORGANIZATION')
            def kf = ec.entity.find("zenith.erp.subscriptions.SubscriptionView")
            if (_org) kf.condition("organizationPartyId", _org)
            def allSubs = kf.list()
            totalSubs = allSubs.size()
            activeSubs = allSubs.count { it.statusId == 'SubActive' }
            def now = ec.user.nowTimestamp
            def in7 = new java.sql.Timestamp(now.getTime() + 7L * 86400000L)
            expiringSoon = allSubs.count { it.nextBillingDate != null && !it.nextBillingDate.before(now) && !it.nextBillingDate.after(in7) && (it.statusId in ['SubActive','SubTrial']) }
            def freqDiv = [BfMonthly:1.0G, BfAnnually:12.0G, BfQuarterly:3.0G, BfHalfYearly:6.0G, BfOneTime:0.0G]
            def mrr = 0.0G
            allSubs.each { s -> if (s.statusId == 'SubActive' && s.billingAmount != null) { def d = freqDiv[s.billingFrequency]; if (d != null && d > 0) mrr += ((s.billingAmount as BigDecimal) / d) } }
            totalSubsStr = z.inr(totalSubs.toString())
            activeSubsStr = z.inr(activeSubs.toString())
            expiringSoonStr = expiringSoon.toString()
            mrrStr = '₹ ' + z.inr(ec.l10n.format(mrr.setScale(0, java.math.RoundingMode.HALF_UP), '#,##0'))
            def monthStart = java.sql.Timestamp.valueOf(ec.l10n.format(now, 'yyyy-MM') + '-01 00:00:00')
            newThisMonth = allSubs.count { it.startDate != null && !it.startDate.before(monthStart) }
            totalDeltaCol = (newThisMonth > 0) ? '#059669' : '#9CA3AF'
            totalDeltaStr = (newThisMonth > 0) ? ('&#8593; ' + newThisMonth + ' this month') : 'no change'

            freqDescMap = [BfMonthly:'Monthly', BfOneTime:'One-Time', BfAnnually:'Annually', BfHalfYearly:'Half-Yearly', BfQuarterly:'Quarterly']
            freqBadgeMap = [BfMonthly:'primary', BfOneTime:'info', BfAnnually:'success', BfHalfYearly:'warning', BfQuarterly:'grey']
            statusDescMap = [SubActive:'Active', SubTrial:'Trial', SubPastDue:'Past Due', SubPaused:'Paused', SubCancelled:'Cancelled', SubExpired:'Expired']
            statusBadgeMap = [SubActive:'success', SubTrial:'warning', SubPastDue:'danger', SubPaused:'grey', SubCancelled:'danger', SubExpired:'grey']
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <!-- Header -->
            <container style="zsec-hdr q-mb-md">
                <container>
                    <label text="Subscriptions" type="h5" style="text-weight-bold q-my-none"/>
                    <label text="Monitor and manage all customer subscriptions." type="span" style="z-statdesc"/>
                </container>
                <container style="z-btnrow">
                    <link url="." text="Refresh" icon="refresh" link-type="anchor" style="z-obtn"/>
                    <section name="sub_newsub_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container style="z-newbtn-wrap">
                    <container-dialog id="CreateSubDialog" button-text="+ New Subscription">
                        <!-- ZE-SUB-004: no plans yet -> guide to the Plans tab instead of an empty required dropdown. -->
                        <section name="CreateSubNoPlans" condition="!hasPlans"><widgets>
                            <render-mode><text type="html,qvt"><![CDATA[
<div style="padding:18px 6px; color:#555; max-width:520px;">
  <div style="font-size:40px; line-height:1; margin-bottom:10px;">📋</div>
  <h3 style="margin:0 0 8px; color:#333;">Create a plan first</h3>
  <p style="margin:0 0 16px;">A subscription enrols a customer in one of <b>your</b> plans — its price, billing cycle and GST. You don't have any plans yet. Add one on the <b>Plans</b> tab, then come back here to enrol a customer.</p>
</div>
                            ]]></text></render-mode>
                            <link url="../Plans" text="Go to Plans →" btn-type="primary"/>
                        </widgets></section>
                        <section name="CreateSubHasPlans" condition="hasPlans"><widgets>
                        <form-single name="CreateSubForm" transition="createSubscription">
                            <field name="customerPartyId"><default-field title="Customer">
                                <drop-down><dynamic-options transition="searchPartyList" server-search="true" min-length="2"/></drop-down>
                            </default-field></field>
                            <field name="planId"><default-field title="Plan"><drop-down>
                                <entity-options key="${planId}" text="${planName} — ₹${billingAmount}/${billingFrequency}">
                                    <entity-find entity-name="zenith.erp.subscriptions.SubscriptionPlan">
                                        <econdition field-name="isActive" value="Y"/>
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <order-by field-name="billingAmount"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="paymentMethodId"><default-field title="Payment Method"><drop-down allow-empty="true">
                                <entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="SubPaymentMethod"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="discountCode"><default-field title="Discount Code"><text-line size="15"/></default-field></field>
                            <field name="notes"><default-field title="Notes"><text-area rows="2" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Create"><submit icon="fa fa-plus-circle"/></default-field></field>
                        </form-single>
                        </widgets></section>
                    </container-dialog>
                    </container>
                    </widgets></section>
                </container>
            </container>

            <!-- 4 KPI stat cards -->
            <render-mode><text type="html,qvt" template="true"><![CDATA[
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-bottom:24px;font-family:Inter,Segoe UI,Arial,sans-serif">
  <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px"><div style="width:44px;height:44px;border-radius:8px;background:#F5F3FF;color:#7C3AED;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/></svg></div><span style="font-size:12.5px;font-weight:500;color:#6B7280">Total Subscriptions</span></div>
    <div style="font-size:28px;font-weight:700;color:#111827;line-height:1.1">${totalSubsStr}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px"><span style="font-size:11.5px;color:#9CA3AF">All time</span><span style="font-size:11.5px;font-weight:600;color:${totalDeltaCol}">${totalDeltaStr}</span></div>
  </div>
  <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px"><div style="width:44px;height:44px;border-radius:8px;background:#ECFDF5;color:#10B981;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg></div><span style="font-size:12.5px;font-weight:500;color:#6B7280">Active Subscriptions</span></div>
    <div style="font-size:28px;font-weight:700;color:#111827;line-height:1.1">${activeSubsStr}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px"><span style="font-size:11.5px;color:#9CA3AF">Ongoing</span><span style="font-size:11.5px;color:#9CA3AF"></span></div>
  </div>
  <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px"><div style="width:44px;height:44px;border-radius:8px;background:#FFFBEB;color:#F59E0B;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><span style="font-size:12.5px;font-weight:500;color:#6B7280">Expiring Soon</span></div>
    <div style="font-size:28px;font-weight:700;color:#111827;line-height:1.1">${expiringSoonStr}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px"><span style="font-size:11.5px;color:#9CA3AF">Within 7 days</span><span style="font-size:11.5px;color:#9CA3AF"></span></div>
  </div>
  <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px"><div style="width:44px;height:44px;border-radius:8px;background:#F5F3FF;color:#7C3AED;display:flex;align-items:center;justify-content:center;flex:0 0 auto"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/></svg></div><span style="font-size:12.5px;font-weight:500;color:#6B7280">Monthly Recurring Revenue</span></div>
    <div style="font-size:28px;font-weight:700;color:#111827;line-height:1.1">${mrrStr}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px"><span style="font-size:11.5px;color:#9CA3AF">MRR</span><span style="font-size:11.5px;color:#9CA3AF"></span></div>
  </div>
</div>
            ]]></text></render-mode>

            <!-- Table card -->
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-txntable">
                <section name="SubsNoMatch" condition="!subList &amp;&amp; (customerPartyId || statusId)"><widgets>
                    <render-mode><text type="html,qvt"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">🔍</div>
  <h3 style="margin:0 0 8px; color:#333;">No subscriptions match your search</h3>
  <p style="max-width:540px; margin:0 auto;">Nothing matches the current filter. Clear the search fields above and click <b>Find</b> again to see all your subscriptions.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="SubsEmptyState" condition="!subList &amp;&amp; !(customerPartyId || statusId)"><widgets>
                    <render-mode><text type="html,qvt"><![CDATA[
<div style="text-align:center; padding:40px 20px; color:#555;">
  <div style="font-size:44px; line-height:1; margin-bottom:12px;">🧾</div>
  <h3 style="margin:0 0 8px; color:#333;">No subscriptions yet</h3>
  <p style="max-width:540px; margin:0 auto;">A subscription links one of your customers to a plan and bills them automatically each cycle. Make sure you have a plan first (see the <b>Plans</b> tab), then click <b>“New Subscription”</b> above to enroll a customer.</p>
</div>
                    ]]></text></render-mode>
                </widgets></section>
                <section name="SubsListSection" condition="subList"><widgets>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search All Subscriptions..." style="display:none"></span>]]></text></render-mode>
            <form-list name="SubListForm" list="subList" list-entry="sub" skip-form="true" header-dialog="true"
                           select-columns="true" show-csv-button="true">
                    <row-actions><script><![CDATA[
                        freqLabel = freqDescMap[sub.billingFrequency] ?: (sub.billingFrequency ?: '—')
                        freqBadge = freqBadgeMap[sub.billingFrequency] ?: 'grey'
                        statusLabel = statusDescMap[sub.statusId] ?: (sub.statusId ?: '—')
                        statusBadge = statusBadgeMap[sub.statusId] ?: 'grey'
                        totalStr = (sub.totalAmount != null) ? ('₹' + com.zenith.Fmt.INSTANCE.inr(ec.l10n.format(sub.totalAmount, '#,##0.00'))) : '—'
                        startStr = sub.startDate ? ec.l10n.format(sub.startDate, 'dd-MM-yyyy') : '—'
                        nextStr = sub.nextBillingDate ? ec.l10n.format(sub.nextBillingDate, 'dd-MM-yyyy') : '—'
                        custStr = sub.customerPartyId ?: '—'
                        planStr = sub.planName ?: '—'
                    ]]></script></row-actions>
                    <field name="subscriptionNumber"><header-field title="Subscription ID" show-order-by="true"/>
                        <default-field><link url="editSubscription" text="${sub.subscriptionNumber}" parameter-map="[subscriptionId:sub.subscriptionId]" link-type="anchor" style="z-vlink"/></default-field></field>
                    <field name="customerPartyId"><header-field title="Customer"><text-find size="15" hide-options="true"/></header-field>
                        <default-field><label text="${custStr}" type="span" style="text-dark"/></default-field></field>
                    <field name="planName"><header-field title="Plan"/>
                        <default-field><label text="${planStr}" type="span" style="text-dark"/></default-field></field>
                    <field name="billingFrequency"><header-field title="Frequency"/>
                        <default-field><label text="${freqLabel}" type="span" style="zenith-badge nd ${freqBadge}"/></default-field></field>
                    <field name="totalAmount"><header-field title="Total (₹)"/>
                        <default-field><label text="${totalStr}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                    <field name="startDate"><header-field title="Start Date" show-order-by="true"/>
                        <default-field><label text="${startStr}" type="span" style="text-grey-8"/></default-field></field>
                    <field name="nextBillingDate"><header-field title="Next Billing"/>
                        <default-field><label text="${nextStr}" type="span" style="text-grey-8"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem"><econdition field-name="statusTypeId" value="Subscription"/></entity-find>
                            </entity-options></drop-down></header-field>
                        <default-field><label text="${statusLabel}" type="span" style="zenith-badge nd ${statusBadge}"/></default-field></field>
                    <field name="rowMenu"><header-field title="Actions"/>
                        <default-field><link url="editSubscription" text="⋮" parameter-map="[subscriptionId:sub.subscriptionId]" link-type="anchor" style="z-kebab"/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
                </widgets></section>
            </container>

            <!-- New Subscription dialog decoration (New_subscription.png): leading icon tiles, red asterisks,
                 placeholders, "New Subscription" title, Cancel button. Cross-surface img-onload (JS survives /qapps).
                 PURELY COSMETIC — the createSubscription write path + fields are untouched. -->
            <render-mode><text type="html,qvt"><![CDATA[
<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" style="display:none" onload='
(function(){
  if(window.__subDlgDeco) return; window.__subDlgDeco=1;
  var NS="http://www.w3.org/2000/svg";
  var A=`width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"`;
  var SVG={
    user:`<svg xmlns="`+NS+`" `+A+`><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    clipboard:`<svg xmlns="`+NS+`" `+A+`><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>`,
    card:`<svg xmlns="`+NS+`" `+A+`><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`,
    tag:`<svg xmlns="`+NS+`" `+A+`><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>`,
    file:`<svg xmlns="`+NS+`" `+A+`><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`
  };
  var MAP={"Customer":["user",1],"Plan":["clipboard",1],"Payment Method":["card",1],"Discount Code":["tag",0],"Notes":["file",0]};
  function deco(){
    var btn=document.getElementById("CreateSubForm_submitButton");
    var form=btn?btn.closest("form"):null;
    if(!form){ var dc=document.getElementsByName("discountCode")[0]; form=dc?dc.closest("form"):null; }
    if(!form) return;
    var labs=form.querySelectorAll(".control-label, .q-field__label");
    for(var k=0;k<labs.length;k++){ (function(lab){
      var txt=(lab.textContent||"").replace(/\s*\*\s*$/,"").replace(/\s+/g," ").trim();
      var m=MAP[txt]; if(!m) return;
      if(!lab.getAttribute("data-subdeco")){
        lab.setAttribute("data-subdeco","1");
        var ico=document.createElement("span"); ico.className="subdeco-ico"; ico.innerHTML=SVG[m[0]];
        lab.insertBefore(ico, lab.firstChild);
        if(m[1]){ var st=document.createElement("span"); st.className="subdeco-req"; st.textContent=" *"; lab.appendChild(st); }
      }
      var fld=lab.closest(".form-group")||lab.closest(".q-field"); if(!fld) return;
      if(txt==="Discount Code"){ var d=fld.querySelector("input"); if(d && !d.getAttribute("placeholder")) d.setAttribute("placeholder","Enter discount code (optional)"); }
      else if(txt==="Notes"){ var n=fld.querySelector("textarea"); if(n && !n.getAttribute("placeholder")) n.setAttribute("placeholder","Add any notes (optional)"); }
      else if(txt==="Customer"||txt==="Payment Method"){
        var ph=(txt==="Customer")?"Select a customer":"Select a payment method";
        var sel=fld.querySelector("select");
        if(sel){ var ch=false; for(var i=0;i<sel.options.length;i++){ if(sel.options[i].value===""&&sel.options[i].textContent!==ph){ sel.options[i].textContent=ph; ch=true; } } if(ch&&window.jQuery){ try{ window.jQuery(sel).trigger("change.select2"); }catch(e){} }
          var r=fld.querySelector(".select2-selection__rendered"); if(r && !sel.value && (r.textContent||"").trim()!==ph){ r.textContent=ph; r.setAttribute("title",ph); r.style.color="#9CA3AF"; } }
        var qi=fld.querySelector("input.q-field__input"); if(qi && qi.getAttribute("placeholder")!==ph) qi.setAttribute("placeholder",ph);
      }
    })(labs[k]); }
    var dlg=form.closest(".modal")||form.closest(".q-dialog");
    if(dlg){ var all=dlg.querySelectorAll("*"); for(var j=0;j<all.length;j++){ var el=all[j]; if(el.children.length===0){ var t=(el.textContent||"").trim(); if((t==="+ New Subscription"||t==="+New Subscription")&&!(el.closest&&el.closest("button"))){ el.textContent="New Subscription"; break; } } }
      var abtn=document.getElementById("CreateSubForm_submitButton");
      if(abtn && abtn.parentNode && !abtn.parentNode.querySelector(".subcancel")){
        var cx=document.createElement("button"); cx.type="button"; cx.className="subcancel"; cx.textContent="Cancel"; cx.setAttribute("data-dismiss","modal");
        abtn.parentNode.insertBefore(cx, abtn);
      }
    }
  }
  document.addEventListener("click", function(e){
    var t=e.target; var c=(t&&t.closest)?t.closest(".subcancel"):null;
    if(c){ e.preventDefault();
      var qd=c.closest?c.closest(".q-dialog"):null;
      if(qd){ var ics=qd.querySelectorAll(".q-icon"); for(var xi=0;xi<ics.length;xi++){ if((ics[xi].textContent||"").trim()==="close"){ var tb=ics[xi].closest("button")||ics[xi]; tb.click(); return; } } }
      try{ document.dispatchEvent(new KeyboardEvent("keydown",{key:"Escape",keyCode:27,which:27,bubbles:true})); }catch(_){}
      return;
    }
    setTimeout(deco,60); setTimeout(deco,260); setTimeout(deco,650);
  });
  deco(); setTimeout(deco,700); setTimeout(deco,1600);
})();
'/>
            ]]></text></render-mode>
        </container>
    </widgets>
</screen>
