<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Document Category ========== -->
    <entity entity-name="DocumentCategory" package="zenith.erp.documents" short-alias="DocumentCategories">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="parentCategoryId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="retentionMonths" type="number-integer"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): NULL = global shared category; a tenant-created category is stamped with its org. -->
        <field name="organizationPartyId" type="id"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="DocFileType" description="Document File Type"/>
            <moqui.basic.Enumeration enumId="DftPdf" enumTypeId="DocFileType" description="PDF" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="DftImage" enumTypeId="DocFileType" description="Image (JPG/PNG)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="DftWord" enumTypeId="DocFileType" description="Word Document" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="DftExcel" enumTypeId="DocFileType" description="Excel Spreadsheet" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="DftText" enumTypeId="DocFileType" description="Text File" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="DftXml" enumTypeId="DocFileType" description="XML" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="DftJson" enumTypeId="DocFileType" description="JSON" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="DftCsv" enumTypeId="DocFileType" description="CSV" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="DftZip" enumTypeId="DocFileType" description="Archive (ZIP/RAR)" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="DftOther" enumTypeId="DocFileType" description="Other" sequenceNum="10"/>
        </seed-data>
    </entity>

    <!-- ========== Document ========== -->
    <entity entity-name="Document" package="zenith.erp.documents" short-alias="DmsDocuments">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="documentNumber" type="text-short"/>
        <field name="title" type="text-medium"/>
        <field name="categoryId" type="id"/>
        <field name="fileType" type="id"/>
        <field name="fileName" type="text-medium"/>
        <field name="filePath" type="text-long"/>
        <field name="fileSizeBytes" type="number-integer"/>
        <field name="mimeType" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="tags" type="text-medium"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="uploadedByPartyId" type="id"/>
        <field name="uploadedDate" type="date-time"/>
        <field name="currentVersion" type="number-integer"/>
        <field name="statusId" type="id"/>
        <field name="expiryDate" type="date"/>
        <field name="retentionUntilDate" type="date"/>
        <field name="isConfidential" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): a document is private to its tenant (read/share IDOR + confidential exposure). -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.documents.DocumentCategory"/>
        <relationship type="one" title="Document" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Document" description="Document Status"/>
            <moqui.basic.StatusItem statusId="DocDraft" statusTypeId="Document" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="DocActive" statusTypeId="Document" description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="DocArchived" statusTypeId="Document" description="Archived" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="DocExpired" statusTypeId="Document" description="Expired" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="DocObsolete" statusTypeId="Document" description="Obsolete" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DocDraft" toStatusId="DocActive" transitionName="Publish"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DocActive" toStatusId="DocArchived" transitionName="Archive"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DocActive" toStatusId="DocExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DocActive" toStatusId="DocObsolete" transitionName="Obsolete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DocArchived" toStatusId="DocActive" transitionName="Restore"/>

            <moqui.basic.EnumerationType enumTypeId="DocRefType" description="Document Reference Type"/>
            <moqui.basic.Enumeration enumId="DrtInvoice" enumTypeId="DocRefType" description="Invoice" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="DrtPurchaseOrder" enumTypeId="DocRefType" description="Purchase Order" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="DrtSalesOrder" enumTypeId="DocRefType" description="Sales Order" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="DrtContract" enumTypeId="DocRefType" description="Contract" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="DrtEmployee" enumTypeId="DocRefType" description="Employee Record" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="DrtProduct" enumTypeId="DocRefType" description="Product" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="DrtCustomer" enumTypeId="DocRefType" description="Customer" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="DrtVendor" enumTypeId="DocRefType" description="Vendor" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="DrtCompliance" enumTypeId="DocRefType" description="Compliance/Legal" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="DrtGeneral" enumTypeId="DocRefType" description="General" sequenceNum="10"/>
        </seed-data>
    </entity>

    <!-- ========== Document Version ========== -->
    <entity entity-name="DocumentVersion" package="zenith.erp.documents" short-alias="DocumentVersions">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="versionNumber" type="number-integer" is-pk="true"/>
        <field name="fileName" type="text-medium"/>
        <field name="filePath" type="text-long"/>
        <field name="fileSizeBytes" type="number-integer"/>
        <field name="changeNotes" type="text-medium"/>
        <field name="uploadedByPartyId" type="id"/>
        <field name="uploadedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.documents.Document"/>
    </entity>

    <!-- ========== Document Access Log ========== -->
    <entity entity-name="DocumentAccessLog" package="zenith.erp.documents" short-alias="DocumentAccessLogs">
        <field name="accessId" type="id" is-pk="true"/>
        <field name="documentId" type="id"/>
        <field name="accessType" type="text-short"/>
        <field name="accessDate" type="date-time"/>
        <field name="accessByPartyId" type="id"/>
        <field name="ipAddress" type="text-short"/>
        <relationship type="one" related="zenith.erp.documents.Document"/>
    </entity>

    <!-- ========== Document Share ========== -->
    <entity entity-name="DocumentShare" package="zenith.erp.documents" short-alias="DocumentShares">
        <field name="shareId" type="id" is-pk="true"/>
        <field name="documentId" type="id"/>
        <field name="sharedWithPartyId" type="id"/>
        <field name="permission" type="text-short"/>
        <field name="sharedByPartyId" type="id"/>
        <field name="sharedDate" type="date-time"/>
        <field name="expiryDate" type="date"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.documents.Document"/>
    </entity>

    <!-- ========== Document Tag ========== -->
    <entity entity-name="DocumentTag" package="zenith.erp.documents" short-alias="DocumentTags">
        <field name="tagId" type="id" is-pk="true"/>
        <field name="tagName" type="text-short"/>
        <field name="color" type="text-short"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Document-Tag Mapping ========== -->
    <entity entity-name="DocumentTagMap" package="zenith.erp.documents" short-alias="DocumentTagMaps">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="tagId" type="id" is-pk="true"/>
        <relationship type="one" related="zenith.erp.documents.Document"/>
        <relationship type="one" related="zenith.erp.documents.DocumentTag"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="DocumentView" package="zenith.erp.documents">
        <member-entity entity-alias="DC" entity-name="zenith.erp.documents.Document"/>
        <member-entity entity-alias="CT" entity-name="zenith.erp.documents.DocumentCategory" join-from-alias="DC" join-optional="true">
            <key-map field-name="categoryId"/></member-entity>
        <alias-all entity-alias="DC"/>
        <alias entity-alias="CT" name="categoryName"/>
        <alias entity-alias="CT" name="retentionMonths"/>
    </view-entity>
</entities>
