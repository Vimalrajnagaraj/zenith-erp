<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Document Detail" default-menu-include="false">

    <parameter name="documentId" required="true"/>

    <transition name="updateDocument" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update a document your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.documents.Document', idField:'documentId', idValue:documentId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Document not found for your account."/></if>
            <service-call name="update#zenith.erp.documents.Document" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="uploadVersion" begin-transaction="true">
        <service-call name="zenith.documents.DocumentServices.upload#NewVersion"/>
        <default-response url="."/>
    </transition>
    <transition name="shareDocument" begin-transaction="true">
        <service-call name="zenith.documents.DocumentServices.share#Document"/>
        <default-response url="."/>
    </transition>
    <transition name="updateShare" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): a share (DocumentShare child) may only be edited on a document your org owns. -->
            <entity-find-one entity-name="zenith.erp.documents.DocumentShare" value-field="_sh"/>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.documents.Document', idField:'documentId', idValue:_sh?.documentId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Document not found for your account."/></if>
            <service-call name="update#zenith.erp.documents.DocumentShare" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="addTag" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): tags may only be added to a document your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.documents.Document', idField:'documentId', idValue:documentId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Document not found for your account."/></if>
            <service-call name="create#zenith.erp.documents.DocumentTagMap" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="removeTag" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.documents.Document', idField:'documentId', idValue:documentId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Document not found for your account."/></if>
            <service-call name="delete#zenith.erp.documents.DocumentTagMap" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SB-013 (Tier 4): block rendering another org's document + its versions/shares/access log (confidential read IDOR). -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                      in-map="[entityName:'zenith.erp.documents.Document', idField:'documentId', idValue:documentId, orgField:'organizationPartyId']"/>
        <if condition="!_da.allowed"><script>ec.web.sendRedirectAndStopRender('/apps/zenith/documents/DocumentList')</script></if>
        <entity-find-one entity-name="zenith.erp.documents.Document" value-field="doc"/>
        <entity-find entity-name="zenith.erp.documents.DocumentVersion" list="versionList">
            <econdition field-name="documentId"/>
            <order-by field-name="-versionNumber"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.documents.DocumentShare" list="shareList">
            <econdition field-name="documentId"/>
            <order-by field-name="-sharedDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.documents.DocumentTagMap" list="tagMapList">
            <econdition field-name="documentId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.documents.DocumentAccessLog" list="accessList">
            <econdition field-name="documentId"/>
            <order-by field-name="-accessDate"/>
            <limit count="20"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box><box-header title="${doc.documentNumber}: ${doc.title}"/>
                <box-body>
                    <form-single name="DocForm" transition="updateDocument" map="doc">
                        <field name="documentId"><default-field><hidden/></default-field></field>
                        <field name="documentNumber"><default-field title="Doc #"><display/></default-field></field>
                        <field name="title"><default-field title="Title"><text-line size="30"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Document"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.documents.DocumentCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own categories + global shared seeds. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fileName"><default-field title="File"><display/></default-field></field>
                        <field name="currentVersion"><default-field title="Version"><display/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="35"/></default-field></field>
                        <field name="referenceType"><default-field title="Reference">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="DocRefType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="referenceId"><default-field title="Ref ID"><text-line size="15"/></default-field></field>
                        <field name="uploadedDate"><default-field title="Uploaded"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expiry"><date-time type="date"/></default-field></field>
                        <field name="retentionUntilDate"><default-field title="Retain Until"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="isConfidential"><default-field title="Confidential">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="doc_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Tags -->
                <container-box><box-header title="Tags"/>
                <box-toolbar>
                    <section name="doc_addtag_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddTagDialog" button-text="Add Tag">
                        <form-single name="AddTagForm" transition="addTag">
                            <field name="documentId"><default-field><hidden/></default-field></field>
                            <field name="tagId"><default-field title="Tag">
                                <drop-down><entity-options key="${tagId}" text="${tagName}">
                                    <entity-find entity-name="zenith.erp.documents.DocumentTag">
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="TagMapList" list="tagMapList" skip-form="true">
                        <field name="tagId"><default-field title="Tag">
                            <display-entity entity-name="zenith.erp.documents.DocumentTag" text="${tagName}"/></default-field></field>
                        <field name="removeBtn">
                            <conditional-field name="doc_tag_remove_write" condition="modCanWrite" title="">
                            <link url="removeTag" text="X" parameter-map="[documentId:documentId, tagId:tagId]"
                                  confirmation="Remove this tag?"/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Upload New Version -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="doc_uploadver_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="UploadVersionDialog" button-text="Upload New Version">
                        <form-single name="UploadVersionForm" transition="uploadVersion">
                            <field name="documentId"><default-field><hidden/></default-field></field>
                            <field name="fileName"><default-field title="File Name"><text-line size="30"/></default-field></field>
                            <field name="filePath"><default-field title="File Path/URL"><text-line size="40"/></default-field></field>
                            <field name="fileSizeBytes"><default-field title="Size (bytes)"><text-line size="10"/></default-field></field>
                            <field name="changeNotes"><default-field title="Change Notes"><text-area rows="2" cols="35"/></default-field></field>
                            <field name="submitButton"><default-field title="Upload"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                    <section name="doc_share_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="ShareDialog" button-text="Share">
                        <form-single name="ShareForm" transition="shareDocument">
                            <field name="documentId"><default-field><hidden/></default-field></field>
                            <field name="sharedWithPartyId"><default-field title="Share With (Party ID)"><text-line size="15"/></default-field></field>
                            <field name="permission"><default-field title="Permission">
                                <drop-down no-current-selected-key="View">
                                    <option key="View" text="View Only"/>
                                    <option key="Edit" text="Edit"/>
                                    <option key="Admin" text="Full Access"/>
                                </drop-down></default-field></field>
                            <field name="expiryDate"><default-field title="Access Expires"><date-time type="date"/></default-field></field>
                            <field name="submitButton"><default-field title="Share"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-body></container-box>

                <!-- Version History -->
                <container-box><box-header title="Version History"/>
                <box-body>
                    <form-list name="VersionList" list="versionList" skip-form="true">
                        <field name="versionNumber"><default-field title="V#"><display/></default-field></field>
                        <field name="fileName"><default-field title="File"><display/></default-field></field>
                        <field name="fileSizeBytes"><default-field title="Size"><display format="#,##0"/></default-field></field>
                        <field name="changeNotes"><default-field title="Notes"><display/></default-field></field>
                        <field name="uploadedByPartyId"><default-field title="By"><display/></default-field></field>
                        <field name="uploadedDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Shares -->
                <container-box><box-header title="Shared With"/>
                <box-body>
                    <form-list name="ShareList" list="shareList" transition="updateShare">
                        <field name="shareId"><default-field title="ID"><display/></default-field></field>
                        <field name="sharedWithPartyId"><default-field title="Party"><display/></default-field></field>
                        <field name="permission"><default-field title="Permission"><display/></default-field></field>
                        <field name="sharedDate"><default-field title="Shared"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="doc_share_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>

                <!-- Access Log -->
                <container-box><box-header title="Access Log (Recent 20)"/>
                <box-body>
                    <form-list name="AccessList" list="accessList" skip-form="true">
                        <field name="accessDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="accessType"><default-field title="Action"><display/></default-field></field>
                        <field name="accessByPartyId"><default-field title="By"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
