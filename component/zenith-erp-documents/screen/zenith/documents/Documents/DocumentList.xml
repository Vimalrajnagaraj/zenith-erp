<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Documents" default-menu-index="1">

    <transition name="createDocument" begin-transaction="true">
        <service-call name="zenith.documents.DocumentServices.create#Document"/>
        <default-response url="."/>
    </transition>
    <transition name="editDocument"><default-response url="../EditDocument"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.documents.DocumentView" list="docList">
            <search-form-inputs default-order-by="-uploadedDate"/>
            <order-by field-name="-uploadedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Document Management"/>
            <box-toolbar>
                <section name="doc_new_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateDocDialog" button-text="Upload Document">
                    <form-single name="CreateDocForm" transition="createDocument">
                        <field name="title"><default-field title="Title"><text-line size="30"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.documents.DocumentCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                    <order-by field-name="categoryName"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fileType"><default-field title="File Type">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="DocFileType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fileName"><default-field title="File Name"><text-line size="30"/></default-field></field>
                        <field name="filePath"><default-field title="File Path/URL"><text-line size="40"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="referenceType"><default-field title="Reference Type">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="DocRefType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="referenceId"><default-field title="Reference ID"><text-line size="15"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date"/></default-field></field>
                        <field name="isConfidential"><default-field title="Confidential">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="tags"><default-field title="Tags (comma-separated)"><text-line size="30"/></default-field></field>
                        <field name="submitButton"><default-field title="Upload"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DocList" list="docList" skip-form="true">
                    <field name="documentNumber"><default-field title="Doc #"><display/></default-field></field>
                    <field name="title"><default-field title="Title"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Category"><display/></default-field></field>
                    <field name="fileType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="fileName"><default-field title="File"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="currentVersion"><default-field title="Ver"><display/></default-field></field>
                    <field name="uploadedDate"><default-field title="Uploaded"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="isConfidential"><default-field title="Conf"><display/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editDocument" text="Detail" parameter-map="[documentId:documentId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
