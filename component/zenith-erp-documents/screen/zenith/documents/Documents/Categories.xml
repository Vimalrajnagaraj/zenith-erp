<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Categories" default-menu-index="2">

    <transition name="createCategory" begin-transaction="true">
        <service-call name="create#zenith.erp.documents.DocumentCategory"/>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <service-call name="update#zenith.erp.documents.DocumentCategory"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.documents.DocumentCategory" list="catList">
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Document Categories"/>
            <box-toolbar>
                <section name="doc_cat_new_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCatDialog" button-text="New Category">
                    <form-single name="CreateCatForm" transition="createCategory">
                        <field name="categoryId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="categoryName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="35"/></default-field></field>
                        <field name="retentionMonths"><default-field title="Retention (months)"><text-line size="6"/></default-field></field>
                        <field name="parentCategoryId"><default-field title="Parent Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.documents.DocumentCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CatList" list="catList" transition="updateCategory">
                    <field name="categoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="25"/></default-field></field>
                    <field name="retentionMonths"><default-field title="Retention (mo)"><text-line size="4"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="doc_cat_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title="Save"><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
