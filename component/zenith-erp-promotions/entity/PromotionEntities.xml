<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Promotion ========== -->
    <entity entity-name="Promotion" package="zenith.erp.promotions" short-alias="Promotions">
        <field name="promotionId" type="id" is-pk="true"/>
        <field name="promotionName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="promotionTypeEnumId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="priority" type="number-integer" default="10"/>
        <field name="isStackable" type="text-indicator" default="'N'"/>
        <field name="isAutoApply" type="text-indicator" default="'Y'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <field name="maxTotalUses" type="number-integer"/>
        <field name="maxUsesPerCustomer" type="number-integer"/>
        <field name="currentUseCount" type="number-integer" default="0"/>
        <field name="applicableOnEnumId" type="id" default="'PaoOrder'"/>
        <relationship type="one" title="PromotionType" related="moqui.basic.Enumeration">
            <key-map field-name="promotionTypeEnumId" related="enumId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PromotionType" description="Promotion Type"/>
            <moqui.basic.Enumeration enumId="PmtPercentOff" enumTypeId="PromotionType" description="Percentage Off" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PmtAmountOff" enumTypeId="PromotionType" description="Fixed Amount Off" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PmtBogo" enumTypeId="PromotionType" description="Buy One Get One (BOGO)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PmtBuyXGetY" enumTypeId="PromotionType" description="Buy X Get Y Free" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PmtBundle" enumTypeId="PromotionType" description="Bundle Deal" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PmtFreeItem" enumTypeId="PromotionType" description="Free Item" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="PmtCashback" enumTypeId="PromotionType" description="Cashback" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="PmtFreeShipping" enumTypeId="PromotionType" description="Free Shipping" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="PmtFlatPrice" enumTypeId="PromotionType" description="Flat Price" sequenceNum="9"/>

            <moqui.basic.EnumerationType enumTypeId="PromotionApplicableOn" description="Promotion Applicable On"/>
            <moqui.basic.Enumeration enumId="PaoOrder" enumTypeId="PromotionApplicableOn" description="Whole Order" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PaoItem" enumTypeId="PromotionApplicableOn" description="Per Item" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PaoShipping" enumTypeId="PromotionApplicableOn" description="Shipping" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- ========== Promotion Condition ========== -->
    <entity entity-name="PromotionCondition" package="zenith.erp.promotions" short-alias="PromotionConditions">
        <field name="conditionId" type="id" is-pk="true"/>
        <field name="promotionId" type="id"/>
        <field name="conditionTypeEnumId" type="id"/>
        <field name="operator" type="text-short" default="'equals'"/>
        <field name="fieldValue" type="text-medium"/>
        <field name="fieldValueTo" type="text-medium"/>
        <relationship type="one" related="zenith.erp.promotions.Promotion"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PromoConditionType" description="Promotion Condition Type"/>
            <moqui.basic.Enumeration enumId="PcnMinOrderAmount" enumTypeId="PromoConditionType" description="Minimum Order Amount" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PcnMinQuantity" enumTypeId="PromoConditionType" description="Minimum Item Quantity" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PcnProduct" enumTypeId="PromoConditionType" description="Specific Product" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PcnProductCategory" enumTypeId="PromoConditionType" description="Product Category" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PcnCustomerGroup" enumTypeId="PromoConditionType" description="Customer Group" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PcnPaymentMethod" enumTypeId="PromoConditionType" description="Payment Method" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="PcnDayOfWeek" enumTypeId="PromoConditionType" description="Day of Week" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="PcnTimeRange" enumTypeId="PromoConditionType" description="Time Range" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="PcnChannel" enumTypeId="PromoConditionType" description="Sales Channel" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="PcnFirstOrder" enumTypeId="PromoConditionType" description="First Order Only" sequenceNum="10"/>
        </seed-data>
    </entity>

    <!-- ========== Promotion Action ========== -->
    <entity entity-name="PromotionAction" package="zenith.erp.promotions" short-alias="PromotionActions">
        <field name="actionId" type="id" is-pk="true"/>
        <field name="promotionId" type="id"/>
        <field name="actionTypeEnumId" type="id"/>
        <field name="discountValue" type="number-decimal"/>
        <field name="maxDiscount" type="currency-precise"/>
        <field name="freeProductId" type="id"/>
        <field name="freeQuantity" type="number-decimal" default="1"/>
        <field name="buyQuantity" type="number-decimal"/>
        <field name="getQuantity" type="number-decimal"/>
        <relationship type="one" related="zenith.erp.promotions.Promotion"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PromoActionType" description="Promotion Action Type"/>
            <moqui.basic.Enumeration enumId="PacDiscountPercent" enumTypeId="PromoActionType" description="Discount %" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PacDiscountAmount" enumTypeId="PromoActionType" description="Discount Amount" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PacFreeProduct" enumTypeId="PromoActionType" description="Free Product" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PacBuyXGetY" enumTypeId="PromoActionType" description="Buy X Get Y Free" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PacCashback" enumTypeId="PromoActionType" description="Cashback" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PacFlatPrice" enumTypeId="PromoActionType" description="Set Flat Price" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Coupon Code ========== -->
    <entity entity-name="CouponCode" package="zenith.erp.promotions" short-alias="CouponCodes">
        <field name="couponId" type="id" is-pk="true"/>
        <field name="promotionId" type="id"/>
        <field name="couponCode" type="text-short"/>
        <field name="maxUses" type="number-integer"/>
        <field name="usedCount" type="number-integer" default="0"/>
        <field name="maxUsesPerCustomer" type="number-integer" default="1"/>
        <field name="validFromDate" type="date-time"/>
        <field name="validThruDate" type="date-time"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.promotions.Promotion"/>
        <index name="COUPON_CODE_IDX" unique="true">
            <index-field name="couponCode"/>
        </index>
    </entity>

    <!-- ========== Promotion Usage (tracking) ========== -->
    <entity entity-name="PromotionUsage" package="zenith.erp.promotions" short-alias="PromotionUsages">
        <field name="usageId" type="id" is-pk="true"/>
        <field name="promotionId" type="id"/>
        <field name="couponId" type="id"/>
        <field name="orderId" type="id"/>
        <field name="posTransactionId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="discountApplied" type="currency-precise"/>
        <field name="usedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.promotions.Promotion"/>
        <relationship type="one" related="zenith.erp.promotions.CouponCode"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="PromotionDetail" package="zenith.erp.promotions">
        <member-entity entity-alias="PM" entity-name="zenith.erp.promotions.Promotion"/>
        <member-entity entity-alias="PA" entity-name="zenith.erp.promotions.PromotionAction" join-from-alias="PM" join-optional="true">
            <key-map field-name="promotionId"/>
        </member-entity>
        <alias entity-alias="PM" name="promotionId"/>
        <alias entity-alias="PM" name="promotionName"/>
        <alias entity-alias="PM" name="promotionTypeEnumId"/>
        <alias entity-alias="PM" name="priority"/>
        <alias entity-alias="PM" name="isActive"/>
        <alias entity-alias="PM" name="isAutoApply"/>
        <alias entity-alias="PM" name="validFromDate"/>
        <alias entity-alias="PM" name="validThruDate"/>
        <alias entity-alias="PM" name="currentUseCount"/>
        <alias entity-alias="PM" name="maxTotalUses"/>
        <alias entity-alias="PA" name="actionTypeEnumId"/>
        <alias entity-alias="PA" name="discountValue"/>
        <alias entity-alias="PA" name="maxDiscount"/>
    </view-entity>

</entities>
