<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Promotions" default-menu-index="2">

    <transition name="editPromotion"><default-response url="../EditPromotion"/></transition>
    <transition name="createPromotion">
        <service-call name="zenith.promotions.PromotionServices.create#Promotion"/>
        <default-response url="../EditPromotion"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.promotions.Promotion" list="promotions">
            <search-form-inputs default-order-by="priority,promotionName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Promotions" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreatePromo" button-text="New Promotion" type="success">
                <form-single name="CreatePromoForm" transition="createPromotion">
                    <field name="promotionName"><default-field title="Name"><text-line size="40"/></default-field></field>
                    <field name="promotionTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="PromotionType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                    <field name="priority"><default-field><text-line size="5" default-value="10"/></default-field></field>
                    <field name="isAutoApply"><default-field title="Auto Apply?">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No (coupon only)"/></drop-down>
                    </default-field></field>
                    <field name="validFromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                    <field name="validThruDate"><default-field title="To"><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PromotionsForm" list="promotions" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="promotionName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Promotion">
                        <link url="editPromotion" text="${promotionName}" parameter-map="[promotionId:promotionId]"/>
                    </default-field></field>
                <field name="promotionTypeEnumId"><header-field title="Type" show-order-by="true">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PromotionType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type"><display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
                <field name="priority"><default-field><display/></default-field></field>
                <field name="isAutoApply"><default-field title="Auto"><display/></default-field></field>
                <field name="currentUseCount"><default-field title="Uses"><display/></default-field></field>
                <field name="maxTotalUses"><default-field title="Max"><display/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><display/></default-field></field>
                <field name="validFromDate"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="validThruDate"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
