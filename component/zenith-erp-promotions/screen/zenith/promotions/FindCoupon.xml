<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Coupons" default-menu-index="3">

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Promotion -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.promotions.Promotion" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="promotionId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.promotionId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.promotions.CouponCode" list="coupons">
            <search-form-inputs default-order-by="couponCode"/>
            <econdition field-name="promotionId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Coupon Codes" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search coupons..." style="display:none"></span>]]></text></render-mode>
            <form-list name="CouponsForm" list="coupons" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="couponCode"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Code"><display/></default-field></field>
                <field name="promotionId"><header-field show-order-by="true"/>
                    <default-field title="Promotion"><display/></default-field></field>
                <field name="usedCount"><default-field title="Used"><display/></default-field></field>
                <field name="maxUses"><default-field title="Max"><display/></default-field></field>
                <field name="isActive"><header-field show-order-by="true">
                    <drop-down allow-empty="true"><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </header-field>
                    <default-field title="Active"><display/></default-field></field>
                <field name="validFromDate"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="validThruDate"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
