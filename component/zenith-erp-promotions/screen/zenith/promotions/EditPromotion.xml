<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Promotion" default-menu-include="false">

    <parameter name="promotionId" required="true"/>

    <transition name="updatePromotion">
        <service-call name="update#zenith.erp.promotions.Promotion"/>
        <default-response url="."/>
    </transition>
    <transition name="addAction">
        <service-call name="create#zenith.erp.promotions.PromotionAction"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteAction">
        <service-call name="delete#zenith.erp.promotions.PromotionAction"/>
        <default-response url="."/>
    </transition>
    <transition name="addCondition">
        <service-call name="create#zenith.erp.promotions.PromotionCondition"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteCondition">
        <service-call name="delete#zenith.erp.promotions.PromotionCondition"/>
        <default-response url="."/>
    </transition>
    <transition name="addCoupon">
        <service-call name="zenith.promotions.PromotionServices.create#CouponCode"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.promotions.Promotion" value-field="promo"/>
        <entity-find entity-name="zenith.erp.promotions.PromotionAction" list="actions">
            <econdition field-name="promotionId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.promotions.PromotionCondition" list="conditions">
            <econdition field-name="promotionId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.promotions.CouponCode" list="coupons">
            <econdition field-name="promotionId"/>
            <order-by field-name="couponCode"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Promotion: ${promo.promotionName}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="../FindPromotion" text="Back to List" style="text-primary"/>
        </container>

        <!-- Promotion Details -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Details" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="UpdatePromo" transition="updatePromotion" map="promo">
                <field name="promotionId"><default-field><hidden/></default-field></field>
                <field name="promotionName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                <field name="promotionTypeEnumId"><default-field title="Type">
                    <drop-down><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PromotionType"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="priority"><default-field><text-line size="5"/></default-field></field>
                <field name="isStackable"><default-field title="Stackable?">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="isAutoApply"><default-field title="Auto Apply?">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="applicableOnEnumId"><default-field title="Applies To">
                    <drop-down><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="PromotionApplicableOn"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="maxTotalUses"><default-field title="Max Uses"><text-line size="8"/></default-field></field>
                <field name="maxUsesPerCustomer"><default-field title="Max/Customer"><text-line size="8"/></default-field></field>
                <field name="isActive"><default-field title="Active?">
                    <drop-down><option key="Y" text="Active"/><option key="N" text="Inactive"/></drop-down>
                </default-field></field>
                <field name="validFromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                <field name="validThruDate"><default-field title="To"><date-time type="date"/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-single>
        </container>

        <!-- Actions -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Actions (what happens when triggered)" type="h5" style="text-weight-bold q-my-none"/>
                <container-dialog id="AddAction" button-text="Add Action" type="success">
                    <form-single name="AddActionForm" transition="addAction">
                        <field name="promotionId"><default-field><hidden default-value="${promotionId}"/></default-field></field>
                        <field name="actionTypeEnumId"><default-field title="Action Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PromoActionType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="discountValue"><default-field title="Value (% or amount)"><text-line size="10"/></default-field></field>
                        <field name="maxDiscount"><default-field title="Max Discount Cap"><text-line size="10"/></default-field></field>
                        <field name="freeProductId"><default-field title="Free Product">
                            <drop-down allow-empty="true"><entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="pseudoId"/></entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="buyQuantity"><default-field title="Buy Qty"><text-line size="5"/></default-field></field>
                        <field name="getQuantity"><default-field title="Get Qty Free"><text-line size="5"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <form-list name="ActionsForm" list="actions" skip-form="true">
                <field name="actionTypeEnumId"><default-field title="Action">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="discountValue"><default-field title="Value"><display/></default-field></field>
                <field name="maxDiscount"><default-field title="Max"><display format="#,##0.00"/></default-field></field>
                <field name="freeProductId"><default-field title="Free Product"><display/></default-field></field>
                <field name="buyQuantity"><default-field title="Buy"><display/></default-field></field>
                <field name="getQuantity"><default-field title="Get"><display/></default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteAction" text="Remove" parameter-map="[actionId:actionId]"
                          confirmation="Remove this action?" style="text-negative"/>
                </default-field></field>
            </form-list>
        </container>

        <!-- Conditions -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Conditions (ALL must match)" type="h5" style="text-weight-bold q-my-none"/>
                <container-dialog id="AddCondition" button-text="Add Condition" type="success">
                    <form-single name="AddCondForm" transition="addCondition">
                        <field name="promotionId"><default-field><hidden default-value="${promotionId}"/></default-field></field>
                        <field name="conditionTypeEnumId"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PromoConditionType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="operator"><default-field>
                            <drop-down>
                                <option key="equals" text="Equals"/>
                                <option key="greater-than" text="Greater Than"/>
                                <option key="less-than" text="Less Than"/>
                                <option key="in" text="In List"/>
                            </drop-down></default-field></field>
                        <field name="fieldValue"><default-field title="Value"><text-line size="30"/></default-field></field>
                        <field name="fieldValueTo"><default-field title="Value To"><text-line size="30"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <form-list name="ConditionsForm" list="conditions" skip-form="true">
                <field name="conditionTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="operator"><default-field><display/></default-field></field>
                <field name="fieldValue"><default-field title="Value"><display/></default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteCondition" text="Remove" parameter-map="[conditionId:conditionId]"
                          confirmation="Remove?" style="text-negative"/>
                </default-field></field>
            </form-list>
        </container>

        <!-- Coupon Codes -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Coupon Codes" type="h5" style="text-weight-bold q-my-none"/>
                <container-dialog id="AddCoupon" button-text="Add Coupon" type="success">
                    <form-single name="AddCouponForm" transition="addCoupon">
                        <field name="promotionId"><default-field><hidden default-value="${promotionId}"/></default-field></field>
                        <field name="couponCode"><default-field title="Code"><text-line size="20"/></default-field></field>
                        <field name="maxUses"><default-field title="Max Uses"><text-line size="8"/></default-field></field>
                        <field name="maxUsesPerCustomer"><default-field title="Max/Customer"><text-line size="5" default-value="1"/></default-field></field>
                        <field name="validFromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                        <field name="validThruDate"><default-field title="To"><date-time type="date"/></default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <form-list name="CouponsForm" list="coupons" skip-form="true">
                <field name="couponCode"><default-field title="Code"><display/></default-field></field>
                <field name="usedCount"><default-field title="Used"><display/></default-field></field>
                <field name="maxUses"><default-field title="Max"><display/></default-field></field>
                <field name="maxUsesPerCustomer"><default-field title="Max/Cust"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
                <field name="validFromDate"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="validThruDate"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
