<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Analytics" default-menu-index="4">

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Promotion -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.promotions.Promotion" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="promotionId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.promotionId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.promotions.PromotionUsage" list="usages">
            <search-form-inputs default-order-by="-usedDate"/>
            <econdition field-name="promotionId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Promotion Analytics" type="h4" style="text-weight-bold q-my-none"/>
            <label text="Track promotion usage, discount amounts, and coupon redemptions." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Analytics..." style="display:none"></span>]]></text></render-mode>
            <form-list name="UsagesForm" list="usages" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="promotionId"><header-field show-order-by="true"><text-find size="15"/></header-field>
                    <default-field title="Promotion"><display/></default-field></field>
                <field name="couponId"><default-field title="Coupon"><display/></default-field></field>
                <field name="orderId"><header-field><text-find size="12"/></header-field>
                    <default-field title="Order"><display/></default-field></field>
                <field name="posTransactionId"><default-field title="POS Txn"><display/></default-field></field>
                <field name="customerPartyId"><default-field title="Customer"><display/></default-field></field>
                <field name="discountApplied"><default-field title="Discount"><display format="#,##0.00"/></default-field></field>
                <field name="usedDate"><header-field show-order-by="true"/>
                    <default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
