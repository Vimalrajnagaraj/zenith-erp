<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.promotions.Promotion" count-field="activePromos">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.promotions.CouponCode" count-field="activeCoupons">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.promotions.PromotionUsage" count-field="totalUsages"/>
        <entity-find entity-name="zenith.erp.promotions.PromotionUsage" list="recentUsages" limit="10">
            <order-by field-name="-usedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Promotions Overview" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage promotions, coupons, and track discount usage." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Promotions" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${activePromos}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="local_offer" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Coupons" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${activeCoupons}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-orange-1 border-radius-md text-orange-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="confirmation_number" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Total Redemptions" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalUsages}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-purple-1 border-radius-md text-purple-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="redeem" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Redemptions" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentUsages" list="recentUsages" skip-form="true">
                <field name="promotionId"><default-field title="Promotion"><display/></default-field></field>
                <field name="orderId"><default-field title="Order"><display/></default-field></field>
                <field name="posTransactionId"><default-field title="POS Txn"><display/></default-field></field>
                <field name="discountApplied"><default-field title="Discount"><display format="#,##0.00"/></default-field></field>
                <field name="usedDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
