<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product Barcodes" default-menu-index="2">

    <transition name="addBarcode">
        <service-call name="zenith.barcode.BarcodeServices.add#ProductBarcode"/>
        <default-response url="."/>
    </transition>
    <transition name="generateBarcode">
        <service-call name="zenith.barcode.BarcodeServices.generate#InternalBarcode"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.barcode.ProductBarcodeDetail" list="barcodes">
            <search-form-inputs default-order-by="productName,barcodeValue"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Product Barcodes" type="h4" style="text-weight-bold q-my-none"/>
            <container style="row q-gutter-sm">
                <container-dialog id="AddBarcode" button-text="Add Barcode" type="success">
                    <form-single name="AddBarcodeForm" transition="addBarcode">
                        <field name="productId"><default-field title="Product">
                            <drop-down><entity-options key="${productId}" text="${productName} [${pseudoId}]">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="productName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="barcodeTypeEnumId"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="BarcodeType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="barcodeValue"><default-field title="Barcode Value"><text-line size="25"/></default-field></field>
                        <field name="isPrimary"><default-field title="Primary?">
                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <container-dialog id="GenerateBarcode" button-text="Generate Internal" type="info">
                    <form-single name="GenerateForm" transition="generateBarcode">
                        <field name="productId"><default-field title="Product">
                            <drop-down><entity-options key="${productId}" text="${productName} [${pseudoId}]">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    <order-by field-name="productName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="prefix"><default-field title="Prefix"><text-line size="8" default-value="ZEN"/></default-field></field>
                        <field name="submitBtn"><default-field title="Generate"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="BarcodesForm" list="barcodes" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="productName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Product"><display/></default-field></field>
                <field name="pseudoId"><default-field title="SKU"><display/></default-field></field>
                <field name="barcodeValue"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Barcode"><display/></default-field></field>
                <field name="printLink"><default-field title="Label">
                    <link url="../renderLabels" text="Print" parameter-map="[barcodeId:barcodeId, moquiSessionToken:ec.web.sessionToken]" link-type="anchor"/>
                </default-field></field>
                <field name="barcodeTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="BarcodeType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                <field name="isPrimary"><default-field title="Primary"><display/></default-field></field>
                <field name="productTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
