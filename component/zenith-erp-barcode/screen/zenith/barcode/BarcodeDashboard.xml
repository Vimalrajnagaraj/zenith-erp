<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.barcode.ProductBarcode" count-field="totalBarcodes">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodeLabel" count-field="totalTemplates"/>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="pendingJobs">
            <econdition field-name="statusId" value="BpPending"/>
        </entity-find-count>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Barcode Management" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage product barcodes, label templates, and print jobs." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Barcodes" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalBarcodes}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="qr_code_scanner" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Label Templates" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalTemplates}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="label" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Pending Print Jobs" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${pendingJobs}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-orange-1 border-radius-md text-orange-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="print" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Barcode Lookup -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Quick Barcode Lookup" type="h5" style="text-weight-bold q-mb-md"/>
            <form-single name="LookupForm" transition=".">
                <field name="barcodeValue"><default-field title="Scan / Enter Barcode"><text-line size="30"/></default-field></field>
                <field name="submitBtn"><default-field title="Lookup"><submit/></default-field></field>
            </form-single>
            <section name="LookupResult" condition="barcodeValue">
                <actions>
                    <service-call name="zenith.barcode.BarcodeServices.lookup#ProductByBarcode"
                                  in-map="[barcodeValue:barcodeValue]" out-map="lookupResult"/>
                </actions>
                <widgets>
                    <section name="Found" condition="lookupResult.found">
                        <widgets>
                            <container style="q-pa-md bg-positive text-white border-radius-md q-mt-md">
                                <label text="Product: ${lookupResult.productName} (${lookupResult.productId})" type="p" style="text-weight-bold q-mb-xs"/>
                                <label text="Price: ${lookupResult.listPrice != null ? '₹' + lookupResult.listPrice : 'N/A'}" type="p"/>
                            </container>
                        </widgets>
                        <fail-widgets>
                            <container style="q-pa-md bg-negative text-white border-radius-md q-mt-md">
                                <label text="No product found for barcode: ${barcodeValue}" type="p"/>
                            </container>
                        </fail-widgets>
                    </section>
                </widgets>
            </section>
        </container>
    </widgets>
</screen>
