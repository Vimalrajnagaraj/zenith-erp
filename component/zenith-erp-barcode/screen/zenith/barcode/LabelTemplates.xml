<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Label Templates" default-menu-index="3">

    <transition name="createTemplate">
        <actions>
            <set field="org" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="org == '_NA_'"><set field="org" from="null"/></if>
            <service-call name="create#zenith.erp.barcode.BarcodeLabel" out-map="createOut" in-map="context + [organizationPartyId:org]"/>
            <!-- BC-031: keep a single default -->
            <if condition="isDefault == 'Y' &amp;&amp; org != null">
                <service-call name="zenith.barcode.BarcodeServices.enforce#SingleDefaultTemplate" in-map="[organizationPartyId:org, keepLabelId:createOut.labelId]"/>
            </if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate">
        <actions>
            <entity-find-one entity-name="zenith.erp.barcode.BarcodeLabel" value-field="tpl"/>
            <if condition="tpl == null"><return error="true" message="Template not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <!-- org guard: only the owning org (super-admin exempt) may edit its template (IDOR) -->
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (tpl.organizationPartyId == null || !_ao || tpl.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this template."/>
            </if>
            <!-- in-map="context" (not auto-map): inside a transition's <actions> a bare service-call does
                 NOT auto-map the submitted web params, so the fields would silently not update. -->
            <service-call name="update#zenith.erp.barcode.BarcodeLabel" in-map="context"/>
            <!-- BC-031: setting this template default demotes the org's other defaults -->
            <if condition="isDefault == 'Y' &amp;&amp; tpl.organizationPartyId != null">
                <service-call name="zenith.barcode.BarcodeServices.enforce#SingleDefaultTemplate" in-map="[organizationPartyId:tpl.organizationPartyId, keepLabelId:tpl.labelId]"/>
            </if>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
        <entity-find entity-name="zenith.erp.barcode.BarcodeLabel" list="templates">
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
            <order-by field-name="labelName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Label Templates" type="h4" style="text-weight-bold q-my-none"/>
            <section name="bar_CreateTemplate_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="CreateTemplate" button-text="New Template" type="success">
                <form-single name="CreateTemplateForm" transition="createTemplate">
                    <field name="labelName"><default-field title="Name"><text-line size="25"/></default-field></field>
                    <field name="labelWidth"><default-field title="Width (mm)"><text-line size="8"/></default-field></field>
                    <field name="labelHeight"><default-field title="Height (mm)"><text-line size="8"/></default-field></field>
                    <field name="barcodeTypeEnumId"><default-field title="Barcode Format">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="BarcodeType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="columnsPerRow"><default-field title="Columns Per Row"><text-line size="4" default-value="3"/></default-field></field>
                    <field name="showProductName"><default-field title="Show Product Name">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="showPrice"><default-field title="Show Price">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="showSku"><default-field title="Show SKU">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                    <field name="showMrp"><default-field title="Show MRP">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                    <field name="isDefault"><default-field title="Set as Default">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="TemplatesForm" list="templates" transition="updateTemplate">
                <field name="labelId"><default-field><hidden/></default-field></field>
                <field name="labelName"><default-field title="Name"><text-line size="20"/></default-field></field>
                <field name="labelWidth"><default-field title="W (mm)"><text-line size="5"/></default-field></field>
                <field name="labelHeight"><default-field title="H (mm)"><text-line size="5"/></default-field></field>
                <field name="columnsPerRow"><default-field title="Cols"><text-line size="3"/></default-field></field>
                <field name="showProductName"><default-field title="Name?">
                    <drop-down><option key="Y" text="Y"/><option key="N" text="N"/></drop-down></default-field></field>
                <field name="showPrice"><default-field title="Price?">
                    <drop-down><option key="Y" text="Y"/><option key="N" text="N"/></drop-down></default-field></field>
                <field name="isDefault"><default-field title="Default">
                    <drop-down><option key="N" text="N"/><option key="Y" text="Y"/></drop-down></default-field></field>
                <field name="submitBtn">
                    <conditional-field name="bar_tpl_update_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
