<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Print Jobs" default-menu-index="4">

    <parameter name="printJobId"/>

    <transition name="createPrintJob">
        <!-- Builds the items list from parallel productId[]/quantity[] form arrays (the New Print Job modal
             can add multiple product rows). Still works for a single product. create#PrintJob org-stamps
             the job + each item server-side and recomputes totalLabels. -->
        <actions>
            <script><![CDATA[
                def pids = ec.web.parameters.productId
                def qtys = ec.web.parameters.quantity
                if (!(pids instanceof List)) pids = (pids != null && pids.toString().trim()) ? [pids] : []
                if (!(qtys instanceof List)) qtys = (qtys != null) ? [qtys] : []
                def built = []
                pids.eachWithIndex { pid, i ->
                    if (pid != null && pid.toString().trim()) {
                        def qv = (i < qtys.size()) ? qtys[i] : '1'
                        def q = (qv?.toString()?.isInteger()) ? (qv as Integer) : 1
                        if (q < 1) q = 1
                        built.add([productId: pid.toString().trim(), quantity: q])
                    }
                }
                itemsList = built
            ]]></script>
            <service-call name="zenith.barcode.BarcodeServices.create#PrintJob" out-map="context"
                          in-map="[labelId:labelId, items:itemsList]"/>
        </actions>
        <!-- land on the builder for the new job so more products can be added before printing -->
        <default-response url="." parameter-map="[printJobId:printJobId]"/>
    </transition>
    <transition name="addItem">
        <service-call name="zenith.barcode.BarcodeServices.add#PrintJobItem"
                      in-map="[printJobId:printJobId, productId:productId, quantity:quantity]"/>
        <default-response url="." parameter-map="[printJobId:printJobId]"/>
    </transition>
    <transition name="removeItem">
        <service-call name="zenith.barcode.BarcodeServices.remove#PrintJobItem"
                      in-map="[printJobId:printJobId, productId:productId]"/>
        <default-response url="." parameter-map="[printJobId:printJobId]"/>
    </transition>
    <transition name="completePrintJob">
        <service-call name="zenith.barcode.BarcodeServices.complete#PrintJob" in-map="[printJobId:printJobId]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>

        <entity-find entity-name="zenith.erp.barcode.BarcodePrintJob" list="printJobs">
            <search-form-inputs default-order-by="-createdDate"/>
            <!-- org isolation: a transition/standalone find runs outside the MANTLE_ACTIVE_ORG filter -->
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
        </entity-find>

        <!-- Stat cards: real, org-scoped counts (admin with no active org sees all). -->
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="statTotal">
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="statPending">
            <econdition field-name="statusId" value="BpPending"/>
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.barcode.BarcodePrintJob" count-field="statCompleted">
            <econdition field-name="statusId" value="BpCompleted"/>
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find entity-name="zenith.erp.barcode.BarcodePrintJob" list="_compJobs">
            <econdition field-name="statusId" value="BpCompleted"/>
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
            <select-field field-name="totalLabels"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.barcode.BarcodeLabel" list="_labs">
            <econdition field-name="organizationPartyId" from="_ao" ignore-if-empty="true"/>
            <order-by field-name="labelName"/>
        </entity-find>
        <!-- New Print Job modal option lists (org-scoped, same scope as the native dialog) -->
        <entity-find entity-name="mantle.product.Product" list="_prodOpts">
            <econdition field-name="ownerPartyId" from="_ao" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
        <script><![CDATA[
            long _sum = 0
            for (r in (_compJobs ?: [])) { _sum += (r.totalLabels ?: 0) }
            statLabels = _sum
            statTotalF = ec.l10n.format(statTotal ?: 0, '#,##0')
            statPendingF = ec.l10n.format(statPending ?: 0, '#,##0')
            statCompletedF = ec.l10n.format(statCompleted ?: 0, '#,##0')
            statLabelsF = ec.l10n.format(statLabels ?: 0, '#,##0')
            // labelId -> [name, dims] for the Template cell (name + "W x H mm" subtitle)
            labelMap = [:]
            labelOptions = []
            for (l in (_labs ?: [])) {
                def w = (l.labelWidth != null) ? l.labelWidth.stripTrailingZeros().toPlainString() : null
                def h = (l.labelHeight != null) ? l.labelHeight.stripTrailingZeros().toPlainString() : null
                def dims = (w != null && h != null) ? (w + ' x ' + h + ' mm') : ''
                labelMap[l.labelId] = [name: (l.labelName ?: l.labelId), dims: dims]
                labelOptions.add([id: l.labelId, label: (l.labelName ?: l.labelId)])
            }
            productOptions = []
            for (p in (_prodOpts ?: [])) {
                productOptions.add([id: p.productId, label: ((p.productName ?: p.productId) + ' (' + (p.pseudoId ?: p.productId) + ')')])
            }
            // /apps vs /qapps mount prefix for the modal's form POST target
            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/')
            appBase = (_zi > 0) ? _uri.substring(0, _zi) : ''
            moquiToken = (ec.web != null) ? (ec.web.sessionToken ?: '') : ''
        ]]></script>

        <!-- builder context: only when a job is selected AND the caller owns it (super-admin exempt) -->
        <if condition="printJobId">
            <entity-find-one entity-name="zenith.erp.barcode.BarcodePrintJob" value-field="curJob"/>
            <if condition="curJob != null &amp;&amp; (ec.user.isInGroup('ADMIN') || (_ao != null &amp;&amp; curJob.organizationPartyId == _ao))">
                <set field="showBuilder" from="true"/>
                <entity-find-one entity-name="zenith.erp.barcode.BarcodeLabel" value-field="curLabel">
                    <field-map field-name="labelId" from="curJob.labelId"/></entity-find-one>
                <set field="curLabelName" from="curLabel?.labelName ?: '(none)'"/>
                <entity-find entity-name="zenith.erp.barcode.BarcodePrintJobItem" list="jobItems">
                    <econdition field-name="printJobId"/>
                    <order-by field-name="productId"/>
                </entity-find>
            </if>
        </if>
    </actions>

    <widgets>
        <!-- ===== Page header: title + subtitle + violet "New Print Job" (opens the custom modal) ===== -->
        <render-mode><text type="html,qvt"><![CDATA[
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px">
                <div><div style="font-size:26px;font-weight:700;color:var(--z-text-main,#111827);line-height:1.2">Print Jobs</div><div style="font-size:14px;margin-top:4px;color:var(--z-text-muted,#6B7280)">Create and manage your label print jobs.</div></div>
                <button type="button" onclick="var o=document.getElementById('npj-overlay');if(o)o.style.display='flex'" style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:19px">add</span>New Print Job</button>
            </div>
        ]]></text></render-mode>

        <!-- ===== Stat cards (real, org-scoped) ===== -->
        <render-mode><text type="html,qvt"><![CDATA[
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-bottom:20px">
                <div style="flex:1 1 210px;min-width:200px;background:rgba(124,58,237,.06);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(124,58,237,.12)"><span class="material-icons" style="font-size:24px;color:#7C3AED">print</span></div>
                    <div style="min-width:0">
                        <div style="font-size:13px;font-weight:600;color:var(--z-text-main,#111827)">Total Jobs</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statTotalF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">All time</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(217,119,6,.07);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(217,119,6,.14)"><span class="material-icons" style="font-size:24px;color:#B45309">schedule</span></div>
                    <div style="min-width:0">
                        <div style="font-size:13px;font-weight:600;color:#B45309">Pending</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statPendingF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Waiting to print</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(16,185,129,.07);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(16,185,129,.15)"><span class="material-icons" style="font-size:24px;color:#0E9F6E">check_circle</span></div>
                    <div style="min-width:0">
                        <div style="font-size:13px;font-weight:600;color:#0E9F6E">Completed</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statCompletedF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Successfully printed</div>
                    </div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:rgba(37,99,235,.06);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(37,99,235,.12)"><span class="material-icons" style="font-size:24px;color:#2563EB">description</span></div>
                    <div style="min-width:0">
                        <div style="font-size:13px;font-weight:600;color:#2563EB">Total Labels Printed</div>
                        <div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${statLabelsF}</div>
                        <div style="font-size:12px;color:var(--z-text-muted,#6B7280)">All time</div>
                    </div>
                </div>
            </div>
        ]]></text></render-mode>

        <!-- ============ Builder panel: add/remove products, then print (shown on drill-in) ============ -->
        <section name="BuilderSection">
            <condition><expression>showBuilder</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Print Job #${curJob.printJobId}" type="h5" style="text-weight-bold q-my-none"/>
                        <link url="." text="Close" parameter-map="[printJobId:'']" btn-type="grey"/>
                    </container>
                    <container style="row q-gutter-md q-mb-md">
                        <label text="Template: ${curLabelName}" type="span" style="text-grey-7"/>
                        <label text="Status: ${curJob.statusId}" type="span" style="text-grey-7"/>
                        <label text="Total Labels: ${curJob.totalLabels ?: 0}" type="span" style="text-weight-bold"/>
                    </container>

                    <!-- add a product line -->
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="printJobId"><default-field><hidden default-value="${printJobId}"/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="false"><entity-options key="${productId}" text="${productName} (${pseudoId})">
                                <entity-find entity-name="mantle.product.Product">
                                    <econdition field-name="ownerPartyId" from="_ao" ignore-if-empty="true"/>
                                    <order-by field-name="productName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="quantity"><default-field title="Quantity"><text-line size="6" default-value="1"/></default-field></field>
                        <field name="addBtn"><default-field title="Add Product"><submit/></default-field></field>
                    </form-single>

                    <form-list name="JobItemsForm" list="jobItems" skip-form="true">
                        <field name="productId"><default-field title="Product">
                            <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                        </default-field></field>
                        <field name="barcodeValue"><default-field title="Barcode"><display/></default-field></field>
                        <field name="quantity"><default-field title="Qty"><display/></default-field></field>
                        <field name="removeLink"><default-field title="">
                            <link url="removeItem" text="Remove" parameter-map="[printJobId:printJobId, productId:productId]" btn-type="negative"/>
                        </default-field></field>
                    </form-list>
                    <section name="NoItems"><condition><expression>!jobItems</expression></condition><widgets>
                        <label text="No products yet — add one above so the job generates labels." type="p" style="text-grey-7 q-mt-md"/>
                    </widgets></section>

                    <container style="row q-gutter-sm q-mt-md">
                        <section name="PrintBtnSec"><condition><expression>jobItems</expression></condition><widgets>
                            <link url="../renderLabels" text="Print Labels" parameter-map="[printJobId:printJobId, moquiSessionToken:ec.web.sessionToken]" link-type="anchor" btn-type="primary"/>
                        </widgets></section>
                        <section name="MarkBuilderSec"><condition><expression>curJob.statusId != 'BpCompleted'</expression></condition><widgets>
                            <link url="completePrintJob" text="Mark Printed" parameter-map="[printJobId:printJobId]" btn-type="positive"/>
                        </widgets></section>
                    </container>
                </container>
            </widgets>
        </section>

        <!-- ===== Jobs table (native form-list + z-listchrome toolbar/footer) ===== -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search by Job ID or Template" style="display:none"></span>]]></text></render-mode>
            <form-list name="PrintJobsForm" list="printJobs" list-entry="pj" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <row-actions><script><![CDATA[
                    def _lm = labelMap[pj.labelId]
                    tmplName = _lm?.name ?: (pj.labelId ?: '—')
                    tmplDims = _lm?.dims ?: ''
                    def _s = pj.statusId
                    stCls = 'grey'; stTxt = 'Unknown'
                    if (_s == 'BpPending') { stCls = 'warning'; stTxt = 'Pending' }
                    else if (_s == 'BpPrinting') { stCls = 'info'; stTxt = 'In Progress' }
                    else if (_s == 'BpCompleted') { stCls = 'success'; stTxt = 'Completed' }
                    else if (_s == 'BpFailed') { stCls = 'danger'; stTxt = 'Failed' }
                    createdStr = (pj.createdDate != null) ? ec.l10n.format(pj.createdDate, 'dd MMM yyyy, hh:mm a') : '—'
                    completedStr = (pj.completedDate != null) ? ec.l10n.format(pj.completedDate, 'dd MMM yyyy, hh:mm a') : '—'
                    def _done = (_s == 'BpCompleted')
                    showBuild = _done ? 'pj-hide' : ''
                    showMark = _done ? 'pj-hide' : ''
                    showView = _done ? '' : 'pj-hide'
                ]]></script></row-actions>
                <field name="printJobId"><header-field title="Job ID" show-order-by="true"/>
                    <default-field title="Job ID"><label text="${pj.printJobId}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                <field name="labelId"><header-field title="Template"/>
                    <default-field title="Template">
                        <label text="${tmplName}" type="span" style="text-dark text-weight-medium"/>
                        <label text="${tmplDims}" type="span" style="pj-dims"/>
                    </default-field></field>
                <field name="totalLabels"><header-field title="Labels" show-order-by="true"/>
                    <default-field title="Labels"><label text="${pj.totalLabels ?: 0}" type="span" style="text-dark"/></default-field></field>
                <field name="statusId"><header-field title="Status">
                    <drop-down allow-empty="true">
                        <option key="BpPending" text="Pending"/><option key="BpPrinting" text="In Progress"/>
                        <option key="BpCompleted" text="Completed"/><option key="BpFailed" text="Failed"/>
                    </drop-down></header-field>
                    <default-field title="Status"><label text="${stTxt}" type="span" style="zenith-badge ${stCls}"/></default-field></field>
                <field name="createdDate"><header-field title="Created" show-order-by="true"/>
                    <default-field title="Created"><label text="${createdStr}" type="span" style="text-grey-6"/></default-field></field>
                <field name="completedDate"><header-field title="Completed" show-order-by="true"/>
                    <default-field title="Completed"><label text="${completedStr}" type="span" style="text-grey-6"/></default-field></field>
                <field name="actionCol"><default-field title="Actions">
                    <link url="." text="Build / Add Items" parameter-map="[printJobId:pj.printJobId]" style="pj-abtn violet ${showBuild}"/>
                    <link url="../renderLabels" text="Print Labels" parameter-map="[printJobId:pj.printJobId, moquiSessionToken:ec.web.sessionToken]" link-type="anchor" style="pj-abtn blue"/>
                    <link url="completePrintJob" text="Mark Printed" parameter-map="[printJobId:pj.printJobId]" style="pj-abtn green ${showMark}"/>
                    <link url="." text="View Details" parameter-map="[printJobId:pj.printJobId]" style="pj-abtn ${showView}"/>
                    <label text="⋮" type="span" style="z-kebab-static"/>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>

        <!-- ===== New Print Job modal (custom; fetch-POST to the createPrintJob transition — a <div>, NOT a
             <form>, because a raw <form> loses its card layout on /qapps) ===== -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign npjRow="display:flex;align-items:center;gap:14px;margin-bottom:16px">
        <#assign npjChip="width:38px;height:38px;flex:0 0 auto;border-radius:10px;background:rgba(124,58,237,.1);display:flex;align-items:center;justify-content:center;color:#7C3AED">
        <#assign npjLbl="width:120px;flex:0 0 auto;font-size:13.5px;font-weight:600;color:#111827">
        <#assign npjSel="width:100%;box-sizing:border-box;height:40px;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <#assign npjInp="flex:1;min-width:0;height:40px;box-sizing:border-box;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#111827;background:#fff;outline:none">
        <div id="npj-overlay" style="display:none;position:fixed;inset:0;background:rgba(17,24,39,.4);z-index:12000;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;font-family:'Segoe UI',Arial,sans-serif">
            <div id="npj-modal" style="background:#fff;border-radius:12px;box-shadow:0 20px 40px rgba(17,24,39,.16);width:100%;max-width:460px">
                <input id="npj-token" type="hidden" value="${(moquiToken)!''}"/>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px">
                    <div style="font-size:18px;font-weight:700;color:#111827">New Print Job</div>
                    <button type="button" onclick="document.getElementById('npj-overlay').style.display='none'" title="Close" style="width:32px;height:32px;border:none;background:transparent;color:#9CA3AF;cursor:pointer;border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="material-icons" style="font-size:20px">close</span></button>
                </div>
                <div style="padding:0 24px 8px">
                    <div style="${npjRow}">
                        <span style="${npjChip}"><span class="material-icons" style="font-size:19px">local_offer</span></span>
                        <label style="${npjLbl}">Label Template</label>
                        <div style="flex:1;min-width:0"><select id="npj-label" name="labelId" style="${npjSel}"><option value="">Select template</option><#list (labelOptions![]) as l><option value="${(l.id)?html}">${(l.label)?html}</option></#list></select></div>
                    </div>
                    <div id="npj-pentries">
                        <div class="npj-pentry">
                            <div style="${npjRow}">
                                <span style="${npjChip}"><span class="material-icons" style="font-size:19px">inventory_2</span></span>
                                <label style="${npjLbl}">Product</label>
                                <div style="flex:1;min-width:0"><select name="productId" required style="${npjSel}"><option value="">Select product</option><#list (productOptions![]) as p><option value="${(p.id)?html}">${(p.label)?html}</option></#list></select></div>
                            </div>
                            <div style="${npjRow}">
                                <span style="${npjChip}"><span class="material-icons" style="font-size:19px">description</span></span>
                                <label style="${npjLbl}">Quantity (Labels)</label>
                                <input type="number" name="quantity" value="1" min="1" style="${npjInp}"/>
                            </div>
                        </div>
                    </div>
                    <hr style="border:none;border-top:1px solid #E5E7EB;margin:16px 0"/>
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#111827">Add Products</div>
                            <div style="font-size:12.5px;color:#6B7280;margin-top:2px">Add multiple products to this print job</div>
                        </div>
                        <button type="button" id="npj-add" style="display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border:1px solid #7C3AED;border-radius:8px;background:#fff;color:#7C3AED;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap"><span class="material-icons" style="font-size:17px">add</span>Add Another Product</button>
                    </div>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:12px;padding:18px 24px;border-top:1px solid #E5E7EB;margin-top:12px">
                    <button type="button" onclick="document.getElementById('npj-overlay').style.display='none'" style="height:40px;padding:0 20px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#6B7280;font-size:14px;font-weight:600;cursor:pointer">Cancel</button>
                    <button type="button" id="npj-create" style="height:40px;padding:0 20px;border:none;border-radius:8px;background:#7C3AED;color:#fff;font-size:14px;font-weight:600;cursor:pointer">Create &amp; Add Products</button>
                </div>
            </div>
        </div>
        <script>
        (function(){
            function setColor(s){ s.style.color = s.value ? '#111827' : '#9CA3AF'; }
            Array.prototype.forEach.call(document.querySelectorAll('#npj-overlay select'), function(s){ setColor(s); s.addEventListener('change', function(){ setColor(s); }); });
            var addBtn=document.getElementById('npj-add'), cont=document.getElementById('npj-pentries');
            if(addBtn && cont && !addBtn.__w){ addBtn.__w=1; addBtn.addEventListener('click', function(){
                var first=cont.querySelector('.npj-pentry'); if(!first) return;
                var clone=first.cloneNode(true);
                Array.prototype.forEach.call(clone.querySelectorAll('select,input'), function(el){
                    if(el.name==='productId'){ el.selectedIndex=0; el.removeAttribute('required'); setColor(el); el.addEventListener('change', function(){ setColor(el); }); }
                    else if(el.name==='quantity'){ el.value='1'; }
                });
                var rm=document.createElement('div');
                rm.style.cssText='text-align:right;margin:-8px 0 12px';
                var rl=document.createElement('button');
                rl.type='button'; rl.textContent='Remove'; rl.style.cssText='border:none;background:transparent;color:#DC2626;font-size:12.5px;font-weight:600;cursor:pointer';
                rl.addEventListener('click', function(){ clone.parentNode.removeChild(clone); });
                rm.appendChild(rl); clone.appendChild(rm);
                cont.appendChild(clone);
            }); }
            // Create: collect labelId + every product row -> fetch POST to createPrintJob, then follow the
            // transition's redirect (response URL carries ?printJobId -> lands on the builder).
            var create=document.getElementById('npj-create');
            if(create && !create.__w){ create.__w=1; create.addEventListener('click', function(){
                var lbl=document.getElementById('npj-label'); var labelId=lbl ? lbl.value : '';
                if(!labelId){ alert('Label Template is required.'); return; }
                var prods=cont.querySelectorAll('select[name="productId"]');
                var qtys=cont.querySelectorAll('input[name="quantity"]');
                var body=new URLSearchParams(); body.append('labelId', labelId); var any=false;
                Array.prototype.forEach.call(prods, function(ps, i){ if(ps.value){ any=true; body.append('productId', ps.value); var q=(qtys[i] && qtys[i].value) ? qtys[i].value : '1'; body.append('quantity', q); } });
                if(!any){ alert('Select at least one product.'); return; }
                var tok=''; try{ tok=window.moqui.webrootVue.moquiSessionToken; }catch(e){}
                if(!tok){ var h=document.getElementById('npj-token'); tok=h ? h.value : ''; }
                body.append('moquiSessionToken', tok);
                var base=location.pathname.split('/zenith/')[0];
                create.disabled=true; create.textContent='Creating...';
                fetch(base+'/zenith/barcode/PrintJobs/createPrintJob',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                    .then(function(r){ location.href = r.url || location.href; })
                    .catch(function(){ create.disabled=false; create.textContent='Create & Add Products'; alert('Create failed — please try again.'); });
            }); }
        })();
        </script>
        ]]></text></render-mode>
    </widgets>
</screen>
