<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Print Jobs" default-menu-index="4">

    <transition name="createPrintJob">
        <service-call name="zenith.barcode.BarcodeServices.create#PrintJob"/>
        <default-response url="."/>
    </transition>
    <transition name="completePrintJob">
        <service-call name="update#zenith.erp.barcode.BarcodePrintJob" in-map="[printJobId:printJobId, statusId:'BpCompleted', completedDate:ec.user.nowTimestamp]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.barcode.BarcodePrintJob" list="printJobs">
            <search-form-inputs default-order-by="-createdDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Print Jobs" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="NewPrintJob" button-text="New Print Job" type="success">
                <form-single name="NewPrintJobForm" transition="createPrintJob">
                    <field name="labelId"><default-field title="Label Template">
                        <drop-down><entity-options key="${labelId}" text="${labelName}">
                            <entity-find entity-name="zenith.erp.barcode.BarcodeLabel">
                                <order-by field-name="labelName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PrintJobsForm" list="printJobs" skip-form="true">
                <field name="printJobId"><default-field title="Job ID"><display/></default-field></field>
                <field name="labelId"><default-field title="Template">
                    <display-entity entity-name="zenith.erp.barcode.BarcodeLabel" key-field-name="labelId" text="${labelName}"/>
                </default-field></field>
                <field name="totalLabels"><default-field title="Labels"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="createdDate"><default-field title="Created"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="completedDate"><default-field title="Completed"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="printLink"><default-field title="Labels">
                    <link url="../renderLabels" text="Print Labels" parameter-map="[printJobId:printJobId, moquiSessionToken:ec.web.sessionToken]" link-type="anchor"/>
                </default-field></field>
                <field name="markBtn"><default-field title="">
                    <section name="MarkSec"><condition><expression>statusId != 'BpCompleted'</expression></condition><widgets>
                        <link url="completePrintJob" text="Mark Printed" parameter-map="[printJobId:printJobId]" btn-type="positive"/>
                    </widgets></section>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
