<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Product Barcode CRUD ========== -->

    <service verb="add" noun="ProductBarcode">
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="barcodeTypeEnumId" required="true"/>
            <parameter name="barcodeValue" required="true"/>
            <parameter name="isPrimary" default-value="N"/>
        </in-parameters>
        <out-parameters><parameter name="barcodeId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.product.Product" value-field="_prd"><field-map field-name="productId"/></entity-find-one>
            <set field="organizationPartyId" from="_prd?.ownerPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <script><![CDATA[
                def bv = (barcodeValue ?: '').trim()
                def checkEan = { String x ->
                    int n = x.length(); int sum = 0
                    for (int i = 0; i < n-1; i++) { int d = Character.getNumericValue(x.charAt(n-2-i)); sum += (i % 2 == 0) ? d*3 : d }
                    return ((10 - (sum % 10)) % 10) == Character.getNumericValue(x.charAt(n-1))
                }
                validationError = null
                if (!bv) validationError = 'Barcode value is required'
                else if (barcodeTypeEnumId == 'BctEan13' && !(bv ==~ /[0-9]{13}/ && checkEan(bv))) validationError = 'EAN-13 must be 13 digits with a valid check digit'
                else if (barcodeTypeEnumId == 'BctEan8' && !(bv ==~ /[0-9]{8}/ && checkEan(bv))) validationError = 'EAN-8 must be 8 digits with a valid check digit'
                else if (barcodeTypeEnumId == 'BctUpcA' && !(bv ==~ /[0-9]{12}/ && checkEan(bv))) validationError = 'UPC-A must be 12 digits with a valid check digit'
            ]]></script>
            <if condition="validationError"><return error="true" message="${validationError}"/></if>

            <!-- Check uniqueness within this organization -->
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="existing" limit="1">
                <econdition field-name="organizationPartyId"/>
                <econdition field-name="barcodeValue"/>
            </entity-find>
            <if condition="existing">
                <return error="true" message="Barcode value '${barcodeValue}' is already in use"/>
            </if>

            <!-- If setting as primary, unset any existing primary for this product -->
            <if condition="isPrimary == 'Y'">
                <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="primaries">
                    <econdition field-name="productId"/>
                    <econdition field-name="isPrimary" value="Y"/>
                </entity-find>
                <iterate list="primaries" entry="p">
                    <service-call name="update#zenith.erp.barcode.ProductBarcode"
                                  in-map="[barcodeId:p.barcodeId, isPrimary:'N']"/>
                </iterate>
            </if>

            <service-call name="create#zenith.erp.barcode.ProductBarcode" out-map="context"
                          in-map="[productId:productId, barcodeTypeEnumId:barcodeTypeEnumId,
                                   barcodeValue:barcodeValue, isPrimary:isPrimary, organizationPartyId:organizationPartyId]"/>
        </actions>
    </service>

    <service verb="lookup" noun="ProductByBarcode">
        <in-parameters><parameter name="barcodeValue" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="productId"/>
            <parameter name="productName"/>
            <parameter name="listPrice" type="BigDecimal"/>
            <parameter name="barcodeTypeEnumId"/>
            <parameter name="found" type="Boolean"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.ProductBarcodeDetail" list="results" limit="1">
                <econdition field-name="barcodeValue"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            <if condition="results">
                <set field="found" from="true"/>
                <set field="productId" from="results[0].productId"/>
                <set field="productName" from="results[0].productName"/>
                <set field="listPrice" from="results[0].listPrice"/>
                <set field="barcodeTypeEnumId" from="results[0].barcodeTypeEnumId"/>
            <else>
                <!-- Fallback: try product pseudoId -->
                <entity-find entity-name="mantle.product.Product" list="products" limit="1">
                    <econdition field-name="pseudoId" from="barcodeValue"/>
                </entity-find>
                <if condition="products">
                    <set field="found" from="true"/>
                    <set field="productId" from="products[0].productId"/>
                    <set field="productName" from="products[0].productName"/>
                    <set field="listPrice" from="products[0].mrpAmount"/>
                <else>
                    <set field="found" from="false"/>
                </else></if>
            </else></if>
        </actions>
    </service>

    <service verb="generate" noun="InternalBarcode">
        <description>Generate a unique internal barcode for a product</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="prefix" default-value="ZEN"/>
        </in-parameters>
        <out-parameters>
            <parameter name="barcodeId"/>
            <parameter name="barcodeValue"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                def rng = new java.security.SecureRandom()
                barcodeValue = prefix + String.format("%09d", rng.nextLong().abs() % 1000000000L)
            ]]></script>

            <service-call name="zenith.barcode.BarcodeServices.add#ProductBarcode" out-map="context"
                          in-map="[productId:productId, barcodeTypeEnumId:'BctInternal',
                                   barcodeValue:barcodeValue, isPrimary:'N']"/>
        </actions>
    </service>

    <!-- ========== Print Job Services ========== -->

    <service verb="create" noun="PrintJob">
        <in-parameters>
            <parameter name="labelId" required="true"/>
            <parameter name="items" type="List"><description>List of maps: productId, quantity</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="printJobId"/></out-parameters>
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="totalLabels" from="0" type="Integer"/>
            <if condition="items">
                <iterate list="items" entry="item">
                    <set field="totalLabels" from="totalLabels + (item.quantity ?: 1)" type="Integer"/>
                </iterate>
            </if>

            <service-call name="create#zenith.erp.barcode.BarcodePrintJob" out-map="jobOut"
                          in-map="[labelId:labelId, organizationPartyId:organizationPartyId, statusId:'BpPending', createdDate:ec.user.nowTimestamp,
                                   totalLabels:totalLabels, createdByUserId:ec.user.userId]"/>
            <set field="printJobId" from="jobOut.printJobId"/>

            <if condition="items">
                <iterate list="items" entry="item">
                    <!-- Get primary barcode -->
                    <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="barcodes" limit="1">
                        <econdition field-name="productId" from="item.productId"/>
                        <econdition field-name="isActive" value="Y"/>
                        <order-by field-name="-isPrimary"/>
                    </entity-find>
                    <set field="bcValue" from="barcodes ? barcodes[0].barcodeValue : item.productId"/>

                    <service-call name="create#zenith.erp.barcode.BarcodePrintJobItem"
                                  in-map="[printJobId:printJobId, organizationPartyId:organizationPartyId, productId:item.productId,
                                           quantity:item.quantity ?: 1, barcodeValue:bcValue]"/>
                </iterate>
            </if>
        </actions>
    </service>

    <service verb="get" noun="ProductBarcodes">
        <in-parameters><parameter name="productId" required="true"/></in-parameters>
        <out-parameters><parameter name="barcodes" type="List"/></out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="barcodes">
                <econdition field-name="productId"/>
                <econdition field-name="isActive" value="Y"/>
                <order-by field-name="-isPrimary,barcodeTypeEnumId"/>
            </entity-find>
        </actions>
    </service>

</services>
