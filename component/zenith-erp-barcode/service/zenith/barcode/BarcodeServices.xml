<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Product Barcode CRUD ========== -->

    <service verb="add" noun="ProductBarcode">
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="barcodeTypeEnumId" required="true"/>
            <parameter name="barcodeValue" required="true"/>
            <parameter name="isPrimary" default-value="N"/>
        </in-parameters>
        <out-parameters><parameter name="barcodeId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.product.Product" value-field="_prd"><field-map field-name="productId"/></entity-find-one>
            <set field="organizationPartyId" from="_prd?.ownerPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <script><![CDATA[
                def bv = (barcodeValue ?: '').trim()
                def checkEan = { String x ->
                    int n = x.length(); int sum = 0
                    for (int i = 0; i < n-1; i++) { int d = Character.getNumericValue(x.charAt(n-2-i)); sum += (i % 2 == 0) ? d*3 : d }
                    return ((10 - (sum % 10)) % 10) == Character.getNumericValue(x.charAt(n-1))
                }
                validationError = null
                if (!bv) validationError = 'Barcode value is required'
                else if (barcodeTypeEnumId == 'BctEan13' && !(bv ==~ /[0-9]{13}/ && checkEan(bv))) validationError = 'EAN-13 must be 13 digits with a valid check digit'
                else if (barcodeTypeEnumId == 'BctEan8' && !(bv ==~ /[0-9]{8}/ && checkEan(bv))) validationError = 'EAN-8 must be 8 digits with a valid check digit'
                else if (barcodeTypeEnumId == 'BctUpcA' && !(bv ==~ /[0-9]{12}/ && checkEan(bv))) validationError = 'UPC-A must be 12 digits with a valid check digit'
            ]]></script>
            <if condition="validationError"><return error="true" message="${validationError}"/></if>

            <!-- Check uniqueness within this organization -->
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="existing" limit="1">
                <econdition field-name="organizationPartyId"/>
                <econdition field-name="barcodeValue"/>
            </entity-find>
            <if condition="existing">
                <return error="true" message="Barcode value '${barcodeValue}' is already in use"/>
            </if>

            <!-- If setting as primary, unset any existing primary for this product -->
            <if condition="isPrimary == 'Y'">
                <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="primaries">
                    <econdition field-name="productId"/>
                    <econdition field-name="isPrimary" value="Y"/>
                </entity-find>
                <iterate list="primaries" entry="p">
                    <service-call name="update#zenith.erp.barcode.ProductBarcode"
                                  in-map="[barcodeId:p.barcodeId, isPrimary:'N']"/>
                </iterate>
            </if>

            <service-call name="create#zenith.erp.barcode.ProductBarcode" out-map="context"
                          in-map="[productId:productId, barcodeTypeEnumId:barcodeTypeEnumId,
                                   barcodeValue:barcodeValue, isPrimary:isPrimary, organizationPartyId:organizationPartyId]"/>

            <!-- Single source of truth: the PRIMARY barcode is mirrored into Product.pseudoId (the code the
                 till, exact-scan and label printing use). Also seed pseudoId if the product has none yet.
                 Non-fatal — a mirror clash never blocks adding the barcode. -->
            <if condition="isPrimary == 'Y' || !_prd?.pseudoId">
                <service-call name="zenith.barcode.BarcodeServices.sync#PseudoIdFromBarcode" ignore-error="true"
                              in-map="[productId:productId, barcodeValue:barcodeValue]"/>
            </if>
        </actions>
    </service>

    <!-- ===== Keep Product.pseudoId (billing code) and the primary ProductBarcode in sync (both ways) ===== -->
    <service verb="sync" noun="PseudoIdFromBarcode">
        <description>Mirror a (primary) barcode value into Product.pseudoId, unless it clashes with another product's code.</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="barcodeValue" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="mantle.product.Product" value-field="prd"><field-map field-name="productId"/></entity-find-one>
            <if condition="prd == null"><return/></if>
            <set field="code" from="barcodeValue?.trim()"/>
            <if condition="!code || prd.pseudoId == code"><return/></if>
            <!-- Don't collide with another product's pseudoId in the same org (unique pseudo_id+owner). -->
            <entity-find entity-name="mantle.product.Product" list="clash" limit="1">
                <econdition field-name="pseudoId" from="code"/>
                <econdition field-name="ownerPartyId" from="prd.ownerPartyId" ignore-if-empty="true"/>
                <econdition field-name="productId" operator="not-equals" from="productId"/>
            </entity-find>
            <if condition="clash">
                <return/> <!-- can't mirror; leave pseudoId as-is (the scan already reads ProductBarcode too) -->
            </if>
            <service-call name="update#mantle.product.Product" in-map="[productId:productId, pseudoId:code]"/>
        </actions>
    </service>

    <service verb="sync" noun="BarcodeFromPseudoId">
        <description>Reflect a directly-set Product.pseudoId back into the ProductBarcode table as the primary barcode.</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="code"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="mantle.product.Product" value-field="prd"><field-map field-name="productId"/></entity-find-one>
            <if condition="prd == null"><return/></if>
            <set field="org" from="prd.ownerPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="c" from="code?.trim()"/>
            <if condition="!c"><return/></if> <!-- blank code: leave the rich table untouched -->
            <!-- If another product in the org already owns this barcode value, we can't mirror it (unique). -->
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="other" limit="1">
                <econdition field-name="organizationPartyId" from="org"/>
                <econdition field-name="barcodeValue" from="c"/>
                <econdition field-name="productId" operator="not-equals" from="productId"/>
            </entity-find>
            <if condition="other"><return/></if>
            <!-- Demote this product's other primaries, then set/create this value as the primary barcode. -->
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="prims">
                <econdition field-name="productId"/>
                <econdition field-name="isPrimary" value="Y"/>
            </entity-find>
            <iterate list="prims" entry="pp">
                <if condition="pp.barcodeValue != c">
                    <service-call name="update#zenith.erp.barcode.ProductBarcode" in-map="[barcodeId:pp.barcodeId, isPrimary:'N']"/>
                </if>
            </iterate>
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="mine" limit="1">
                <econdition field-name="productId"/>
                <econdition field-name="barcodeValue" from="c"/>
            </entity-find>
            <if condition="mine">
                <service-call name="update#zenith.erp.barcode.ProductBarcode" in-map="[barcodeId:mine[0].barcodeId, isPrimary:'Y', isActive:'Y']"/>
            <else>
                <service-call name="create#zenith.erp.barcode.ProductBarcode"
                              in-map="[productId:productId, organizationPartyId:org, barcodeTypeEnumId:'BctInternal',
                                       barcodeValue:c, isPrimary:'Y', isActive:'Y']"/>
            </else></if>
        </actions>
    </service>

    <service verb="lookup" noun="ProductByBarcode">
        <in-parameters><parameter name="barcodeValue" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="productId"/>
            <parameter name="productName"/>
            <parameter name="listPrice" type="BigDecimal"/>
            <parameter name="barcodeTypeEnumId"/>
            <parameter name="found" type="Boolean"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.ProductBarcodeDetail" list="results" limit="1">
                <econdition field-name="barcodeValue"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            <if condition="results">
                <set field="found" from="true"/>
                <set field="productId" from="results[0].productId"/>
                <set field="productName" from="results[0].productName"/>
                <set field="listPrice" from="results[0].listPrice"/>
                <set field="barcodeTypeEnumId" from="results[0].barcodeTypeEnumId"/>
            <else>
                <!-- Fallback: try product pseudoId -->
                <entity-find entity-name="mantle.product.Product" list="products" limit="1">
                    <econdition field-name="pseudoId" from="barcodeValue"/>
                </entity-find>
                <if condition="products">
                    <set field="found" from="true"/>
                    <set field="productId" from="products[0].productId"/>
                    <set field="productName" from="products[0].productName"/>
                    <set field="listPrice" from="products[0].mrpAmount"/>
                <else>
                    <set field="found" from="false"/>
                </else></if>
            </else></if>
        </actions>
    </service>

    <service verb="generate" noun="InternalBarcode">
        <description>Generate a unique internal barcode for a product</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="prefix" default-value="ZEN"/>
        </in-parameters>
        <out-parameters>
            <parameter name="barcodeId"/>
            <parameter name="barcodeValue"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                def rng = new java.security.SecureRandom()
                barcodeValue = prefix + String.format("%09d", rng.nextLong().abs() % 1000000000L)
            ]]></script>

            <service-call name="zenith.barcode.BarcodeServices.add#ProductBarcode" out-map="context"
                          in-map="[productId:productId, barcodeTypeEnumId:'BctInternal',
                                   barcodeValue:barcodeValue, isPrimary:'N']"/>
        </actions>
    </service>

    <!-- ========== Print Job Services ========== -->

    <service verb="create" noun="PrintJob">
        <in-parameters>
            <parameter name="labelId" required="true"/>
            <parameter name="items" type="List"><description>List of maps: productId, quantity</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="printJobId"/></out-parameters>
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="organizationPartyId == '_NA_'"><set field="organizationPartyId" from="null"/></if>

            <service-call name="create#zenith.erp.barcode.BarcodePrintJob" out-map="jobOut"
                          in-map="[labelId:labelId, organizationPartyId:organizationPartyId, statusId:'BpPending', createdDate:ec.user.nowTimestamp,
                                   totalLabels:0, createdByUserId:ec.user.userId]"/>
            <set field="printJobId" from="jobOut.printJobId"/>

            <if condition="items">
                <iterate list="items" entry="item">
                    <entity-find-one entity-name="mantle.product.Product" value-field="_ip">
                        <field-map field-name="productId" from="item.productId"/></entity-find-one>
                    <!-- Only add real products the caller's org owns (super-admin exempt); silently skip foreign/unknown. -->
                    <if condition="_ip != null &amp;&amp; (ec.user.isInGroup('ADMIN') || _ip.ownerPartyId == null || organizationPartyId == null || _ip.ownerPartyId == organizationPartyId)">
                        <set field="qty" from="(item.quantity?.toString()?.isInteger()) ? (item.quantity as Integer) : 1"/>
                        <if condition="qty &lt; 1"><set field="qty" from="1"/></if>
                        <!-- Get primary barcode; fall back to the product code, then the id -->
                        <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="barcodes" limit="1">
                            <econdition field-name="productId" from="item.productId"/>
                            <econdition field-name="isActive" value="Y"/>
                            <order-by field-name="-isPrimary"/>
                        </entity-find>
                        <set field="bcValue" from="barcodes ? barcodes[0].barcodeValue : (_ip.pseudoId ?: item.productId)"/>
                        <service-call name="create#zenith.erp.barcode.BarcodePrintJobItem"
                                      in-map="[printJobId:printJobId, organizationPartyId:organizationPartyId, productId:item.productId,
                                               quantity:qty, barcodeValue:bcValue]"/>
                    </if>
                </iterate>
                <service-call name="zenith.barcode.BarcodeServices.recompute#PrintJobTotal" in-map="[printJobId:printJobId]"/>
            </if>
        </actions>
    </service>

    <!-- Recompute a print job's label total from its items (single source of truth for totalLabels). -->
    <service verb="recompute" noun="PrintJobTotal">
        <in-parameters><parameter name="printJobId" required="true"/></in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.BarcodePrintJobItem" list="items">
                <econdition field-name="printJobId"/>
            </entity-find>
            <set field="total" from="0" type="Integer"/>
            <iterate list="items" entry="it">
                <set field="total" from="total + ((it.quantity ?: 0) as Integer)" type="Integer"/>
            </iterate>
            <service-call name="update#zenith.erp.barcode.BarcodePrintJob" in-map="[printJobId:printJobId, totalLabels:total]"/>
        </actions>
    </service>

    <!-- Add (or increment) a product line on a print job. Org-guarded: only the owning org (super-admin
         exempt) may touch the job, and only its own products can be added (no cross-tenant product/leak). -->
    <service verb="add" noun="PrintJobItem">
        <in-parameters>
            <parameter name="printJobId" required="true"/>
            <parameter name="productId" required="true"/>
            <parameter name="quantity" default-value="1"/>
        </in-parameters>
        <out-parameters><parameter name="printJobId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.barcode.BarcodePrintJob" value-field="job"/>
            <if condition="job == null"><return error="true" message="Print job not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <set field="_isAdmin" from="ec.user.isInGroup('ADMIN')"/>
            <if condition="!_isAdmin &amp;&amp; (job.organizationPartyId == null || !_ao || job.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this print job."/></if>

            <entity-find-one entity-name="mantle.product.Product" value-field="_prd"><field-map field-name="productId"/></entity-find-one>
            <if condition="_prd == null"><return error="true" message="Product not found."/></if>
            <if condition="!_isAdmin &amp;&amp; _prd.ownerPartyId != null &amp;&amp; _ao != null &amp;&amp; _prd.ownerPartyId != _ao">
                <return error="true" message="You do not have access to this product."/></if>

            <set field="qty" from="(quantity?.toString()?.isInteger()) ? (quantity as Integer) : 1"/>
            <if condition="qty &lt; 1"><set field="qty" from="1"/></if>

            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="barcodes" limit="1">
                <econdition field-name="productId"/>
                <econdition field-name="isActive" value="Y"/>
                <order-by field-name="-isPrimary"/>
            </entity-find>
            <set field="bcValue" from="barcodes ? barcodes[0].barcodeValue : (_prd.pseudoId ?: productId)"/>

            <!-- PK is (printJobId, productId): re-adding the same product increments its quantity -->
            <entity-find-one entity-name="zenith.erp.barcode.BarcodePrintJobItem" value-field="existingItem"/>
            <if condition="existingItem != null">
                <service-call name="update#zenith.erp.barcode.BarcodePrintJobItem"
                              in-map="[printJobId:printJobId, productId:productId,
                                       quantity:((existingItem.quantity ?: 0) as Integer) + qty, barcodeValue:bcValue]"/>
            <else>
                <service-call name="create#zenith.erp.barcode.BarcodePrintJobItem"
                              in-map="[printJobId:printJobId, productId:productId, organizationPartyId:job.organizationPartyId,
                                       quantity:qty, barcodeValue:bcValue]"/>
            </else></if>
            <service-call name="zenith.barcode.BarcodeServices.recompute#PrintJobTotal" in-map="[printJobId:printJobId]"/>
        </actions>
    </service>

    <!-- Remove a product line from a print job (org-guarded). -->
    <service verb="remove" noun="PrintJobItem">
        <in-parameters>
            <parameter name="printJobId" required="true"/>
            <parameter name="productId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.barcode.BarcodePrintJob" value-field="job"/>
            <if condition="job == null"><return error="true" message="Print job not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (job.organizationPartyId == null || !_ao || job.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this print job."/></if>
            <service-call name="delete#zenith.erp.barcode.BarcodePrintJobItem" in-map="[printJobId:printJobId, productId:productId]"/>
            <service-call name="zenith.barcode.BarcodeServices.recompute#PrintJobTotal" in-map="[printJobId:printJobId]"/>
        </actions>
    </service>

    <!-- BC-031: enforce ONE default label template per org. After a template is set default, demote every
         OTHER default in the same org to isDefault='N' (mirrors the primary-barcode demotion pattern). -->
    <service verb="enforce" noun="SingleDefaultTemplate">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="keepLabelId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.BarcodeLabel" list="others">
                <econdition field-name="organizationPartyId"/>
                <econdition field-name="isDefault" value="Y"/>
                <econdition field-name="labelId" operator="not-equals" from="keepLabelId"/>
            </entity-find>
            <iterate list="others" entry="o">
                <service-call name="update#zenith.erp.barcode.BarcodeLabel" in-map="[labelId:o.labelId, isDefault:'N']"/>
            </iterate>
        </actions>
    </service>

    <!-- Mark a print job completed (org-guarded — replaces the unguarded inline update in the screen). -->
    <service verb="complete" noun="PrintJob">
        <in-parameters><parameter name="printJobId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.barcode.BarcodePrintJob" value-field="job"/>
            <if condition="job == null"><return error="true" message="Print job not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (job.organizationPartyId == null || !_ao || job.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this print job."/></if>
            <service-call name="update#zenith.erp.barcode.BarcodePrintJob"
                          in-map="[printJobId:printJobId, statusId:'BpCompleted', completedDate:ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="get" noun="ProductBarcodes">
        <in-parameters><parameter name="productId" required="true"/></in-parameters>
        <out-parameters><parameter name="barcodes" type="List"/></out-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="barcodes">
                <econdition field-name="productId"/>
                <econdition field-name="isActive" value="Y"/>
                <order-by field-name="-isPrimary,barcodeTypeEnumId"/>
            </entity-find>
        </actions>
    </service>

    <!-- ZE-BC-091: delete a product barcode. The Barcode module had add/generate but NO remove, so obsolete
         barcodes couldn't be cleaned up (reported). Org-guarded: only the owning org may delete its barcode
         (super-admins exempt). If the removed one was the primary and another active barcode remains for the
         product, promote it so the product keeps a primary. -->
    <service verb="delete" noun="ProductBarcode">
        <in-parameters><parameter name="barcodeId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.barcode.ProductBarcode" value-field="bc"/>
            <if condition="bc == null"><return error="true" message="Barcode not found."/></if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!ec.user.isInGroup('ADMIN') &amp;&amp; (bc.organizationPartyId == null || !_ao || _ao == '_NA_' || bc.organizationPartyId != _ao)">
                <return error="true" message="You do not have access to this barcode."/>
            </if>
            <service-call name="delete#zenith.erp.barcode.ProductBarcode" in-map="[barcodeId:barcodeId]"/>
            <if condition="bc.isPrimary == 'Y'">
                <entity-find entity-name="zenith.erp.barcode.ProductBarcode" list="_rest" limit="1">
                    <econdition field-name="productId" from="bc.productId"/>
                    <econdition field-name="isActive" value="Y"/>
                </entity-find>
                <if condition="_rest">
                    <service-call name="update#zenith.erp.barcode.ProductBarcode" in-map="[barcodeId:_rest[0].barcodeId, isPrimary:'Y']"/>
                </if>
            </if>
        </actions>
    </service>

</services>
