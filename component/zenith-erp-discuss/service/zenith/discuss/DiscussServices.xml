<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Channel Services ========== -->

    <service verb="create" noun="Channel">
        <description>Create a new discussion channel. Sets creator from current user's party.</description>
        <in-parameters>
            <parameter name="channelName" required="true"/>
            <parameter name="description"/>
            <parameter name="isPrivate" default-value="N"/>
        </in-parameters>
        <out-parameters>
            <parameter name="channelId"/>
        </out-parameters>
        <actions>
            <!-- Resolve current user's partyId -->
            <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                <field-map field-name="userId" from="ec.user.userId"/>
            </entity-find-one>
            <set field="creatorPartyId" from="userAccount?.partyId"/>
            <set field="createdDate" from="ec.user.nowTimestamp"/>

            <service-call name="create#zenith.erp.discuss.DiscussChannel" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="update" noun="Channel">
        <description>Update an existing discussion channel's details.</description>
        <in-parameters>
            <parameter name="channelId" required="true"/>
            <parameter name="channelName"/>
            <parameter name="description"/>
            <parameter name="isPrivate"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.discuss.DiscussChannel" in-map="context"/>
        </actions>
    </service>

    <!-- ========== Message Services ========== -->

    <service verb="post" noun="Message">
        <description>Post a message to a discussion channel. Sender defaults to current user's party.</description>
        <in-parameters>
            <parameter name="channelId" required="true"/>
            <parameter name="messageBody" required="true"/>
            <parameter name="senderPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="messageId"/>
        </out-parameters>
        <actions>
            <!-- If senderPartyId not provided, resolve from current user -->
            <if condition="!senderPartyId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                    <field-map field-name="userId" from="ec.user.userId"/>
                </entity-find-one>
                <set field="senderPartyId" from="userAccount?.partyId"/>
            </if>
            <set field="sentDate" from="ec.user.nowTimestamp"/>

            <service-call name="create#zenith.erp.discuss.DiscussMessage" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="delete" noun="Message">
        <description>Delete a message from a discussion channel.</description>
        <in-parameters>
            <parameter name="messageId" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="delete#zenith.erp.discuss.DiscussMessage" in-map="[messageId: messageId]"/>
        </actions>
    </service>

</services>
