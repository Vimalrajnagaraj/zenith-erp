<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="DiscussChannel" package="zenith.erp.discuss">
        <field name="channelId" type="id" is-pk="true"/>
        <field name="channelName" type="text-short"/>
        <field name="description" type="text-medium"/>
        <field name="creatorPartyId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="isPrivate" type="text-indicator"/>
        <relationship type="one" title="Creator" related="mantle.party.Party">
            <key-map field-name="creatorPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="DiscussMessage" package="zenith.erp.discuss">
        <field name="messageId" type="id" is-pk="true"/>
        <field name="channelId" type="id"/>
        <field name="senderPartyId" type="id"/>
        <field name="messageBody" type="text-long"/>
        <field name="sentDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.discuss.DiscussChannel"/>
        <relationship type="one" title="Sender" related="mantle.party.Party">
            <key-map field-name="senderPartyId" related="partyId"/></relationship>
    </entity>

</entities>
