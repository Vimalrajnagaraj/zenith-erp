<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Chat" default-menu-index="2">

    <parameter name="channelId"/>

    <transition name="postMessage">
        <service-call name="create#zenith.erp.discuss.DiscussMessage" in-map="context + [sentDate: ec.user.nowTimestamp]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Fetch current channel info -->
        <entity-find-one entity-name="zenith.erp.discuss.DiscussChannel" value-field="currentChannel">
            <field-map field-name="channelId" from="channelId"/>
        </entity-find-one>

        <!-- Fetch message history for this channel -->
        <entity-find entity-name="zenith.erp.discuss.DiscussMessage" list="messageList">
            <search-form-inputs default-order-by="sentDate"/>
            <econdition field-name="channelId" from="channelId" ignore-if-empty="true"/>
        </entity-find>

        <!-- Provide list of users for sender dropdown -->
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="firstName"/>
        </entity-find>
        
        <!-- List of channels for quick switching -->
        <entity-find entity-name="zenith.erp.discuss.DiscussChannel" list="channelList">
            <order-by field-name="channelName"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Chat Interface layout -->
        <container-row>
            <row-col md="3">
                <container-box><box-header title="Channels"/><box-body>
                    <form-list name="SidebarChannels" list="channelList" skip-form="true">
                        <field name="channelName">
                            <default-field>
                                <link url="." text="${channelName}" parameter-map="[channelId:channelId]"/>
                            </default-field>
                        </field>
                    </form-list>
                </box-body></container-box>
            </row-col>

            <row-col md="9">
                <container-box><box-header title="Chat: ${currentChannel ? currentChannel.channelName : 'Select a channel'}"/><box-body>
                    
                    <!-- Display Messages (HTTP Refresh based) -->
                    <form-list name="ChatHistoryForm" list="messageList" skip-form="true" show-page-size="true">
                        <field name="senderPartyId">
                            <default-field title="User"><display-entity entity-name="mantle.party.Person" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/></default-field>
                        </field>
                        <field name="messageBody">
                            <default-field title="Message"><display/></default-field>
                        </field>
                        <field name="sentDate">
                            <default-field title="Time"><display format="yyyy-MM-dd HH:mm:ss"/></default-field>
                        </field>
                    </form-list>

                    <!-- Compose Message Form -->
                    <container style="margin-top: 20px; padding-top: 10px; border-top: 1px solid #ccc;">
                        <form-single name="ComposeMessageForm" transition="postMessage">
                            <field name="channelId"><default-field><hidden/></default-field></field>
                            <!-- In a production system, sender is automatically the logged in user via context. 
                                 For this demo, we allow selecting the sender to simulate different users chatting. -->
                            <field name="senderPartyId"><default-field title="Posting As">
                                <drop-down>
                                    <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="messageBody"><default-field title="Message"><text-area rows="2" cols="80"/></default-field></field>
                            <field name="submitButton"><default-field title="Send Message"><submit/></default-field></field>
                        </form-single>
                    </container>
                    
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
