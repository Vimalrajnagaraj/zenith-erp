<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Channels" default-menu-index="1">

    <transition name="createChannel">
        <service-call name="create#zenith.erp.discuss.DiscussChannel"
                      in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.discuss.DiscussChannel" list="channelList">
            <search-form-inputs default-order-by="-createdDate"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Chat Channels"/><box-toolbar>
            <container-dialog id="NewChannelDialog" button-text="Create Channel">
                <form-single name="NewChannelForm" transition="createChannel">
                    <field name="channelName"><default-field title="Channel Name (e.g. #sales)"><text-line size="20"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="50"/></default-field></field>
                    <field name="creatorPartyId"><default-field title="Creator">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="isPrivate"><default-field title="Private Room?"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                    <field name="createdDate"><default-field title="Created Date"><date-time/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="ChannelListForm" list="channelList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="channelId"><default-field><hidden/></default-field></field>
                <field name="channelName">
                    <header-field title="Channel Name" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="description">
                    <header-field title="Topic"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="creatorPartyId">
                    <header-field title="Creator">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="mantle.party.Person" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/></default-field>
                </field>
                <field name="isPrivate">
                    <header-field title="Private?"><drop-down allow-empty="true"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="joinButton">
                    <!-- Standard HTTP link to the Chat screen, passing the channel ID -->
                    <default-field title="Action">
                        <link url="../Chat" text="Join Chat" parameter-map="[channelId:channelId]"/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
