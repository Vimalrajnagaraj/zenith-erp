<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <!-- Define an ArtifactGroup for all Zenith screens -->
    <moqui.security.ArtifactGroup artifactGroupId="ZENITH_SCREENS" description="ZetaERP Screens"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="ZENITH_SCREENS"
            artifactName="component://zenith-erp-app/screen/zenith/ZenithApp.xml"
            artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>

    <!-- Grant access to all logged in users -->
    <moqui.security.ArtifactAuthz artifactAuthzId="ZENITH_SCREENS_USERS"
            userGroupId="ALL_USERS" artifactGroupId="ZENITH_SCREENS"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
