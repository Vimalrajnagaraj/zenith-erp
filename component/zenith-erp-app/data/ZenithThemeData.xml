<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <!-- Inject Zenith CSS into the DEFAULT theme -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT" sequenceNum="50" resourceTypeEnumId="STRT_STYLESHEET" resourceValue="/zenithstatic/css/zenith-theme-v4.css"/>

    <!-- Inject Zenith CSS into the DEFAULT_QUASAR theme -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="50" resourceTypeEnumId="STRT_STYLESHEET" resourceValue="/zenithstatic/css/zenith-theme-v4.css"/>

    <!-- Override Moqui logo with ZetaERP logo -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT" sequenceNum="100" resourceTypeEnumId="STRT_HEADER_LOGO"
            resourceValue="/zenithstatic/img/zetaerp-logo.svg"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="100" resourceTypeEnumId="STRT_HEADER_LOGO"
            resourceValue="/zenithstatic/img/zetaerp-logo.svg"/>

    <!-- Set Browser Tab Favicon to ZetaERP logo -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT" sequenceNum="100" resourceTypeEnumId="STRT_SHORTCUT_ICON"
            resourceValue="/zenithstatic/img/zetaerp-logo.svg"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="100" resourceTypeEnumId="STRT_SHORTCUT_ICON"
            resourceValue="/zenithstatic/img/zetaerp-logo.svg"/>

    <!-- Remove "Built on Moqui" footer, replace with ZetaERP branding -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="200" resourceTypeEnumId="STRT_FOOTER_ITEM">
        <resourceValue><![CDATA[<div class="col text-center q-px-md"><span class="text-grey-5">© 2024-2026 ZetaERP · Cloud ERP Platform</span></div>]]></resourceValue>
    </moqui.screen.ScreenThemeResource>

    <!-- ZE-AUTH-001: "My Password" self-service link in the account area of BOTH shells.
         /qapps (Quasar) — a plugin in the top-right account dropdown, next to Logout. -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="140" resourceTypeEnumId="STRT_HEADER_ACCOUNT_COMP"
            resourceValue="/zenithstatic/lib/MyPasswordNav.qvue"/>
    <!-- /apps (Bootstrap) — a navbar button (there is no account dropdown, just top-right nav buttons). -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT" sequenceNum="125" resourceTypeEnumId="STRT_HEADER_NAVBAR_ITEM">
        <resourceValue><![CDATA[<#if ec.user.userId?has_content><a href="/apps/zenith/MyPassword" data-toggle="tooltip" data-container="body" data-original-title="My Password" data-placement="bottom" class="btn btn-default btn-sm navbar-btn navbar-right"><i class="fa fa-lock"></i></a></#if>]]></resourceValue>
    </moqui.screen.ScreenThemeResource>
</entity-facade-xml>
