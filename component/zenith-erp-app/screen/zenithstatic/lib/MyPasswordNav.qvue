<!-- ZE-AUTH-001: adds a "My Password" link to the /qapps (Quasar) top-right account dropdown, next to
     Logout, so any signed-in user can jump straight to the self-service sign-in-password screen. Registered
     as a STRT_HEADER_ACCOUNT_COMP account plugin (see ZenithThemeData.xml); the /apps shell gets the
     equivalent via a STRT_HEADER_NAVBAR_ITEM button. -->
<template>
    <q-btn flat dense no-caps align="left" class="full-width q-my-xs" icon="lock" label="My Password"
           type="a" href="/qapps/zenith/MyPassword">
        <q-tooltip>Set or change your sign-in password</q-tooltip>
    </q-btn>
</template>
<script>
module.exports = { name: "MyPasswordNav" };
</script>
