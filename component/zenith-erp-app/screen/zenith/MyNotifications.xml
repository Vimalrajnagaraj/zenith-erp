<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Notifications" default-menu-index="97">

    <!-- ZE-DASH-0402 follow-up: self-service, per-user, per-device browser-notification manager. Replaces the
         removed on-every-load nag (notif-nag-fix.js) with a CONTEXTUAL opt-in. Pure client-side: browser
         permission lives in the browser, so there is no server state. The Enable button fires the REAL
         Notification.requestPermission from a genuine user gesture via moqui._realNotifRequest.
         Renders on all three surfaces (html=/apps, vuet=/vapps, qvt=/qapps). /qapps strips <script>/<style>,
         so the logic rides an <img onload> native attribute (no double-quotes allowed inside it) and every
         state is a display-toggled HTML block — the JS only toggles visibility and wires clicks. -->
    <widgets>
        <render-mode><text type="html,vuet,qvt" template="true"><![CDATA[
<div style="max-width:760px;margin:0 auto;padding:10px 6px">
  <div style="background:#fff;border:1px solid #E4DFF3;border-radius:16px;box-shadow:0 2px 12px rgba(70,61,122,.06);padding:24px 26px">
    <div style="display:flex;align-items:center;gap:13px;margin-bottom:4px">
      <span class="material-icons" style="font-size:30px;color:#6E56CF">notifications_active</span>
      <div>
        <div style="font-size:19px;font-weight:800;color:#2A2340;line-height:1.2">Browser Notifications</div>
        <div style="font-size:13px;color:#7A7391;margin-top:2px">Desktop alerts from ZetaERP on this device &middot; this setting is per browser &amp; device.</div>
      </div>
    </div>

    <!-- OFF (permission = default) -->
    <div id="znotif-off" style="display:none;margin-top:18px">
      <span style="background:#EEF0F5;color:#64748B;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:800">Off</span>
      <div style="font-size:13.5px;color:#4A4260;margin:11px 0 15px">Turn on desktop alerts so ZetaERP can notify you on this device. You&#39;ll be asked once by your browser &mdash; you can change your mind anytime.</div>
      <button id="znotif-enable" type="button" style="padding:10px 20px;border:none;border-radius:10px;background:#6E56CF;color:#fff;font-size:14px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:7px">
        <span class="material-icons" style="font-size:18px">notifications_active</span>Enable notifications</button>
    </div>

    <!-- ON (permission = granted) -->
    <div id="znotif-on" style="display:none;margin-top:18px">
      <span style="background:#DCFCE7;color:#166534;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:800">On</span>
      <div style="font-size:13.5px;color:#4A4260;margin:11px 0 0">Desktop alerts are enabled on this device.
        <button id="znotif-test" type="button" style="padding:7px 15px;border:1px solid #E4DFF3;border-radius:9px;background:#F4F0FC;color:#463D7A;font-size:13px;font-weight:700;cursor:pointer;margin-left:8px;vertical-align:middle">Send a test</button></div>
      <div style="font-size:12px;color:#9C93B4;margin-top:9px">To turn them off, use your browser&#39;s site settings for this page.</div>
    </div>

    <!-- BLOCKED (permission = denied) -->
    <div id="znotif-denied" style="display:none;margin-top:18px">
      <span style="background:#FEE2E2;color:#991B1B;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:800">Blocked</span>
      <div style="font-size:13.5px;color:#4A4260;margin:11px 0 10px">Your browser is blocking notifications for ZetaERP. To turn them back on:</div>
      <div style="font-size:13px;color:#6A6285;background:#F8F5FE;border:1px solid #E4DFF3;border-radius:10px;padding:11px 13px">
        <span id="znotif-how-safari" style="display:none">In Safari: menu bar &rarr; <b>Settings</b> &rarr; <b>Websites</b> &rarr; <b>Notifications</b>, then set <b>erp.zetaclantech.com</b> to <b>Allow</b>. Reload this page after.</span>
        <span id="znotif-how-chrome" style="display:none">Click the <b>padlock / tune</b> icon at the left of the address bar &rarr; <b>Site settings</b> &rarr; <b>Notifications</b> &rarr; <b>Allow</b>. Reload this page after.</span>
        <span id="znotif-how-firefox" style="display:none">Click the <b>padlock</b> in the address bar &rarr; clear the <b>Notifications</b> block, then reload this page and click <b>Enable</b> again.</span>
        <span id="znotif-how-other" style="display:none">Open your browser&#39;s <b>site settings</b> for this page and set <b>Notifications</b> to <b>Allow</b>, then reload.</span>
      </div>
      <button id="znotif-retry" type="button" style="margin-top:12px;padding:9px 17px;border:1px solid #E4DFF3;border-radius:9px;background:#F4F0FC;color:#463D7A;font-size:13px;font-weight:700;cursor:pointer">I&#39;ve allowed it &mdash; re-check</button>
    </div>

    <!-- UNSUPPORTED -->
    <div id="znotif-unsupported" style="display:none;margin-top:18px">
      <span style="background:#EEF0F5;color:#64748B;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:800">Not supported</span>
      <div style="font-size:13.5px;color:#4A4260;margin-top:11px">This browser doesn&#39;t support desktop notifications.</div>
    </div>

    <div style="margin-top:20px;padding-top:14px;border-top:1px solid #EFEAF8;font-size:12px;color:#9C93B4;line-height:1.5">
      Notifications appear while ZetaERP is open in a browser tab on this device. Granting permission here only allows the browser to show them &mdash; it doesn&#39;t share anything with anyone.
    </div>
  </div>
</div>
<img alt="" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" onload="(function(){
  function g(id){return document.getElementById(id);}
  function show(id){var a=['znotif-off','znotif-on','znotif-denied','znotif-unsupported'];for(var i=0;i<a.length;i++){var e=g(a[i]);if(e)e.style.display=(a[i]===id)?'block':'none';}}
  function test(){try{var n=new Notification('ZetaERP',{body:'Notifications are working on this device.'});setTimeout(function(){try{n.close();}catch(e){}},5000);}catch(e){}}
  function render(){
    if(!('Notification' in window)){show('znotif-unsupported');return;}
    var p=window.Notification.permission;
    if(p==='granted'){show('znotif-on');return;}
    if(p==='denied'){show('znotif-denied');
      var u=navigator.userAgent||'';var b='other';
      if(/Firefox\//.test(u))b='firefox';else if(/Edg\//.test(u))b='chrome';else if(/Chrome\//.test(u))b='chrome';else if(/Safari\//.test(u))b='safari';
      var hs=['safari','chrome','firefox','other'];for(var i=0;i<hs.length;i++){var e=g('znotif-how-'+hs[i]);if(e)e.style.display=(hs[i]===b)?'inline':'none';}
      return;}
    show('znotif-off');
  }
  function enable(){
    var req=(window.moqui&&window.moqui._realNotifRequest)||(('Notification' in window)?window.Notification.requestPermission:null);
    if(!req){render();return;}
    function done(perm){render();if(perm==='granted')test();}
    try{var r=req.call(window.Notification,done);if(r&&r.then)r.then(done);}catch(e){render();}
  }
  var be=g('znotif-enable');if(be)be.onclick=enable;
  var bt=g('znotif-test');if(bt)bt.onclick=test;
  var br=g('znotif-retry');if(br)br.onclick=render;
  render();
})()"/>
        ]]></text></render-mode>
    </widgets>
</screen>
