<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Access Control">

    <transition name="createRule">
        <service-call name="create#zenith.erp.base.UserAccessControl"/>
        <default-response url="."/>
    </transition>
    <transition name="updateRule">
        <service-call name="update#zenith.erp.base.UserAccessControl"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.UserAccessControl" list="rules">
            <order-by field-name="userId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="User Access Control (IP/Device)" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateRule" button-text="New Rule" type="success">
                <form-single name="CreateForm" transition="createRule">
                    <field name="userId"><default-field title="User ID"><text-line size="15"/></default-field></field>
                    <field name="accessTypeEnumId"><default-field title="Type">
                        <drop-down>
                            <option key="UacBlacklist" text="Blacklist"/>
                            <option key="UacWhitelist" text="Whitelist"/>
                        </drop-down></default-field></field>
                    <field name="ipAddress"><default-field title="IP Address"><text-line size="15"/></default-field></field>
                    <field name="deviceIdentifier"><default-field title="Device ID"><text-line size="20"/></default-field></field>
                    <field name="isActive" from="'Y'"><default-field><hidden/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="RulesForm" list="rules" transition="updateRule">
                <field name="userAccessControlId"><default-field><hidden/></default-field></field>
                <field name="userId"><default-field title="User"><display/></default-field></field>
                <field name="accessTypeEnumId"><default-field title="Type">
                    <drop-down>
                        <option key="UacBlacklist" text="Blacklist"/>
                        <option key="UacWhitelist" text="Whitelist"/>
                    </drop-down></default-field></field>
                <field name="ipAddress"><default-field title="IP"><text-line size="12"/></default-field></field>
                <field name="deviceIdentifier"><default-field title="Device"><text-line size="15"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
