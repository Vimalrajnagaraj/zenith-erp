<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Companies">

    <transition name="companySetup"><default-response url="../CompanySetup"/></transition>
    <transition name="createCompany">
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')"><return error="true" message="Only the platform administrator can create companies"/></if>
            <service-call name="zenith.base.CompanyServices.create#Company"/>
        </actions>
        <default-response url="../CompanySetup"/>
    </transition>

    <actions>
        <!-- Org isolation: a tenant admin sees only their own company; platform admin sees all. -->
        <set field="_orgScope" from="ec.user.isInGroup('ADMIN') ? null : ((ec.user.getPreference('ACTIVE_ORGANIZATION') &amp;&amp; ec.user.getPreference('ACTIVE_ORGANIZATION') != '_NA_') ? ec.user.getPreference('ACTIVE_ORGANIZATION') : '__NONE__')"/>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="companyList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <econdition field-name="partyId" from="_orgScope" ignore-if-empty="true"/>
            <order-by field-name="organizationName"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="Company Management" type="h4"/>
        <label text="Manage your organizations. Each company has its own GSTIN, chart of accounts, and document sequences." type="p"/>

        <form-list name="CompanyListForm" list="companyList" skip-form="true">
            <field name="partyId"><default-field title="ID">
                <link url="companySetup" text="${partyId}" link-type="anchor"/>
            </default-field></field>
            <field name="organizationName"><default-field title="Company Name">
                <link url="companySetup" text="${organizationName}" link-type="anchor"/>
            </default-field></field>
            <field name="pseudoId"><default-field title="Code"><display/></default-field></field>
        </form-list>

        <container-box>
            <box-header title="Create New Company"/>
            <box-body>
                <form-single name="CreateCompanyForm" transition="createCompany">
                    <field name="organizationName"><default-field title="Company Name">
                        <text-line size="40"/></default-field></field>
                    <field name="orgCode"><default-field title="Organization Code"
                            tooltip="Unique code used for login (e.g. ACME, TATA001)">
                        <text-line size="20" maxlength="20"/></default-field></field>
                    <field name="countryGeoId"><default-field title="Country">
                        <drop-down>
                            <entity-options key="${countryGeoId}" text="${countryName}">
                                <entity-find entity-name="zenith.erp.base.CountryConfiguration">
                                    <order-by field-name="countryName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="taxRegistrationNumber"><default-field title="Tax Registration No."
                            tooltip="GSTIN (India), EIN (US), VAT Reg (UK/UAE)">
                        <text-line size="20" maxlength="20"/></default-field></field>
                    <field name="panNumber"><default-field title="PAN">
                        <text-line size="15" maxlength="10"/></default-field></field>
                    <field name="address1"><default-field title="Address">
                        <text-line size="50"/></default-field></field>
                    <field name="city"><default-field title="City">
                        <text-line size="30"/></default-field></field>
                    <field name="postalCode"><default-field title="Postal Code">
                        <text-line size="10" maxlength="10"/></default-field></field>
                    <field name="emailAddress"><default-field title="Email">
                        <text-line size="30"/></default-field></field>
                    <field name="phoneNumber"><default-field title="Phone">
                        <text-line size="15"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create Company">
                        <submit/></default-field></field>
                </form-single>
            </box-body>
        </container-box>
    </widgets>
</screen>
