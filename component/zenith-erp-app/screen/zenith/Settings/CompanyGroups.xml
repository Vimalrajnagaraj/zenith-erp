<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Company Groups">

    <transition name="createGroup">
        <service-call name="zenith.base.NotificationServices.create#CompanyGroup"/>
        <default-response url="."/>
    </transition>
    <transition name="addMember">
        <service-call name="zenith.base.NotificationServices.add#CompanyGroupMember"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.CompanyGroup" list="groups">
            <order-by field-name="groupName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.base.CompanyGroupMember" list="members">
            <order-by field-name="companyGroupId,fromDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Company Groups" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateGroup" button-text="New Group" type="success">
                <form-single name="CreateForm" transition="createGroup">
                    <field name="groupName"><default-field title="Group Name"><text-line size="20"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="30"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="GroupsForm" list="groups" skip-form="true">
                <field name="companyGroupId"><default-field title="ID"><display/></default-field></field>
                <field name="groupName"><default-field title="Name"><display/></default-field></field>
                <field name="description"><default-field><display/></default-field></field>
            </form-list>
        </container>

        <container style="row items-center justify-between q-mb-md">
            <label text="Group Members" type="h5" style="text-weight-bold q-my-none"/>
            <container-dialog id="AddMember" button-text="Add Member" type="info">
                <form-single name="AddMemberForm" transition="addMember">
                    <field name="companyGroupId"><default-field title="Group">
                        <drop-down><entity-options key="${companyGroupId}" text="${groupName}">
                            <entity-find entity-name="zenith.erp.base.CompanyGroup"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="partyId"><default-field title="Company">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="roleEnumId"><default-field title="Role">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="GroupMemberRole"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="MembersForm" list="members" skip-form="true">
                <field name="companyGroupId"><default-field title="Group">
                    <display-entity entity-name="zenith.erp.base.CompanyGroup" key-field-name="companyGroupId" text="${groupName}"/>
                </default-field></field>
                <field name="partyId"><default-field title="Company">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="roleEnumId"><default-field title="Role">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="fromDate"><default-field><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
