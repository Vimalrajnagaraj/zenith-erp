<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="GST Configuration">

    <transition name="updateGstConfig">
        <service-call name="update#zenith.erp.india.IndiaGstConfig"/>
        <default-response url="."/>
    </transition>
    <transition name="testGstCalc">
        <service-call name="zenith.india.GstServices.calculate#Gst" out-map="calcResult"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>

        <entity-find entity-name="zenith.erp.india.IndiaGstConfig" list="gstConfigs">
            <order-by field-name="organizationPartyId"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.IndiaGstSlab" list="gstSlabs">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="gstRate"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateCode"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="GST Configuration" type="h4"/>

        <container-box>
            <box-header title="Registered GSTINs"/>
            <box-body>
                <form-list name="GstConfigList" list="gstConfigs" skip-form="true">
                    <field name="organizationPartyId"><default-field title="Organization"><display/></default-field></field>
                    <field name="gstin"><default-field title="GSTIN"><display/></default-field></field>
                    <field name="legalName"><default-field title="Legal Name"><display/></default-field></field>
                    <field name="stateCode"><default-field title="State"><display/></default-field></field>
                    <field name="registrationType"><default-field title="Type"><display/></default-field></field>
                    <field name="isCompositionScheme"><default-field title="Composition">
                        <display text="${isCompositionScheme == 'Y' ? 'Yes' : 'No'}"/></default-field></field>
                    <field name="einvoiceEnabled"><default-field title="E-Invoice">
                        <display text="${einvoiceEnabled == 'Y' ? 'Enabled' : 'Disabled'}"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="GST Slabs"/>
            <box-body>
                <form-list name="GstSlabList" list="gstSlabs" skip-form="true">
                    <field name="gstSlabId"><default-field title="Slab ID"><display/></default-field></field>
                    <field name="slabName"><default-field title="Name"><display/></default-field></field>
                    <field name="gstRate"><default-field title="GST Rate %"><display format="0.##"/></default-field></field>
                    <field name="cgstRate"><default-field title="CGST %"><display format="0.##"/></default-field></field>
                    <field name="sgstRate"><default-field title="SGST %"><display format="0.##"/></default-field></field>
                    <field name="igstRate"><default-field title="IGST %"><display format="0.##"/></default-field></field>
                    <field name="cessRate"><default-field title="Cess %"><display format="0.##"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="GST Calculator (Test)"/>
            <box-body>
                <form-single name="GstCalcForm" transition="testGstCalc">
                    <field name="supplierStateCode"><default-field title="Supplier State">
                        <drop-down>
                            <entity-options key="${stateCode}" text="${stateCode} - ${stateName}">
                                <entity-find entity-name="zenith.erp.india.IndiaState"><order-by field-name="stateCode"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="buyerStateCode"><default-field title="Buyer State">
                        <drop-down>
                            <entity-options key="${stateCode}" text="${stateCode} - ${stateName}">
                                <entity-find entity-name="zenith.erp.india.IndiaState"><order-by field-name="stateCode"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="gstSlabId"><default-field title="GST Slab">
                        <drop-down>
                            <entity-options key="${gstSlabId}" text="${slabName} (${gstRate}%)">
                                <entity-find entity-name="zenith.erp.india.IndiaGstSlab">
                                    <econdition field-name="isActive" value="Y"/>
                                    <order-by field-name="gstRate"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="taxableAmount"><default-field title="Taxable Amount (${currSymbol})">
                        <text-line size="15" default-value="10000"/></default-field></field>
                    <field name="submitBtn"><default-field title="Calculate GST"><submit/></default-field></field>
                </form-single>

                <section name="CalcResultSection" condition="calcResult">
                    <widgets>
                        <label text="GST Calculation Result" type="h5"/>
                        <container style="table-responsive">
                            <form-single name="CalcResultForm" map="calcResult">
                                <field name="supplyType"><default-field title="Supply Type"><display/></default-field></field>
                                <field name="cgstRate"><default-field title="CGST Rate"><display format="0.##%"/></default-field></field>
                                <field name="cgstAmount"><default-field title="CGST Amount"><display format="#,##0.00"/></default-field></field>
                                <field name="sgstRate"><default-field title="SGST Rate"><display format="0.##%"/></default-field></field>
                                <field name="sgstAmount"><default-field title="SGST Amount"><display format="#,##0.00"/></default-field></field>
                                <field name="igstRate"><default-field title="IGST Rate"><display format="0.##%"/></default-field></field>
                                <field name="igstAmount"><default-field title="IGST Amount"><display format="#,##0.00"/></default-field></field>
                                <field name="cessAmount"><default-field title="Cess Amount"><display format="#,##0.00"/></default-field></field>
                                <field name="totalTaxAmount"><default-field title="Total Tax"><display format="#,##0.00"/></default-field></field>
                                <field name="totalAmount"><default-field title="Total Amount"><display format="#,##0.00"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>
            </box-body>
        </container-box>
    </widgets>
</screen>
