<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Backups">

    <transition name="createSchedule">
        <service-call name="create#zenith.erp.base.BackupSchedule"/>
        <default-response url="."/>
    </transition>
    <transition name="updateSchedule">
        <service-call name="update#zenith.erp.base.BackupSchedule"/>
        <default-response url="."/>
    </transition>
    <transition name="runBackup">
        <service-call name="zenith.base.NotificationServices.execute#Backup"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.BackupSchedule" list="schedules">
            <order-by field-name="scheduleName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.base.BackupLog" list="logs" limit="20">
            <order-by field-name="-startTime"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Backup Management" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateSchedule" button-text="New Schedule" type="success">
                <form-single name="CreateForm" transition="createSchedule">
                    <field name="scheduleName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="backupTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="BackupType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="frequencyEnumId"><default-field title="Frequency">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="BackupFrequency"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="retentionDays"><default-field><text-line size="5" default-value="30"/></default-field></field>
                    <field name="isCloudBackup"><default-field title="Cloud">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="isActive" from="'Y'"><default-field><hidden/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="SchedulesForm" list="schedules" transition="updateSchedule">
                <field name="backupScheduleId"><default-field><hidden/></default-field></field>
                <field name="scheduleName"><default-field title="Name"><display/></default-field></field>
                <field name="backupTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="frequencyEnumId"><default-field title="Frequency">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="retentionDays"><default-field title="Retain"><display/></default-field></field>
                <field name="isCloudBackup"><default-field title="Cloud"><display/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="runNow"><default-field title="">
                    <link url="runBackup" text="Run Now" parameter-map="[backupScheduleId:backupScheduleId]" btn-type="info"/>
                </default-field></field>
                <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
            </form-list>
        </container>

        <label text="Backup History" type="h5" style="text-weight-bold q-mb-md"/>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="LogsForm" list="logs" skip-form="true" show-csv-button="true">
                <field name="startTime"><default-field title="Started"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="endTime"><default-field title="Ended"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="backupTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="backupSize"><default-field title="Size"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="filePath"><default-field title="File"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
