<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Document Sequences">

    <transition name="updateSequence">
        <service-call name="update#zenith.erp.base.SystemSequence"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.SystemSequence" list="sequenceList">
            <order-by field-name="organizationPartyId,sequenceType"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="Document Sequences" type="h4"/>
        <label text="Configure numbering prefixes and formats for invoices, orders, and other documents. Financial year is automatically included (e.g., INV/26-27/00001)." type="p"/>

        <form-list name="SequenceListForm" list="sequenceList" transition="updateSequence">
            <field name="organizationPartyId"><default-field title="Organization"><display/></default-field></field>
            <field name="sequenceType"><default-field title="Document Type"><display/></default-field></field>
            <field name="prefix"><default-field title="Prefix"><text-line size="10"/></default-field></field>
            <field name="suffix"><default-field title="Suffix"><text-line size="10"/></default-field></field>
            <field name="nextValue"><default-field title="Next Number"><text-line size="8"/></default-field></field>
            <field name="padLength"><default-field title="Pad Length"><text-line size="3"/></default-field></field>
            <field name="includeFinancialYear"><default-field title="Include FY">
                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
            </default-field></field>
            <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
        </form-list>
    </widgets>
</screen>
