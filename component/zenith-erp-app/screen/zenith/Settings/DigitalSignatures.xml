<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Digital Signatures">

    <transition name="createSignature">
        <service-call name="create#zenith.erp.base.DigitalSignature"/>
        <default-response url="."/>
    </transition>
    <transition name="updateSignature">
        <service-call name="update#zenith.erp.base.DigitalSignature"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.DigitalSignature" list="signatures">
            <order-by field-name="partyId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Digital Signatures" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateSig" button-text="Add Signature" type="success">
                <form-single name="CreateForm" transition="createSignature">
                    <field name="partyId"><default-field title="Person">
                        <drop-down><entity-options key="${partyId}" text="${firstName} ${lastName}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="partyTypeEnumId" value="PtyPerson"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="signatureImageLocation"><default-field title="Signature Image Path"><text-line size="30"/></default-field></field>
                    <field name="certificateLocation"><default-field title="Certificate Path"><text-line size="30"/></default-field></field>
                    <field name="certificateExpiry"><default-field title="Certificate Expiry"><date-time type="date"/></default-field></field>
                    <field name="isDefault" from="'N'"><default-field title="Default">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="SigsForm" list="signatures" transition="updateSignature">
                <field name="digitalSignatureId"><default-field><hidden/></default-field></field>
                <field name="partyId"><default-field title="Person">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${firstName} ${lastName}"/>
                </default-field></field>
                <field name="signatureImageLocation"><default-field title="Signature"><display/></default-field></field>
                <field name="certificateExpiry"><default-field title="Cert Expiry"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="isDefault"><default-field title="Default">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
