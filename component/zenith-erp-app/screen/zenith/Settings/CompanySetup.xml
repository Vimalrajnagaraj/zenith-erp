<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Company Setup">

    <parameter name="partyId" required="true"/>

    <transition name="updateCompany">
        <service-call name="zenith.base.CompanyServices.update#Company"/>
        <default-response url="."/>
    </transition>
    <transition name="updateSettings">
        <service-call name="store#zenith.erp.base.CompanySettings"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.party.Organization" value-field="org"/>

        <entity-find-one entity-name="mantle.party.PartyIdentification" value-field="panRecord">
            <field-map field-name="partyId"/>
            <field-map field-name="partyIdTypeEnumId" value="PtidTaxId"/>
        </entity-find-one>

        <entity-find-one entity-name="mantle.party.PartyIdentification" value-field="orgCodeRecord">
            <field-map field-name="partyId"/>
            <field-map field-name="partyIdTypeEnumId" value="PtidOrgCode"/>
        </entity-find-one>

        <entity-find entity-name="zenith.erp.base.CompanySettings" list="settingsList">
            <econdition field-name="organizationPartyId" from="partyId"/>
            <order-by field-name="settingKey"/>
        </entity-find>

        <set field="countryGeoId" from="settingsList.find{it.settingKey=='COUNTRY_GEO_ID'}?.settingValue"/>
        <set field="currencyUomId" from="settingsList.find{it.settingKey=='CURRENCY_UOM_ID'}?.settingValue"/>
        <set field="tanNumber" from="settingsList.find{it.settingKey=='TAN_NUMBER'}?.settingValue"/>
        <set field="cinNumber" from="settingsList.find{it.settingKey=='CIN_NUMBER'}?.settingValue"/>
        <set field="fyStartMonth" from="settingsList.find{it.settingKey=='FY_START_MONTH'}?.settingValue ?: '4'"/>

        <if condition="countryGeoId">
            <entity-find-one entity-name="zenith.erp.base.CountryConfiguration" value-field="countryConfig">
                <field-map field-name="countryGeoId"/>
            </entity-find-one>
        </if>

        <entity-find-one entity-name="zenith.erp.india.IndiaGstConfig" value-field="gstConfig">
            <field-map field-name="organizationPartyId" from="partyId"/>
        </entity-find-one>

        <entity-find entity-name="zenith.erp.base.CompanyBranch" list="branchList">
            <econdition field-name="organizationPartyId" from="partyId"/>
            <order-by field-name="branchName"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="Company Setup: ${org?.organizationName}" type="h4"/>

        <container-row>
            <row-col lg="6" md="12">
                <container-box>
                    <box-header title="Company Details"/>
                    <box-body>
                        <form-single name="CompanyDetailsForm" transition="updateCompany" map="org">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="orgCode" from="orgCodeRecord?.idValue"><default-field title="Organization Code">
                                <display/></default-field></field>
                            <field name="organizationName"><default-field title="Company Name">
                                <text-line size="40"/></default-field></field>
                            <field name="country" from="countryConfig?.countryName ?: countryGeoId"><default-field title="Country">
                                <display/></default-field></field>
                            <field name="currency" from="currencyUomId"><default-field title="Currency">
                                <display/></default-field></field>
                            <field name="panNumber" from="panRecord?.idValue"><default-field title="PAN">
                                <text-line size="15" maxlength="10"/></default-field></field>
                            <field name="tanNumber"><default-field title="TAN">
                                <text-line size="15" maxlength="10"/></default-field></field>
                            <field name="cinNumber"><default-field title="CIN">
                                <text-line size="25" maxlength="21"/></default-field></field>
                            <field name="submitBtn"><default-field title="Update">
                                <submit/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6" md="12">
                <section name="GstConfigSection" condition="gstConfig">
                    <widgets>
                        <container-box>
                            <box-header title="GST Registration"/>
                            <box-body>
                                <form-single name="GstInfoForm" map="gstConfig">
                                    <field name="gstin"><default-field title="GSTIN"><display/></default-field></field>
                                    <field name="stateCode"><default-field title="State"><display/></default-field></field>
                                    <field name="registrationType"><default-field title="Type"><display/></default-field></field>
                                    <field name="isCompositionScheme"><default-field title="Composition">
                                        <display text="${isCompositionScheme == 'Y' ? 'Yes' : 'No'}"/></default-field></field>
                                    <field name="einvoiceEnabled"><default-field title="E-Invoice">
                                        <display text="${einvoiceEnabled == 'Y' ? 'Enabled' : 'Disabled'}"/></default-field></field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </row-col>
        </container-row>

        <container-box>
            <box-header title="Financial Settings"/>
            <box-body>
                <form-single name="FinancialSettingsForm" transition="updateSettings"
                             map="[organizationPartyId:partyId, settingKey:'FY_START_MONTH']">
                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                    <field name="settingKey"><default-field><hidden default-value="FY_START_MONTH"/></default-field></field>
                    <field name="settingValue" from="fyStartMonth"><default-field title="Financial Year Starts">
                        <drop-down>
                            <option key="1" text="January"/>
                            <option key="2" text="February"/>
                            <option key="3" text="March"/>
                            <option key="4" text="April (Indian Standard)"/>
                            <option key="7" text="July"/>
                            <option key="10" text="October"/>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field><hidden default-value="Financial Year Start Month"/></default-field></field>
                    <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Company Settings"/>
            <box-body>
                <form-list name="SettingsListForm" list="settingsList" skip-form="true">
                    <field name="settingKey"><default-field title="Setting"><display/></default-field></field>
                    <field name="settingValue"><default-field title="Value"><display/></default-field></field>
                    <field name="description"><default-field title="Description"><display/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
