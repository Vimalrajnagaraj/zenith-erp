<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Notifications">

    <transition name="createTemplate">
        <service-call name="create#zenith.erp.base.NotificationTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate">
        <service-call name="update#zenith.erp.base.NotificationTemplate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.base.NotificationTemplate" list="templates">
            <order-by field-name="channelEnumId,eventTypeEnumId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.base.NotificationLog" list="recentLogs" limit="20">
            <order-by field-name="-sentDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Notification Templates" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateTemplate" button-text="New Template" type="success">
                <form-single name="CreateForm" transition="createTemplate">
                    <field name="channelEnumId"><default-field title="Channel">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="NotificationChannel"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="eventTypeEnumId"><default-field title="Event">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="NotificationEvent"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="templateName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="messageTemplate"><default-field title="Message"><text-area rows="4" cols="40"/></default-field></field>
                    <field name="isActive" from="'Y'"><default-field><hidden/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="TemplatesForm" list="templates" transition="updateTemplate">
                <field name="notificationTemplateId"><default-field><hidden/></default-field></field>
                <field name="templateName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="channelEnumId"><default-field title="Channel">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="eventTypeEnumId"><default-field title="Event">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="messageTemplate"><default-field title="Message"><text-area rows="2" cols="30"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>

        <label text="Recent Notification Log" type="h5" style="text-weight-bold q-mb-md"/>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="LogForm" list="recentLogs" skip-form="true">
                <field name="sentDate"><default-field title="Sent"><display format="dd-MMM HH:mm"/></default-field></field>
                <field name="channelEnumId"><default-field title="Channel">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="recipientAddress"><default-field title="To"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
