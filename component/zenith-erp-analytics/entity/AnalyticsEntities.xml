<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Daily Sales Snapshot: store-level daily aggregates -->
    <entity entity-name="DailySalesSnapshot" package="zenith.erp.analytics" short-alias="DailySalesSnapshot">
        <field name="snapshotId" type="id" is-pk="true"/>
        <field name="storeId" type="id"/>
        <field name="snapshotDate" type="date"/>
        <field name="totalSales" type="currency-amount" default="0"/>
        <field name="totalReturns" type="currency-amount" default="0"/>
        <field name="netSales" type="currency-amount" default="0"/>
        <field name="totalTax" type="currency-amount" default="0"/>
        <field name="totalDiscount" type="currency-amount" default="0"/>
        <field name="transactionCount" type="number-integer" default="0"/>
        <field name="itemsSold" type="number-integer" default="0"/>
        <field name="avgBasketValue" type="currency-amount" default="0"/>
        <field name="avgItemsPerTransaction" type="number-decimal" default="0"/>
        <field name="uniqueCustomers" type="number-integer" default="0"/>
        <field name="newCustomers" type="number-integer" default="0"/>
        <field name="cashSales" type="currency-amount" default="0"/>
        <field name="cardSales" type="currency-amount" default="0"/>
        <field name="upiSales" type="currency-amount" default="0"/>
        <field name="otherSales" type="currency-amount" default="0"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
        <index name="IDX_DSS_STORE_DATE" unique="true">
            <index-field name="storeId"/><index-field name="snapshotDate"/>
        </index>
    </entity>

    <!-- Footfall Counter: hourly footfall per store -->
    <entity entity-name="FootfallCounter" package="zenith.erp.analytics" short-alias="FootfallCounter">
        <field name="footfallId" type="id" is-pk="true"/>
        <field name="storeId" type="id"/>
        <field name="counterDate" type="date"/>
        <field name="hourOfDay" type="number-integer"/>
        <field name="footfallCount" type="number-integer" default="0"/>
        <field name="conversionCount" type="number-integer" default="0"/>
        <field name="conversionRate" type="number-decimal" default="0"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
    </entity>

    <!-- Basket Analysis: product co-purchase patterns -->
    <entity entity-name="BasketAnalysis" package="zenith.erp.analytics" short-alias="BasketAnalysis">
        <field name="basketAnalysisId" type="id" is-pk="true"/>
        <field name="productId1" type="id"/>
        <field name="productId2" type="id"/>
        <field name="coOccurrenceCount" type="number-integer" default="0"/>
        <field name="supportPercent" type="number-decimal"/>
        <field name="confidencePercent" type="number-decimal"/>
        <field name="liftRatio" type="number-decimal"/>
        <field name="analysisDate" type="date"/>
        <field name="periodDays" type="number-integer"/>
        <relationship type="one" title="Product1" related="mantle.product.Product" short-alias="product1">
            <key-map field-name="productId1" related="productId"/></relationship>
        <relationship type="one" title="Product2" related="mantle.product.Product" short-alias="product2">
            <key-map field-name="productId2" related="productId"/></relationship>
    </entity>

    <!-- Sales Target: by store/region/salesperson -->
    <entity entity-name="SalesTarget" package="zenith.erp.analytics" short-alias="SalesTarget">
        <field name="salesTargetId" type="id" is-pk="true"/>
        <field name="targetTypeEnumId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="periodEnumId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="targetAmount" type="currency-amount"/>
        <field name="actualAmount" type="currency-amount" default="0"/>
        <field name="targetTransactions" type="number-integer"/>
        <field name="actualTransactions" type="number-integer" default="0"/>
        <field name="achievementPercent" type="number-decimal" default="0"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SalesTargetType" description="Sales Target Type"/>
            <moqui.basic.Enumeration enumId="SttStore" enumTypeId="SalesTargetType" description="Store" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SttSalesperson" enumTypeId="SalesTargetType" description="Salesperson" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SttRegion" enumTypeId="SalesTargetType" description="Region" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SttCategory" enumTypeId="SalesTargetType" description="Category" sequenceNum="4"/>

            <moqui.basic.EnumerationType enumTypeId="TargetPeriod" description="Target Period"/>
            <moqui.basic.Enumeration enumId="TpDaily" enumTypeId="TargetPeriod" description="Daily" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="TpWeekly" enumTypeId="TargetPeriod" description="Weekly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="TpMonthly" enumTypeId="TargetPeriod" description="Monthly" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="TpQuarterly" enumTypeId="TargetPeriod" description="Quarterly" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="TpYearly" enumTypeId="TargetPeriod" description="Yearly" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- Product Performance: periodic sales metrics per product -->
    <entity entity-name="ProductPerformance" package="zenith.erp.analytics" short-alias="ProductPerformance">
        <field name="performanceId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="quantitySold" type="number-decimal" default="0"/>
        <field name="revenue" type="currency-amount" default="0"/>
        <field name="costOfGoods" type="currency-amount" default="0"/>
        <field name="grossMargin" type="currency-amount" default="0"/>
        <field name="grossMarginPercent" type="number-decimal" default="0"/>
        <field name="sellThroughRate" type="number-decimal" default="0"/>
        <field name="stockTurnover" type="number-decimal" default="0"/>
        <field name="daysOfSupply" type="number-decimal" default="0"/>
        <field name="gmroi" type="number-decimal" default="0"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" related="zenith.erp.stores.Store" short-alias="store"/>
    </entity>

    <!-- KPI Dashboard Configuration -->
    <entity entity-name="KpiWidget" package="zenith.erp.analytics" short-alias="KpiWidget">
        <field name="kpiWidgetId" type="id" is-pk="true"/>
        <field name="widgetName" type="text-medium"/>
        <field name="kpiTypeEnumId" type="id"/>
        <field name="displayOrder" type="number-integer"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="thresholdGreen" type="number-decimal"/>
        <field name="thresholdYellow" type="number-decimal"/>
        <field name="thresholdRed" type="number-decimal"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="KpiType" description="KPI Type"/>
            <moqui.basic.Enumeration enumId="KtSalesPerSqFt" enumTypeId="KpiType" description="Sales per Sq Ft" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="KtConversionRate" enumTypeId="KpiType" description="Conversion Rate" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="KtAvgTransaction" enumTypeId="KpiType" description="Avg Transaction Value" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="KtItemsPerTxn" enumTypeId="KpiType" description="Items per Transaction" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="KtSellThrough" enumTypeId="KpiType" description="Sell-Through Rate" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="KtGmroi" enumTypeId="KpiType" description="GMROI" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="KtShrinkage" enumTypeId="KpiType" description="Shrinkage Rate" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="KtStockTurnover" enumTypeId="KpiType" description="Stock Turnover" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="KtCustomerRetention" enumTypeId="KpiType" description="Customer Retention" sequenceNum="9"/>
        </seed-data>
    </entity>
    <!-- ========== Embedded Business Intelligence (Drag-and-Drop) ========== -->
    <entity entity-name="CustomBiReport" package="zenith.erp.analytics">
        <field name="reportId" type="id" is-pk="true"/>
        <field name="tenantId" type="id"/> <!-- Enforce Tenant Isolation -->
        <field name="reportName" type="text-medium"/>
        <field name="dataSource" type="text-medium"/> <!-- e.g. 'SalesInvoice', 'InventoryLevels' -->
        <field name="selectedRows" type="text-long"/> <!-- JSON array of fields -->
        <field name="selectedColumns" type="text-long"/> <!-- JSON array of fields -->
        <field name="selectedMeasures" type="text-long"/> <!-- JSON array of aggregation fields -->
        <field name="chartType" type="text-short"/> <!-- e.g. 'pivot', 'bar', 'pie' -->
        <field name="createdByEmployeeId" type="id"/>
        <relationship type="one" related="zenith.erp.hr.Employee">
            <key-map field-name="createdByEmployeeId" related="employeeId"/>
        </relationship>
    </entity>

    <!-- ========== Role-Based KPI Dashboards ========== -->
    <entity entity-name="RoleDashboardConfig" package="zenith.erp.analytics">
        <field name="configId" type="id" is-pk="true"/>
        <field name="tenantId" type="id"/>
        <field name="roleTypeId" type="id"/> <!-- e.g., 'CEO', 'WAREHOUSE_MGR' -->
        <field name="dashboardScreenPath" type="text-long"/> <!-- e.g. 'zenith.analytics.RoleDashboards.CeoDashboard' -->
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.RoleType"/>
    </entity>

</entities>
