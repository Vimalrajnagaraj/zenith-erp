<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Products" default-menu-index="4">

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Store -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.stores.Store" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="storeId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.storeId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.analytics.ProductPerformance" list="products">
            <search-form-inputs default-order-by="-revenue"/>
            <econdition field-name="storeId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Product Performance" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ProductsForm" list="products" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="productId"><default-field title="Product">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="storeId"><header-field>
                    <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                        <entity-find entity-name="zenith.erp.stores.Store"/>
                    </entity-options></drop-down></header-field>
                    <default-field title="Store">
                        <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                    </default-field></field>
                <field name="periodStart"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="quantitySold"><header-field show-order-by="true"/>
                    <default-field title="Qty Sold"><display/></default-field></field>
                <field name="revenue"><header-field show-order-by="true"/>
                    <default-field><display format="#,##0.00"/></default-field></field>
                <field name="grossMarginPercent"><default-field title="Margin %"><display format="#0.0"/></default-field></field>
                <field name="sellThroughRate"><default-field title="Sell-Through"><display format="#0.0%"/></default-field></field>
                <field name="stockTurnover"><default-field title="Turnover"><display format="#0.0"/></default-field></field>
                <field name="gmroi"><header-field show-order-by="true"/>
                    <default-field title="GMROI"><display format="#0.00"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
