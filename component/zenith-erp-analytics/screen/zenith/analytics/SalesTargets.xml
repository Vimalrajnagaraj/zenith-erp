<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Targets" default-menu-index="3">

    <transition name="createTarget">
        <service-call name="zenith.analytics.AnalyticsServices.set#SalesTarget"/>
        <default-response url="."/>
    </transition>
    <transition name="updateActuals">
        <service-call name="zenith.analytics.AnalyticsServices.update#TargetActuals"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.analytics.SalesTarget" list="targets">
            <search-form-inputs default-order-by="-periodStart"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Sales Targets" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="NewTarget" button-text="Set Target" type="success">
                <form-single name="NewTargetForm" transition="createTarget">
                    <field name="targetTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="SalesTargetType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="storeId"><default-field title="Store">
                        <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="periodEnumId"><default-field title="Period">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="TargetPeriod"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="periodStart"><default-field><date-time type="date"/></default-field></field>
                    <field name="periodEnd"><default-field><date-time type="date"/></default-field></field>
                    <field name="targetAmount"><default-field><text-line size="12"/></default-field></field>
                    <field name="targetTransactions"><default-field title="Target Txns"><text-line size="8"/></default-field></field>
                    <field name="submitBtn"><default-field title="Set"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="TargetsForm" list="targets" transition="updateActuals">
                <field name="salesTargetId"><default-field><hidden/></default-field></field>
                <field name="targetTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="storeId"><default-field title="Store">
                    <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                </default-field></field>
                <field name="periodEnumId"><default-field title="Period">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="periodStart"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="periodEnd"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="targetAmount"><default-field title="Target"><display format="#,##0"/></default-field></field>
                <field name="actualAmount"><default-field title="Actual"><text-line size="10"/></default-field></field>
                <field name="actualTransactions"><default-field title="Txns"><text-line size="6"/></default-field></field>
                <field name="achievementPercent"><default-field title="%"><display format="#0.0"/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
