<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <service-call name="zenith.analytics.AnalyticsServices.get#AnalyticsDashboard" out-map="dashboard"/>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Analytics Dashboard" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Revenue (30 days)" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(dashboard.totalRevenue ?: 0, '#,##0.00')}" type="h3" style="text-positive text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Transactions (30 days)" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.totalTransactions ?: 0}" type="h3" style="text-primary text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Avg Basket Value" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(dashboard.avgBasketValue ?: 0, '#,##0.00')}" type="h3" style="text-info text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
                    <label text="Recent Daily Snapshots" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="SnapshotsForm" list="dashboard.recentSnapshots" skip-form="true" list-entry-limit="7">
                        <field name="snapshotDate"><default-field title="Date"><display format="dd-MMM"/></default-field></field>
                        <field name="storeId"><default-field title="Store">
                            <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                        </default-field></field>
                        <field name="netSales"><default-field title="Net Sales"><display format="#,##0"/></default-field></field>
                        <field name="transactionCount"><default-field title="Txns"><display/></default-field></field>
                        <field name="avgBasketValue"><default-field title="Avg Basket"><display format="#,##0"/></default-field></field>
                    </form-list>
                </container>
            </row-col>
            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
                    <label text="Target Achievement" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="TargetsForm" list="dashboard.targetAchievement" skip-form="true" list-entry-limit="7">
                        <field name="storeId"><default-field title="Store">
                            <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                        </default-field></field>
                        <field name="targetAmount"><default-field title="Target"><display format="#,##0"/></default-field></field>
                        <field name="actualAmount"><default-field title="Actual"><display format="#,##0"/></default-field></field>
                        <field name="achievementPercent"><default-field title="Achievement"><display format="#0.0%"/></default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
