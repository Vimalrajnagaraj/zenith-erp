<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Footfall" default-menu-index="5">

    <transition name="recordFootfall">
        <service-call name="zenith.analytics.AnalyticsServices.record#Footfall"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Store -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.stores.Store" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="storeId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.storeId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.analytics.FootfallCounter" list="footfallData">
            <search-form-inputs default-order-by="-counterDate,-hourOfDay"/>
            <econdition field-name="storeId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Footfall Data" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="RecordFootfall" button-text="Record Footfall" type="success">
                <form-single name="RecordForm" transition="recordFootfall">
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="counterDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="hourOfDay"><default-field title="Hour (0-23)"><text-line size="3"/></default-field></field>
                    <field name="footfallCount"><default-field title="Footfall"><text-line size="6"/></default-field></field>
                    <field name="conversionCount"><default-field title="Conversions"><text-line size="6" default-value="0"/></default-field></field>
                    <field name="submitBtn"><default-field title="Record"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="FootfallForm" list="footfallData" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="storeId"><header-field>
                    <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                        <entity-find entity-name="zenith.erp.stores.Store"/>
                    </entity-options></drop-down></header-field>
                    <default-field title="Store">
                        <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                    </default-field></field>
                <field name="counterDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="hourOfDay"><default-field title="Hour"><display/></default-field></field>
                <field name="footfallCount"><default-field title="Footfall"><display/></default-field></field>
                <field name="conversionCount"><default-field title="Conversions"><display/></default-field></field>
                <field name="conversionRate"><default-field title="Conv %"><display format="#0.0"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
