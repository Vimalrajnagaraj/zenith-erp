<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Basket Analysis" default-menu-index="6">

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): org-isolate CSV — show a pair only if BOTH products are the org's -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expProdIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.product.Product" list="_expProds"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="productId"/></entity-find>
            <set field="_expProdIds" from="_expProds ? _expProds.collect{it.productId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.analytics.BasketAnalysis" list="baskets">
            <search-form-inputs default-order-by="-coOccurrenceCount"/>
            <econdition field-name="productId1" operator="in" from="_expProdIds" ignore-if-empty="true"/>
            <econdition field-name="productId2" operator="in" from="_expProdIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Basket Analysis — Frequently Bought Together" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Basket Analysis..." style="display:none"></span>]]></text></render-mode>
            <form-list name="BasketForm" list="baskets" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="productId1"><default-field title="Product A">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="productId2"><default-field title="Product B">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="coOccurrenceCount"><header-field show-order-by="true"/>
                    <default-field title="Co-purchases"><display/></default-field></field>
                <field name="supportPercent"><default-field title="Support %"><display format="#0.0"/></default-field></field>
                <field name="confidencePercent"><default-field title="Confidence %"><display format="#0.0"/></default-field></field>
                <field name="liftRatio"><header-field show-order-by="true"/>
                    <default-field title="Lift"><display format="#0.00"/></default-field></field>
                <field name="analysisDate"><default-field title="Analyzed"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
