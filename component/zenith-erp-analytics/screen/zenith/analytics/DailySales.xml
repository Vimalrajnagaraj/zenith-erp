<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Daily Sales" default-menu-index="2">

    <transition name="generateSnapshot">
        <service-call name="zenith.analytics.AnalyticsServices.generate#DailySalesSnapshot"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning Store -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.stores.Store" list="_expOwnerRows"><econdition field-name="organizationPartyId" from="_expOrg"/><select-field field-name="storeId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.storeId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.analytics.DailySalesSnapshot" list="snapshots">
            <search-form-inputs default-order-by="-snapshotDate"/>
            <econdition field-name="storeId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Daily Sales Snapshots" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="GenerateSnapshot" button-text="Generate Snapshot" type="info">
                <form-single name="GenerateForm" transition="generateSnapshot">
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="snapshotDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Generate"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="SnapshotsForm" list="snapshots" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="storeId"><header-field>
                    <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                        <entity-find entity-name="zenith.erp.stores.Store"/>
                    </entity-options></drop-down></header-field>
                    <default-field title="Store">
                        <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                    </default-field></field>
                <field name="snapshotDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalSales"><default-field title="Gross Sales"><display format="#,##0.00"/></default-field></field>
                <field name="totalReturns"><default-field title="Returns"><display format="#,##0.00"/></default-field></field>
                <field name="netSales"><header-field show-order-by="true"/>
                    <default-field title="Net Sales"><display format="#,##0.00"/></default-field></field>
                <field name="transactionCount"><default-field title="Txns"><display/></default-field></field>
                <field name="avgBasketValue"><default-field title="Avg Basket"><display format="#,##0.00"/></default-field></field>
                <field name="uniqueCustomers"><default-field title="Customers"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
