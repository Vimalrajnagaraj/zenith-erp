<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Embedded BI Builder" default-menu-index="10">

    <transition name="getPivotData">
        <service-call name="zenith.analytics.BiServices.generate#PivotData" in-map="context"/>
        <default-response type="json"/>
    </transition>

    <actions>
        <!-- Mock fetching available data sources -->
        <script>
            availableSources = [
                [id: 'SalesInvoice', text: 'Sales Invoices'],
                [id: 'InventoryLevel', text: 'Inventory Levels'],
                [id: 'LedgerTransaction', text: 'General Ledger']
            ]
        </script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Drag-and-Drop BI Builder" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <!-- Responsive container for BI Workspace -->
        <container-row>
            <!-- Data Source Selection -->
            <row-col lg="3" md="4" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Data Source" type="h6" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="SelectSourceForm">
                        <field name="dataSource"><default-field title=""><drop-down>
                            <list-options list="availableSources" key="${id}" text="${text}"/>
                        </drop-down></default-field></field>
                    </form-single>
                    
                    <label text="Available Fields (Drag)" type="h6" style="q-mt-md q-mb-sm"/>
                    <container style="bg-grey-2 q-pa-sm border-radius-sm q-mb-sm"><label text="Region" type="p" style="q-mb-none"/></container>
                    <container style="bg-grey-2 q-pa-sm border-radius-sm q-mb-sm"><label text="Product Category" type="p" style="q-mb-none"/></container>
                    <container style="bg-grey-2 q-pa-sm border-radius-sm q-mb-sm"><label text="Net Sales" type="p" style="q-mb-none"/></container>
                </container>
            </row-col>
            
            <!-- BI Canvas Workspace -->
            <row-col lg="9" md="8" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg" id="bi-canvas-container">
                    <label text="BI Canvas" type="h6" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    
                    <!-- Apache ECharts JS Placeholder (Asynchronous Rendering) -->
                    <render-mode><text type="html"><![CDATA[
                        <div id="echart-main" style="width: 100%; height: 500px;"></div>
                        <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                var chartDom = document.getElementById('echart-main');
                                var myChart = echarts.init(chartDom);
                                
                                myChart.showLoading();
                                
                                // Asynchronous Data Fetching (AJAX) to prevent browser memory crash
                                fetch('/apps/zenith/analytics/EmbeddedBiBuilder/getPivotData?dataSource=SalesInvoice')
                                    .then(response => response.json())
                                    .then(data => {
                                        myChart.hideLoading();
                                        
                                        var option = {
                                            legend: {},
                                            tooltip: {},
                                            dataset: data.chartData,
                                            xAxis: { type: 'category' },
                                            yAxis: {},
                                            series: [{ type: 'bar' }, { type: 'bar' }]
                                        };
                                        myChart.setOption(option);
                                    })
                                    .catch(error => {
                                        myChart.hideLoading();
                                        console.error("Error fetching BI Data:", error);
                                    });
                                
                                // Responsiveness: Resize chart when window resizes
                                window.addEventListener('resize', function() {
                                    myChart.resize();
                                });
                            });
                        </script>
                    ]]></text></render-mode>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
