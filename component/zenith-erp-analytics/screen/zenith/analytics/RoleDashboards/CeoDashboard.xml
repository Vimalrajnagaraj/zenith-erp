<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="CEO Dashboard" default-menu-index="1">

    <actions>
        <!-- Mock fetching real-time financial data -->
        <script>
            // In production, these pull from AccountBalance and CrmPipeline dynamic views
            realTimeCashFlow = 1250000.00
            currentBurnRate = 145000.00
            pipelineValue = 4500000.00
        </script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Executive Dashboard (CEO)" type="h2" style="text-primary text-weight-bold q-my-none"/>
                <label text="Real-time financial &amp; operational metrics" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <link url="/apps/zenith/analytics/EmbeddedBiBuilder" text="Open BI Builder" link-type="anchor" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo text-white q-px-md"/>
        </container>

        <!-- KPI Summary Row -->
        <container-row>
            <row-col lg="4" md="4" sm="12">
                <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg text-center q-mb-md">
                    <label text="Real-Time Cash Flow" type="h6" style="text-grey-8 text-weight-medium"/>
                    <label text="$1,250,000" type="h2" style="text-green text-weight-bold q-my-sm"/>
                    <label text="+12% from last month" type="p" style="text-success text-weight-bold q-mb-none"/>
                </container>
            </row-col>
            <row-col lg="4" md="4" sm="12">
                <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg text-center q-mb-md">
                    <label text="Monthly Burn Rate" type="h6" style="text-grey-8 text-weight-medium"/>
                    <label text="$145,000" type="h2" style="text-red text-weight-bold q-my-sm"/>
                    <label text="-3% from last month" type="p" style="text-success text-weight-bold q-mb-none"/>
                </container>
            </row-col>
            <row-col lg="4" md="4" sm="12">
                <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg text-center q-mb-md">
                    <label text="Sales Pipeline Value" type="h6" style="text-grey-8 text-weight-medium"/>
                    <label text="$4,500,000" type="h2" style="text-indigo text-weight-bold q-my-sm"/>
                    <label text="Expected to close in Q3" type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </row-col>
        </container-row>
        
        <!-- BI Visualizations -->
        <container-row>
            <row-col lg="6" sm="12">
                <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg q-mt-md">
                     <label text="Revenue Trend (YTD)" type="h5" style="text-dark text-weight-bold q-mb-md"/>
                     <!-- Placeholder for Apache ECharts rendered line graph -->
                     <container style="bg-grey-2 border-radius-sm" id="revenue-chart-placeholder"><label text="[Revenue Line Chart loads here via AJAX]" type="p" style="q-pa-xl text-center text-grey-6"/></container>
                </container>
            </row-col>
            <row-col lg="6" sm="12">
                <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg q-mt-md">
                     <label text="Pipeline by Region" type="h5" style="text-dark text-weight-bold q-mb-md"/>
                     <!-- Placeholder for Apache ECharts rendered pie chart -->
                     <container style="bg-grey-2 border-radius-sm" id="pipeline-chart-placeholder"><label text="[Pipeline Pie Chart loads here via AJAX]" type="p" style="q-pa-xl text-center text-grey-6"/></container>
                </container>
            </row-col>
        </container-row>

    </widgets>
</screen>
