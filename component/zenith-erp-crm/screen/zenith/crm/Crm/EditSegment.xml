<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Segment" default-menu-include="false">

    <parameter name="segmentId" required="true"/>

    <transition name="updateSegment">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (prevent cross-tenant IDOR edit) -->
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg"/>
            <if condition="curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <service-call name="zenith.crm.CrmServices.update#CustomerSegment" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="addCriteria">
        <actions>
            <!-- Org-isolation: assert the target segment belongs to the active org before mutating -->
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg"/>
            <if condition="curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <service-call name="zenith.crm.CrmServices.add#SegmentCriteria" in-map="[segmentId:segmentId, criteriaTypeEnumId:criteriaTypeEnumId, operator:operator, joinOperator:joinOperator, fieldValue:fieldValue, fieldValueTo:fieldValueTo]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="deleteCriteria">
        <actions>
            <service-call name="zenith.crm.CrmServices.assert#CrmWrite" out-map="crmWrite"/>
            <if condition="!crmWrite.allowed"><return error="true" message="CRM write access and an active organization are required."/></if>
            <!-- Org-isolation: criteriaId carries no org; resolve via its segment and assert ownership -->
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.SegmentCriteria" value-field="curCrit"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg">
                <field-map field-name="segmentId" from="curCrit?.segmentId"/></entity-find-one>
            <if condition="curCrit == null || curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <service-call name="delete#zenith.erp.crm.SegmentCriteria" in-map="[criteriaId:criteriaId]"/>
            <if condition="curSeg.isAutoEvaluate == 'Y'">
                <entity-find-count entity-name="zenith.erp.crm.SegmentCriteria" count-field="remainingRules"><econdition field-name="segmentId" from="curSeg.segmentId"/></entity-find-count>
                <if condition="remainingRules"><service-call name="zenith.crm.CrmServices.evaluate#Segment" in-map="[segmentId:curSeg.segmentId]"/></if>
                <if condition="!remainingRules">
                    <entity-find entity-name="zenith.erp.crm.SegmentMember" list="oldAutoMembers">
                        <econdition field-name="segmentId" from="curSeg.segmentId"/><econdition field-name="addedMethod" value="Auto"/>
                    </entity-find>
                    <iterate list="oldAutoMembers" entry="oldMember"><service-call name="delete#zenith.erp.crm.SegmentMember"
                        in-map="[segmentId:curSeg.segmentId, partyId:oldMember.partyId]"/></iterate>
                    <entity-find-count entity-name="zenith.erp.crm.SegmentMember" count-field="remainingMembers"><econdition field-name="segmentId" from="curSeg.segmentId"/></entity-find-count>
                    <service-call name="update#zenith.erp.crm.CustomerSegment" in-map="[segmentId:curSeg.segmentId, memberCount:remainingMembers]"/>
                </if>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="addMember">
        <actions>
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg"/>
            <if condition="curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <!-- ZE-SB-013 (Tier 3): the added member party must belong to this org. -->
            <if condition="partyId">
                <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ma"
                              in-map="[entityName:'mantle.party.Party', idField:'partyId', idValue:partyId, orgField:'ownerPartyId']"/>
                <if condition="!_ma.allowed"><return error="true" message="That party isn't part of your organization."/></if>
            </if>
            <service-call name="zenith.crm.CrmServices.add#SegmentMember" in-map="[segmentId:segmentId, partyId:partyId]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="removeMember">
        <actions>
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg"/>
            <if condition="curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <service-call name="zenith.crm.CrmServices.remove#SegmentMember" in-map="[segmentId:segmentId, partyId:partyId]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="evaluateSegment">
        <actions>
            <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="curSeg"/>
            <if condition="curSeg == null || !activeOrg || activeOrg == '_NA_' || curSeg.organizationPartyId != activeOrg">
                <return error="true" message="Segment not found for your account."/>
            </if>
            <service-call name="zenith.crm.CrmServices.evaluate#Segment"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="segment"/>
        <!-- Org-isolation: block IDOR read of another tenant's segment by guessing segmentId -->
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <if condition="segment == null || !activeOrg || activeOrg == '_NA_' || segment.organizationPartyId != activeOrg">
            <return error="true" message="Segment not found for your account."/>
        </if>
        <entity-find entity-name="zenith.erp.crm.SegmentCriteria" list="criteriaList">
            <econdition field-name="segmentId"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <set field="hasUnsupportedCriteria" from="criteriaList.any { !['SctCustomerGroup','SctCountry','SctTotalSpend','SctOrderCount'].contains(it.criteriaTypeEnumId) }"/>
        <if condition="segment.isAutoEvaluate == 'Y' &amp;&amp; criteriaList &amp;&amp; modCanWrite &amp;&amp; !hasUnsupportedCriteria">
            <service-call name="zenith.crm.CrmServices.evaluate#Segment" in-map="[segmentId:segmentId]"/>
            <entity-find-one entity-name="zenith.erp.crm.CustomerSegment" value-field="segment"/>
        </if>
        <entity-find entity-name="zenith.erp.crm.SegmentMemberDetail" list="members">
            <econdition field-name="segmentId"/>
            <order-by field-name="organizationName,firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Segment: ${segment.segmentName}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="evaluateSegment" text="Evaluate Now" btn-type="info" condition="modCanWrite &amp;&amp; !criteriaList.isEmpty() &amp;&amp; !hasUnsupportedCriteria"
                  parameter-map="[segmentId:segmentId]" confirmation="Evaluate segment criteria and update members?"/>
        </container>
        <section name="unsupportedSegmentRules" condition="hasUnsupportedCriteria"><widgets><container style="zcrm-error"><label text="This segment contains a rule that is not supported by the evaluator. Remove or replace it before evaluating." type="p"/></container></widgets></section>

        <container-row>
            <row-col lg="8" md="12">
                <!-- Segment Details -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Segment Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="SegmentForm" map="segment" transition="updateSegment">
                        <field name="segmentId"><default-field><hidden/></default-field></field>
                        <field name="segmentName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="segmentTypeEnumId"><default-field title="Type">
                            <drop-down><option key="CstDynamic" text="Dynamic (rules)"/><option key="CstStatic" text="Static (manual members)"/>
                                <option key="CstSpendBased" text="Legacy: spend-based"/><option key="CstFrequency" text="Legacy: purchase frequency"/>
                                <option key="CstGeographic" text="Legacy: geographic"/><option key="CstProductPref" text="Legacy: product preference"/>
                                <option key="CstRecency" text="Legacy: recency"/><option key="CstCustom" text="Legacy: custom/manual"/>
                            </drop-down></default-field></field>
                        <field name="description"><default-field><text-area rows="2" cols="50"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn">
                            <conditional-field name="seg_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>

                <!-- Criteria -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Criteria" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="AddCriteria_write"><condition><expression>modCanWrite</expression></condition><widgets>
                        <container-dialog id="AddCriteria" button-text="Add Criteria" type="success">
                            <form-single name="AddCriteriaForm" transition="addCriteria">
                                <field name="segmentId" from="segment.segmentId"><default-field><hidden/></default-field></field>
                                <field name="criteriaTypeEnumId"><default-field title="Criteria Type">
                                    <drop-down>
                                        <option key="SctCustomerGroup" text="Customer group"/>
                                        <option key="SctCountry" text="Country"/>
                                        <option key="SctTotalSpend" text="Total spend"/>
                                        <option key="SctOrderCount" text="Order count"/>
                                    </drop-down></default-field></field>
                                <field name="operator"><default-field>
                                    <drop-down>
                                        <option key="eq" text="Equals"/>
                                        <option key="gt" text="Greater Than"/><option key="gte" text="Greater or Equal"/>
                                        <option key="lt" text="Less Than"/><option key="lte" text="Less or Equal"/>
                                    </drop-down></default-field></field>
                                <field name="joinOperator"><default-field title="Combine with previous"><drop-down><option key="AND"/><option key="OR"/></drop-down></default-field></field>
                                <field name="fieldValue"><default-field title="Value (group ID, country code, or number)"><text-line size="20"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </container>

                    <section name="noCriteria" condition="criteriaList.isEmpty()"><widgets><container style="zcrm-empty"><label text="No rules yet. Add a supported rule to evaluate this segment, or add members manually." type="p"/></container></widgets></section>
                    <form-list name="CriteriaForm" list="criteriaList" skip-form="true">
                        <field name="sequenceNum"><default-field title="#"><display/></default-field></field>
                        <field name="criteriaTypeEnumId"><default-field title="Criteria">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="operator"><default-field><display/></default-field></field>
                        <field name="joinOperator"><default-field title="Combine"><display/></default-field></field>
                        <field name="fieldValue"><default-field title="Value"><display/></default-field></field>
                        <field name="fieldValueTo"><default-field title="Value To"><display/></default-field></field>
                        <field name="removeBtn">
                            <conditional-field name="crit_remove_write" condition="modCanWrite" title="">
                            <link url="deleteCriteria" text="Remove" btn-type="danger"
                                  parameter-map="[criteriaId:criteriaId]"
                                  confirmation="Remove this criteria?"/>
                            </conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </container>

                <!-- Members -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Members (${members.size()})" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="AddMember_write"><condition><expression>modCanWrite &amp;&amp; segment.isAutoEvaluate != 'Y'</expression></condition><widgets>
                        <container-dialog id="AddMember" button-text="Add Member" type="success">
                            <form-single name="AddMemberForm" transition="addMember">
                                <field name="segmentId" from="segment.segmentId"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Customer">
                                    <drop-down><entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Customer"/>
                                            <econdition field-name="ownerPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </container>

                    <section name="noMembers" condition="members.isEmpty()"><widgets><container style="zcrm-empty"><label text="No customers in this segment yet. Add a member or evaluate its rules." type="p"/></container></widgets></section>
                    <form-list name="MembersForm" list="members" skip-form="true">
                        <field name="partyId"><default-field title="Customer">
                            <display text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}"/>
                        </default-field></field>
                        <field name="addedDate"><default-field title="Added"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="addedMethod"><default-field title="Method"><display/></default-field></field>
                        <field name="removeBtn">
                            <conditional-field name="mem_remove_write" condition="modCanWrite &amp;&amp; segment.isAutoEvaluate != 'Y'" title="">
                            <link url="removeMember" text="Remove" btn-type="danger"
                                  parameter-map="[segmentId:segmentId, partyId:partyId]"
                                  confirmation="Remove this member?"/>
                            </conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Members" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${segment.memberCount ?: 0}" type="h3" style="text-primary text-weight-bold q-my-sm"/>
                </container>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Criteria Rules" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${criteriaList.size()}" type="h3" style="text-info text-weight-bold q-my-sm"/>
                </container>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Last Evaluated" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${segment.lastEvaluatedDate ? ec.l10n.format(segment.lastEvaluatedDate, 'dd-MMM-yyyy HH:mm') : 'Never'}"
                           type="h6" style="text-dark text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
