<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Activity Detail" default-menu-include="false">
    <parameter name="activityId" required="true"/>
    <transition name="completeActivity"><service-call name="zenith.crm.CrmServices.complete#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="rescheduleActivity"><service-call name="zenith.crm.CrmServices.reschedule#Activity"/>
        <default-response url="."/><error-response url="."/></transition>
    <actions>
        <entity-find-one entity-name="zenith.erp.crm.CrmActivity" value-field="activity"/>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <if condition="!activity || !activeOrg || activeOrg == '_NA_' || activity.organizationPartyId != activeOrg">
            <return error="true" message="Activity not found for your organization."/>
        </if>
        <entity-find entity-name="zenith.erp.crm.CrmAuditEvent" list="auditEvents"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="recordType" value="Activity"/><econdition field-name="recordId" from="activityId"/><order-by field-name="-eventDate"/></entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="${activity.subject}" type="h3"/><label text="${activity.activityType} · ${activity.statusId ?: 'Completed'}" type="p"/><link url="../Activities" text="Back to activities"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Due" type="span"/><label text="${activity.dueDate ? ec.l10n.format(activity.dueDate, 'dd MMM yyyy HH:mm') : 'Not scheduled'}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Owner" type="span"/><label text="${activity.assignedToUserId ?: activity.performedByUserId ?: 'Unassigned'}" type="h4"/></container>
            <container style="zcrm-metric"><label text="Priority" type="span"/><label text="${activity.priority ?: 'Normal'}" type="h4"/></container>
        </container>
        <container-box><box-header title="Linked record and notes"/><box-body>
            <label text="Lead: ${activity.leadId ?: '—'} · Opportunity: ${activity.salesOpportunityId ?: '—'} · Contact: ${activity.contactPartyId ?: '—'}" type="p"/>
            <label text="${activity.description ?: 'No notes'}" type="p"/>
            <label text="Outcome: ${activity.outcome ?: 'Pending'}" type="p"/>
        </box-body></container-box>
        <section name="ActivityActions" condition="modCanWrite &amp;&amp; activity.statusId != 'Completed'"><widgets>
            <container-row><row-col lg="6"><container-box><box-header title="Complete activity"/><box-body>
                <form-single name="CompleteActivityForm" transition="completeActivity">
                    <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                    <field name="outcome"><default-field title="Outcome"><text-line size="32"/></default-field></field>
                    <field name="description"><default-field title="Notes"><text-area rows="3" cols="40"/></default-field></field>
                    <field name="durationMinutes"><default-field title="Duration (minutes)"><text-line size="8"/></default-field></field>
                    <field name="nextFollowUpDate"><default-field title="Next follow-up (optional)"><date-time type="date-time"/></default-field></field>
                    <field name="submitButton"><default-field title="Complete"><submit/></default-field></field>
                </form-single>
            </box-body></container-box></row-col>
            <row-col lg="6"><container-box><box-header title="Reschedule"/><box-body>
                <form-single name="RescheduleActivityForm" transition="rescheduleActivity">
                    <field name="activityId"><default-field><hidden default-value="${activityId}"/></default-field></field>
                    <field name="dueDate"><default-field title="New due date"><date-time type="date-time"/></default-field></field>
                    <field name="note"><default-field title="Reason (optional)"><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Reschedule"><submit/></default-field></field>
                </form-single>
            </box-body></container-box></row-col></container-row>
        </widgets></section>
        <container-box><box-header title="Change history"/><box-body>
            <section name="NoChanges" condition="auditEvents.isEmpty()"><widgets><label text="No reschedules recorded." type="p"/></widgets></section>
            <form-list name="ActivityAudit" list="auditEvents" skip-form="true">
                <field name="eventDate"><default-field title="When"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="previousValue"><default-field title="Previous due"><display/></default-field></field>
                <field name="newValue"><default-field title="New due"><display/></default-field></field>
                <field name="note"><default-field><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
