<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="CRM Settings" default-menu-include="false">
    <transition name="saveStage"><service-call name="zenith.crm.CrmServices.save#StageSetting"/>
        <default-response url="."/><error-response url="."/></transition>
    <actions>
        <set field="isCrmAdmin" from="modCanWrite &amp;&amp; (ec.user.isInGroup('ADMIN') || ec.user.isInGroup('ZENITH_ADMIN'))"/>
        <entity-find entity-name="mantle.sales.opportunity.SalesOpportunityStage" list="baseStages"><order-by field-name="sequenceNum"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmStageSetting" list="stageSettings">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <script><![CDATA[
            def byId = stageSettings.collectEntries { [(it.opportunityStageId):it] }
            stageRows = baseStages.findAll { !['SoClosedWon','SoClosedLost'].contains(it.opportunityStageId) }
                .collect { base ->
                    def own = byId[base.opportunityStageId]
                    [opportunityStageId:base.opportunityStageId, displayName:own?.displayName ?: base.description,
                     sequenceNum:own?.sequenceNum ?: base.sequenceNum,
                     probability:own?.defaultProbability != null ? own.defaultProbability : base.defaultProbability,
                     active:own?.isActive ?: 'Y']
                }.sort { it.sequenceNum ?: 0 }
        ]]></script>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="CRM Settings" type="h3"/>
            <label text="Configure this organization's open pipeline stages." type="p"/>
            <link url="../Dashboard" text="Back to CRM"/></container>
        <section name="AdminOnly" condition="isCrmAdmin"><widgets>
            <container-box><box-header title="Pipeline stages"/><box-body>
                <label text="Changes here apply to new opportunities and future stage moves. Existing opportunity probabilities are kept until their stage changes." type="p"/>
                <form-list name="StageSettingList" list="stageRows" skip-form="true">
                    <field name="displayName"><default-field title="Stage"><display/></default-field></field>
                    <field name="sequenceNum"><default-field title="Order"><display/></default-field></field>
                    <field name="probability"><default-field title="Default probability"><display format="0%"/></default-field></field>
                    <field name="active"><default-field title="Active"><display/></default-field></field>
                </form-list>
                <form-single name="SaveStageSetting" transition="saveStage">
                    <field name="opportunityStageId"><default-field title="Stage"><drop-down>
                        <list-options list="stageRows" key="${opportunityStageId}" text="${displayName}"/>
                    </drop-down></default-field></field>
                    <field name="displayName"><default-field title="Display name"><text-line size="28"/></default-field></field>
                    <field name="sequenceNum"><default-field title="Display order"><text-line size="8"/></default-field></field>
                    <field name="defaultProbability"><default-field title="Default probability (0–1)"><text-line size="8"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save stage"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>
        <section name="SettingsReadOnly" condition="!isCrmAdmin"><widgets><container style="zcrm-empty">
            <label text="CRM administrator access is required to change these settings." type="p"/>
        </container></widgets></section>
    </widgets>
</screen>
