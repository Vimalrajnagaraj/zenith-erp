<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Leads" default-menu-index="2">
    <parameter name="leadSourceId"/><parameter name="campaignId"/><parameter name="statusId"/><parameter name="assignedToUserId"/><parameter name="period"/>

    <transition name="createLead">
        <service-call name="zenith.crm.CrmServices.create#Lead"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="editLead">
        <default-response url="../EditLead"/>
    </transition>
    <transition name="saveView"><service-call name="zenith.crm.CrmServices.save#CrmFilter"/><default-response url="."/><error-response url="."/></transition>
    <transition name="deleteView"><service-call name="zenith.crm.CrmServices.delete#CrmFilter"/><default-response url="."/><error-response url="."/></transition>

    <actions>
        <script><![CDATA[
            period = period == 'month' ? 'month' : 'all'
            def today = java.time.LocalDate.parse(new java.text.SimpleDateFormat('yyyy-MM-dd').format(ec.user.nowTimestamp))
            periodStart = period == 'month' ? java.sql.Timestamp.valueOf(today.withDayOfMonth(1).atStartOfDay()) : null
            periodEnd = period == 'month' ? java.sql.Timestamp.valueOf(today.withDayOfMonth(1).plusMonths(1).atStartOfDay()) : null
        ]]></script>
        <entity-find-count entity-name="zenith.erp.crm.Lead" count-field="organizationLeadCount">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="createdDate" operator="greater-equals" from="periodStart" ignore-if-empty="true"/>
            <econdition field-name="createdDate" operator="less" from="periodEnd" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.crm.Lead" count-field="newLeadCount">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="statusId" value="LeadNew"/>
            <econdition field-name="createdDate" operator="greater-equals" from="periodStart" ignore-if-empty="true"/>
            <econdition field-name="createdDate" operator="less" from="periodEnd" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.crm.Lead" count-field="qualifiedLeadCount">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="statusId" value="LeadQualified"/>
            <econdition field-name="createdDate" operator="greater-equals" from="periodStart" ignore-if-empty="true"/>
            <econdition field-name="createdDate" operator="less" from="periodEnd" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.crm.Lead" count-field="convertedLeadCount">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="statusId" value="LeadConverted"/>
            <econdition field-name="createdDate" operator="greater-equals" from="periodStart" ignore-if-empty="true"/>
            <econdition field-name="createdDate" operator="less" from="periodEnd" ignore-if-empty="true"/>
        </entity-find-count>
        <entity-find entity-name="zenith.erp.crm.LeadListView" list="leadList">
            <search-form-inputs default-order-by="-createdDate" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="createdDate" operator="greater-equals" from="periodStart" ignore-if-empty="true"/>
            <econdition field-name="createdDate" operator="less" from="periodEnd" ignore-if-empty="true"/>
        </entity-find>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <set field="_ao" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="organizationPartyId" from="_ao"/></if>
        <entity-find entity-name="zenith.erp.crm.LeadSource" list="leadSources">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="description"/>
        </entity-find>
        <set field="leadSources" from="leadSources.findAll { !it.organizationPartyId || it.organizationPartyId == crmOrganization.activeOrgId }"/>
        <entity-find entity-name="zenith.erp.crm.CrmCampaign" list="campaigns">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="campaignName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmSavedFilter" list="savedFilters">
            <econdition field-name="organizationPartyId" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="userId" from="ec.user.userId"/><econdition field-name="screenName" value="Leads"/>
            <order-by field-name="filterName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro zcrm-leads-head"><label text="Leads" type="h3"/><label text="Track and manage potential customers." type="p"/></container>
        <container style="zcrm-period"><link url="." text="All time" parameter-map="[period:'all']" style="${period == 'all' ? 'zcrm-period-active' : ''}"/><link url="." text="This month" parameter-map="[period:'month']" style="${period == 'month' ? 'zcrm-period-active' : ''}"/></container>
        <container style="zcrm-pipeline-actions"><link url="../ImportLeads" text="Import CSV" condition="modCanWrite"/></container>
        <container style="zcrm-period zcrm-saved-views">
            <section-iterate name="LeadSavedViews" list="savedFilters" entry="saved"><widgets>
                <link url="." text="${saved.filterName}" parameter-map="new groovy.json.JsonSlurper().parseText(saved.filterJson)"/>
                <link url="deleteView" text="Remove" parameter-map="[filterId:saved.filterId]" condition="modCanWrite" confirmation="Remove this saved view?"/>
            </widgets></section-iterate>
            <section name="SaveLeadView" condition="modCanWrite"><widgets><form-single name="SaveLeadFilter" transition="saveView">
                <field name="screenName"><default-field><hidden default-value="Leads"/></default-field></field>
                <field name="period"><default-field><hidden default-value="${period}"/></default-field></field>
                <field name="leadSourceId"><default-field><hidden default-value="${leadSourceId ?: ''}"/></default-field></field>
                <field name="campaignId"><default-field><hidden default-value="${campaignId ?: ''}"/></default-field></field>
                <field name="statusId"><default-field><hidden default-value="${statusId ?: ''}"/></default-field></field>
                <field name="assignedToUserId"><default-field><hidden default-value="${assignedToUserId ?: ''}"/></default-field></field>
                <field name="filterName"><default-field title="Save current filters as"><text-line size="20"/></default-field></field>
                <field name="submitButton"><default-field title="Save view"><submit/></default-field></field>
            </form-single></widgets></section>
        </container>
        <container style="zcrm-metrics zcrm-lead-metrics">
            <container style="zcrm-metric zcrm-tone-purple"><label text="Total leads" type="span"/><label text="${organizationLeadCount}" type="h4"/><label text="All leads in your organization" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric zcrm-tone-blue"><label text="New" type="span"/><label text="${newLeadCount}" type="h4"/><label text="Awaiting first contact" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric zcrm-tone-green"><label text="Qualified" type="span"/><label text="${qualifiedLeadCount}" type="h4"/><label text="Leads marked as qualified" type="span" style="zcrm-muted"/></container>
            <container style="zcrm-metric zcrm-tone-orange"><label text="Converted" type="span"/><label text="${convertedLeadCount}" type="h4"/><label text="Converted to customers" type="span" style="zcrm-muted"/></container>
        </container>
        <container style="zcrm-leads-directory"><container-box><box-header title="Lead directory"/><box-toolbar>
            <section name="NewLead_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewLeadDialog" button-text="New Lead" condition="_hasActiveOrg">
                <form-single name="NewLeadForm" transition="createLead">
                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                    <field name="firstName"><default-field title="First Name"><text-line size="20"/></default-field></field>
                    <field name="lastName"><default-field title="Last Name"><text-line size="20"/></default-field></field>
                    <field name="companyName"><default-field title="Company"><text-line size="30"/></default-field></field>
                    <field name="designation"><default-field><text-line size="20"/></default-field></field>
                    <field name="email"><default-field><text-line size="30"/></default-field></field>
                    <field name="mobile"><default-field title="Mobile"><text-line size="15"/></default-field></field>
                    <field name="city"><default-field><text-line size="20"/></default-field></field>
                    <field name="regionCode"><default-field title="State">
                        <drop-down allow-empty="true">
                            <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="20"/></default-field></field>
                    <field name="leadSourceId"><default-field title="Source">
                        <drop-down allow-empty="false">
                            <list-options list="leadSources" key="${leadSourceId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="sourceDetail"><default-field title="Source Detail"><text-line size="30"/></default-field></field>
                    <field name="campaignId"><default-field title="Campaign"><drop-down allow-empty="true"><list-options list="campaigns" key="${campaignId}" text="${campaignName}"/></drop-down></default-field></field>
                    <field name="utmSource"><default-field title="UTM Source"><text-line size="24"/></default-field></field>
                    <field name="utmMedium"><default-field title="UTM Medium"><text-line size="24"/></default-field></field>
                    <field name="utmCampaign"><default-field title="UTM Campaign"><text-line size="24"/></default-field></field>
                    <field name="utmContent"><default-field title="UTM Content"><text-line size="24"/></default-field></field>
                    <field name="utmTerm"><default-field title="UTM Term"><text-line size="24"/></default-field></field>
                    <field name="landingPageUrl"><default-field title="Landing URL"><text-line size="40"/></default-field></field>
                    <field name="allowDuplicate"><default-field title="Duplicate Check"><drop-down><option key="N" text="Check for duplicates"/><option key="Y" text="Reviewed: create separately"/></drop-down></default-field></field>
                    <field name="rating"><default-field>
                        <drop-down><option key="Hot"/><option key="Warm"/><option key="Cold"/></drop-down>
                    </default-field></field>
                    <field name="estimatedAmount"><default-field title="Est. Deal Value (${currSymbol})"><text-line size="12"/></default-field></field>
                    <field name="description"><default-field title="Notes"><text-area rows="3" cols="50"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Lead"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
            <section name="NoOrg" condition="!_hasActiveOrg"><widgets><label text="Select an organization to create or view leads." type="span" style="text-grey-7"/></widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Leads..." style="display:none"></span>]]></text></render-mode>
            <label text="${organizationLeadCount} leads in this organization. Use the table filters to find a lead." type="p" style="zcrm-list-count"/>
            <form-list name="LeadListForm" list="leadList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="firstName">
                    <header-field title="Lead"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><link url="editLead" text="${firstName} ${lastName ?: ''}" parameter-map="[leadId:leadId]"/></default-field>
                </field>
                <field name="companyName">
                    <header-field title="Company"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="email"><header-field><text-find size="25" hide-options="true"/></header-field><default-field><display/></default-field></field>
                <field name="mobile"><header-field title="Phone"><text-find size="18" hide-options="true"/></header-field><default-field title="Phone"><display text="${mobile ?: phone ?: ''}"/></default-field></field>
                <field name="sourceName"><header-field title="Source"><text-find size="18" hide-options="true"/></header-field><default-field title="Source"><display/></default-field></field>
                <field name="campaignName"><header-field title="Campaign"><text-find size="18" hide-options="true"/></header-field><default-field><display/></default-field></field>
                <field name="assignedToUserId"><header-field title="Owner"><text-find size="16" hide-options="true"/></header-field><default-field><display text="${assignedToUserId ?: 'Unassigned'}"/></default-field></field>
                <field name="score">
                    <header-field show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="estimatedAmount">
                    <header-field title="Est. Value" show-order-by="true"/>
                    <default-field><display format="#,##,##0"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Stage">
                        <drop-down allow-empty="true">
                            <option key="LeadNew" text="New"/>
                            <option key="LeadContacted" text="Contacted"/>
                            <option key="LeadQualified" text="Qualified"/>
                            <option key="LeadConverted" text="Converted"/>
                            <option key="LeadLost" text="Lost"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="createdDate">
                    <header-field title="Created" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
            <section name="NoLeads" condition="leadList.isEmpty() &amp;&amp; organizationLeadCount == 0"><widgets><container style="zcrm-empty zcrm-leads-empty"><label text="No leads yet" type="h5"/><label text="Use New Lead above to start tracking potential customers." type="p"/></container></widgets></section>
            <section name="NoLeadMatches" condition="leadList.isEmpty() &amp;&amp; organizationLeadCount &gt; 0"><widgets><container style="zcrm-empty zcrm-leads-empty"><label text="No leads match this search" type="h5"/><label text="Clear the table filters or try a different term." type="p"/></container></widgets></section>
        </box-body></container-box></container>
    </widgets>
</screen>
