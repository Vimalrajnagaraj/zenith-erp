<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sources &amp; Campaigns" default-menu-index="6">
    <parameter name="trackingCampaignId"/><parameter name="destinationUrl"/>
    <parameter name="utmContent"/><parameter name="utmTerm"/>
    <transition name="createSource">
        <service-call name="zenith.crm.CrmServices.create#LeadSource"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="createCampaign">
        <service-call name="zenith.crm.CrmServices.create#CrmCampaign"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <actions>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        <entity-find entity-name="zenith.erp.crm.LeadSource" list="allSources">
            <econdition field-name="isActive" value="Y"/><order-by field-name="description"/>
        </entity-find>
        <set field="sources" from="allSources.findAll { !it.organizationPartyId || it.organizationPartyId == activeOrg }"/>
        <entity-find entity-name="zenith.erp.crm.CrmCampaign" list="campaigns">
            <search-form-inputs default-order-by="-startDate,campaignName" skip-fields="organizationPartyId"/>
            <econdition field-name="organizationPartyId" from="activeOrg"/>
        </entity-find>
        <script><![CDATA[
            trackingUrl = null
            trackingError = null
            if (trackingCampaignId && destinationUrl) {
                def campaign = ec.entity.find('zenith.erp.crm.CrmCampaign')
                    .condition('campaignId', trackingCampaignId).condition('organizationPartyId', activeOrg).one()
                try {
                    def uri = new java.net.URI(destinationUrl.trim())
                    if (!campaign || !(uri.scheme?.toLowerCase(java.util.Locale.ROOT) in ['http','https']) || !uri.host)
                        throw new IllegalArgumentException('Select a campaign and an HTTP or HTTPS destination.')
                    def values = [utm_source:campaign.leadSourceId.toLowerCase(java.util.Locale.ROOT),
                        utm_medium:(campaign.medium ?: 'referral').toLowerCase(java.util.Locale.ROOT),
                        utm_campaign:campaign.campaignKey]
                    if (utmContent) values.utm_content = utmContent
                    if (utmTerm) values.utm_term = utmTerm
                    values.crm_campaign_id = campaign.campaignId
                    def encoded = values.collect { key, value ->
                        java.net.URLEncoder.encode(key, 'UTF-8') + '=' + java.net.URLEncoder.encode(value.toString(), 'UTF-8')
                    }.join('&')
                    def base = destinationUrl.trim().split('#', 2)[0]
                    def fragment = destinationUrl.trim().contains('#') ? '#' + destinationUrl.trim().split('#', 2)[1] : ''
                    def separator = base.endsWith('?') || base.endsWith('&') ? '' : (uri.rawQuery ? '&' : '?')
                    trackingUrl = base + separator + encoded + fragment
                } catch (Exception ignored) {
                    trackingError = 'Select a campaign and enter a valid HTTP or HTTPS destination URL.'
                }
            }
        ]]></script>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="Sources &amp; Campaigns" type="h3"/>
            <label text="Track where enquiries came from and build links for real campaigns." type="p"/></container>
        <container style="zcrm-board-toolbar">
            <section name="SourceAdmin" condition="modCanWrite &amp;&amp; (ec.user.isInGroup('ADMIN') || ec.user.isInGroup('ZENITH_ADMIN'))"><widgets>
                <container-dialog id="NewSourceDialog" button-text="New Source">
                    <form-single name="NewSourceForm" transition="createSource">
                        <field name="description"><default-field title="Source name"><text-line size="32"/></default-field></field>
                        <field name="submitButton"><default-field title="Create source"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
            <section name="CampaignWrite" condition="modCanWrite"><widgets>
                <container-dialog id="NewCampaignDialog" button-text="New Campaign">
                    <form-single name="NewCampaignForm" transition="createCampaign">
                        <field name="campaignName"><default-field title="Campaign name"><text-line size="32"/></default-field></field>
                        <field name="leadSourceId"><default-field title="Source"><drop-down><list-options list="sources" key="${leadSourceId}" text="${description}"/></drop-down></default-field></field>
                        <field name="medium"><default-field title="Medium"><text-line size="24"/></default-field></field>
                        <field name="startDate"><default-field title="Start"><date-time type="date"/></default-field></field>
                        <field name="endDate"><default-field title="End"><date-time type="date"/></default-field></field>
                        <field name="budgetAmount"><default-field title="Budget (optional)"><text-line size="16"/></default-field></field>
                        <field name="landingPageUrl"><default-field title="Landing URL"><text-line size="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Create campaign"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </widgets></section>
        </container>
        <container-box><box-header title="Tracking link builder"/><box-body>
            <label text="Add UTM tags to a destination URL. Existing query parameters and fragments stay intact." type="p"/>
            <form-single name="TrackingLinkForm" transition="." type="find">
                <field name="trackingCampaignId"><default-field title="Campaign"><drop-down allow-empty="true"><list-options list="campaigns" key="${campaignId}" text="${campaignName}"/></drop-down></default-field></field>
                <field name="destinationUrl"><default-field title="Destination URL"><text-line size="45"/></default-field></field>
                <field name="utmContent"><default-field title="UTM content (optional)"><text-line size="24"/></default-field></field>
                <field name="utmTerm"><default-field title="UTM term (optional)"><text-line size="24"/></default-field></field>
                <field name="submitButton"><default-field title="Build link"><submit/></default-field></field>
            </form-single>
            <label text="${trackingUrl}" type="p" condition="trackingUrl" style="zcrm-tracking-url"/>
            <label text="${trackingError}" type="p" condition="trackingError" style="text-negative"/>
        </box-body></container-box>
        <container-box><box-header title="Campaigns"/><box-body>
            <section name="NoCampaigns" condition="campaigns.isEmpty()"><widgets><label text="No campaigns yet. Create one to build tracked links." type="p"/></widgets></section>
            <form-list name="CampaignList" list="campaigns" skip-form="true" header-dialog="true" show-csv-button="true">
                <field name="campaignName"><header-field><text-find size="24"/></header-field><default-field><display/></default-field></field>
                <field name="leadSourceId"><default-field title="Source"><display/></default-field></field>
                <field name="medium"><default-field><display/></default-field></field>
                <field name="startDate"><default-field title="Start"><display format="dd MMM yyyy"/></default-field></field>
                <field name="endDate"><default-field title="End"><display format="dd MMM yyyy"/></default-field></field>
                <field name="budgetAmount"><default-field title="Budget"><display format="#,##,##0"/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
        <container-box><box-header title="Source catalogue"/><box-body>
            <label text="Manual source selection and UTM capture are available. Platform connection status is shown only when an integration is configured." type="p"/>
            <form-list name="SourceList" list="sources" skip-form="true">
                <field name="description"><default-field title="Source"><display/></default-field></field>
                <field name="organizationPartyId"><default-field title="Scope"><display text="${organizationPartyId ? 'This organization' : 'Default'}"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
