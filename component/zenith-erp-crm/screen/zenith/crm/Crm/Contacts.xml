<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contacts" default-menu-index="5">
    <actions>
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_') ?: '__NO_ORGANIZATION__'"/>
        <entity-find-count entity-name="mantle.party.Party" count-field="contactCount"><econdition field-name="ownerPartyId" from="activeOrg"/></entity-find-count>
        <entity-find entity-name="zenith.erp.contacts.ContactListView" list="contacts">
            <search-form-inputs default-order-by="organizationName,firstName" skip-fields="ownerPartyId"/>
            <econdition field-name="ownerPartyId" from="activeOrg"/>
        </entity-find>
    </actions>
    <widgets>
        <container style="zcrm-intro"><label text="Contacts" type="h3"/>
            <label text="People and companies shared with leads, opportunities and activities." type="p"/></container>
        <container style="zcrm-pipeline-actions"><link url="../goContacts" text="Manage Contacts"/></container>
        <container style="zcrm-metrics zcrm-reference-metrics">
            <container style="zcrm-metric"><label text="Contacts in this organization" type="span"/><label text="${contactCount}" type="h4"/><label text="Shared ERP records" type="span" style="zcrm-muted"/></container>
        </container>
        <container-box><box-header title="Contact directory"/><box-body>
            <section name="NoContacts" condition="contacts.isEmpty()"><widgets><label text="No contacts match. Create a contact in the shared Contacts module or clear filters." type="p"/></widgets></section>
            <form-list name="CrmContactsList" list="contacts" skip-form="true" header-dialog="true" show-csv-button="true" show-page-size="true">
                <field name="partyId"><default-field title="Contact"><link url="../ContactDetail" text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim() ?: partyId}" parameter-map="[partyId:partyId]"/></default-field></field>
                <field name="organizationName"><header-field title="Company"><text-find size="22"/></header-field><default-field><display/></default-field></field>
                <field name="emailAddress"><header-field title="Email"><text-find size="22"/></header-field><default-field><display/></default-field></field>
                <field name="phoneNumber"><header-field title="Phone"><text-find size="18"/></header-field><default-field><display/></default-field></field>
                <field name="partyTypeEnumId"><default-field title="Type"><display/></default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
