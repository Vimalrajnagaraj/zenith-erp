<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Lead Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="leadId" required="true"/>

    <transition name="updateLead">
        <actions>
            <service-call name="zenith.crm.CrmServices.update#Lead" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="convertLead">
        <actions>
            <service-call name="zenith.crm.CrmServices.convert#Lead" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="logActivity">
        <service-call name="zenith.crm.CrmServices.log#Activity"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="recordTouch"><service-call name="zenith.crm.CrmServices.record#LeadTouch"/><default-response url="."/><error-response url="."/></transition>
    <transition name="scheduleActivity"><service-call name="zenith.crm.CrmServices.schedule#Activity"/><default-response url="."/><error-response url="."/></transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.crm.Lead" value-field="lead"/>
        <!-- Org-isolation: block IDOR read of another tenant's lead by guessing leadId -->
        <set field="activeOrg" from="(crmOrganization.activeOrgId ?: '_NA_')"/>
        <if condition="lead == null || !activeOrg || activeOrg == '_NA_' || lead.organizationPartyId != activeOrg">
            <return error="true" message="Lead not found for your account."/>
        </if>
        <entity-find entity-name="zenith.erp.crm.LeadSource" list="leadSources">
            <econdition field-name="isActive" value="Y"/><order-by field-name="description"/></entity-find>
        <set field="leadSources" from="leadSources.findAll { !it.organizationPartyId || it.organizationPartyId == activeOrg }"/>
        <entity-find entity-name="zenith.erp.crm.CrmCampaign" list="campaigns"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="isActive" value="Y"/></entity-find>
        <script><![CDATA[
            def contacts = ec.entity.find('zenith.erp.contacts.ContactListView').condition('ownerPartyId', activeOrg).list()
            possibleDuplicates = contacts.findAll { row ->
                (lead.email && row.emailAddress?.equalsIgnoreCase(lead.email)) ||
                ((lead.mobile ?: lead.phone) && row.phoneNumber?.replaceAll(/\D/, '') == (lead.mobile ?: lead.phone).replaceAll(/\D/, ''))
            }.collect { it.partyId }.unique()
        ]]></script>
        <entity-find entity-name="zenith.erp.india.IndiaState" list="stateList">
            <order-by field-name="stateName"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmActivity" list="activities">
            <econdition field-name="leadId"/>
            <order-by field-name="-activityDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.crm.LeadTouch" list="touches"><econdition field-name="leadId"/><econdition field-name="organizationPartyId" from="activeOrg"/><order-by field-name="-touchDate"/></entity-find>
        <entity-find entity-name="zenith.erp.crm.CrmAuditEvent" list="sourceAudit"><econdition field-name="organizationPartyId" from="activeOrg"/><econdition field-name="recordType" value="Lead"/><econdition field-name="recordId" from="leadId"/><order-by field-name="-eventDate"/></entity-find>
    </actions>

    <widgets>
        <container style="zcrm-intro"><label text="Lead details" type="h3"/><label text="Update qualification, contact details and the activity history." type="p"/><link url="../Leads" text="Back to leads"/></container>
        <container-row>
            <row-col lg="7">
                <container-box><box-header title="Lead Details"/><box-toolbar>
                    <section name="ConvertLeadAction" condition="lead.statusId != 'LeadConverted' &amp;&amp; lead.statusId != 'LeadLost' &amp;&amp; modCanWrite"><widgets>
                        <container-dialog id="ConvertLeadDialog" button-text="Convert to Opportunity">
                            <form-single name="ConvertLeadForm" transition="convertLead">
                                <field name="leadId"><default-field><hidden default-value="${leadId}"/></default-field></field>
                                <field name="reusePartyId"><default-field title="Existing contact ID (if matched)"><text-line size="24"/></default-field></field>
                                <field name="createOpportunity"><default-field title="Create opportunity"><drop-down><option key="Y" text="Yes"/><option key="N" text="No, contact only"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Confirm conversion"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets></section>
                </box-toolbar><box-body>
                    <form-single name="EditLeadForm" map="lead" transition="updateLead">
                        <field name="leadId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <option key="LeadNew" text="New"/>
                                <option key="LeadContacted" text="Contacted"/>
                                <option key="LeadQualified" text="Qualified"/>
                                <option key="LeadConverted" text="Converted (use Convert to Contact)"/>
                                <option key="LeadLost" text="Lost"/>
                            </drop-down>
                        </default-field></field>
                        <field name="firstName"><default-field><text-line size="20"/></default-field></field>
                        <field name="lastName"><default-field><text-line size="20"/></default-field></field>
                        <field name="companyName"><default-field title="Company"><text-line size="30"/></default-field></field>
                        <field name="designation"><default-field><text-line size="20"/></default-field></field>
                        <field name="email"><default-field><text-line size="30"/></default-field></field>
                        <field name="mobile"><default-field><text-line size="15"/></default-field></field>
                        <field name="phone"><default-field><text-line size="15"/></default-field></field>
                        <field name="website"><default-field><text-line size="30"/></default-field></field>
                        <field name="address"><default-field><text-area rows="2" cols="50"/></default-field></field>
                        <field name="city"><default-field><text-line size="20"/></default-field></field>
                        <field name="regionCode"><default-field title="State">
                            <drop-down allow-empty="true">
                                <list-options list="stateList" key="${stateCode}" text="${stateCode} - ${stateName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="postalCode"><default-field title="PIN Code"><text-line size="8"/></default-field></field>
                        <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="20"/></default-field></field>
                        <field name="taxIdNumber"><default-field title="PAN"><text-line size="12"/></default-field></field>
                        <field name="leadSourceId"><conditional-field name="source_admin" condition="ec.user.isInGroup('ADMIN') || ec.user.isInGroup('ZENITH_ADMIN')" title="Original source">
                            <drop-down allow-empty="false">
                                <list-options list="leadSources" key="${leadSourceId}" text="${description}"/>
                            </drop-down>
                        </conditional-field><default-field title="Original source"><display text="${leadSourceId ?: 'Unknown'}"/></default-field></field>
                        <field name="sourceDetail"><default-field title="Source detail"><text-line size="30"/></default-field></field>
                        <field name="campaignId"><default-field title="Campaign"><drop-down allow-empty="true"><list-options list="campaigns" key="${campaignId}" text="${campaignName}"/></drop-down></default-field></field>
                        <field name="rating"><default-field>
                            <drop-down><option key="Hot"/><option key="Warm"/><option key="Cold"/></drop-down>
                        </default-field></field>
                        <field name="estimatedAmount"><default-field title="Est. Deal (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="estimatedCloseDate"><default-field title="Est. Close"><date-time type="date"/></default-field></field>
                        <field name="description"><default-field title="Notes"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="lostReason"><default-field title="Disqualification reason"><text-line size="40"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                    <label text="Score: ${lead.score ?: 0}/100" type="div" style="text-info"/>
                    <label text="First touch: ${lead.firstTouchSourceId ?: lead.leadSourceId ?: 'Unknown'} · Latest touch: ${lead.latestTouchSourceId ?: lead.leadSourceId ?: 'Unknown'}" type="p"/>
                    <label text="UTM: ${lead.utmSource ?: '—'} / ${lead.utmMedium ?: '—'} / ${lead.utmCampaign ?: '—'}" type="p"/>
                    <label text="Possible matching contacts: ${possibleDuplicates.join(', ')}" type="p" condition="possibleDuplicates"/>
                    <section name="LeadTouchWrite" condition="modCanWrite"><widgets><container-dialog id="RecordTouchDialog" button-text="Record new touch">
                        <form-single name="RecordTouchForm" transition="recordTouch">
                            <field name="leadId"><default-field><hidden default-value="${leadId}"/></default-field></field>
                            <field name="leadSourceId"><default-field title="Latest source"><drop-down><list-options list="leadSources" key="${leadSourceId}" text="${description}"/></drop-down></default-field></field>
                            <field name="utmSource"><default-field title="UTM source (optional)"><text-line size="24"/></default-field></field>
                            <field name="utmMedium"><default-field title="UTM medium (optional)"><text-line size="24"/></default-field></field>
                            <field name="utmCampaign"><default-field title="UTM campaign (optional)"><text-line size="24"/></default-field></field>
                            <field name="submitButton"><default-field title="Record touch"><submit/></default-field></field>
                        </form-single>
                    </container-dialog></widgets></section>
                    <form-list name="TouchHistory" list="touches" skip-form="true">
                        <field name="touchDate"><default-field title="Touch"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                        <field name="leadSourceId"><default-field title="Source"><display/></default-field></field>
                        <field name="utmCampaign"><default-field title="Campaign"><display/></default-field></field>
                    </form-list>
                    <form-list name="LeadAttributionAudit" list="sourceAudit" skip-form="true">
                        <field name="eventDate"><default-field title="Change date"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                        <field name="action"><default-field><display/></default-field></field>
                        <field name="previousValue"><default-field title="Previous"><display/></default-field></field>
                        <field name="newValue"><default-field title="Current"><display/></default-field></field>
                    </form-list>
                    <label text="Converted to Party: ${lead.convertedPartyId}" type="div" style="text-success" condition="lead.convertedPartyId"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="5">
                <container-box><box-header title="Activities"/><box-toolbar>
                    <section name="LeadLogActivity_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="LogActivityDialog" button-text="Log Activity">
                        <form-single name="LogActivityForm" transition="logActivity">
                            <field name="leadId"><default-field><hidden/></default-field></field>
                            <field name="activityType"><default-field title="Type">
                                <drop-down>
                                    <option key="Call" text="Phone Call"/>
                                    <option key="Email" text="Email"/>
                                    <option key="Meeting" text="Meeting"/>
                                    <option key="WhatsApp" text="WhatsApp"/>
                                    <option key="Note" text="Note"/>
                                    <option key="Task" text="Task"/>
                                </drop-down>
                            </default-field></field>
                            <field name="subject"><default-field><text-line size="30"/></default-field></field>
                            <field name="description"><default-field><text-area rows="3" cols="40"/></default-field></field>
                            <field name="outcome"><default-field><text-line size="30"/></default-field></field>
                            <field name="nextFollowUpDate"><default-field title="Next Follow-up"><date-time type="date-time"/></default-field></field>
                            <field name="submitButton"><default-field title="Log"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ScheduleLeadActivityDialog" button-text="Schedule Follow-up">
                        <form-single name="ScheduleLeadActivity" transition="scheduleActivity">
                            <field name="leadId"><default-field><hidden default-value="${leadId}"/></default-field></field>
                            <field name="activityType"><default-field title="Type"><drop-down><option key="Call"/><option key="Email"/><option key="Meeting"/><option key="Demo"/><option key="Task"/><option key="FollowUp"/></drop-down></default-field></field>
                            <field name="subject"><default-field><text-line size="30"/></default-field></field>
                            <field name="dueDate"><default-field title="Due"><date-time type="date-time"/></default-field></field>
                            <field name="priority"><default-field><drop-down><option key="Normal"/><option key="High"/><option key="Low"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Schedule"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar><box-body>
                    <form-list name="ActivityListForm" list="activities" skip-form="true">
                        <field name="activityDate"><default-field title="Date"><display format="dd/MM/yy HH:mm"/></default-field></field>
                        <field name="activityType"><default-field title="Type"><display/></default-field></field>
                        <field name="subject"><default-field><display/></default-field></field>
                        <field name="outcome"><default-field><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
