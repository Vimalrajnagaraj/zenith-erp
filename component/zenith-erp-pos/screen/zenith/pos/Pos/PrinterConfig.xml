<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Printers" default-menu-index="22">

    <parameter name="searchTerm"/>
    <parameter name="typeFilter"/>
    <parameter name="connFilter"/>
    <parameter name="statusFilter"/>
    <parameter name="termFilter"/>

    <transition name="createPrinter" begin-transaction="true">
        <service-call name="create#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePrinter" begin-transaction="true">
        <service-call name="update#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="deletePrinter" begin-transaction="true">
        <service-call name="delete#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PrinterConfiguration" list="allPrinters">
            <order-by field-name="printerName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.Enumeration" list="printerTypeEnums">
            <econdition field-name="enumTypeId" value="PrinterType"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="allTerminals">
            <order-by field-name="terminalName"/>
        </entity-find>
        <script><![CDATA[
            // KPI stats from the full (unfiltered) set.
            totalPrinters = allPrinters.size()
            activePrinters = allPrinters.count { it.isActive == 'Y' }
            inactivePrinters = totalPrinters - activePrinters
            templatesCount = allPrinters.collect { it.receiptTemplateId }.findAll { it }.unique().size()
            hasPrinters = totalPrinters > 0
            // lookups for search + display
            def typeDesc = [:]; printerTypeEnums.each { typeDesc[it.enumId] = it.description }
            def termName = [:]; allTerminals.each { termName[it.terminalId] = it.terminalName }
            // apply the toolbar filters in-memory (the printer list is small).
            def st = (searchTerm ?: '').toLowerCase().trim()
            printerList = allPrinters.findAll { pr ->
                (st == '' || [pr.printerName, pr.ipAddress, pr.connectionType, (typeDesc[pr.printerTypeEnumId] ?: ''), (termName[pr.terminalId] ?: '')].collect { (it ?: '').toString().toLowerCase() }.any { it.contains(st) }) &&
                (!typeFilter || pr.printerTypeEnumId == typeFilter) &&
                (!connFilter || pr.connectionType == connFilter) &&
                (!statusFilter || pr.isActive == statusFilter) &&
                (!termFilter || pr.terminalId == termFilter)
            }
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_printers" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#128424; Printers &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Set up your receipt and kitchen printers.<br><b>1</b>&nbsp;<b>Add Printer</b> with its type and connection.<br><b>2</b>&nbsp;Assign each printer to the terminal that should use it.</div></details>]]></text></render-mode>

        <container style="q-px-md q-pt-md">
            <!-- Page header: printer icon + title + subtitle; Add Printer top-right when printers exist -->
            <container style="zsec-hdr row items-center q-mb-lg">
                <container style="row items-center no-wrap">
                    <container style="z-icobadge lg primary q-mr-md"><label text="print" type="span" style="material-icons"/></container>
                    <container style="column">
                        <label text="Printer Configuration" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Add, manage and configure printers for POS billing." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                    </container>
                </container>
                <section name="AddBtnHdr"><condition><expression>hasPrinters</expression></condition><widgets>
                <container style="z-newbtn-wrap">
                    <container-dialog id="CreatePrinterDialog" button-text="+ Add Printer"
                        button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                        <form-single name="CreatePrinterForm" transition="createPrinter">
                            <field name="printerId"><default-field title="Printer ID"><text-line size="15"/></default-field></field>
                            <field name="printerName"><default-field title="Printer Name"><text-line size="30"/></default-field></field>
                            <field name="printerTypeEnumId"><default-field title="Printer Type">
                                <drop-down><entity-options key="${enumId}" text="${description}"><entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="PrinterType"/><order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down></default-field></field>
                            <field name="connectionType"><default-field title="Connection Type">
                                <drop-down><option key="USB" text="USB"/><option key="Network" text="Network (TCP/IP)"/><option key="Bluetooth" text="Bluetooth"/></drop-down></default-field></field>
                            <field name="ipAddress"><default-field title="IP Address"><text-line size="20"/></default-field></field>
                            <field name="port"><default-field title="Port"><text-line size="8"/></default-field></field>
                            <field name="terminalId"><default-field title="Linked Terminal">
                                <drop-down allow-empty="true"><entity-options key="${terminalId}" text="${terminalName}"><entity-find entity-name="zenith.erp.pos.PosTerminal"><econdition field-name="isActive" value="Y"/><order-by field-name="terminalName"/></entity-find></entity-options></drop-down></default-field></field>
                            <field name="receiptTemplateId"><default-field title="Receipt Template">
                                <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}"><entity-find entity-name="zenith.erp.pos.PosReceiptTemplate"><econdition field-name="isActive" value="Y"/><order-by field-name="templateName"/></entity-find></entity-options></drop-down></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>
                </widgets></section>
            </container>

            <!-- KPI stat cards: Total(violet) / Active(green) / Inactive(grey) / Templates(blue) -->
            <container style="z-statrow">
                <container style="z-statcell z-statcard-violet q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg primary"><label text="print" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Total Printers" type="span" style="z-statlabel"/>
                            <label text="${totalPrinters ?: 0}" type="span" style="z-statnum z-txt-primary"/>
                            <label text="All configured printers" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-green q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg green"><label text="check_circle" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Active Printers" type="span" style="z-statlabel"/>
                            <label text="${activePrinters ?: 0}" type="span" style="z-statnum z-amt-green"/>
                            <label text="Ready for use" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-grey q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg grey"><label text="power_settings_new" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Inactive Printers" type="span" style="z-statlabel"/>
                            <label text="${inactivePrinters ?: 0}" type="span" style="z-statnum"/>
                            <label text="Not in use" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
                <container style="z-statcell z-statcard-blue q-pa-md">
                    <container style="z-statinner">
                        <container style="z-icobadge lg blue"><label text="settings" type="span" style="material-icons"/></container>
                        <container style="z-statmeta">
                            <label text="Templates" type="span" style="z-statlabel"/>
                            <label text="${templatesCount ?: 0}" type="span" style="z-statnum z-amt-blue"/>
                            <label text="Assigned to printers" type="span" style="z-statdesc"/>
                        </container>
                    </container>
                </container>
            </container>
        </container>

        <!-- Toolbar: search + type / connection / status filters + More Filters (reveals terminal filter) -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <div style="margin:2px 16px 0;font-family:'Segoe UI',Arial,sans-serif">
          <form method="get" action="PrinterConfig" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <div style="position:relative;flex:1;min-width:240px">
              <span class="material-icons" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:18px;color:#9CA3AF;pointer-events:none">search</span>
              <input type="text" name="searchTerm" value="${(searchTerm!'')?html}" placeholder="Search by printer name, type, IP address or terminal..." style="width:100%;padding:9px 12px 9px 36px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;box-sizing:border-box;background:#fff"/>
            </div>
            <select name="typeFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Types</option>
              <#list (printerTypeEnums![]) as e>
                <option value="${e.enumId}" <#if (typeFilter!'')==e.enumId>selected</#if>>${(e.description!e.enumId)?html}</option>
              </#list>
            </select>
            <select name="connFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Connections</option>
              <option value="USB" <#if (connFilter!'')=='USB'>selected</#if>>USB</option>
              <option value="Network" <#if (connFilter!'')=='Network'>selected</#if>>Network</option>
              <option value="Bluetooth" <#if (connFilter!'')=='Bluetooth'>selected</#if>>Bluetooth</option>
            </select>
            <select name="statusFilter" onchange="this.form.submit()" style="padding:9px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
              <option value="">All Status</option>
              <option value="Y" <#if (statusFilter!'')=='Y'>selected</#if>>Active</option>
              <option value="N" <#if (statusFilter!'')=='N'>selected</#if>>Inactive</option>
            </select>
            <button type="button" onclick="var r=document.getElementById('prnMoreRow');if(r)r.style.display=(r.style.display==='none'?'flex':'none');" style="display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;color:#374151;font-size:13px;font-weight:500;cursor:pointer"><span class="material-icons" style="font-size:16px">filter_list</span>More Filters</button>
            <button type="submit" style="display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:16px">search</span>Search</button>
            <div id="prnMoreRow" style="<#if (termFilter!'')?has_content>display:flex<#else>display:none</#if>;flex-basis:100%;align-items:center;gap:8px;font-size:13px;color:#374151;padding-top:2px">
              <span style="color:#6B7280">Terminal:</span>
              <select name="termFilter" onchange="this.form.submit()" style="padding:8px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;color:#374151;background:#fff">
                <option value="">All terminals</option>
                <#list (allTerminals![]) as t>
                  <option value="${t.terminalId}" <#if (termFilter!'')==t.terminalId>selected</#if>>${(t.terminalName!t.terminalId)?html}</option>
                </#list>
              </select>
            </div>
          </form>
        </div>
        ]]></text></render-mode>

        <container style="q-pa-md">
            <!-- Empty state (no printers configured at all) -->
            <section name="EmptyState"><condition><expression>!hasPrinters</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg">
                <container style="prn-empty">
                    <container style="prn-empty-ico"><label text="print" type="span" style="material-icons"/></container>
                    <label text="No printers configured yet" type="span" style="prn-empty-h"/>
                    <label text="Add a printer to start printing bills, receipts and kitchen orders." type="span" style="prn-empty-p"/>
                    <container style="z-newbtn-wrap">
                        <container-dialog id="CreatePrinterDialogEmpty" button-text="+ Add Printer"
                            button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                            <form-single name="CreatePrinterFormEmpty" transition="createPrinter">
                                <field name="printerId"><default-field title="Printer ID"><text-line size="15"/></default-field></field>
                                <field name="printerName"><default-field title="Printer Name"><text-line size="30"/></default-field></field>
                                <field name="printerTypeEnumId"><default-field title="Printer Type">
                                    <drop-down><entity-options key="${enumId}" text="${description}"><entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="PrinterType"/><order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down></default-field></field>
                                <field name="connectionType"><default-field title="Connection Type">
                                    <drop-down><option key="USB" text="USB"/><option key="Network" text="Network (TCP/IP)"/><option key="Bluetooth" text="Bluetooth"/></drop-down></default-field></field>
                                <field name="ipAddress"><default-field title="IP Address"><text-line size="20"/></default-field></field>
                                <field name="port"><default-field title="Port"><text-line size="8"/></default-field></field>
                                <field name="terminalId"><default-field title="Linked Terminal">
                                    <drop-down allow-empty="true"><entity-options key="${terminalId}" text="${terminalName}"><entity-find entity-name="zenith.erp.pos.PosTerminal"><econdition field-name="isActive" value="Y"/><order-by field-name="terminalName"/></entity-find></entity-options></drop-down></default-field></field>
                                <field name="receiptTemplateId"><default-field title="Receipt Template">
                                    <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}"><entity-find entity-name="zenith.erp.pos.PosReceiptTemplate"><econdition field-name="isActive" value="Y"/><order-by field-name="templateName"/></entity-find></entity-options></drop-down></default-field></field>
                                <field name="isActive"><default-field title="Active">
                                    <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                                <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                </container>
            </container>
            </widgets></section>

            <!-- Printer table (inline-editable rows) -->
            <section name="TableState"><condition><expression>hasPrinters</expression></condition><widgets>
            <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-txntable">
                <form-list name="PrinterListForm" list="printerList" transition="updatePrinter">
                    <field name="printerId"><header-field title="ID"/><default-field><display/></default-field></field>
                    <field name="printerName"><header-field title="Name"/><default-field title="Name"><text-line size="18"/></default-field></field>
                    <field name="printerTypeEnumId"><header-field title="Type"/><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}"><entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="PrinterType"/><order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="connectionType"><header-field title="Connection"/><default-field title="Connection">
                        <drop-down><option key="USB" text="USB"/><option key="Network" text="Network"/><option key="Bluetooth" text="Bluetooth"/></drop-down></default-field></field>
                    <field name="ipAddress"><header-field title="IP Address"/><default-field title="IP Address"><text-line size="14"/></default-field></field>
                    <field name="port"><header-field title="Port"/><default-field title="Port"><text-line size="6"/></default-field></field>
                    <field name="terminalId"><header-field title="Terminal"/><default-field title="Terminal">
                        <drop-down allow-empty="true"><entity-options key="${terminalId}" text="${terminalName}"><entity-find entity-name="zenith.erp.pos.PosTerminal"><order-by field-name="terminalName"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="receiptTemplateId"><header-field title="Template"/><default-field title="Template">
                        <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}"><entity-find entity-name="zenith.erp.pos.PosReceiptTemplate"><order-by field-name="templateName"/></entity-find></entity-options></drop-down></default-field></field>
                    <field name="isActive"><header-field title="Status"/><default-field title="Status">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitBtn"><header-field title="Actions"/><default-field title="Actions"><submit text="Update"/></default-field></field>
                    <field name="deleteBtn"><header-field title=""/><default-field title="">
                        <link url="deletePrinter" text="Delete" btn-type="danger" style="q-btn--dense"
                              parameter-map="[printerId:printerId]" confirmation="Delete this printer?"/>
                    </default-field></field>
                </form-list>
            </container>
            </widgets></section>
        </container>
    </widgets>
</screen>
