<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Printers" default-menu-index="22">

    <transition name="createPrinter" begin-transaction="true">
        <service-call name="create#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePrinter" begin-transaction="true">
        <service-call name="update#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="deletePrinter" begin-transaction="true">
        <service-call name="delete#zenith.erp.pos.PrinterConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PrinterConfiguration" list="printerList">
            <order-by field-name="printerName"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_printers" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128424; Printers &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Set up your receipt and kitchen printers.<br><b>1</b>&nbsp;<b>Add Printer</b> with its type and connection.<br><b>2</b>&nbsp;Assign each printer to the terminal that should use it.</div></details>]]></text></render-mode>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Printer Configuration" type="h4" style="text-weight-bold q-my-none"/>
            <container style="row q-gutter-sm">
                <link url="goTerminal" text="Back to Billing" icon="fa fa-arrow-left" btn-type="primary" style="q-btn--dense"/>
                <container-dialog id="CreatePrinterDialog" button-text="Add Printer" type="success">
                    <form-single name="CreatePrinterForm" transition="createPrinter">
                        <field name="printerId"><default-field title="Printer ID"><text-line size="15"/></default-field></field>
                        <field name="printerName"><default-field title="Printer Name"><text-line size="30"/></default-field></field>
                        <field name="printerTypeEnumId"><default-field title="Printer Type">
                            <drop-down>
                                <entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="PrinterType"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                        <field name="connectionType"><default-field title="Connection Type">
                            <drop-down>
                                <option key="USB" text="USB"/>
                                <option key="Network" text="Network (TCP/IP)"/>
                                <option key="Bluetooth" text="Bluetooth"/>
                            </drop-down></default-field></field>
                        <field name="ipAddress"><default-field title="IP Address"><text-line size="20"/></default-field></field>
                        <field name="port"><default-field title="Port"><text-line size="8"/></default-field></field>
                        <field name="terminalId"><default-field title="Linked Terminal">
                            <drop-down allow-empty="true">
                                <entity-options key="${terminalId}" text="${terminalName}">
                                    <entity-find entity-name="zenith.erp.pos.PosTerminal">
                                        <econdition field-name="isActive" value="Y"/>
                                        <order-by field-name="terminalName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                        <field name="receiptTemplateId"><default-field title="Receipt Template">
                            <drop-down allow-empty="true">
                                <entity-options key="${templateId}" text="${templateName}">
                                    <entity-find entity-name="zenith.erp.pos.PosReceiptTemplate">
                                        <econdition field-name="isActive" value="Y"/>
                                        <order-by field-name="templateName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y">
                                <option key="Y" text="Yes"/>
                                <option key="N" text="No"/>
                            </drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PrinterListForm" list="printerList" transition="updatePrinter">
                <field name="printerId"><default-field title="ID"><display/></default-field></field>
                <field name="printerName"><default-field title="Name"><text-line size="18"/></default-field></field>
                <field name="printerTypeEnumId"><default-field title="Type">
                    <drop-down>
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="PrinterType"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options>
                    </drop-down></default-field></field>
                <field name="connectionType"><default-field title="Connection">
                    <drop-down>
                        <option key="USB" text="USB"/>
                        <option key="Network" text="Network"/>
                        <option key="Bluetooth" text="Bluetooth"/>
                    </drop-down></default-field></field>
                <field name="ipAddress"><default-field title="IP Address"><text-line size="14"/></default-field></field>
                <field name="port"><default-field title="Port"><text-line size="6"/></default-field></field>
                <field name="terminalId"><default-field title="Terminal">
                    <drop-down allow-empty="true">
                        <entity-options key="${terminalId}" text="${terminalName}">
                            <entity-find entity-name="zenith.erp.pos.PosTerminal">
                                <order-by field-name="terminalName"/>
                            </entity-find>
                        </entity-options>
                    </drop-down></default-field></field>
                <field name="receiptTemplateId"><default-field title="Template">
                    <drop-down allow-empty="true">
                        <entity-options key="${templateId}" text="${templateName}">
                            <entity-find entity-name="zenith.erp.pos.PosReceiptTemplate">
                                <order-by field-name="templateName"/>
                            </entity-find>
                        </entity-options>
                    </drop-down></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down>
                        <option key="Y" text="Yes"/>
                        <option key="N" text="No"/>
                    </drop-down></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deletePrinter" text="Delete" btn-type="danger" style="q-btn--dense"
                          parameter-map="[printerId:printerId]" confirmation="Delete this printer?"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
