<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Discount" default-menu-index="14">

    <transition name="saveDiscountSettings" begin-transaction="true">
        <actions>
            <script><![CDATA[
                def orgId = ec.user.getPreference('ACTIVE_ORGANIZATION')
                if (!orgId || orgId == '_NA_') {
                    ec.message.addError("No active shop selected. Open the POS for your shop first, then set the discount rules.")
                    return
                }
                def savePref = { k, v ->
                    def existing = ec.entity.find("moqui.security.UserPreference")
                        .condition("userId", orgId).condition("preferenceKey", k).one()
                    if (existing) { existing.preferenceValue = (v != null ? v.toString() : ''); existing.update() }
                    else { ec.entity.makeValue("moqui.security.UserPreference")
                        .setAll([userId: orgId, preferenceKey: k, preferenceValue: (v != null ? v.toString() : '')]).create() }
                }

                // Discount limit % — clamp 0..100; blank means "no limit gate"
                def limStr = (context.discountLimitPct != null ? context.discountLimitPct.toString().trim() : '')
                if (limStr != '') {
                    BigDecimal lim
                    try { lim = new BigDecimal(limStr) } catch (Exception e) {
                        ec.message.addError("Discount limit must be a number (e.g. 10)."); return
                    }
                    if (lim < 0) lim = BigDecimal.ZERO
                    if (lim > 100) lim = new BigDecimal("100")
                    savePref('POS_DISC_LIMIT', lim.stripTrailingZeros().toPlainString())
                } else {
                    savePref('POS_DISC_LIMIT', '')
                }

                // Round-off step — from a fixed dropdown, so it is already one of 0/1/5/10
                def stepStr = (context.roundOffStep != null ? context.roundOffStep.toString().trim() : '')
                savePref('POS_DISC_ROUNDSTEP', stepStr == '' ? '0' : stepStr)

                // Manager PIN — write-only. Blank = leave unchanged. Clear checkbox = remove it.
                def clearPin = (context.clearPin == 'Y' || context.clearPin == true)
                def pinStr = (context.managerPin != null ? context.managerPin.toString().trim() : '')
                if (clearPin) {
                    savePref('POS_DISC_PIN', '')
                    ec.message.addMessage("Discount rules saved. Manager PIN removed.")
                } else if (pinStr != '') {
                    if (!(pinStr ==~ /\d{4,6}/)) {
                        ec.message.addError("Manager PIN must be 4 to 6 digits."); return
                    }
                    savePref('POS_DISC_PIN', pinStr)
                    ec.message.addMessage("Discount rules saved. Manager PIN updated.")
                } else {
                    ec.message.addMessage("Discount rules saved.")
                }
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            def _uri = (ec.web?.request?.requestURI ?: '')
            def _zi = _uri.indexOf('/zenith/')
            appBase = _zi > 0 ? _uri.substring(0, _zi) : ''

            def orgId = ec.user.getPreference('ACTIVE_ORGANIZATION')
            hasOrg = (orgId && orgId != '_NA_')
            def rd = { k -> hasOrg ? ec.entity.find("moqui.security.UserPreference")
                .condition("userId", orgId).condition("preferenceKey", k).one()?.preferenceValue : null }
            def curLimit = rd('POS_DISC_LIMIT')
            def curStep = rd('POS_DISC_ROUNDSTEP')
            def curPin = rd('POS_DISC_PIN')
            // pre-fill the form from saved values (the PIN is NEVER pre-filled — write-only)
            discountLimitPct = (curLimit != null && curLimit.toString().trim() != '') ? curLimit.toString().trim() : ''
            roundOffStep = (curStep != null && curStep.toString().trim() != '') ? curStep.toString().trim() : '0'
            // Current-rules chips (the PIN value is never shown — only Set / Not set)
            limitChip = (discountLimitPct != '') ? (discountLimitPct + '%') : 'No limit'
            stepDisplay = (roundOffStep == '0' || roundOffStep == '') ? 'Off' : ('₹' + roundOffStep)
            roundChip = (roundOffStep == '0' || roundOffStep == '') ? 'Off' : ('Nearest ₹' + roundOffStep)
            pinDisplay = (curPin != null && curPin.toString().trim() != '') ? 'Set' : 'Not set'
            pinChipClass = (pinDisplay == 'Set') ? 'success' : 'warning'
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_discount" style="background:#EEF2FF;border:1px solid #C7D2FE;border-left:5px solid #6366F1;border-radius:10px;padding:9px 16px;margin:8px 16px 0 16px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:700;font-size:14px;color:#3730A3;outline:none">&#127991; Discount rules &mdash; quick help <span style="font-weight:500;color:#6B7280;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Control how much discount your cashiers can give at the billing counter.<br><b>1</b>&nbsp;<b>Discount limit</b> &mdash; the biggest discount a cashier may give without approval (e.g. 10%). Leave blank to allow any amount.<br><b>2</b>&nbsp;<b>Manager PIN</b> &mdash; a secret code needed to go above the limit. It is hidden &mdash; we never show it back on screen.<br><b>3</b>&nbsp;<b>Round-off</b> &mdash; round the final amount to a neat figure (e.g. nearest &#8377;5).</div></details>]]></text></render-mode>

        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <div style="padding:16px 20px 0;font-family:'Segoe UI',Arial,sans-serif">
            <!-- Page header -->
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px">
                <div style="display:flex;align-items:center;gap:14px">
                    <span class="z-icobadge lg primary"><span class="material-icons">sell</span></span>
                    <div>
                        <div style="font-size:20px;font-weight:800;color:#111827;line-height:1.3">Discount &amp; Round-off Rules</div>
                        <div style="font-size:13px;color:#6B7280;line-height:1.5">Set discount limits, round-off rules and manage PIN for POS transactions.</div>
                    </div>
                </div>
                <a href="#posHelp_discount" onclick="var d=document.getElementById('posHelp_discount');if(d){d.open=true;}" style="display:inline-flex;align-items:center;gap:6px;background:#FEF3C7;color:#B45309;border:1px solid #FDE68A;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap"><span class="material-icons" style="font-size:16px">lightbulb</span>Need help?</a>
            </div>

            <#if !hasOrg>
            <div style="background:#FEF2F2;border:1px solid #FECACA;border-radius:12px;padding:18px 20px;color:#B91C1C;font-size:13px;font-weight:500">No shop is selected for this session, so discount rules cannot be saved. Open the POS for your shop (so it becomes your active organization), then come back here.</div>
            <#else>
            <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">
                <!-- ===== LEFT: Discount Rules form ===== -->
                <section style="flex:1.35 1 440px;min-width:0;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px">
                        <span class="z-icobadge primary"><span class="material-icons">settings</span></span>
                        <div>
                            <div style="font-size:15px;font-weight:700;color:#111827">Discount Rules</div>
                            <div style="font-size:12.5px;color:#6B7280">Configure the rules for discounts and manager approval.</div>
                        </div>
                    </div>

                    <div style="margin-bottom:16px">
                        <label style="font-size:13px;font-weight:600;color:#111827;display:block">Discount limit (%) without PIN</label>
                        <div style="font-size:12px;color:#9CA3AF;margin:2px 0 7px">Maximum discount allowed without PIN.</div>
                        <div style="display:flex;align-items:stretch;border:1px solid #E5E7EB;border-radius:8px;overflow:hidden;max-width:440px">
                            <input id="disc-limit" type="number" step="0.01" min="0" max="100" value="${(discountLimitPct)!''}" placeholder="e.g. 5" style="flex:1;min-width:0;border:none;padding:10px 12px;font-size:14px;outline:none"/>
                            <span style="display:flex;align-items:center;justify-content:center;width:44px;background:#F8F9FC;border-left:1px solid #E5E7EB;color:#6B7280;font-size:14px">%</span>
                        </div>
                    </div>

                    <div style="margin-bottom:16px">
                        <label style="font-size:13px;font-weight:600;color:#111827;display:block">Round-off the final amount</label>
                        <div style="font-size:12px;color:#9CA3AF;margin:2px 0 7px">Choose how to round the bill amount.</div>
                        <select id="disc-round" style="max-width:440px;width:100%;box-sizing:border-box;padding:10px 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;color:#374151;background:#fff">
                            <option value="0" <#if (roundOffStep!'0') == '0'>selected</#if>>Off (exact amount)</option>
                            <option value="1" <#if (roundOffStep!'') == '1'>selected</#if>>Nearest &#8377;1</option>
                            <option value="5" <#if (roundOffStep!'') == '5'>selected</#if>>Nearest &#8377;5</option>
                            <option value="10" <#if (roundOffStep!'') == '10'>selected</#if>>Nearest &#8377;10</option>
                        </select>
                    </div>

                    <div style="margin-bottom:16px">
                        <label style="font-size:13px;font-weight:600;color:#111827;display:block">Manager PIN (4&ndash;6 digits)</label>
                        <div style="font-size:12px;color:#9CA3AF;margin:2px 0 7px">Required for discounts above the limit.</div>
                        <div style="display:flex;align-items:stretch;border:1px solid #E5E7EB;border-radius:8px;overflow:hidden;max-width:440px">
                            <input id="disc-pin" type="password" inputmode="numeric" autocomplete="new-password" maxlength="6" placeholder="Leave blank to keep current; type a new PIN to change" style="flex:1;min-width:0;border:none;padding:10px 12px;font-size:14px;outline:none"/>
                            <button type="button" id="disc-eye" title="Show / hide" style="display:flex;align-items:center;justify-content:center;width:44px;background:#F8F9FC;border:none;border-left:1px solid #E5E7EB;color:#9CA3AF;cursor:pointer"><span class="material-icons" style="font-size:18px">visibility</span></button>
                        </div>
                    </div>

                    <div style="margin-bottom:20px">
                        <label style="font-size:13px;font-weight:600;color:#111827;display:block">Remove the PIN (allow no override)</label>
                        <div style="font-size:12px;color:#9CA3AF;margin:2px 0 7px">If enabled, discounts cannot be overridden.</div>
                        <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:#374151"><input type="checkbox" id="disc-clear" style="width:16px;height:16px;accent-color:#7C3AED"/> Yes, do not allow override</label>
                    </div>

                    <#if (modCanWrite!false)>
                    <div style="display:flex;gap:12px">
                        <button id="disc-save" type="button" style="display:inline-flex;align-items:center;gap:7px;padding:11px 20px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:18px">save</span>Save Discount Rules</button>
                        <button id="disc-reset" type="button" style="display:inline-flex;align-items:center;gap:6px;padding:11px 18px;background:#fff;color:#374151;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"><span class="material-icons" style="font-size:16px">restart_alt</span>Reset</button>
                    </div>
                    <#else>
                    <div style="font-size:12.5px;color:#6B7280">You have view-only access &mdash; changes are disabled.</div>
                    </#if>
                    <div id="disc-result" style="margin-top:12px;font-size:13px"></div>
                </section>

                <!-- ===== RIGHT: Current Rules ===== -->
                <section style="flex:1 1 320px;min-width:0;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:20px">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
                        <span class="z-icobadge primary"><span class="material-icons">description</span></span>
                        <div>
                            <div style="font-size:15px;font-weight:700;color:#111827">Current Rules</div>
                            <div style="font-size:12.5px;color:#6B7280">These settings are currently active for this store.</div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #F1F1F4">
                        <span class="z-icobadge primary"><span class="material-icons">percent</span></span>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:13px;font-weight:600;color:#111827">Discount limit</div>
                            <div style="font-size:11.5px;color:#9CA3AF">Without PIN</div>
                        </div>
                        <span class="zenith-badge primary nd">${limitChip!'—'}</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #F1F1F4">
                        <span class="z-icobadge orange"><span class="material-icons">vpn_key</span></span>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:13px;font-weight:600;color:#111827">Manager PIN</div>
                        </div>
                        <span class="zenith-badge ${pinChipClass!'warning'} nd">${pinDisplay!'Not set'}</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 0">
                        <span class="z-icobadge green"><span class="material-icons">currency_rupee</span></span>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:13px;font-weight:600;color:#111827">Round-off</div>
                        </div>
                        <span class="zenith-badge success nd">${roundChip!'Off'}</span>
                    </div>
                    <div style="display:flex;gap:10px;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:10px;padding:12px 14px;margin-top:14px">
                        <span class="material-icons" style="color:#2563EB;font-size:20px">info</span>
                        <div>
                            <div style="font-size:13px;font-weight:700;color:#1E40AF">How it works?</div>
                            <div style="font-size:12.5px;color:#1D4ED8;line-height:1.5">If the discount is within the set limit, no PIN is required. For higher discounts, a manager PIN is needed.</div>
                        </div>
                    </div>
                </section>
            </div>
            </#if>
        </div>

        <#if (hasOrg && (modCanWrite!false))>
        <script>
        (function(){
            function tok(){ try{ if(window.moqui&&window.moqui.webrootVue&&window.moqui.webrootVue.moquiSessionToken) return window.moqui.webrootVue.moquiSessionToken; }catch(e){} return ''; }
            var eye=document.getElementById('disc-eye'), pin=document.getElementById('disc-pin');
            if(eye&&pin) eye.addEventListener('click',function(){ pin.type = (pin.type==='password'?'text':'password'); var g=eye.querySelector('.material-icons'); if(g) g.textContent = (pin.type==='password'?'visibility':'visibility_off'); });
            var reset=document.getElementById('disc-reset'); if(reset) reset.addEventListener('click',function(){ location.reload(); });
            var save=document.getElementById('disc-save');
            if(save) save.addEventListener('click',function(){
                save.disabled=true; var o=save.innerHTML; save.textContent='Saving...';
                var body=new URLSearchParams({ discountLimitPct:(document.getElementById('disc-limit')||{}).value||'',
                    roundOffStep:(document.getElementById('disc-round')||{}).value||'0',
                    managerPin:(document.getElementById('disc-pin')||{}).value||'',
                    clearPin:(document.getElementById('disc-clear')&&document.getElementById('disc-clear').checked)?'Y':'',
                    moquiSessionToken:tok() });
                fetch('${appBase!''}/zenith/pos/DiscountSettings/saveDiscountSettings',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body,credentials:'same-origin'})
                    .then(function(){ location.reload(); })
                    .catch(function(){ save.disabled=false; save.innerHTML=o; var r=document.getElementById('disc-result'); if(r){ r.textContent='Save failed — please try again.'; r.style.color='#DC2626'; } });
            });
        })();
        </script>
        </#if>
        ]]></text></render-mode>
    </widgets>
</screen>
