<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Transactions" default-menu-index="3">

    <transition name="editTransaction"><default-response url="../EditTransaction"/></transition>
    <transition name="goDailySummary"><default-response url="../DailySummary"/></transition>
    <transition name="goReports"><default-response url="../Reports"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goPriceOverrides"><default-response url="../PriceOverrides"/></transition>

    <actions>
        <!-- ZE-SHOP: scope to the globally-selected shop's sessions (null = All Shops) -->
        <script>_shopSessions = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").parameter("includePosScope", true).call(); _shopSessions = _sc?.sessionIds } catch (Exception _e) {}</script>
        <entity-find entity-name="zenith.erp.pos.PosTransactionView" list="txnList">
            <search-form-inputs default-order-by="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="sessionId" operator="in" from="_shopSessions" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_transactions" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128203; Transactions &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">This is the record of <b>every bill</b> you have made &mdash; sales and returns.<br><b>1</b>&nbsp;Use the column filters (Date, Txn Number, Customer, Status) and press <b>Find</b> to locate a bill.<br><b>2</b>&nbsp;Click a bill&#39;s blue <b>ID</b> to open it and view or correct it.<br><b>3</b>&nbsp;Buttons at the top jump to Billing, Daily Summary or Reports. Use the <b>CSV</b> button to export the list.</div></details>]]></text></render-mode>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
            <link url="goReports" text="Reports" icon="fa fa-bar-chart" btn-type="warning" style="q-btn--dense"/>
            <link url="goPriceOverrides" text="Price Overrides" icon="fa fa-exchange" btn-type="danger" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container-box>
            <box-header title="All POS Transactions"/>
            <box-body>
                <form-list name="AllTxnList" list="txnList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <field name="transactionId"><default-field title="ID">
                        <link url="editTransaction" text="${transactionId}" link-type="anchor"
                              parameter-map="[transactionId:transactionId]"/></default-field></field>
                    <field name="transactionNumber"><header-field title="Txn Number" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="transactionType"><header-field title="Type">
                            <drop-down allow-empty="true"><option key="Sale"/><option key="Return"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="entryDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="terminalName"><header-field title="Terminal" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="customerName"><header-field title="Customer"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="subtotal"><default-field title="Subtotal"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalTaxAmount"><default-field title="Tax"><display format="#,##0.00"/></default-field></field>
                    <field name="grandTotal"><header-field title="Total" show-order-by="true"/>
                        <default-field><display format="#,##,##0.00"/></default-field></field>
                    <field name="payableAmount"><default-field title="Payable"><display format="#,##,##0.00"/></default-field></field>
                    <field name="statusId"><header-field title="Status">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="PosTransaction"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <!-- ZE-POS-004: a completed CREDIT (Pay Later) bill with an outstanding balance must not read
                             plain "Completed" (the sale is done but the receivable isn't). Show its credit status.
                             isCredit is cleared when fully settled, so this only tags genuinely-outstanding bills. -->
                        <conditional-field condition="statusId == 'PtCompleted' &amp;&amp; isCredit == 'Y' &amp;&amp; (payableAmount ?: 0) &gt; (paidAmount ?: 0)">
                            <display text="Credit — Due ${zinr.inr(ec.l10n.format((payableAmount ?: 0) - (paidAmount ?: 0), '#,##0.00'))}"/></conditional-field>
                        <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
