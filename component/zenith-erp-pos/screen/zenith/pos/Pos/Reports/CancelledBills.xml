<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cancelled Bills" default-menu-index="4">

    <transition name="viewTransaction"><default-response url="../../EditTransaction"/></transition>
    <transition name="goTransactions"><default-response url="../../PosTransactions"/></transition>
    <transition name="goDailySummary"><default-response url="../../DailySummary"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>

    <actions>
        <set field="fromDate" from="fromDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="thruDate" from="thruDate ?: fromDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(fromDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(thruDate + ' 23:59:59')"/>

        <entity-find entity-name="zenith.erp.pos.PosTransactionView" list="cancelledList">
            <econdition field-name="statusId" value="PtVoided"/>
            <econdition field-name="entryDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="entryDate" operator="less-equals" from="dayEnd"/>
            <order-by field-name="-entryDate"/>
        </entity-find>

        <script><![CDATA[
            cancelledTotal = cancelledList.sum { (it.payableAmount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            cancelledCount = cancelledList.size()
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
            <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container style="q-mb-md">
            <form-single name="CancelFilter" transition=".">
                <field name="fromDate"><default-field title="From">
                    <date-time type="date" default-value="${fromDate}"/>
                </default-field></field>
                <field name="thruDate"><default-field title="To">
                    <date-time type="date" default-value="${thruDate}"/>
                </default-field></field>
                <field name="searchBtn"><default-field title="">
                    <submit text="Search" icon="fa fa-search"/>
                </default-field></field>
            </form-single>
        </container>

        <container-row>
            <row-col lg="6" md="6" sm="6">
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center">
                    <label text="Cancelled Bills" style="text-grey-7 text-caption"/>
                    <label text="${cancelledCount}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                </container>
            </row-col>
            <row-col lg="6" md="6" sm="6">
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center">
                    <label text="Cancelled Amount" style="text-grey-7 text-caption"/>
                    <label text="${ec.l10n.format(cancelledTotal, '#,##0.00')}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                </container>
            </row-col>
        </container-row>

        <form-list name="CancelledList" list="cancelledList" list-entry="bill" skip-form="true"
                   show-csv-button="true" show-xlsx-button="true">
            <field name="transactionNumber"><default-field title="Bill No">
                <link url="viewTransaction" text="${bill.transactionNumber}" parameter-map="[transactionId:bill.transactionId]"
                      link-type="anchor"/>
            </default-field></field>
            <field name="entryDate"><default-field title="Date">
                <display format="dd-MM-yyyy HH:mm"/>
            </default-field></field>
            <field name="terminalName"><default-field title="Terminal">
                <display/>
            </default-field></field>
            <field name="subtotal"><default-field title="Subtotal">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="discountTotal"><default-field title="Discount">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="payableAmount"><default-field title="Amount">
                <display format="#,##0.00"/>
            </default-field></field>
        </form-list>
    </widgets>
</screen>
