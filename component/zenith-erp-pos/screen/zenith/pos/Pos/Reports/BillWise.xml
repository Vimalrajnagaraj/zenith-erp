<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bill Wise" default-menu-index="1">

    <transition name="viewTransaction">
        <default-response url="../../EditTransaction"/>
    </transition>
    <transition name="goDailySummary"><default-response url="../../DailySummary"/></transition>
    <transition name="goTransactions"><default-response url="../../PosTransactions"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goPriceOverrides"><default-response url="../../PriceOverrides"/></transition>

    <actions>
        <set field="fromDate" from="fromDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="thruDate" from="thruDate ?: fromDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(fromDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(thruDate + ' 23:59:59')"/>

        <entity-find entity-name="zenith.erp.pos.PosTransactionView" list="billList">
            <econdition field-name="entryDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="entryDate" operator="less-equals" from="dayEnd"/>
            <econdition field-name="statusId" from="statusId" ignore-if-empty="true"/>
            <order-by field-name="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <script><![CDATA[
            reportTotalSales = billList.findAll { it.statusId == 'PtCompleted' }.sum { (it.payableAmount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            reportTotalBills = billList.findAll { it.statusId == 'PtCompleted' }.size()
            reportTotalDiscount = billList.findAll { it.statusId == 'PtCompleted' }.sum { (it.discountTotal ?: 0) as BigDecimal } ?: BigDecimal.ZERO
        ]]></script>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <form-single name="BillFilter" transition=".">
                <field name="fromDate"><default-field title="From">
                    <date-time type="date" default-value="${fromDate}"/>
                </default-field></field>
                <field name="thruDate"><default-field title="To">
                    <date-time type="date" default-value="${thruDate}"/>
                </default-field></field>
                <field name="statusId"><default-field title="Status">
                    <drop-down allow-empty="true">
                        <option key="PtCompleted" text="Completed"/>
                        <option key="PtVoided" text="Voided"/>
                        <option key="PtCreated" text="Created"/>
                    </drop-down>
                </default-field></field>
                <field name="searchBtn"><default-field title="">
                    <submit text="Search" icon="fa fa-search"/>
                </default-field></field>
            </form-single>
        </container>

        <container style="row items-center justify-end q-mb-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
            <link url="goPriceOverrides" text="Price Overrides" icon="fa fa-exchange" btn-type="danger" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>

        <container-row>
            <row-col lg="4" md="4" sm="4">
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center">
                    <label text="Total Sales" style="text-grey-7 text-caption"/>
                    <label text="${ec.l10n.format(reportTotalSales, '#,##0.00')}" type="h5" style="text-weight-bold text-positive q-my-xs"/>
                </container>
            </row-col>
            <row-col lg="4" md="4" sm="4">
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center">
                    <label text="Bills" style="text-grey-7 text-caption"/>
                    <label text="${reportTotalBills}" type="h5" style="text-weight-bold text-primary q-my-xs"/>
                </container>
            </row-col>
            <row-col lg="4" md="4" sm="4">
                <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center">
                    <label text="Total Discount" style="text-grey-7 text-caption"/>
                    <label text="${ec.l10n.format(reportTotalDiscount, '#,##0.00')}" type="h5" style="text-weight-bold text-orange-7 q-my-xs"/>
                </container>
            </row-col>
        </container-row>

        <form-list name="BillWiseList" list="billList" list-entry="bill" skip-form="true"
                   show-csv-button="true" show-xlsx-button="true">
            <field name="transactionNumber"><default-field title="Bill No">
                <link url="viewTransaction" text="${bill.transactionNumber}" parameter-map="[transactionId:bill.transactionId]"
                      link-type="anchor"/>
            </default-field></field>
            <field name="entryDate"><default-field title="Date">
                <display format="dd-MM-yyyy HH:mm"/>
            </default-field></field>
            <field name="terminalName"><default-field title="Terminal">
                <display/>
            </default-field></field>
            <field name="customerName"><default-field title="Customer">
                <display default-text="-"/>
            </default-field></field>
            <field name="subtotal"><default-field title="Subtotal">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="discountTotal"><default-field title="Discount">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="totalTaxAmount"><default-field title="Tax">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="payableAmount"><default-field title="Net Amount">
                <display format="#,##0.00"/>
            </default-field></field>
            <field name="statusId"><default-field title="Status">
                <display-entity entity-name="moqui.basic.StatusItem"/>
            </default-field></field>
        </form-list>
    </widgets>
</screen>
