<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cash Entry" default-menu-index="9">

    <!-- ZE-POS-008: the auto create#PosCashEntry accepted an empty/zero/negative Amount (entity field is
         not required) -> invalid cash-movement rows corrupting reconciliation. Validate before saving. -->
    <transition name="addCashIn">
        <actions>
            <script><![CDATA[amtVal = null; try { amtVal = amount ? new BigDecimal(amount.toString().trim()) : null } catch (Exception e) { amtVal = null }]]></script>
            <if condition="amtVal == null || amtVal &lt;= 0">
                <return error="true" message="Enter a valid Amount greater than 0 — the cash entry was not saved."/></if>
            <service-call name="create#zenith.erp.pos.PosCashEntry" in-map="context + [entryType:'CashIn', amount:amtVal, organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="addCashOut">
        <actions>
            <script><![CDATA[amtVal = null; try { amtVal = amount ? new BigDecimal(amount.toString().trim()) : null } catch (Exception e) { amtVal = null }]]></script>
            <if condition="amtVal == null || amtVal &lt;= 0">
                <return error="true" message="Enter a valid Amount greater than 0 — the cash entry was not saved."/></if>
            <service-call name="create#zenith.erp.pos.PosCashEntry" in-map="context + [entryType:'CashOut', amount:amtVal, organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="deleteCashEntry"><service-call name="delete#zenith.erp.pos.PosCashEntry"/>
        <default-response url="."/></transition>
    <transition name="goExpenses"><default-response url="../Expenses"/></transition>
    <transition name="goSessions"><default-response url="../PosSessions"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goDailySummary"><default-response url="../DailySummary"/></transition>

    <actions>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="filterThruDate" from="filterThruDate ?: filterDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(filterDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(filterThruDate + ' 23:59:59')"/>

        <entity-find entity-name="moqui.basic.Enumeration" list="reasonList">
            <econdition field-name="enumTypeId" value="PosCashReason"/>
            <order-by field-name="description"/>
        </entity-find>

        <!-- ZE-SHOP: scope cash entries to the selected shop's sessions (null = All Shops) -->
        <script>_shopSessions = null; try { def _sc = ec.service.sync().name("zenith.base.ShopServices.get#ActiveShopScope").parameter("includePosScope", true).call(); _shopSessions = _sc?.sessionIds } catch (Exception _e) {}</script>
        <entity-find entity-name="zenith.erp.pos.PosCashEntryView" list="cashEntryList">
            <econdition field-name="entryDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="entryDate" operator="less-equals" from="dayEnd"/>
            <econdition field-name="entryType" from="filterType" ignore-if-empty="true"/>
            <order-by field-name="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="sessionId" operator="in" from="_shopSessions" ignore-if-empty="true"/><!-- ZE-SHOP -->
        </entity-find>

        <script><![CDATA[
            totalCashIn = cashEntryList.findAll { it.entryType == 'CashIn' }.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            totalCashOut = cashEntryList.findAll { it.entryType == 'CashOut' }.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            netCash = totalCashIn - totalCashOut
            cashInCount = cashEntryList.findAll { it.entryType == 'CashIn' }.size()
            cashOutCount = cashEntryList.findAll { it.entryType == 'CashOut' }.size()
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_cashentry" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128181; Cash Entry &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Record cash moving in or out of the drawer that is <b>not a sale</b>.<br><b>1</b>&nbsp;<b>Cash In</b> (left) &mdash; money added, e.g. a change fund or owner deposit.<br><b>2</b>&nbsp;<b>Cash Out</b> (right) &mdash; money taken out, e.g. a bank deposit or petty cash.<br><b>3</b>&nbsp;Pick a reason, enter the amount and press <b>Add</b>. Totals and <b>Net Cash</b> update below.</div></details>]]></text></render-mode>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-md q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
                <link url="goExpenses" text="Expenses" icon="fa fa-money" btn-type="warning" style="q-btn--dense"/>
                <link url="goSessions" text="Sessions" icon="fa fa-clock-o" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container-row>
                <row-col lg="6" md="6" sm="12">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <label text="Cash In" type="h6" style="text-weight-bold text-positive q-mb-sm"/>
                        <form-single name="CashInForm" transition="addCashIn">
                            <field name="entryDate"><default-field title="Date">
                                <date-time type="date-time" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')}"/>
                            </default-field></field>
                            <field name="amount"><default-field title="Amount">
                                <text-line size="15" input-type="number"/>
                            </default-field></field>
                            <field name="reason"><default-field title="Reason">
                                <drop-down>
                                    <option key="CeDeposit" text="Owner/Partner Deposit"/>
                                    <option key="CeAdvance" text="Customer Advance"/>
                                    <option key="CeChange" text="Change Fund"/>
                                    <option key="CeOther" text="Other"/>
                                </drop-down>
                            </default-field></field>
                            <field name="description"><default-field title="Notes">
                                <text-line size="30"/>
                            </default-field></field>
                            <field name="referenceNumber"><default-field title="Ref No.">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="enteredByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                            <field name="submitBtn">
                                <conditional-field name="cashin_save_write" condition="modCanWrite" title="">
                                    <submit text="Add Cash In" icon="fa fa-plus" type="success"/>
                                </conditional-field>
                                <default-field title="">
                                    <label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/>
                                </default-field></field>
                        </form-single>
                    </container>
                </row-col>
                <row-col lg="6" md="6" sm="12">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <label text="Cash Out" type="h6" style="text-weight-bold text-negative q-mb-sm"/>
                        <form-single name="CashOutForm" transition="addCashOut">
                            <field name="entryDate"><default-field title="Date">
                                <date-time type="date-time" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')}"/>
                            </default-field></field>
                            <field name="amount"><default-field title="Amount">
                                <text-line size="15" input-type="number"/>
                            </default-field></field>
                            <field name="reason"><default-field title="Reason">
                                <drop-down>
                                    <option key="CeBankDeposit" text="Bank Deposit"/>
                                    <option key="CeWithdrawal" text="Owner/Partner Withdrawal"/>
                                    <option key="CePettyCash" text="Petty Cash"/>
                                    <option key="CeRefund" text="Customer Refund"/>
                                    <option key="CeOther" text="Other"/>
                                </drop-down>
                            </default-field></field>
                            <field name="description"><default-field title="Notes">
                                <text-line size="30"/>
                            </default-field></field>
                            <field name="referenceNumber"><default-field title="Ref No.">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="enteredByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                            <field name="submitBtn">
                                <conditional-field name="cashout_save_write" condition="modCanWrite" title="">
                                    <submit text="Add Cash Out" icon="fa fa-minus" type="danger"/>
                                </conditional-field>
                                <default-field title="">
                                    <label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/>
                                </default-field></field>
                        </form-single>
                    </container>
                </row-col>
            </container-row>

            <container-row>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Cash In" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(totalCashIn, '#,##0.00'))}" type="h5" style="text-weight-bold text-positive q-my-xs"/>
                        <label text="${cashInCount} entries" style="text-grey-6 text-caption"/>
                    </container>
                </row-col>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Cash Out" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(totalCashOut, '#,##0.00'))}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                        <label text="${cashOutCount} entries" style="text-grey-6 text-caption"/>
                    </container>
                </row-col>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Net Cash" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(netCash, '#,##0.00'))}" type="h5" style="text-weight-bold ${netCash >= 0 ? 'text-positive' : 'text-negative'} q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <container style="q-mb-md">
                <form-single name="CashFilter" transition=".">
                    <field name="filterDate"><default-field title="From">
                        <date-time type="date" default-value="${filterDate}"/>
                    </default-field></field>
                    <field name="filterThruDate"><default-field title="To">
                        <date-time type="date" default-value="${filterThruDate}"/>
                    </default-field></field>
                    <field name="filterType"><default-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="CashIn" text="Cash In"/>
                            <option key="CashOut" text="Cash Out"/>
                        </drop-down>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <form-list name="CashEntryList" list="cashEntryList" list-entry="ce" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="entryDate"><default-field title="Date">
                    <display format="dd-MM-yyyy HH:mm"/>
                </default-field></field>
                <field name="entryType"><default-field title="Type">
                    <display/>
                </default-field></field>
                <field name="amount"><default-field title="Amount">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="reason"><default-field title="Reason">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="description"><default-field title="Notes">
                    <display default-text="-"/>
                </default-field></field>
                <field name="referenceNumber"><default-field title="Ref No.">
                    <display default-text="-"/>
                </default-field></field>
                <field name="enteredBy"><default-field title="By">
                    <display text="${ce.firstName ?: ''} ${ce.lastName ?: ''}"/>
                </default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="cashdel_write" condition="modCanWrite" title="">
                    <link url="deleteCashEntry" text="" icon="fa fa-trash" btn-type="danger"
                          parameter-map="[cashEntryId:ce.cashEntryId]"
                          confirmation="Delete this cash entry?"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
