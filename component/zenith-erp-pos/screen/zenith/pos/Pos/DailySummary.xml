<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Daily Summary" default-menu-index="4">

    <transition name="goReports"><default-response url="../Reports"/></transition>
    <transition name="goExpenses"><default-response url="../Expenses"/></transition>
    <transition name="goCashEntry"><default-response url="../CashEntry"/></transition>
    <transition name="editTransaction"><default-response url="../EditTransaction"/></transition>

    <actions>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(filterDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(filterDate + ' 23:59:59')"/>

        <entity-find entity-name="zenith.erp.pos.PosTransaction" list="completedTxns">
            <econdition field-name="statusId" value="PtCompleted"/>
            <econdition field-name="entryDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="entryDate" operator="less-equals" from="dayEnd"/>
            <order-by field-name="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="(ec.user.getPreference('ACTIVE_ORGANIZATION')) ?: '__NO_ORGANIZATION__'"/>
        </entity-find>

        <script><![CDATA[
            totalSales = BigDecimal.ZERO
            totalReturns = BigDecimal.ZERO
            totalTax = BigDecimal.ZERO
            totalDiscount = BigDecimal.ZERO
            saleCount = 0
            returnCount = 0

            completedTxns.each { t ->
                if (t.transactionType == 'Return') {
                    totalReturns += (t.grandTotal ?: 0) as BigDecimal
                    returnCount++
                } else {
                    totalSales += (t.grandTotal ?: 0) as BigDecimal
                    saleCount++
                }
                totalTax += (t.totalTaxAmount ?: 0) as BigDecimal
                totalDiscount += (t.discountTotal ?: 0) as BigDecimal
            }
            netSales = totalSales - totalReturns
            avgTicket = saleCount > 0 ? (totalSales / saleCount) : BigDecimal.ZERO

            payMethodTotals = new LinkedHashMap()
            completedTxns.each { t ->
                def payments = ec.entity.find("zenith.erp.pos.PosPayment")
                    .condition("transactionId", t.transactionId).list()
                payments.each { p ->
                    def method = p.paymentMethod ?: "Other"
                    payMethodTotals[method] = (payMethodTotals[method] ?: BigDecimal.ZERO) + ((p.amount ?: 0) as BigDecimal)
                }
            }
            paymentBreakdown = payMethodTotals.collect { k, v -> [method:k, amount:v] }

            // Hourly breakdown
            hourlyMap = new LinkedHashMap()
            (8..22).each { h -> hourlyMap[h] = [hour:h, label:"${String.format('%02d', h)}:00", count:0, amount:BigDecimal.ZERO] }
            completedTxns.each { t ->
                if (t.entryDate && t.transactionType != 'Return') {
                    def cal = java.util.Calendar.getInstance()
                    cal.setTime(t.entryDate)
                    def h = cal.get(java.util.Calendar.HOUR_OF_DAY)
                    if (hourlyMap.containsKey(h)) {
                        hourlyMap[h].count++
                        hourlyMap[h].amount += (t.grandTotal ?: 0) as BigDecimal
                    }
                }
            }
            hourlyData = hourlyMap.values().findAll { it.count > 0 }
        ]]></script>
    </actions>

    <widgets>
        <container style="pos-reference-daily-page q-pa-md">
            <container style="pos-reference-daily-header">
                <label text="Daily Summary" type="h6" style="text-weight-bold"/>
                <form-single name="DateFilter" transition=".">
                    <field name="filterDate"><default-field title="Date">
                        <date-time type="date" default-value="${filterDate}"/>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="View" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <!-- KPI Cards -->
            <container-row>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Sales" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(totalSales, '#,##0.00'))}" type="h5" style="text-weight-bold text-positive q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Returns" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(totalReturns, '#,##0.00'))}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Net Sales" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(netSales, '#,##0.00'))}" type="h5" style="text-weight-bold text-primary q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Tax Collected" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(totalTax, '#,##0.00'))}" type="h5" style="text-weight-bold text-orange-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Transactions" style="text-grey-7 text-caption"/>
                        <label text="${saleCount + returnCount}" type="h5" style="text-weight-bold text-blue-8 q-my-xs"/>
                        <label text="${saleCount} sales, ${returnCount} returns" style="text-grey-6 text-caption"/>
                    </container>
                </row-col>
                <row-col lg="2" md="4" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Avg. Ticket" style="text-grey-7 text-caption"/>
                        <label text="${zinr.inr(ec.l10n.format(avgTicket, '#,##0.00'))}" type="h5" style="text-weight-bold text-purple-8 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <container-row>
                <row-col lg="4" md="6" sm="12">
                    <label text="Payment Breakdown" type="h6" style="text-weight-bold q-mb-sm"/>
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <form-list name="PayMethodList" list="paymentBreakdown" skip-form="true">
                            <field name="method"><default-field title="Payment Method">
                                <display/>
                            </default-field></field>
                            <field name="amount"><default-field title="Amount">
                                <display format="#,##0.00"/>
                            </default-field></field>
                        </form-list>
                        <label text="No payments recorded" condition="!paymentBreakdown" style="text-grey-6 q-pa-md text-center"/>
                    </container>
                </row-col>

                <row-col lg="8" md="6" sm="12">
                    <label text="Hourly Sales" type="h6" style="text-weight-bold q-mb-sm"/>
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <form-list name="HourlySalesList" list="hourlyData" skip-form="true">
                            <field name="label"><default-field title="Hour">
                                <display/>
                            </default-field></field>
                            <field name="count"><default-field title="Transactions">
                                <display/>
                            </default-field></field>
                            <field name="amount"><default-field title="Amount">
                                <display format="#,##0.00"/>
                            </default-field></field>
                        </form-list>
                        <label text="No sales this day" condition="!hourlyData" style="text-grey-6 q-pa-md text-center"/>
                    </container>
                </row-col>
            </container-row>

            <container style="row items-center justify-between q-mb-sm">
                <label text="Transactions" type="h6" style="text-weight-bold"/>
                <container style="row q-gutter-sm">
                    <link url="goReports" text="Full Reports" icon="fa fa-bar-chart" btn-type="info" style="q-btn--dense"/>
                    <link url="goExpenses" text="Expenses" icon="fa fa-money" btn-type="warning" style="q-btn--dense"/>
                    <link url="goCashEntry" text="Cash Entry" icon="fa fa-exchange" btn-type="success" style="q-btn--dense"/>
                </container>
            </container>
            <form-list name="CompletedTxnList" list="completedTxns" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="transactionNumber"><default-field title="Txn #">
                    <link url="editTransaction" text="${transactionNumber}" parameter-map="[transactionId:transactionId]" link-type="anchor"/>
                </default-field></field>
                <field name="transactionType"><default-field title="Type">
                    <display/>
                </default-field></field>
                <field name="entryDate"><default-field title="Time">
                    <display format="HH:mm"/>
                </default-field></field>
                <field name="customerName"><default-field title="Customer">
                    <display default-text="Walk-in"/>
                </default-field></field>
                <field name="subtotal"><default-field title="Subtotal">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="totalTaxAmount"><default-field title="Tax">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="discountTotal"><default-field title="Discount">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="grandTotal"><default-field title="Total">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
