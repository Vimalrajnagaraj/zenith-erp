<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Categories" default-menu-index="2">

    <transition name="createCategory"><service-call name="create#zenith.erp.pos.PosExpenseCategory"/>
        <default-response url="."/></transition>
    <transition name="updateCategory"><service-call name="update#zenith.erp.pos.PosExpenseCategory"/>
        <default-response url="."/></transition>
    <transition name="goCashEntry"><default-response url="../../CashEntry"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosExpenseCategory" list="categoryList">
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goCashEntry" text="Cash Entry" icon="fa fa-exchange" btn-type="info" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <section name="AddCategory_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <label text="Add Category" type="h6" style="text-weight-bold q-mb-md"/>
            <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-lg border-radius-lg">
                <form-single name="AddCategory" transition="createCategory">
                    <field name="categoryId"><default-field title="Category ID">
                        <text-line size="20"/>
                    </default-field></field>
                    <field name="categoryName"><default-field title="Name">
                        <text-line size="30"/>
                    </default-field></field>
                    <field name="description"><default-field title="Description">
                        <text-line size="50"/>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Add Category" icon="fa fa-plus"/>
                    </default-field></field>
                </form-single>
            </container>
            </widgets></section>

            <label text="Expense Categories" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="CategoryList" list="categoryList" list-entry="cat" transition="updateCategory">
                <field name="categoryId"><default-field title="ID">
                    <display/>
                </default-field></field>
                <field name="categoryName">
                    <conditional-field name="catname_write" condition="modCanWrite" title="Name">
                        <text-line size="25"/>
                    </conditional-field>
                    <default-field title="Name"><display/></default-field>
                </field>
                <field name="description">
                    <conditional-field name="catdesc_write" condition="modCanWrite" title="Description">
                        <text-line size="40"/>
                    </conditional-field>
                    <default-field title="Description"><display/></default-field>
                </field>
                <field name="isActive">
                    <conditional-field name="catactive_write" condition="modCanWrite" title="Active">
                        <drop-down>
                            <option key="Y" text="Yes"/>
                            <option key="N" text="No"/>
                        </drop-down>
                    </conditional-field>
                    <default-field title="Active"><display/></default-field>
                </field>
                <field name="submitBtn">
                    <conditional-field name="catupd_write" condition="modCanWrite" title="">
                        <submit text="Update" icon="fa fa-save"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
