<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Summary" default-menu-index="3">

    <transition name="goCashEntry"><default-response url="../../CashEntry"/></transition>
    <transition name="goDailySummary"><default-response url="../../DailySummary"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <set field="fromDate" from="fromDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="thruDate" from="thruDate ?: fromDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(fromDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(thruDate + ' 23:59:59')"/>

        <script><![CDATA[
            def expenses = ec.entity.find("zenith.erp.pos.PosExpenseView")
                .condition("expenseDate", "greater-equals", dayStart)
                .condition("expenseDate", "less-equals", dayEnd).list()

            categorySummary = []
            grandTotal = BigDecimal.ZERO
            totalEntries = 0

            if (expenses) {
                def catMap = new LinkedHashMap()
                expenses.each { e ->
                    def catId = e.categoryId ?: 'Uncategorized'
                    def catName = e.categoryName ?: 'Uncategorized'
                    if (!catMap[catId]) {
                        catMap[catId] = [categoryName: catName, totalAmount: BigDecimal.ZERO,
                            entryCount: 0 as int, cashAmount: BigDecimal.ZERO, otherAmount: BigDecimal.ZERO]
                    }
                    def amt = (e.amount ?: 0) as BigDecimal
                    catMap[catId].totalAmount += amt
                    catMap[catId].entryCount++
                    if (e.paymentMethod == 'Cash') catMap[catId].cashAmount += amt
                    else catMap[catId].otherAmount += amt
                }
                categorySummary = catMap.values().sort { -(it.totalAmount as BigDecimal) }
                grandTotal = categorySummary.sum { it.totalAmount } ?: BigDecimal.ZERO
                totalEntries = categorySummary.sum { it.entryCount } ?: 0
            }

            paymentSummary = []
            if (expenses) {
                def pmMap = new LinkedHashMap()
                expenses.each { e ->
                    def pm = e.paymentMethod ?: 'Other'
                    if (!pmMap[pm]) pmMap[pm] = [paymentMethod: pm, totalAmount: BigDecimal.ZERO, entryCount: 0 as int]
                    pmMap[pm].totalAmount += (e.amount ?: 0) as BigDecimal
                    pmMap[pm].entryCount++
                }
                paymentSummary = pmMap.values().sort { -(it.totalAmount as BigDecimal) }
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
                <link url="goCashEntry" text="Cash Entry" icon="fa fa-exchange" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container style="q-mb-md">
                <form-single name="SummaryFilter" transition=".">
                    <field name="fromDate"><default-field title="From">
                        <date-time type="date" default-value="${fromDate}"/>
                    </default-field></field>
                    <field name="thruDate"><default-field title="To">
                        <date-time type="date" default-value="${thruDate}"/>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <container-row>
                <row-col lg="6" md="6" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Expenses" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(grandTotal, '#,##0.00')}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="6" md="6" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Entries" style="text-grey-7 text-caption"/>
                        <label text="${totalEntries}" type="h5" style="text-weight-bold text-primary q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <label text="Category Wise" type="h6" style="text-weight-bold q-mb-sm"/>
            <form-list name="CategorySummaryList" list="categorySummary" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="categoryName"><default-field title="Category">
                    <display/>
                </default-field></field>
                <field name="entryCount"><default-field title="Entries">
                    <display/>
                </default-field></field>
                <field name="cashAmount"><default-field title="Cash">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="otherAmount"><default-field title="Non-Cash">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="totalAmount"><default-field title="Total">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>

            <label text="Payment Mode Wise" type="h6" style="text-weight-bold q-mt-lg q-mb-sm"/>
            <form-list name="PaymentSummaryList" list="paymentSummary" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="paymentMethod"><default-field title="Payment Mode">
                    <display/>
                </default-field></field>
                <field name="entryCount"><default-field title="Entries">
                    <display/>
                </default-field></field>
                <field name="totalAmount"><default-field title="Amount">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
