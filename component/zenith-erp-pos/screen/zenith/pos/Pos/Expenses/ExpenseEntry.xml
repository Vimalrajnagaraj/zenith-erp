<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Expense Entry" default-menu-index="1">

    <!-- ZE-POS-008 class: the bare auto create#PosExpense accepted an empty/zero/negative Amount. -->
    <transition name="createExpense">
        <actions>
            <script><![CDATA[amtVal = null; try { amtVal = amount ? new BigDecimal(amount.toString().trim()) : null } catch (Exception e) { amtVal = null }]]></script>
            <if condition="amtVal == null || amtVal &lt;= 0">
                <return error="true" message="Enter a valid Amount greater than 0 — the expense was not saved."/></if>
            <service-call name="create#zenith.erp.pos.PosExpense" in-map="context + [amount:amtVal, organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="deleteExpense"><service-call name="delete#zenith.erp.pos.PosExpense"/>
        <default-response url="."/></transition>
    <transition name="goCashEntry"><default-response url="../../CashEntry"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goDailySummary"><default-response url="../../DailySummary"/></transition>

    <actions>
        <set field="filterDate" from="filterDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="filterThruDate" from="filterThruDate ?: filterDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(filterDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(filterThruDate + ' 23:59:59')"/>

        <entity-find entity-name="zenith.erp.pos.PosExpenseCategory" list="categoryList">
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="categoryName"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.pos.PosExpenseView" list="expenseList">
            <econdition field-name="expenseDate" operator="greater-equals" from="dayStart"/>
            <econdition field-name="expenseDate" operator="less-equals" from="dayEnd"/>
            <econdition field-name="categoryId" from="filterCategoryId" ignore-if-empty="true"/>
            <order-by field-name="-expenseDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <script><![CDATA[
            totalExpenses = expenseList.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            cashExpenses = expenseList.findAll { it.paymentMethod == 'Cash' }.sum { (it.amount ?: 0) as BigDecimal } ?: BigDecimal.ZERO
            otherExpenses = totalExpenses - cashExpenses
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-md q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
                <link url="goCashEntry" text="Cash Entry" icon="fa fa-exchange" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <section name="AddExpense_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <label text="Add New Expense" type="h6" style="text-weight-bold q-mb-md"/>
            <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-lg border-radius-lg">
                <form-single name="AddExpense" transition="createExpense">
                    <field name="expenseDate"><default-field title="Date">
                        <date-time type="date-time" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')}"/>
                    </default-field></field>
                    <field name="categoryId"><default-field title="Category">
                        <drop-down>
                            <list-options list="categoryList" key="${categoryId}" text="${categoryName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="amount"><default-field title="Amount">
                        <text-line size="15" input-type="number"/>
                    </default-field></field>
                    <field name="description"><default-field title="Description">
                        <text-line size="40"/>
                    </default-field></field>
                    <field name="paymentMethod"><default-field title="Payment Mode">
                        <drop-down>
                            <option key="Cash" text="Cash"/>
                            <option key="UPI" text="UPI"/>
                            <option key="Card" text="Card"/>
                            <option key="BankTransfer" text="Bank Transfer"/>
                        </drop-down>
                    </default-field></field>
                    <field name="referenceNumber"><default-field title="Reference No.">
                        <text-line size="20"/>
                    </default-field></field>
                    <field name="enteredByPartyId"><default-field><hidden default-value="${ec.user.userAccount?.partyId}"/></default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Save Expense" icon="fa fa-plus"/>
                    </default-field></field>
                </form-single>
            </container>
            </widgets></section>

            <label text="Expense List" type="h6" style="text-weight-bold q-mb-md"/>

            <container style="q-mb-md">
                <form-single name="ExpenseFilter" transition=".">
                    <field name="filterDate"><default-field title="From">
                        <date-time type="date" default-value="${filterDate}"/>
                    </default-field></field>
                    <field name="filterThruDate"><default-field title="To">
                        <date-time type="date" default-value="${filterThruDate}"/>
                    </default-field></field>
                    <field name="filterCategoryId"><default-field title="Category">
                        <drop-down allow-empty="true">
                            <list-options list="categoryList" key="${categoryId}" text="${categoryName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <container-row>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Expenses" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(totalExpenses, '#,##0.00')}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Cash Expenses" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(cashExpenses, '#,##0.00')}" type="h5" style="text-weight-bold text-orange-7 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="4" md="4" sm="4">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Other Payments" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(otherExpenses, '#,##0.00')}" type="h5" style="text-weight-bold text-blue-7 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <form-list name="ExpenseListForm" list="expenseList" list-entry="exp" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="expenseDate"><default-field title="Date">
                    <display format="dd-MM-yyyy HH:mm"/>
                </default-field></field>
                <field name="categoryName"><default-field title="Category">
                    <display/>
                </default-field></field>
                <field name="description"><default-field title="Description">
                    <display default-text="-"/>
                </default-field></field>
                <field name="amount"><default-field title="Amount">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="paymentMethod"><default-field title="Payment">
                    <display/>
                </default-field></field>
                <field name="referenceNumber"><default-field title="Ref No.">
                    <display default-text="-"/>
                </default-field></field>
                <field name="enteredBy"><default-field title="Entered By">
                    <display text="${exp.firstName ?: ''} ${exp.lastName ?: ''}"/>
                </default-field></field>
                <field name="deleteBtn">
                    <conditional-field name="exp_del_write" condition="modCanWrite" title="">
                        <link url="deleteExpense" text="" icon="fa fa-trash" btn-type="danger"
                              parameter-map="[expenseId:exp.expenseId]"
                              confirmation="Delete this expense entry?"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
