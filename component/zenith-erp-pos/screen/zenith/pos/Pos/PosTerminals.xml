<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Terminals" default-menu-index="5">

    <transition name="createTerminal" begin-transaction="true">
        <actions>
            <!-- ZE-POS-TERM-VIS: a terminal saved with a null/other organizationPartyId is filtered out of every
                 org-scoped read (ZTF_POSTERMINAL MANTLE_ACTIVE_ORG filter) => "created but not visible". The form's
                 org field was optional, so leaving it blank created a null-org (invisible) terminal. Force the
                 caller's ACTIVE_ORGANIZATION for tenant users (ignore any submitted org => also blocks forging
                 another tenant's org); a super-admin with no active org keeps the org they picked. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao &amp;&amp; _ao != '_NA_' &amp;&amp; !ec.user.isInGroup('ADMIN')">
                <set field="organizationPartyId" from="_ao"/>
            </if>
            <service-call name="create#zenith.erp.pos.PosTerminal" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateTerminal" begin-transaction="true">
        <actions>
            <!-- ZE-POS-TERM-VIS: don't let an edit blank/re-point the org (would make the terminal vanish or
                 cross-tenant). Re-stamp the caller's org for tenant users. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao &amp;&amp; _ao != '_NA_' &amp;&amp; !ec.user.isInGroup('ADMIN')">
                <set field="organizationPartyId" from="_ao"/>
            </if>
            <service-call name="update#zenith.erp.pos.PosTerminal" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="goSalesMode"><default-response url="../SalesMode"/></transition>
    <transition name="goSessions"><default-response url="../PosSessions"/></transition>
    <transition name="goReceipts"><default-response url="../ReceiptConfig"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="hasActiveOrg" from="activeOrgId != null &amp;&amp; activeOrgId != '_NA_'"/>
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="terminalList">
            <!-- ZE-POS-TERM-VIS: explicit org scope (belt-and-suspenders with ZTF_POSTERMINAL). -->
            <econdition field-name="organizationPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <order-by field-name="terminalName"/>
        </entity-find>
        <!-- ZE-SHOP: facilities a terminal may bind to — this org's stores/warehouses (a no-org super-admin sees all). -->
        <entity-find entity-name="mantle.facility.Facility" list="orgFacilities">
            <econdition field-name="facilityTypeEnumId" operator="in" value="FcTpWarehouse,FcTpStore,FcTpRetailStore"/>
            <econdition field-name="ownerPartyId" from="hasActiveOrg ? activeOrgId : null" ignore-if-empty="true"/>
            <order-by field-name="facilityName"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_terminals" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128421; Terminals &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Each billing counter / till is a <b>terminal</b>.<br><b>1</b>&nbsp;<b>Add Terminal</b> for every device that bills, and mark it active.<br><b>2</b>&nbsp;Sessions and sales are tracked separately for each terminal.</div></details>]]></text></render-mode>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goSalesMode" text="Sales Modes" icon="fa fa-tags" btn-type="warning" style="q-btn--dense"/>
            <link url="goReceipts" text="Receipts" icon="fa fa-file-text-o" btn-type="info" style="q-btn--dense"/>
            <link url="goSessions" text="Sessions" icon="fa fa-clock-o" btn-type="primary" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container-box>
            <box-header title="POS Terminals"/>
            <box-toolbar>
                <section name="CreateTerminal_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateTerminalDialog" button-text="Add Terminal">
                    <form-single name="CreateTerminalForm" transition="createTerminal">
                        <field name="terminalId"><default-field title="Terminal ID"><text-line size="15"/></default-field></field>
                        <field name="terminalName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="facilityId"><default-field title="Store/Facility">
                            <drop-down allow-empty="true"><list-options list="orgFacilities" key="${facilityId}" text="${facilityName}"/></drop-down></default-field></field>
                        <!-- ZE-POS-TERM-VIS: a tenant user's terminal is auto-stamped with their own org (hidden), so it
                             can never be saved null-org (invisible) and the cross-tenant org list isn't leaked. Only a
                             super-admin with no active org sees the org picker (to create a terminal for a tenant). -->
                        <field name="organizationPartyId">
                            <conditional-field name="term_org_auto" condition="hasActiveOrg"><hidden default-value="${activeOrgId}"/></conditional-field>
                            <default-field title="Organization">
                                <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName}">
                                    <entity-find entity-name="mantle.party.Organization"/>
                                </entity-options></drop-down></default-field></field>
                        <field name="stateCode"><default-field title="State Code (GST)"><text-line size="5"/></default-field></field>
                        <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="20"/></default-field></field>
                        <field name="upiVpa"><default-field title="UPI VPA"><text-line size="30"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="TerminalList" list="terminalList" transition="updateTerminal">
                    <field name="terminalId"><default-field title="ID"><display/></default-field></field>
                    <field name="terminalName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="facilityId"><default-field title="Facility">
                        <drop-down allow-empty="true"><list-options list="orgFacilities" key="${facilityId}" text="${facilityName}"/></drop-down></default-field></field>
                    <field name="stateCode"><default-field title="State"><text-line size="4"/></default-field></field>
                    <field name="taxRegistrationNumber"><default-field title="GSTIN"><text-line size="18"/></default-field></field>
                    <field name="upiVpa"><default-field title="UPI VPA"><text-line size="20"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="term_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
