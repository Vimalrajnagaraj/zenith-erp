<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Stock" default-menu-index="2">

    <transition name="goImport"><default-response url="../../ProductImport"/></transition>
    <transition name="goWastage"><default-response url="../../Wastage"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.inventory.ProductStockView" list="stockList">
            <econdition field-name="productTypeEnumId" value="PtAsset"/>
            <econdition field-name="productName" operator="like" value="%${searchText}%" ignore-if-empty="true" ignore-case="true"/>
            <econdition field-name="pseudoId" operator="like" value="%${searchSku}%" ignore-if-empty="true" ignore-case="true"/>
            <order-by field-name="productName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goImport" text="Import" icon="fa fa-upload" btn-type="primary" style="q-btn--dense"/>
                <link url="goWastage" text="Wastage" icon="fa fa-trash" btn-type="danger" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container style="q-mb-md">
                <form-single name="StockSearch" transition=".">
                    <field name="searchText"><default-field title="Product Name">
                        <text-line size="30" default-value="${searchText ?: ''}"/>
                    </default-field></field>
                    <field name="searchSku"><default-field title="SKU">
                        <text-line size="20" default-value="${searchSku ?: ''}"/>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <form-list name="FullStockList" list="stockList" list-entry="s" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="pseudoId"><default-field title="SKU">
                    <display/>
                </default-field></field>
                <field name="productName"><default-field title="Product">
                    <display/>
                </default-field></field>
                <field name="totalQoh"><default-field title="On Hand">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="totalAtp"><default-field title="Available">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="reorderPoint"><default-field title="Reorder Pt">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="mrpAmount"><default-field title="MRP">
                    <display format="#,##0.00"/>
                </default-field></field>
                <field name="stockStatus"><default-field title="Status">
                    <display text="${(s.totalQoh ?: 0) &lt;= 0 ? 'OUT' : ((s.reorderPoint ?: 0) &gt; 0 &amp;&amp; (s.totalQoh ?: 0) &lt;= (s.reorderPoint ?: 0) ? 'LOW' : 'OK')}"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
