<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Alerts" default-menu-index="1">

    <transition name="goImport"><default-response url="../../ProductImport"/></transition>
    <transition name="goWastage"><default-response url="../../Wastage"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>

    <actions>
        <script><![CDATA[
            // ZE-SALES-014 f/u: org-isolate the CSV/XLSX export (standalone render skips the authz filter)
            def _org = ec.user.getPreference("ACTIVE_ORGANIZATION")
            def _prodFind = ec.entity.find("zenith.erp.inventory.ProductStockView")
                .condition("productTypeEnumId", "PtAsset")
            if (_org) _prodFind.condition("ownerPartyId", _org)
            def allProducts = _prodFind.list()

            totalProducts = allProducts.size()
            totalStockValue = BigDecimal.ZERO

            zeroStockList = []
            lowStockList = []

            allProducts.each { p ->
                def qoh = (p.totalQoh ?: 0) as BigDecimal
                def reorder = (p.reorderPoint ?: 0) as BigDecimal

                if (qoh <= 0) {
                    zeroStockList.add([productId: p.productId, pseudoId: p.pseudoId ?: '',
                        productName: p.productName ?: p.pseudoId ?: p.productId,
                        mrpAmount: p.mrpAmount ?: BigDecimal.ZERO,
                        reorderPoint: reorder, totalQoh: qoh])
                } else if (reorder > 0 && qoh <= reorder) {
                    lowStockList.add([productId: p.productId, pseudoId: p.pseudoId ?: '',
                        productName: p.productName ?: p.pseudoId ?: p.productId,
                        mrpAmount: p.mrpAmount ?: BigDecimal.ZERO,
                        reorderPoint: reorder, totalQoh: qoh,
                        shortfall: (reorder - qoh).setScale(2, java.math.RoundingMode.HALF_UP)])
                }

                totalStockValue += (qoh > 0 && p.mrpAmount) ? qoh * (p.mrpAmount as BigDecimal) : BigDecimal.ZERO
            }

            zeroStockCount = zeroStockList.size()
            lowStockCount = lowStockList.size()
            inStockCount = totalProducts - zeroStockCount

            zeroStockList.sort { it.productName }
            lowStockList.sort { (it.shortfall as BigDecimal) }
            lowStockList = lowStockList.reverse()
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container-row>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Products" style="text-grey-7 text-caption"/>
                        <label text="${totalProducts}" type="h5" style="text-weight-bold text-primary q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="In Stock" style="text-grey-7 text-caption"/>
                        <label text="${inStockCount}" type="h5" style="text-weight-bold text-positive q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Zero Stock" style="text-grey-7 text-caption"/>
                        <label text="${zeroStockCount}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Low Stock" style="text-grey-7 text-caption"/>
                        <label text="${lowStockCount}" type="h5" style="text-weight-bold text-orange-7 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <container style="row items-center justify-between q-mb-md">
                <label text="" style=""/>
                <container style="row q-gutter-sm">
                    <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                    <link url="goImport" text="Import" icon="fa fa-upload" btn-type="primary" style="q-btn--dense"/>
                    <link url="goWastage" text="Wastage" icon="fa fa-trash" btn-type="danger" style="q-btn--dense"/>
                    <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
                </container>
            </container>

            <label text="Zero Stock Products" type="h6" style="text-weight-bold text-negative q-mb-sm"/>
            <container style="q-mb-lg">
                <form-list name="ZeroStockList" list="zeroStockList" skip-form="true"
                           show-csv-button="true" show-xlsx-button="true">
                    <field name="pseudoId"><default-field title="SKU">
                        <display/>
                    </default-field></field>
                    <field name="productName"><default-field title="Product">
                        <display/>
                    </default-field></field>
                    <field name="mrpAmount"><default-field title="MRP">
                        <display format="#,##0.00"/>
                    </default-field></field>
                    <field name="reorderPoint"><default-field title="Reorder Pt">
                        <display format="#,##0"/>
                    </default-field></field>
                    <field name="totalQoh"><default-field title="Stock">
                        <display format="#,##0"/>
                    </default-field></field>
                </form-list>
            </container>

            <label text="Low Stock Products (Below Reorder Point)" type="h6" style="text-weight-bold text-orange-7 q-mb-sm"/>
            <form-list name="LowStockList" list="lowStockList" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="pseudoId"><default-field title="SKU">
                    <display/>
                </default-field></field>
                <field name="productName"><default-field title="Product">
                    <display/>
                </default-field></field>
                <field name="totalQoh"><default-field title="Current Stock">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="reorderPoint"><default-field title="Reorder Point">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="shortfall"><default-field title="Shortfall">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="mrpAmount"><default-field title="MRP">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
