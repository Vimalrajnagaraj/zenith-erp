<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Price Overrides" default-menu-index="16">

    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTransactions"><default-response url="../PosTransactions"/></transition>
    <transition name="goReports"><default-response url="../Reports"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goDailySummary"><default-response url="../DailySummary"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosItemPriceOverrideView" list="overrideList">
            <search-form-inputs default-order-by="-changeDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_priceoverrides" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#127991; Price Overrides &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">A read-only <b>log</b> of every manual price change made during billing.<br>It shows who changed which item&#39;s price, when, and by how much &mdash; for your oversight. Nothing to edit here.</div></details>]]></text></render-mode>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
            <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
            <link url="goReports" text="Reports" icon="fa fa-bar-chart" btn-type="warning" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container-box>
            <box-header title="Price Override Audit Log"/>
            <box-body>
                <form-list name="PriceOverrideList" list="overrideList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <field name="changeDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="transactionNumber"><header-field title="Bill No" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="productName"><header-field title="Product"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="productId"><header-field title="Product ID"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="originalPrice"><default-field title="Original Price"><display format="#,##0.00"/></default-field></field>
                    <field name="newPrice"><default-field title="New Price"><display format="#,##0.00"/></default-field></field>
                    <field name="priceDiff"><default-field title="Difference">
                        <display text="${ec.l10n.format((newPrice ?: 0) - (originalPrice ?: 0), '#,##0.00')}"/></default-field></field>
                    <field name="changedBy"><default-field title="Changed By">
                        <display text="${(firstName ?: '') + ' ' + (lastName ?: '')}"/></default-field></field>
                    <field name="sessionId"><header-field title="Session" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
