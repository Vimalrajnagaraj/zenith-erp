<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Summary" default-menu-index="2">

    <transition name="goStock"><default-response url="../../Stock"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <set field="fromDate" from="fromDate ?: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="thruDate" from="thruDate ?: fromDate"/>
        <set field="dayStart" from="java.sql.Timestamp.valueOf(fromDate + ' 00:00:00')"/>
        <set field="dayEnd" from="java.sql.Timestamp.valueOf(thruDate + ' 23:59:59')"/>

        <script><![CDATA[
            // ZE-SALES-014 f/u: org-isolate the CSV/XLSX export (standalone render skips the authz filter)
            def _org = ec.user.getPreference("ACTIVE_ORGANIZATION")
            def _wastageFind = ec.entity.find("zenith.erp.pos.PosStockWastage")
                .condition("wastageDate", "greater-equals", dayStart)
                .condition("wastageDate", "less-equals", dayEnd)
            if (_org) _wastageFind.condition("organizationPartyId", _org)
            def wastages = _wastageFind.list()

            grandTotalLoss = BigDecimal.ZERO
            grandTotalQty = BigDecimal.ZERO

            reasonSummary = []
            productSummary = []

            if (wastages) {
                def reasonMap = new LinkedHashMap()
                def productMap = new LinkedHashMap()

                wastages.each { w ->
                    def reason = w.wastageReason ?: 'Other'
                    if (!reasonMap[reason]) {
                        def enumVal = ec.entity.find("moqui.basic.Enumeration").condition("enumId", reason).one()
                        reasonMap[reason] = [reason: reason, reasonName: enumVal?.description ?: reason,
                            totalLoss: BigDecimal.ZERO, totalQty: BigDecimal.ZERO, entryCount: 0 as int]
                    }
                    reasonMap[reason].totalLoss += (w.totalLoss ?: 0) as BigDecimal
                    reasonMap[reason].totalQty += (w.quantity ?: 0) as BigDecimal
                    reasonMap[reason].entryCount++

                    def pName = w.productName ?: w.productId ?: 'Unknown'
                    if (!productMap[pName]) {
                        productMap[pName] = [productName: pName,
                            totalLoss: BigDecimal.ZERO, totalQty: BigDecimal.ZERO, entryCount: 0 as int]
                    }
                    productMap[pName].totalLoss += (w.totalLoss ?: 0) as BigDecimal
                    productMap[pName].totalQty += (w.quantity ?: 0) as BigDecimal
                    productMap[pName].entryCount++
                }

                reasonSummary = reasonMap.values().sort { -(it.totalLoss as BigDecimal) }
                productSummary = productMap.values().sort { -(it.totalLoss as BigDecimal) }
                grandTotalLoss = reasonSummary.sum { it.totalLoss } ?: BigDecimal.ZERO
                grandTotalQty = reasonSummary.sum { it.totalQty } ?: BigDecimal.ZERO
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goStock" text="Stock" icon="fa fa-cubes" btn-type="primary" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container style="q-mb-md">
                <form-single name="SummaryFilter" transition=".">
                    <field name="fromDate"><default-field title="From">
                        <date-time type="date" default-value="${fromDate}"/>
                    </default-field></field>
                    <field name="thruDate"><default-field title="To">
                        <date-time type="date" default-value="${thruDate}"/>
                    </default-field></field>
                    <field name="searchBtn"><default-field title="">
                        <submit text="Search" icon="fa fa-search"/>
                    </default-field></field>
                </form-single>
            </container>

            <container-row>
                <row-col lg="6" md="6" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Loss Amount" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(grandTotalLoss, '#,##0.00')}" type="h5" style="text-weight-bold text-negative q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="6" md="6" sm="6">
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Qty Wasted" style="text-grey-7 text-caption"/>
                        <label text="${ec.l10n.format(grandTotalQty, '#,##0')}" type="h5" style="text-weight-bold text-orange-7 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <label text="By Reason" type="h6" style="text-weight-bold q-mb-sm"/>
            <form-list name="ReasonSummaryList" list="reasonSummary" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="reasonName"><default-field title="Reason">
                    <display/>
                </default-field></field>
                <field name="entryCount"><default-field title="Entries">
                    <display/>
                </default-field></field>
                <field name="totalQty"><default-field title="Qty Wasted">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="totalLoss"><default-field title="Loss Amount">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>

            <label text="By Product" type="h6" style="text-weight-bold q-mt-lg q-mb-sm"/>
            <form-list name="ProductSummaryList" list="productSummary" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="productName"><default-field title="Product">
                    <display/>
                </default-field></field>
                <field name="entryCount"><default-field title="Entries">
                    <display/>
                </default-field></field>
                <field name="totalQty"><default-field title="Qty Wasted">
                    <display format="#,##0"/>
                </default-field></field>
                <field name="totalLoss"><default-field title="Loss Amount">
                    <display format="#,##0.00"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
