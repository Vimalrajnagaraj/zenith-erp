<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tables" default-menu-index="2">

    <transition name="createTable">
        <service-call name="create#zenith.erp.pos.RestaurantTable"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTableStatus">
        <actions>
            <service-call name="update#zenith.erp.pos.RestaurantTable"
                          in-map="[tableId:tableId, statusId:statusId]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteTable">
        <service-call name="delete#zenith.erp.pos.RestaurantTable"/>
        <default-response url="."/>
    </transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goTransactions"><default-response url="../../PosTransactions"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.RestaurantTable" list="tables">
            <order-by field-name="sectionName,tableNumber"/>
        </entity-find>

        <script><![CDATA[
            totalTables = tables.size()
            availableCount = tables.count { it.statusId == 'TblAvailable' || !it.statusId }
            occupiedCount = tables.count { it.statusId == 'TblOccupied' }
            reservedCount = tables.count { it.statusId == 'TblReserved' }
            cleaningCount = tables.count { it.statusId == 'TblCleaning' }

            sections = tables.collect { it.sectionName ?: 'Main' }.unique().sort()
            tablesBySection = [:]
            sections.each { sec ->
                tablesBySection[sec] = tables.findAll { (it.sectionName ?: 'Main') == sec }
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-sm q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <container-row>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-white shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Total Tables" style="text-grey-7 text-caption"/>
                        <label text="${totalTables}" type="h4" style="text-weight-bold text-primary q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-green-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Available" style="text-grey-7 text-caption"/>
                        <label text="${availableCount}" type="h4" style="text-weight-bold text-green-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-red-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Occupied" style="text-grey-7 text-caption"/>
                        <label text="${occupiedCount}" type="h4" style="text-weight-bold text-red-8 q-my-xs"/>
                    </container>
                </row-col>
                <row-col lg="3" md="3" sm="6">
                    <container style="zenith-card bg-amber-1 shadow-1 q-pa-md q-mb-md text-center border-radius-lg">
                        <label text="Reserved" style="text-grey-7 text-caption"/>
                        <label text="${reservedCount}" type="h4" style="text-weight-bold text-amber-8 q-my-xs"/>
                    </container>
                </row-col>
            </container-row>

            <container style="row items-center justify-between q-mb-md">
                <label text="Table Layout" type="h6" style="text-weight-bold"/>
                <section name="AddTable_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddTable" button-text="Add Table" type="success">
                    <form-single name="CreateTableForm" transition="createTable">
                        <field name="tableNumber"><default-field title="Table Number">
                            <text-line size="6"/>
                        </default-field></field>
                        <field name="tableName"><default-field title="Table Name">
                            <text-line size="20"/>
                        </default-field></field>
                        <field name="seatingCapacity"><default-field title="Seats">
                            <text-line size="4" input-type="number" default-value="4"/>
                        </default-field></field>
                        <field name="sectionName"><default-field title="Section">
                            <text-line size="15" default-value="Main"/>
                        </default-field></field>
                        <field name="facilityId"><default-field title="Facility">
                            <drop-down allow-empty="true"><entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility"/>
                            </entity-options></drop-down>
                        </default-field></field>
                        <field name="statusId" from="'TblAvailable'"><default-field><hidden/></default-field></field>
                        <field name="submitBtn"><default-field title="">
                            <submit text="Add Table" icon="fa fa-plus"/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>

            <render-mode><text type="html,qvt" template="true"><![CDATA[
<#list sections as section>
    <div style="margin-bottom:20px;">
        <div style="font-weight:bold; font-size:14px; color:#555; margin-bottom:10px; text-transform:uppercase; letter-spacing:1px;">
            &#127978; ${section}
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:12px;">
            <#list tablesBySection[section] as tbl>
                <#assign statusColor = "#4CAF50"/>
                <#assign statusBg = "#E8F5E9"/>
                <#assign statusText = "Available"/>
                <#assign statusIcon = "&#9989;"/>
                <#if tbl.statusId! == "TblOccupied">
                    <#assign statusColor = "#F44336"/>
                    <#assign statusBg = "#FFEBEE"/>
                    <#assign statusText = "Occupied"/>
                    <#assign statusIcon = "&#127860;"/>
                <#elseif tbl.statusId! == "TblReserved">
                    <#assign statusColor = "#FF9800"/>
                    <#assign statusBg = "#FFF3E0"/>
                    <#assign statusText = "Reserved"/>
                    <#assign statusIcon = "&#128338;"/>
                <#elseif tbl.statusId! == "TblCleaning">
                    <#assign statusColor = "#9E9E9E"/>
                    <#assign statusBg = "#F5F5F5"/>
                    <#assign statusText = "Cleaning"/>
                    <#assign statusIcon = "&#129529;"/>
                </#if>

                <div style="width:150px; background:${statusBg}; border:2px solid ${statusColor}; border-radius:12px; padding:14px; text-align:center; position:relative;">
                    <div style="font-size:28px; margin-bottom:4px;">${statusIcon}</div>
                    <div style="font-weight:bold; font-size:20px; color:#333;">T${tbl.tableNumber!''}</div>
                    <#if tbl.tableName?has_content>
                        <div style="font-size:11px; color:#666; margin-top:2px;">${tbl.tableName}</div>
                    </#if>
                    <div style="font-size:11px; color:#888; margin-top:4px;">&#128101; ${tbl.seatingCapacity!4} seats</div>
                    <div style="margin-top:6px;">
                        <span style="background:${statusColor}; color:#fff; padding:2px 10px; border-radius:10px; font-size:10px; font-weight:bold;">${statusText}</span>
                    </div>
                    <#if tbl.currentTransactionId?has_content>
                        <div style="font-size:10px; color:#555; margin-top:4px;">Txn: ${tbl.currentTransactionId}</div>
                    </#if>

                    <#if modCanWrite>
                    <div style="margin-top:8px; display:flex; gap:3px; justify-content:center; flex-wrap:wrap;">
                        <#if tbl.statusId! != "TblAvailable">
                            <a href="updateTableStatus?tableId=${tbl.tableId}&statusId=TblAvailable" style="background:#4CAF50; color:#fff; padding:2px 6px; border-radius:4px; text-decoration:none; font-size:10px;">Free</a>
                        </#if>
                        <#if tbl.statusId! != "TblOccupied">
                            <a href="updateTableStatus?tableId=${tbl.tableId}&statusId=TblOccupied" style="background:#F44336; color:#fff; padding:2px 6px; border-radius:4px; text-decoration:none; font-size:10px;">Occupy</a>
                        </#if>
                        <#if tbl.statusId! != "TblReserved">
                            <a href="updateTableStatus?tableId=${tbl.tableId}&statusId=TblReserved" style="background:#FF9800; color:#fff; padding:2px 6px; border-radius:4px; text-decoration:none; font-size:10px;">Reserve</a>
                        </#if>
                        <#if tbl.statusId! != "TblCleaning">
                            <a href="updateTableStatus?tableId=${tbl.tableId}&statusId=TblCleaning" style="background:#9E9E9E; color:#fff; padding:2px 6px; border-radius:4px; text-decoration:none; font-size:10px;">Clean</a>
                        </#if>
                    </div>
                    </#if>
                </div>
            </#list>
        </div>
    </div>
</#list>

<#if !tables?? || tables?size == 0>
    <div style="text-align:center; padding:40px; color:#999;">
        <div style="font-size:48px; margin-bottom:10px;">&#127978;</div>
        <div style="font-size:16px;">No tables configured</div>
        <div style="font-size:13px; margin-top:4px;">Click "Add Table" to set up your restaurant tables</div>
    </div>
</#if>
            ]]></text></render-mode>

            <label text="Table List" type="h6" style="text-weight-bold q-mt-lg q-mb-sm"/>
            <form-list name="TableManageList" list="tables" list-entry="t" skip-form="true">
                <field name="tableNumber"><default-field title="Table #">
                    <display/>
                </default-field></field>
                <field name="tableName"><default-field title="Name">
                    <display default-text="-"/>
                </default-field></field>
                <field name="seatingCapacity"><default-field title="Seats">
                    <display/>
                </default-field></field>
                <field name="sectionName"><default-field title="Section">
                    <display default-text="Main"/>
                </default-field></field>
                <field name="statusId"><default-field title="Status">
                    <display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/>
                </default-field></field>
                <field name="deleteBtn"><default-field title="">
                    <link url="deleteTable" text="" icon="fa fa-trash" btn-type="danger"
                          parameter-map="[tableId:t.tableId]"
                          condition="modCanWrite"
                          confirmation="Delete table ${t.tableNumber}?"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
