<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Barcode Labels" default-menu-index="19">

    <parameter name="searchTerm"/>

    <actions>
        <script><![CDATA[
            def posOrg = ec.user.getPreference('ACTIVE_ORGANIZATION')
            def pf = ec.entity.find("mantle.product.Product").condition("productTypeEnumId", "PtAsset")
            if (posOrg) pf.condition("ownerPartyId", posOrg)
            def candidates = pf.orderBy("productName").limit(5000).list()
            def termLower = (searchTerm ?: '').toLowerCase().trim()
            def filtered = candidates.findAll { pr ->
                termLower == '' || (pr.productName ?: '').toLowerCase().contains(termLower) || (pr.pseudoId ?: '').toLowerCase().contains(termLower)
            }
            if (filtered.size() > 300) filtered = filtered.subList(0, 300)
            rows = filtered.collect { pr -> [productId: pr.productId, productName: (pr.productName ?: pr.productId),
                                             code: (pr.pseudoId ?: ''),
                                             price: (pr.mrpAmount != null ? (pr.mrpAmount as BigDecimal).toPlainString() : '')] }
            totalShown = filtered.size()

            // BC-032 f/u: expose the org's Label Templates so this printer honors the SAME Show/Hide +
            // size settings as the barcode-module renderLabels (default template drives the labels).
            def tf = ec.entity.find("zenith.erp.barcode.BarcodeLabel")
            if (posOrg) tf.condition("organizationPartyId", posOrg)
            templates = tf.orderBy("-isDefault,labelName").list()
            hasDefaultTpl = (templates.find { it.isDefault == 'Y' } != null)
            blToken = ec.web.sessionToken   // for the shared renderLabels iframe (read-only GET)
        ]]></script>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <div style="padding:14px 16px;max-width:1000px;margin:0 auto;font-family:'Segoe UI',Arial,sans-serif">
            <!-- The /qapps SPA strips <script> tags from screen content, so bootstrap the external
                 JS via an <img onload> attribute (inline event attributes survive); a script element
                 created with appendChild executes normally. -->
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="display:none" onload="if(!window.__blBoot){window.__blBoot=1;var s=document.createElement('script');s.src='/zenithstatic/js/pos-barcode-labels.js?v=4';document.body.appendChild(s);}"/>
            <div id="bl-token" data-t="${(blToken!'')?html}" style="display:none"></div>
            <div style="font-size:22px;font-weight:800;color:#1a237e;margin-bottom:2px">&#127991;&#65039; Barcode Labels</div>
            <div style="font-size:13px;color:#5f6368;margin-bottom:12px">Print scannable barcode stickers for your products.</div>

            <details open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin-bottom:14px">
                <summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#127991;&#65039; New here? Read this first <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary>
                <div style="font-size:13.5px;color:#202124;line-height:1.85;margin-top:10px">
                    <div style="margin-bottom:6px">Make printable stickers with a real scannable barcode for each product. Stick them on items or shelves so the cashier can scan instead of searching.</div>
                    <div style="font-weight:700;color:#174ea6;margin-bottom:3px">How to print labels</div>
                    <div style="margin-bottom:6px">1&nbsp; <b>Tick</b> the products you want &nbsp;&rarr;&nbsp; 2&nbsp; Choose a <b>label size</b> and how many <b>copies</b> of each &nbsp;&rarr;&nbsp; 3&nbsp; Click <b>Preview</b>, then <b>Print</b>.</div>
                    <div style="background:#fff3cd;border:1px solid #ffe082;border-radius:7px;padding:8px 11px;color:#6d4c00">&#9888;&#65039; A product with <b>no code</b> can't have a barcode &mdash; set its code on the <b>Barcodes</b> page first. The barcode is a standard <b>Code 128</b>, readable by any scanner.</div>
                </div>
            </details>

            <form method="get" action="BarcodeLabels" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px">
                <input type="text" name="searchTerm" value="${(searchTerm!'')?html}" placeholder="Search name or code..." style="flex:1;min-width:200px;padding:9px 12px;border:1px solid #bbb;border-radius:7px;font-size:14px"/>
                <button type="submit" style="padding:9px 20px;background:#1565c0;color:#fff;border:none;border-radius:7px;font-size:14px;font-weight:700;cursor:pointer">Search</button>
            </form>

            <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:flex-end;background:#f5f7fb;border:1px solid #e0e4ea;border-radius:9px;padding:10px 14px;margin-bottom:10px">
                <div><div style="font-size:12px;font-weight:700;color:#444;margin-bottom:3px">Label template</div>
                    <select id="bl-template" style="padding:8px 10px;border:1px solid #bbb;border-radius:7px;font-size:14px;min-width:150px">
                        <option value="">&mdash; Custom size &mdash;</option>
                        <#list (templates![]) as t>
                        <option value="${(t.labelId)?html}" data-showname="${(t.showProductName)!'Y'}" data-showprice="${(t.showPrice)!'Y'}" data-showsku="${(t.showSku)!'N'}" data-w="${(t.labelWidth!50)?c}" data-h="${(t.labelHeight!30)?c}"<#if (t.isDefault!'N') == 'Y'> selected</#if>>${(t.labelName)?html}<#if (t.isDefault!'N') == 'Y'> (default)</#if></option>
                        </#list>
                    </select></div>
                <div id="bl-size-wrap"<#if hasDefaultTpl!false> style="display:none"</#if>><div style="font-size:12px;font-weight:700;color:#444;margin-bottom:3px">Label size</div>
                    <select id="bl-size" style="padding:8px 10px;border:1px solid #bbb;border-radius:7px;font-size:14px">
                        <option value="50,25">50 &times; 25 mm</option>
                        <option value="38,25">38 &times; 25 mm</option>
                        <option value="65,35">65 &times; 35 mm</option>
                        <option value="100,50">100 &times; 50 mm</option>
                    </select></div>
                <div><div style="font-size:12px;font-weight:700;color:#444;margin-bottom:3px">Copies of each</div>
                    <input id="bl-copies" type="number" min="1" max="200" value="1" style="width:90px;padding:8px;border:1px solid #bbb;border-radius:7px;font-size:14px"/></div>
                <label id="bl-price-wrap" style="font-size:13px;color:#333;display:flex;align-items:center;gap:6px<#if hasDefaultTpl!false>;display:none</#if>"><input type="checkbox" id="bl-showprice" checked/> Show price</label>
                <button type="button" id="bl-preview" style="padding:9px 20px;background:#2e7d32;color:#fff;border:none;border-radius:7px;font-size:14px;font-weight:700;cursor:pointer">Preview labels</button>
                <button type="button" id="bl-print" style="padding:9px 20px;background:#1a73e8;color:#fff;border:none;border-radius:7px;font-size:14px;font-weight:700;cursor:pointer">&#128424;&#65039; Print</button>
            </div>

            <div style="display:flex;gap:8px;margin-bottom:6px">
                <button type="button" id="bl-all" style="padding:6px 12px;background:#eceff1;border:1px solid #cfd8dc;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer">Select all shown</button>
                <button type="button" id="bl-none" style="padding:6px 12px;background:#eceff1;border:1px solid #cfd8dc;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer">Clear</button>
                <span style="font-size:12px;color:#777;align-self:center">${totalShown!0} product(s) shown</span>
            </div>

            <div style="max-height:300px;overflow-y:auto;border:1px solid #e0e0e0;border-radius:8px;margin-bottom:16px">
                <table style="width:100%;border-collapse:collapse;font-size:13.5px">
                    <#list (rows![]) as r>
                    <tr style="border-bottom:1px solid #eee">
                        <td style="padding:6px 8px;width:34px;text-align:center">
                            <#if (r.code)?has_content><input type="checkbox" class="bl-pick" value="${(r.productId)?html}" data-name="${(r.productName)?html}" data-code="${(r.code)?html}" data-price="${(r.price)?html}"/>
                            <#else><span title="No code set" style="color:#b71c1c">&#9888;</span></#if>
                        </td>
                        <td style="padding:6px 8px">${(r.productName)?html}</td>
                        <td style="padding:6px 8px;color:#777;font-size:12px"><#if (r.code)?has_content>${(r.code)?html}<#else><span style="color:#b71c1c">no code &mdash; set it on the Barcodes page</span></#if></td>
                        <td style="padding:6px 8px;text-align:right;color:#333"><#if (r.price)?has_content>&#8377;${r.price}</#if></td>
                    </tr>
                    </#list>
                    <#if !(rows?has_content)><tr><td style="padding:20px;text-align:center;color:#888">No products found.</td></tr></#if>
                </table>
            </div>

            <div id="bl-preview-area" style="display:none">
                <div style="font-size:13px;color:#555;margin-bottom:8px">Preview below &mdash; click <b>Print</b> above (or the Print button inside the preview) to print.</div>
                <iframe id="bl-frame" title="Label preview" style="width:100%;height:520px;border:1px solid #bbb;border-radius:8px;background:#fff"></iframe>
            </div>
        </div>
        ]]></text></render-mode>
    </widgets>
</screen>
