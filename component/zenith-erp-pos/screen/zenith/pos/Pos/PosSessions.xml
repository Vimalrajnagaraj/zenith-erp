<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sessions" default-menu-index="6">

    <transition name="openSession" begin-transaction="true">
        <service-call name="zenith.pos.PosServices.open#PosSession"/>
        <default-response url="../EditSession"/>
    </transition>
    <transition name="editSession"><default-response url="../EditSession"/></transition>
    <transition name="goCashEntry"><default-response url="../CashEntry"/></transition>
    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>
    <transition name="goTerminals"><default-response url="../PosTerminals"/></transition>
    <transition name="goTransactions"><default-response url="../PosTransactions"/></transition>
    <transition name="goDailySummary"><default-response url="../DailySummary"/></transition>

    <actions>
        <set field="currSymbol" value="₹"/>
        <entity-find entity-name="zenith.erp.pos.PosSessionView" list="sessionList">
            <search-form-inputs default-order-by="-openDate"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_sessions" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128342; Sessions &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">A <b>session</b> is one cashier&#39;s shift on a terminal &mdash; it holds that shift&#39;s sales and cash count.<br><b>1</b>&nbsp;Click <b>Open New Session</b>, pick the terminal and enter the <b>opening cash</b> to start billing.<br><b>2</b>&nbsp;Each row shows that shift&#39;s sales, returns and cash <b>difference</b>.<br><b>3</b>&nbsp;Click a <b>Session</b> ID to open it, then <b>close</b> it at the end of the shift to count the drawer.</div></details>]]></text></render-mode>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="primary" style="q-btn--dense"/>
            <link url="goDailySummary" text="Daily Summary" icon="fa fa-calendar" btn-type="info" style="q-btn--dense"/>
            <link url="goTerminals" text="Terminals" icon="fa fa-desktop" style="q-btn--dense"/>
            <link url="goCashEntry" text="Cash Entry" icon="fa fa-exchange" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container-box>
            <box-header title="POS Sessions"/>
            <box-toolbar>
                <section name="OpenSession_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="OpenSessionDialog" button-text="Open New Session">
                    <form-single name="OpenSessionForm" transition="openSession">
                        <field name="terminalId"><default-field title="Terminal">
                            <drop-down><entity-options key="${terminalId}" text="${terminalName}">
                                <entity-find entity-name="zenith.erp.pos.PosTerminal">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="openingCash"><default-field title="Opening Cash (${currSymbol})">
                            <text-line size="12" default-value="0"/></default-field></field>
                        <field name="submitButton"><default-field title="Open Session"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="SessionList" list="sessionList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <field name="sessionId"><default-field title="Session">
                        <link url="editSession" text="${sessionId}" link-type="anchor"
                              parameter-map="[sessionId:sessionId]"/></default-field></field>
                    <field name="terminalName"><header-field title="Terminal" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="operatorPartyId"><header-field title="Operator"/>
                        <default-field><display/></default-field></field>
                    <field name="openDate"><header-field title="Opened" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="closeDate"><header-field title="Closed"/>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="statusId"><header-field title="Status" show-order-by="true">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="PosSession"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="openingCash"><default-field title="Opening (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalSales"><default-field title="Sales (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalReturns"><default-field title="Returns (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="totalTransactions"><default-field title="Txns"><display/></default-field></field>
                    <field name="closingCash"><default-field title="Closing (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="cashDifference"><default-field title="Diff (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
