<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Credit Bills" default-menu-index="9">

    <widgets>
        <!-- ZE-POS-002 / PS-073: this page drives the /apps-only pos-terminal.js, and its data fetch to
             Terminal/ajaxCart is a POST. On /qapps that POST hits the POS /qapps->/apps 301 redirect, which
             (per HTTP) turns POST into GET and DROPS the body — so action=creditBills is lost and the bills
             never load. Bounce the page to /apps up-front (same as the Terminal) so the fetch runs on /apps.
             img-onload is used because /qapps strips <script>; guarded so it is a no-op on /apps. -->
        <render-mode><text type="html,qvt" template="true"><![CDATA[<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="display:none" onload="if(location.pathname.indexOf('/qapps/')===0){location.replace('/apps/'+location.pathname.substring(7)+location.search);}"/>]]></text></render-mode>
        <container-box>
            <box-header title="Credit Bills"/>
            <box-body>
                <render-mode><text type="html,qvt" template="true"><![CDATA[<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"/><div id="credit-bills-root" style="min-height:200px">Loading credit bills…</div><script src="/zenithstatic/js/pos-terminal.js?v=150"></script>]]></text></render-mode>
            </box-body>
        </container-box>
    </widgets>
</screen>
