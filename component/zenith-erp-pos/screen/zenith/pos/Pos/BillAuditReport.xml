<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Audit Report" default-menu-index="8">

    <transition name="goTerminal"><default-response url="../Terminal"/></transition>
    <transition name="goTransactions"><default-response url="../PosTransactions"/></transition>
    <transition name="goReports"><default-response url="../Reports"/></transition>
    <transition name="goDashboard"><default-response url="../Dashboard"/></transition>

    <actions>
        <!-- Scope the audit trail to the operator's organization (whole store) -->
        <set field="opParty" from="ec.user.userAccount?.partyId"/>
        <entity-find entity-name="zenith.erp.pos.PosSession" list="recentSess" limit="1">
            <econdition field-name="operatorPartyId" from="opParty"/>
            <order-by field-name="-openDate"/>
        </entity-find>
        <set field="myOrg" from="null"/>
        <if condition="recentSess">
            <entity-find-one entity-name="zenith.erp.pos.PosTerminal" value-field="myTerm">
                <field-map field-name="terminalId" from="recentSess[0].terminalId"/>
            </entity-find-one>
            <set field="myOrg" from="myTerm?.organizationPartyId"/>
        </if>

        <entity-find entity-name="zenith.erp.pos.PosAmendmentView" list="auditList">
            <search-form-inputs default-order-by="-amendmentDate"/>
            <econdition field-name="organizationPartyId" from="myOrg" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_billaudit" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128737; Audit Report &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">A <b>tamper trail</b>: every edit made to an already-issued bill, showing the old and new values and who changed them.<br>Read-only &mdash; it exists to protect billing integrity.</div></details>]]></text></render-mode>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
            <link url="goTransactions" text="Transactions" icon="fa fa-list" btn-type="info" style="q-btn--dense"/>
            <link url="goReports" text="Reports" icon="fa fa-bar-chart" btn-type="warning" style="q-btn--dense"/>
            <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
        </container>
        <container-box>
            <box-header title="Bill Edit Audit Trail"/>
            <box-body>
                <form-list name="AuditList" list="auditList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <field name="amendmentDate"><header-field title="Date / Time" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="transactionNumber"><header-field title="Bill Number" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="changeType"><header-field title="Change Type">
                            <drop-down allow-empty="true">
                                <option key="QTY_CHANGE" text="Qty Change"/>
                                <option key="PRICE_CHANGE" text="Price Change"/>
                                <option key="ITEM_ADDED" text="Item Added"/>
                                <option key="ITEM_REMOVED" text="Item Removed"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="productName"><header-field title="Product"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="oldValue"><default-field title="Old Value"><display/></default-field></field>
                    <field name="newValue"><default-field title="New Value"><display/></default-field></field>
                    <field name="oldGrandTotal"><default-field title="Old Total"><display format="#,##,##0.00"/></default-field></field>
                    <field name="newGrandTotal"><default-field title="New Total"><display format="#,##,##0.00"/></default-field></field>
                    <field name="reason"><header-field title="Reason"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="amendedByPartyId"><header-field title="Changed By" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="terminalName"><header-field title="Terminal"/>
                        <default-field><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
