<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Template" default-menu-index="2" default-menu-include="false">

    <parameter name="templateId" required="true"/>

    <transition name="updateTemplate">
        <actions>
            <!-- Cross-tenant write-IDOR guard: only the owning org (ADMIN exempt) may mutate this template. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.pos.PosReceiptTemplate', idField:'templateId', idValue:templateId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="update#zenith.erp.pos.PosReceiptTemplate" in-map="context"/>
            <service-call name="zenith.pos.PosServices.enforce#SingleDefaultReceiptTemplate" in-map="[templateId:templateId]"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="deleteTemplate">
        <actions>
            <!-- Cross-tenant write-IDOR guard: only the owning org (ADMIN exempt) may mutate this template. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.pos.PosReceiptTemplate', idField:'templateId', idValue:templateId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="delete#zenith.erp.pos.PosReceiptTemplate" in-map="context"/>
        </actions>
        <default-response url="../Templates"/></transition>

    <actions>
        <!-- Cross-tenant IDOR render guard: only the owning org (ADMIN exempt) may open a receipt template.
             Load NOTHING when blocked; widgets show a plain no-access panel instead of another tenant's data. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_acc"
                      in-map="[entityName:'zenith.erp.pos.PosReceiptTemplate', idField:'templateId', idValue:templateId, orgField:'organizationPartyId']"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.pos.PosReceiptTemplate" value-field="tpl"/>
        </if>
    </actions>

    <widgets>
        <!-- Cross-tenant / missing template — plain notice, never another org's template/company data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That receipt template isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="q-pa-md">
            <container-row>
                <row-col lg="7" md="7" sm="12">
                    <label text="Receipt Settings" type="h6" style="text-weight-bold q-mb-md"/>
                    <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <form-single name="EditTemplateForm" transition="updateTemplate" map="tpl">
                            <field name="templateId"><default-field><hidden/></default-field></field>

                            <field name="templateName"><default-field title="Template Name">
                                <text-line size="30"/>
                            </default-field></field>
                            <field name="isDefault"><default-field title="Default Template">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>

                            <field name="companyHeader" from="''"><default-field><label text="Company Details" type="h6" style="text-weight-bold q-mt-md"/></default-field></field>
                            <field name="companyName"><default-field title="Company Name">
                                <text-line size="40"/>
                            </default-field></field>
                            <field name="addressLine1"><default-field title="Address Line 1">
                                <text-line size="40"/>
                            </default-field></field>
                            <field name="addressLine2"><default-field title="Address Line 2">
                                <text-line size="40"/>
                            </default-field></field>
                            <field name="city"><default-field title="City">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="state"><default-field title="State">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="pincode"><default-field title="Pincode">
                                <text-line size="10"/>
                            </default-field></field>
                            <field name="phone"><default-field title="Phone">
                                <text-line size="20"/>
                            </default-field></field>
                            <field name="email"><default-field title="Email">
                                <text-line size="30"/>
                            </default-field></field>
                            <field name="taxRegistrationNumber"><default-field title="Tax Reg. No. (GSTIN)">
                                <text-line size="20"/>
                            </default-field></field>

                            <field name="contentHeader" from="''"><default-field><label text="Header &amp; Footer" type="h6" style="text-weight-bold q-mt-md"/></default-field></field>
                            <field name="headerText"><default-field title="Header Text">
                                <text-line size="50"/>
                            </default-field></field>
                            <field name="footerText"><default-field title="Footer Text">
                                <text-line size="50"/>
                            </default-field></field>
                            <field name="termsText"><default-field title="Terms &amp; Conditions">
                                <text-area rows="3" cols="50"/>
                            </default-field></field>

                            <field name="printHeader" from="''"><default-field><label text="Print Settings" type="h6" style="text-weight-bold q-mt-md"/></default-field></field>
                            <field name="receiptWidth"><default-field title="Receipt Width">
                                <drop-down><option key="80mm" text="80mm (Standard)"/><option key="58mm" text="58mm (Compact)"/></drop-down>
                            </default-field></field>
                            <field name="showLogo"><default-field title="Show Logo">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="logoUrl"><default-field title="Logo URL">
                                <text-line size="50"/>
                            </default-field></field>

                            <field name="displayHeader" from="''"><default-field><label text="Display Options" type="h6" style="text-weight-bold q-mt-md"/></default-field></field>
                            <field name="showTaxBreakdown"><default-field title="Show Tax Breakdown">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="showDiscount"><default-field title="Show Discount">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="showCustomerInfo"><default-field title="Show Customer Info">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="showPaymentDetails"><default-field title="Show Payment Details">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>
                            <field name="showItemTax"><default-field title="Show Per-Item Tax">
                                <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                            </default-field></field>

                            <field name="submitBtn">
                                <conditional-field name="tpl_save_write" condition="modCanWrite" title="">
                                <submit text="Save Changes" icon="fa fa-save"/>
                                </conditional-field>
                                <default-field title="">
                                <label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                        </form-single>
                    </container>

                    <section name="DeleteTemplate_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container style="q-mt-md">
                        <link url="deleteTemplate" text="Delete Template" icon="fa fa-trash" btn-type="danger"
                              parameter-map="[templateId:templateId]"
                              confirmation="Are you sure you want to delete this template?"/>
                    </container>
                    </widgets></section>
                </row-col>

                <row-col lg="5" md="5" sm="12">
                    <label text="Receipt Preview" type="h6" style="text-weight-bold q-mb-md"/>
                    <render-mode><text type="html,qvt" template="true"><![CDATA[
<div style="background:#fff; border:1px solid #ddd; padding:16px; max-width:320px; font-family:'Courier New',monospace; font-size:12px; line-height:1.5; margin:0 auto;">
    <#if tpl.showLogo! == 'Y' && tpl.logoUrl?has_content>
        <div style="text-align:center; margin-bottom:8px;">
            <img src="${tpl.logoUrl!}" style="max-height:50px; max-width:200px;" alt="Logo"/>
        </div>
    </#if>
    <div style="text-align:center; font-weight:bold; font-size:14px;">${tpl.companyName!'Company Name'}</div>
    <#if tpl.addressLine1?has_content><div style="text-align:center;">${tpl.addressLine1!}</div></#if>
    <#if tpl.addressLine2?has_content><div style="text-align:center;">${tpl.addressLine2!}</div></#if>
    <#if tpl.city?has_content || tpl.state?has_content || tpl.pincode?has_content>
        <div style="text-align:center;">${tpl.city!}<#if tpl.state?has_content>, ${tpl.state!}</#if> <#if tpl.pincode?has_content>- ${tpl.pincode!}</#if></div>
    </#if>
    <#if tpl.phone?has_content><div style="text-align:center;">Ph: ${tpl.phone!}</div></#if>
    <#if tpl.email?has_content><div style="text-align:center;">${tpl.email!}</div></#if>
    <#if tpl.taxRegistrationNumber?has_content><div style="text-align:center;">GSTIN: ${tpl.taxRegistrationNumber!}</div></#if>

    <#if tpl.headerText?has_content>
        <div style="text-align:center; margin-top:6px; font-style:italic;">${tpl.headerText!}</div>
    </#if>

    <div style="border-top:1px dashed #999; margin:8px 0;"></div>

    <div style="display:flex; justify-content:space-between;">
        <span>Bill No: <b>INV-0001</b></span>
        <span>13-06-2026</span>
    </div>
    <#if tpl.showCustomerInfo! == 'Y'>
        <div>Customer: Walk-in Customer</div>
    </#if>
    <div>Cashier: John Doe</div>

    <div style="border-top:1px dashed #999; margin:8px 0;"></div>

    <table style="width:100%; font-size:11px;">
        <tr style="border-bottom:1px solid #ccc;">
            <th style="text-align:left;">Item</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Rate</th><th style="text-align:right;">Amt</th>
        </tr>
        <tr><td>Rice Bag 5kg</td><td style="text-align:right;">2</td><td style="text-align:right;">250.00</td><td style="text-align:right;">500.00</td></tr>
        <#if tpl.showItemTax! == 'Y'><tr><td colspan="4" style="font-size:10px; color:#666; padding-left:10px;">Tax: 5% = 25.00</td></tr></#if>
        <tr><td>Cooking Oil 1L</td><td style="text-align:right;">1</td><td style="text-align:right;">180.00</td><td style="text-align:right;">180.00</td></tr>
        <#if tpl.showItemTax! == 'Y'><tr><td colspan="4" style="font-size:10px; color:#666; padding-left:10px;">Tax: 18% = 32.40</td></tr></#if>
        <tr><td>Sugar 1kg</td><td style="text-align:right;">3</td><td style="text-align:right;">45.00</td><td style="text-align:right;">135.00</td></tr>
        <#if tpl.showItemTax! == 'Y'><tr><td colspan="4" style="font-size:10px; color:#666; padding-left:10px;">Tax: 5% = 6.75</td></tr></#if>
    </table>

    <div style="border-top:1px dashed #999; margin:8px 0;"></div>

    <div style="display:flex; justify-content:space-between;"><span>Subtotal:</span><span>815.00</span></div>
    <#if tpl.showDiscount! == 'Y'>
        <div style="display:flex; justify-content:space-between; color:#c00;"><span>Discount:</span><span>-15.00</span></div>
    </#if>
    <#if tpl.showTaxBreakdown! == 'Y'>
        <div style="display:flex; justify-content:space-between;"><span>CGST:</span><span>32.08</span></div>
        <div style="display:flex; justify-content:space-between;"><span>SGST:</span><span>32.08</span></div>
    </#if>
    <div style="display:flex; justify-content:space-between; font-weight:bold; font-size:14px; border-top:1px solid #333; margin-top:4px; padding-top:4px;">
        <span>Total:</span><span>864.16</span>
    </div>

    <#if tpl.showPaymentDetails! == 'Y'>
        <div style="border-top:1px dashed #999; margin:8px 0;"></div>
        <div style="display:flex; justify-content:space-between;"><span>Cash:</span><span>900.00</span></div>
        <div style="display:flex; justify-content:space-between;"><span>Change:</span><span>35.84</span></div>
    </#if>

    <div style="border-top:1px dashed #999; margin:8px 0;"></div>

    <#if tpl.footerText?has_content>
        <div style="text-align:center; font-size:11px;">${tpl.footerText!}</div>
    </#if>
    <#if tpl.termsText?has_content>
        <div style="text-align:center; font-size:10px; color:#666; margin-top:4px;">${tpl.termsText!}</div>
    </#if>

    <div style="text-align:center; margin-top:8px; font-size:10px; color:#999;">
        Width: ${tpl.receiptWidth!'80mm'} | Template: ${tpl.templateName!}
    </div>
</div>
                    ]]></text></render-mode>
                </row-col>
            </container-row>
        </container>
        </widgets>
        </section>
    </widgets>
</screen>
