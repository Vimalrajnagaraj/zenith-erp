<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Templates" default-menu-index="1">

    <transition name="createTemplate">
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.pos.PosReceiptTemplate" in-map="context"/>
        </actions>
        <default-response url="."/></transition>
    <transition name="editTemplate">
        <default-response url="../EditTemplate"/>
    </transition>
    <transition name="goTerminals"><default-response url="../../PosTerminals"/></transition>
    <transition name="goDashboard"><default-response url="../../Dashboard"/></transition>
    <transition name="goTerminal"><default-response url="../../Terminal"/></transition>
    <transition name="goSalesMode"><default-response url="../../SalesMode"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.PosReceiptTemplate" list="templateList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="templateName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container style="row items-center justify-end q-mb-md q-gutter-sm">
                <link url="goTerminal" text="Billing" icon="fa fa-calculator" btn-type="success" style="q-btn--dense"/>
                <link url="goTerminals" text="Terminals" icon="fa fa-desktop" btn-type="primary" style="q-btn--dense"/>
                <link url="goSalesMode" text="Sales Modes" icon="fa fa-tags" btn-type="warning" style="q-btn--dense"/>
                <link url="goDashboard" text="Dashboard" icon="fa fa-dashboard" style="q-btn--dense"/>
            </container>
            <label text="Create Receipt Template" type="h6" style="text-weight-bold q-mb-md"/>
            <container style="zenith-card bg-white shadow-2 q-pa-md q-mb-lg border-radius-lg">
                <form-single name="CreateTemplate" transition="createTemplate">
                    <field name="templateName"><default-field title="Template Name">
                        <text-line size="30"/>
                    </default-field></field>
                    <field name="companyName"><default-field title="Company Name">
                        <text-line size="40"/>
                    </default-field></field>
                    <field name="phone"><default-field title="Phone">
                        <text-line size="20"/>
                    </default-field></field>
                    <field name="receiptWidth"><default-field title="Receipt Width">
                        <drop-down>
                            <option key="80mm" text="80mm (Standard)"/>
                            <option key="58mm" text="58mm (Compact)"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="">
                        <submit text="Create Template" icon="fa fa-plus"/>
                    </default-field></field>
                </form-single>
            </container>

            <label text="Receipt Templates" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="TemplateList" list="templateList" list-entry="tpl" skip-form="true">
                <field name="templateName"><default-field title="Template">
                    <link url="editTemplate" text="${tpl.templateName}" parameter-map="[templateId:tpl.templateId]" link-type="anchor"/>
                </default-field></field>
                <field name="companyName"><default-field title="Company">
                    <display default-text="-"/>
                </default-field></field>
                <field name="receiptWidth"><default-field title="Width">
                    <display/>
                </default-field></field>
                <field name="isDefault"><default-field title="Default">
                    <display text="${tpl.isDefault == 'Y' ? 'Yes' : 'No'}"/>
                </default-field></field>
                <field name="isActive"><default-field title="Active">
                    <display text="${tpl.isActive == 'Y' ? 'Yes' : 'No'}"/>
                </default-field></field>
                <field name="editBtn"><default-field title="">
                    <link url="editTemplate" text="Edit" icon="fa fa-pencil"
                          parameter-map="[templateId:tpl.templateId]"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
