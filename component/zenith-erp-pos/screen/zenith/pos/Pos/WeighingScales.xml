<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Weighing Scales" default-menu-include="false">

    <transition name="createConfig">
        <service-call name="zenith.pos.PosServices.configure#WeighingScale"/>
        <default-response url="."/>
    </transition>
    <transition name="updateConfig">
        <service-call name="update#zenith.erp.pos.WeighingScaleConfig"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.pos.WeighingScaleConfig" list="configs">
            <order-by field-name="terminalId"/>
        </entity-find>
    </actions>

    <widgets>
        <render-mode><text type="html,qvt" template="true"><![CDATA[<details id="posHelp_scales" open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:8px 12px 4px 12px;font-family:Segoe UI,Arial,sans-serif"><summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#9878; Weighing Scales &mdash; quick help <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary><div style="font-size:13px;color:#202124;line-height:1.9;margin-top:8px">Connect weighing scales so loose / weighed items price automatically.<br><b>1</b>&nbsp;<b>Add Scale</b> with its make and connection.<br><b>2</b>&nbsp;Once connected, weighed items pick up the weight at billing.</div></details>]]></text></render-mode>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Weighing Scale Configuration" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateConfig" button-text="Add Scale" type="success">
                <form-single name="CreateForm" transition="createConfig">
                    <field name="terminalId"><default-field title="Terminal">
                        <drop-down><entity-options key="${terminalId}" text="${terminalName}">
                            <entity-find entity-name="zenith.erp.pos.PosTerminal"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="connectionType"><default-field title="Connection">
                        <drop-down>
                            <option key="Serial" text="Serial (COM)"/>
                            <option key="USB" text="USB"/>
                            <option key="Bluetooth" text="Bluetooth"/>
                            <option key="Network" text="Network (TCP/IP)"/>
                        </drop-down></default-field></field>
                    <field name="portName"><default-field title="Port"><text-line size="10"/></default-field></field>
                    <field name="baudRate"><default-field title="Baud Rate">
                        <drop-down>
                            <option key="9600" text="9600"/>
                            <option key="19200" text="19200"/>
                            <option key="38400" text="38400"/>
                            <option key="115200" text="115200"/>
                        </drop-down></default-field></field>
                    <field name="weightUomId"><default-field title="Unit">
                        <drop-down>
                            <option key="WT_kg" text="Kilogram (kg)"/>
                            <option key="WT_g" text="Gram (g)"/>
                            <option key="WT_lb" text="Pound (lb)"/>
                            <option key="WT_oz" text="Ounce (oz)"/>
                        </drop-down></default-field></field>
                    <field name="decimalPlaces"><default-field title="Decimals">
                        <drop-down>
                            <option key="1" text="1"/><option key="2" text="2"/>
                            <option key="3" text="3"/>
                        </drop-down></default-field></field>
                    <field name="isAutoCapture"><default-field title="Auto Capture">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ConfigsForm" list="configs" transition="updateConfig">
                <field name="scaleConfigId"><default-field><hidden/></default-field></field>
                <field name="terminalId"><default-field title="Terminal">
                    <display-entity entity-name="zenith.erp.pos.PosTerminal" key-field-name="terminalId" text="${terminalName}"/>
                </default-field></field>
                <field name="connectionType"><default-field title="Connection"><display/></default-field></field>
                <field name="portName"><default-field title="Port"><text-line size="8"/></default-field></field>
                <field name="baudRate"><default-field title="Baud"><display/></default-field></field>
                <field name="weightUomId"><default-field title="Unit"><display/></default-field></field>
                <field name="decimalPlaces"><default-field title="Dec"><display/></default-field></field>
                <field name="isAutoCapture"><default-field title="Auto">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
