<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Point of Sale" default-menu-index="11">

    <always-actions>
        <set field="html_title" value="Point of Sale"/>
    </always-actions>

    <subscreens default-item="Dashboard">
        <subscreens-item name="OfflineMode" location="component://zenith-erp-pos/screen/zenith/pos/Pos/OfflineMode.xml" menu-title="Offline Mode"/>
    </subscreens>

    <transition name="goSales"><default-response url="/apps/zenith/sales/SalesDashboard"/></transition>
    <transition name="goInventory"><default-response url="/apps/zenith/Inventory/FindProduct"/></transition>
    <transition name="goContacts"><default-response url="/apps/zenith/Contacts/Customers"/></transition>
    <transition name="goAccounting"><default-response url="/apps/zenith/Accounting/AcctgDashboard"/></transition>

    <actions>
        <script><![CDATA[
            // SaaS module-access flags: hide cross-module links not in the tenant's plan (inherited from ZenithApp)
            def _mods = context.saasAllowedModules
            boolean _allMod = (context.saasHasAllAccess == true) || (context.isSaasTenant != true)
            modSales = _allMod || (_mods != null && _mods.contains('sales'))
            modInventory = _allMod || (_mods != null && _mods.contains('inventory'))
            modContacts = _allMod || (_mods != null && _mods.contains('contacts'))
            modAccounting = _allMod || (_mods != null && _mods.contains('accounting'))
            modPurchase = _allMod || (_mods != null && _mods.contains('purchase'))
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-sm q-gutter-sm">
            <section name="PosNavSales" condition="modSales"><widgets><link url="goSales" text="Sales" icon="fa fa-line-chart" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="PosNavInventory" condition="modInventory"><widgets><link url="goInventory" text="Inventory" icon="fa fa-cubes" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="PosNavContacts" condition="modContacts"><widgets><link url="goContacts" text="Customers" icon="fa fa-users" btn-type="success" style="q-btn--dense"/></widgets></section>
            <section name="PosNavAccounting" condition="modAccounting"><widgets><link url="goAccounting" text="Accounting" icon="fa fa-calculator" btn-type="warning" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-panel id="pos-tabs" type="tab"/>
    </widgets>
</screen>
