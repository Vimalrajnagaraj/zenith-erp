<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Templates" default-menu-index="3">

    <transition name="createTemplate" begin-transaction="true">
        <service-call name="create#zenith.erp.marketing.EmailTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate" begin-transaction="true">
        <service-call name="update#zenith.erp.marketing.EmailTemplate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.marketing.EmailTemplate" list="templateList">
            <order-by field-name="templateName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Email Templates"/>
            <box-toolbar>
                <container-dialog id="CreateTemplateDialog" button-text="New Template">
                    <form-single name="CreateTemplateForm" transition="createTemplate">
                        <field name="templateId"><default-field title="Template ID"><text-line size="15"/></default-field></field>
                        <field name="templateName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="subject"><default-field title="Default Subject"><text-line size="50"/></default-field></field>
                        <field name="category"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="EmailTemplateCategory"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="previewText"><default-field title="Preview Text"><text-line size="50"/></default-field></field>
                        <field name="htmlContent"><default-field title="HTML Content"><text-area rows="12" cols="60"/></default-field></field>
                        <field name="textContent"><default-field title="Plain Text"><text-area rows="6" cols="60"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="TemplateList" list="templateList" transition="updateTemplate">
                    <field name="templateId"><default-field title="ID"><display/></default-field></field>
                    <field name="templateName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="subject"><default-field title="Subject"><text-line size="30"/></default-field></field>
                    <field name="category"><default-field title="Category">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="EmailTemplateCategory"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="previewText"><default-field title="Preview"><text-line size="20"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
