<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="SMS Gateways" default-menu-index="5">

    <transition name="createGateway" begin-transaction="true">
        <service-call name="create#zenith.erp.marketing.SmsGateway"/>
        <default-response url="."/>
    </transition>
    <transition name="updateGateway" begin-transaction="true">
        <service-call name="update#zenith.erp.marketing.SmsGateway"/>
        <default-response url="."/>
    </transition>
    <transition name="createDltTemplate" begin-transaction="true">
        <service-call name="create#zenith.erp.marketing.SmsDltTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDltTemplate" begin-transaction="true">
        <service-call name="update#zenith.erp.marketing.SmsDltTemplate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.marketing.SmsGateway" list="gatewayList">
            <order-by field-name="gatewayName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.marketing.SmsDltTemplate" list="dltList">
            <order-by field-name="gatewayId,templateName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.marketing.SmsLog" list="logList">
            <order-by field-name="-sentDate"/>
            <limit-range start="0" size="50"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- SMS Gateways -->
        <container-box>
            <box-header title="SMS Gateways (Indian Providers)"/>
            <box-toolbar>
                <section name="mkt_AddGateway_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddGatewayDialog" button-text="Add Gateway">
                    <form-single name="AddGatewayForm" transition="createGateway">
                        <field name="gatewayId"><default-field title="Gateway ID"><text-line size="15"/></default-field></field>
                        <field name="gatewayName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="providerCode"><default-field title="Provider">
                            <drop-down>
                                <option key="MSG91" text="MSG91"/>
                                <option key="KALEYRA" text="Kaleyra"/>
                                <option key="TEXTLOCAL" text="TextLocal"/>
                            </drop-down></default-field></field>
                        <field name="apiKey"><default-field title="API Key"><text-line size="40"/></default-field></field>
                        <field name="apiSecret"><default-field title="API Secret"><text-line size="40"/></default-field></field>
                        <field name="senderId"><default-field title="Sender ID (6 chars)"><text-line size="8"/></default-field></field>
                        <field name="dltEntityId"><default-field title="DLT Entity ID (TRAI)"><text-line size="25"/></default-field></field>
                        <field name="apiBaseUrl"><default-field title="API Base URL"><text-line size="40"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="GatewayList" list="gatewayList" transition="updateGateway">
                    <field name="gatewayId"><default-field title="ID"><display/></default-field></field>
                    <field name="gatewayName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="providerCode"><default-field title="Provider"><display/></default-field></field>
                    <field name="senderId"><default-field title="Sender"><text-line size="8"/></default-field></field>
                    <field name="dltEntityId"><default-field title="DLT Entity"><text-line size="18"/></default-field></field>
                    <field name="apiBaseUrl"><default-field title="API URL"><text-line size="25"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="mkt_gw_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- DLT Templates (TRAI Compliance) -->
        <container-box>
            <box-header title="DLT Templates (TRAI Registered)"/>
            <box-toolbar>
                <section name="mkt_AddDlt_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddDltDialog" button-text="Add DLT Template">
                    <form-single name="AddDltForm" transition="createDltTemplate">
                        <field name="dltTemplateId"><default-field title="DLT Template ID"><text-line size="20"/></default-field></field>
                        <field name="gatewayId"><default-field title="Gateway">
                            <drop-down><entity-options key="${gatewayId}" text="${gatewayName}">
                                <entity-find entity-name="zenith.erp.marketing.SmsGateway"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="templateName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="templateContent"><default-field title="Content"><text-area rows="4" cols="50"/></default-field></field>
                        <field name="category"><default-field title="Category">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="SmsDltCategory"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DltList" list="dltList" transition="updateDltTemplate">
                    <field name="dltTemplateId"><default-field title="DLT ID"><display/></default-field></field>
                    <field name="gatewayId"><default-field title="Gateway">
                        <display-entity entity-name="zenith.erp.marketing.SmsGateway" text="${gatewayName}"/></default-field></field>
                    <field name="templateName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="templateContent"><default-field title="Content"><text-area rows="2" cols="30"/></default-field></field>
                    <field name="category"><default-field title="Category">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="mkt_dlt_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- SMS Log -->
        <container-box>
            <box-header title="SMS Log (Last 50)"/>
            <box-body>
                <form-list name="SmsLogList" list="logList" skip-form="true">
                    <field name="logId"><default-field title="ID"><display/></default-field></field>
                    <field name="gatewayId"><default-field title="Gateway">
                        <display-entity entity-name="zenith.erp.marketing.SmsGateway" text="${gatewayName}"/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="message"><default-field title="Message"><display/></default-field></field>
                    <field name="dltTemplateId"><default-field title="DLT ID"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status"><display/></default-field></field>
                    <field name="sentDate"><default-field title="Sent"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
