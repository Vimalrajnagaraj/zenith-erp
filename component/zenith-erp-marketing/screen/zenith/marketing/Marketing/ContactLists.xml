<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact Lists" default-menu-index="4">

    <transition name="createList" begin-transaction="true">
        <service-call name="create#zenith.erp.marketing.ContactList"
                      in-map="context + [organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION')]"/>
        <default-response url="."/>
    </transition>
    <transition name="updateList" begin-transaction="true">
        <service-call name="update#zenith.erp.marketing.ContactList"/>
        <default-response url="."/>
    </transition>
    <transition name="addMember" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.addMember#ContactList"/>
        <default-response url="."/>
    </transition>
    <transition name="unsubscribeMember" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.unsubscribe#ContactListMember"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.marketing.ContactList" list="listList">
            <order-by field-name="listName"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.marketing.ContactListMemberView" list="memberList">
            <search-form-inputs default-order-by="listName,lastName"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Contact Lists -->
        <container-box>
            <box-header title="Contact Lists"/>
            <box-toolbar>
                <section name="mkt_CreateList_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateListDialog" button-text="New List">
                    <form-single name="CreateListForm" transition="createList">
                        <field name="listId"><default-field title="List ID"><text-line size="15"/></default-field></field>
                        <field name="listName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="listType"><default-field title="Type">
                            <drop-down no-current-selected-key="Static">
                                <option key="Static"/><option key="Dynamic"/>
                            </drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="ListList" list="listList" transition="updateList">
                    <field name="listId"><default-field title="ID"><display/></default-field></field>
                    <field name="listName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="listType"><default-field title="Type"><display/></default-field></field>
                    <field name="totalSubscribers"><default-field title="Subscribers"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="mkt_list_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Members -->
        <container-box>
            <box-header title="List Members"/>
            <box-toolbar>
                <section name="mkt_AddMember_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddMemberDialog" button-text="Add Member">
                    <form-single name="AddMemberForm" transition="addMember">
                        <field name="listId"><default-field title="List">
                            <drop-down><entity-options key="${listId}" text="${listName}">
                                <entity-find entity-name="zenith.erp.marketing.ContactList">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="partyId"><default-field title="Party ID"><text-line size="15"/></default-field></field>
                        <field name="firstName"><default-field title="First Name"><text-line size="20"/></default-field></field>
                        <field name="lastName"><default-field title="Last Name"><text-line size="20"/></default-field></field>
                        <field name="email"><default-field title="Email"><text-line size="30"/></default-field></field>
                        <field name="phone"><default-field title="Phone"><text-line size="15"/></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="MemberList" list="memberList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true">
                    <field name="listName"><header-field title="List" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="partyId"><default-field title="Party"><display/></default-field></field>
                    <field name="firstName"><header-field title="First Name"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="lastName"><header-field title="Last Name"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="email"><header-field title="Email"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="isSubscribed"><header-field title="Subscribed">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="subscribedDate"><default-field title="Since"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="actions"><default-field title="">
                        <link url="unsubscribeMember" text="Unsub"
                              parameter-map="[listId:listId, partyId:partyId]"
                              condition="isSubscribed == 'Y' &amp;&amp; modCanWrite"
                              confirmation="Unsubscribe this member?"/>
                    </default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
