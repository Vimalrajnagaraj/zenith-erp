<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Campaigns" default-menu-index="1">

    <transition name="createCampaign" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.create#Campaign"/>
        <default-response url="../EditCampaign"/>
    </transition>
    <transition name="editCampaign"><default-response url="../EditCampaign"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.marketing.CampaignView" list="campaignList">
            <search-form-inputs default-order-by="-campaignId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Marketing Campaigns"/>
            <box-toolbar>
                <section name="mkt_NewCampaign_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCampaignDialog" button-text="New Campaign">
                    <form-single name="CreateCampaignForm" transition="createCampaign">
                        <field name="campaignName"><default-field title="Campaign Name"><text-line size="35"/></default-field></field>
                        <field name="campaignType"><default-field title="Type">
                            <drop-down no-current-selected-key="Email">
                                <option key="Email"/><option key="SMS"/><option key="Both" text="Email + SMS"/>
                            </drop-down></default-field></field>
                        <field name="contactListId"><default-field title="Contact List">
                            <drop-down allow-empty="true"><entity-options key="${listId}" text="${listName} (${totalSubscribers ?: 0})">
                                <entity-find entity-name="zenith.erp.marketing.ContactList">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="templateId"><default-field title="Email Template">
                            <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}">
                                <entity-find entity-name="zenith.erp.marketing.EmailTemplate">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="subject"><default-field title="Email Subject"><text-line size="50"/></default-field></field>
                        <field name="senderName"><default-field title="Sender Name"><text-line size="25"/></default-field></field>
                        <field name="senderEmail"><default-field title="Sender Email"><text-line size="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CampaignList" list="campaignList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <field name="campaignId"><default-field title="ID">
                        <link url="editCampaign" text="${campaignId}" link-type="anchor"
                              parameter-map="[campaignId:campaignId]"/></default-field></field>
                    <field name="campaignName"><header-field title="Name" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="campaignType"><header-field title="Type">
                            <drop-down allow-empty="true"><option key="Email"/><option key="SMS"/><option key="Both"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="listName"><default-field title="List"><display/></default-field></field>
                    <field name="templateName"><default-field title="Template"><display/></default-field></field>
                    <field name="statusId"><header-field title="Status">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="MarketingCampaign"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="scheduledDate"><header-field title="Scheduled" show-order-by="true"/>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="totalRecipients"><default-field title="Recipients"><display/></default-field></field>
                    <field name="totalSent"><default-field title="Sent"><display/></default-field></field>
                    <field name="totalOpened"><default-field title="Opened"><display/></default-field></field>
                    <field name="totalClicked"><default-field title="Clicked"><display/></default-field></field>
                    <field name="totalBounced"><default-field title="Bounced"><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
