<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Campaign" default-menu-index="2" default-menu-include="false">

    <parameter name="campaignId" required="true"/>

    <transition name="updateCampaign" begin-transaction="true">
        <service-call name="update#zenith.erp.marketing.MarketingCampaign"/>
        <default-response url="."/>
    </transition>
    <transition name="scheduleCampaign" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.schedule#Campaign"/>
        <default-response url="."/>
    </transition>
    <transition name="sendCampaign" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.send#Campaign"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelCampaign" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.cancel#Campaign"/>
        <default-response url="."/>
    </transition>
    <transition name="completeCampaign" begin-transaction="true">
        <service-call name="zenith.marketing.MarketingServices.complete#Campaign"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.marketing.MarketingCampaign" value-field="campaign"/>
        <entity-find entity-name="zenith.erp.marketing.CampaignRecipient" list="recipientList">
            <econdition field-name="campaignId"/>
            <order-by field-name="recipientSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6" md="12">
                <container-box><box-header title="Campaign: ${campaign.campaignName}"/>
                <box-body>
                    <form-single name="CampaignForm" transition="updateCampaign" map="campaign">
                        <field name="campaignId"><default-field><hidden/></default-field></field>
                        <field name="campaignName"><default-field title="Name"><text-line size="35"/></default-field></field>
                        <field name="campaignType"><default-field title="Type">
                            <drop-down><option key="Email"/><option key="SMS"/><option key="Both"/></drop-down></default-field></field>
                        <field name="contactListId"><default-field title="Contact List">
                            <drop-down allow-empty="true"><entity-options key="${listId}" text="${listName}">
                                <entity-find entity-name="zenith.erp.marketing.ContactList">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="templateId"><default-field title="Email Template">
                            <drop-down allow-empty="true"><entity-options key="${templateId}" text="${templateName}">
                                <entity-find entity-name="zenith.erp.marketing.EmailTemplate">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="subject"><default-field title="Subject"><text-line size="50"/></default-field></field>
                        <field name="senderName"><default-field title="Sender Name"><text-line size="25"/></default-field></field>
                        <field name="senderEmail"><default-field title="Sender Email"><text-line size="35"/></default-field></field>
                        <field name="smsGatewayId"><default-field title="SMS Gateway">
                            <drop-down allow-empty="true"><entity-options key="${gatewayId}" text="${gatewayName}">
                                <entity-find entity-name="zenith.erp.marketing.SmsGateway">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="smsMessage"><default-field title="SMS Message"><text-area rows="3" cols="45"/></default-field></field>
                        <field name="smsDltTemplateId"><default-field title="DLT Template ID"><text-line size="25"/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="6" md="12">
                <container-box><box-header title="Statistics"/>
                <box-body>
                    <form-single name="StatsForm" map="campaign">
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="scheduledDate"><default-field title="Scheduled"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="sentDate"><default-field title="Sent"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="totalRecipients"><default-field title="Recipients"><display/></default-field></field>
                        <field name="totalSent"><default-field title="Sent"><display/></default-field></field>
                        <field name="totalDelivered"><default-field title="Delivered"><display/></default-field></field>
                        <field name="totalOpened"><default-field title="Opened"><display/></default-field></field>
                        <field name="totalClicked"><default-field title="Clicked"><display/></default-field></field>
                        <field name="totalBounced"><default-field title="Bounced"><display/></default-field></field>
                        <field name="totalUnsubscribed"><default-field title="Unsubscribed"><display/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="DraftActions" condition="campaign.statusId == 'McpDraft'"><widgets>
                        <container-dialog id="ScheduleDialog" button-text="Schedule">
                            <form-single name="ScheduleForm" transition="scheduleCampaign">
                                <field name="campaignId"><default-field><hidden/></default-field></field>
                                <field name="scheduledDate"><default-field title="Send Date"><date-time/></default-field></field>
                                <field name="submitButton"><default-field title="Schedule"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <link url="sendCampaign" text="Send Now" parameter-map="[campaignId:campaignId]"
                              confirmation="Send campaign to all subscribers now?"/>
                    </widgets></section>
                    <section name="ScheduledActions" condition="campaign.statusId == 'McpScheduled'"><widgets>
                        <link url="cancelCampaign" text="Cancel" btn-type="danger"
                              parameter-map="[campaignId:campaignId]"
                              confirmation="Cancel this scheduled campaign?"/>
                    </widgets></section>
                    <section name="SendingActions" condition="campaign.statusId == 'McpSending'"><widgets>
                        <link url="completeCampaign" text="Mark Complete"
                              parameter-map="[campaignId:campaignId]"
                              confirmation="Mark this campaign as complete?"/>
                    </widgets></section>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Recipients -->
        <container-box>
            <box-header title="Recipients"/>
            <box-body>
                <form-list name="RecipientList" list="recipientList" skip-form="true">
                    <field name="recipientSeqId"><default-field title="#"><display/></default-field></field>
                    <field name="partyId"><default-field title="Party"><display/></default-field></field>
                    <field name="email"><default-field title="Email"><display/></default-field></field>
                    <field name="phone"><default-field title="Phone"><display/></default-field></field>
                    <field name="channel"><default-field title="Channel"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status"><display/></default-field></field>
                    <field name="sentDate"><default-field title="Sent"><display format="dd-MM HH:mm"/></default-field></field>
                    <field name="deliveredDate"><default-field title="Delivered"><display format="dd-MM HH:mm"/></default-field></field>
                    <field name="openedDate"><default-field title="Opened"><display format="dd-MM HH:mm"/></default-field></field>
                    <field name="clickedDate"><default-field title="Clicked"><display format="dd-MM HH:mm"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
