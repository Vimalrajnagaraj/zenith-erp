<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Email Template ========== -->
    <entity entity-name="EmailTemplate" package="zenith.erp.marketing" table-name="ZENITH_EMAIL_TEMPLATE" short-alias="EmailTemplates">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="templateName" type="text-medium"/>
        <field name="subject" type="text-medium"/>
        <field name="htmlContent" type="text-very-long"/>
        <field name="textContent" type="text-very-long"/>
        <field name="category" type="text-short"/>
        <field name="previewText" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Contact List ========== -->
    <entity entity-name="ContactList" package="zenith.erp.marketing" table-name="ZENITH_CONTACT_LIST" short-alias="ContactLists">
        <field name="listId" type="id" is-pk="true"/>
        <field name="listName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="listType" type="text-short"/>
        <field name="totalSubscribers" type="number-integer"/>
        <field name="isActive" type="text-indicator"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="ContactListMember" package="zenith.erp.marketing" short-alias="ContactListMembers">
        <field name="listId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="email" type="text-medium"/>
        <field name="phone" type="text-short"/>
        <field name="firstName" type="text-medium"/>
        <field name="lastName" type="text-medium"/>
        <field name="isSubscribed" type="text-indicator"/>
        <field name="subscribedDate" type="date-time"/>
        <field name="unsubscribedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.marketing.ContactList"/>
    </entity>

    <!-- ========== Marketing Campaign ========== -->
    <entity entity-name="MarketingCampaign" package="zenith.erp.marketing" table-name="ZENITH_MKTG_CAMPAIGN" short-alias="MarketingCampaigns">
        <field name="campaignId" type="id" is-pk="true"/>
        <field name="campaignName" type="text-medium"/>
        <field name="campaignType" type="text-short"/>
        <field name="templateId" type="id"/>
        <field name="contactListId" type="id"/>
        <field name="subject" type="text-medium"/>
        <field name="senderName" type="text-medium"/>
        <field name="senderEmail" type="text-medium"/>
        <field name="smsGatewayId" type="id"/>
        <field name="smsMessage" type="text-long"/>
        <field name="smsDltTemplateId" type="text-medium"/>
        <field name="scheduledDate" type="date-time"/>
        <field name="sentDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="totalRecipients" type="number-integer"/>
        <field name="totalSent" type="number-integer"/>
        <field name="totalDelivered" type="number-integer"/>
        <field name="totalOpened" type="number-integer"/>
        <field name="totalClicked" type="number-integer"/>
        <field name="totalBounced" type="number-integer"/>
        <field name="totalUnsubscribed" type="number-integer"/>
        <relationship type="one" related="zenith.erp.marketing.EmailTemplate"/>
        <relationship type="one" related="zenith.erp.marketing.ContactList" fk-name="FK_MC_CLIST">
            <key-map field-name="contactListId" related="listId"/></relationship>
        <relationship type="one" title="MarketingCampaign" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="MarketingCampaign" description="Marketing Campaign"/>
            <moqui.basic.StatusItem statusId="McpDraft" statusTypeId="MarketingCampaign" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="McpScheduled" statusTypeId="MarketingCampaign" description="Scheduled" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="McpSending" statusTypeId="MarketingCampaign" description="Sending" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="McpSent" statusTypeId="MarketingCampaign" description="Sent" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="McpCancelled" statusTypeId="MarketingCampaign" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="McpDraft" toStatusId="McpScheduled" transitionName="Schedule"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="McpDraft" toStatusId="McpSending" transitionName="Send Now"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="McpScheduled" toStatusId="McpSending" transitionName="Start Sending"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="McpScheduled" toStatusId="McpCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="McpSending" toStatusId="McpSent" transitionName="Complete"/>
        </seed-data>
    </entity>

    <!-- ========== Campaign Recipient ========== -->
    <entity entity-name="CampaignRecipient" package="zenith.erp.marketing" short-alias="CampaignRecipients">
        <field name="campaignId" type="id" is-pk="true"/>
        <field name="recipientSeqId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="email" type="text-medium"/>
        <field name="phone" type="text-short"/>
        <field name="channel" type="text-short"/>
        <field name="statusId" type="text-short"/>
        <field name="sentDate" type="date-time"/>
        <field name="deliveredDate" type="date-time"/>
        <field name="openedDate" type="date-time"/>
        <field name="clickedDate" type="date-time"/>
        <field name="bounceReason" type="text-medium"/>
        <relationship type="one" related="zenith.erp.marketing.MarketingCampaign"/>
    </entity>

    <!-- ========== SMS Gateway (Indian) ========== -->
    <entity entity-name="SmsGateway" package="zenith.erp.marketing" short-alias="SmsGateways">
        <field name="gatewayId" type="id" is-pk="true"/>
        <field name="gatewayName" type="text-medium"/>
        <field name="providerCode" type="text-short"/>
        <field name="apiKey" type="text-medium" encrypt="true"/>
        <field name="apiSecret" type="text-medium" encrypt="true"/>
        <field name="senderId" type="text-short"/>
        <field name="dltEntityId" type="text-medium"/>
        <field name="apiBaseUrl" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): per-tenant isolation for a table holding encrypted API secrets. -->
        <field name="organizationPartyId" type="id"/>
    </entity>

    <entity entity-name="SmsDltTemplate" package="zenith.erp.marketing" short-alias="SmsDltTemplates">
        <field name="dltTemplateId" type="id" is-pk="true"/>
        <field name="gatewayId" type="id"/>
        <field name="templateName" type="text-medium"/>
        <field name="templateContent" type="text-long"/>
        <field name="category" type="text-short"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.marketing.SmsGateway"/>
    </entity>

    <entity entity-name="SmsLog" package="zenith.erp.marketing" short-alias="SmsLogs">
        <field name="logId" type="id" is-pk="true"/>
        <field name="gatewayId" type="id"/>
        <field name="campaignId" type="id"/>
        <field name="phone" type="text-short"/>
        <field name="message" type="text-long"/>
        <field name="dltTemplateId" type="text-medium"/>
        <field name="statusId" type="text-short"/>
        <field name="sentDate" type="date-time"/>
        <field name="deliveredDate" type="date-time"/>
        <field name="apiMessageId" type="text-medium"/>
        <field name="apiResponse" type="text-long"/>
        <relationship type="one" related="zenith.erp.marketing.SmsGateway"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="CampaignView" package="zenith.erp.marketing">
        <member-entity entity-alias="MC" entity-name="zenith.erp.marketing.MarketingCampaign"/>
        <member-entity entity-alias="ET" entity-name="zenith.erp.marketing.EmailTemplate" join-from-alias="MC" join-optional="true">
            <key-map field-name="templateId"/></member-entity>
        <member-entity entity-alias="CL" entity-name="zenith.erp.marketing.ContactList" join-from-alias="MC" join-optional="true">
            <key-map field-name="contactListId" related="listId"/></member-entity>
        <alias-all entity-alias="MC"/>
        <alias entity-alias="ET" name="templateName"/>
        <alias entity-alias="CL" name="listName"/>
    </view-entity>

    <view-entity entity-name="ContactListMemberView" package="zenith.erp.marketing">
        <member-entity entity-alias="CLM" entity-name="zenith.erp.marketing.ContactListMember"/>
        <member-entity entity-alias="CL" entity-name="zenith.erp.marketing.ContactList" join-from-alias="CLM">
            <key-map field-name="listId"/></member-entity>
        <alias-all entity-alias="CLM"/>
        <alias entity-alias="CL" name="listName"/>
        <alias entity-alias="CL" name="organizationPartyId"/>
    </view-entity>
</entities>
