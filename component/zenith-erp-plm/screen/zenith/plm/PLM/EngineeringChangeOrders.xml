<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="ECOs" default-menu-index="1">

    <transition name="createEco">
        <service-call name="create#zenith.erp.plm.EngineeringChangeOrder"/>
        <default-response url="."/>
    </transition>

    <transition name="updateEco">
        <service-call name="update#zenith.erp.plm.EngineeringChangeOrder"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.plm.EngineeringChangeOrder" list="ecoList">
            <search-form-inputs default-order-by="-effectiveDate"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <condition name="statusTypeId" value="EcoStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Engineering Change Orders"/><box-toolbar>
            <container-dialog id="NewEcoDialog" button-text="New ECO">
                <form-single name="NewEcoForm" transition="createEco">
                    <field name="ecoNumber"><default-field title="ECO Number"><text-line size="20"/></default-field></field>
                    <field name="title"><default-field title="Title"><text-line size="40"/></default-field></field>
                    <field name="productId"><default-field title="Target Product">
                        <drop-down allow-empty="true">
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="requestedByPartyId"><default-field title="Requested By">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="EcoDraft">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="effectiveDate"><default-field title="Effective Date"><date-time/></default-field></field>
                    <field name="reasonForChange"><default-field title="Reason for Change"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Create ECO"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="EcoListForm" list="ecoList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="ecoId"><default-field><hidden/></default-field></field>
                <field name="ecoNumber">
                    <header-field title="ECO #" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="title">
                    <header-field title="Title" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="productId">
                    <header-field title="Product">
                        <drop-down allow-empty="true">
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="mantle.product.Product" text="${productName}"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <!-- Form inline to allow quick status updates / approvals -->
                    <default-field>
                        <form-single name="UpdateStatusForm" transition="updateEco">
                            <field name="ecoId"><default-field><hidden/></default-field></field>
                            <field name="statusId"><default-field title="">
                                <drop-down>
                                    <list-options list="statusList" key="${statusId}" text="${description}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="approvedByPartyId"><default-field title="Approved By">
                                <drop-down allow-empty="true">
                                    <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                        </form-single>
                    </default-field>
                </field>
                <field name="effectiveDate">
                    <header-field title="Effective Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
