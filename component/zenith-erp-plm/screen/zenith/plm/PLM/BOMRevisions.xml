<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="BOM Revisions" default-menu-index="2">

    <transition name="createRevision">
        <service-call name="create#zenith.erp.plm.BillOfMaterialRevision"/>
        <default-response url="."/>
    </transition>

    <transition name="updateRevision">
        <service-call name="update#zenith.erp.plm.BillOfMaterialRevision"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.product.Product" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="productId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.productId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.plm.BillOfMaterialRevision" list="revisionList">
            <search-form-inputs default-order-by="-effectiveFrom"/>
            <econdition field-name="productId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.plm.EngineeringChangeOrder" list="ecoList">
            <order-by field-name="-effectiveDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="BOM Revisions"/><box-toolbar>
            <section name="plm_NewRevision_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewRevisionDialog" button-text="New Revision">
                <form-single name="NewRevisionForm" transition="createRevision">
                    <field name="productId"><default-field title="Product Assembly">
                        <drop-down>
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="revisionString"><default-field title="Revision Code"><text-line size="10"/></default-field></field>
                    <field name="ecoId"><default-field title="Linked ECO">
                        <drop-down allow-empty="true">
                            <list-options list="ecoList" key="${ecoId}" text="${ecoNumber} - ${title}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="effectiveFrom"><default-field title="Effective From"><date-time/></default-field></field>
                    <field name="effectiveThru"><default-field title="Effective Thru"><date-time/></default-field></field>
                    <field name="notes"><default-field title="Notes"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Revision"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="RevisionListForm" list="revisionList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="bomRevisionId"><default-field><hidden/></default-field></field>
                <field name="productId">
                    <header-field title="Product">
                        <drop-down allow-empty="true">
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="mantle.product.Product" text="${productName}"/></default-field>
                </field>
                <field name="revisionString">
                    <header-field title="Revision" show-order-by="true"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="ecoId">
                    <header-field title="Linked ECO">
                        <drop-down allow-empty="true">
                            <list-options list="ecoList" key="${ecoId}" text="${ecoNumber}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="zenith.erp.plm.EngineeringChangeOrder" text="${ecoNumber} - ${title}"/></default-field>
                </field>
                <field name="effectiveFrom">
                    <header-field title="From Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="effectiveThru">
                    <header-field title="Thru Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
