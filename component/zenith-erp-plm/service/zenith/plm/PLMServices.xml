<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Engineering Change Order Lifecycle ========== -->

    <service verb="create" noun="EngineeringChangeOrder">
        <description>Create a new Engineering Change Order in EcoDraft status. Requester defaults to current user.</description>
        <in-parameters>
            <parameter name="ecoNumber" required="true"/>
            <parameter name="productId"/>
            <parameter name="title" required="true"/>
            <parameter name="reasonForChange"/>
            <parameter name="requestedByPartyId"/>
            <parameter name="effectiveDate"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ecoId"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="EcoDraft"/>

            <!-- Default requestedByPartyId from current user -->
            <if condition="!requestedByPartyId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                    <field-map field-name="userId" from="ec.user.userId"/>
                </entity-find-one>
                <set field="requestedByPartyId" from="userAccount?.partyId"/>
            </if>

            <service-call name="create#zenith.erp.plm.EngineeringChangeOrder" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="submit" noun="EngineeringChangeOrder">
        <description>Submit an ECO for review. Validates current status is EcoDraft.</description>
        <in-parameters>
            <parameter name="ecoId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.plm.EngineeringChangeOrder" value-field="eco"/>
            <if condition="!eco"><return error="true" message="Engineering Change Order [${ecoId}] not found."/></if>
            <if condition="eco.statusId != 'EcoDraft'">
                <return error="true" message="ECO [${ecoId}] must be in EcoDraft status to submit for review. Current status: ${eco.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.plm.EngineeringChangeOrder"
                          in-map="[ecoId: ecoId, statusId: 'EcoReview']"/>
        </actions>
    </service>

    <service verb="approve" noun="EngineeringChangeOrder">
        <description>Approve an ECO under review. Approver defaults to current user.</description>
        <in-parameters>
            <parameter name="ecoId" required="true"/>
            <parameter name="approvedByPartyId"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.plm.EngineeringChangeOrder" value-field="eco"/>
            <if condition="!eco"><return error="true" message="Engineering Change Order [${ecoId}] not found."/></if>
            <if condition="eco.statusId != 'EcoReview'">
                <return error="true" message="ECO [${ecoId}] must be in EcoReview status to approve. Current status: ${eco.statusId}"/>
            </if>

            <!-- Default approvedByPartyId from current user -->
            <if condition="!approvedByPartyId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                    <field-map field-name="userId" from="ec.user.userId"/>
                </entity-find-one>
                <set field="approvedByPartyId" from="userAccount?.partyId"/>
            </if>

            <service-call name="update#zenith.erp.plm.EngineeringChangeOrder"
                          in-map="[ecoId: ecoId, statusId: 'EcoApproved', approvedByPartyId: approvedByPartyId]"/>
        </actions>
    </service>

    <service verb="implement" noun="EngineeringChangeOrder">
        <description>Implement an approved ECO. Sets effectiveDate to now if not already set.</description>
        <in-parameters>
            <parameter name="ecoId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.plm.EngineeringChangeOrder" value-field="eco"/>
            <if condition="!eco"><return error="true" message="Engineering Change Order [${ecoId}] not found."/></if>
            <if condition="eco.statusId != 'EcoApproved'">
                <return error="true" message="ECO [${ecoId}] must be in EcoApproved status to implement. Current status: ${eco.statusId}"/>
            </if>

            <set field="updateMap" from="[ecoId: ecoId, statusId: 'EcoImplemented']"/>
            <!-- Set effectiveDate if not already set on the record -->
            <if condition="!eco.effectiveDate">
                <set field="updateMap.effectiveDate" from="ec.user.nowTimestamp"/>
            </if>

            <service-call name="update#zenith.erp.plm.EngineeringChangeOrder" in-map="updateMap"/>
        </actions>
    </service>

    <service verb="reject" noun="EngineeringChangeOrder">
        <description>Reject an ECO under review. Validates current status is EcoReview.</description>
        <in-parameters>
            <parameter name="ecoId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.plm.EngineeringChangeOrder" value-field="eco"/>
            <if condition="!eco"><return error="true" message="Engineering Change Order [${ecoId}] not found."/></if>
            <if condition="eco.statusId != 'EcoReview'">
                <return error="true" message="ECO [${ecoId}] must be in EcoReview status to reject. Current status: ${eco.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.plm.EngineeringChangeOrder"
                          in-map="[ecoId: ecoId, statusId: 'EcoRejected']"/>
        </actions>
    </service>

    <!-- ========== Bill of Material Revision Services ========== -->

    <service verb="create" noun="BillOfMaterialRevision">
        <description>Create a new BOM revision record.</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
            <parameter name="revisionString" required="true"/>
            <parameter name="ecoId"/>
            <parameter name="effectiveFrom"/>
            <parameter name="effectiveThru"/>
            <parameter name="notes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="bomRevisionId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.plm.BillOfMaterialRevision" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="update" noun="BillOfMaterialRevision">
        <description>Update an existing BOM revision record.</description>
        <in-parameters>
            <parameter name="bomRevisionId" required="true"/>
            <parameter name="productId"/>
            <parameter name="revisionString"/>
            <parameter name="ecoId"/>
            <parameter name="effectiveFrom"/>
            <parameter name="effectiveThru"/>
            <parameter name="notes"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.plm.BillOfMaterialRevision" in-map="context"/>
        </actions>
    </service>

</services>
