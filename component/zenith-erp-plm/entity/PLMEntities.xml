<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="EngineeringChangeOrder" package="zenith.erp.plm">
        <field name="ecoId" type="id" is-pk="true"/>
        <field name="ecoNumber" type="text-short"/>
        <field name="productId" type="id"/>
        <field name="title" type="text-medium"/>
        <field name="reasonForChange" type="text-long"/>
        <field name="requestedByPartyId" type="id"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="effectiveDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" title="RequestedBy" related="mantle.party.Party">
            <key-map field-name="requestedByPartyId" related="partyId"/></relationship>
        <relationship type="one" title="ApprovedBy" related="mantle.party.Party">
            <key-map field-name="approvedByPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="EcoStatus" description="ECO Status"/>
            <moqui.basic.StatusItem statusId="EcoDraft" statusTypeId="EcoStatus" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EcoReview" statusTypeId="EcoStatus" description="Under Review" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EcoApproved" statusTypeId="EcoStatus" description="Approved" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EcoImplemented" statusTypeId="EcoStatus" description="Implemented" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="EcoRejected" statusTypeId="EcoStatus" description="Rejected" sequenceNum="5"/>
        </seed-data>
    </entity>

    <entity entity-name="BillOfMaterialRevision" package="zenith.erp.plm">
        <field name="bomRevisionId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="revisionString" type="text-short"/>
        <field name="ecoId" type="id"><description>Linked ECO that introduced this revision</description></field>
        <field name="effectiveFrom" type="date-time"/>
        <field name="effectiveThru" type="date-time"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="zenith.erp.plm.EngineeringChangeOrder"/>
    </entity>

</entities>
