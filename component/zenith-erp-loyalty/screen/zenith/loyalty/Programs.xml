<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Programs" default-menu-index="3">

    <transition name="createProgram">
        <service-call name="zenith.loyalty.LoyaltyServices.create#LoyaltyProgram"/>
        <default-response url="."/>
    </transition>
    <transition name="addTier">
        <service-call name="create#zenith.erp.loyalty.LoyaltyTier"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteTier">
        <service-call name="delete#zenith.erp.loyalty.LoyaltyTier"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.loyalty.LoyaltyProgram" list="programs">
            <order-by field-name="programName"/>
        </entity-find>
        <set field="selectedProgramId" from="programId ?: (programs ? programs[0].programId : null)"/>
        <if condition="selectedProgramId">
            <entity-find-one entity-name="zenith.erp.loyalty.LoyaltyProgram" value-field="selectedProgram">
                <field-map field-name="programId" from="selectedProgramId"/>
            </entity-find-one>
            <entity-find entity-name="zenith.erp.loyalty.LoyaltyTier" list="tiers">
                <econdition field-name="programId" from="selectedProgramId"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>
        </if>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Loyalty Programs" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateProgram" button-text="New Program" type="success">
                <form-single name="CreateProgramForm" transition="createProgram">
                    <field name="programName"><default-field title="Name"><text-line size="30"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="pointsPerCurrencyUnit"><default-field title="Points per Currency Unit"><text-line size="8" default-value="1"/></default-field></field>
                    <field name="pointRedemptionValue"><default-field title="Point Value (currency)"><text-line size="8" default-value="0.01"/></default-field></field>
                    <field name="minRedemptionPoints"><default-field title="Min Redemption"><text-line size="8" default-value="100"/></default-field></field>
                    <field name="pointExpiryDays"><default-field title="Point Expiry (days)"><text-line size="8"/></default-field></field>
                    <field name="tierEnabled"><default-field title="Enable Tiers?">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="ProgramsForm" list="programs" skip-form="true">
                <field name="programName"><default-field title="Program"><display/></default-field></field>
                <field name="pointsPerCurrencyUnit"><default-field title="Pts/Unit"><display/></default-field></field>
                <field name="pointRedemptionValue"><default-field title="Pt Value"><display/></default-field></field>
                <field name="minRedemptionPoints"><default-field title="Min Redeem"><display/></default-field></field>
                <field name="pointExpiryDays"><default-field title="Expiry Days"><display/></default-field></field>
                <field name="tierEnabled"><default-field title="Tiers"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
            </form-list>
        </container>

        <section name="TierSection" condition="selectedProgram &amp;&amp; selectedProgram.tierEnabled == 'Y'">
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Tiers for: ${selectedProgram.programName}" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="AddTier" button-text="Add Tier" type="success">
                            <form-single name="AddTierForm" transition="addTier">
                                <field name="programId"><default-field><hidden default-value="${selectedProgramId}"/></default-field></field>
                                <field name="tierName"><default-field title="Tier Name"><text-line size="20"/></default-field></field>
                                <field name="minPoints"><default-field title="Min Points"><text-line size="10"/></default-field></field>
                                <field name="pointMultiplier"><default-field title="Point Multiplier"><text-line size="5" default-value="1"/></default-field></field>
                                <field name="discountPercent"><default-field title="Discount %"><text-line size="5"/></default-field></field>
                                <field name="sequenceNum"><default-field title="Order"><text-line size="3"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="TiersForm" list="tiers" skip-form="true">
                        <field name="tierName"><default-field title="Tier"><display/></default-field></field>
                        <field name="minPoints"><default-field title="Min Points"><display/></default-field></field>
                        <field name="pointMultiplier"><default-field title="Multiplier"><display/></default-field></field>
                        <field name="discountPercent"><default-field title="Discount %"><display/></default-field></field>
                        <field name="freeShipping"><default-field title="Free Ship"><display/></default-field></field>
                        <field name="deleteBtn"><default-field title="">
                            <link url="deleteTier" text="Remove" parameter-map="[tierId:tierId]"
                                  confirmation="Remove this tier?" style="text-negative"/>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
