<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rewards" default-menu-index="4">

    <transition name="createReward">
        <service-call name="create#zenith.erp.loyalty.LoyaltyReward"/>
        <default-response url="."/>
    </transition>
    <transition name="updateReward">
        <service-call name="update#zenith.erp.loyalty.LoyaltyReward"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.loyalty.LoyaltyReward" list="rewards">
            <order-by field-name="pointsCost"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Loyalty Rewards" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateReward" button-text="New Reward" type="success">
                <form-single name="CreateRewardForm" transition="createReward">
                    <field name="programId"><default-field title="Program">
                        <drop-down><entity-options key="${programId}" text="${programName}">
                            <entity-find entity-name="zenith.erp.loyalty.LoyaltyProgram">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="rewardName"><default-field title="Reward Name"><text-line size="30"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="pointsCost"><default-field title="Points Cost"><text-line size="8"/></default-field></field>
                    <field name="rewardTypeEnumId"><default-field title="Reward Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="LoyaltyRewardType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="rewardValue"><default-field title="Value"><text-line size="10"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="RewardsForm" list="rewards" skip-form="true">
                <field name="rewardName"><default-field title="Reward"><display/></default-field></field>
                <field name="pointsCost"><default-field title="Points"><display/></default-field></field>
                <field name="rewardTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="rewardValue"><default-field title="Value"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
