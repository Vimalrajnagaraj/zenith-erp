<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Members" default-menu-index="2">

    <transition name="editMember"><default-response url="../EditMember"/></transition>
    <transition name="enrollMember">
        <service-call name="zenith.loyalty.LoyaltyServices.enroll#Member"/>
        <default-response url="../EditMember"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.loyalty.LoyaltyMemberDetail" list="members">
            <search-form-inputs default-order-by="-enrollDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Loyalty Members" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="EnrollMember" button-text="Enroll Member" type="success">
                <form-single name="EnrollForm" transition="enrollMember">
                    <field name="programId"><default-field title="Program">
                        <drop-down><entity-options key="${programId}" text="${programName}">
                            <entity-find entity-name="zenith.erp.loyalty.LoyaltyProgram">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="partyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}">
                            <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                <econdition field-name="roleTypeId" value="Customer"/>
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="welcomeBonus"><default-field title="Welcome Bonus Points"><text-line size="8" default-value="0"/></default-field></field>
                    <field name="submitBtn"><default-field title="Enroll"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="MembersForm" list="members" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="memberNumber"><header-field show-order-by="true"><text-find size="12"/></header-field>
                    <default-field title="Member #">
                        <link url="editMember" text="${memberNumber}" parameter-map="[memberId:memberId]"/>
                    </default-field></field>
                <field name="partyId"><header-field show-order-by="true"><text-find size="12"/></header-field>
                    <default-field title="Customer"><display/></default-field></field>
                <field name="programName"><default-field title="Program"><display/></default-field></field>
                <field name="tierName"><default-field title="Tier"><display/></default-field></field>
                <field name="currentPoints"><header-field show-order-by="true"/>
                    <default-field title="Points"><display/></default-field></field>
                <field name="lifetimePoints"><default-field title="Lifetime"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="LmActive" text="Active"/><option key="LmSuspended" text="Suspended"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
                <field name="enrollDate"><default-field title="Enrolled"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
