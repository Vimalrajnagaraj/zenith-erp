<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.loyalty.LoyaltyMember" count-field="totalMembers">
            <econdition field-name="statusId" value="LmActive"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.loyalty.LoyaltyProgram" count-field="totalPrograms">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.loyalty.PointTransaction" count-field="totalTransactions"/>

        <entity-find entity-name="zenith.erp.loyalty.PointTransaction" list="recentTxns" limit="10">
            <econdition field-name="transactionTypeEnumId" value="PttEarn"/>
            <order-by field-name="-transactionDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Loyalty Overview" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage loyalty programs, members, and rewards." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Members" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalMembers}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="people" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Programs" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalPrograms}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-amber-1 border-radius-md text-amber-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="star" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Transactions" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${totalTransactions}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="swap_horiz" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Points Earned" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentTxns" list="recentTxns" skip-form="true">
                <field name="memberId"><default-field title="Member"><display/></default-field></field>
                <field name="points"><default-field><display/></default-field></field>
                <field name="referenceTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="description"><default-field><display/></default-field></field>
                <field name="transactionDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
