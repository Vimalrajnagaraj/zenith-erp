<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Member" default-menu-include="false">

    <parameter name="memberId" required="true"/>

    <transition name="earnPoints">
        <service-call name="zenith.loyalty.LoyaltyServices.earn#Points"/>
        <default-response url="."/>
    </transition>
    <transition name="redeemPoints">
        <service-call name="zenith.loyalty.LoyaltyServices.redeem#Points"/>
        <default-response url="."/>
    </transition>
    <transition name="updateStatus">
        <service-call name="update#zenith.erp.loyalty.LoyaltyMember"/>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="zenith.loyalty.LoyaltyServices.get#MemberDashboard"
                      in-map="[memberId:memberId]" out-map="dash"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Member: ${dash.member.memberNumber}" type="h4" style="text-weight-bold q-my-none"/>
            <link url="../FindMember" text="Back to Members" style="text-primary"/>
        </container>

        <!-- Member Info Cards -->
        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Current Points" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dash.member.currentPoints ?: 0}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Worth ${zinr.inr(ec.l10n.format(dash.redemptionValue, '#,##0.00'))}" type="p" style="text-grey-6 q-mt-xs"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Lifetime Points" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dash.member.lifetimePoints ?: 0}" type="h3" style="text-dark text-weight-bold q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Tier" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dash.tier?.tierName ?: 'None'}" type="h3" style="text-amber-8 text-weight-bold q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dash.member.statusId == 'LmActive' ? 'Active' : 'Inactive'}" type="h3"
                           style="${dash.member.statusId == 'LmActive' ? 'text-green-8' : 'text-red-8'} text-weight-bold q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Quick Actions -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <label text="Quick Actions" type="h5" style="text-weight-bold q-mb-md"/>
            <container style="row q-gutter-md">
                <container-dialog id="EarnPointsDlg" button-text="Award Points" type="success">
                    <form-single name="EarnForm" transition="earnPoints">
                        <field name="memberId"><default-field><hidden default-value="${memberId}"/></default-field></field>
                        <field name="points"><default-field title="Points"><text-line size="10"/></default-field></field>
                        <field name="referenceTypeEnumId"><default-field title="Reason">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="PointReferenceType"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="description"><default-field><text-line size="30"/></default-field></field>
                        <field name="submitBtn"><default-field title="Award"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <container-dialog id="RedeemPointsDlg" button-text="Redeem Points" type="warning">
                    <form-single name="RedeemForm" transition="redeemPoints">
                        <field name="memberId"><default-field><hidden default-value="${memberId}"/></default-field></field>
                        <field name="points"><default-field title="Points to Redeem"><text-line size="10"/></default-field></field>
                        <field name="description"><default-field><text-line size="30"/></default-field></field>
                        <field name="submitBtn"><default-field title="Redeem"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <!-- Point History -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <label text="Point History" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="TxnHistory" list="dash.recentTransactions" skip-form="true">
                <field name="transactionTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="points"><default-field><display/></default-field></field>
                <field name="referenceTypeEnumId"><default-field title="Reason">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="description"><default-field><display/></default-field></field>
                <field name="transactionDate"><default-field title="Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
