<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Loyalty Program ========== -->
    <entity entity-name="LoyaltyProgram" package="zenith.erp.loyalty" short-alias="LoyaltyPrograms">
        <field name="programId" type="id" is-pk="true"/>
        <field name="programName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="organizationPartyId" type="id"/>
        <field name="pointsPerCurrencyUnit" type="number-decimal" default="1"/>
        <field name="pointRedemptionValue" type="number-decimal" default="0.01"/>
        <field name="minRedemptionPoints" type="number-integer" default="100"/>
        <field name="pointExpiryDays" type="number-integer"/>
        <field name="tierEnabled" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== Loyalty Tier ========== -->
    <entity entity-name="LoyaltyTier" package="zenith.erp.loyalty" short-alias="LoyaltyTiers">
        <field name="tierId" type="id" is-pk="true"/>
        <field name="programId" type="id"/>
        <field name="tierName" type="text-medium"/>
        <field name="minPoints" type="number-integer"/>
        <field name="pointMultiplier" type="number-decimal" default="1"/>
        <field name="discountPercent" type="number-decimal"/>
        <field name="freeShipping" type="text-indicator" default="'N'"/>
        <field name="prioritySupport" type="text-indicator" default="'N'"/>
        <field name="sequenceNum" type="number-integer"/>
        <relationship type="one" related="zenith.erp.loyalty.LoyaltyProgram"/>
    </entity>

    <!-- ========== Loyalty Member ========== -->
    <entity entity-name="LoyaltyMember" package="zenith.erp.loyalty" short-alias="LoyaltyMembers">
        <field name="memberId" type="id" is-pk="true"/>
        <field name="programId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="memberNumber" type="text-short"/>
        <field name="currentPoints" type="number-integer" default="0"/>
        <field name="lifetimePoints" type="number-integer" default="0"/>
        <field name="tierId" type="id"/>
        <field name="enrollDate" type="date-time"/>
        <field name="statusId" type="id" default="'LmActive'"/>
        <relationship type="one" related="zenith.erp.loyalty.LoyaltyProgram"/>
        <relationship type="one" related="zenith.erp.loyalty.LoyaltyTier"/>
        <relationship type="one" related="mantle.party.Party"/>
        <index name="LM_PARTY" unique="true">
            <index-field name="programId"/>
            <index-field name="partyId"/>
        </index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="LoyaltyMember" description="Loyalty Member"/>
            <moqui.basic.StatusItem statusId="LmActive" statusTypeId="LoyaltyMember" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="LmSuspended" statusTypeId="LoyaltyMember" description="Suspended" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="LmClosed" statusTypeId="LoyaltyMember" description="Closed" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LmActive" toStatusId="LmSuspended" transitionName="Suspend"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LmActive" toStatusId="LmClosed" transitionName="Close"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LmSuspended" toStatusId="LmActive" transitionName="Reactivate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="LmSuspended" toStatusId="LmClosed" transitionName="Close"/>
        </seed-data>
    </entity>

    <!-- ========== Point Transaction ========== -->
    <entity entity-name="PointTransaction" package="zenith.erp.loyalty" short-alias="PointTransactions">
        <field name="transactionId" type="id" is-pk="true"/>
        <field name="memberId" type="id"/>
        <field name="transactionTypeEnumId" type="id"/>
        <field name="points" type="number-integer"/>
        <field name="referenceTypeEnumId" type="id"/>
        <field name="referenceId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="transactionDate" type="date-time"/>
        <field name="expiryDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.loyalty.LoyaltyMember"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PointTransactionType" description="Point Transaction Type"/>
            <moqui.basic.Enumeration enumId="PttEarn" enumTypeId="PointTransactionType" description="Earn" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PttRedeem" enumTypeId="PointTransactionType" description="Redeem" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PttExpire" enumTypeId="PointTransactionType" description="Expire" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PttAdjust" enumTypeId="PointTransactionType" description="Adjustment" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PttBonus" enumTypeId="PointTransactionType" description="Bonus" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PttReturn" enumTypeId="PointTransactionType" description="Return Reversal" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="PointReferenceType" description="Point Reference Type"/>
            <moqui.basic.Enumeration enumId="PrtSale" enumTypeId="PointReferenceType" description="Sale" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PrtReturn" enumTypeId="PointReferenceType" description="Return" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="PrtBirthday" enumTypeId="PointReferenceType" description="Birthday Bonus" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="PrtWelcome" enumTypeId="PointReferenceType" description="Welcome Bonus" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="PrtPromotion" enumTypeId="PointReferenceType" description="Promotion Bonus" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="PrtManual" enumTypeId="PointReferenceType" description="Manual Adjustment" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Loyalty Reward ========== -->
    <entity entity-name="LoyaltyReward" package="zenith.erp.loyalty" short-alias="LoyaltyRewards">
        <field name="rewardId" type="id" is-pk="true"/>
        <field name="programId" type="id"/>
        <field name="rewardName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="pointsCost" type="number-integer"/>
        <field name="rewardTypeEnumId" type="id"/>
        <field name="rewardValue" type="number-decimal"/>
        <field name="productId" type="id"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.loyalty.LoyaltyProgram"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="LoyaltyRewardType" description="Loyalty Reward Type"/>
            <moqui.basic.Enumeration enumId="LrtDiscount" enumTypeId="LoyaltyRewardType" description="Discount" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="LrtFreeProduct" enumTypeId="LoyaltyRewardType" description="Free Product" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="LrtVoucher" enumTypeId="LoyaltyRewardType" description="Voucher" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="LrtCashback" enumTypeId="LoyaltyRewardType" description="Cashback" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="LoyaltyMemberDetail" package="zenith.erp.loyalty">
        <member-entity entity-alias="LM" entity-name="zenith.erp.loyalty.LoyaltyMember"/>
        <member-entity entity-alias="LP" entity-name="zenith.erp.loyalty.LoyaltyProgram" join-from-alias="LM">
            <key-map field-name="programId"/>
        </member-entity>
        <member-entity entity-alias="LT" entity-name="zenith.erp.loyalty.LoyaltyTier" join-from-alias="LM" join-optional="true">
            <key-map field-name="tierId"/>
        </member-entity>
        <alias entity-alias="LM" name="memberId"/>
        <alias entity-alias="LM" name="partyId"/>
        <alias entity-alias="LM" name="memberNumber"/>
        <alias entity-alias="LM" name="currentPoints"/>
        <alias entity-alias="LM" name="lifetimePoints"/>
        <alias entity-alias="LM" name="enrollDate"/>
        <alias entity-alias="LM" name="statusId"/>
        <alias entity-alias="LP" name="programName"/>
        <alias entity-alias="LP" name="organizationPartyId"/>
        <alias entity-alias="LT" name="tierName"/>
    </view-entity>

</entities>
