<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- US-specific Party fields -->
    <extend-entity entity-name="Party" package="mantle.party">
        <field name="einNumber" type="text-short"><description>Employer Identification Number</description></field>
        <field name="ssnLast4" type="text-short"><description>Last 4 of SSN (for 1099 reporting)</description></field>
    </extend-entity>

    <!-- US-specific Employee fields -->
    <extend-entity entity-name="Employee" package="zenith.erp.hr">
        <field name="ssn" type="text-short"><description>Social Security Number (encrypted)</description></field>
        <field name="w4FilingStatus" type="text-short"><description>W-4 filing status</description></field>
        <field name="w4Allowances" type="number-integer"/>
        <field name="stateWithholdingExempt" type="text-indicator"/>
    </extend-entity>

    <!-- Nexus Configuration: where the company has tax obligation -->
    <entity entity-name="NexusConfiguration" package="zenith.erp.us" short-alias="NexusConfiguration">
        <field name="nexusId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="stateGeoId" type="id"/>
        <field name="nexusTypeEnumId" type="id"/>
        <field name="effectiveDate" type="date"/>
        <field name="registrationNumber" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="NexusType" description="Nexus Type"/>
            <moqui.basic.Enumeration enumId="NxPhysical" enumTypeId="NexusType" description="Physical Presence" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="NxEconomic" enumTypeId="NexusType" description="Economic Nexus" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="NxClickThrough" enumTypeId="NexusType" description="Click-Through Nexus" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="NxAffiliate" enumTypeId="NexusType" description="Affiliate Nexus" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="NxMarketplace" enumTypeId="NexusType" description="Marketplace Nexus" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- US Tax Jurisdiction: multi-level (state + county + city + special district) -->
    <entity entity-name="UsTaxJurisdiction" package="zenith.erp.us" short-alias="UsTaxJurisdiction">
        <field name="jurisdictionId" type="id" is-pk="true"/>
        <field name="stateGeoId" type="id"/>
        <field name="countyName" type="text-medium"/>
        <field name="cityName" type="text-medium"/>
        <field name="specialDistrictName" type="text-medium"/>
        <field name="zipCode" type="text-short"/>
        <field name="stateRate" type="number-decimal" default="0"/>
        <field name="countyRate" type="number-decimal" default="0"/>
        <field name="cityRate" type="number-decimal" default="0"/>
        <field name="specialRate" type="number-decimal" default="0"/>
        <field name="combinedRate" type="number-decimal" default="0"/>
        <field name="effectiveDate" type="date"/>
        <field name="expirationDate" type="date"/>
    </entity>

    <!-- Tax Holiday -->
    <entity entity-name="TaxHoliday" package="zenith.erp.us" short-alias="TaxHoliday">
        <field name="taxHolidayId" type="id" is-pk="true"/>
        <field name="stateGeoId" type="id"/>
        <field name="holidayName" type="text-medium"/>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="maxItemPrice" type="currency-amount"/>
        <field name="applicableCategories" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- 1099 Tracking -->
    <entity entity-name="Form1099Tracking" package="zenith.erp.us" short-alias="Form1099Tracking">
        <field name="tracking1099Id" type="id" is-pk="true"/>
        <field name="vendorPartyId" type="id"/>
        <field name="taxYear" type="number-integer"/>
        <field name="totalPayments" type="currency-amount" default="0"/>
        <field name="threshold1099" type="currency-amount" default="600"/>
        <field name="requires1099" type="text-indicator" default="'N'"/>
        <field name="form1099Filed" type="text-indicator" default="'N'"/>
        <field name="filedDate" type="date"/>
        <relationship type="one" related="mantle.party.Party" short-alias="vendor">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
    </entity>

    <!-- Sales Tax Return -->
    <entity entity-name="SalesTaxReturn" package="zenith.erp.us" short-alias="SalesTaxReturn">
        <field name="taxReturnId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="stateGeoId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="grossSales" type="currency-amount" default="0"/>
        <field name="exemptSales" type="currency-amount" default="0"/>
        <field name="taxableSales" type="currency-amount" default="0"/>
        <field name="taxCollected" type="currency-amount" default="0"/>
        <field name="taxDue" type="currency-amount" default="0"/>
        <field name="filingDeadline" type="date"/>
        <field name="statusId" type="id"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="SalesTaxReturn" description="Sales Tax Return Status"/>
            <moqui.basic.StatusItem statusId="StrDraft" statusTypeId="SalesTaxReturn" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="StrCalculated" statusTypeId="SalesTaxReturn" description="Calculated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="StrFiled" statusTypeId="SalesTaxReturn" description="Filed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="StrPaid" statusTypeId="SalesTaxReturn" description="Paid" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StrDraft" toStatusId="StrCalculated" transitionName="Calculate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StrCalculated" toStatusId="StrFiled" transitionName="File"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="StrFiled" toStatusId="StrPaid" transitionName="Mark Paid"/>
        </seed-data>
    </entity>

</entities>
