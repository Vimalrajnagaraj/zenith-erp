<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Shift Definition -->
    <entity entity-name="WorkShift" package="zenith.erp.attendance" short-alias="WorkShifts">
        <field name="shiftId" type="id" is-pk="true"/>
        <field name="shiftName" type="text-medium"/>
        <field name="shiftCode" type="text-short"/>
        <field name="startTime" type="text-short"/>
        <field name="endTime" type="text-short"/>
        <field name="graceMinutes" type="number-integer" default="15"/>
        <field name="halfDayHours" type="number-decimal" default="4"/>
        <field name="fullDayHours" type="number-decimal" default="8"/>
        <field name="isNightShift" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- Attendance Policy -->
    <entity entity-name="AttendancePolicy" package="zenith.erp.attendance" short-alias="AttendancePolicies">
        <field name="policyId" type="id" is-pk="true"/>
        <field name="policyName" type="text-medium"/>
        <field name="defaultShiftId" type="id"/>
        <field name="weeklyOffDays" type="text-medium"/>
        <field name="minHoursFullDay" type="number-decimal" default="8"/>
        <field name="minHoursHalfDay" type="number-decimal" default="4"/>
        <field name="overtimeAfterHours" type="number-decimal" default="9"/>
        <field name="overtimeRateMultiplier" type="number-decimal" default="1.5"/>
        <field name="autoDeductBreakMinutes" type="number-integer" default="30"/>
        <field name="lateMarkAfterMinutes" type="number-integer" default="15"/>
        <field name="lateMarksForHalfDay" type="number-integer" default="3"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.attendance.WorkShift">
            <key-map field-name="defaultShiftId" related="shiftId"/></relationship>
    </entity>

    <!-- Employee Shift Assignment -->
    <entity entity-name="EmployeeShift" package="zenith.erp.attendance" short-alias="EmployeeShifts">
        <field name="employeeShiftId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="shiftId" type="id"/>
        <field name="policyId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.attendance.WorkShift"/>
        <relationship type="one" related="zenith.erp.attendance.AttendancePolicy"/>
    </entity>

    <!-- Daily Attendance Record -->
    <entity entity-name="AttendanceRecord" package="zenith.erp.attendance" short-alias="AttendanceRecords">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="attendanceDate" type="date-time"/>
        <field name="shiftId" type="id"/>
        <field name="clockIn" type="date-time"/>
        <field name="clockOut" type="date-time"/>
        <field name="totalHours" type="number-decimal"/>
        <field name="overtimeHours" type="number-decimal"/>
        <field name="breakMinutes" type="number-integer"/>
        <field name="attendanceStatus" type="id"/>
        <field name="isLate" type="text-indicator" default="'N'"/>
        <field name="lateMinutes" type="number-integer"/>
        <field name="isEarlyOut" type="text-indicator" default="'N'"/>
        <field name="earlyOutMinutes" type="number-integer"/>
        <field name="source" type="id"/>
        <field name="deviceId" type="text-short"/>
        <field name="locationName" type="text-medium"/>
        <field name="notes" type="text-medium"/>
        <field name="regularizedByPartyId" type="id"/>
        <field name="regularizedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.attendance.WorkShift"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AttendanceStatus" description="Attendance Status"/>
            <moqui.basic.Enumeration enumId="AttSt_PRESENT" enumTypeId="AttendanceStatus" description="Present" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AttSt_ABSENT" enumTypeId="AttendanceStatus" description="Absent" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="AttSt_HALFDAY" enumTypeId="AttendanceStatus" description="Half Day" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="AttSt_ONLEAVE" enumTypeId="AttendanceStatus" description="On Leave" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="AttSt_HOLIDAY" enumTypeId="AttendanceStatus" description="Holiday" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="AttSt_WEEKOFF" enumTypeId="AttendanceStatus" description="Weekly Off" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="AttSt_WFH" enumTypeId="AttendanceStatus" description="Work From Home" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="AttSt_ONDUTY" enumTypeId="AttendanceStatus" description="On Duty / Deputation" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="AttSt_COMPOFF" enumTypeId="AttendanceStatus" description="Comp Off" sequenceNum="9"/>

            <moqui.basic.EnumerationType enumTypeId="AttendanceSource" description="Attendance Source"/>
            <moqui.basic.Enumeration enumId="AttSrc_MANUAL" enumTypeId="AttendanceSource" description="Manual Entry" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AttSrc_BIOMETRIC" enumTypeId="AttendanceSource" description="Biometric Device" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="AttSrc_RFID" enumTypeId="AttendanceSource" description="RFID Card" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="AttSrc_MOBILE" enumTypeId="AttendanceSource" description="Mobile App" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="AttSrc_WEB" enumTypeId="AttendanceSource" description="Web Portal" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="AttSrc_IMPORT" enumTypeId="AttendanceSource" description="CSV/Excel Import" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="AttSrc_REGULARIZE" enumTypeId="AttendanceSource" description="Regularized" sequenceNum="7"/>
        </seed-data>
    </entity>

    <!-- Attendance Regularization Request -->
    <entity entity-name="RegularizationRequest" package="zenith.erp.attendance" short-alias="RegularizationRequests">
        <field name="requestId" type="id" is-pk="true"/>
        <field name="recordId" type="id"/>
        <field name="employeePartyId" type="id"/>
        <field name="requestDate" type="date-time"/>
        <field name="attendanceDate" type="date-time"/>
        <field name="requestedClockIn" type="date-time"/>
        <field name="requestedClockOut" type="date-time"/>
        <field name="reason" type="text-long"/>
        <field name="statusId" type="id"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="approvedDate" type="date-time"/>
        <field name="rejectionReason" type="text-medium"/>
        <relationship type="one" related="zenith.erp.attendance.AttendanceRecord">
            <key-map field-name="recordId"/></relationship>
        <relationship type="one" title="RegularizationRequest" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="RegularizationReq" description="Regularization Request"/>
            <moqui.basic.StatusItem statusId="RgPending" statusTypeId="RegularizationReq" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RgApproved" statusTypeId="RegularizationReq" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RgRejected" statusTypeId="RegularizationReq" description="Rejected" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgPending" toStatusId="RgApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RgPending" toStatusId="RgRejected" transitionName="Reject"/>
        </seed-data>
    </entity>

    <!-- Holiday Calendar -->
    <entity entity-name="Holiday" package="zenith.erp.attendance" short-alias="Holidays">
        <field name="holidayId" type="id" is-pk="true"/>
        <field name="holidayName" type="text-medium"/>
        <field name="holidayDate" type="date-time"/>
        <field name="holidayType" type="id"/>
        <field name="isOptional" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="HolidayType" description="Holiday Type"/>
            <moqui.basic.Enumeration enumId="HolType_NATIONAL" enumTypeId="HolidayType" description="National Holiday" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="HolType_STATE" enumTypeId="HolidayType" description="State Holiday" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="HolType_RESTRICTED" enumTypeId="HolidayType" description="Restricted Holiday" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="HolType_COMPANY" enumTypeId="HolidayType" description="Company Holiday" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- Overtime Record -->
    <entity entity-name="OvertimeRecord" package="zenith.erp.attendance" short-alias="OvertimeRecords">
        <field name="overtimeId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id"/>
        <field name="overtimeDate" type="date-time"/>
        <field name="hours" type="number-decimal"/>
        <field name="rateMultiplier" type="number-decimal" default="1.5"/>
        <field name="reason" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="approvedByPartyId" type="id"/>
        <relationship type="one" title="OvertimeRecord" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="OvertimeRecord" description="Overtime Record"/>
            <moqui.basic.StatusItem statusId="OtPending" statusTypeId="OvertimeRecord" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="OtApproved" statusTypeId="OvertimeRecord" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="OtRejected" statusTypeId="OvertimeRecord" description="Rejected" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="OtPending" toStatusId="OtApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="OtPending" toStatusId="OtRejected" transitionName="Reject"/>
        </seed-data>
    </entity>

    <!-- View: Attendance with shift info -->
    <view-entity entity-name="AttendanceRecordView" package="zenith.erp.attendance">
        <member-entity entity-alias="AR" entity-name="zenith.erp.attendance.AttendanceRecord"/>
        <member-entity entity-alias="WS" entity-name="zenith.erp.attendance.WorkShift" join-from-alias="AR" join-optional="true">
            <key-map field-name="shiftId"/></member-entity>
        <alias-all entity-alias="AR"/>
        <alias entity-alias="WS" name="shiftName"/>
        <alias entity-alias="WS" name="startTime" field="startTime"/>
        <alias entity-alias="WS" name="endTime" field="endTime"/>
    </view-entity>
</entities>
