<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Regularizations" default-menu-index="3">

    <transition name="processRegularization" begin-transaction="true">
        <service-call name="zenith.attendance.AttendanceServices.regularize#Attendance"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.attendance.RegularizationRequest" list="reqList">
            <order-by field-name="-requestDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Regularization Requests"/>
            <box-body>
                <form-list name="RegList" list="reqList" skip-form="true">
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="attendanceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="requestedClockIn"><default-field title="Req In"><display format="HH:mm"/></default-field></field>
                    <field name="requestedClockOut"><default-field title="Req Out"><display format="HH:mm"/></default-field></field>
                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="requestDate"><default-field title="Requested"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="approveBtn"><default-field title="">
                        <link url="processRegularization" text="Approve"
                              parameter-map="[requestId:requestId, approve:'true']"
                              confirmation="Approve this regularization?"/></default-field></field>
                    <field name="rejectBtn"><default-field title="">
                        <link url="processRegularization" text="Reject"
                              parameter-map="[requestId:requestId, approve:'false', rejectionReason:'Rejected by manager']"
                              confirmation="Reject this regularization?"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
