<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Holidays" default-menu-index="5">

    <transition name="createHoliday" begin-transaction="true">
        <service-call name="create#zenith.erp.attendance.Holiday"/>
        <default-response url="."/>
    </transition>
    <transition name="updateHoliday" begin-transaction="true">
        <service-call name="update#zenith.erp.attendance.Holiday"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.attendance.Holiday" list="holList">
            <order-by field-name="holidayDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Holiday Calendar"/>
            <box-toolbar>
                <container-dialog id="CreateHolDialog" button-text="New Holiday">
                    <form-single name="CreateHolForm" transition="createHoliday">
                        <field name="holidayId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="holidayName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="holidayDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                        <field name="holidayType"><default-field title="Type">
                            <drop-down no-current-selected-key="HolType_NATIONAL"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="HolidayType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="isOptional"><default-field title="Optional/Restricted">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="HolList" list="holList" transition="updateHoliday">
                    <field name="holidayId"><default-field title="ID"><display/></default-field></field>
                    <field name="holidayName"><default-field title="Name"><text-line size="18"/></default-field></field>
                    <field name="holidayDate"><default-field title="Date"><display format="dd-MM-yyyy (EEE)"/></default-field></field>
                    <field name="holidayType"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="HolidayType"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="isOptional"><default-field title="Optional">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
