<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Attendance" default-menu-index="1">

    <transition name="clockIn" begin-transaction="true">
        <service-call name="zenith.attendance.AttendanceServices.clockIn#Attendance"/>
        <default-response url="."/>
    </transition>
    <transition name="clockOut" begin-transaction="true">
        <service-call name="zenith.attendance.AttendanceServices.clockOut#Attendance"/>
        <default-response url="."/>
    </transition>
    <transition name="requestRegularize" begin-transaction="true">
        <service-call name="create#zenith.erp.attendance.RegularizationRequest"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="currentPartyId" from="ec.user.userAccount?.partyId"/>
        <set field="now" from="ec.user.nowTimestamp"/>

        <!-- Current month records -->
        <set field="cal" from="java.util.Calendar.getInstance()"/>
        <script>cal.setTime(now); cal.set(java.util.Calendar.DAY_OF_MONTH, 1); cal.set(java.util.Calendar.HOUR_OF_DAY, 0); cal.set(java.util.Calendar.MINUTE, 0); cal.set(java.util.Calendar.SECOND, 0)</script>
        <set field="monthStart" from="new java.sql.Timestamp(cal.getTimeInMillis())"/>
        <script>cal.add(java.util.Calendar.MONTH, 1)</script>
        <set field="monthEnd" from="new java.sql.Timestamp(cal.getTimeInMillis())"/>

        <entity-find entity-name="zenith.erp.attendance.AttendanceRecordView" list="myRecords">
            <econdition field-name="employeePartyId" from="currentPartyId"/>
            <econdition field-name="attendanceDate" operator="greater-equals" from="monthStart"/>
            <econdition field-name="attendanceDate" operator="less" from="monthEnd"/>
            <order-by field-name="-attendanceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Clock In / Out Actions -->
        <container-box><box-header title="Clock In / Out"/>
        <box-body>
            <container-dialog id="ClockInDialog" button-text="Clock In">
                <form-single name="ClockInForm" transition="clockIn">
                    <field name="shiftId"><default-field title="Shift">
                        <drop-down allow-empty="true"><entity-options key="${shiftId}" text="${shiftName} (${shiftCode})">
                            <entity-find entity-name="zenith.erp.attendance.WorkShift">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="locationName"><default-field title="Location"><text-line size="20"/></default-field></field>
                    <field name="notes"><default-field title="Notes"><text-line size="25"/></default-field></field>
                    <field name="submitButton"><default-field title="Clock In"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="ClockOutDialog" button-text="Clock Out">
                <form-single name="ClockOutForm" transition="clockOut">
                    <field name="notes"><default-field title="Notes"><text-line size="25"/></default-field></field>
                    <field name="submitButton"><default-field title="Clock Out"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-body></container-box>

        <!-- Monthly Attendance -->
        <container-box><box-header title="My Attendance (Current Month)"/>
        <box-toolbar>
            <container-dialog id="RegDialog" button-text="Request Regularization">
                <form-single name="RegForm" transition="requestRegularize">
                    <field name="employeePartyId"><default-field><hidden default-value="${currentPartyId}"/></default-field></field>
                    <field name="requestDate"><default-field><hidden default-value="${now}"/></default-field></field>
                    <field name="statusId"><default-field><hidden default-value="RgPending"/></default-field></field>
                    <field name="attendanceDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="requestedClockIn"><default-field title="Actual Clock In"><date-time type="date-time"/></default-field></field>
                    <field name="requestedClockOut"><default-field title="Actual Clock Out"><date-time type="date-time"/></default-field></field>
                    <field name="reason"><default-field title="Reason"><text-area rows="2" cols="35"/></default-field></field>
                    <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar>
        <box-body>
            <form-list name="MyRecordList" list="myRecords" skip-form="true">
                <field name="attendanceDate"><default-field title="Date"><display format="dd-MM-yyyy (EEE)"/></default-field></field>
                <field name="shiftName"><default-field title="Shift"><display/></default-field></field>
                <field name="clockIn"><default-field title="In"><display format="HH:mm"/></default-field></field>
                <field name="clockOut"><default-field title="Out"><display format="HH:mm"/></default-field></field>
                <field name="totalHours"><default-field title="Hours"><display format="0.00"/></default-field></field>
                <field name="overtimeHours"><default-field title="OT"><display format="0.00"/></default-field></field>
                <field name="attendanceStatus"><default-field title="Status">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                <field name="isLate"><default-field title="Late"><display/></default-field></field>
                <field name="source"><default-field title="Source">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
