<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Overtime" default-menu-index="6">

    <transition name="createOvertime" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 5): only log overtime for an employee of your own org. -->
            <if condition="employeePartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ea" in-map="[partyId:employeePartyId]"/>
                <if condition="!_ea.allowed"><return error="true" message="That employee isn't part of your organization."/></if>
            </if>
            <service-call name="create#zenith.erp.attendance.OvertimeRecord" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateOvertime" begin-transaction="true">
        <service-call name="update#zenith.erp.attendance.OvertimeRecord"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.attendance.OvertimeRecord" list="otList">
            <order-by field-name="-overtimeDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Overtime Records"/>
            <box-toolbar>
                <container-dialog id="CreateOtDialog" button-text="Log Overtime">
                    <form-single name="CreateOtForm" transition="createOvertime">
                        <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="overtimeDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                        <field name="hours"><default-field title="Hours"><text-line size="5"/></default-field></field>
                        <field name="rateMultiplier"><default-field title="Rate Multiplier"><text-line size="4" default-value="1.5"/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-line size="30"/></default-field></field>
                        <field name="statusId"><default-field><hidden default-value="OtPending"/></default-field></field>
                        <field name="submitButton"><default-field title="Log"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="OtList" list="otList" transition="updateOvertime">
                    <field name="overtimeId"><default-field><hidden/></default-field></field>
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="overtimeDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="hours"><default-field title="Hours"><display format="0.00"/></default-field></field>
                    <field name="rateMultiplier"><default-field title="Rate"><display/></default-field></field>
                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down><entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="OvertimeRecord"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
