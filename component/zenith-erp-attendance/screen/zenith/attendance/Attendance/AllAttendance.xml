<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Attendance" default-menu-index="2">

    <transition name="markAttendance" begin-transaction="true">
        <service-call name="zenith.attendance.AttendanceServices.mark#Attendance"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.attendance.AttendanceRecordView" list="allRecords">
            <search-form-inputs default-order-by="-attendanceDate"/>
            <order-by field-name="-attendanceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Attendance Records"/>
            <box-toolbar>
                <container-dialog id="MarkDialog" button-text="Mark Attendance">
                    <form-single name="MarkForm" transition="markAttendance">
                        <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="attendanceDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                        <field name="attendanceStatus"><default-field title="Status">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="AttendanceStatus"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="shiftId"><default-field title="Shift">
                            <drop-down allow-empty="true"><entity-options key="${shiftId}" text="${shiftName}">
                                <entity-find entity-name="zenith.erp.attendance.WorkShift">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="notes"><default-field title="Notes"><text-line size="25"/></default-field></field>
                        <field name="submitButton"><default-field title="Mark"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="AllRecordList" list="allRecords" skip-form="true">
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="attendanceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="shiftName"><default-field title="Shift"><display/></default-field></field>
                    <field name="clockIn"><default-field title="In"><display format="HH:mm"/></default-field></field>
                    <field name="clockOut"><default-field title="Out"><display format="HH:mm"/></default-field></field>
                    <field name="totalHours"><default-field title="Hours"><display format="0.00"/></default-field></field>
                    <field name="attendanceStatus"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="isLate"><default-field title="Late"><display/></default-field></field>
                    <field name="source"><default-field title="Source">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
