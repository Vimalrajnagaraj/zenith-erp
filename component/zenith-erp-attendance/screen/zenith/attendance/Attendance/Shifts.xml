<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Shifts &amp; Policies" default-menu-index="4">

    <transition name="createShift" begin-transaction="true">
        <service-call name="create#zenith.erp.attendance.WorkShift"/>
        <default-response url="."/>
    </transition>
    <transition name="updateShift" begin-transaction="true">
        <service-call name="update#zenith.erp.attendance.WorkShift"/>
        <default-response url="."/>
    </transition>
    <transition name="createPolicy" begin-transaction="true">
        <service-call name="create#zenith.erp.attendance.AttendancePolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicy" begin-transaction="true">
        <service-call name="update#zenith.erp.attendance.AttendancePolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="assignShift" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 5): only assign a shift to an employee of your own org. -->
            <if condition="employeePartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ea" in-map="[partyId:employeePartyId]"/>
                <if condition="!_ea.allowed"><return error="true" message="That employee isn't part of your organization."/></if>
            </if>
            <service-call name="create#zenith.erp.attendance.EmployeeShift" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.attendance.WorkShift" list="shiftList">
            <order-by field-name="shiftName"/></entity-find>
        <entity-find entity-name="zenith.erp.attendance.AttendancePolicy" list="policyList">
            <order-by field-name="policyName"/></entity-find>
        <entity-find entity-name="zenith.erp.attendance.EmployeeShift" list="assignList">
            <order-by field-name="-fromDate"/></entity-find>
    </actions>

    <widgets>
        <!-- Shifts -->
        <container-box><box-header title="Work Shifts"/>
        <box-toolbar>
            <container-dialog id="CreateShiftDialog" button-text="New Shift">
                <form-single name="CreateShiftForm" transition="createShift">
                    <field name="shiftId"><default-field title="ID"><text-line size="15"/></default-field></field>
                    <field name="shiftName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="shiftCode"><default-field title="Code"><text-line size="5"/></default-field></field>
                    <field name="startTime"><default-field title="Start (HH:mm)"><text-line size="8"/></default-field></field>
                    <field name="endTime"><default-field title="End (HH:mm)"><text-line size="8"/></default-field></field>
                    <field name="graceMinutes"><default-field title="Grace (min)"><text-line size="4" default-value="15"/></default-field></field>
                    <field name="isNightShift"><default-field title="Night Shift">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar>
        <box-body>
            <form-list name="ShiftList" list="shiftList" transition="updateShift">
                <field name="shiftId"><default-field title="ID"><display/></default-field></field>
                <field name="shiftName"><default-field title="Name"><text-line size="12"/></default-field></field>
                <field name="shiftCode"><default-field title="Code"><text-line size="4"/></default-field></field>
                <field name="startTime"><default-field title="Start"><text-line size="5"/></default-field></field>
                <field name="endTime"><default-field title="End"><text-line size="5"/></default-field></field>
                <field name="graceMinutes"><default-field title="Grace"><text-line size="3"/></default-field></field>
                <field name="isNightShift"><default-field title="Night">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-list>
        </box-body></container-box>

        <!-- Policies -->
        <container-box><box-header title="Attendance Policies"/>
        <box-toolbar>
            <container-dialog id="CreatePolicyDialog" button-text="New Policy">
                <form-single name="CreatePolicyForm" transition="createPolicy">
                    <field name="policyId"><default-field title="ID"><text-line size="15"/></default-field></field>
                    <field name="policyName"><default-field title="Name"><text-line size="25"/></default-field></field>
                    <field name="defaultShiftId"><default-field title="Default Shift">
                        <drop-down><entity-options key="${shiftId}" text="${shiftName}">
                            <entity-find entity-name="zenith.erp.attendance.WorkShift">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="weeklyOffDays"><default-field title="Weekly Off"><text-line size="20" default-value="Saturday,Sunday"/></default-field></field>
                    <field name="overtimeAfterHours"><default-field title="OT After (hrs)"><text-line size="4" default-value="9"/></default-field></field>
                    <field name="overtimeRateMultiplier"><default-field title="OT Rate"><text-line size="4" default-value="1.5"/></default-field></field>
                    <field name="lateMarkAfterMinutes"><default-field title="Late After (min)"><text-line size="4" default-value="15"/></default-field></field>
                    <field name="lateMarksForHalfDay"><default-field title="Lates = Half Day"><text-line size="3" default-value="3"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar>
        <box-body>
            <form-list name="PolicyList" list="policyList" transition="updatePolicy">
                <field name="policyId"><default-field title="ID"><display/></default-field></field>
                <field name="policyName"><default-field title="Name"><text-line size="12"/></default-field></field>
                <field name="defaultShiftId"><default-field title="Shift">
                    <display-entity entity-name="zenith.erp.attendance.WorkShift" key-field-name="shiftId" text="${shiftName}"/></default-field></field>
                <field name="weeklyOffDays"><default-field title="Off Days"><text-line size="12"/></default-field></field>
                <field name="overtimeAfterHours"><default-field title="OT Hrs"><text-line size="3"/></default-field></field>
                <field name="lateMarkAfterMinutes"><default-field title="Late Min"><text-line size="3"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-list>
        </box-body></container-box>

        <!-- Employee Shift Assignments -->
        <container-box><box-header title="Employee Shift Assignments"/>
        <box-toolbar>
            <container-dialog id="AssignDialog" button-text="Assign Shift">
                <form-single name="AssignForm" transition="assignShift">
                    <field name="employeePartyId"><default-field title="Employee (Party ID)"><text-line size="15"/></default-field></field>
                    <field name="shiftId"><default-field title="Shift">
                        <drop-down><entity-options key="${shiftId}" text="${shiftName}">
                            <entity-find entity-name="zenith.erp.attendance.WorkShift">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="policyId"><default-field title="Policy">
                        <drop-down><entity-options key="${policyId}" text="${policyName}">
                            <entity-find entity-name="zenith.erp.attendance.AttendancePolicy">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="fromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                    <field name="thruDate"><default-field title="To"><date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Assign"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar>
        <box-body>
            <form-list name="AssignList" list="assignList" skip-form="true">
                <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                <field name="shiftId"><default-field title="Shift">
                    <display-entity entity-name="zenith.erp.attendance.WorkShift" key-field-name="shiftId" text="${shiftName}"/></default-field></field>
                <field name="policyId"><default-field title="Policy">
                    <display-entity entity-name="zenith.erp.attendance.AttendancePolicy" key-field-name="policyId" text="${policyName}"/></default-field></field>
                <field name="fromDate"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                <field name="thruDate"><default-field title="To"><display format="dd-MM-yyyy"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
