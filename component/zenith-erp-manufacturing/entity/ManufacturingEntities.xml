<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Bill of Material ========== -->
    <entity entity-name="BillOfMaterial" package="zenith.erp.manufacturing" short-alias="BillOfMaterials">
        <field name="bomId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="bomName" type="text-medium"/>
        <field name="bomVersion" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="outputQuantity" type="number-decimal"/>
        <field name="isDefault" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <entity entity-name="BomItem" package="zenith.erp.manufacturing" short-alias="BomItems">
        <field name="bomId" type="id" is-pk="true"/>
        <field name="bomItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <field name="wastePercent" type="number-decimal"/>
        <field name="isOptional" type="text-indicator"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.manufacturing.BillOfMaterial"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Work Center ========== -->
    <entity entity-name="WorkCenter" package="zenith.erp.manufacturing" short-alias="WorkCenters">
        <field name="workCenterId" type="id" is-pk="true"/>
        <field name="workCenterName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="facilityId" type="id"/>
        <field name="capacityPerHour" type="number-decimal"/>
        <field name="costPerHour" type="currency-amount"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="mantle.facility.Facility"/>
    </entity>

    <!-- ========== Routing ========== -->
    <entity entity-name="Routing" package="zenith.erp.manufacturing" short-alias="Routings">
        <field name="routingId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="routingName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="isDefault" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <entity entity-name="RoutingOperation" package="zenith.erp.manufacturing" short-alias="RoutingOperations">
        <field name="routingId" type="id" is-pk="true"/>
        <field name="operationSeqId" type="id" is-pk="true"/>
        <field name="operationName" type="text-medium"/>
        <field name="workCenterId" type="id"/>
        <field name="setupTimeMinutes" type="number-integer"/>
        <field name="runTimeMinutes" type="number-integer"/>
        <field name="description" type="text-long"/>
        <relationship type="one" related="zenith.erp.manufacturing.Routing"/>
        <relationship type="one" related="zenith.erp.manufacturing.WorkCenter"/>
    </entity>

    <!-- ========== Work Order ========== -->
    <entity entity-name="WorkOrder" package="zenith.erp.manufacturing" short-alias="WorkOrders">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="workOrderNumber" type="text-short"/>
        <field name="productId" type="id"/>
        <field name="bomId" type="id"/>
        <field name="routingId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="completedQuantity" type="number-decimal"/>
        <field name="wastageQuantity" type="number-decimal"/>
        <field name="plannedStartDate" type="date"/>
        <field name="plannedEndDate" type="date"/>
        <field name="actualStartDate" type="date"/>
        <field name="actualEndDate" type="date"/>
        <field name="facilityId" type="id"/>
        <field name="statusId" type="text-short"/>
        <field name="priority" type="text-short"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="zenith.erp.manufacturing.BillOfMaterial"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="WorkOrder" description="Work Order"/>
            <moqui.basic.StatusItem statusId="WoDraft" statusTypeId="WorkOrder" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="WoReleased" statusTypeId="WorkOrder" description="Released" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="WoInProgress" statusTypeId="WorkOrder" description="In Progress" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="WoCompleted" statusTypeId="WorkOrder" description="Completed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="WoCancelled" statusTypeId="WorkOrder" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoDraft" toStatusId="WoReleased" transitionName="Release"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoReleased" toStatusId="WoInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoInProgress" toStatusId="WoCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoDraft" toStatusId="WoCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoReleased" toStatusId="WoCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <entity entity-name="WorkOrderMaterial" package="zenith.erp.manufacturing" short-alias="WorkOrderMaterials">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="materialSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="plannedQuantity" type="number-decimal"/>
        <field name="actualQuantity" type="number-decimal"/>
        <field name="wastedQuantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <relationship type="one" related="zenith.erp.manufacturing.WorkOrder"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <entity entity-name="WorkOrderOperation" package="zenith.erp.manufacturing" short-alias="WorkOrderOperations">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="operationSeqId" type="id" is-pk="true"/>
        <field name="operationName" type="text-medium"/>
        <field name="workCenterId" type="id"/>
        <field name="plannedMinutes" type="number-integer"/>
        <field name="actualMinutes" type="number-integer"/>
        <field name="statusId" type="text-short"/>
        <field name="operatorName" type="text-medium"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.manufacturing.WorkOrder"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="WoOperation" description="Work Order Operation"/>
            <moqui.basic.StatusItem statusId="OpPending" statusTypeId="WoOperation" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="OpInProgress" statusTypeId="WoOperation" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="OpCompleted" statusTypeId="WoOperation" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="OpPending" toStatusId="OpInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="OpInProgress" toStatusId="OpCompleted" transitionName="Complete"/>
        </seed-data>
    </entity>

    <!-- ========== Job Work (GST Compliant) ========== -->
    <entity entity-name="JobWorkOrder" package="zenith.erp.manufacturing" short-alias="JobWorkOrders">
        <field name="jobWorkOrderId" type="id" is-pk="true"/>
        <field name="jobWorkNumber" type="text-short"/>
        <field name="jobWorkerPartyId" type="id"/>
        <field name="challanNumber" type="text-short"/>
        <field name="challanDate" type="date"/>
        <field name="dispatchDate" type="date"/>
        <field name="expectedReturnDate" type="date"/>
        <field name="actualReturnDate" type="date"/>
        <field name="returnChallanNumber" type="text-short"/>
        <field name="jobWorkCharges" type="currency-amount"/>
        <field name="sacCode" type="text-short"/>
        <field name="gstRatePercent" type="number-decimal"/>
        <field name="facilityId" type="id"/>
        <field name="isCapitalGoods" type="text-indicator"/>
        <field name="statusId" type="text-short"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" title="JobWorker" related="mantle.party.Party">
            <key-map field-name="jobWorkerPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.facility.Facility"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="JobWork" description="Job Work"/>
            <moqui.basic.StatusItem statusId="JwDraft" statusTypeId="JobWork" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="JwDispatched" statusTypeId="JobWork" description="Dispatched" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="JwPartialReturn" statusTypeId="JobWork" description="Partial Return" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="JwReturned" statusTypeId="JobWork" description="Returned" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="JwOverdue" statusTypeId="JobWork" description="Overdue" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="JwCancelled" statusTypeId="JobWork" description="Cancelled" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwDraft" toStatusId="JwDispatched" transitionName="Dispatch"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwDispatched" toStatusId="JwPartialReturn" transitionName="Partial Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwDispatched" toStatusId="JwReturned" transitionName="Full Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwPartialReturn" toStatusId="JwReturned" transitionName="Full Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwDispatched" toStatusId="JwOverdue" transitionName="Mark Overdue"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="JwDraft" toStatusId="JwCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <entity entity-name="JobWorkItem" package="zenith.erp.manufacturing" short-alias="JobWorkItems">
        <field name="jobWorkOrderId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="dispatchedQuantity" type="number-decimal"/>
        <field name="returnedQuantity" type="number-decimal"/>
        <field name="damagedQuantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <field name="valueAmount" type="currency-amount"/>
        <relationship type="one" related="zenith.erp.manufacturing.JobWorkOrder"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="WorkOrderView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="WO" entity-name="zenith.erp.manufacturing.WorkOrder"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="WO">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="WO"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <view-entity entity-name="BomView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="BOM" entity-name="zenith.erp.manufacturing.BillOfMaterial"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="BOM">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="BOM"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <view-entity entity-name="BomItemView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="BI" entity-name="zenith.erp.manufacturing.BomItem"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="BI">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="BI"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <view-entity entity-name="WorkOrderMaterialView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="WM" entity-name="zenith.erp.manufacturing.WorkOrderMaterial"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="WM">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="WM"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <!-- ========== MRP Planned Order ========== -->
    <entity entity-name="PlannedOrder" package="zenith.erp.manufacturing" short-alias="PlannedOrders">
        <field name="plannedOrderId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="bomId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="requiredQuantity" type="number-decimal"/>
        <field name="availableStock" type="number-decimal"/>
        <field name="netRequirement" type="number-decimal"/>
        <field name="plannedQuantity" type="number-decimal"/>
        <field name="requiredDate" type="date"/>
        <field name="plannedStartDate" type="date"/>
        <field name="leadTimeDays" type="number-integer"/>
        <field name="orderType" type="text-short"><description>Manufacture, Purchase, Transfer</description></field>
        <field name="sourceType" type="text-short"><description>MRP, Manual</description></field>
        <field name="mrpRunId" type="text-short"/>
        <field name="statusId" type="text-short"/>
        <field name="convertedToId" type="id"><description>WorkOrderId or PurchaseOrderId</description></field>
        <field name="priority" type="text-short"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="zenith.erp.manufacturing.BillOfMaterial"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="PlannedOrder" description="Planned Order"/>
            <moqui.basic.StatusItem statusId="PoPlanned" statusTypeId="PlannedOrder" description="Planned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="PoFirmed" statusTypeId="PlannedOrder" description="Firmed" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="PoConverted" statusTypeId="PlannedOrder" description="Converted" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="PoCancelled" statusTypeId="PlannedOrder" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PoPlanned" toStatusId="PoFirmed" transitionName="Firm"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PoFirmed" toStatusId="PoConverted" transitionName="Convert"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PoPlanned" toStatusId="PoCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PoFirmed" toStatusId="PoCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== MRP Run Log ========== -->
    <entity entity-name="MrpRun" package="zenith.erp.manufacturing" short-alias="MrpRuns">
        <field name="mrpRunId" type="id" is-pk="true"/>
        <field name="runDate" type="date-time"/>
        <field name="facilityId" type="id"/>
        <field name="planningHorizonDays" type="number-integer"/>
        <field name="productsAnalyzed" type="number-integer"/>
        <field name="plannedOrdersCreated" type="number-integer"/>
        <field name="purchaseOrdersCreated" type="number-integer"/>
        <field name="totalShortage" type="number-decimal"/>
        <field name="runByUserId" type="id"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="mantle.facility.Facility"/>
    </entity>

    <!-- ========== Capacity Plan ========== -->
    <entity entity-name="CapacityPlan" package="zenith.erp.manufacturing" short-alias="CapacityPlans">
        <field name="capacityPlanId" type="id" is-pk="true"/>
        <field name="workCenterId" type="id"/>
        <field name="planDate" type="date"/>
        <field name="availableHours" type="number-decimal"/>
        <field name="plannedHours" type="number-decimal"/>
        <field name="actualHours" type="number-decimal" default="0"/>
        <field name="utilizationPercent" type="number-decimal"/>
        <field name="overloadFlag" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.manufacturing.WorkCenter"/>
    </entity>

    <!-- ========== Planned Order View ========== -->
    <view-entity entity-name="PlannedOrderView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="PO" entity-name="zenith.erp.manufacturing.PlannedOrder"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="PO">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="FAC" entity-name="mantle.facility.Facility" join-from-alias="PO" join-optional="true">
            <key-map field-name="facilityId"/></member-entity>
        <alias-all entity-alias="PO"/>
        <alias entity-alias="PRD" name="productName"/>
        <alias entity-alias="PRD" name="pseudoId"/>
        <alias entity-alias="FAC" name="facilityName"/>
    </view-entity>

    <view-entity entity-name="JobWorkItemView" package="zenith.erp.manufacturing">
        <member-entity entity-alias="JI" entity-name="zenith.erp.manufacturing.JobWorkItem"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="JI">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="JI"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>
</entities>
