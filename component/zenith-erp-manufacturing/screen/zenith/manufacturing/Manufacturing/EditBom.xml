<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="BOM Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="bomId" required="true"/>

    <transition name="updateBom">
        <service-call name="update#zenith.erp.manufacturing.BillOfMaterial"/>
        <default-response url="."/>
    </transition>
    <transition name="addItem">
        <service-call name="zenith.manufacturing.ManufacturingServices.add#BomItem"/>
        <default-response url="."/>
    </transition>
    <transition name="updateItem">
        <service-call name="update#zenith.erp.manufacturing.BomItem"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteItem">
        <service-call name="delete#zenith.erp.manufacturing.BomItem"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.manufacturing.BillOfMaterial" value-field="bom"/>
        <entity-find-one entity-name="mantle.product.Product" value-field="product">
            <field-map field-name="productId" from="bom.productId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.manufacturing.BomItemView" list="itemList">
            <econdition field-name="bomId"/>
            <order-by field-name="bomItemSeqId"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="${bom.bomName} — ${product.productName}" type="h4"/>
        <label text="Version: ${bom.bomVersion} | Output Qty: ${bom.outputQuantity} | Default: ${bom.isDefault}" type="div" style="text-muted"/>

        <container-row>
            <row-col lg="5">
                <container-box><box-header title="BOM Details"/><box-body>
                    <form-single name="BomForm" map="bom" transition="updateBom">
                        <field name="bomId"><default-field><hidden/></default-field></field>
                        <field name="bomName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="bomVersion"><default-field title="Version"><text-line size="6"/></default-field></field>
                        <field name="outputQuantity"><default-field title="Output Qty"><text-line size="6"/></default-field></field>
                        <field name="description"><default-field><text-area rows="2" cols="30"/></default-field></field>
                        <field name="isDefault"><default-field title="Default">
                            <drop-down><option key="Y"/><option key="N"/></drop-down>
                        </default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y"/><option key="N"/></drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="7">
                <container-box><box-header title="Components / Raw Materials"/><box-toolbar>
                    <container-dialog id="AddItemDialog" button-text="Add Component">
                        <form-single name="AddItemForm" transition="addItem">
                            <field name="bomId"><default-field><hidden/></default-field></field>
                            <field name="productId"><default-field title="Material">
                                <drop-down>
                                    <list-options list="productList" key="${productId}" text="${productName}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                            <field name="wastePercent"><default-field title="Waste %"><text-line size="6" default-value="0"/></default-field></field>
                            <field name="notes"><default-field><text-line size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar><box-body>
                    <form-list name="ItemListForm" list="itemList" skip-form="true" transition="updateItem">
                        <field name="bomId"><default-field><hidden/></default-field></field>
                        <field name="bomItemSeqId"><default-field><hidden/></default-field></field>
                        <field name="productName"><default-field title="Material"><display/></default-field></field>
                        <field name="quantity"><default-field title="Qty"><text-line size="6"/></default-field></field>
                        <field name="wastePercent"><default-field title="Waste %"><text-line size="4"/></default-field></field>
                        <field name="notes"><default-field><display/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        <field name="deleteBtn"><default-field title="">
                            <link url="deleteItem" text="X" parameter-map="[bomId:bomId, bomItemSeqId:bomItemSeqId]"
                                  confirmation="Remove this component?"/>
                        </default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
