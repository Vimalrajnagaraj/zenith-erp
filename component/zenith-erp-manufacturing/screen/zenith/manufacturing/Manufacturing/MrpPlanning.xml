<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="MRP Planning" default-menu-index="6">

    <transition name="runMrp">
        <service-call name="zenith.manufacturing.MrpServices.run#MrpCalculation"/>
        <default-response url="."/>
    </transition>
    <transition name="firmOrder">
        <service-call name="update#zenith.erp.manufacturing.PlannedOrder"
            in-map="[plannedOrderId: plannedOrderId, statusId: 'PoFirmed']"/>
        <default-response url="."/>
    </transition>
    <transition name="convertOrder">
        <service-call name="zenith.manufacturing.MrpServices.convert#PlannedOrderToWorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelOrder">
        <service-call name="update#zenith.erp.manufacturing.PlannedOrder"
            in-map="[plannedOrderId: plannedOrderId, statusId: 'PoCancelled']"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Get planned orders -->
        <entity-find entity-name="zenith.erp.manufacturing.PlannedOrderView" list="plannedOrders">
            <search-form-inputs default-order-by="-requiredDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <!-- MRP Run history -->
        <entity-find entity-name="zenith.erp.manufacturing.MrpRun" list="mrpRuns">
            <order-by field-name="-runDate"/>
            <limit count="5"/>
        </entity-find>

        <!-- Summary counts -->
        <entity-find-count entity-name="zenith.erp.manufacturing.PlannedOrder" count-field="totalPlanned">
            <econdition field-name="statusId" value="PoPlanned"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.manufacturing.PlannedOrder" count-field="totalFirmed">
            <econdition field-name="statusId" value="PoFirmed"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.manufacturing.PlannedOrder" count-field="manufactureOrders">
            <econdition field-name="orderType" value="Manufacture"/>
            <econdition field-name="statusId" operator="in" value="PoPlanned,PoFirmed"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.manufacturing.PlannedOrder" count-field="purchaseOrders">
            <econdition field-name="orderType" value="Purchase"/>
            <econdition field-name="statusId" operator="in" value="PoPlanned,PoFirmed"/>
        </entity-find-count>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Material Requirements Planning (MRP)" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Explode BOMs, check stock levels, and generate planned orders for shortages" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container-dialog id="RunMrpDialog" button-text="Run MRP" width="500"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="RunMrpForm" transition="runMrp">
                    <field name="facilityId"><default-field title="Facility (optional)">
                        <drop-down allow-empty="true">
                            <entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility">
                                    <order-by field-name="facilityName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="planningHorizonDays"><default-field title="Planning Horizon">
                        <drop-down allow-empty="false">
                            <option key="7" text="1 Week"/>
                            <option key="14" text="2 Weeks"/>
                            <option key="30" text="1 Month"/>
                            <option key="60" text="2 Months"/>
                            <option key="90" text="3 Months"/>
                        </drop-down>
                    </default-field></field>
                    <field name="includeExistingOrders"><default-field title="Include Pending Work Orders">
                        <drop-down allow-empty="false">
                            <option key="true" text="Yes — deduct pending WO quantities"/>
                            <option key="false" text="No — ignore existing work orders"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Run MRP Calculation"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- KPI Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Planned Orders" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${totalPlanned}" type="h3" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Firmed Orders" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${totalFirmed}" type="h3" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="To Manufacture" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${manufactureOrders}" type="h3" style="text-warning text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="To Purchase" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${purchaseOrders}" type="h3" style="text-negative text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Recent MRP Runs -->
        <section name="MrpRunsSection" condition="mrpRuns">
            <widgets>
                <container style="bg-white shadow-2 border-radius-lg q-pa-md q-mb-md">
                    <label text="Recent MRP Runs" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-list name="MrpRunList" list="mrpRuns" skip-form="true">
                        <field name="runDate"><default-field title="Run Date"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="planningHorizonDays"><default-field title="Horizon (days)"><display/></default-field></field>
                        <field name="productsAnalyzed"><default-field title="Products"><display/></default-field></field>
                        <field name="plannedOrdersCreated"><default-field title="Mfg Orders"><display/></default-field></field>
                        <field name="purchaseOrdersCreated"><default-field title="PO Orders"><display/></default-field></field>
                        <field name="totalShortage"><default-field title="Total Shortage"><display format="#,##0"/></default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>

        <!-- Planned Orders List -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <label text="Planned Orders" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="PlannedOrderList" list="plannedOrders" skip-form="true"
                       header-dialog="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="productName"><header-field title="Product" show-order-by="true"/>
                    <default-field title="Product"><display/></default-field></field>
                <field name="orderType"><header-field title="Type">
                    <drop-down allow-empty="true">
                        <option key="Manufacture" text="Manufacture"/>
                        <option key="Purchase" text="Purchase"/>
                    </drop-down></header-field>
                    <default-field title="Type"><display/></default-field></field>
                <field name="requiredQuantity"><default-field title="Required"><display format="#,##0"/></default-field></field>
                <field name="availableStock"><default-field title="Available"><display format="#,##0"/></default-field></field>
                <field name="netRequirement"><default-field title="Shortage"><display format="#,##0" style="text-negative text-weight-bold"/></default-field></field>
                <field name="plannedQuantity"><default-field title="Plan Qty"><display format="#,##0" style="text-positive text-weight-bold"/></default-field></field>
                <field name="requiredDate"><header-field title="Required By" show-order-by="true"/>
                    <default-field title="Required By"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="statusId"><header-field title="Status">
                    <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                        <entity-find entity-name="moqui.basic.StatusItem">
                            <econdition field-name="statusTypeId" value="PlannedOrder"/></entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                    </default-field></field>
                <field name="actions"><default-field title="Actions">
                    <link url="firmOrder" text="Firm" btn-type="info" style="q-btn--dense q-mr-xs"
                          parameter-map="[plannedOrderId: plannedOrderId]"
                          condition="statusId == 'PoPlanned'" confirmation="Firm this planned order?"/>
                    <link url="convertOrder" text="Convert to WO" btn-type="success" style="q-btn--dense q-mr-xs"
                          parameter-map="[plannedOrderId: plannedOrderId]"
                          condition="statusId == 'PoFirmed' &amp;&amp; orderType == 'Manufacture'"
                          confirmation="Convert to Work Order?"/>
                    <link url="cancelOrder" text="Cancel" btn-type="danger" style="q-btn--dense"
                          parameter-map="[plannedOrderId: plannedOrderId]"
                          condition="statusId in ['PoPlanned', 'PoFirmed']"
                          confirmation="Cancel this planned order?"/>
                </default-field></field>
                <field name="searchButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
