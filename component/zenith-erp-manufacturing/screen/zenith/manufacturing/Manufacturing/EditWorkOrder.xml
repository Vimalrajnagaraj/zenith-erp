<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work Order Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="workOrderId" required="true"/>

    <transition name="releaseWo">
        <service-call name="zenith.manufacturing.ManufacturingServices.release#WorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="startWo">
        <service-call name="zenith.manufacturing.ManufacturingServices.start#WorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="completeWo">
        <service-call name="zenith.manufacturing.ManufacturingServices.complete#WorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="recordMaterial">
        <service-call name="zenith.manufacturing.ManufacturingServices.record#MaterialConsumption"/>
        <default-response url="."/>
    </transition>
    <transition name="updateOperation">
        <service-call name="update#zenith.erp.manufacturing.WorkOrderOperation"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.manufacturing.WorkOrder" value-field="wo"/>
        <entity-find-one entity-name="mantle.product.Product" value-field="product">
            <field-map field-name="productId" from="wo.productId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.manufacturing.WorkOrderMaterialView" list="materials">
            <econdition field-name="workOrderId"/>
            <order-by field-name="materialSeqId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.manufacturing.WorkOrderOperation" list="operations">
            <econdition field-name="workOrderId"/>
            <order-by field-name="operationSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="${wo.workOrderNumber} — ${product.productName}" type="h4"/>
        <label text="Status: ${wo.statusId} | Qty: ${wo.quantity} | Done: ${wo.completedQuantity ?: 0} | Waste: ${wo.wastageQuantity ?: 0} | Priority: ${wo.priority}" type="div" style="text-muted"/>

        <container-box><box-header title="Actions"/><box-toolbar>
            <link url="releaseWo" text="Release" parameter-map="[workOrderId:workOrderId]"
                  condition="wo.statusId == 'WoDraft' &amp;&amp; modCanWrite" confirmation="Release this work order for production?"/>
            <link url="startWo" text="Start Production" parameter-map="[workOrderId:workOrderId]"
                  condition="wo.statusId == 'WoReleased' &amp;&amp; modCanWrite" confirmation="Start production?"/>
        </box-toolbar><box-body>
            <section name="CompleteSection" condition="wo.statusId == 'WoInProgress' &amp;&amp; modCanWrite">
                <widgets>
                    <container-dialog id="CompleteDialog" button-text="Complete Work Order">
                        <form-single name="CompleteForm" transition="completeWo">
                            <field name="workOrderId"><default-field><hidden/></default-field></field>
                            <field name="completedQuantity"><default-field title="Completed Qty"><text-line size="8"/></default-field></field>
                            <field name="wastageQuantity"><default-field title="Wastage Qty"><text-line size="8" default-value="0"/></default-field></field>
                            <field name="submitButton"><default-field title="Complete"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </widgets>
            </section>
        </box-body></container-box>

        <container-row>
            <row-col lg="7">
                <!-- Materials -->
                <container-box><box-header title="Materials (BOM Explosion)"/><box-body>
                    <form-list name="MaterialForm" list="materials" transition="recordMaterial">
                        <field name="workOrderId"><default-field><hidden/></default-field></field>
                        <field name="materialSeqId"><default-field><hidden/></default-field></field>
                        <field name="productName"><default-field title="Material"><display/></default-field></field>
                        <field name="plannedQuantity"><default-field title="Planned"><display format="#,##0.##"/></default-field></field>
                        <field name="actualQuantity"><default-field title="Actual">
                            <text-line size="8"/></default-field></field>
                        <field name="wastedQuantity"><default-field title="Wasted">
                            <text-line size="6" default-value="0"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="mat_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>
            </row-col>
            <row-col lg="5">
                <!-- Operations -->
                <container-box><box-header title="Operations"/><box-body>
                    <form-list name="OperationForm" list="operations" transition="updateOperation">
                        <field name="workOrderId"><default-field><hidden/></default-field></field>
                        <field name="operationSeqId"><default-field><hidden/></default-field></field>
                        <field name="operationName"><default-field title="Operation"><display/></default-field></field>
                        <field name="plannedMinutes"><default-field title="Plan (min)"><display/></default-field></field>
                        <field name="actualMinutes"><default-field title="Actual (min)">
                            <text-line size="6"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <option key="OpPending" text="Pending"/>
                                <option key="OpInProgress" text="In Progress"/>
                                <option key="OpCompleted" text="Completed"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="op_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
