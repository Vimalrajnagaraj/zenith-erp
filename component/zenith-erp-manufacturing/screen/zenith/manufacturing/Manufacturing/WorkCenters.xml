<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work Centers" default-menu-index="3">

    <transition name="createWc">
        <service-call name="create#zenith.erp.manufacturing.WorkCenter"/>
        <default-response url="."/>
    </transition>
    <transition name="updateWc">
        <service-call name="update#zenith.erp.manufacturing.WorkCenter"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.manufacturing.WorkCenter" list="wcList">
            <search-form-inputs default-order-by="workCenterName"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Work Centers &amp; Machines"/><box-toolbar>
            <container-dialog id="NewWcDialog" button-text="New Work Center">
                <form-single name="NewWcForm" transition="createWc">
                    <field name="workCenterName"><default-field title="Name"><text-line size="25"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="facilityId"><default-field title="Facility">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="capacityPerHour"><default-field title="Capacity / Hour"><text-line size="8"/></default-field></field>
                    <field name="costPerHour"><default-field title="Cost / Hour (${currSymbol})"><text-line size="8"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y"/><option key="N"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="WcListForm" list="wcList" skip-form="true" transition="updateWc">
                <field name="workCenterId"><default-field><hidden/></default-field></field>
                <field name="workCenterName">
                    <header-field title="Name" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="description"><default-field><display/></default-field></field>
                <field name="capacityPerHour"><default-field title="Capacity/Hr"><display/></default-field></field>
                <field name="costPerHour"><default-field title="Cost/Hr"><display format="#,##0"/></default-field></field>
                <field name="isActive">
                    <header-field title="Active">
                        <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
