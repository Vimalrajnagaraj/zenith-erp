<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bill of Materials" default-menu-index="2">

    <transition name="createBom">
        <service-call name="zenith.manufacturing.ManufacturingServices.create#BillOfMaterial"/>
        <default-response url="../EditBom"/>
    </transition>
    <transition name="editBom">
        <default-response url="../EditBom"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.manufacturing.BomView" list="bomList">
            <search-form-inputs default-order-by="productName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Bill of Materials"/><box-toolbar>
            <container-dialog id="NewBomDialog" button-text="New BOM">
                <form-single name="NewBomForm" transition="createBom">
                    <field name="productId"><default-field title="Finished Product">
                        <drop-down>
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="bomName"><default-field title="BOM Name"><text-line size="30"/></default-field></field>
                    <field name="bomVersion"><default-field title="Version"><text-line size="6" default-value="1.0"/></default-field></field>
                    <field name="outputQuantity"><default-field title="Output Qty"><text-line size="6" default-value="1"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="BomListForm" list="bomList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="bomName">
                    <header-field title="BOM Name"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><link url="editBom" text="${bomName}" parameter-map="[bomId:bomId]"/></default-field>
                </field>
                <field name="productName">
                    <header-field title="Product"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="bomVersion"><default-field title="Version"><display/></default-field></field>
                <field name="outputQuantity"><default-field title="Output Qty"><display/></default-field></field>
                <field name="isDefault"><default-field title="Default"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
