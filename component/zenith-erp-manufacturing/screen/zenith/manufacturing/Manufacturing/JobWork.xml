<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job Work" default-menu-index="4">

    <transition name="createJw">
        <service-call name="zenith.manufacturing.ManufacturingServices.create#JobWorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="addJwItem">
        <service-call name="zenith.manufacturing.ManufacturingServices.add#JobWorkItem"/>
        <default-response url="."/>
    </transition>
    <transition name="dispatchJw">
        <service-call name="zenith.manufacturing.ManufacturingServices.dispatch#JobWorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="receiveReturn">
        <service-call name="zenith.manufacturing.ManufacturingServices.receive#JobWorkReturn"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.manufacturing.JobWorkOrder" list="jwList">
            <search-form-inputs default-order-by="-jobWorkNumber"/>
            <econdition field-name="jobWorkerPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendorList">
            <econdition field-name="roleTypeId" value="Supplier"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Job Work Orders (GST Compliant)"/><box-toolbar>
            <section name="NewJw_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewJwDialog" button-text="New Job Work">
                <form-single name="NewJwForm" transition="createJw">
                    <field name="jobWorkerPartyId"><default-field title="Job Worker">
                        <drop-down>
                            <list-options list="vendorList" key="${partyId}" text="${organizationName ?: (firstName + ' ' + (lastName ?: ''))}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="facilityId"><default-field title="Dispatch From">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="isCapitalGoods"><default-field title="Capital Goods">
                        <drop-down><option key="N" text="No (1-year return)"/><option key="Y" text="Yes (3-year return)"/></drop-down>
                    </default-field></field>
                    <field name="sacCode"><default-field title="SAC Code"><text-line size="6" default-value="9988"/></default-field></field>
                    <field name="gstRatePercent"><default-field title="GST Rate %"><text-line size="4" default-value="18"/></default-field></field>
                    <field name="notes"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="JwListForm" list="jwList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="jobWorkNumber">
                    <header-field title="JW#"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="challanNumber"><default-field title="Challan"><display/></default-field></field>
                <field name="challanDate"><default-field title="Date"><display format="dd/MM/yyyy"/></default-field></field>
                <field name="isCapitalGoods"><default-field title="Capital"><display/></default-field></field>
                <field name="expectedReturnDate"><default-field title="Return By"><display format="dd/MM/yyyy"/></default-field></field>
                <field name="sacCode"><default-field title="SAC"><display/></default-field></field>
                <field name="jobWorkCharges"><default-field title="Charges"><display format="#,##,##0"/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="JwDraft" text="Draft"/><option key="JwDispatched" text="Dispatched"/>
                            <option key="JwPartialReturn" text="Partial"/><option key="JwReturned" text="Returned"/>
                            <option key="JwOverdue" text="Overdue"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="actions"><default-field title="">
                    <link url="dispatchJw" text="Dispatch" parameter-map="[jobWorkOrderId:jobWorkOrderId]"
                          condition="statusId == 'JwDraft' &amp;&amp; modCanWrite" confirmation="Dispatch goods to job worker?"/>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>

        <!-- Add items and receive returns sections shown inline via dialogs -->
        <section name="ItemSection" condition="jwList &amp;&amp; modCanWrite">
            <widgets>
                <container-box><box-header title="Add Items to Job Work / Record Returns"/><box-body>
                    <container-row>
                        <row-col lg="6">
                            <container-dialog id="AddItemDialog" button-text="Add Item to Job Work">
                                <form-single name="AddJwItemForm" transition="addJwItem">
                                    <field name="jobWorkOrderId"><default-field title="Job Work Order">
                                        <drop-down>
                                            <list-options list="jwList" key="${jobWorkOrderId}" text="${jobWorkNumber}"/>
                                        </drop-down>
                                    </default-field></field>
                                    <field name="productId"><default-field title="Product">
                                        <drop-down>
                                            <list-options list="productList" key="${productId}" text="${productName}"/>
                                        </drop-down>
                                    </default-field></field>
                                    <field name="dispatchedQuantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                                    <field name="valueAmount"><default-field title="Value (${currSymbol})"><text-line size="10"/></default-field></field>
                                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </row-col>
                        <row-col lg="6">
                            <container-dialog id="ReturnDialog" button-text="Record Return">
                                <form-single name="ReturnForm" transition="receiveReturn">
                                    <field name="jobWorkOrderId"><default-field title="Job Work Order">
                                        <drop-down>
                                            <list-options list="jwList" key="${jobWorkOrderId}" text="${jobWorkNumber}"/>
                                        </drop-down>
                                    </default-field></field>
                                    <field name="itemSeqId"><default-field title="Item Seq"><text-line size="6"/></default-field></field>
                                    <field name="returnedQuantity"><default-field title="Returned Qty"><text-line size="8"/></default-field></field>
                                    <field name="damagedQuantity"><default-field title="Damaged Qty"><text-line size="8" default-value="0"/></default-field></field>
                                    <field name="returnChallanNumber"><default-field title="Return Challan #"><text-line size="15"/></default-field></field>
                                    <field name="submitButton"><default-field title="Record"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </row-col>
                    </container-row>
                </box-body></container-box>
            </widgets>
        </section>
    </widgets>
</screen>
