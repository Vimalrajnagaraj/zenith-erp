<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Production Schedule" default-menu-index="7">

    <transition name="calculateCapacity">
        <service-call name="zenith.manufacturing.MrpServices.calculate#CapacityPlan"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Get active work orders grouped by date -->
        <entity-find entity-name="zenith.erp.manufacturing.WorkOrderView" list="activeWorkOrders">
            <econdition field-name="statusId" operator="in" value="WoReleased,WoInProgress"/>
            <order-by field-name="plannedStartDate,priority"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <!-- Get work center capacity -->
        <!-- ZE-SALES-014 f/u (Tier D): org-isolate capacity CSV via workCenter -> facility -> owner (multi-hop) -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expWcIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.facility.Facility" list="_expFacilities"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="facilityId"/></entity-find>
            <set field="_expFacilityIds" from="_expFacilities ? _expFacilities.collect{it.facilityId} : ['__none__']"/>
            <entity-find entity-name="zenith.erp.manufacturing.WorkCenter" list="_expWorkCenters"><econdition field-name="facilityId" operator="in" from="_expFacilityIds"/><select-field field-name="workCenterId"/></entity-find>
            <set field="_expWcIds" from="_expWorkCenters ? _expWorkCenters.collect{it.workCenterId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.manufacturing.CapacityPlan" list="capacityPlans">
            <order-by field-name="planDate,workCenterId"/>
            <econdition field-name="workCenterId" operator="in" from="_expWcIds" ignore-if-empty="true"/>
        </entity-find>

        <!-- Work center utilization summary -->
        <entity-find entity-name="zenith.erp.manufacturing.WorkCenter" list="workCenters">
            <econdition field-name="isActive" value="Y"/>
        </entity-find>

        <!-- Summary stats -->
        <entity-find-count entity-name="zenith.erp.manufacturing.WorkOrder" count-field="releasedCount">
            <econdition field-name="statusId" value="WoReleased"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.manufacturing.WorkOrder" count-field="inProgressCount">
            <econdition field-name="statusId" value="WoInProgress"/>
        </entity-find-count>

        <!-- Overdue work orders -->
        <set field="today" from="new java.sql.Date(System.currentTimeMillis())"/>
        <entity-find entity-name="zenith.erp.manufacturing.WorkOrderView" list="overdueOrders">
            <econdition field-name="statusId" operator="in" value="WoReleased,WoInProgress"/>
            <econdition field-name="plannedEndDate" operator="less" from="today"/>
            <!-- ZE-SALES-014 f/u: multi-list screen — isolate the overdue list too (CSV renders every list) -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Production Schedule" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="View active production orders, work center capacity, and scheduling conflicts" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <link url="calculateCapacity" text="Recalculate Capacity" icon="fa fa-refresh"
                  btn-type="primary" style="text-weight-bold q-px-lg" condition="modCanWrite"/>
        </container>

        <!-- KPI Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Released" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${releasedCount}" type="h3" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="In Progress" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${inProgressCount}" type="h3" style="text-positive text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Overdue" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${overdueOrders.size()}" type="h3" style="text-negative text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Work Centers" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${workCenters.size()}" type="h3" style="text-grey-8 text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Work Center Capacity -->
        <section name="CapacitySection" condition="capacityPlans">
            <widgets>
                <container style="bg-white shadow-2 border-radius-lg q-pa-md q-mb-md">
                    <label text="Work Center Capacity Utilization" type="h6" style="text-weight-bold q-mb-md"/>
                    <form-list name="CapacityList" list="capacityPlans" skip-form="true">
                        <field name="workCenterId"><default-field title="Work Center">
                            <display-entity entity-name="zenith.erp.manufacturing.WorkCenter" text="${workCenterName}"/>
                        </default-field></field>
                        <field name="planDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="availableHours"><default-field title="Available Hrs"><display format="#,##0.0"/></default-field></field>
                        <field name="plannedHours"><default-field title="Planned Hrs"><display format="#,##0.0"/></default-field></field>
                        <field name="utilizationPercent"><default-field title="Utilization">
                            <display format="#0.0'%'" style="${utilizationPercent > 100 ? 'text-negative text-weight-bold' : utilizationPercent > 80 ? 'text-warning text-weight-bold' : 'text-positive text-weight-bold'}"/>
                        </default-field></field>
                        <field name="overloadFlag"><default-field title="Status">
                            <display text="${overloadFlag == 'Y' ? 'OVERLOADED' : 'OK'}"
                                     style="${overloadFlag == 'Y' ? 'text-negative text-weight-bold' : 'text-positive'}"/>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>

        <!-- Overdue Warning -->
        <section name="OverdueSection" condition="overdueOrders">
            <widgets>
                <container style="bg-red-1 shadow-2 border-radius-lg q-pa-md q-mb-md">
                    <label text="Overdue Work Orders" type="h6" style="text-negative text-weight-bold q-mb-md"/>
                    <form-list name="OverdueList" list="overdueOrders" skip-form="true">
                        <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                        <field name="productName"><default-field title="Product"><display/></default-field></field>
                        <field name="quantity"><default-field title="Qty"><display format="#,##0"/></default-field></field>
                        <field name="plannedEndDate"><default-field title="Due Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                        </default-field></field>
                    </form-list>
                </container>
            </widgets>
        </section>

        <!-- Active Production Orders -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <label text="Active Production Orders" type="h6" style="text-weight-bold q-mb-md"/>
            <form-list name="ProductionScheduleList" list="activeWorkOrders" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                <field name="productName"><default-field title="Product"><display/></default-field></field>
                <field name="quantity"><default-field title="Plan Qty"><display format="#,##0"/></default-field></field>
                <field name="completedQuantity"><default-field title="Completed"><display format="#,##0"/></default-field></field>
                <field name="plannedStartDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="plannedEndDate"><default-field title="End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="priority"><default-field title="Priority"><display/></default-field></field>
                <field name="statusId"><default-field title="Status">
                    <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                </default-field></field>
                <field name="viewDetail"><default-field title="">
                    <link url="/apps/zenith/manufacturing/EditWorkOrder" text="View" btn-type="info" style="q-btn--dense"
                          parameter-map="[workOrderId: workOrderId]"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
