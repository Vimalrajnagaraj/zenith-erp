<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work Orders" default-menu-index="1">

    <transition name="createWo">
        <service-call name="zenith.manufacturing.ManufacturingServices.create#WorkOrder"/>
        <default-response url="../EditWorkOrder"/>
    </transition>
    <transition name="editWo">
        <default-response url="../EditWorkOrder"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.manufacturing.WorkOrderView" list="woList">
            <search-form-inputs default-order-by="-workOrderNumber"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.product.Product" list="productList">
            <econdition field-name="productTypeEnumId" value="PtFinishedGood" or-null="true"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="productName"/>
        </entity-find>
        <entity-find entity-name="mantle.facility.Facility" list="facilityList">
            <order-by field-name="facilityName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Work Orders"/><box-toolbar>
            <section name="NewWo_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewWoDialog" button-text="New Work Order">
                <form-single name="NewWoForm" transition="createWo">
                    <field name="productId"><default-field title="Product (Finished Good)">
                        <drop-down>
                            <list-options list="productList" key="${productId}" text="${productName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="quantity"><default-field title="Quantity to Produce"><text-line size="8"/></default-field></field>
                    <field name="facilityId"><default-field title="Facility">
                        <drop-down allow-empty="true">
                            <list-options list="facilityList" key="${facilityId}" text="${facilityName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="plannedStartDate"><default-field title="Planned Start"><date-time type="date"/></default-field></field>
                    <field name="plannedEndDate"><default-field title="Planned End"><date-time type="date"/></default-field></field>
                    <field name="priority"><default-field>
                        <drop-down><option key="High"/><option key="Medium"/><option key="Low"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="WoListForm" list="woList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="workOrderNumber">
                    <header-field title="WO#" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><link url="editWo" text="${workOrderNumber}"
                        parameter-map="[workOrderId:workOrderId]"/></default-field>
                </field>
                <field name="productName">
                    <header-field title="Product"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="quantity"><default-field title="Planned"><display/></default-field></field>
                <field name="completedQuantity"><default-field title="Done"><display/></default-field></field>
                <field name="plannedStartDate">
                    <header-field title="Start" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd/MM/yyyy"/></default-field>
                </field>
                <field name="plannedEndDate"><default-field title="End"><display format="dd/MM/yyyy"/></default-field></field>
                <field name="priority"><default-field><display/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="WoDraft" text="Draft"/><option key="WoReleased" text="Released"/>
                            <option key="WoInProgress" text="In Progress"/><option key="WoCompleted" text="Completed"/>
                            <option key="WoCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
