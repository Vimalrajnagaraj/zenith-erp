<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Fleet" default-menu-include="true">
    
    <subscreens default-item="FleetDashboard"/>

    <transition name="goMaintenance"><default-response url="../maintenance/MaintenanceDashboard"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/FindContact"/></transition>
    <transition name="goExpenses"><default-response url="../expenses/MyExpenses"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_maintenance_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('maintenance'))"><widgets><link url="goMaintenance" text="Maintenance" icon="fa fa-wrench" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_contacts_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="goContacts" text="Contacts" icon="fa fa-address-book" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_expenses_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('expenses'))"><widgets><link url="goExpenses" text="Expenses" icon="fa fa-credit-card" btn-type="warning" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
