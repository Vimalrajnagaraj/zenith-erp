<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vehicle Detail" default-menu-include="false">

    <parameter name="vehicleId" required="true"/>

    <transition name="updateVehicle" begin-transaction="true">
        <service-call name="update#zenith.erp.fleet.Vehicle"/>
        <default-response url="."/>
    </transition>
    <transition name="assignVehicle" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.assign#Vehicle"/>
        <default-response url="."/>
    </transition>
    <transition name="returnVehicle" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.return#Vehicle"/>
        <default-response url="."/>
    </transition>
    <transition name="logFuel" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.log#Fuel"/>
        <default-response url="."/>
    </transition>
    <transition name="createDocument" begin-transaction="true">
        <service-call name="create#zenith.erp.fleet.VehicleDocument"/>
        <default-response url="."/>
    </transition>
    <transition name="createExpense" begin-transaction="true">
        <service-call name="create#zenith.erp.fleet.VehicleExpense"/>
        <default-response url="."/>
    </transition>
    <transition name="createService" begin-transaction="true">
        <service-call name="create#zenith.erp.fleet.VehicleService"/>
        <default-response url="."/>
    </transition>
    <transition name="completeService" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.complete#VehicleService"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.fleet.Vehicle" value-field="vehicle"/>
        <entity-find entity-name="zenith.erp.fleet.VehicleAssignment" list="assignmentList">
            <econdition field-name="vehicleId"/>
            <order-by field-name="-assignedDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.FuelLog" list="fuelList">
            <econdition field-name="vehicleId"/>
            <order-by field-name="-fuelDate"/>
            <limit count="20"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.VehicleDocument" list="docList">
            <econdition field-name="vehicleId"/>
            <order-by field-name="expiryDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.VehicleExpense" list="expenseList">
            <econdition field-name="vehicleId"/>
            <order-by field-name="-expenseDate"/>
            <limit count="20"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.VehicleService" list="serviceList">
            <econdition field-name="vehicleId"/>
            <order-by field-name="-serviceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <!-- Vehicle Detail -->
                <container-box><box-header title="${vehicle.vehicleNumber}: ${vehicle.registrationNumber}"/>
                <box-body>
                    <form-single name="VehicleForm" transition="updateVehicle" map="vehicle">
                        <field name="vehicleId"><default-field><hidden/></default-field></field>
                        <field name="vehicleNumber"><default-field title="Vehicle #"><display/></default-field></field>
                        <field name="registrationNumber"><default-field title="Reg No"><text-line size="15"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Vehicle"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="make"><default-field title="Make"><text-line size="15"/></default-field></field>
                        <field name="model"><default-field title="Model"><text-line size="15"/></default-field></field>
                        <field name="yearOfManufacture"><default-field title="Year"><text-line size="6"/></default-field></field>
                        <field name="engineNumber"><default-field title="Engine No"><text-line size="20"/></default-field></field>
                        <field name="chassisNumber"><default-field title="Chassis No"><text-line size="20"/></default-field></field>
                        <field name="color"><default-field title="Color"><text-line size="10"/></default-field></field>
                        <field name="currentOdometerKm"><default-field title="Odometer (km)"><text-line size="10"/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <!-- Compliance / Documents -->
                <container-box><box-header title="Compliance &amp; Expiry Dates"/>
                <box-body>
                    <form-single name="ComplianceForm" transition="updateVehicle" map="vehicle">
                        <field name="vehicleId"><default-field><hidden/></default-field></field>
                        <field name="insurancePolicyNumber"><default-field title="Insurance Policy"><text-line size="20"/></default-field></field>
                        <field name="insuranceProvider"><default-field title="Insurer"><text-line size="20"/></default-field></field>
                        <field name="insuranceExpiryDate"><default-field title="Insurance Expiry"><date-time type="date"/></default-field></field>
                        <field name="fitnessExpiryDate"><default-field title="Fitness Expiry"><date-time type="date"/></default-field></field>
                        <field name="pucExpiryDate"><default-field title="PUC Expiry"><date-time type="date"/></default-field></field>
                        <field name="permitExpiryDate"><default-field title="Permit Expiry"><date-time type="date"/></default-field></field>
                        <field name="roadTaxExpiryDate"><default-field title="Road Tax Expiry"><date-time type="date"/></default-field></field>
                        <field name="fastagNumber"><default-field title="FASTag Number"><text-line size="20"/></default-field></field>
                        <field name="fastagProvider"><default-field title="FASTag Bank"><text-line size="15"/></default-field></field>
                        <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <!-- Documents -->
                <container-box><box-header title="Documents"/>
                <box-toolbar>
                    <container-dialog id="AddDocDialog" button-text="Add Document">
                        <form-single name="AddDocForm" transition="createDocument">
                            <field name="vehicleId"><default-field><hidden/></default-field></field>
                            <field name="documentType"><default-field title="Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="VehicleDocType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="documentNumber"><default-field title="Document No"><text-line size="20"/></default-field></field>
                            <field name="issueDate"><default-field title="Issue Date"><date-time type="date"/></default-field></field>
                            <field name="expiryDate"><default-field title="Expiry Date"><date-time type="date"/></default-field></field>
                            <field name="issuingAuthority"><default-field title="Issuing Authority"><text-line size="25"/></default-field></field>
                            <field name="remarks"><default-field title="Remarks"><text-line size="30"/></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body>
                    <form-list name="DocList" list="docList" skip-form="true">
                        <field name="documentType"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="documentNumber"><default-field title="Number"><display/></default-field></field>
                        <field name="issueDate"><default-field title="Issued"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="expiryDate"><default-field title="Expires"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="isActive"><default-field title="Active"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Actions -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <container-dialog id="AssignDialog" button-text="Assign Driver">
                        <form-single name="AssignForm" transition="assignVehicle">
                            <field name="vehicleId"><default-field><hidden/></default-field></field>
                            <field name="driverId"><default-field title="Driver">
                                <drop-down><entity-options key="${driverId}" text="${driverName} (${licenseNumber})">
                                    <entity-find entity-name="zenith.erp.fleet.FleetDriver">
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="odometerAtAssignment"><default-field title="Odometer (km)"><text-line size="10"/></default-field></field>
                            <field name="purpose"><default-field title="Purpose"><text-line size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Assign"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="FuelDialog" button-text="Log Fuel">
                        <form-single name="FuelForm" transition="logFuel">
                            <field name="vehicleId"><default-field><hidden/></default-field></field>
                            <field name="fuelDate"><default-field title="Date"><date-time/></default-field></field>
                            <field name="fuelType"><default-field title="Fuel Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="FuelType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="quantityLitres"><default-field title="Quantity (L)"><text-line size="8"/></default-field></field>
                            <field name="ratePerLitre"><default-field title="Rate/Litre (${currSymbol})"><text-line size="8"/></default-field></field>
                            <field name="odometerKm"><default-field title="Odometer (km)"><text-line size="10"/></default-field></field>
                            <field name="fuelStationName"><default-field title="Station"><text-line size="20"/></default-field></field>
                            <field name="fuelStationCity"><default-field title="City"><text-line size="15"/></default-field></field>
                            <field name="paymentMode"><default-field title="Payment">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="FuelPaymentMode"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="receiptNumber"><default-field title="Receipt No"><text-line size="15"/></default-field></field>
                            <field name="isFullTank"><default-field title="Full Tank">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Log"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ExpenseDialog" button-text="Add Expense">
                        <form-single name="ExpenseForm" transition="createExpense">
                            <field name="vehicleId"><default-field><hidden/></default-field></field>
                            <field name="expenseType"><default-field title="Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="VehicleExpenseType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="expenseDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                            <field name="amount"><default-field title="Amount (${currSymbol})"><text-line size="10"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                            <field name="vendorName"><default-field title="Vendor"><text-line size="20"/></default-field></field>
                            <field name="receiptNumber"><default-field title="Receipt No"><text-line size="15"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ServiceDialog" button-text="Schedule Service">
                        <form-single name="ServiceForm" transition="createService">
                            <field name="vehicleId"><default-field><hidden/></default-field></field>
                            <field name="serviceType"><default-field title="Type">
                                <drop-down><option key="Scheduled" text="Scheduled"/><option key="Breakdown" text="Breakdown"/>
                                    <option key="Accident" text="Accident Repair"/></drop-down></default-field></field>
                            <field name="serviceDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                            <field name="odometerAtService"><default-field title="Odometer"><text-line size="10"/></default-field></field>
                            <field name="serviceProvider"><default-field title="Provider"><text-line size="20"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="laborCost"><default-field title="Labor (${currSymbol})"><text-line size="10"/></default-field></field>
                            <field name="partsCost"><default-field title="Parts (${currSymbol})"><text-line size="10"/></default-field></field>
                            <field name="statusId"><default-field><hidden default-value="VsScheduled"/></default-field></field>
                            <field name="submitButton"><default-field title="Schedule"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-body></container-box>

                <!-- Assignments -->
                <container-box><box-header title="Driver Assignments"/>
                <box-body>
                    <form-list name="AssignmentList" list="assignmentList" skip-form="true">
                        <field name="driverId"><default-field title="Driver"><display/></default-field></field>
                        <field name="assignedDate"><default-field title="Assigned"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="returnDate"><default-field title="Returned"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="odometerAtAssignment"><default-field title="Start km"><display format="#,##0"/></default-field></field>
                        <field name="odometerAtReturn"><default-field title="End km"><display format="#,##0"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="returnBtn"><default-field title="">
                            <link url="returnVehicle" text="Return" parameter-map="[assignmentId:assignmentId]"
                                  condition="statusId=='VaAssigned'" confirmation="Return this vehicle?"/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Fuel Log -->
                <container-box><box-header title="Fuel Log (Recent 20)"/>
                <box-body>
                    <form-list name="FuelList" list="fuelList" skip-form="true">
                        <field name="fuelDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="quantityLitres"><default-field title="Litres"><display format="#,##0.00"/></default-field></field>
                        <field name="ratePerLitre"><default-field title="Rate"><display format="#,##0.00"/></default-field></field>
                        <field name="totalAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                        <field name="odometerKm"><default-field title="Odometer"><display format="#,##0"/></default-field></field>
                        <field name="fuelStationCity"><default-field title="City"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Service History -->
                <container-box><box-header title="Service History"/>
                <box-body>
                    <form-list name="ServiceList" list="serviceList" skip-form="true">
                        <field name="serviceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="serviceType"><default-field title="Type"><display/></default-field></field>
                        <field name="serviceProvider"><default-field title="Provider"><display/></default-field></field>
                        <field name="totalCost"><default-field title="Cost"><display format="#,##0"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="completeBtn"><default-field title="">
                            <link url="completeService" text="Complete" parameter-map="[serviceId:serviceId]"
                                  condition="statusId=='VsScheduled' || statusId=='VsInProgress'"
                                  confirmation="Mark service as completed?"/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Expenses -->
                <container-box><box-header title="Expenses (Recent 20)"/>
                <box-body>
                    <form-list name="ExpenseList" list="expenseList" skip-form="true">
                        <field name="expenseDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="expenseType"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="amount"><default-field title="Amount"><display format="#,##0"/></default-field></field>
                        <field name="description"><default-field title="Description"><display/></default-field></field>
                        <field name="vendorName"><default-field title="Vendor"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
