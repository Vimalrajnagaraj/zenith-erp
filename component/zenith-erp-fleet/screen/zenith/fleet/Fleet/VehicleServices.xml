<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Services" default-menu-index="6">

    <transition name="createService" begin-transaction="true">
        <service-call name="create#zenith.erp.fleet.VehicleService"/>
        <default-response url="."/>
    </transition>
    <transition name="completeService" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.complete#VehicleService"/>
        <default-response url="."/>
    </transition>
    <transition name="updateService" begin-transaction="true">
        <service-call name="update#zenith.erp.fleet.VehicleService"/>
        <default-response url="."/>
    </transition>
    <transition name="checkExpiry" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.check#DocumentExpiry" out-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.fleet.VehicleService" list="serviceList">
            <search-form-inputs default-order-by="-serviceDate"/>
            <order-by field-name="-serviceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Vehicle Service &amp; Maintenance"/>
            <box-toolbar>
                <section name="ScheduleService_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateServiceDialog" button-text="Schedule Service">
                    <form-single name="CreateServiceForm" transition="createService">
                        <field name="vehicleId"><default-field title="Vehicle">
                            <drop-down><entity-options key="${vehicleId}" text="${registrationNumber} - ${make} ${model}">
                                <entity-find entity-name="zenith.erp.fleet.Vehicle">
                                    <econdition field-name="statusId" operator="in" value="VhActive,VhInMaintenance"/>
                                    <order-by field-name="registrationNumber"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="serviceType"><default-field title="Type">
                            <drop-down><option key="Scheduled" text="Scheduled Service"/>
                                <option key="Breakdown" text="Breakdown Repair"/>
                                <option key="Accident" text="Accident Repair"/></drop-down></default-field></field>
                        <field name="serviceDate"><default-field title="Service Date"><date-time type="date"/></default-field></field>
                        <field name="odometerAtService"><default-field title="Odometer (km)"><text-line size="10"/></default-field></field>
                        <field name="serviceProvider"><default-field title="Service Provider"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="laborCost"><default-field title="Est Labor (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="partsCost"><default-field title="Est Parts (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="nextServiceDate"><default-field title="Next Service Date"><date-time type="date"/></default-field></field>
                        <field name="nextServiceOdometerKm"><default-field title="Next Service km"><text-line size="10"/></default-field></field>
                        <field name="statusId"><default-field><hidden default-value="VsScheduled"/></default-field></field>
                        <field name="submitButton"><default-field title="Schedule"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
                <link url="checkExpiry" text="Check Document Expiry" confirmation="Scan all vehicles for expiring documents?"/>
            </box-toolbar>
            <box-body>
                <form-list name="ServiceList" list="serviceList" skip-form="true">
                    <field name="serviceId"><default-field title="ID"><display/></default-field></field>
                    <field name="vehicleId"><default-field title="Vehicle"><display/></default-field></field>
                    <field name="serviceType"><default-field title="Type"><display/></default-field></field>
                    <field name="serviceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="serviceProvider"><default-field title="Provider"><display/></default-field></field>
                    <field name="description"><default-field title="Description"><display/></default-field></field>
                    <field name="laborCost"><default-field title="Labor"><display format="#,##0"/></default-field></field>
                    <field name="partsCost"><default-field title="Parts"><display format="#,##0"/></default-field></field>
                    <field name="totalCost"><default-field title="Total"><display format="#,##0"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="nextServiceDate"><default-field title="Next Service"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="completeBtn">
                        <conditional-field name="complete_write" condition="modCanWrite" title="">
                        <link url="completeService" text="Complete" parameter-map="[serviceId:serviceId]"
                              condition="statusId=='VsScheduled' || statusId=='VsInProgress'"
                              confirmation="Mark service completed?"/>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
