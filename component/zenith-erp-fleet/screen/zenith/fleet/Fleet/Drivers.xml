<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Drivers" default-menu-index="3">

    <transition name="createDriver" begin-transaction="true">
        <service-call name="create#zenith.erp.fleet.FleetDriver"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDriver" begin-transaction="true">
        <service-call name="update#zenith.erp.fleet.FleetDriver"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.fleet.FleetDriver" list="driverList">
            <order-by field-name="driverName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Fleet Drivers"/>
            <box-toolbar>
                <section name="AddDriver_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateDriverDialog" button-text="Add Driver">
                    <form-single name="CreateDriverForm" transition="createDriver">
                        <field name="driverId"><default-field title="Driver ID"><text-line size="15"/></default-field></field>
                        <field name="driverName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="licenseNumber"><default-field title="License No"><text-line size="20"/></default-field></field>
                        <field name="licenseType"><default-field title="License Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="LicenseType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="licenseExpiryDate"><default-field title="License Expiry"><date-time type="date"/></default-field></field>
                        <field name="badgeNumber"><default-field title="Badge No"><text-line size="10"/></default-field></field>
                        <field name="bloodGroup"><default-field title="Blood Group">
                            <drop-down allow-empty="true">
                                <option key="A+"/><option key="A-"/><option key="B+"/><option key="B-"/>
                                <option key="O+"/><option key="O-"/><option key="AB+"/><option key="AB-"/>
                            </drop-down></default-field></field>
                        <field name="emergencyContactName"><default-field title="Emergency Contact"><text-line size="20"/></default-field></field>
                        <field name="emergencyContactPhone"><default-field title="Emergency Phone"><text-line size="12"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DriverList" list="driverList" transition="updateDriver">
                    <field name="driverId"><default-field title="ID"><display/></default-field></field>
                    <field name="driverName"><default-field title="Name"><text-line size="18"/></default-field></field>
                    <field name="licenseNumber"><default-field title="License No"><text-line size="15"/></default-field></field>
                    <field name="licenseType"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="LicenseType"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="licenseExpiryDate"><default-field title="License Expiry"><date-time type="date"/></default-field></field>
                    <field name="bloodGroup"><default-field title="Blood">
                        <drop-down allow-empty="true">
                            <option key="A+"/><option key="A-"/><option key="B+"/><option key="B-"/>
                            <option key="O+"/><option key="O-"/><option key="AB+"/><option key="AB-"/>
                        </drop-down></default-field></field>
                    <field name="emergencyContactPhone"><default-field title="Emergency Ph"><text-line size="12"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
