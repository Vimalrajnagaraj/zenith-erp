<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Trips" default-menu-index="5">

    <transition name="createTrip" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.create#Trip"/>
        <default-response url="."/>
    </transition>
    <transition name="startTrip" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.start#Trip"/>
        <default-response url="."/>
    </transition>
    <transition name="completeTrip" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.complete#Trip"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTrip" begin-transaction="true">
        <service-call name="update#zenith.erp.fleet.TripLog"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.fleet.TripLogView" list="tripList">
            <search-form-inputs default-order-by="-plannedStartDate"/>
            <order-by field-name="-plannedStartDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Trip Log"/>
            <box-toolbar>
                <container-dialog id="CreateTripDialog" button-text="Plan Trip">
                    <form-single name="CreateTripForm" transition="createTrip">
                        <field name="vehicleId"><default-field title="Vehicle">
                            <drop-down><entity-options key="${vehicleId}" text="${registrationNumber} - ${make} ${model}">
                                <entity-find entity-name="zenith.erp.fleet.Vehicle">
                                    <econdition field-name="statusId" value="VhActive"/>
                                    <order-by field-name="registrationNumber"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="driverId"><default-field title="Driver">
                            <drop-down allow-empty="true"><entity-options key="${driverId}" text="${driverName}">
                                <entity-find entity-name="zenith.erp.fleet.FleetDriver">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fromLocation"><default-field title="From"><text-line size="25"/></default-field></field>
                        <field name="toLocation"><default-field title="To"><text-line size="25"/></default-field></field>
                        <field name="purpose"><default-field title="Purpose"><text-line size="30"/></default-field></field>
                        <field name="plannedStartDate"><default-field title="Planned Start"><date-time/></default-field></field>
                        <field name="submitButton"><default-field title="Plan"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="TripList" list="tripList" skip-form="true">
                    <field name="tripNumber"><default-field title="Trip #"><display/></default-field></field>
                    <field name="registrationNumber"><default-field title="Vehicle"><display/></default-field></field>
                    <field name="driverName"><default-field title="Driver"><display/></default-field></field>
                    <field name="fromLocation"><default-field title="From"><display/></default-field></field>
                    <field name="toLocation"><default-field title="To"><display/></default-field></field>
                    <field name="distanceKm"><default-field title="Distance (km)"><display format="#,##0"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="plannedStartDate"><default-field title="Planned"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="tollAmount"><default-field title="Toll"><display format="#,##0"/></default-field></field>
                    <field name="startBtn"><default-field title="">
                        <link url="startTrip" text="Start" parameter-map="[tripId:tripId]"
                              condition="statusId=='TrPlanned'" confirmation="Start this trip?"/></default-field></field>
                    <field name="completeBtn"><default-field title="">
                        <link url="completeTrip" text="Complete" parameter-map="[tripId:tripId]"
                              condition="statusId=='TrInProgress'" confirmation="Complete this trip?"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Trip completion dialog for entering end details -->
        <container-box>
            <box-header title="Complete Trip (enter end details)"/>
            <box-body>
                <form-single name="CompleteTripForm" transition="completeTrip">
                    <field name="tripId"><default-field title="Trip ID"><text-line size="15"/></default-field></field>
                    <field name="endOdometerKm"><default-field title="End Odometer (km)"><text-line size="10"/></default-field></field>
                    <field name="tollAmount"><default-field title="Toll Amount (${currSymbol})"><text-line size="10"/></default-field></field>
                    <field name="otherExpenses"><default-field title="Other Expenses (${currSymbol})"><text-line size="10"/></default-field></field>
                    <field name="remarks"><default-field title="Remarks"><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Complete Trip"><submit/></default-field></field>
                </form-single>
            </box-body>
        </container-box>
    </widgets>
</screen>
