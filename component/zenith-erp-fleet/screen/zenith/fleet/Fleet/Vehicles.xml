<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vehicles" default-menu-index="2">

    <transition name="createVehicle" begin-transaction="true">
        <service-call name="zenith.fleet.FleetServices.create#Vehicle"/>
        <default-response url="."/>
    </transition>
    <transition name="editVehicle"><default-response url="../EditVehicle"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.fleet.Vehicle" list="vehicleList">
            <search-form-inputs default-order-by="registrationNumber"/>
            <order-by field-name="registrationNumber"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Fleet Vehicles"/>
            <box-toolbar>
                <section name="AddVehicle_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateVehicleDialog" button-text="Add Vehicle">
                    <form-single name="CreateVehicleForm" transition="createVehicle">
                        <field name="registrationNumber"><default-field title="Registration No (e.g. KA01AB1234)"><text-line size="15"/></default-field></field>
                        <field name="vehicleType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="VehicleType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="make"><default-field title="Make"><text-line size="20"/></default-field></field>
                        <field name="model"><default-field title="Model"><text-line size="20"/></default-field></field>
                        <field name="yearOfManufacture"><default-field title="Year"><text-line size="6"/></default-field></field>
                        <field name="fuelType"><default-field title="Fuel">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="FuelType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="ownershipType"><default-field title="Ownership">
                            <drop-down no-current-selected-key="OtOwned"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="OwnershipType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="engineNumber"><default-field title="Engine No"><text-line size="20"/></default-field></field>
                        <field name="chassisNumber"><default-field title="Chassis No"><text-line size="20"/></default-field></field>
                        <field name="color"><default-field title="Color"><text-line size="10"/></default-field></field>
                        <field name="seatingCapacity"><default-field title="Seats"><text-line size="4"/></default-field></field>
                        <field name="loadCapacityKg"><default-field title="Load (kg)"><text-line size="8"/></default-field></field>
                        <field name="purchaseDate"><default-field title="Purchase Date"><date-time type="date"/></default-field></field>
                        <field name="purchaseAmount"><default-field title="Purchase Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="fastagNumber"><default-field title="FASTag Number"><text-line size="20"/></default-field></field>
                        <field name="fastagProvider"><default-field title="FASTag Bank">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="FastagProvider"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="VehicleList" list="vehicleList" skip-form="true">
                    <field name="vehicleNumber"><default-field title="Vehicle #"><display/></default-field></field>
                    <field name="registrationNumber"><default-field title="Reg No"><display/></default-field></field>
                    <field name="vehicleType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="make"><default-field title="Make"><display/></default-field></field>
                    <field name="model"><default-field title="Model"><display/></default-field></field>
                    <field name="fuelType"><default-field title="Fuel">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="currentOdometerKm"><default-field title="Odometer (km)"><display format="#,##0"/></default-field></field>
                    <field name="insuranceExpiryDate"><default-field title="Ins Expiry"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editVehicle" text="Detail" parameter-map="[vehicleId:vehicleId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
