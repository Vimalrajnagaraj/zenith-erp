<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.fleet.Vehicle" count-field="totalVehicles"/>
        <entity-find-count entity-name="zenith.erp.fleet.Vehicle" count-field="activeVehicles">
            <econdition field-name="statusId" value="VhActive"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.fleet.Vehicle" count-field="maintenanceVehicles">
            <econdition field-name="statusId" value="VhInMaintenance"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.fleet.FleetDriver" count-field="totalDrivers">
            <econdition field-name="isActive" value="Y"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.fleet.TripLog" count-field="activeTrips">
            <econdition field-name="statusId" value="TrInProgress"/></entity-find-count>

        <!-- Vehicles with expiring documents (next 30 days) -->
        <set field="cutoffDate" from="new java.sql.Date(System.currentTimeMillis() + 30L * 24 * 60 * 60 * 1000)"/>
        <entity-find entity-name="zenith.erp.fleet.Vehicle" list="expiringInsurance">
            <econdition field-name="statusId" value="VhActive"/>
            <econdition field-name="insuranceExpiryDate" operator="less-equals" from="cutoffDate"/>
            <econdition field-name="insuranceExpiryDate" operator="is-not-null"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.Vehicle" list="expiringPuc">
            <econdition field-name="statusId" value="VhActive"/>
            <econdition field-name="pucExpiryDate" operator="less-equals" from="cutoffDate"/>
            <econdition field-name="pucExpiryDate" operator="is-not-null"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fleet.Vehicle" list="expiringFitness">
            <econdition field-name="statusId" value="VhActive"/>
            <econdition field-name="fitnessExpiryDate" operator="less-equals" from="cutoffDate"/>
            <econdition field-name="fitnessExpiryDate" operator="is-not-null"/>
        </entity-find>

        <!-- Upcoming services -->
        <entity-find entity-name="zenith.erp.fleet.VehicleService" list="upcomingServices">
            <econdition field-name="statusId" value="VsScheduled"/>
            <order-by field-name="serviceDate"/>
            <limit count="10"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="3" md="6">
                <container-box><box-header title="Total Vehicles"/>
                <box-body><label text="${totalVehicles}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Active"/>
                <box-body><label text="${activeVehicles}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="In Maintenance"/>
                <box-body><label text="${maintenanceVehicles}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Active Trips"/>
                <box-body><label text="${activeTrips}" type="h3"/></box-body></container-box>
            </row-col>
        </container-row>

        <container-box>
            <box-header title="Expiring Documents (Next 30 Days)"/>
            <box-body>
                <label text="Insurance: ${expiringInsurance.size()} vehicles | PUC: ${expiringPuc.size()} vehicles | Fitness: ${expiringFitness.size()} vehicles"
                       type="p"/>
                <form-list name="ExpiringInsuranceList" list="expiringInsurance" skip-form="true">
                    <field name="registrationNumber"><default-field title="Reg No"><display/></default-field></field>
                    <field name="make"><default-field title="Make"><display/></default-field></field>
                    <field name="model"><default-field title="Model"><display/></default-field></field>
                    <field name="insuranceExpiryDate"><default-field title="Insurance Expiry"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="pucExpiryDate"><default-field title="PUC Expiry"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="fitnessExpiryDate"><default-field title="Fitness Expiry"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="viewBtn"><default-field title="">
                        <link url="../Vehicles/EditVehicle" text="View" parameter-map="[vehicleId:vehicleId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Upcoming Service Schedule"/>
            <box-body>
                <form-list name="UpcomingServiceList" list="upcomingServices" skip-form="true">
                    <field name="vehicleId"><default-field title="Vehicle"><display/></default-field></field>
                    <field name="serviceType"><default-field title="Type"><display/></default-field></field>
                    <field name="serviceDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="serviceProvider"><default-field title="Provider"><display/></default-field></field>
                    <field name="description"><default-field title="Description"><display/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
