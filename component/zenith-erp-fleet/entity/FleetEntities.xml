<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Vehicle ========== -->
    <entity entity-name="Vehicle" package="zenith.erp.fleet" short-alias="Vehicles">
        <field name="vehicleId" type="id" is-pk="true"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="registrationNumber" type="text-short"/>
        <field name="vehicleType" type="id"/>
        <field name="make" type="text-medium"/>
        <field name="model" type="text-medium"/>
        <field name="yearOfManufacture" type="number-integer"/>
        <field name="engineNumber" type="text-medium"/>
        <field name="chassisNumber" type="text-medium"/>
        <field name="fuelType" type="id"/>
        <field name="color" type="text-short"/>
        <field name="seatingCapacity" type="number-integer"/>
        <field name="loadCapacityKg" type="number-decimal"/>
        <field name="currentOdometerKm" type="number-decimal"/>
        <field name="statusId" type="id"/>
        <field name="purchaseDate" type="date"/>
        <field name="purchaseAmount" type="currency-precise"/>
        <field name="ownershipType" type="id"/>
        <field name="insurancePolicyNumber" type="text-medium"/>
        <field name="insuranceProvider" type="text-medium"/>
        <field name="insuranceExpiryDate" type="date"/>
        <field name="fitnessExpiryDate" type="date"/>
        <field name="pucExpiryDate" type="date"/>
        <field name="permitExpiryDate" type="date"/>
        <field name="roadTaxExpiryDate" type="date"/>
        <field name="fastagNumber" type="text-medium"/>
        <field name="fastagProvider" type="text-short"/>
        <field name="assignedDriverPartyId" type="id"/>
        <field name="facilityId" type="id"/>
        <relationship type="one" title="Vehicle" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Vehicle" description="Fleet Vehicle"/>
            <moqui.basic.StatusItem statusId="VhActive" statusTypeId="Vehicle" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="VhInMaintenance" statusTypeId="Vehicle" description="In Maintenance" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="VhRetired" statusTypeId="Vehicle" description="Retired" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="VhSold" statusTypeId="Vehicle" description="Sold" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VhActive" toStatusId="VhInMaintenance" transitionName="Send to Maintenance"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VhActive" toStatusId="VhRetired" transitionName="Retire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VhActive" toStatusId="VhSold" transitionName="Sell"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VhInMaintenance" toStatusId="VhActive" transitionName="Return to Service"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VhRetired" toStatusId="VhSold" transitionName="Sell"/>
        </seed-data>
    </entity>

    <!-- ========== Driver ========== -->
    <entity entity-name="FleetDriver" package="zenith.erp.fleet" short-alias="FleetDrivers">
        <field name="driverId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="driverName" type="text-medium"/>
        <field name="licenseNumber" type="text-medium"/>
        <field name="licenseType" type="id"/>
        <field name="licenseExpiryDate" type="date"/>
        <field name="badgeNumber" type="text-short"/>
        <field name="bloodGroup" type="text-short"/>
        <field name="emergencyContactName" type="text-medium"/>
        <field name="emergencyContactPhone" type="text-short"/>
        <field name="isActive" type="text-indicator"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="LicenseType" description="Driving License Type"/>
            <moqui.basic.Enumeration enumId="LtLmv" enumTypeId="LicenseType" description="LMV - Light Motor Vehicle" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="LtHmv" enumTypeId="LicenseType" description="HMV - Heavy Motor Vehicle" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="LtHgmv" enumTypeId="LicenseType" description="HGMV - Heavy Goods Motor Vehicle" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="LtHpmv" enumTypeId="LicenseType" description="HPMV - Heavy Passenger Motor Vehicle" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="LtMcwg" enumTypeId="LicenseType" description="MCWG - Motorcycle with Gear" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="LtMcwog" enumTypeId="LicenseType" description="MCWOG - Motorcycle without Gear" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Vehicle Assignment ========== -->
    <entity entity-name="VehicleAssignment" package="zenith.erp.fleet" short-alias="VehicleAssignments">
        <field name="assignmentId" type="id" is-pk="true"/>
        <field name="vehicleId" type="id"/>
        <field name="driverId" type="id"/>
        <field name="assignedDate" type="date-time"/>
        <field name="returnDate" type="date-time"/>
        <field name="odometerAtAssignment" type="number-decimal"/>
        <field name="odometerAtReturn" type="number-decimal"/>
        <field name="purpose" type="text-medium"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <relationship type="one" related="zenith.erp.fleet.FleetDriver"/>
        <relationship type="one" title="VehicleAssignment" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="VehicleAssignment" description="Vehicle Assignment"/>
            <moqui.basic.StatusItem statusId="VaAssigned" statusTypeId="VehicleAssignment" description="Assigned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="VaReturned" statusTypeId="VehicleAssignment" description="Returned" sequenceNum="2"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VaAssigned" toStatusId="VaReturned" transitionName="Return"/>
        </seed-data>
    </entity>

    <!-- ========== Fuel Log ========== -->
    <entity entity-name="FuelLog" package="zenith.erp.fleet" short-alias="FuelLogs">
        <field name="fuelLogId" type="id" is-pk="true"/>
        <field name="vehicleId" type="id"/>
        <field name="driverId" type="id"/>
        <field name="fuelDate" type="date-time"/>
        <field name="fuelType" type="id"/>
        <field name="quantityLitres" type="number-decimal"/>
        <field name="ratePerLitre" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="odometerKm" type="number-decimal"/>
        <field name="fuelStationName" type="text-medium"/>
        <field name="fuelStationCity" type="text-medium"/>
        <field name="receiptNumber" type="text-short"/>
        <field name="paymentMode" type="id"/>
        <field name="isFullTank" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <relationship type="one" related="zenith.erp.fleet.FleetDriver"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="VehicleType" description="Vehicle Type"/>
            <moqui.basic.Enumeration enumId="VtCar" enumTypeId="VehicleType" description="Car" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VtSuv" enumTypeId="VehicleType" description="SUV" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VtTruck" enumTypeId="VehicleType" description="Truck" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VtVan" enumTypeId="VehicleType" description="Van" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="VtBus" enumTypeId="VehicleType" description="Bus" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="VtBike" enumTypeId="VehicleType" description="Two-Wheeler" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="VtTempo" enumTypeId="VehicleType" description="Tempo/Auto" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="VtTrailer" enumTypeId="VehicleType" description="Trailer" sequenceNum="8"/>

            <moqui.basic.EnumerationType enumTypeId="FuelType" description="Fuel Type"/>
            <moqui.basic.Enumeration enumId="FtPetrol" enumTypeId="FuelType" description="Petrol" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="FtDiesel" enumTypeId="FuelType" description="Diesel" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="FtCng" enumTypeId="FuelType" description="CNG" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="FtLpg" enumTypeId="FuelType" description="LPG" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="FtElectric" enumTypeId="FuelType" description="Electric" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="FtHybrid" enumTypeId="FuelType" description="Hybrid" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="OwnershipType" description="Vehicle Ownership"/>
            <moqui.basic.Enumeration enumId="OtOwned" enumTypeId="OwnershipType" description="Owned" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="OtLeased" enumTypeId="OwnershipType" description="Leased" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="OtRented" enumTypeId="OwnershipType" description="Rented" sequenceNum="3"/>

            <moqui.basic.EnumerationType enumTypeId="FuelPaymentMode" description="Fuel Payment Mode"/>
            <moqui.basic.Enumeration enumId="FpmCash" enumTypeId="FuelPaymentMode" description="Cash" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="FpmCard" enumTypeId="FuelPaymentMode" description="Card" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="FpmUpi" enumTypeId="FuelPaymentMode" description="UPI" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="FpmFleetCard" enumTypeId="FuelPaymentMode" description="Fleet Card (HPCL/BPCL/IOC)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="FpmFastag" enumTypeId="FuelPaymentMode" description="FASTag" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== Trip Log ========== -->
    <entity entity-name="TripLog" package="zenith.erp.fleet" short-alias="TripLogs">
        <field name="tripId" type="id" is-pk="true"/>
        <field name="tripNumber" type="text-short"/>
        <field name="vehicleId" type="id"/>
        <field name="driverId" type="id"/>
        <field name="fromLocation" type="text-medium"/>
        <field name="toLocation" type="text-medium"/>
        <field name="startOdometerKm" type="number-decimal"/>
        <field name="endOdometerKm" type="number-decimal"/>
        <field name="distanceKm" type="number-decimal"/>
        <field name="purpose" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="plannedStartDate" type="date-time"/>
        <field name="actualStartDate" type="date-time"/>
        <field name="actualEndDate" type="date-time"/>
        <field name="tollAmount" type="currency-precise"/>
        <field name="otherExpenses" type="currency-precise"/>
        <field name="remarks" type="text-long"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <relationship type="one" related="zenith.erp.fleet.FleetDriver"/>
        <relationship type="one" title="Trip" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Trip" description="Fleet Trip"/>
            <moqui.basic.StatusItem statusId="TrPlanned" statusTypeId="Trip" description="Planned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="TrInProgress" statusTypeId="Trip" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="TrCompleted" statusTypeId="Trip" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="TrCancelled" statusTypeId="Trip" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TrPlanned" toStatusId="TrInProgress" transitionName="Start Trip"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TrPlanned" toStatusId="TrCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TrInProgress" toStatusId="TrCompleted" transitionName="Complete Trip"/>
        </seed-data>
    </entity>

    <!-- ========== Vehicle Expense ========== -->
    <entity entity-name="VehicleExpense" package="zenith.erp.fleet" short-alias="VehicleExpenses">
        <field name="expenseId" type="id" is-pk="true"/>
        <field name="vehicleId" type="id"/>
        <field name="expenseType" type="id"/>
        <field name="expenseDate" type="date"/>
        <field name="amount" type="currency-precise"/>
        <field name="description" type="text-medium"/>
        <field name="vendorName" type="text-medium"/>
        <field name="receiptNumber" type="text-short"/>
        <field name="paymentMode" type="text-short"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="VehicleExpenseType" description="Vehicle Expense Type"/>
            <moqui.basic.Enumeration enumId="VeFuel" enumTypeId="VehicleExpenseType" description="Fuel" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VeMaintenance" enumTypeId="VehicleExpenseType" description="Maintenance/Repair" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VeInsurance" enumTypeId="VehicleExpenseType" description="Insurance Premium" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VeRoadTax" enumTypeId="VehicleExpenseType" description="Road Tax" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="VeToll" enumTypeId="VehicleExpenseType" description="Toll (FASTag)" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="VeParking" enumTypeId="VehicleExpenseType" description="Parking" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="VeFine" enumTypeId="VehicleExpenseType" description="Challan/Fine" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="VeFitness" enumTypeId="VehicleExpenseType" description="Fitness Certificate" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="VePuc" enumTypeId="VehicleExpenseType" description="PUC Certificate" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="VePermit" enumTypeId="VehicleExpenseType" description="Permit Fees" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="VeTyre" enumTypeId="VehicleExpenseType" description="Tyre Replacement" sequenceNum="11"/>
            <moqui.basic.Enumeration enumId="VeWashing" enumTypeId="VehicleExpenseType" description="Washing/Cleaning" sequenceNum="12"/>
            <moqui.basic.Enumeration enumId="VeOther" enumTypeId="VehicleExpenseType" description="Other" sequenceNum="13"/>
        </seed-data>
    </entity>

    <!-- ========== Vehicle Service/Maintenance ========== -->
    <entity entity-name="VehicleService" package="zenith.erp.fleet" short-alias="VehicleServices">
        <field name="serviceId" type="id" is-pk="true"/>
        <field name="vehicleId" type="id"/>
        <field name="serviceType" type="text-short"/>
        <field name="serviceDate" type="date"/>
        <field name="nextServiceDate" type="date"/>
        <field name="nextServiceOdometerKm" type="number-decimal"/>
        <field name="odometerAtService" type="number-decimal"/>
        <field name="serviceProvider" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="laborCost" type="currency-precise"/>
        <field name="partsCost" type="currency-precise"/>
        <field name="totalCost" type="currency-precise"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <relationship type="one" title="VehicleService" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="VehicleService" description="Vehicle Service"/>
            <moqui.basic.StatusItem statusId="VsScheduled" statusTypeId="VehicleService" description="Scheduled" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="VsInProgress" statusTypeId="VehicleService" description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="VsCompleted" statusTypeId="VehicleService" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VsScheduled" toStatusId="VsInProgress" transitionName="Start Service"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VsInProgress" toStatusId="VsCompleted" transitionName="Complete"/>
        </seed-data>
    </entity>

    <!-- ========== Vehicle Document (RC, Insurance, Fitness, PUC, Permit) ========== -->
    <entity entity-name="VehicleDocument" package="zenith.erp.fleet" short-alias="VehicleDocuments">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="vehicleId" type="id"/>
        <field name="documentType" type="id"/>
        <field name="documentNumber" type="text-medium"/>
        <field name="issueDate" type="date"/>
        <field name="expiryDate" type="date"/>
        <field name="issuingAuthority" type="text-medium"/>
        <field name="remarks" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.fleet.Vehicle"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="VehicleDocType" description="Vehicle Document Type"/>
            <moqui.basic.Enumeration enumId="VdRc" enumTypeId="VehicleDocType" description="Registration Certificate (RC)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VdInsurance" enumTypeId="VehicleDocType" description="Insurance Policy" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VdFitness" enumTypeId="VehicleDocType" description="Fitness Certificate" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VdPuc" enumTypeId="VehicleDocType" description="PUC (Pollution Under Control)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="VdPermit" enumTypeId="VehicleDocType" description="Route/National Permit" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="VdRoadTax" enumTypeId="VehicleDocType" description="Road Tax Receipt" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="VdFastag" enumTypeId="VehicleDocType" description="FASTag KYC" sequenceNum="7"/>
        </seed-data>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="FuelLogView" package="zenith.erp.fleet">
        <member-entity entity-alias="FL" entity-name="zenith.erp.fleet.FuelLog"/>
        <member-entity entity-alias="VH" entity-name="zenith.erp.fleet.Vehicle" join-from-alias="FL" join-optional="true">
            <key-map field-name="vehicleId"/></member-entity>
        <member-entity entity-alias="DR" entity-name="zenith.erp.fleet.FleetDriver" join-from-alias="FL" join-optional="true">
            <key-map field-name="driverId"/></member-entity>
        <alias-all entity-alias="FL"/>
        <alias entity-alias="VH" name="registrationNumber"/>
        <alias entity-alias="VH" name="make"/>
        <alias entity-alias="VH" name="model"/>
        <alias entity-alias="DR" name="driverName"/>
    </view-entity>

    <view-entity entity-name="TripLogView" package="zenith.erp.fleet">
        <member-entity entity-alias="TR" entity-name="zenith.erp.fleet.TripLog"/>
        <member-entity entity-alias="VH" entity-name="zenith.erp.fleet.Vehicle" join-from-alias="TR" join-optional="true">
            <key-map field-name="vehicleId"/></member-entity>
        <member-entity entity-alias="DR" entity-name="zenith.erp.fleet.FleetDriver" join-from-alias="TR" join-optional="true">
            <key-map field-name="driverId"/></member-entity>
        <alias-all entity-alias="TR"/>
        <alias entity-alias="VH" name="registrationNumber"/>
        <alias entity-alias="DR" name="driverName"/>
    </view-entity>
</entities>
