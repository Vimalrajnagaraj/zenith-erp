<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="RevenueRecognitionSchedule" package="zenith.erp.accounting.revrec">
        <field name="revRecId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceItemSeqId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="recognizedAmount" type="currency-amount"/>
        <field name="deferredAmount" type="currency-amount"/>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="amortizationMonths" type="number-integer"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" related="moqui.basic.StatusItem"/>
    </entity>

    <entity entity-name="RevRecAmortizationEntry" package="zenith.erp.accounting.revrec">
        <field name="amortizationEntryId" type="id" is-pk="true"/>
        <field name="revRecId" type="id"/>
        <field name="acctgTransId" type="id"/>
        <field name="periodId" type="id"/>
        <field name="amortizationDate" type="date"/>
        <field name="amount" type="currency-amount"/>
        <field name="isProcessed" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.accounting.revrec.RevenueRecognitionSchedule"/>
        <relationship type="one" related="mantle.ledger.transaction.AcctgTrans"/>
    </entity>

</entities>
