<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Generic GL Account Extensions ========== -->
    <extend-entity entity-name="GlAccount" package="mantle.ledger.account">
        <field name="accountClassification" type="text-short"><description>Country-specific chart of accounts classification</description></field>
        <field name="accountSubClassification" type="text-short"/>
    </extend-entity>

    <!-- ========== Cheque Template (for cheque printing) ========== -->
    <entity entity-name="ChequeTemplate" package="zenith.erp.accounting" short-alias="ChequeTemplate">
        <field name="chequeTemplateId" type="id" is-pk="true"/>
        <field name="templateName" type="text-medium"/>
        <field name="bankName" type="text-medium"/>
        <field name="chequeWidth" type="number-decimal"/>
        <field name="chequeHeight" type="number-decimal"/>
        <field name="dateX" type="number-decimal"/><field name="dateY" type="number-decimal"/>
        <field name="payeeX" type="number-decimal"/><field name="payeeY" type="number-decimal"/>
        <field name="amountWordsX" type="number-decimal"/><field name="amountWordsY" type="number-decimal"/>
        <field name="amountFiguresX" type="number-decimal"/><field name="amountFiguresY" type="number-decimal"/>
        <field name="accountPayeeOnly" type="text-indicator" default="'Y'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== Post-Dated Cheque (PDC) Tracking ========== -->
    <entity entity-name="PostDatedCheque" package="zenith.erp.accounting" short-alias="PostDatedCheque">
        <field name="pdcId" type="id" is-pk="true"/>
        <field name="chequeNumber" type="text-short"/>
        <field name="bankName" type="text-medium"/>
        <field name="branchName" type="text-medium"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="chequeDate" type="date"/>
        <field name="receivedDate" type="date"/>
        <field name="partyId" type="id"/>
        <field name="directionEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="depositDate" type="date"/>
        <field name="clearanceDate" type="date"/>
        <field name="bounceDate" type="date"/>
        <field name="bounceReason" type="text-medium"/>
        <field name="reminderDate" type="date"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="mantle.party.Party" short-alias="party"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="PdcDirection" description="PDC Direction"/>
            <moqui.basic.Enumeration enumId="PdcReceived" enumTypeId="PdcDirection" description="Received from Customer" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="PdcIssued" enumTypeId="PdcDirection" description="Issued to Supplier" sequenceNum="2"/>

            <moqui.basic.StatusType statusTypeId="PostDatedCheque" description="PDC Status"/>
            <moqui.basic.StatusItem statusId="PdcOnHand" statusTypeId="PostDatedCheque" description="On Hand" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="PdcDeposited" statusTypeId="PostDatedCheque" description="Deposited" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="PdcCleared" statusTypeId="PostDatedCheque" description="Cleared" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="PdcBounced" statusTypeId="PostDatedCheque" description="Bounced" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="PdcCancelled" statusTypeId="PostDatedCheque" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PdcOnHand" toStatusId="PdcDeposited" transitionName="Deposit"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PdcDeposited" toStatusId="PdcCleared" transitionName="Cleared"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PdcDeposited" toStatusId="PdcBounced" transitionName="Bounced"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PdcOnHand" toStatusId="PdcCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PdcBounced" toStatusId="PdcDeposited" transitionName="Re-Deposit"/>
        </seed-data>
    </entity>

    <!-- ========== Voucher Audit Log ========== -->
    <entity entity-name="VoucherAuditLog" package="zenith.erp.accounting" short-alias="VoucherAuditLog">
        <field name="auditLogId" type="id" is-pk="true"/>
        <field name="voucherType" type="text-short"/>
        <field name="voucherId" type="id"/>
        <field name="actionEnumId" type="id"/>
        <field name="actionDate" type="date-time"/>
        <field name="actionByUserId" type="id"/>
        <field name="previousValue" type="text-very-long"/>
        <field name="newValue" type="text-very-long"/>
        <field name="ipAddress" type="text-short"/>
        <field name="notes" type="text-medium"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="VoucherAuditAction" description="Voucher Audit Action"/>
            <moqui.basic.Enumeration enumId="VaaCreated" enumTypeId="VoucherAuditAction" description="Created" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VaaModified" enumTypeId="VoucherAuditAction" description="Modified" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VaaCancelled" enumTypeId="VoucherAuditAction" description="Cancelled" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VaaDeleted" enumTypeId="VoucherAuditAction" description="Deleted" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="VaaApproved" enumTypeId="VoucherAuditAction" description="Approved" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="VaaPrinted" enumTypeId="VoucherAuditAction" description="Printed" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Supporting Document (attachments for vouchers/ledgers) ========== -->
    <entity entity-name="SupportingDocument" package="zenith.erp.accounting" short-alias="SupportingDocument">
        <field name="documentId" type="id" is-pk="true"/>
        <field name="referenceType" type="text-short"/>
        <field name="referenceId" type="id"/>
        <field name="documentName" type="text-medium"/>
        <field name="documentTypeEnumId" type="id"/>
        <field name="contentLocation" type="text-long"/>
        <field name="mimeType" type="text-short"/>
        <field name="fileSize" type="number-integer"/>
        <field name="uploadDate" type="date-time"/>
        <field name="uploadedByUserId" type="id"/>
        <field name="description" type="text-medium"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SupportDocType" description="Supporting Document Type"/>
            <moqui.basic.Enumeration enumId="SdtInvoiceCopy" enumTypeId="SupportDocType" description="Invoice Copy" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SdtReceiptCopy" enumTypeId="SupportDocType" description="Receipt" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SdtBankStatement" enumTypeId="SupportDocType" description="Bank Statement" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SdtChequeImage" enumTypeId="SupportDocType" description="Cheque Image" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="SdtContract" enumTypeId="SupportDocType" description="Contract" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="SdtOther" enumTypeId="SupportDocType" description="Other" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- ========== Budget ========== -->
    <entity entity-name="Budget" package="zenith.erp.accounting" table-name="ZENITH_BUDGET" short-alias="Budget">
        <field name="budgetId" type="id" is-pk="true"/>
        <field name="budgetName" type="text-medium"/>
        <field name="budgetTypeEnumId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="glAccountId" type="id"/>
        <field name="budgetYear" type="text-short"/>
        <field name="budgetMonth" type="text-short"/>
        <field name="budgetAmount" type="currency-amount"/>
        <field name="actualAmount" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.ledger.account.GlAccount" short-alias="glAccount"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="BudgetType" description="Budget Type"/>
            <moqui.basic.Enumeration enumId="BtDepartment" enumTypeId="BudgetType" description="Department" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="BtProject" enumTypeId="BudgetType" description="Project" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="BtCost" enumTypeId="BudgetType" description="Cost Center" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="BtCapex" enumTypeId="BudgetType" description="Capital Expenditure" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="BtOpex" enumTypeId="BudgetType" description="Operating Expenditure" sequenceNum="5"/>

            <moqui.basic.StatusType statusTypeId="Budget" description="Budget Status"/>
            <moqui.basic.StatusItem statusId="BudDraft" statusTypeId="Budget" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="BudApproved" statusTypeId="Budget" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="BudActive" statusTypeId="Budget" description="Active" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="BudClosed" statusTypeId="Budget" description="Closed" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BudDraft" toStatusId="BudApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BudApproved" toStatusId="BudActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BudActive" toStatusId="BudClosed" transitionName="Close"/>
        </seed-data>
    </entity>

    <!-- ========== Recurring Invoice Template ========== -->
    <entity entity-name="RecurringInvoice" package="zenith.erp.accounting" short-alias="RecurringInvoice">
        <field name="recurringInvoiceId" type="id" is-pk="true"/>
        <field name="invoiceTypeEnumId" type="id"/>
        <field name="fromPartyId" type="id"/>
        <field name="toPartyId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="currencyUomId" type="id"/>
        <field name="recurringFrequency" type="text-short"/>
        <field name="nextInvoiceDate" type="date"/>
        <field name="lastInvoiceDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="autoSend" type="text-indicator" default="'N'"/>
        <field name="invoiceCount" type="number-integer" default="0"/>
        <relationship type="one" title="From" related="mantle.party.Party">
            <key-map field-name="fromPartyId" related="partyId"/></relationship>
        <relationship type="one" title="To" related="mantle.party.Party">
            <key-map field-name="toPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="RecurringFrequency" description="Recurring Invoice Frequency"/>
            <moqui.basic.Enumeration enumId="RfWeekly" enumTypeId="RecurringFrequency" description="Weekly" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RfBiWeekly" enumTypeId="RecurringFrequency" description="Bi-Weekly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RfMonthly" enumTypeId="RecurringFrequency" description="Monthly" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RfQuarterly" enumTypeId="RecurringFrequency" description="Quarterly" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RfAnnually" enumTypeId="RecurringFrequency" description="Annually" sequenceNum="5"/>
        </seed-data>
    </entity>

    <entity entity-name="RecurringInvoiceItem" package="zenith.erp.accounting" short-alias="RecurringInvoiceItem">
        <field name="recurringInvoiceId" type="id" is-pk="true"/>
        <field name="recurringItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="quantity" type="number-decimal" default="1"/>
        <field name="unitAmount" type="currency-amount"/>
        <relationship type="one" related="zenith.erp.accounting.RecurringInvoice"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== Bank Reconciliation (generic) ========== -->
    <entity entity-name="BankReconciliation" package="zenith.erp.accounting" short-alias="BankReconciliation">
        <field name="reconciliationId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="bankAccountId" type="id"/>
        <field name="statementDate" type="date"/>
        <field name="statementBalance" type="currency-precise"/>
        <field name="reconciledBalance" type="currency-precise"/>
        <field name="unreconciledCount" type="number-integer"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <!-- ZE-SALES-014 f/u (Tier D): view over the framework audit log joined to the audited voucher, so the
         MCA Audit Log screen can org-isolate by the voucher's own org (indexed PK joins scale to 160k+ rows,
         unlike a per-org IN-list of every invoiceId). Optional joins: pkPrimaryValue matches the audited PK;
         the screen scopes per-changedEntityName so cross-type ID collisions never mis-attribute a row. -->
    <view-entity entity-name="McaAuditLogView" package="zenith.erp.accounting">
        <member-entity entity-alias="EAL" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="EAL" join-optional="true">
            <key-map field-name="pkPrimaryValue" related="invoiceId"/></member-entity>
        <member-entity entity-alias="PAY" entity-name="mantle.account.payment.Payment" join-from-alias="EAL" join-optional="true">
            <key-map field-name="pkPrimaryValue" related="paymentId"/></member-entity>
        <member-entity entity-alias="ATR" entity-name="mantle.ledger.transaction.AcctgTrans" join-from-alias="EAL" join-optional="true">
            <key-map field-name="pkPrimaryValue" related="acctgTransId"/></member-entity>
        <alias-all entity-alias="EAL"/>
        <alias entity-alias="INV" name="invOrg" field="fromPartyId"/>
        <alias entity-alias="PAY" name="payFromOrg" field="fromPartyId"/>
        <alias entity-alias="PAY" name="payToOrg" field="toPartyId"/>
        <alias entity-alias="ATR" name="atOrg" field="organizationPartyId"/>
    </view-entity>

</entities>
