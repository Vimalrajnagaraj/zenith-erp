<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Generic Withholding Tax Services ========== -->
    <!-- Country-specific withholding tax implementations (TDS for India, etc.) live in country plugins.
         This file provides a generic dispatcher if needed. -->

    <service verb="calculate" noun="WithholdingTax">
        <description>Generic withholding tax calculation. Dispatches to country-specific service
            via WITHHOLDING_TAX_SERVICE CompanySettings key.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="payeePartyId" required="true"/>
            <parameter name="grossAmount" type="BigDecimal" required="true"/>
            <parameter name="invoiceId"/>
            <parameter name="paymentId"/>
            <parameter name="transactionDate" type="Timestamp" default="ec.user.nowTimestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="withholdingAmount" type="BigDecimal"/>
            <parameter name="netAmount" type="BigDecimal"/>
            <parameter name="transactionId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="whtSetting">
                <field-map field-name="organizationPartyId"/>
                <field-map field-name="settingKey" value="WITHHOLDING_TAX_SERVICE"/>
            </entity-find-one>

            <if condition="whtSetting?.settingValue">
                <service-call name="${whtSetting.settingValue}"
                              in-map="context" out-map="context"/>
            <else>
                <set field="withholdingAmount" from="BigDecimal.ZERO"/>
                <set field="netAmount" from="grossAmount"/>
            </else></if>
        </actions>
    </service>

</services>
