<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Create Post-Dated Cheque -->
    <service verb="create" noun="PostDatedCheque">
        <in-parameters>
            <parameter name="chequeNumber" required="true"/>
            <parameter name="bankName" required="true"/>
            <parameter name="partyId" required="true"/>
            <parameter name="amount" type="BigDecimal" required="true"/>
            <parameter name="chequeDate" type="Date" required="true"/>
            <parameter name="directionEnumId" required="true"/>
            <parameter name="referenceId"/>
            <parameter name="currencyUomId"/>
            <parameter name="reminderDate" type="Date"/>
            <parameter name="notes"/>
        </in-parameters>
        <out-parameters><parameter name="postDatedChequeId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.accounting.PostDatedCheque"
                          in-map="context + [statusId:'PdcOnHand']" out-map="context"/>
        </actions>
    </service>

    <!-- Deposit PDC -->
    <service verb="deposit" noun="PostDatedCheque">
        <in-parameters><parameter name="postDatedChequeId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.accounting.PostDatedCheque" value-field="pdc" for-update="true"/>
            <set field="pdc.statusId" value="PdcDeposited"/>
            <set field="pdc.depositedDate" from="ec.user.nowTimestamp"/>
            <entity-update value-field="pdc"/>
        </actions>
    </service>

    <!-- Clear/Bounce PDC -->
    <service verb="update" noun="PostDatedChequeStatus">
        <in-parameters>
            <parameter name="postDatedChequeId" required="true"/>
            <parameter name="statusId" required="true"/>
            <parameter name="bounceReason"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.accounting.PostDatedCheque" value-field="pdc" for-update="true"/>
            <set field="pdc.statusId" from="statusId"/>
            <if condition="statusId == 'PdcCleared'">
                <set field="pdc.clearedDate" from="ec.user.nowTimestamp"/>
            </if>
            <if condition="bounceReason"><set field="pdc.bounceReason" from="bounceReason"/></if>
            <entity-update value-field="pdc"/>
        </actions>
    </service>

    <!-- Get PDC reminders (cheques due soon) -->
    <service verb="get" noun="PdcReminders">
        <in-parameters>
            <parameter name="daysAhead" type="Integer" default-value="7"/>
        </in-parameters>
        <out-parameters><parameter name="reminderList" type="List"/></out-parameters>
        <actions>
            <set field="futureDate" from="new java.sql.Date(System.currentTimeMillis() + (daysAhead * 86400000L))"/>
            <entity-find entity-name="zenith.erp.accounting.PostDatedCheque" list="reminderList">
                <econdition field-name="statusId" value="PdcOnHand"/>
                <econdition field-name="chequeDate" operator="less-equals" from="futureDate"/>
                <order-by field-name="chequeDate"/>
            </entity-find>
        </actions>
    </service>

    <!-- Log Voucher Audit -->
    <service verb="log" noun="VoucherAudit">
        <in-parameters>
            <parameter name="voucherType" required="true"/>
            <parameter name="voucherId" required="true"/>
            <parameter name="actionEnumId" required="true"/>
            <parameter name="previousValue"/>
            <parameter name="newValue"/>
        </in-parameters>
        <actions>
            <service-call name="create#zenith.erp.accounting.VoucherAuditLog"
                          in-map="context + [actionDate:ec.user.nowTimestamp,
                                             performedByPartyId:ec.user.userAccount?.partyId,
                                             ipAddress:ec.web?.request?.remoteAddr]"/>
        </actions>
    </service>

    <!-- Attach Supporting Document -->
    <service verb="attach" noun="SupportingDocument">
        <in-parameters>
            <parameter name="referenceType" required="true"/>
            <parameter name="referenceId" required="true"/>
            <parameter name="documentTypeEnumId" required="true"/>
            <parameter name="documentName" required="true"/>
            <parameter name="fileLocation" required="true"/>
            <parameter name="description"/>
        </in-parameters>
        <out-parameters><parameter name="supportingDocumentId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.accounting.SupportingDocument"
                          in-map="context + [uploadedDate:ec.user.nowTimestamp,
                                             uploadedByPartyId:ec.user.userAccount?.partyId]"
                          out-map="context"/>
        </actions>
    </service>

    <!-- Print Cheque (using template) -->
    <service verb="print" noun="Cheque">
        <in-parameters>
            <parameter name="chequeTemplateId" required="true"/>
            <parameter name="payeeName" required="true"/>
            <parameter name="amount" type="BigDecimal" required="true"/>
            <parameter name="chequeDate" type="Date" required="true"/>
            <parameter name="accountPayeeOnly" type="text-indicator" default-value="Y"/>
        </in-parameters>
        <out-parameters><parameter name="printData" type="Map"/></out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.accounting.ChequeTemplate" value-field="template"/>
            <set field="printData" from="[payeeName:payeeName, amount:amount, chequeDate:chequeDate,
                                          accountPayeeOnly:accountPayeeOnly,
                                          dateX:template.dateX, dateY:template.dateY,
                                          payeeX:template.payeeX, payeeY:template.payeeY,
                                          amountWordsX:template.amountWordsX, amountWordsY:template.amountWordsY,
                                          amountFiguresX:template.amountFiguresX, amountFiguresY:template.amountFiguresY]"/>
        </actions>
    </service>

</services>
