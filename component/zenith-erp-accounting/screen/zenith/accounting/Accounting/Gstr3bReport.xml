<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GSTR-3B">

    <transition name="generateGstr3b">
        <service-call name="zenith.india.Gstr2Services.generate#Gstr3bData" out-map="gstr3bResult"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="defaultPeriod" from="String.format('%02d%04d', mn, yr)"/>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="GSTR-3B Summary Return" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-single name="GenerateForm" transition="generateGstr3b">
                <field name="organizationPartyId"><default-field title="Organization">
                    <drop-down><entity-options key="${partyId}" text="${organizationName}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                            <!-- Org isolation: tenant sees only its own org in the picker (admin sees all). -->
                            <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="returnPeriod" from="defaultPeriod"><default-field title="Period (MMYYYY)">
                    <text-line size="8"/>
                </default-field></field>
                <field name="submitBtn"><default-field title="Generate GSTR-3B"><submit type="success"/></default-field></field>
            </form-single>
        </container>

        <section name="ResultSection" condition="gstr3bResult">
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Table 3.1 — Outward Supplies (Output Tax)" type="h5" style="text-weight-bold q-mb-md"/>
                    <container style="row">
                        <label text="IGST: ${ec.l10n.format(gstr3bResult.table31?.igst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CGST: ${ec.l10n.format(gstr3bResult.table31?.cgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="SGST: ${ec.l10n.format(gstr3bResult.table31?.sgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CESS: ${ec.l10n.format(gstr3bResult.table31?.cess ?: 0, '#,##0.00')}" style="text-weight-medium"/>
                    </container>
                </container>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Table 4 — Eligible ITC (Input Tax)" type="h5" style="text-weight-bold q-mb-md"/>
                    <container style="row">
                        <label text="IGST: ${ec.l10n.format(gstr3bResult.table4?.igst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CGST: ${ec.l10n.format(gstr3bResult.table4?.cgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="SGST: ${ec.l10n.format(gstr3bResult.table4?.sgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CESS: ${ec.l10n.format(gstr3bResult.table4?.cess ?: 0, '#,##0.00')}" style="text-weight-medium"/>
                    </container>
                </container>

                <container style="zenith-card bg-primary shadow-2 border-radius-lg q-pa-lg text-white">
                    <label text="Net Tax Payable" type="h5" style="text-weight-bold q-mb-md"/>
                    <container style="row">
                        <label text="IGST: ${ec.l10n.format(gstr3bResult.netTaxPayable?.igst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CGST: ${ec.l10n.format(gstr3bResult.netTaxPayable?.cgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="SGST: ${ec.l10n.format(gstr3bResult.netTaxPayable?.sgst ?: 0, '#,##0.00')}" style="q-mr-lg text-weight-medium"/>
                        <label text="CESS: ${ec.l10n.format(gstr3bResult.netTaxPayable?.cess ?: 0, '#,##0.00')}" style="text-weight-medium"/>
                    </container>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
