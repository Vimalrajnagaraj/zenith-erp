<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bank Feeds &amp; Auto BRS" default-menu-index="8">

    <transition name="importBankFeed">
        <service-call name="zenith.erp.india.BankReconciliationServices.import#BankFeed" in-map="[finAccountId:finAccountId, feedFormat:feedFormat, feedFile:feedFile]"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="mantle.account.financial.FinancialAccount" list="finAccountList">
            <econdition field-name="finAccountTypeId" value="BankAccount"/>
        </entity-find>
        
        <entity-find entity-name="mantle.ledger.reconciliation.GlReconciliation" list="reconciliationList">
            <search-form-inputs default-order-by="-reconciledDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box><box-header title="Import Bank Feeds (MT940 / CSV)"/>
                <box-toolbar>
                    <link url="." text="Connect via Plaid" icon="glyphicon glyphicon-link" class="btn btn-info" tooltip="Automatically sync live bank feeds using Plaid Integration"/>
                </box-toolbar>
                <box-body>
                    <label text="Connects to corporate banking APIs (ICICI, HDFC, SBI) or accepts manual MT940 uploads to auto-match payments and receipts against GL entries." type="p" style="text-primary text-weight-bold q-mb-md"/>
                    
                    <form-single name="ImportBankFeedForm" transition="importBankFeed">
                        <field name="finAccountId"><default-field title="Bank Account">
                            <drop-down>
                                <list-options list="finAccountList" key="${finAccountId}" text="${finAccountName} [${finAccountCode}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="feedFormat"><default-field title="Format">
                            <drop-down>
                                <option key="MT940" text="MT940 (Standard)"/>
                                <option key="CSV" text="Bank CSV"/>
                                <option key="API" text="Live API Fetch"/>
                            </drop-down>
                        </default-field></field>
                        <field name="feedFile"><default-field title="Upload File"><file/></default-field></field>
                        <field name="submitButton"><default-field title="Import &amp; Auto-Reconcile"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="Direct Payouts (NEFT/RTGS)"/><box-body>
                    <label text="Select vendor invoices and initiate NEFT/RTGS transfers directly from the ERP without logging into the corporate banking portal." type="p"/>
                    <link url="../Payments" text="Go to Payment Run Dashboard" icon="account_balance_wallet" class="q-btn q-btn--standard bg-primary text-white q-mt-sm"/>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-box><box-header title="Bank Reconciliation Statements (BRS)"/><box-body>
            <form-list name="BrsListForm" list="reconciliationList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="glReconciliationId"><header-field title="BRS ID"/><default-field><display/></default-field></field>
                <field name="glAccountId"><header-field title="GL Account"/><default-field><display/></default-field></field>
                <field name="reconciledDate"><header-field title="Date"/><default-field><display/></default-field></field>
                <field name="openingBalance"><header-field title="Opening Balance"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                <field name="reconciledBalance"><header-field title="Reconciled Balance"/><default-field><display currency-unit-field="currencyUomId"/></default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </box-body></container-box>
    </widgets>
</screen>
