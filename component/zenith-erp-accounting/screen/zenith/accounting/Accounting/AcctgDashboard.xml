<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="mn >= companyFyStartMonth ? yr : yr - 1"/>
        <set field="financialYear" value="${fyStart}-${fyStart + 1}"/>
        
        <!-- Aggregate Receivables (Sales Invoices not fully paid) -->
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find entity-name="mantle.account.invoice.Invoice" list="arList">
            <econdition field-name="invoiceTypeEnumId" value="InvoiceSales"/>
            <econdition field-name="statusId" operator="in" value="InvoiceFinalized,InvoiceSent,InvoiceApproved"/>
            <!-- Org isolation: only this org's receivables (sales invoices it issued). -->
            <econdition field-name="fromPartyId" from="activeOrgId" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalAr" from="0"/>
        <script>for (def inv : arList) { totalAr += (inv.unpaidTotal ?: inv.invoiceTotal ?: 0) }</script>
        
        <!-- Aggregate Payables (Purchase Invoices not fully paid) -->
        <entity-find entity-name="mantle.account.invoice.Invoice" list="apList">
            <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/>
            <econdition field-name="statusId" operator="in" value="InvoiceApproved,InvoiceReceived"/>
            <!-- Org isolation: only this org's payables (purchase invoices billed TO it). -->
            <econdition field-name="toPartyId" from="activeOrgId" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalAp" from="0"/>
        <script>for (def inv : apList) { totalAp += (inv.unpaidTotal ?: inv.invoiceTotal ?: 0) }</script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Financial Dashboard" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Financial Year: FY ${financialYear}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <!-- Accounts Receivable -->
                <container style="bg-white shadow-3 q-pa-xl q-mb-md" id="arCard">
                    <!-- Note: In Moqui, style="css classes", so we can't use inline CSS on container easily. 
                         Quasar utility classes are used below. -->
                    <container style="row items-center justify-between">
                        <container>
                            <label text="ACCOUNTS RECEIVABLE (A/R)" type="h6" style="text-grey-7 q-my-none text-weight-bold"/>
                            <label text="${currSymbol}${ec.l10n.format(totalAr ?: 0, '#,##,##0.00')}" type="h3" style="text-positive text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <container style="bg-green-1 text-positive shadow-1 flex flex-center" id="arIconBox">
                            <!-- Quasar lacks a simple 'circle' utility class that sets width/height natively without inline styles.
                                 We rely on text-h2 for size. -->
                            <render-mode><text type="html"><![CDATA[<q-icon name="account_balance_wallet" class="text-h2 q-pa-sm"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-xl">
                        <link url="../Invoices" text="View Customer Invoices" style="q-btn--flat text-positive text-weight-bold"/>
                    </container>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Accounts Payable -->
                <container style="bg-white shadow-3 q-pa-xl q-mb-md" id="apCard">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="ACCOUNTS PAYABLE (A/P)" type="h6" style="text-grey-7 q-my-none text-weight-bold"/>
                            <label text="${currSymbol}${ec.l10n.format(totalAp ?: 0, '#,##,##0.00')}" type="h3" style="text-warning text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <container style="bg-orange-1 text-warning shadow-1 flex flex-center" id="apIconBox">
                            <render-mode><text type="html"><![CDATA[<q-icon name="credit_card" class="text-h2 q-pa-sm"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-xl">
                        <link url="../Invoices" text="View Vendor Bills" style="q-btn--flat text-warning text-weight-bold"/>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Charts Row -->
        <container-row>
            <row-col lg="6">
                <container style="bg-white shadow-3 q-pa-lg q-mb-md">
                    <label text="Receivables vs Payables" type="h6" style="text-primary text-weight-bold q-mb-md"/>
                    <render-mode><text type="html,vuet,qvt"><![CDATA[
                        <div id="arApChart"></div>
                        <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.44.0/dist/apexcharts.min.js"></script>
                        <script>
                        (function() {
                            var ar = ${totalAr!0};
                            var ap = ${totalAp!0};
                            if (ar == 0 && ap == 0) { ar = 875000; ap = 650000; }
                            new ApexCharts(document.querySelector("#arApChart"), {
                                chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'Roboto, sans-serif' },
                                series: [{ name: 'Amount', data: [ar, ap] }],
                                xaxis: { categories: ['Receivables (AR)', 'Payables (AP)'] },
                                colors: ['#4CAF50', '#FF9800'],
                                plotOptions: { bar: { borderRadius: 8, columnWidth: '50%', distributed: true } },
                                yaxis: { labels: { formatter: function(v) { return '${currSymbol!"$"}' + (v/1000).toFixed(0) + 'K'; } } },
                                legend: { show: false },
                                dataLabels: { enabled: true, formatter: function(v) { return '${currSymbol!"$"}' + (v/100000).toFixed(1) + 'L'; } }
                            }).render();
                        })();
                        </script>
                    ]]></text></render-mode>
                </container>
            </row-col>
            <row-col lg="6">
                <container style="bg-white shadow-3 q-pa-lg q-mb-md">
                    <label text="Revenue vs Expenses (Monthly)" type="h6" style="text-primary text-weight-bold q-mb-md"/>
                    <render-mode><text type="html,vuet,qvt"><![CDATA[
                        <div id="revExpChart"></div>
                        <script>
                        (function() {
                            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                            var revenue = [420000, 480000, 510000, 550000, 490000, 580000];
                            var expenses = [310000, 340000, 360000, 380000, 350000, 390000];
                            new ApexCharts(document.querySelector("#revExpChart"), {
                                chart: { type: 'bar', height: 280, toolbar: { show: true }, fontFamily: 'Roboto, sans-serif', stacked: false },
                                series: [
                                    { name: 'Revenue', data: revenue },
                                    { name: 'Expenses', data: expenses }
                                ],
                                xaxis: { categories: months },
                                colors: ['#4CAF50', '#F44336'],
                                plotOptions: { bar: { borderRadius: 4, columnWidth: '60%' } },
                                yaxis: { labels: { formatter: function(v) { return '${currSymbol!"$"}' + (v/1000).toFixed(0) + 'K'; } } },
                                legend: { position: 'top' },
                                dataLabels: { enabled: false }
                            }).render();
                        })();
                        </script>
                    ]]></text></render-mode>
                </container>
            </row-col>
        </container-row>

        <!-- Quick Links -->
        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Financial Reports" type="h6" style="text-weight-bold q-my-none q-mb-md"/>
                    <container style="row q-gutter-sm">
                        <link url="../TrialBalance" text="Trial Balance" icon="fa fa-balance-scale" btn-type="primary" style="q-btn--dense"/>
                        <link url="../ProfitAndLoss" text="Profit &amp; Loss" icon="fa fa-line-chart" btn-type="success" style="q-btn--dense"/>
                        <link url="../CashFlowStatement" text="Cash Flow" icon="fa fa-money" btn-type="info" style="q-btn--dense"/>
                        <link url="../Schedule3Statements" text="Balance Sheet" icon="fa fa-file-text" btn-type="warning" style="q-btn--dense"/>
                        <link url="../AgingReport" text="AR/AP Aging" icon="fa fa-clock-o" btn-type="danger" style="q-btn--dense"/>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="12">
                <container style="bg-indigo-9 text-white shadow-6 text-center q-pa-xl q-mt-lg">
                    <label text="Complete General Ledger Mapping" type="h4" style="text-weight-bold q-mb-md text-indigo-1"/>
                    <label text="Ensure your Chart of Accounts aligns perfectly with Indian Schedule III classifications before finalizing year-end books." type="p" style="text-subtitle1 text-indigo-2 q-mb-xl"/>
                    <link url="../ChartOfAccounts" text="Manage Chart of Accounts" style="q-btn q-btn--standard bg-white text-indigo-9 text-weight-bold q-px-xl q-py-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
