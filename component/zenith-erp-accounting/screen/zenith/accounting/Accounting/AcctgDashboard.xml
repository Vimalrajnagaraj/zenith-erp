<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <parameter name="dashDate"/>
    <parameter name="dashDateTo"/>
    <parameter name="showSettings"/>

    <transition name="saveDashLayout">
        <actions><script><![CDATA[
            def _wk = ['kpis','arap','revexp']
            ec.user.setPreference('ACCT_DASH_HIDDEN', _wk.findAll { !context.get('w_' + it) }.join(','))
        ]]></script></actions>
        <default-response url="." parameter-map="[dashDate:dashDate, dashDateTo:dashDateTo]"/>
    </transition>
    <transition name="resetDashLayout">
        <actions><script>ec.user.setPreference('ACCT_DASH_HIDDEN', null); ec.user.setPreference('ACCT_DASH_ORDER', null)</script></actions>
        <default-response url="." parameter-map="[dashDate:dashDate, dashDateTo:dashDateTo]"/>
    </transition>
    <transition name="saveDashOrder" require-session-token="false">
        <actions><script><![CDATA[
            def _valid = ['kpis','arap','revexp']
            def _clean = ((context.order ?: '').toString().split(',') as List).findAll { _valid.contains(it) }
            ec.user.setPreference('ACCT_DASH_ORDER', _clean.join(','))
            ec.web.sendJsonResponse([saved:true, order:_clean.join(',')])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="changeDashDate"><default-response url="." parameter-map="[dashDate:dashDate, dashDateTo:dashDateTo]"/></transition>

    <actions>
        <!-- ZE-DASH date-range filter. DEFAULT = all-time (empty) so A/R and A/P stay at current totals on load;
             a selected range scopes them to invoices dated in that period. -->
        <script><![CDATA[
            def sdf = new java.text.SimpleDateFormat("yyyy-MM-dd")
            def now = ec.user.nowTimestamp
            def todayStr = sdf.format(now)
            if (!dashDate) dashDate = ''
            if (!dashDateTo) dashDateTo = ''
            dayStart = null; dayEndExcl = null
            if (dashDate) {
                if (!dashDateTo) dashDateTo = dashDate
                if (dashDateTo < dashDate) { def _s = dashDate; dashDate = dashDateTo; dashDateTo = _s }
                dayStart = java.sql.Timestamp.valueOf(dashDate + " 00:00:00")
                def _ce = java.util.Calendar.getInstance(); _ce.setTime(java.sql.Timestamp.valueOf(dashDateTo + " 00:00:00")); _ce.add(java.util.Calendar.DAY_OF_MONTH, 1)
                dayEndExcl = new java.sql.Timestamp(_ce.getTimeInMillis())
            }
            def _cw = java.util.Calendar.getInstance(); _cw.setTime(now); _cw.set(java.util.Calendar.DAY_OF_WEEK, _cw.getFirstDayOfWeek()); def weekStartStr = sdf.format(_cw.getTime())
            def _cm = java.util.Calendar.getInstance(); _cm.setTime(now); _cm.set(java.util.Calendar.DAY_OF_MONTH,1); def monthStartStr = sdf.format(_cm.getTime())
            def _c30 = java.util.Calendar.getInstance(); _c30.setTime(now); _c30.add(java.util.Calendar.DAY_OF_MONTH,-29); def last30Str = sdf.format(_c30.getTime())
            urlAll = "?"; urlToday = "?dashDate="+todayStr+"&dashDateTo="+todayStr
            urlWeek = "?dashDate="+weekStartStr+"&dashDateTo="+todayStr
            urlMonth = "?dashDate="+monthStartStr+"&dashDateTo="+todayStr
            url30 = "?dashDate="+last30Str+"&dashDateTo="+todayStr
            presetActive = 'all'
            if (dashDate) {
                presetActive = 'custom'
                if (dashDateTo == todayStr) {
                    if (dashDate == todayStr) presetActive='today'
                    else if (dashDate == weekStartStr) presetActive='week'
                    else if (dashDate == monthStartStr) presetActive='month'
                    else if (dashDate == last30Str) presetActive='last30'
                }
            }
        ]]></script>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="mn >= companyFyStartMonth ? yr : yr - 1"/>
        <set field="financialYear" value="${fyStart}-${fyStart + 1}"/>
        
        <!-- Aggregate Receivables (Sales Invoices not fully paid) -->
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find entity-name="mantle.account.invoice.Invoice" list="arList">
            <econdition field-name="invoiceTypeEnumId" value="InvoiceSales"/>
            <econdition field-name="statusId" operator="in" value="InvoiceFinalized,InvoiceSent,InvoiceApproved"/>
            <!-- Org isolation: only this org's receivables (sales invoices it issued). -->
            <econdition field-name="fromPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <econdition field-name="invoiceDate" operator="greater-equals" from="dayStart" ignore-if-empty="true"/>
            <econdition field-name="invoiceDate" operator="less" from="dayEndExcl" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalAr" from="0"/>
        <script>for (def inv : arList) { totalAr += (inv.unpaidTotal ?: inv.invoiceTotal ?: 0) }</script>
        
        <!-- Aggregate Payables (Purchase Invoices not fully paid) -->
        <entity-find entity-name="mantle.account.invoice.Invoice" list="apList">
            <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/>
            <econdition field-name="statusId" operator="in" value="InvoiceApproved,InvoiceReceived"/>
            <!-- Org isolation: only this org's payables (purchase invoices billed TO it). -->
            <econdition field-name="toPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <econdition field-name="invoiceDate" operator="greater-equals" from="dayStart" ignore-if-empty="true"/>
            <econdition field-name="invoiceDate" operator="less" from="dayEndExcl" ignore-if-empty="true"/>
        </entity-find>
        <set field="totalAp" from="0"/>
        <script>for (def inv : apList) { totalAp += (inv.unpaidTotal ?: inv.invoiceTotal ?: 0) }</script>

        <!-- ZE-DASH layout: switchable widgets (+ cashier role default) + saved drag order -->
        <script><![CDATA[
            def _roleHidden = ''
            try {
                if (!ec.user.isInGroup("ADMIN")) {
                    def _zrp = (ec.user.userGroupIdSet ?: []).findAll { it?.startsWith("ZENITH_") && it != "ZENITH_ALL" }
                    if (_zrp.size() == 1 && _zrp.contains("ZENITH_CASHIER")) _roleHidden = 'arap,revexp'
                }
            } catch (Exception e) {}
            def _pref = ec.user.getPreference('ACCT_DASH_HIDDEN')
            def _hiddenSet = ((_pref != null) ? _pref : _roleHidden).split(',').findAll { it }.toSet()
            showKpis = !_hiddenSet.contains('kpis'); showArap = !_hiddenSet.contains('arap'); showRevexp = !_hiddenSet.contains('revexp')
            w_kpis = showKpis ? 'Y' : ''; w_arap = showArap ? 'Y' : ''; w_revexp = showRevexp ? 'Y' : ''
            dashOrderCsv = (ec.user.getPreference('ACCT_DASH_ORDER') ?: '')
            urlSettings = dashDate ? ("?dashDate="+dashDate+"&dashDateTo="+dashDateTo+"&showSettings=1") : "?showSettings=1"
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Financial Dashboard" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Financial Year: FY ${financialYear}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <!-- ZE-DASH: date-range filter + customize gear -->
        <container style="q-px-lg q-py-md q-mb-md zenith-card bg-white shadow-1 border-radius-lg">
            <render-mode><text type="html" template="true"><![CDATA[<div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-family:Segoe UI,Arial,sans-serif;margin-bottom:10px"><span style="font-size:11.5px;font-weight:800;color:#5C6B85;letter-spacing:.06em;margin-right:4px">DATE RANGE</span><a href="${urlAll}" class="zdash-chip${(presetActive=='all')?string(' on','')}">All time</a><a href="${urlToday}" class="zdash-chip${(presetActive=='today')?string(' on','')}">Today</a><a href="${urlWeek}" class="zdash-chip${(presetActive=='week')?string(' on','')}">This Week</a><a href="${urlMonth}" class="zdash-chip${(presetActive=='month')?string(' on','')}">This Month</a><a href="${url30}" class="zdash-chip${(presetActive=='last30')?string(' on','')}">Last 30 Days</a><a href="${urlSettings}" class="zdash-chip" style="margin-left:auto">&#9881; Customize</a></div>]]></text></render-mode>
            <form-single name="DateForm" transition="changeDashDate">
                <field name="dashDate"><default-field title="From"><date-time type="date" default-value="${dashDate}"/></default-field></field>
                <field name="dashDateTo"><default-field title="To"><date-time type="date" default-value="${dashDateTo}"/></default-field></field>
                <field name="goBtn"><default-field title=""><submit text="Apply" icon="fa fa-check"/></default-field></field>
            </form-single>
        </container>
        <section name="DashSettings" condition="showSettings == '1'">
            <widgets>
                <container style="q-px-lg q-py-md q-mb-md zenith-card bg-white shadow-1 border-radius-lg">
                    <render-mode><text type="html"><![CDATA[<div style="font-size:12.5px;font-weight:800;color:#0A2A7A;letter-spacing:.04em;margin-bottom:2px">&#9881; CUSTOMIZE DASHBOARD</div><div style="font-size:12px;color:#5C6B85;margin-bottom:8px">Tick the sections you want to see &mdash; saved to your account. Drag the handle on any card to reorder.</div>]]></text></render-mode>
                    <form-single name="DashLayoutForm" transition="saveDashLayout">
                        <field name="dashDate"><default-field><hidden/></default-field></field>
                        <field name="dashDateTo"><default-field><hidden/></default-field></field>
                        <field name="w_kpis"><default-field title="A/R and A/P summary"><check><option key="Y" text=" "/></check></default-field></field>
                        <field name="w_arap"><default-field title="Receivables vs Payables chart"><check><option key="Y" text=" "/></check></default-field></field>
                        <field name="w_revexp"><default-field title="Revenue vs Expenses chart"><check><option key="Y" text=" "/></check></default-field></field>
                        <field name="saveBtn"><default-field title=""><submit text="Save Layout" icon="fa fa-check"/></default-field></field>
                    </form-single>
                    <container style="row q-gutter-sm q-mt-sm">
                        <link url="resetDashLayout" text="Reset to Default" icon="fa fa-undo" btn-type="warning" parameter-map="[dashDate:dashDate, dashDateTo:dashDateTo]"/>
                        <link url="." text="Close" btn-type="flat" parameter-map="[dashDate:dashDate, dashDateTo:dashDateTo]"/>
                    </container>
                </container>
            </widgets>
        </section>

        <section name="wKpis" condition="showKpis"><widgets>
        <render-mode><text type="html"><![CDATA[<div class="dash-widget" data-wkey="kpis"><div class="dash-handle" title="Drag to reorder">&#8942;&#8942;</div>]]></text></render-mode>
        <container-row>
            <row-col lg="6">
                <!-- Accounts Receivable -->
                <container style="bg-white shadow-3 q-pa-xl q-mb-md" id="arCard">
                    <!-- Note: In Moqui, style="css classes", so we can't use inline CSS on container easily. 
                         Quasar utility classes are used below. -->
                    <container style="row items-center justify-between">
                        <container>
                            <label text="ACCOUNTS RECEIVABLE (A/R)" type="h6" style="text-grey-7 q-my-none text-weight-bold"/>
                            <label text="${currSymbol}${ec.l10n.format(totalAr ?: 0, '#,##,##0.00')}" type="h3" style="text-positive text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <container style="bg-green-1 text-positive shadow-1 flex flex-center" id="arIconBox">
                            <!-- Quasar lacks a simple 'circle' utility class that sets width/height natively without inline styles.
                                 We rely on text-h2 for size. -->
                            <render-mode><text type="html"><![CDATA[<q-icon name="account_balance_wallet" class="text-h2 q-pa-sm"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-xl">
                        <link url="../Invoices" text="View Customer Invoices" style="q-btn--flat text-positive text-weight-bold"/>
                    </container>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Accounts Payable -->
                <container style="bg-white shadow-3 q-pa-xl q-mb-md" id="apCard">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="ACCOUNTS PAYABLE (A/P)" type="h6" style="text-grey-7 q-my-none text-weight-bold"/>
                            <label text="${currSymbol}${ec.l10n.format(totalAp ?: 0, '#,##,##0.00')}" type="h3" style="text-warning text-weight-bolder q-my-none q-mt-sm"/>
                        </container>
                        <container style="bg-orange-1 text-warning shadow-1 flex flex-center" id="apIconBox">
                            <render-mode><text type="html"><![CDATA[<q-icon name="credit_card" class="text-h2 q-pa-sm"/>]]></text></render-mode>
                        </container>
                    </container>
                    <container style="q-mt-xl">
                        <link url="../Invoices" text="View Vendor Bills" style="q-btn--flat text-warning text-weight-bold"/>
                    </container>
                </container>
            </row-col>
        </container-row>
        <render-mode><text type="html"><![CDATA[</div>]]></text></render-mode>
        </widgets></section>

        <!-- Charts Row -->
        <container-row>
            <row-col lg="6">
                <section name="wArap" condition="showArap"><widgets>
                <render-mode><text type="html"><![CDATA[<div class="dash-widget" data-wkey="arap"><div class="dash-handle" title="Drag to reorder">&#8942;&#8942;</div>]]></text></render-mode>
                <container style="bg-white shadow-3 q-pa-lg q-mb-md">
                    <label text="Receivables vs Payables" type="h6" style="text-primary text-weight-bold q-mb-md"/>
                    <render-mode><text type="html,vuet,qvt"><![CDATA[
                        <div id="arApChart"></div>
                        <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.44.0/dist/apexcharts.min.js"></script>
                        <script>
                        (function() {
                            var ar = ${(totalAr!0)?c};
                            var ap = ${(totalAp!0)?c};
                            if (ar == 0 && ap == 0) { ar = 875000; ap = 650000; }
                            new ApexCharts(document.querySelector("#arApChart"), {
                                chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'Roboto, sans-serif' },
                                series: [{ name: 'Amount', data: [ar, ap] }],
                                xaxis: { categories: ['Receivables (AR)', 'Payables (AP)'] },
                                colors: ['#4CAF50', '#FF9800'],
                                plotOptions: { bar: { borderRadius: 8, columnWidth: '50%', distributed: true } },
                                yaxis: { labels: { formatter: function(v) { return '${currSymbol!"$"}' + (v/1000).toFixed(0) + 'K'; } } },
                                legend: { show: false },
                                dataLabels: { enabled: true, formatter: function(v) { return '${currSymbol!"$"}' + (v/100000).toFixed(1) + 'L'; } }
                            }).render();
                        })();
                        </script>
                    ]]></text></render-mode>
                </container>
                <render-mode><text type="html"><![CDATA[</div>]]></text></render-mode>
                </widgets></section>
            </row-col>
            <row-col lg="6">
                <section name="wRevexp" condition="showRevexp"><widgets>
                <render-mode><text type="html"><![CDATA[<div class="dash-widget" data-wkey="revexp"><div class="dash-handle" title="Drag to reorder">&#8942;&#8942;</div>]]></text></render-mode>
                <container style="bg-white shadow-3 q-pa-lg q-mb-md">
                    <label text="Revenue vs Expenses (Monthly)" type="h6" style="text-primary text-weight-bold q-mb-md"/>
                    <render-mode><text type="html,vuet,qvt"><![CDATA[
                        <div id="revExpChart"></div>
                        <script>
                        (function() {
                            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                            var revenue = [420000, 480000, 510000, 550000, 490000, 580000];
                            var expenses = [310000, 340000, 360000, 380000, 350000, 390000];
                            new ApexCharts(document.querySelector("#revExpChart"), {
                                chart: { type: 'bar', height: 280, toolbar: { show: true }, fontFamily: 'Roboto, sans-serif', stacked: false },
                                series: [
                                    { name: 'Revenue', data: revenue },
                                    { name: 'Expenses', data: expenses }
                                ],
                                xaxis: { categories: months },
                                colors: ['#4CAF50', '#F44336'],
                                plotOptions: { bar: { borderRadius: 4, columnWidth: '60%' } },
                                yaxis: { labels: { formatter: function(v) { return '${currSymbol!"$"}' + (v/1000).toFixed(0) + 'K'; } } },
                                legend: { position: 'top' },
                                dataLabels: { enabled: false }
                            }).render();
                        })();
                        </script>
                    ]]></text></render-mode>
                </container>
                <render-mode><text type="html"><![CDATA[</div>]]></text></render-mode>
                </widgets></section>
            </row-col>
        </container-row>

        <render-mode><text type="html"><![CDATA[<div id="dashExtras">]]></text></render-mode>
        <!-- Quick Links -->
        <container-row>
            <row-col lg="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Financial Reports" type="h6" style="text-weight-bold q-my-none q-mb-md"/>
                    <container style="row q-gutter-sm">
                        <link url="../TrialBalance" text="Trial Balance" icon="fa fa-balance-scale" btn-type="primary" style="q-btn--dense"/>
                        <link url="../ProfitAndLoss" text="Profit &amp; Loss" icon="fa fa-line-chart" btn-type="success" style="q-btn--dense"/>
                        <link url="../CashFlowStatement" text="Cash Flow" icon="fa fa-money" btn-type="info" style="q-btn--dense"/>
                        <link url="../Schedule3Statements" text="Balance Sheet" icon="fa fa-file-text" btn-type="warning" style="q-btn--dense"/>
                        <link url="../AgingReport" text="AR/AP Aging" icon="fa fa-clock-o" btn-type="danger" style="q-btn--dense"/>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container-row>
            <row-col lg="12">
                <container style="bg-indigo-9 text-white shadow-6 text-center q-pa-xl q-mt-lg">
                    <label text="Complete General Ledger Mapping" type="h4" style="text-weight-bold q-mb-md text-indigo-1"/>
                    <label text="Ensure your Chart of Accounts aligns perfectly with Indian Schedule III classifications before finalizing year-end books." type="p" style="text-subtitle1 text-indigo-2 q-mb-xl"/>
                    <link url="../ChartOfAccounts" text="Manage Chart of Accounts" style="q-btn q-btn--standard bg-white text-indigo-9 text-weight-bold q-px-xl q-py-sm"/>
                </container>
            </row-col>
        </container-row>
        <render-mode><text type="html"><![CDATA[</div>]]></text></render-mode>

        <render-mode><text type="html" template="true"><![CDATA[<script>window.__dashLayout={saveUrl:(("${ec.web.request.requestURI}").replace(/\/+$/,''))+'/saveDashOrder',order:"${dashOrderCsv}"};</script><script src="/zenithstatic/js/dash-layout.js?v=2"></script>]]></text></render-mode>
    </widgets>
</screen>
