<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Consolidation Dashboard" default-menu-index="90">

    <transition name="runConsolidation">
        <service-call name="zenith.accounting.ConsolidationServices.run#GlobalConsolidation" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <!-- ZE-INV-IV-070 f/u: a tenant has exactly one org; auto-fill it (the /qapps Vue m-drop-down renders the
             get#ActiveOrgList list-options EMPTY, blocking the form). Super-admins (no active org) keep the picker. -->
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="parentOrgId" from="_ao"/></if>
        <entity-find entity-name="mantle.party.time.TimePeriod" list="periodList">
            <econdition field-name="timePeriodTypeId" value="FiscalMonth"/>
            <order-by field-name="-fromDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <section name="RunConsolidation_write">
                    <condition><expression>modCanWrite</expression></condition>
                    <widgets>
                        <container-box><box-header title="Run Global Consolidation"/>
                            <box-body>
                                <label text="Enterprise FP&amp;A: Convert localized subsidiary ledgers to the Parent Org's base currency and eliminate inter-company transactions automatically." type="p" style="text-primary text-weight-bold q-mb-md"/>
                                <form-single name="RunConsolidationForm" transition="runConsolidation">
                                    <field name="parentOrgId">
                                        <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                                        <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                                        <default-field title="Parent Organization">
                                        <drop-down>
                                            <list-options list="orgList" key="${partyId}" text="${organizationName} [${pseudoId}]"/>
                                        </drop-down>
                                    </default-field></field>
                                    <field name="periodId"><default-field title="Fiscal Period">
                                        <drop-down>
                                            <list-options list="periodList" key="${timePeriodId}" text="${periodName} (${fromDate} to ${thruDate})"/>
                                        </drop-down>
                                    </default-field></field>
                                    <field name="submitButton"><default-field title="Execute Consolidation"><submit/></default-field></field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="Recent Consolidations"/>
                    <box-body>
                        <label text="No recent consolidations found." type="p"/>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
