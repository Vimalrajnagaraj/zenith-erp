<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GSTR-2">

    <transition name="generateGstr2" read-only="true"><default-response url="." parameter-map="[organizationPartyId:organizationPartyId,returnPeriod:returnPeriod]"/></transition>

    <actions>
        <if condition="organizationPartyId &amp;&amp; returnPeriod"><service-call name="zenith.india.Gstr2Services.generate#Gstr2Data" in-map="context" out-map="gstr2Result"/></if>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="defaultPeriod" from="String.format('%02d%04d', mn, yr)"/>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="GSTR-2 Purchase Register" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-single name="GenerateForm" transition="generateGstr2">
                <field name="organizationPartyId"><default-field title="Organization">
                    <drop-down><entity-options key="${partyId}" text="${organizationName}">
                        <entity-find entity-name="mantle.party.PartyDetail">
                            <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                            <!-- Org isolation: tenant sees only its own org in the picker (admin sees all). -->
                            <econdition field-name="partyId" from="ec.service.sync().name('zenith.tax.TaxAccessServices.get#AuthorizedActiveOrganization').call().activeOrgId ?: '_NA_'" ignore-if-empty="true"/>
                        </entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="returnPeriod" from="returnPeriod ?: defaultPeriod"><default-field title="Period (MMYYYY)">
                    <text-line size="8"/>
                </default-field></field>
                <field name="submitBtn"><default-field title="Generate Report"><submit type="success"/></default-field></field>
            </form-single>
        </container>

        <section name="ResultSection" condition="gstr2Result">
            <widgets>
                <container-row>
                    <row-col lg="3" md="6">
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                            <label text="Total Invoices" type="p" style="text-grey-7 text-uppercase q-mb-xs"/>
                            <label text="${gstr2Result.totalInvoices}" type="h4" style="text-weight-bold"/>
                        </container>
                    </row-col>
                    <row-col lg="3" md="6">
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                            <label text="Taxable Value" type="p" style="text-grey-7 text-uppercase q-mb-xs"/>
                            <label text="${zinr.inr(ec.l10n.format(gstr2Result.totalTaxableValue ?: 0, '#,##0.00'))}" type="h4" style="text-weight-bold"/>
                        </container>
                    </row-col>
                    <row-col lg="3" md="6">
                        <container style="zenith-card bg-positive shadow-2 border-radius-lg q-pa-lg text-center text-white">
                            <label text="Matched" type="p" style="text-uppercase q-mb-xs"/>
                            <label text="${gstr2Result.matchedCount}" type="h4" style="text-weight-bold"/>
                        </container>
                    </row-col>
                    <row-col lg="3" md="6">
                        <container style="zenith-card bg-negative shadow-2 border-radius-lg q-pa-lg text-center text-white">
                            <label text="Unmatched" type="p" style="text-uppercase q-mb-xs"/>
                            <label text="${gstr2Result.unmatchedCount}" type="h4" style="text-weight-bold"/>
                        </container>
                    </row-col>
                </container-row>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-lg">
                    <label text="Tax Summary" type="h5" style="text-weight-bold q-mb-md"/>
                    <container style="row">
                        <label text="IGST: ${zinr.inr(ec.l10n.format(gstr2Result.totalIgst ?: 0, '#,##0.00'))}" style="q-mr-lg"/>
                        <label text="CGST: ${zinr.inr(ec.l10n.format(gstr2Result.totalCgst ?: 0, '#,##0.00'))}" style="q-mr-lg"/>
                        <label text="SGST: ${zinr.inr(ec.l10n.format(gstr2Result.totalSgst ?: 0, '#,##0.00'))}" style="q-mr-lg"/>
                        <label text="CESS: ${zinr.inr(ec.l10n.format(gstr2Result.totalCess ?: 0, '#,##0.00'))}"/>
                    </container>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
