<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Payments" default-menu-index="4">

    <transition name="createPayment">
        <service-call name="create#mantle.account.payment.Payment" out-map="createOut"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="statusColorMap" from="[
            'PmntProposed': 'grey',
            'PmntPromised': 'info',
            'PmntAuthorized': 'primary',
            'PmntDelivered': 'warning',
            'PmntCancelled': 'danger',
            'PmntVoid': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Payments Ledger" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Log incoming receipts from customers and outgoing payments to vendors." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            
            <section name="LogPayment_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="LogPaymentDialog" button-text="Log Payment" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                <form-single name="LogPaymentForm" transition="createPayment">
                    <field name="paymentTypeEnumId">
                        <default-field title="Payment Direction">
                            <drop-down>
                                <option key="PtInvoicePayment" text="Incoming (Customer Receipt)"/>
                                <option key="PtVendorPayment" text="Outgoing (Vendor Payment)"/>
                            </drop-down>
                        </default-field>
                    </field>
                    
                    <field name="fromPartyId">
                        <default-field title="From Party (Payer)">
                            <drop-down allow-empty="true">
                                <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetail">
                                        <econdition field-name="partyId" operator="not-equals" value="_NA_"/>
                                        <order-by field-name="organizationName"/>
                                        <order-by field-name="firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    
                    <field name="toPartyId">
                        <default-field title="To Party (Payee)">
                            <drop-down allow-empty="true">
                                <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetail">
                                        <econdition field-name="partyId" operator="not-equals" value="_NA_"/>
                                        <order-by field-name="organizationName"/>
                                        <order-by field-name="firstName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    
                    <field name="amount"><default-field title="Amount (${currSymbol})"><text-line size="15"/></default-field></field>
                    <field name="effectiveDate"><default-field title="Date"><date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/></default-field></field>
                    
                    <field name="paymentMethodId">
                        <default-field title="Payment Method">
                            <drop-down allow-empty="true">
                                <entity-options key="${paymentMethodId}" text="${description}">
                                    <entity-find entity-name="mantle.account.method.PaymentMethod"/>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    
                    <field name="comments"><default-field title="Reference / UTR / Remarks"><text-line size="60"/></default-field></field>
                    
                    <field name="submitButton"><default-field title="Log Transaction"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Payments..." style="display:none"></span>]]></text></render-mode>
            <form-list name="FindPaymentList" list="paymentList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <entity-find entity-name="mantle.account.payment.Payment" list="paymentList">
                    <search-form-inputs default-order-by="-effectiveDate,paymentId"/>
                    <!-- Org isolation: payments where this org is payer (fromPartyId) OR payee (toPartyId). Admin sees all. -->
                    <econditions combine="or">
                        <econdition field-name="fromPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        <econdition field-name="toPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                    </econditions>
                </entity-find>

                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="fromParty">
                        <field-map field-name="partyId" from="fromPartyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    
                    <!-- Precompute clean strings for the CSV Export -->
                    <set field="fromName" from="fromParty?.organizationName ?: (fromParty?.firstName ? fromParty.firstName + ' ' + (fromParty.lastName?:'') : fromPartyId)"/>
                    <set field="toName" from="toParty?.organizationName ?: (toParty?.firstName ? toParty.firstName + ' ' + (toParty.lastName?:'') : toPartyId)"/>
                    <set field="partiesText" from="fromName + ' -> ' + toName"/>
                    
                    <set field="typeText" from="paymentTypeEnumId == 'PtInvoicePayment' ? 'INBOUND' : (paymentTypeEnumId == 'PtVendorPayment' ? 'OUTBOUND' : paymentTypeEnumId)"/>
                    
                    <set field="unappliedAmt" from="unappliedTotal ?: amount ?: 0"/>
                    <set field="unappliedText" from="unappliedAmt > 0 ? zinr.inr(ec.l10n.format(unappliedAmt, '#,##,##0.00')) : 'Fully Applied'"/>
                    <set field="unappliedStyle" from="unappliedAmt > 0 ? 'text-weight-bold text-danger' : 'text-success text-caption'"/>
                    
                    <set field="statusText" from="statusId ? statusId.replace('Pmnt', '').toUpperCase() : 'DELIVERED'"/>
                </row-actions>

                <field name="paymentId">
                    <header-field title="Ref ID" show-order-by="true"><text-find/></header-field>
                    <default-field><display style="text-indigo-8 text-weight-bold"/></default-field>
                </field>

                <field name="effectiveDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="dd MMM yyyy"/></default-field>
                </field>
                
                <field name="paymentTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="PtInvoicePayment" text="Incoming"/>
                            <option key="PtVendorPayment" text="Outgoing"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display text="${typeText}" style="${paymentTypeEnumId == 'PtInvoicePayment' ? 'zenith-badge success' : 'zenith-badge warning'}"/>
                    </default-field>
                </field>

                <field name="parties">
                    <header-field title="Parties"/>
                    <default-field>
                        <display text="${partiesText}" style="text-strong"/>
                    </default-field>
                </field>

                <field name="amount">
                    <header-field title="Amount (${currSymbol})" show-order-by="true"><range-find/></header-field>
                    <default-field><display format="#,##,##0.00" style="text-weight-bold"/></default-field>
                </field>
                
                <field name="unappliedTotal">
                    <header-field title="Unapplied"/>
                    <default-field>
                        <display text="${unappliedText}" style="${unappliedStyle}"/>
                    </default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="PmntProposed" text="Proposed"/>
                            <option key="PmntPromised" text="Promised"/>
                            <option key="PmntAuthorized" text="Authorized"/>
                            <option key="PmntDelivered" text="Delivered"/>
                            <option key="PmntCancelled" text="Cancelled"/>
                            <option key="PmntVoid" text="Void"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display text="${statusText}" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
