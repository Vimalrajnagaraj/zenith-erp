<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Voucher Audit">

    <actions>
        <entity-find entity-name="zenith.erp.accounting.VoucherAuditLog" list="auditLogs">
            <search-form-inputs default-order-by="-actionDate"/>
            <!-- ZE-SALES-014 f/u (Tier D): org-isolate the export; org is set on create from the acting user's org -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Voucher Audit Trail" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AuditForm" list="auditLogs" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="actionDate"><default-field title="Date/Time"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="voucherType"><header-field show-order-by="true">
                    <text-find hide-options="true" size="10"/>
                </header-field><default-field title="Voucher Type"><display/></default-field></field>
                <field name="voucherId"><default-field title="Voucher ID"><display/></default-field></field>
                <field name="actionEnumId"><default-field title="Action">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="performedByPartyId"><default-field title="User">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="previousValue"><default-field title="Previous"><display/></default-field></field>
                <field name="newValue"><default-field title="New"><display/></default-field></field>
                <field name="ipAddress"><default-field title="IP"><display/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
