<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Chart of Accounts" default-menu-index="2">

    <transition name="createGlAccount">
        <service-call name="create#mantle.ledger.account.GlAccount"/>
        <default-response url="."/>
    </transition>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Chart of Accounts" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Manage the General Ledger configured for Indian Schedule III requirements." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            
            <section name="NewAccount_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewAccountDialog" button-text="New Account" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                <form-single name="NewAccountForm" transition="createGlAccount">
                    <field name="accountCode"><default-field title="Account Code"><text-line size="10"/></default-field></field>
                    <field name="accountName"><default-field title="Account Name"><text-line size="40"/></default-field></field>
                    <field name="parentGlAccountId"><default-field title="Parent Account">
                        <drop-down allow-empty="true">
                            <entity-options key="${glAccountId}" text="${accountCode} - ${accountName}">
                                <entity-find entity-name="mantle.ledger.account.GlAccount">
                                    <econdition field-name="disallowPosting" value="Y"/>
                                    <order-by field-name="accountCode"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="glAccountClassEnumId"><default-field title="Account Class">
                        <widget-template-include location="component://webroot/template/screen/BasicWidgetTemplates.xml#enumDropDown">
                            <set field="enumTypeId" value="GlAccountClass"/>
                        </widget-template-include>
                    </default-field></field>
                    <field name="scheduleIiiGroup"><default-field title="Schedule III Group (India)">
                        <drop-down allow-empty="true">
                            <option key="EQUITY" text="Equity"/>
                            <option key="LIABILITIES" text="Liabilities"/>
                            <option key="ASSETS" text="Assets"/>
                            <option key="INCOME" text="Income"/>
                            <option key="EXPENSE" text="Expense"/>
                        </drop-down>
                    </default-field></field>
                    <field name="isGstAccount"><default-field title="Is this a GST Ledger Account?">
                        <drop-down no-current-selected-key="N">
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create Account"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="CoaListForm" list="accountList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <entity-find entity-name="mantle.ledger.account.GlAccount" list="accountList">
                    <search-form-inputs default-order-by="accountCode"/>
                </entity-find>
                
                <row-actions>
                    <set field="postingText" from="disallowPosting == 'Y' ? 'Group (No Posting)' : 'Postable'"/>
                    <set field="postingStyle" from="disallowPosting == 'Y' ? 'text-grey-6 text-caption' : 'text-success text-caption text-weight-bold'"/>
                    <set field="gstText" from="isGstAccount == 'Y' ? 'GST' : ''"/>
                    <set field="gstStyle" from="isGstAccount == 'Y' ? 'zenith-badge warning' : ''"/>
                    <set field="scheduleIiiGroupDisplay" from="scheduleIiiGroup ?: '-'"/>
                </row-actions>

                <field name="accountCode">
                    <header-field title="Code" show-order-by="true"><text-find/></header-field>
                    <default-field><display text="${accountCode}" style="text-indigo-8 text-weight-bold"/></default-field>
                </field>
                
                <field name="accountName">
                    <header-field title="Account Name" show-order-by="true"><text-find/></header-field>
                    <default-field><display text="${accountName}" style="text-dark text-weight-medium"/></default-field>
                </field>
                
                <field name="scheduleIiiGroup">
                    <header-field title="Schedule III Group">
                        <drop-down allow-empty="true">
                            <option key="EQUITY"/><option key="LIABILITIES"/><option key="ASSETS"/>
                            <option key="INCOME"/><option key="EXPENSE"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display text="${scheduleIiiGroupDisplay}" style="zenith-badge grey"/>
                    </default-field>
                </field>

                <field name="glAccountClassEnumId">
                    <header-field title="Class"/>
                    <default-field>
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field>
                </field>

                <field name="isGstAccount">
                    <header-field title="GST Account">
                        <drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </header-field>
                    <default-field>
                        <display text="${gstText}" style="${gstStyle}"/>
                    </default-field>
                </field>
                
                <field name="disallowPosting">
                    <default-field title="Posting">
                        <display text="${postingText}" style="${postingStyle}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
