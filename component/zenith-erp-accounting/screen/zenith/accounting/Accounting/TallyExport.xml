<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tally Export">

    <transition name="exportJournals">
        <service-call name="zenith.india.TallyExportServices.export#JournalsToTally" out-map="exportResult"/>
        <default-response url="."/>
    </transition>
    <transition name="exportLedgers">
        <service-call name="zenith.india.TallyExportServices.export#LedgersToTally" out-map="ledgerResult"/>
        <default-response url="."/>
    </transition>
    <transition name="downloadXml" read-only="true">
        <parameter name="xmlData"/>
        <parameter name="fileName"/>
        <actions>
            <script>ec.web.sendTextResponse(xmlData, "application/xml", fileName)</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <container style="q-mb-lg">
            <label text="Tally Export" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Export Vouchers" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="ExportJournalsForm" transition="exportJournals">
                        <field name="organizationPartyId"><default-field title="Organization">
                            <drop-down><entity-options key="${partyId}" text="${organizationName}">
                                <entity-find entity-name="mantle.party.PartyDetail">
                                    <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                                    <!-- Org isolation: tenant sees only its own org in the picker (admin sees all). -->
                                    <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="fromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                        <field name="toDate"><default-field title="To"><date-time type="date"/></default-field></field>
                        <field name="companyName"><default-field title="Tally Company Name"><text-line size="20"/></default-field></field>
                        <field name="submitBtn"><default-field title="Export Vouchers"><submit type="success"/></default-field></field>
                    </form-single>
                </container>

                <section name="JournalResult" condition="exportResult">
                    <widgets>
                        <container style="zenith-card bg-positive shadow-2 border-radius-lg q-pa-lg text-white text-center">
                            <label text="Exported ${exportResult.voucherCount} vouchers" type="h5" style="text-weight-bold"/>
                        </container>
                    </widgets>
                </section>
            </row-col>

            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Export Chart of Accounts" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="ExportLedgersForm" transition="exportLedgers">
                        <field name="organizationPartyId"><default-field title="Organization">
                            <drop-down><entity-options key="${partyId}" text="${organizationName}">
                                <entity-find entity-name="mantle.party.PartyDetail">
                                    <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                                    <!-- Org isolation: tenant sees only its own org in the picker (admin sees all). -->
                                    <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="companyName"><default-field title="Tally Company Name"><text-line size="20"/></default-field></field>
                        <field name="submitBtn"><default-field title="Export Ledgers"><submit type="info"/></default-field></field>
                    </form-single>
                </container>

                <section name="LedgerResult" condition="ledgerResult">
                    <widgets>
                        <container style="zenith-card bg-info shadow-2 border-radius-lg q-pa-lg text-white text-center">
                            <label text="Exported ${ledgerResult.ledgerCount} ledgers" type="h5" style="text-weight-bold"/>
                        </container>
                    </widgets>
                </section>
            </row-col>
        </container-row>
    </widgets>
</screen>
