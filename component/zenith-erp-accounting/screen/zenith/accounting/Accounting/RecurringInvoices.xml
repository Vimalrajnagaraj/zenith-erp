<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Recurring Invoices" default-menu-index="15">

    <transition name="createRecurring"><service-call name="create#zenith.erp.accounting.RecurringInvoice"/>
        <default-response url="."/></transition>
    <transition name="updateRecurring"><service-call name="update#zenith.erp.accounting.RecurringInvoice"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.accounting.RecurringInvoice" list="recurringList">
            <order-by field-name="nextInvoiceDate"/>
        </entity-find>

        <entity-find-count entity-name="zenith.erp.accounting.RecurringInvoice" count-field="activeCount">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>

        <!-- Upcoming invoices (next 30 days) -->
        <set field="thirtyDaysLater" from="new java.sql.Date(System.currentTimeMillis() + (30L * 86400000L))"/>
        <entity-find entity-name="zenith.erp.accounting.RecurringInvoice" list="upcomingList">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="nextInvoiceDate" operator="less-equals" from="thirtyDaysLater"/>
            <order-by field-name="nextInvoiceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Recurring Invoices" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Automate repeating invoices — monthly retainers, subscriptions, rent" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container-dialog id="CreateRecurringDialog" button-text="Create Template" width="700"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="CreateRecurringForm" transition="createRecurring">
                    <field name="invoiceTypeEnumId"><default-field title="Invoice Type">
                        <drop-down allow-empty="false">
                            <option key="InvoiceSales" text="Sales Invoice"/>
                            <option key="InvoicePurchase" text="Purchase Invoice"/>
                        </drop-down>
                    </default-field></field>
                    <field name="toPartyId"><default-field title="Customer / Vendor">
                        <drop-down allow-empty="false">
                            <entity-options key="${partyId}" text="${organizationName ?: (firstName + ' ' + lastName)}">
                                <entity-find entity-name="mantle.party.PartyDetail">
                                    <order-by field-name="organizationName,firstName"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="totalAmount"><default-field title="Amount"><text-line size="15"/></default-field></field>
                    <field name="recurringFrequency"><default-field title="Frequency">
                        <drop-down allow-empty="false">
                            <option key="Monthly" text="Monthly"/>
                            <option key="Quarterly" text="Quarterly"/>
                            <option key="Annually" text="Annually"/>
                            <option key="Weekly" text="Weekly"/>
                            <option key="BiWeekly" text="Bi-Weekly"/>
                        </drop-down>
                    </default-field></field>
                    <field name="nextInvoiceDate"><default-field title="First Invoice Date"><date-time type="date"/></default-field></field>
                    <field name="endDate"><default-field title="End Date (optional)"><date-time type="date"/></default-field></field>
                    <field name="autoSend"><default-field title="Auto-Send">
                        <drop-down allow-empty="false"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- Summary -->
        <container-row>
            <row-col lg="4">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Active Templates" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${activeCount ?: 0}" type="h3" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="4">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Due Next 30 Days" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${upcomingList?.size() ?: 0}" type="h3" style="text-warning text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="4">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Total Templates" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${recurringList?.size() ?: 0}" type="h3" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Recurring Invoice List -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="RecurringListForm" list="recurringList" transition="updateRecurring" multi="true"
                       show-csv-button="true">
                <field name="recurringInvoiceId"><default-field><hidden/></default-field></field>
                <field name="description"><default-field title="Description"><display/></default-field></field>
                <field name="invoiceTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="toPartyId"><default-field title="Party">
                    <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                </default-field></field>
                <field name="totalAmount"><default-field title="Amount"><display format="#,##,##0.00"/></default-field></field>
                <field name="recurringFrequency"><default-field title="Frequency"><display/></default-field></field>
                <field name="nextInvoiceDate"><default-field title="Next Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="invoiceCount"><default-field title="Generated"><display/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down allow-empty="false"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
