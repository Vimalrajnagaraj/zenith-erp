<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="ASC 606 Transition Tool" default-menu-index="95">

    <transition name="generateCatchUp">
        <service-call name="zenith.accounting.Asc606TransitionServices.generate#CumulativeCatchUpEntry" in-map="context"/>
        <default-response url="."/>
    </transition>
    
    <transition name="postCatchUp">
        <service-call name="zenith.accounting.Asc606TransitionServices.post#CumulativeCatchUpEntry" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <order-by field-name="organizationName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box><box-header title="ASC 606 Compliance Cut-over"/>
                    <box-body>
                        <label text="Identify all active subscriptions crossing the cut-over date, and draft a cumulative catch-up Journal Entry. This preserves historical invoice GL entries while applying new routing rules to future invoices." type="p" style="text-primary text-weight-bold q-mb-md"/>
                        
                        <form-single name="Asc606GenerateForm" transition="generateCatchUp">
                            <field name="organizationPartyId"><default-field title="Organization">
                                <drop-down>
                                    <list-options list="orgList" key="${partyId}" text="${organizationName} [${pseudoId}]"/>
                                </drop-down>
                            </default-field></field>
                            <field name="cutoverDate"><default-field title="Cut-over Date"><date-time type="date"/></default-field></field>
                            <field name="submitButton">
                                <conditional-field name="save_write" condition="modCanWrite" title="Draft Catch-Up Entry"><submit/></conditional-field>
                                <default-field title="Draft Catch-Up Entry"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="Pending Approvals"/>
                    <box-body>
                        <label text="No pending ASC 606 Catch-Up entries for review." type="p"/>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
