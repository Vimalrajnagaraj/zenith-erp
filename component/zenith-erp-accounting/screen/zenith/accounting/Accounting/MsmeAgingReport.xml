<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="MSME Aging Report" default-menu-index="7">

    <actions>
        <!-- Fetch AP Invoices linked to Vendors marked as MSME -->
        <!-- We use an entity-find with a view-entity equivalent in code or just fetch invoices and filter. -->
        <entity-find entity-name="mantle.account.invoice.Invoice" list="apInvoices">
            <search-form-inputs default-order-by="invoiceDate"/>
            <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/>
            <econdition field-name="statusId" operator="in" from="['InvoiceFinalized', 'InvoiceApproved']"/>
        </entity-find>

        <set field="msmeInvoiceList" from="[]"/>
        <set field="nowDate" from="ec.user.nowTimestamp"/>

        <iterate list="apInvoices" entry="invoice">
            <!-- Check if Vendor is MSME -->
            <entity-find-one entity-name="zenith.erp.india.IndiaPartyTaxProfile" value-field="taxProfile">
                <field-map field-name="partyId" from="invoice.fromPartyId"/>
            </entity-find-one>

            <if condition="taxProfile != null &amp;&amp; taxProfile.isMsme == 'Y'">
                <!-- Fetch Vendor Name -->
                <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorDetail">
                    <field-map field-name="partyId" from="invoice.fromPartyId"/>
                </entity-find-one>
                
                <!-- Calculate Aging -->
                <script>
                    def dueDate = invoice.dueDate ?: invoice.invoiceDate
                    def daysOverdue = 0
                    if (dueDate != null &amp;&amp; nowDate.after(dueDate)) {
                        def diffMillis = nowDate.getTime() - dueDate.getTime()
                        daysOverdue = Math.floor(diffMillis / (1000 * 60 * 60 * 24))
                    }
                    
                    def invoiceMap = invoice.getMap()
                    invoiceMap.put("daysOverdue", daysOverdue)
                    invoiceMap.put("udyamNumber", taxProfile.udyamRegistrationNumber)
                    
                    def orgName = vendorDetail?.organizationName
                    def personName = vendorDetail?.firstName ? vendorDetail.firstName + ' ' + (vendorDetail.lastName ?: '') : null
                    invoiceMap.put("vendorName", orgName ?: personName ?: invoice.fromPartyId)
                    
                    // Flag for Sec 43B(h) Disallowance
                    if (daysOverdue > 45) {
                        invoiceMap.put("taxDisallowed", "Y")
                    } else {
                        invoiceMap.put("taxDisallowed", "N")
                    }
                    
                    msmeInvoiceList.add(invoiceMap)
                </script>
            </if>
        </iterate>
    </actions>

    <widgets>
        <container-box><box-header title="MSME Aging Report (Sec 43B(h) Compliance)"/><box-body>
            <label text="Due to recent Income Tax rules (Sec 43B(h)), late payments (> 45 days) to MSME vendors cannot be claimed as deductions, artificially increasing your taxable profit." type="p" style="text-warning text-weight-bold q-mb-md"/>
            
            <form-list name="MsmeAgingListForm" list="msmeInvoiceList" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="invoiceId">
                    <header-field title="Invoice #"><text-find/></header-field>
                    <default-field><display style="text-indigo-8 text-weight-bold"/></default-field>
                </field>
                <field name="vendorName">
                    <header-field title="Vendor"/><text-find/>
                    <default-field><display style="text-strong"/></default-field>
                </field>
                <field name="udyamNumber">
                    <header-field title="UDYAM No."/>
                    <default-field><display/></default-field>
                </field>
                <field name="invoiceDate">
                    <header-field title="Invoice Date" show-order-by="true"/>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="dueDate">
                    <header-field title="Due Date" show-order-by="true"/>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="invoiceTotal">
                    <header-field title="Total Amt" show-order-by="true"/>
                    <default-field><display currency-unit-field="currencyUomId" style="text-weight-bold"/></default-field>
                </field>
                <field name="daysOverdue">
                    <header-field title="Days Overdue" show-order-by="true"/>
                    <default-field>
                        <display text="${daysOverdue}" style="${daysOverdue > 45 ? 'text-danger text-weight-bold' : 'text-success text-weight-bold'}"/>
                    </default-field>
                </field>
                <field name="taxDisallowed">
                    <header-field title="IT Disallowance Risk"/>
                    <default-field>
                        <display text="${taxDisallowed == 'Y' ? 'HIGH RISK' : 'SAFE'}" style="${taxDisallowed == 'Y' ? 'bg-danger text-white q-pa-xs border-radius-sm' : 'bg-success text-white q-pa-xs border-radius-sm'}"/>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
