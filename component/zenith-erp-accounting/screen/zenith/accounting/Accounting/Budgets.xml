<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Budgets" default-menu-index="14">

    <transition name="createBudget"><service-call name="create#zenith.erp.accounting.Budget"/>
        <default-response url="."/></transition>
    <transition name="updateBudget"><service-call name="update#zenith.erp.accounting.Budget"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.accounting.Budget" list="budgetList">
            <search-form-inputs default-order-by="-budgetYear,-budgetMonth"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <!-- Summary for current FY -->
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
        <entity-find entity-name="zenith.erp.accounting.Budget" list="currentYearBudgets">
            <econdition field-name="budgetYear" from="currentYear.toString()"/>
        </entity-find>
        <set field="totalBudgeted" from="0" type="BigDecimal"/>
        <set field="totalActual" from="0" type="BigDecimal"/>
        <script>
            for (def b : currentYearBudgets) {
                totalBudgeted += (b.budgetAmount ?: 0)
                totalActual += (b.actualAmount ?: 0)
            }
        </script>
        <set field="variance" from="totalBudgeted - totalActual"/>
        <set field="utilizationPercent" from="totalBudgeted > 0 ? ((totalActual / totalBudgeted) * 100).intValue() : 0"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Budget Management" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Plan, track, and control departmental and project budgets" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container-dialog id="CreateBudgetDialog" button-text="Create Budget" width="700"
                              button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-lg">
                <form-single name="CreateBudgetForm" transition="createBudget">
                    <field name="budgetName"><default-field title="Budget Name"><text-line size="30"/></default-field></field>
                    <field name="budgetTypeEnumId"><default-field title="Type">
                        <drop-down allow-empty="false">
                            <option key="BtDepartment" text="Department"/>
                            <option key="BtProject" text="Project"/>
                            <option key="BtCost" text="Cost Center"/>
                            <option key="BtCapex" text="Capital Expenditure"/>
                            <option key="BtOpex" text="Operating Expenditure"/>
                        </drop-down>
                    </default-field></field>
                    <field name="glAccountId"><default-field title="GL Account">
                        <drop-down allow-empty="true">
                            <entity-options key="${glAccountId}" text="${accountCode} - ${accountName}">
                                <entity-find entity-name="mantle.ledger.account.GlAccount">
                                    <order-by field-name="accountCode"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="budgetYear"><default-field title="Year"><text-line size="6" default-value="${currentYear}"/></default-field></field>
                    <field name="budgetMonth"><default-field title="Month (1-12, blank for annual)"><text-line size="4"/></default-field></field>
                    <field name="budgetAmount"><default-field title="Budget Amount"><text-line size="15"/></default-field></field>
                    <field name="description"><default-field title="Notes"><text-area rows="2" cols="40"/></default-field></field>
                    <field name="statusId"><default-field><hidden default-value="BudDraft"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <!-- Summary Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Total Budgeted (${currentYear})" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${currSymbol}${ec.l10n.format(totalBudgeted, '#,##,##0')}" type="h4" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Actual Spent" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${currSymbol}${ec.l10n.format(totalActual, '#,##,##0')}" type="h4" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Variance" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${currSymbol}${ec.l10n.format(variance.abs(), '#,##,##0')}" type="h4"
                           style="${variance >= 0 ? 'text-positive' : 'text-negative'} text-weight-bolder q-my-none"/>
                    <label text="${variance >= 0 ? 'Under Budget' : 'Over Budget'}" type="p"
                           style="${variance >= 0 ? 'text-positive' : 'text-negative'} text-weight-bold q-mt-xs q-mb-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md">
                    <label text="Utilization" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${utilizationPercent}%" type="h4"
                           style="${utilizationPercent > 100 ? 'text-negative' : utilizationPercent > 80 ? 'text-warning' : 'text-positive'} text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Budget List -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="BudgetListForm" list="budgetList" transition="updateBudget" multi="true"
                       header-dialog="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="budgetId"><default-field><hidden/></default-field></field>
                <field name="budgetName"><header-field title="Budget Name" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field title="Name"><display/></default-field></field>
                <field name="budgetTypeEnumId"><header-field title="Type" show-order-by="true"/>
                    <default-field title="Type"><display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
                <field name="budgetYear"><header-field title="Year" show-order-by="true"><text-find size="6" hide-options="true"/></header-field>
                    <default-field title="Year"><display/></default-field></field>
                <field name="budgetMonth"><header-field title="Month"/>
                    <default-field title="Month"><display/></default-field></field>
                <field name="budgetAmount"><header-field title="Budget" show-order-by="true"/>
                    <default-field title="Budget"><display format="#,##,##0.00"/></default-field></field>
                <field name="actualAmount"><header-field title="Actual" show-order-by="true"/>
                    <default-field title="Actual"><text-line size="12"/></default-field></field>
                <field name="statusId"><header-field title="Status">
                    <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                        <entity-find entity-name="moqui.basic.StatusItem">
                            <econdition field-name="statusTypeId" value="Budget"/></entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Status">
                        <drop-down allow-empty="false"><entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="Budget"/></entity-find>
                        </entity-options></drop-down>
                    </default-field></field>
                <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                <field name="searchButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
