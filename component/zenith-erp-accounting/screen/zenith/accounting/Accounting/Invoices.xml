<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices (A/R &amp; A/P)" default-menu-index="3">

    <actions>
        <set field="statusColorMap" from="[
            'InvoiceIn-Process': 'grey',
            'InvoiceApproved': 'primary',
            'InvoiceSent': 'info',
            'InvoiceReceived': 'warning',
            'InvoiceFinalized': 'primary',
            'InvoicePaid': 'success',
            'InvoiceCancelled': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Accounts Receivable &amp; Payable" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Track outstanding customer invoices and vendor bills." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="FindInvoiceList" list="invoiceList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <entity-find entity-name="mantle.account.invoice.Invoice" list="invoiceList">
                    <search-form-inputs default-order-by="-invoiceDate,invoiceId"/>
                    <!-- Org isolation: this org's sales invoices (fromPartyId) OR purchase bills (toPartyId). Admin sees all. -->
                    <econditions combine="or">
                        <econdition field-name="fromPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                        <econdition field-name="toPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                    </econditions>
                </entity-find>

                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="fromParty">
                        <field-map field-name="partyId" from="fromPartyId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    
                    <script>
                        def getPartyName = { party ->
                            if (!party) return "Unknown"
                            if (party.organizationName) return party.organizationName
                            if (party.firstName || party.lastName) return (party.firstName ?: "") + " " + (party.lastName ?: "")
                            return party.pseudoId ?: party.partyId ?: "Unknown"
                        }
                        fromName = getPartyName(fromParty)
                        toName = getPartyName(toParty)
                        
                        // Compute CSV-friendly Display text and CSS styles
                        def isSales = invoiceTypeEnumId == 'InvoiceSales'
                        def isPurchase = invoiceTypeEnumId == 'InvoicePurchase'
                        
                        typeText = isSales ? 'A/R' : (isPurchase ? 'A/P' : 'OTHER')
                        typeStyle = isSales ? 'zenith-badge success' : (isPurchase ? 'zenith-badge warning' : 'zenith-badge dark')
                        targetUrl = isSales ? '/vapps/zenith/sales/EditInvoice' : (isPurchase ? '/vapps/zenith/Purchase/EditPurchaseInvoice' : '')
                        
                        counterpartyText = isPurchase ? "From: " + fromName : "To: " + toName
                        
                        dateStr = invoiceDate ? ec.l10n.format(invoiceDate, 'dd MMM yyyy') : 'N/A'
                        
                        totalStr = ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00')
                        
                        def unpaid = unpaidTotal ?: invoiceTotal ?: 0
                        unpaidStr = ec.l10n.format(unpaid, '#,##,##0.00')
                        unpaidStyle = unpaid > 0 ? 'text-weight-bold text-danger' : 'text-weight-bold text-success'
                        
                        statusText = statusId ? statusId.replace('Invoice', '').toUpperCase() : 'UNKNOWN'
                    </script>
                </row-actions>

                <field name="toPartyId">
                    <header-field><text-find/></header-field>
                    <default-field><hidden/></default-field>
                </field>
                <field name="fromPartyId">
                    <header-field><text-find/></header-field>
                    <default-field><hidden/></default-field>
                </field>

                <field name="invoiceId">
                    <header-field title="Invoice ID" show-order-by="true"><text-find/></header-field>
                    <default-field>
                        <section name="LinkSection" condition="targetUrl"><widgets>
                            <link url="${targetUrl}" text="${invoiceId}" style="text-weight-bold text-primary" parameter-map="[invoiceId:invoiceId]" link-type="anchor"/>
                        </widgets><fail-widgets>
                            <display text="${invoiceId}"/>
                        </fail-widgets></section>
                    </default-field>
                </field>

                <field name="invoiceTypeEnumId">
                    <header-field title="Type">
                        <drop-down allow-empty="true">
                            <option key="InvoiceSales" text="A/R (Sales)"/>
                            <option key="InvoicePurchase" text="A/P (Purchase)"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display text="${typeText}" style="${typeStyle}"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><display text="${dateStr}"/></default-field>
                </field>

                <field name="partyInfo">
                    <header-field title="Counterparty"/>
                    <default-field>
                        <link url="/vapps/zenith/contacts/Contacts/EditContact" text="${counterpartyText}" style="text-indigo-8 text-weight-bold" parameter-map="[partyId:(isPurchase ? fromPartyId : toPartyId)]" link-type="anchor"/>
                    </default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Total Amount (${currSymbol})" show-order-by="true"/>
                    <default-field><display text="${totalStr}" style="text-weight-bold"/></default-field>
                </field>
                
                <field name="unpaidTotal">
                    <header-field title="Outstanding (${currSymbol})"/>
                    <default-field>
                        <display text="${unpaidStr}" style="${unpaidStyle}"/>
                    </default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIn-Process" text="In Process"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoiceFinalized" text="Finalized"/>
                            <option key="InvoiceSent" text="Sent"/>
                            <option key="InvoiceReceived" text="Received"/>
                            <option key="InvoicePaid" text="Paid"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display text="${statusText}" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
