<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="GST Reports" default-menu-index="6">

    <transition name="extractGstr1">
        <service-call name="zenith.erp.india.GstServices.extract#Gstr1Data"/>
        <default-response url="."/>
    </transition>

    <transition name="downloadGstr1Json" read-only="true">
        <parameter name="filingId" required="true"/>
        <actions>
            <entity-find-one entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="filing"/>
            <if condition="filing != null &amp;&amp; filing.jsonPayload != null">
                <script>
                    ec.web.sendTextResponse(filing.jsonPayload, "application/json", "GSTR1_" + filing.returnPeriod + ".json")
                </script>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script>
            ec.entity.makeDataLoader().location("component://zenith-erp-india/data/IndiaDemoData.xml").load()
        </script>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="yr" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="mn" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="fyStart" from="mn &gt;= 4 ? yr : yr - 1"/>
        <set field="currentFy" value="${fyStart}-${fyStart + 1}"/>
        
        <!-- Pad month to 2 digits -->
        <set field="mnStr" from="mn &lt; 10 ? '0' + mn : '' + mn"/>
        <set field="currentPeriod" value="${mnStr}${yr}"/>

        <!-- Fetch default internal organization -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <!-- Org isolation: tenant sees only its own org in the picker (admin with no active org sees all). -->
            <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.india.gstr1.Gstr1Filing" list="filingList">
            <search-form-inputs default-order-by="-filingDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <section name="Gstr1Generate_write">
                    <condition><expression>modCanWrite</expression></condition>
                    <widgets>
                        <container-box><box-header title="Generate GSTR-1 Return"/><box-body>
                            <form-single name="ExtractGstr1Form" transition="extractGstr1">
                                <field name="organizationPartyId"><default-field title="Branch / GSTIN">
                                    <drop-down>
                                        <list-options list="orgList" key="${partyId}" text="${organizationName}"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="returnPeriod"><default-field title="Return Period (MMYYYY)">
                                    <text-line size="6" default-value="${currentPeriod}"/>
                                </default-field></field>
                                <field name="financialYear"><default-field title="Financial Year">
                                    <text-line size="9" default-value="${currentFy}"/>
                                </default-field></field>
                                <field name="submitButton"><default-field title="Extract Data from Invoices">
                                    <submit/>
                                </default-field></field>
                            </form-single>
                        </box-body></container-box>
                    </widgets>
                </section>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="GST Ledgers &amp; ITC"/><box-body>
                    <label text="Electronic Liability Register" type="p" style="text-primary text-weight-bold q-mb-xs"/>
                    <label text="IGST Output, CGST Output, SGST Output balances are tracked via standard GL Accounts 211010-211040." type="p"/>
                    <label text="Electronic Credit Ledger (ITC)" type="p" style="text-primary text-weight-bold q-mb-xs q-mt-md"/>
                    <label text="IGST Input, CGST Input, SGST Input balances are tracked via GL Accounts 310410-310440." type="p"/>
                    <label text="Reverse Charge Mechanism (RCM)" type="p" style="text-primary text-weight-bold q-mb-xs q-mt-md"/>
                    <label text="The Auto-RCM Service executes on Purchase Invoice approval for applicable vendor categories." type="p"/>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-box><box-header title="GSTR-1 Filings History"/><box-body>
            <form-list name="Gstr1ListForm" list="filingList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="returnPeriod"><header-field title="Period"/><default-field><display/></default-field></field>
                <field name="financialYear"><header-field title="FY"/><default-field><display/></default-field></field>
                <field name="organizationPartyId"><header-field title="Org ID"/><default-field><display/></default-field></field>
                <field name="filingDate"><header-field title="Generated On"><date-find/></header-field><default-field><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                <field name="statusId"><header-field title="Status"/><default-field><display/></default-field></field>
                <field name="acknowledgementNumber"><header-field title="ARN"/><default-field><display/></default-field></field>
                <field name="jsonDownload"><default-field title="JSON Payload">
                    <link url="downloadGstr1Json" text="Download JSON" condition="statusId == 'DRAFT'" icon="download" link-type="anchor">
                        <parameter name="filingId" value="${filingId}"/>
                    </link>
                </default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </box-body></container-box>
    </widgets>
</screen>
