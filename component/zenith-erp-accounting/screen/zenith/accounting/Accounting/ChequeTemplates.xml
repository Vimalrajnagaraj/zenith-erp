<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cheque Templates">

    <transition name="createTemplate">
        <service-call name="create#zenith.erp.accounting.ChequeTemplate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTemplate">
        <service-call name="update#zenith.erp.accounting.ChequeTemplate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.accounting.ChequeTemplate" list="templates">
            <order-by field-name="templateName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Cheque Print Templates" type="h4" style="text-weight-bold q-my-none"/>
            <section name="CreateTemplate_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="CreateTemplate" button-text="New Template" type="success">
                <form-single name="CreateForm" transition="createTemplate">
                    <field name="templateName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="bankName"><default-field><text-line size="20"/></default-field></field>
                    <field name="dateX"><default-field title="Date X (mm)"><text-line size="5"/></default-field></field>
                    <field name="dateY"><default-field title="Date Y (mm)"><text-line size="5"/></default-field></field>
                    <field name="payeeX"><default-field title="Payee X"><text-line size="5"/></default-field></field>
                    <field name="payeeY"><default-field title="Payee Y"><text-line size="5"/></default-field></field>
                    <field name="amountWordsX"><default-field title="Words X"><text-line size="5"/></default-field></field>
                    <field name="amountWordsY"><default-field title="Words Y"><text-line size="5"/></default-field></field>
                    <field name="amountFiguresX"><default-field title="Figures X"><text-line size="5"/></default-field></field>
                    <field name="amountFiguresY"><default-field title="Figures Y"><text-line size="5"/></default-field></field>
                    <field name="accountPayeeOnly" from="'Y'"><default-field title="A/C Payee Only">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="TemplatesForm" list="templates" transition="updateTemplate">
                <field name="chequeTemplateId"><default-field><hidden/></default-field></field>
                <field name="templateName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="bankName"><default-field title="Bank"><text-line size="15"/></default-field></field>
                <field name="dateX"><default-field title="Date X"><text-line size="4"/></default-field></field>
                <field name="dateY"><default-field title="Date Y"><text-line size="4"/></default-field></field>
                <field name="payeeX"><default-field title="Payee X"><text-line size="4"/></default-field></field>
                <field name="payeeY"><default-field title="Payee Y"><text-line size="4"/></default-field></field>
                <field name="amountFiguresX"><default-field title="Fig X"><text-line size="4"/></default-field></field>
                <field name="amountFiguresY"><default-field title="Fig Y"><text-line size="4"/></default-field></field>
                <field name="submitBtn"><conditional-field name="update_write" condition="modCanWrite" title="Update"><submit/></conditional-field><default-field title=""><label text="" type="span"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
