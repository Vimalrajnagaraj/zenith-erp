<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Manual Journal Entry" default-menu-index="2">

    <transition name="postJournalEntry">
        <parameter name="organizationPartyId" required="true"/>
        <parameter name="transactionDate" type="Timestamp" required="true"/>
        <parameter name="description" required="true"/>
        <parameter name="debitGlAccountId" required="true"/>
        <parameter name="creditGlAccountId" required="true"/>
        <parameter name="amount" type="BigDecimal" required="true"/>
        
        <actions>
            <!-- Org-isolation: a tenant user may only post into their OWN org's ledger.
                 Force organizationPartyId to the active org, ignoring the submitted value
                 (prevents posting a journal into another tenant's ledger). Platform
                 super-admin has no active org and keeps the explicitly chosen org. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN')">
                <set field="organizationPartyId" from="activeOrg"/>
            </if>
            <if condition="amount &lt;= 0">
                <return error="true" message="Amount must be greater than zero."/>
            </if>
            <if condition="debitGlAccountId == creditGlAccountId">
                <return error="true" message="Debit and Credit accounts cannot be the same."/>
            </if>
            
            <!-- Create AcctgTrans -->
            <service-call name="create#mantle.ledger.transaction.AcctgTrans"
                          in-map="[acctgTransTypeEnumId:'AttJournal', organizationPartyId:organizationPartyId,
                                   transactionDate:transactionDate, description:description,
                                   isPosted:'Y', postedDate:ec.user.nowTimestamp]"
                          out-map="transOut"/>
                          
            <!-- Create Debit Entry -->
            <service-call name="create#mantle.ledger.transaction.AcctgTransEntry"
                          in-map="[acctgTransId:transOut.acctgTransId, acctgTransEntrySeqId:'01',
                                   debitCreditFlag:'D', amount:amount, glAccountId:debitGlAccountId,
                                   reconcileStatusId:'AesNotReconciled', isSummary:'N']"/>
                                   
            <!-- Create Credit Entry -->
            <service-call name="create#mantle.ledger.transaction.AcctgTransEntry"
                          in-map="[acctgTransId:transOut.acctgTransId, acctgTransEntrySeqId:'02',
                                   debitCreditFlag:'C', amount:amount, glAccountId:creditGlAccountId,
                                   reconcileStatusId:'AesNotReconciled', isSummary:'N']"/>
                                   
            <!-- Post Transaction using standard Moqui service to ensure GL balances are updated -->
            <service-call name="mantle.ledger.LedgerServices.post#AcctgTrans"
                          in-map="[acctgTransId:transOut.acctgTransId]"/>
                          
            <message type="success">Journal Entry successfully posted!</message>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>

        <entity-find entity-name="mantle.ledger.account.GlAccount" list="glAccountList">
            <order-by field-name="accountCode"/>
            <order-by field-name="accountName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Manual Journal Entry"/><box-body>
            <container style="q-pa-md bg-white shadow-1 rounded-borders" width="800">
                <form-single name="ManualJournalForm" transition="postJournalEntry">
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down>
                            <list-options list="orgList" key="${partyId}" text="${organizationName}"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="transactionDate"><default-field title="Transaction Date">
                        <date-time type="date" default-value="${ec.user.nowTimestamp}"/>
                    </default-field></field>
                    
                    <field name="description"><default-field title="Description">
                        <text-line size="60"/>
                    </default-field></field>
                    
                    <field name="debitGlAccountId"><default-field title="Debit Account">
                        <drop-down>
                            <list-options list="glAccountList" key="${glAccountId}" text="${accountCode} - ${accountName}"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="creditGlAccountId"><default-field title="Credit Account">
                        <drop-down>
                            <list-options list="glAccountList" key="${glAccountId}" text="${accountCode} - ${accountName}"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="amount"><default-field title="Amount">
                        <text-line size="20"/>
                    </default-field></field>
                    
                    <field name="submitButton">
                        <conditional-field name="save_write" condition="modCanWrite" title="Post Journal Entry"><submit/></conditional-field>
                        <default-field title="Post Journal Entry"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                    </field>
                    
                    <field-layout>
                        <field-row><field-ref name="organizationPartyId"/><field-ref name="transactionDate"/></field-row>
                        <field-row><field-ref name="description"/></field-row>
                        <field-row><field-ref name="debitGlAccountId"/><field-ref name="creditGlAccountId"/></field-row>
                        <field-row><field-ref name="amount"/></field-row>
                        <field-ref name="submitButton"/>
                    </field-layout>
                </form-single>
            </container>
        </box-body></container-box>
    </widgets>
</screen>
