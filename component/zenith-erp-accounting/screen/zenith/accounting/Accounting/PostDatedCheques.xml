<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Post-Dated Cheques">

    <transition name="createPdc">
        <service-call name="zenith.accounting.ChequeServices.create#PostDatedCheque"/>
        <default-response url="."/>
    </transition>
    <transition name="depositPdc">
        <service-call name="zenith.accounting.ChequeServices.deposit#PostDatedCheque"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePdcStatus">
        <service-call name="zenith.accounting.ChequeServices.update#PostDatedChequeStatus"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.accounting.PostDatedCheque" list="pdcList">
            <search-form-inputs default-order-by="chequeDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Post-Dated Cheques" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreatePdc" button-text="New PDC" type="success">
                <form-single name="CreatePdcForm" transition="createPdc">
                    <field name="chequeNumber"><default-field title="Cheque #"><text-line size="15"/></default-field></field>
                    <field name="bankName"><default-field title="Bank"><text-line size="20"/></default-field></field>
                    <field name="partyId"><default-field title="Party">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="amount"><default-field><text-line size="12"/></default-field></field>
                    <field name="chequeDate"><default-field title="Cheque Date"><date-time type="date"/></default-field></field>
                    <field name="directionEnumId"><default-field title="Direction">
                        <drop-down>
                            <option key="PdcReceived" text="Received"/>
                            <option key="PdcIssued" text="Issued"/>
                        </drop-down></default-field></field>
                    <field name="reminderDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="notes"><default-field><text-area rows="2" cols="30"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PdcForm" list="pdcList" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="chequeNumber"><default-field title="Cheque #"><display/></default-field></field>
                <field name="bankName"><default-field title="Bank"><display/></default-field></field>
                <field name="partyId"><default-field title="Party">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="amount"><default-field><display format="#,##0.00"/></default-field></field>
                <field name="chequeDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="directionEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="PdcOnHand" text="On Hand"/>
                        <option key="PdcDeposited" text="Deposited"/>
                        <option key="PdcCleared" text="Cleared"/>
                        <option key="PdcBounced" text="Bounced"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="depositPdc" text="Deposit" parameter-map="[postDatedChequeId:postDatedChequeId]"
                          condition="statusId == 'PdcOnHand'" btn-type="info" style="q-btn--dense"/>
                    <link url="updatePdcStatus" text="Cleared"
                          parameter-map="[postDatedChequeId:postDatedChequeId, statusId:'PdcCleared']"
                          condition="statusId == 'PdcDeposited'" btn-type="success" style="q-btn--dense"/>
                    <link url="updatePdcStatus" text="Bounced"
                          parameter-map="[postDatedChequeId:postDatedChequeId, statusId:'PdcBounced']"
                          condition="statusId == 'PdcDeposited'" btn-type="danger" style="q-btn--dense"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
