<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="MCA Audit Log" default-menu-index="6">

    <actions>
        <set field="_mcaOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <!-- ZE-SALES-014 f/u (Tier D): scope the audit trail to the active org via the audited voucher's own
             org (invoice/payment/GL). Per-type conditions so a pkPrimaryValue that collides across entity
             types can't mis-attribute; ignore-if-empty means super-admin (empty org) sees the full log. -->
        <entity-find entity-name="zenith.erp.accounting.McaAuditLogView" list="auditLogList">
            <search-form-inputs default-order-by="-changedDate"/>
            <econdition field-name="changedEntityName" operator="in" value="mantle.ledger.transaction.AcctgTrans,mantle.ledger.transaction.AcctgTransEntry,mantle.account.invoice.Invoice,mantle.account.payment.Payment"/>
            <econditions combine="or">
                <econditions combine="and">
                    <econdition field-name="changedEntityName" value="mantle.account.invoice.Invoice"/>
                    <econdition field-name="invOrg" from="_mcaOrg" ignore-if-empty="true"/>
                </econditions>
                <econditions combine="and">
                    <econdition field-name="changedEntityName" value="mantle.account.payment.Payment"/>
                    <econdition field-name="payFromOrg" from="_mcaOrg" ignore-if-empty="true"/>
                </econditions>
                <econditions combine="and">
                    <econdition field-name="changedEntityName" value="mantle.account.payment.Payment"/>
                    <econdition field-name="payToOrg" from="_mcaOrg" ignore-if-empty="true"/>
                </econditions>
                <econditions combine="and">
                    <econdition field-name="changedEntityName" operator="in" value="mantle.ledger.transaction.AcctgTrans,mantle.ledger.transaction.AcctgTransEntry"/>
                    <econdition field-name="atOrg" from="_mcaOrg" ignore-if-empty="true"/>
                </econditions>
            </econditions>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Statutory Voucher Edit Log (MCA Mandate)"/><box-body>
            <label text="As per MCA guidelines, this audit trail is non-disableable and records all modifications to financial vouchers." type="p" style="text-warning text-weight-bold q-mb-md"/>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search MCA Audit Log..." style="display:none"></span>]]></text></render-mode>
            <form-list name="McaAuditLogForm" list="auditLogList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <row-actions>
                    <!-- Resolve User Name -->
                    <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAcct">
                        <field-map field-name="userId" from="changedByUserId"/>
                    </entity-find-one>
                    <set field="displayUser" from="userAcct?.username ?: (changedByUserId ?: 'System / API')"/>
                    
                    <!-- Clean Entity Name -->
                    <set field="cleanEntity" from="changedEntityName.substring(changedEntityName.lastIndexOf('.') + 1)"/>
                    
                    <!-- Clean Field Name -->
                    <set field="cleanField" from="changedFieldName == 'statusId' ? 'Status' : (changedFieldName == 'invoiceTotal' ? 'Total Amount' : changedFieldName)"/>
                    
                    <!-- Clean Values -->
                    <set field="cleanNewValue" from="newValueText?.startsWith('Invoice') ? newValueText.replace('Invoice', '').toUpperCase() : newValueText"/>
                    <set field="cleanOldValue" from="oldValueText ? (oldValueText.startsWith('Invoice') ? oldValueText.replace('Invoice', '').toUpperCase() : oldValueText) : '(Initial Record)'"/>
                </row-actions>

                <field name="changedDate">
                    <header-field title="Timestamp" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd HH:mm:ss"/></default-field>
                </field>
                <field name="changedByUserId">
                    <header-field title="User" show-order-by="true">
                        <drop-down allow-empty="true">
                            <entity-options key="${userId}" text="${username}">
                                <entity-find entity-name="moqui.security.UserAccount">
                                    <order-by field-name="username"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${displayUser}" style="${!changedByUserId ? 'text-grey-7' : 'text-strong'}"/></default-field>
                </field>
                <field name="changedEntityName">
                    <header-field title="Entity">
                        <drop-down allow-empty="true">
                            <option key="mantle.account.invoice.Invoice" text="Invoice"/>
                            <option key="mantle.account.payment.Payment" text="Payment"/>
                            <option key="mantle.ledger.transaction.AcctgTrans" text="GL Transaction"/>
                            <option key="mantle.ledger.transaction.AcctgTransEntry" text="GL Transaction Entry"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${cleanEntity}"/></default-field>
                </field>
                <field name="pkPrimaryValue">
                    <header-field title="Voucher ID"><text-find/></header-field>
                    <default-field><display style="text-indigo-8 text-weight-bold"/></default-field>
                </field>
                <field name="changedFieldName">
                    <header-field title="Field"><text-find/></header-field>
                    <default-field><display text="${cleanField}"/></default-field>
                </field>
                <field name="oldValueText">
                    <header-field title="Old Value"><text-find/></header-field>
                    <default-field><display text="${cleanOldValue}" style="${!oldValueText ? 'text-grey-6 text-italic' : 'text-danger'}"/></default-field>
                </field>
                <field name="newValueText">
                    <header-field title="New Value"><text-find/></header-field>
                    <default-field><display text="${cleanNewValue}" style="text-success text-weight-bold"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
