<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- UK-specific Party fields -->
    <extend-entity entity-name="Party" package="mantle.party">
        <field name="vatRegistrationNumber" type="text-short"><description>UK VAT Number</description></field>
        <field name="companyRegistrationNumber" type="text-short"><description>Companies House number</description></field>
        <field name="utrNumber" type="text-short"><description>Unique Taxpayer Reference</description></field>
    </extend-entity>

    <!-- UK-specific Employee fields -->
    <extend-entity entity-name="Employee" package="zenith.erp.hr">
        <field name="niNumber" type="text-short"><description>National Insurance Number</description></field>
        <field name="taxCode" type="text-short"><description>HMRC Tax Code</description></field>
        <field name="pensionOptOut" type="text-indicator"><description>Opted out of auto-enrolment</description></field>
        <field name="studentLoanPlan" type="text-short"><description>Student loan repayment plan (1/2/4/PG)</description></field>
    </extend-entity>

    <!-- VAT Return (Making Tax Digital) -->
    <entity entity-name="VatReturn" package="zenith.erp.uk" short-alias="VatReturn">
        <field name="vatReturnId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="box1VatDueSales" type="currency-amount" default="0"><description>VAT due on sales</description></field>
        <field name="box2VatDueAcquisitions" type="currency-amount" default="0"><description>VAT due on EU acquisitions</description></field>
        <field name="box3TotalVatDue" type="currency-amount" default="0"/>
        <field name="box4VatReclaimedInput" type="currency-amount" default="0"/>
        <field name="box5NetVatDue" type="currency-amount" default="0"/>
        <field name="box6TotalSalesExVat" type="currency-amount" default="0"/>
        <field name="box7TotalPurchasesExVat" type="currency-amount" default="0"/>
        <field name="box8TotalSuppliesExVat" type="currency-amount" default="0"/>
        <field name="box9TotalAcquisitionsExVat" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <field name="hmrcSubmissionId" type="text-medium"/>
        <field name="submittedDate" type="date-time"/>
        <field name="filingDeadline" type="date"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="VatReturn" description="UK VAT Return Status"/>
            <moqui.basic.StatusItem statusId="VrDraft" statusTypeId="VatReturn" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="VrCalculated" statusTypeId="VatReturn" description="Calculated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="VrSubmitted" statusTypeId="VatReturn" description="Submitted to HMRC" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="VrAccepted" statusTypeId="VatReturn" description="Accepted" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VrDraft" toStatusId="VrCalculated" transitionName="Calculate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VrCalculated" toStatusId="VrSubmitted" transitionName="Submit to HMRC"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="VrSubmitted" toStatusId="VrAccepted" transitionName="Accepted"/>
        </seed-data>
    </entity>

    <!-- MTD (Making Tax Digital) Submission Log -->
    <entity entity-name="MtdSubmission" package="zenith.erp.uk" short-alias="MtdSubmission">
        <field name="submissionId" type="id" is-pk="true"/>
        <field name="vatReturnId" type="id"/>
        <field name="submissionType" type="text-short"/>
        <field name="hmrcCorrelationId" type="text-medium"/>
        <field name="requestPayload" type="text-very-long"/>
        <field name="responsePayload" type="text-very-long"/>
        <field name="httpStatus" type="number-integer"/>
        <field name="submittedDate" type="date-time"/>
        <field name="isSuccess" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.uk.VatReturn" short-alias="vatReturn"/>
    </entity>

    <!-- UK VAT Rate Configuration -->
    <entity entity-name="UkVatRate" package="zenith.erp.uk" short-alias="UkVatRate">
        <field name="ukVatRateId" type="id" is-pk="true"/>
        <field name="vatRateTypeEnumId" type="id"/>
        <field name="rate" type="number-decimal"/>
        <field name="effectiveDate" type="date"/>
        <field name="expirationDate" type="date"/>
        <field name="description" type="text-medium"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="UkVatRateType" description="UK VAT Rate Type"/>
            <moqui.basic.Enumeration enumId="UkVatStandard" enumTypeId="UkVatRateType" description="Standard Rate" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="UkVatReduced" enumTypeId="UkVatRateType" description="Reduced Rate" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="UkVatZero" enumTypeId="UkVatRateType" description="Zero Rate" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="UkVatExempt" enumTypeId="UkVatRateType" description="Exempt" sequenceNum="4"/>

            <!-- Default UK VAT rates -->
            <zenith.erp.uk.UkVatRate ukVatRateId="UK_STD_20" vatRateTypeEnumId="UkVatStandard" rate="20" effectiveDate="2011-01-04" description="Standard 20%"/>
            <zenith.erp.uk.UkVatRate ukVatRateId="UK_RED_5" vatRateTypeEnumId="UkVatReduced" rate="5" effectiveDate="2011-01-04" description="Reduced 5%"/>
            <zenith.erp.uk.UkVatRate ukVatRateId="UK_ZERO" vatRateTypeEnumId="UkVatZero" rate="0" effectiveDate="2011-01-04" description="Zero rated"/>
        </seed-data>
    </entity>

</entities>
