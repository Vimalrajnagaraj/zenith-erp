<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <!-- UK Country Configuration -->
    <zenith.erp.base.CountryConfiguration countryGeoId="GBR" countryName="United Kingdom"
            fiscalYearStartMonth="4" dateFormat="dd/MM/yyyy" numberFormat="###,###.##"
            defaultCurrencyUomId="GBP" taxSystemType="VAT"
            amountToWordsService="zenith.uk.UkServices.convert#AmountToWords"/>

    <!-- UK Regions -->
    <zenith.erp.base.RegionConfiguration regionGeoId="GBR_ENG" countryGeoId="GBR" regionName="England" regionCode="ENG" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="GBR_SCT" countryGeoId="GBR" regionName="Scotland" regionCode="SCT" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="GBR_WLS" countryGeoId="GBR" regionName="Wales" regionCode="WLS" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="GBR_NIR" countryGeoId="GBR" regionName="Northern Ireland" regionCode="NIR" hasTaxJurisdiction="Y"/>

    <!-- Party Identification Types for UK -->
    <moqui.basic.EnumerationType enumTypeId="PartyIdentificationType" description="Party Identification Type"/>
    <moqui.basic.Enumeration enumId="PtidVatReg" enumTypeId="PartyIdentificationType" description="VAT Registration Number"/>
    <moqui.basic.Enumeration enumId="PtidCompanyReg" enumTypeId="PartyIdentificationType" description="Company Registration Number"/>
    <moqui.basic.Enumeration enumId="PtidUtr" enumTypeId="PartyIdentificationType" description="Unique Taxpayer Reference"/>
    <moqui.basic.Enumeration enumId="PtidNino" enumTypeId="PartyIdentificationType" description="National Insurance Number"/>
</entity-facade-xml>
