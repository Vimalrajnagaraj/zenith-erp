<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Stores" default-menu-index="1">

    <transition name="editStore"><default-response url="../EditStore"/></transition>
    <transition name="createStore">
        <service-call name="zenith.stores.StoreServices.create#Store"/>
        <default-response url="../EditStore"/>
    </transition>

    <actions>
        <!-- ZE-SHOP: adopt any org retail-store facility (e.g. the onboarding Main Store) that lacks a Store row. -->
        <service-call name="zenith.stores.StoreServices.reconcile#OrgShops"/>
        <set field="curOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>

        <entity-find entity-name="zenith.erp.stores.StoreDetail" list="stores">
            <search-form-inputs default-order-by="storeName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="organizationPartyId" from="curOrg" ignore-if-empty="true"/>
        </entity-find>

        <!-- Stat cards: whole-org counts (NOT just the current page), org-scoped. -->
        <entity-find entity-name="zenith.erp.stores.Store" list="_allStores">
            <econdition field-name="organizationPartyId" from="curOrg" ignore-if-empty="true"/>
            <select-field field-name="city"/><select-field field-name="managerPartyId"/><select-field field-name="statusId"/>
        </entity-find>

        <script><![CDATA[
            totalStores = (_allStores ?: []).size()
            activeStores = (_allStores ?: []).count { it.statusId == 'StActive' }
            citiesCovered = (_allStores ?: []).collect { it.city }.findAll { it }.unique().size()
            managersCount = (_allStores ?: []).collect { it.managerPartyId }.findAll { it }.unique().size()
            typeMap = ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId','StoreType').list().collectEntries { [(it.enumId): it.description] }
            statusMap = ec.entity.find('moqui.basic.StatusItem').condition('statusTypeId','Store').list().collectEntries { [(it.statusId): it.description] }
        ]]></script>
    </actions>

    <widgets>
        <!-- ===== Header: title + subtitle + violet New Store ===== -->
        <container style="pb-head">
            <container style="pb-head-text">
                <label text="Stores" type="h4" style="pb-head-title"/>
                <label text="Manage and monitor all company stores and their details." type="p" style="pb-head-sub"/>
            </container>
            <container style="pb-head-actions">
                <container style="pb-ctaP">
                <container-dialog id="CreateStore" button-text="New Store" type="primary">
                    <form-single name="CreateStoreForm" transition="createStore">
                        <field name="storeName"><default-field title="Store Name"><text-line size="25"/></default-field></field>
                        <field name="storeTypeEnumId"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="StoreType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <!-- ZE-SHOP: a new shop auto-creates its own retail-store facility (create#Store), so no facility
                             picker here — keeps Store<->Facility strictly 1:1. Re-link on Edit if ever needed. -->
                        <field name="city"><default-field><text-line size="20"/></default-field></field>
                        <field name="phone"><default-field><text-line size="15"/></default-field></field>
                        <field name="areaSqFt"><default-field title="Area (sq ft)"><text-line size="10"/></default-field></field>
                        <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </container>
            </container>
        </container>

        <!-- ===== Stat cards (real, org-scoped) ===== -->
        <render-mode><text type="html,qvt"><![CDATA[
            <div style="display:flex;flex-wrap:wrap;gap:16px;margin-bottom:20px">
                <div style="flex:1 1 210px;min-width:200px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(124,58,237,.12)"><span class="material-icons" style="font-size:24px;color:#7C3AED">store</span></div>
                    <div style="min-width:0"><div style="font-size:12.5px;font-weight:600;color:var(--z-text-main,#111827)">Total Stores</div><div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${totalStores}</div><div style="font-size:12px;color:var(--z-text-muted,#6B7280)">All registered stores</div></div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(16,185,129,.15)"><span class="material-icons" style="font-size:24px;color:#0E9F6E">apartment</span></div>
                    <div style="min-width:0"><div style="font-size:12.5px;font-weight:600;color:var(--z-text-main,#111827)">Active Stores</div><div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${activeStores}</div><div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Currently active</div></div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(217,119,6,.14)"><span class="material-icons" style="font-size:24px;color:#B45309">place</span></div>
                    <div style="min-width:0"><div style="font-size:12.5px;font-weight:600;color:var(--z-text-main,#111827)">Cities Covered</div><div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${citiesCovered}</div><div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Unique locations</div></div>
                </div>
                <div style="flex:1 1 210px;min-width:200px;background:var(--z-bg-card,#fff);border:1px solid var(--z-border,#E5E7EB);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:16px">
                    <div style="width:48px;height:48px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(37,99,235,.12)"><span class="material-icons" style="font-size:24px;color:#2563EB">person</span></div>
                    <div style="min-width:0"><div style="font-size:12.5px;font-weight:600;color:var(--z-text-main,#111827)">Managers</div><div style="font-size:26px;font-weight:700;line-height:1.15;color:var(--z-text-main,#111827)">${managersCount}</div><div style="font-size:12px;color:var(--z-text-muted,#6B7280)">Store managers</div></div>
                </div>
            </div>
        ]]></text></render-mode>

        <!-- ===== Table (native form-list + z-listchrome toolbar/footer) ===== -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search stores..." style="display:none"></span>]]></text></render-mode>
            <form-list name="StoresForm" list="stores" list-entry="st" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <row-actions><script><![CDATA[
                    def _t = st.storeTypeEnumId
                    typeLabel = (typeMap[_t] ?: _t ?: '—')
                    typeBadge = (_t == 'StOwned') ? 'info' : ((_t == 'StFranchise') ? 'success' : ((_t == 'StPopUp') ? 'warning' : ((_t == 'StKiosk') ? 'primary' : 'grey')))
                    statusLabel = (statusMap[st.statusId] ?: st.statusId ?: '—')
                    statusBadge = (st.statusId == 'StActive') ? 'success' : ((st.statusId == 'StInactive') ? 'grey' : 'warning')
                    mgr = (((st.managerFirstName ?: '') + ' ' + (st.managerLastName ?: '')).trim()) ?: '—'
                ]]></script></row-actions>
                <field name="storeCode"><header-field title="Code"/>
                    <default-field title="Code"><label text="${st.storeCode ?: '—'}" type="span" style="text-dark text-weight-medium"/></default-field></field>
                <field name="storeName"><header-field title="Store" show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Store">
                        <link url="editStore" text="${st.storeName}" parameter-map="[storeId:st.storeId]" style="z-dklink"/>
                    </default-field></field>
                <field name="storeTypeEnumId"><header-field title="Type">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="StoreType"/>
                        </entity-find>
                    </entity-options></drop-down></header-field>
                    <default-field title="Type"><label text="${typeLabel}" type="span" style="zenith-badge nd ${typeBadge}"/></default-field></field>
                <field name="city"><header-field title="City"/>
                    <default-field title="City"><label text="${st.city ?: '—'}" type="span" style="text-grey-7"/></default-field></field>
                <field name="facilityName"><header-field title="Facility"/>
                    <default-field title="Facility"><label text="${st.facilityName ?: '—'}" type="span" style="text-grey-7"/></default-field></field>
                <field name="managerFirstName"><header-field title="Manager"/>
                    <default-field title="Manager"><label text="${mgr}" type="span" style="text-grey-7"/></default-field></field>
                <field name="statusId"><header-field title="Status" show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="StActive" text="Active"/><option key="StInactive" text="Inactive"/>
                        <option key="StRenovation" text="Under Renovation"/><option key="StClosed" text="Permanently Closed"/>
                    </drop-down></header-field>
                    <default-field title="Status"><label text="${statusLabel}" type="span" style="zenith-badge ${statusBadge} z-stbadge"/></default-field></field>
                <field name="actionCol"><default-field title="Actions">
                    <link url="editStore" text="⋮" parameter-map="[storeId:st.storeId]" style="z-kebab"/>
                </default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
