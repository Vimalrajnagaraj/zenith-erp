<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Store" default-menu-include="false">

    <parameter name="storeId" required="true"/>

    <transition name="updateStore">
        <service-call name="zenith.stores.StoreServices.update#Store"/>
        <default-response url="."/>
    </transition>
    <transition name="setHours">
        <service-call name="zenith.stores.StoreServices.set#OperatingHours"/>
        <default-response url="."/>
    </transition>
    <transition name="setTarget">
        <service-call name="zenith.stores.StoreServices.set#StoreTarget"/>
        <default-response url="."/>
    </transition>
    <transition name="addHoliday">
        <service-call name="create#zenith.erp.stores.StoreHoliday"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.stores.Store" value-field="store"/>
        <entity-find entity-name="zenith.erp.stores.StoreOperatingHours" list="hours">
            <econdition field-name="storeId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.stores.StoreTarget" list="targets">
            <econdition field-name="storeId"/>
            <order-by field-name="-periodStart"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.stores.StoreHoliday" list="holidays">
            <econdition field-name="storeId"/>
            <order-by field-name="holidayDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Store: ${store.storeName}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Store Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="StoreForm" map="store" transition="updateStore">
                        <field name="storeId"><default-field><hidden/></default-field></field>
                        <field name="storeName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="storeCode"><default-field title="Code"><display/></default-field></field>
                        <field name="storeTypeEnumId"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="StoreType"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="facilityId"><default-field title="Facility">
                            <drop-down allow-empty="true"><entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="managerPartyId"><default-field title="Manager">
                            <drop-down allow-empty="true"><entity-options key="${partyId}" text="${firstName} ${lastName}">
                                <entity-find entity-name="mantle.party.PersonAndUserAccount"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="address"><default-field><text-area rows="2" cols="40"/></default-field></field>
                        <field name="city"><default-field><text-line size="20"/></default-field></field>
                        <field name="phone"><default-field><text-line size="15"/></default-field></field>
                        <field name="email"><default-field><text-line size="25"/></default-field></field>
                        <field name="areaSqFt"><default-field title="Area (sq ft)"><text-line size="10"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <entity-options key="${toStatusId}" text="${transitionName}">
                                    <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                        <econdition field-name="statusFlowId" value="Default"/>
                                        <econdition field-name="statusId" from="store.statusId"/>
                                    </entity-find>
                                </entity-options>
                                <option key="${store.statusId}" text="${store.statusId}"/>
                            </drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <!-- Operating Hours -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Operating Hours" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="HoursForm" list="hours" transition="setHours">
                        <field name="storeId"><default-field><hidden/></default-field></field>
                        <field name="dayOfWeek"><default-field title="Day"><display/></default-field></field>
                        <field name="openTime"><default-field title="Open"><text-line size="8"/></default-field></field>
                        <field name="closeTime"><default-field title="Close"><text-line size="8"/></default-field></field>
                        <field name="isClosed"><default-field title="Closed?">
                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Save"><submit/></default-field></field>
                    </form-list>
                </container>

                <!-- Targets -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Targets" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="SetTarget" button-text="Set Target" type="success">
                            <form-single name="SetTargetForm" transition="setTarget">
                                <field name="storeId" from="store.storeId"><default-field><hidden/></default-field></field>
                                <field name="targetPeriodEnumId"><default-field title="Period">
                                    <drop-down><entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="TargetPeriod"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="periodStart"><default-field><date-time type="date"/></default-field></field>
                                <field name="periodEnd"><default-field><date-time type="date"/></default-field></field>
                                <field name="salesTarget"><default-field title="Sales Target"><text-line size="12"/></default-field></field>
                                <field name="transactionTarget"><default-field title="Txn Target"><text-line size="8"/></default-field></field>
                                <field name="submitBtn"><default-field title="Set"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="TargetsForm" list="targets" skip-form="true">
                        <field name="targetPeriodEnumId"><default-field title="Period">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="periodStart"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="periodEnd"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="salesTarget"><default-field title="Target"><display format="#,##0"/></default-field></field>
                        <field name="actualSales"><default-field title="Actual"><display format="#,##0"/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${store.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Area" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${store.areaSqFt ?: 'N/A'} sq ft" type="h5" style="text-dark text-weight-bold q-my-sm"/>
                </container>

                <!-- Holidays -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Holidays" type="h6" style="text-weight-bold q-my-none"/>
                        <container-dialog id="AddHoliday" button-text="Add" type="info">
                            <form-single name="AddHolidayForm" transition="addHoliday">
                                <field name="storeId" from="store.storeId"><default-field><hidden/></default-field></field>
                                <field name="holidayDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                                <field name="description"><default-field><text-line size="20"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="HolidaysForm" list="holidays" skip-form="true">
                        <field name="holidayDate"><default-field title="Date"><display format="dd-MMM"/></default-field></field>
                        <field name="description"><default-field title="Reason"><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
