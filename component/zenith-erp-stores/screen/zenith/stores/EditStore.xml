<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Store" default-menu-include="false">

    <parameter name="storeId" required="true"/>

    <transition name="updateStore" method="post">
        <service-call name="zenith.stores.StoreServices.update#Store"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>
    <transition name="setTarget" method="post">
        <service-call name="zenith.stores.StoreServices.set#StoreTarget"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>
    <transition name="addHoliday" method="post">
        <service-call name="zenith.stores.StoreServices.add#StoreHoliday"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>
    <transition name="assignCounter" method="post">
        <service-call name="zenith.stores.StoreServices.assign#ShopCounter"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>

    <transition name="saveStoreProfile" method="post">
        <service-call name="zenith.stores.StoreServices.save#StoreProfile"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>

    <transition name="deleteStore" method="post">
        <service-call name="zenith.stores.StoreServices.delete#Store"/>
        <default-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/FindStore" url-type="plain"/>
        <error-response url="${ec.web.getRequest().getRequestURI().split('/zenith/')[0]}/zenith/Stores/EditStore?storeId=${java.net.URLEncoder.encode(storeId,'UTF-8')}" url-type="plain"/>
    </transition>

    <actions>
        <service-call name="zenith.base.SecurityServices.check#ModuleWriteAccess" in-map="[moduleId:'stores']" out-map="shopPermission"/>
        <set field="shopCanWrite" from="shopPermission.canWrite"/>
        <!-- ZE-SB-013 (Tier 4): block rendering another org's store detail (cross-tenant read IDOR). -->
        <service-call name="zenith.stores.StoreAccessServices.assert#StoreAccess" out-map="_ca"
                      in-map="[storeId:storeId]"/>
        <if condition="!_ca.allowed">
            <script>ec.message.clearErrors()
                    def _sh = (ec.web.getRequest()?.getRequestURI() ?: '').startsWith('/qapps/') ? '/qapps' : '/apps'
                    sri.sendRedirectAndStopRender(_sh + "/zenith/Stores/FindStore")</script>
            <return/>
        </if>
        <entity-find-one entity-name="zenith.erp.stores.Store" value-field="store"/>
        <entity-find entity-name="zenith.erp.stores.StoreOperatingHours" list="hours">
            <econdition field-name="storeId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.stores.StoreTarget" list="targets">
            <econdition field-name="storeId"/>
            <order-by field-name="-periodStart"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.stores.StoreHoliday" list="holidays">
            <econdition field-name="storeId"/>
            <order-by field-name="holidayDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.pos.PosTerminal" list="orgTerminals">
            <econdition field-name="organizationPartyId" from="store.organizationPartyId"/>
            <order-by field-name="terminalName"/>
        </entity-find>

        <script><![CDATA[
            def _enumDesc = { id -> id ? (ec.entity.find('moqui.basic.Enumeration').condition('enumId', id).useCache(true).one()?.description ?: id) : null }
            def _facName = { id -> id ? (ec.entity.find('mantle.facility.Facility').condition('facilityId', id).condition('ownerPartyId',store.organizationPartyId).one()?.facilityName ?: id) : null }

            def _uri = (ec.web?.request?.requestURI ?: ''); def _zi = _uri.indexOf('/zenith/')
            appBase = (_zi > 0) ? _uri.substring(0, _zi) : ''
            moquiToken = (ec.web != null) ? (ec.web.sessionToken ?: '') : ''

            // avatar initials
            def _nm = ((store.storeName ?: 'Store') as String).trim()
            def _parts = _nm.split(/\s+/).findAll { it }
            avatarInit = ((_parts.size() >= 2) ? ('' + _parts[0].charAt(0) + _parts[1].charAt(0)) : (_nm.length() >= 2 ? _nm.substring(0,2) : (_nm ?: 'S'))).toUpperCase()

            storeTypeLabel = _enumDesc(store.storeTypeEnumId) ?: '—'
            facilityName = _facName(store.facilityId) ?: ''
            statusLabel = store.statusId ? (ec.entity.find('moqui.basic.StatusItem').condition('statusId', store.statusId).useCache(true).one()?.description ?: store.statusId) : '—'
            isActiveStore = (store.statusId == 'StActive')
            areaStr = (store.areaSqFt != null) ? (store.areaSqFt.stripTrailingZeros().toPlainString()) : null

            // counters
            totalCounters = (orgTerminals ?: []).count {it.facilityId == store.facilityId}
            assignedHere = 0; (orgTerminals ?: []).each { if (it.facilityId == store.facilityId) assignedHere++ }

            // option lists
            storeTypeOptions = ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId','StoreType').orderBy('sequenceNum').list().collect { [id: it.enumId, label: it.description] }
            def _org = store.organizationPartyId
            def _facFind = ec.entity.find('mantle.facility.Facility').condition('facilityTypeEnumId','FcTpRetailStore')
            _facFind.condition('ownerPartyId', _org)
            facilityOptions = _facFind.orderBy('facilityName').list().collect { [id: it.facilityId, label: it.facilityName] }
            def managerIds = ec.entity.find('mantle.party.Party').condition('ownerPartyId',_org).disableAuthz().list().collect {it.partyId}
            managerIds.addAll(ec.entity.find('zenith.erp.hr.Employee').condition('organizationPartyId',_org).disableAuthz().list().collect {it.partyId})
            managerOptions = ec.entity.find('mantle.party.PersonAndUserAccount').condition('partyId','in',managerIds ?: ['__NONE__']).orderBy('firstName').list().collect { [id: it.partyId, label: (((it.firstName ?: '') + ' ' + (it.lastName ?: '')).trim() ?: it.partyId)] }
            // status: current + reachable (status flow) so we never offer an invalid transition
            statusOptions = [[id: store.statusId, label: statusLabel]]
            ec.entity.find('moqui.basic.StatusFlowTransition').condition('statusFlowId','Default').condition('statusId', store.statusId).list().each { tr ->
                statusOptions.add([id: tr.toStatusId, label: (ec.entity.find('moqui.basic.StatusItem').condition('statusId', tr.toStatusId).useCache(true).one()?.description ?: tr.toStatusId)])
            }
            targetPeriodOptions = ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId','TargetPeriod').orderBy('sequenceNum').list().collect { [id: it.enumId, label: it.description] }

            // counter rows
            counterRows = (orgTerminals ?: []).collect { t -> [id: t.terminalId, name: (t.terminalName ?: t.terminalId), facName: (_facName(t.facilityId) ?: '—'), here: (t.facilityId == store.facilityId)] }

            // operating hours by day (Mon..Sun)
            def _hmap = [:]; (hours ?: []).each { _hmap[it.dayOfWeek] = it }
            def _dayName = [Mon:'Monday', Tue:'Tuesday', Wed:'Wednesday', Thu:'Thursday', Fri:'Friday', Sat:'Saturday', Sun:'Sunday']
            hoursRows = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].collect { d -> def h=_hmap[d]; [day:d, name:_dayName[d], open:(h?.openTime ?: ''), close:(h?.closeTime ?: ''), closed:(h?.isClosed == 'Y')] }

            // targets with progress
            targetRows = (targets ?: []).collect { t ->
                def tgt = (t.salesTarget ?: 0) as BigDecimal
                def act = (t.actualSales ?: 0) as BigDecimal
                def pct = (tgt > 0) ? Math.min(100, (act * 100 / tgt).setScale(0, java.math.RoundingMode.HALF_UP).intValue()) : 0
                [period: (_enumDesc(t.targetPeriodEnumId) ?: ''),
                 from: (t.periodStart != null ? ec.l10n.format(t.periodStart,'dd MMM yyyy') : ''),
                 thru: (t.periodEnd != null ? ec.l10n.format(t.periodEnd,'dd MMM yyyy') : ''),
                 tgt: ec.l10n.format(tgt,'#,##0.00'), act: ec.l10n.format(act,'#,##0.00'), pct: pct]
            }
            // holidays
            holidayRows = (holidays ?: []).collect { h ->
                [day: (h.holidayDate != null ? ec.l10n.format(h.holidayDate,'dd') : '?'),
                 mon: (h.holidayDate != null ? ec.l10n.format(h.holidayDate,'MMM').toUpperCase() : ''),
                 reason: (h.description ?: '—')]
            }
        ]]></script>
    </actions>

    <widgets>
        <container style="zc-shops-page">
        <render-mode><text type="html,qvt" template="true"><![CDATA[
        <#assign fLbl="display:block;font-size:12px;font-weight:500;text-transform:uppercase;letter-spacing:.04em;color:#9CA3AF;margin-bottom:4px">
        <#assign fInp="width:100%;box-sizing:border-box;height:42px;padding:0 12px;border:1px solid #E5E7EB;border-radius:8px;font-size:14px;font-weight:500;color:#111827;background:#F8F9FC;outline:none">
        <#assign secTitle="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:#111827;padding-bottom:8px;border-bottom:1px solid #EEF0F4;margin:0 0 16px">
        <#assign tabBtn="padding:14px 20px;font-size:13px;font-weight:600;background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap">
        <#assign btnPri="display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 16px;background:#7C3AED;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none">
        <#assign btnOut="display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 16px;background:#fff;color:#374151;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none">
        <#assign statCard="flex:1 1 200px;min-width:180px;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:16px 20px;box-shadow:0 1px 2px rgba(0,0,0,.04)">
        <input id="st-token" type="hidden" value="${(moquiToken!'')?html}"/>
        <span data-shop-can-write="${shopCanWrite?string('true','false')}" hidden></span>
        <input id="st-id" type="hidden" value="${store.storeId?html}"/>

        <!-- breadcrumb -->
        <div style="font-size:13px;color:#9CA3AF;margin-bottom:16px">
            <a href="${appBase}/zenith/Stores/FindStore" style="color:#7C3AED;font-weight:500;text-decoration:none">Shops</a>
            <span style="margin:0 6px">/</span>
            <a href="${appBase}/zenith/Stores/FindStore" style="color:#7C3AED;font-weight:500;text-decoration:none">All Stores</a>
            <span style="margin:0 6px">/</span>
            <span style="color:#111827;font-weight:500">${(store.storeName!'Store')?html}</span>
        </div>

        <!-- store header -->
        <div style="background:#fff;border:1px solid #E5E7EB;border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,.04);display:flex;align-items:center;gap:18px;padding:24px 28px;margin-bottom:20px;flex-wrap:wrap">
            <div style="width:64px;height:64px;flex:0 0 auto;border-radius:16px;background:linear-gradient(135deg,#7C3AED,#6D28D9);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700">${(avatarInit)?html}</div>
            <div style="flex:1;min-width:200px">
                <div style="font-size:22px;font-weight:700;color:#111827;line-height:1.3">${(store.storeName!'Store')?html}</div>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:6px;font-size:13px;color:#6B7280">
                    <span>Code: ${(store.storeCode!'—')?html}</span>
                    <span style="color:#E5E7EB">|</span>
                    <span>${(storeTypeLabel)?html}</span>
                    <#if isActiveStore><span style="padding:2px 10px;border-radius:99px;font-size:11px;font-weight:600;letter-spacing:.02em;background:#ECFDF5;color:#059669">Active</span>
                    <#else><span style="padding:2px 10px;border-radius:99px;font-size:11px;font-weight:600;letter-spacing:.02em;background:#F3F4F6;color:#6B7280">${(statusLabel)?html}</span></#if>
                    <span style="padding:2px 10px;border-radius:99px;font-size:11px;font-weight:600;letter-spacing:.02em;background:#EDE9FE;color:#7C3AED">${totalCounters} Counter${(totalCounters == 1)?string('','s')}</span>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <a href="${appBase}/zenith/pos/Terminal" style="${btnOut}"><span class="material-icons" style="font-size:17px">point_of_sale</span>Open POS</a>
                <button type="button" onclick="window.stSave()" style="${btnPri}"><span class="material-icons" style="font-size:17px">check</span>Save Store</button>

            </div>
        </div>

        <!-- quick stats -->
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px">
            <div style="${statCard}"><div style="${fLbl}">Status</div><div style="font-size:22px;font-weight:700;color:${isActiveStore?string('#10B981','#6B7280')}">${(statusLabel)?html}</div><div style="font-size:12px;color:#6B7280">${(storeTypeLabel)?html}</div></div>
            <div style="${statCard}"><div style="${fLbl}">POS Counters</div><div style="font-size:22px;font-weight:700;color:#7C3AED">${totalCounters}</div><div style="font-size:12px;color:#6B7280">${assignedHere} assigned here</div></div>
            <div style="${statCard}"><div style="${fLbl}">Area</div><div style="font-size:22px;font-weight:700;color:#9CA3AF"><#if areaStr??>${areaStr}<#else>N/A</#if></div><div style="font-size:12px;color:#6B7280"><#if areaStr??>sq ft<#else>sq ft not set</#if></div></div>
            <div style="${statCard}"><div style="${fLbl}">Facility</div><div style="font-size:16px;font-weight:700;color:#111827"><#if (facilityName?has_content)>${facilityName?html}<#else>Not linked</#if></div><div style="font-size:12px;color:#6B7280">Linked facility</div></div>
        </div>

        <!-- tabs -->
        <div style="background:#fff;border:1px solid #E5E7EB;border-bottom:none;border-radius:12px 12px 0 0;box-shadow:0 1px 2px rgba(0,0,0,.04)">
            <div style="display:flex;padding:0 24px;border-bottom:1px solid #E5E7EB;overflow-x:auto">
                <button type="button" id="tab-details" onclick="window.stTab('details')" style="${tabBtn};color:#7C3AED;border-bottom-color:#7C3AED">Store Details</button>
                <button type="button" id="tab-counters" onclick="window.stTab('counters')" style="${tabBtn};color:#6B7280">POS Counters</button>
                <button type="button" id="tab-hours" onclick="window.stTab('hours')" style="${tabBtn};color:#6B7280">Operating Hours</button>
                <button type="button" id="tab-targets" onclick="window.stTab('targets')" style="${tabBtn};color:#6B7280">Targets</button>
                <button type="button" id="tab-holidays" onclick="window.stTab('holidays')" style="${tabBtn};color:#6B7280">Holidays</button>
            </div>
        </div>
        <div style="background:#fff;border:1px solid #E5E7EB;border-top:none;border-radius:0 0 12px 12px;box-shadow:0 1px 2px rgba(0,0,0,.04);padding:28px">

            <!-- Store Details -->
            <div id="panel-details" style="display:block">
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">home</span>General Information</div>
                <div style="display:flex;flex-wrap:wrap;gap:16px 24px;margin-bottom:24px">
                    <div style="flex:1 1 280px"><label for="st-name" style="${fLbl}">Store Name</label><input id="st-name" required class="st-inp" type="text" value="${(store.storeName!'')?html}" style="${fInp}"/></div>
                    <div style="flex:1 1 280px"><span style="${fLbl}">Store Code</span><div style="${fInp};display:flex;align-items:center;font-family:'SF Mono',Consolas,monospace;letter-spacing:.04em">${(store.storeCode!'—')?html}</div></div>
                    <div style="flex:1 1 280px"><label for="st-type" style="${fLbl}">Store Type</label><select id="st-type" class="st-sel" style="${fInp}"><#list storeTypeOptions as o><option value="${(o.id)?html}"<#if o.id == (store.storeTypeEnumId!'')> selected</#if>>${(o.label)?html}</option></#list></select></div>
                    <div style="flex:1 1 280px"><label for="st-facility" style="${fLbl}">Facility</label><select id="st-facility" class="st-sel"<#if store.facilityId?has_content> disabled</#if> style="${fInp}"><option value="">Not linked</option><#list facilityOptions as o><option value="${(o.id)?html}"<#if o.id == (store.facilityId!'')> selected</#if>>${(o.label)?html}</option></#list></select></div>
                    <div style="flex:1 1 280px"><label for="st-manager" style="${fLbl}">Manager</label><select id="st-manager" class="st-sel" style="${fInp}"><option value="">Select Manager</option><#list managerOptions as o><option value="${(o.id)?html}"<#if o.id == (store.managerPartyId!'')> selected</#if>>${(o.label)?html}</option></#list></select></div>
                    <div style="flex:1 1 280px"><label for="st-status" style="${fLbl}">Status</label><select id="st-status" class="st-sel" style="${fInp}"><#list statusOptions as o><option value="${(o.id)?html}"<#if o.id == (store.statusId!'')> selected</#if>>${(o.label)?html}</option></#list></select></div>
                </div>
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">place</span>Location &amp; Contact</div>
                <div style="display:flex;flex-wrap:wrap;gap:16px 24px">
                    <div style="flex:1 1 100%"><label for="st-address" style="${fLbl}">Address</label><textarea id="st-address" class="st-ta" style="${fInp};height:auto;min-height:72px;padding:10px 12px;resize:vertical">${(store.address!'')?html}</textarea></div>
                    <div style="flex:1 1 220px"><label for="st-city" style="${fLbl}">City</label><input id="st-city" class="st-inp" type="text" value="${(store.city!'')?html}" style="${fInp}"/></div>
                    <div style="flex:1 1 220px"><label for="st-phone" style="${fLbl}">Phone</label><input id="st-phone" class="st-inp" type="tel" value="${(store.phone!'')?html}" style="${fInp}"/></div>
                    <div style="flex:1 1 220px"><label for="st-email" style="${fLbl}">Email</label><input id="st-email" class="st-inp" type="email" value="${(store.email!'')?html}" placeholder="store@example.com" style="${fInp}"/></div>
                    <div style="flex:1 1 220px"><label for="st-area" style="${fLbl}">Area (sq ft)</label><input id="st-area" class="st-inp" type="number" min="0" step="any" value="<#if areaStr??>${areaStr}</#if>" placeholder="Enter area" style="${fInp}"/></div>
                </div>
            </div>

            <!-- POS Counters -->
            <div id="panel-counters" style="display:none">
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">point_of_sale</span>POS Counter Assignments</div>
                <p style="font-size:13px;color:#6B7280;margin:0 0 16px">Assign POS counters to this store. Unused counters can be reassigned here. Counters with session history keep their original shop.</p>
                <div class="st-table-scroll"><table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead><tr style="text-align:left;color:#9CA3AF;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #E5E7EB">
                        <th style="padding:12px">Counter Name</th><th style="padding:12px">Current Assignment</th><th style="padding:12px;text-align:right;width:140px">Action</th>
                    </tr></thead>
                    <tbody>
                    <#list counterRows as c>
                        <tr style="border-bottom:1px solid #EEF0F4">
                            <td style="padding:12px;font-weight:600;color:#111827">${(c.name)?html}</td>
                            <td style="padding:12px"><span style="font-size:12px;<#if c.here>color:#059669;font-weight:600<#else>color:#6B7280</#if>">${(c.facName)?html}</span></td>
                            <td style="padding:12px;text-align:right">
                                <#if c.here><span style="display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:99px;font-size:12px;font-weight:600;background:#ECFDF5;color:#059669"><span class="material-icons" style="font-size:13px">check</span>Assigned</span>
                                <#else><button type="button" data-counter-id="${c.id?html}" onclick="window.stAssign(this.dataset.counterId)" style="padding:4px 12px;border-radius:99px;font-size:12px;font-weight:600;border:1px solid #E5E7EB;background:#fff;color:#6B7280;cursor:pointer">Assign Here</button></#if>
                            </td>
                        </tr>
                    </#list>
                    <#if !(counterRows?has_content)><tr><td colspan="3" style="padding:24px;text-align:center;color:#9CA3AF">No POS counters in this organization yet.</td></tr></#if>
                    </tbody>
                </table></div>
            </div>

            <!-- Operating Hours -->
            <div id="panel-hours" style="display:none">
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">schedule</span>Weekly Schedule</div>
                <p style="font-size:13px;color:#6B7280;margin:0 0 18px">Set regular operating hours for this store. Toggle &ldquo;Closed&rdquo; to mark non-working days, then click Save Store Profile.</p>
                <div class="st-hours-heading" style="display:grid;grid-template-columns:120px 1fr 1fr 80px;gap:10px;padding-bottom:6px;font-size:11px;font-weight:600;color:#9CA3AF;text-transform:uppercase;letter-spacing:.05em">
                    <div>Day</div><div>Open</div><div>Close</div><div>Closed?</div>
                </div>
                <#list hoursRows as h>
                <div class="st-hrow" data-day="${h.day}" style="display:grid;grid-template-columns:120px 1fr 1fr 80px;gap:10px;align-items:center;padding:7px 0;border-bottom:1px solid #EEF0F4">
                    <div style="font-size:13px;font-weight:600;color:#111827">${h.name}</div>
                    <input type="time" class="st-inp st-htime" aria-label="${h.name} opening time" value="${h.open?html}" <#if h.closed>disabled</#if> style="height:38px;padding:0 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;background:#F8F9FC;color:#111827;<#if h.closed>opacity:.5</#if>"/>
                    <input type="time" class="st-inp st-htime" aria-label="${h.name} closing time" value="${h.close?html}" <#if h.closed>disabled</#if> style="height:38px;padding:0 10px;border:1px solid #E5E7EB;border-radius:8px;font-size:13px;background:#F8F9FC;color:#111827;<#if h.closed>opacity:.5</#if>"/>
                    <button type="button" class="st-tgl${h.closed?string(' on','')}" role="switch" aria-label="${h.name} closed" aria-checked="${h.closed?string('true','false')}" onclick="window.stToggleDay(this)"></button>
                </div>
                </#list>
            </div>

            <!-- Targets -->
            <div id="panel-targets" style="display:none">
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">track_changes</span>Sales Targets</div>
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px">
                    <p style="font-size:13px;color:#6B7280;margin:0">Set periodic revenue targets and track actuals against them.</p>
                    <button type="button" onclick="document.getElementById('st-target-form').style.display='block'" style="${btnOut}"><span class="material-icons" style="font-size:16px">add</span>Set Target</button>
                </div>
                <div id="st-target-form" style="display:none;margin-bottom:22px">
                    <div style="border:1px dashed #7C3AED;background:#F8F9FC;border-radius:8px;padding:16px 20px">
                        <div style="display:flex;flex-wrap:wrap;gap:16px 24px;margin-bottom:12px">
                            <div style="flex:1 1 200px"><label for="tg-period" style="${fLbl}">Period</label><select id="tg-period" class="st-sel" style="${fInp}"><#list targetPeriodOptions as o><option value="${(o.id)?html}"<#if o.id=='TpMonthly'> selected</#if>>${(o.label)?html}</option></#list></select></div>
                            <div style="flex:1 1 200px"><label for="tg-from" style="${fLbl}">From Date</label><input id="tg-from" class="st-inp" type="date" style="${fInp}"/></div>
                            <div style="flex:1 1 200px"><label for="tg-to" style="${fLbl}">To Date</label><input id="tg-to" class="st-inp" type="date" style="${fInp}"/></div>
                            <div style="flex:1 1 200px"><label for="tg-amt" style="${fLbl}">Target Amount (&#8377;)</label><input id="tg-amt" class="st-inp" type="number" min="0" step="any" placeholder="e.g. 500000" style="${fInp}"/></div>
                        </div>
                        <div style="display:flex;gap:8px;justify-content:flex-end">
                            <button type="button" onclick="document.getElementById('st-target-form').style.display='none'" style="background:none;border:none;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer;padding:8px 12px">Cancel</button>
                            <button type="button" onclick="window.stAddTarget()" style="${btnPri}">Add Target</button>
                        </div>
                    </div>
                </div>
                <#if (targetRows?has_content)>
                    <#list targetRows as t>
                    <div style="border:1px solid #E5E7EB;border-radius:8px;padding:16px 20px;margin-bottom:12px">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><span style="font-size:14px;font-weight:600;color:#111827">${(t.period)?html}</span><span style="font-size:12px;color:#6B7280">${(t.from)?html} &#8212; ${(t.thru)?html}</span></div>
                        <div style="height:6px;border-radius:99px;background:#EEF0F4;overflow:hidden"><div style="height:100%;width:${t.pct}%;background:#7C3AED;border-radius:99px"></div></div>
                        <div style="display:flex;justify-content:space-between;margin-top:8px;font-size:12px;color:#6B7280"><span>&#8377; ${(t.act)?html} achieved</span><span>Target: &#8377; ${(t.tgt)?html} (${t.pct}%)</span></div>
                    </div>
                    </#list>
                <#else>
                    <div style="text-align:center;padding:40px 20px;color:#9CA3AF"><span class="material-icons" style="font-size:36px;opacity:.3">track_changes</span><div style="font-size:13px;margin-top:8px">No targets set yet</div><div style="font-size:12px;margin-top:4px">Click &ldquo;Set Target&rdquo; to define a sales target for this store.</div></div>
                </#if>
            </div>

            <!-- Holidays -->
            <div id="panel-holidays" style="display:none">
                <div style="${secTitle}"><span class="material-icons" style="font-size:18px;color:#7C3AED">event</span>Store Holidays</div>
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px">
                    <p style="font-size:13px;color:#6B7280;margin:0">Add specific dates when this store will be closed (besides the regular weekly schedule).</p>
                    <button type="button" onclick="document.getElementById('st-holiday-form').style.display='block'" style="${btnOut}"><span class="material-icons" style="font-size:16px">add</span>Add Holiday</button>
                </div>
                <div id="st-holiday-form" style="display:none;margin-bottom:22px">
                    <div style="border:1px dashed #7C3AED;background:#F8F9FC;border-radius:8px;padding:16px 20px">
                        <div style="display:flex;flex-wrap:wrap;gap:16px 24px;margin-bottom:12px">
                            <div style="flex:1 1 220px"><label for="hl-date" style="${fLbl}">Date</label><input id="hl-date" class="st-inp" type="date" style="${fInp}"/></div>
                            <div style="flex:1 1 220px"><label for="hl-reason" style="${fLbl}">Reason</label><input id="hl-reason" class="st-inp" type="text" placeholder="e.g. Pongal, Diwali" style="${fInp}"/></div>
                        </div>
                        <div style="display:flex;gap:8px;justify-content:flex-end">
                            <button type="button" onclick="document.getElementById('st-holiday-form').style.display='none'" style="background:none;border:none;color:#6B7280;font-size:13px;font-weight:600;cursor:pointer;padding:8px 12px">Cancel</button>
                            <button type="button" onclick="window.stAddHol()" style="${btnPri}">Add Holiday</button>
                        </div>
                    </div>
                </div>
                <#if (holidayRows?has_content)>
                    <#list holidayRows as h>
                    <div style="display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid #EEF0F4">
                        <div style="width:48px;height:48px;flex:0 0 auto;border-radius:8px;background:#EDE9FE;display:flex;flex-direction:column;align-items:center;justify-content:center"><span style="font-size:16px;font-weight:700;color:#7C3AED;line-height:1">${h.day}</span><span style="font-size:10px;font-weight:600;color:#7C3AED;text-transform:uppercase">${h.mon}</span></div>
                        <div style="font-size:13px;color:#111827">${(h.reason)?html}</div>
                    </div>
                    </#list>
                <#else>
                    <div style="text-align:center;padding:40px 20px;color:#9CA3AF"><span class="material-icons" style="font-size:36px;opacity:.3">event</span><div style="font-size:13px;margin-top:8px">No holidays added yet</div><div style="font-size:12px;margin-top:4px">Click &ldquo;Add Holiday&rdquo; to mark specific closure dates.</div></div>
                </#if>
            </div>

            <!-- save bar -->
            <div style="display:flex;align-items:center;gap:12px;padding:16px 0 0;margin-top:24px;border-top:1px solid #E5E7EB">
                <button type="button" onclick="window.stDelete()" style="background:none;border:none;color:#EF4444;font-size:13px;font-weight:600;cursor:pointer;padding:8px 14px;border-radius:8px">Delete Store</button>
                <div style="flex:1"></div>
                <a href="${appBase}/zenith/Stores/EditStore?storeId=${(store.storeId)?url('UTF-8')}" style="${btnOut}">Discard Changes</a>
                <button type="button" onclick="window.stSave()" style="${btnPri}">Save Store Profile</button>
            </div>
        </div>

        <img alt="" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" onload="if(window.zcShopsInit){window.zcShopsInit()}else{var s=document.createElement('script');s.src='/zenithstatic/js/shops.js?v=6';document.head.appendChild(s)}"/>
        ]]></text></render-mode>
            </container>
    </widgets>
</screen>
