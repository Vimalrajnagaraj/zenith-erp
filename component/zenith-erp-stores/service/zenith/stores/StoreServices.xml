<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="Store">
        <in-parameters>
            <parameter name="storeName" required="true"/>
            <parameter name="storeCode"/>
            <parameter name="storeTypeEnumId" required="true"/>
            <parameter name="facilityId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="managerPartyId"/>
            <parameter name="address"/>
            <parameter name="city"/>
            <parameter name="regionGeoId"/>
            <parameter name="countryGeoId"/>
            <parameter name="postalCode"/>
            <parameter name="phone"/>
            <parameter name="email"/>
            <parameter name="areaSqFt" type="BigDecimal"/>
            <parameter name="openDate" type="Date"/>
        </in-parameters>
        <out-parameters><parameter name="storeId"/></out-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): FORCE the owning org from the session — never trust a submitted
                 organizationPartyId (create#Store used to accept it as free input = cross-tenant stamp). -->
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="!organizationPartyId || organizationPartyId == '_NA_'">
                <return error="true" message="No active organization is selected. Switch into an organization first."/>
            </if>
            <!-- ZE-SB-013 (Tier 5): a store manager must be a member of this org. -->
            <if condition="managerPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ma" in-map="[partyId:managerPartyId]"/>
                <if condition="!_ma.allowed"><return error="true" message="That manager isn't part of your organization."/></if>
            </if>
            <if condition="!storeCode">
                <script><![CDATA[
                    def existing = ec.entity.find("zenith.erp.stores.Store").condition("organizationPartyId", organizationPartyId).count()
                    storeCode = "STR" + String.format("%04d", existing + 1)
                ]]></script>
            </if>
            <!-- ZE-SHOP: a shop IS a FcTpRetailStore facility (the POS/dashboards filter on it). Auto-create one when
                 none is linked; if a facility was chosen it MUST belong to this org (defense in depth). Keeps 1:1. -->
            <script><![CDATA[
                if (facilityId) {
                    boolean _dz = ec.artifactExecution.disableAuthz()
                    try {
                        def _pf = ec.entity.find("mantle.facility.Facility").condition("facilityId", facilityId).one()
                        if (_pf == null || _pf.ownerPartyId != organizationPartyId) { ec.message.addError("That facility isn't part of your organization."); return }
                    } finally { if (!_dz) ec.artifactExecution.enableAuthz() }
                } else {
                    def _fac = ec.service.sync().name("create#mantle.facility.Facility")
                        .parameters([facilityTypeEnumId:'FcTpRetailStore', facilityName:storeName, ownerPartyId:organizationPartyId]).call()
                    facilityId = _fac.facilityId
                }
            ]]></script>
            <service-call name="create#zenith.erp.stores.Store" out-map="context"
                          in-map="context + [organizationPartyId:organizationPartyId, statusId:'StActive']"/>
        </actions>
    </service>

    <!-- ZE-SHOP: adopt every FcTpRetailStore facility the org owns (e.g. the onboarding "Main Store") that has no
         Store row yet, so the Stores list == the shops the switcher/filters see. Idempotent, keyed on facilityId
         (1:1 Store<->Facility). Safe to call on every Stores list render. -->
    <service verb="reconcile" noun="OrgShops" authenticate="true">
        <actions>
            <script><![CDATA[
                def org = ec.user.getPreference("ACTIVE_ORGANIZATION")
                if (!org || org == '_NA_') return
                boolean _dz = ec.artifactExecution.disableAuthz()
                try {
                    def facs = ec.entity.find("mantle.facility.Facility")
                        .condition("ownerPartyId", org).condition("facilityTypeEnumId", "FcTpRetailStore").list()
                    def existing = ec.entity.find("zenith.erp.stores.Store").condition("organizationPartyId", org).list()
                    def haveFac = existing.collect { it.facilityId }.findAll { it } as Set
                    int _seq = existing.size()
                    facs.each { f ->
                        if (!haveFac.contains(f.facilityId)) {
                            _seq++
                            ec.service.sync().name("create#zenith.erp.stores.Store").parameters([
                                storeName: (f.facilityName ?: f.facilityId), storeCode: "STR" + String.format("%04d", _seq),
                                storeTypeEnumId: "StOwned", facilityId: f.facilityId, organizationPartyId: org, statusId: "StActive"
                            ]).call()
                            haveFac.add(f.facilityId)
                        }
                    }
                } finally { if (!_dz) ec.artifactExecution.enableAuthz() }
            ]]></script>
        </actions>
    </service>

    <!-- ZE-SHOP: bind a POS counter (terminal) to this shop's facility so the shop's POS sales attribute to it.
         Both the store and the terminal must belong to the active org. -->
    <service verb="assign" noun="ShopCounter">
        <in-parameters>
            <parameter name="storeId" required="true"/>
            <parameter name="terminalId" required="true"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_sa"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_sa.allowed"><return error="true" message="Store not found for your account."/></if>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ta"
                          in-map="[entityName:'zenith.erp.pos.PosTerminal', idField:'terminalId', idValue:terminalId, orgField:'organizationPartyId']"/>
            <if condition="!_ta.allowed"><return error="true" message="Counter not found for your account."/></if>
            <entity-find-one entity-name="zenith.erp.stores.Store" value-field="_st"/>
            <if condition="!_st?.facilityId"><return error="true" message="This shop has no linked facility."/></if>
            <service-call name="update#zenith.erp.pos.PosTerminal" in-map="[terminalId:terminalId, facilityId:_st.facilityId]"/>
        </actions>
    </service>

    <service verb="update" noun="Store">
        <in-parameters>
            <parameter name="storeId" required="true"/>
            <parameter name="storeName"/>
            <parameter name="storeCode"/>
            <parameter name="storeTypeEnumId"/>
            <parameter name="facilityId"/>
            <parameter name="managerPartyId"/>
            <parameter name="address"/>
            <parameter name="city"/>
            <parameter name="regionGeoId"/>
            <parameter name="countryGeoId"/>
            <parameter name="postalCode"/>
            <parameter name="phone"/>
            <parameter name="email"/>
            <parameter name="areaSqFt" type="BigDecimal"/>
            <parameter name="statusId"/>
        </in-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update a store your org owns (org is not an in-param, so it can't be re-homed). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Store not found for your account."/></if>
            <if condition="managerPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ma" in-map="[partyId:managerPartyId]"/>
                <if condition="!_ma.allowed"><return error="true" message="That manager isn't part of your organization."/></if>
            </if>
            <service-call name="update#zenith.erp.stores.Store" in-map="context"/>
        </actions>
    </service>

    <service verb="set" noun="OperatingHours">
        <in-parameters>
            <parameter name="storeId" required="true"/>
            <parameter name="dayOfWeek" required="true"/>
            <parameter name="openTime"/>
            <parameter name="closeTime"/>
            <parameter name="isClosed" default-value="N"/>
        </in-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): child of Store — guard via the parent store's org. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Store not found for your account."/></if>
            <service-call name="store#zenith.erp.stores.StoreOperatingHours"
                          in-map="[storeId:storeId, dayOfWeek:dayOfWeek, openTime:openTime,
                                   closeTime:closeTime, isClosed:isClosed]"/>
        </actions>
    </service>

    <service verb="set" noun="StoreTarget">
        <in-parameters>
            <parameter name="storeId" required="true"/>
            <parameter name="targetPeriodEnumId" required="true"/>
            <parameter name="periodStart" type="Date" required="true"/>
            <parameter name="periodEnd" type="Date" required="true"/>
            <parameter name="salesTarget" type="BigDecimal"/>
            <parameter name="transactionTarget" type="Integer"/>
            <parameter name="footfallTarget" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="targetId"/></out-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): child of Store — guard via the parent store's org. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Store not found for your account."/></if>
            <service-call name="create#zenith.erp.stores.StoreTarget" out-map="context"
                          in-map="[storeId:storeId, targetPeriodEnumId:targetPeriodEnumId,
                                   periodStart:periodStart, periodEnd:periodEnd,
                                   salesTarget:salesTarget, transactionTarget:transactionTarget,
                                   footfallTarget:footfallTarget, actualSales:0,
                                   actualTransactions:0, actualFootfall:0]"/>
        </actions>
    </service>

    <service verb="set" noun="StoreConfig">
        <in-parameters>
            <parameter name="storeId" required="true"/>
            <parameter name="configKey" required="true"/>
            <parameter name="configValue" required="true"/>
        </in-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): child of Store — guard via the parent store's org. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Store not found for your account."/></if>
            <service-call name="store#zenith.erp.stores.StoreConfiguration"
                          in-map="[storeId:storeId, configKey:configKey, configValue:configValue]"/>
        </actions>
    </service>

    <service verb="get" noun="StoreDashboard">
        <in-parameters><parameter name="storeId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="store" type="Map"/>
            <parameter name="operatingHours" type="List"/>
            <parameter name="currentTargets" type="List"/>
            <parameter name="holidays" type="List"/>
        </out-parameters>
        <actions>
            <!-- ZE-SB-013 (Tier 4): only read a dashboard for a store your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.stores.Store', idField:'storeId', idValue:storeId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Store not found for your account."/></if>
            <entity-find-one entity-name="zenith.erp.stores.StoreDetail" value-field="store"/>
            <entity-find entity-name="zenith.erp.stores.StoreOperatingHours" list="operatingHours">
                <econdition field-name="storeId"/>
                <order-by field-name="dayOfWeek"/>
            </entity-find>
            <entity-find entity-name="zenith.erp.stores.StoreTarget" list="currentTargets">
                <econdition field-name="storeId"/>
                <econdition field-name="periodEnd" operator="greater-equals" from="ec.user.nowTimestamp"/>
                <order-by field-name="-periodStart"/>
            </entity-find>
            <entity-find entity-name="zenith.erp.stores.StoreHoliday" list="holidays">
                <econdition field-name="storeId"/>
                <econdition field-name="holidayDate" operator="greater-equals" from="ec.user.nowTimestamp"/>
                <order-by field-name="holidayDate"/>
            </entity-find>
        </actions>
    </service>

</services>
