<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product Reviews" default-menu-index="5">

    <transition name="updateReview" begin-transaction="true">
        <service-call name="update#zenith.erp.ecommerce.ProductReview"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteReview" begin-transaction="true">
        <service-call name="delete#zenith.erp.ecommerce.ProductReview"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.ecommerce.ProductReviewView" list="reviewList">
            <search-form-inputs default-order-by="-reviewDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Product Reviews — Moderation"/>
            <box-body>
                <form-list name="ReviewList" list="reviewList" transition="updateReview"
                           header-dialog="true" select-columns="true" saved-finds="true"
                           show-csv-button="true" show-all-button="true">
                    <field name="reviewId"><default-field title="ID"><display/></default-field></field>
                    <field name="productName"><header-field title="Product" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="customerPartyId"><header-field title="Customer"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="rating"><header-field title="Rating" show-order-by="true">
                            <drop-down allow-empty="true">
                                <option key="1"/><option key="2"/><option key="3"/>
                                <option key="4"/><option key="5"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="reviewTitle"><header-field title="Title"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="reviewText"><default-field title="Review"><display/></default-field></field>
                    <field name="reviewDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="isVerifiedPurchase"><header-field title="Verified">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="isApproved"><header-field title="Approved">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><header-field title="Find"><submit/></header-field>
                        <conditional-field name="rev_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                    <field name="deleteButton">
                        <conditional-field name="rev_delete_write" condition="modCanWrite" title="">
                        <link url="deleteReview" text="X" parameter-map="[reviewId:reviewId]"
                              confirmation="Delete this review?"/>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
