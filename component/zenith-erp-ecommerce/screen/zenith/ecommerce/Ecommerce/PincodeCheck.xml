<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pincode Serviceability" default-menu-index="4">

    <transition name="createPincode" begin-transaction="true">
        <service-call name="create#zenith.erp.ecommerce.PincodeServiceability"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePincode" begin-transaction="true">
        <service-call name="update#zenith.erp.ecommerce.PincodeServiceability"/>
        <default-response url="."/>
    </transition>
    <transition name="deletePincode" begin-transaction="true">
        <service-call name="delete#zenith.erp.ecommerce.PincodeServiceability"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.ecommerce.PincodeServiceability" list="pincodeList">
            <search-form-inputs default-order-by="pincode"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Pincode Serviceability"/>
            <box-toolbar>
                <section name="AddPincode_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddPincodeDialog" button-text="Add Pincode">
                    <form-single name="AddPincodeForm" transition="createPincode">
                        <field name="pincode"><default-field title="Pincode"><text-line size="10"/></default-field></field>
                        <field name="city"><default-field title="City"><text-line size="25"/></default-field></field>
                        <field name="stateCode"><default-field title="State Code"><text-line size="5"/></default-field></field>
                        <field name="zone"><default-field title="Zone">
                            <drop-down><option key="LOCAL"/><option key="REGIONAL"/><option key="METRO"/><option key="NATIONAL"/></drop-down></default-field></field>
                        <field name="isServiceable"><default-field title="Serviceable">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="codAvailable"><default-field title="COD Available">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="estimatedDays"><default-field title="Est. Days"><text-line size="5"/></default-field></field>
                        <field name="shippingProviderId"><default-field title="Shipping Provider">
                            <drop-down allow-empty="true"><entity-options key="${shippingProviderId}" text="${providerName}">
                                <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Pincode Serviceability..." style="display:none"></span>]]></text></render-mode>
            <form-list name="PincodeList" list="pincodeList" transition="updatePincode"
                           header-dialog="true" select-columns="true" saved-finds="true"
                           show-csv-button="true" show-all-button="true">
                    <field name="pincode"><header-field title="Pincode" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="city"><header-field title="City" show-order-by="true"><text-find/></header-field>
                        <default-field><text-line size="15"/></default-field></field>
                    <field name="stateCode"><header-field title="State" show-order-by="true"><text-find/></header-field>
                        <default-field><text-line size="4"/></default-field></field>
                    <field name="zone"><header-field title="Zone" show-order-by="true">
                            <drop-down allow-empty="true"><option key="LOCAL"/><option key="REGIONAL"/>
                                <option key="METRO"/><option key="NATIONAL"/></drop-down></header-field>
                        <default-field><drop-down><option key="LOCAL"/><option key="REGIONAL"/>
                            <option key="METRO"/><option key="NATIONAL"/></drop-down></default-field></field>
                    <field name="isServiceable"><header-field title="Serviceable">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="codAvailable"><header-field title="COD">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="estimatedDays"><header-field title="Est. Days"/>
                        <default-field><text-line size="3"/></default-field></field>
                    <field name="shippingProviderId"><header-field title="Provider">
                            <drop-down allow-empty="true"><entity-options key="${shippingProviderId}" text="${providerName}">
                                <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider"/>
                            </entity-options></drop-down></header-field>
                        <default-field><drop-down allow-empty="true"><entity-options key="${shippingProviderId}" text="${providerName}">
                            <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider">
                                <econdition field-name="isActive" value="Y"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="submitButton"><header-field title="Find"><submit/></header-field>
                        <conditional-field name="pin_update_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                    <field name="deleteButton">
                        <conditional-field name="pin_delete_write" condition="modCanWrite" title="">
                        <link url="deletePincode" text="X" parameter-map="[pincode:pincode]"
                              confirmation="Delete pincode ${pincode}?"/>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
