<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Shipping Providers" default-menu-index="3">

    <transition name="createProvider" begin-transaction="true">
        <service-call name="create#zenith.erp.ecommerce.ShippingProvider"/>
        <default-response url="."/>
    </transition>
    <transition name="updateProvider" begin-transaction="true">
        <service-call name="update#zenith.erp.ecommerce.ShippingProvider"/>
        <default-response url="."/>
    </transition>
    <transition name="createRate" begin-transaction="true">
        <service-call name="create#zenith.erp.ecommerce.ShippingRate"/>
        <default-response url="."/>
    </transition>
    <transition name="updateRate" begin-transaction="true">
        <service-call name="update#zenith.erp.ecommerce.ShippingRate"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider" list="providerList">
            <order-by field-name="providerName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.ecommerce.ShippingRate" list="rateList">
            <order-by field-name="shippingProviderId,fromZone,toZone,weightFromGrams"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Shipping Providers"/>
            <box-toolbar>
                <section name="CreateProvider_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateProviderDialog" button-text="Add Provider">
                    <form-single name="CreateProviderForm" transition="createProvider">
                        <field name="shippingProviderId"><default-field title="Provider ID"><text-line size="20"/></default-field></field>
                        <field name="providerName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="providerCode"><default-field title="Code"><text-line size="15"/></default-field></field>
                        <field name="apiBaseUrl"><default-field title="API Base URL"><text-line size="60"/></default-field></field>
                        <field name="apiKey"><default-field title="API Key"><text-line size="40"/></default-field></field>
                        <field name="apiSecret"><default-field title="API Secret"><text-line size="40"/></default-field></field>
                        <field name="trackingUrlTemplate"><default-field title="Tracking URL Template"><text-line size="60"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="ProviderList" list="providerList" transition="updateProvider">
                    <field name="shippingProviderId"><default-field title="ID"><display/></default-field></field>
                    <field name="providerName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="providerCode"><default-field title="Code"><text-line size="10"/></default-field></field>
                    <field name="apiBaseUrl"><default-field title="API URL"><text-line size="30"/></default-field></field>
                    <field name="trackingUrlTemplate"><default-field title="Tracking URL"><text-line size="40"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="prov_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Shipping Rates"/>
            <box-toolbar>
                <section name="CreateRate_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateRateDialog" button-text="Add Rate">
                    <form-single name="CreateRateForm" transition="createRate">
                        <field name="shippingProviderId"><default-field title="Provider">
                            <drop-down><entity-options key="${shippingProviderId}" text="${providerName}">
                                <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fromZone"><default-field title="From Zone">
                            <drop-down><option key="LOCAL"/><option key="REGIONAL"/><option key="METRO"/><option key="NATIONAL"/></drop-down></default-field></field>
                        <field name="toZone"><default-field title="To Zone">
                            <drop-down><option key="LOCAL"/><option key="REGIONAL"/><option key="METRO"/><option key="NATIONAL"/></drop-down></default-field></field>
                        <field name="weightFromGrams"><default-field title="Weight From (g)"><text-line size="10"/></default-field></field>
                        <field name="weightToGrams"><default-field title="Weight To (g)"><text-line size="10"/></default-field></field>
                        <field name="baseRate"><default-field title="Base Rate (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="perKgRate"><default-field title="Per Kg Rate (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="codCharge"><default-field title="COD Charge (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="RateList" list="rateList" transition="updateRate">
                    <field name="shippingRateId"><default-field title="ID"><display/></default-field></field>
                    <field name="shippingProviderId"><default-field title="Provider">
                        <display-entity entity-name="zenith.erp.ecommerce.ShippingProvider" text="${providerName}"/></default-field></field>
                    <field name="fromZone"><default-field title="From"><display/></default-field></field>
                    <field name="toZone"><default-field title="To"><display/></default-field></field>
                    <field name="weightFromGrams"><default-field title="Wt From (g)"><text-line size="6"/></default-field></field>
                    <field name="weightToGrams"><default-field title="Wt To (g)"><text-line size="6"/></default-field></field>
                    <field name="baseRate"><default-field title="Base (${currSymbol})"><text-line size="6"/></default-field></field>
                    <field name="perKgRate"><default-field title="Per Kg (${currSymbol})"><text-line size="6"/></default-field></field>
                    <field name="codCharge"><default-field title="COD (${currSymbol})"><text-line size="6"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="rate_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
