<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="2">

    <transition name="saveSettings" begin-transaction="true">
        <service-call name="store#zenith.erp.ecommerce.EcommerceSettings"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.ecommerce.EcommerceSettings" list="settingsList">
            <econdition field-name="isActive" value="Y"/>
        </entity-find>
        <set field="settings" from="settingsList ? settingsList[0] : null"/>
    </actions>

    <widgets>
        <container-box>
            <box-header title="eCommerce Settings"/>
            <box-body>
                <form-single name="EcomSettingsForm" transition="saveSettings" map="settings">
                    <field name="settingsId"><default-field><hidden default-value="${settings?.settingsId ?: 'ECOM_DEFAULT'}"/></default-field></field>

                    <field name="storeHeader"><default-field title=""><label text="Store Configuration" type="h5"/></default-field></field>
                    <field name="storeName"><default-field title="Store Name"><text-line size="40"/></default-field></field>
                    <field name="storeUrl"><default-field title="Store URL"><text-line size="60"/></default-field></field>
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName}">
                            <entity-find entity-name="mantle.party.Organization"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="defaultCurrencyUomId"><default-field title="Currency">
                        <drop-down no-current-selected-key="${companyCurrency}"><entity-options key="${uomId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Uom">
                                <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                            </entity-find></entity-options></drop-down></default-field></field>

                    <field name="paymentHeader"><default-field title=""><label text="Payment Gateway (Razorpay)" type="h5"/></default-field></field>
                    <field name="razorpayEnabled"><default-field title="Razorpay Enabled">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="razorpayKeyId"><default-field title="Razorpay Key ID"><text-line size="40"/></default-field></field>
                    <field name="razorpayKeySecret"><default-field title="Razorpay Key Secret"><text-line size="40"/></default-field></field>

                    <field name="upiHeader"><default-field title=""><label text="UPI Settings" type="h5"/></default-field></field>
                    <field name="upiEnabled"><default-field title="UPI Enabled">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="upiVpa"><default-field title="UPI VPA (e.g. store@upi)"><text-line size="40"/></default-field></field>

                    <field name="codHeader"><default-field title=""><label text="Cash on Delivery" type="h5"/></default-field></field>
                    <field name="codEnabled"><default-field title="COD Enabled">
                        <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="codMinAmount"><default-field title="COD Min Amount (${currSymbol})"><text-line size="15"/></default-field></field>
                    <field name="codMaxAmount"><default-field title="COD Max Amount (${currSymbol})"><text-line size="15"/></default-field></field>

                    <field name="gstHeader"><default-field title=""><label text="GST" type="h5"/></default-field></field>
                    <field name="gstOnOrders"><default-field title="GST on Orders">
                        <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>

                    <field name="isActive"><default-field title="Active">
                        <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>

                    <field name="submitButton">
                        <conditional-field name="settings_save_write" condition="modCanWrite" title="Save Settings"><submit/></conditional-field>
                        <default-field title="Save Settings"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
    </widgets>
</screen>
