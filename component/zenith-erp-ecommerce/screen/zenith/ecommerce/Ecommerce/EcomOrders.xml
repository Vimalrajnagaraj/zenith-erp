<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Orders" default-menu-index="1">

    <transition name="updateTracking" begin-transaction="true">
        <service-call name="zenith.ecommerce.EcommerceServices.assign#ShipmentTracking"/>
        <default-response url="."/>
    </transition>
    <transition name="updateStatus" begin-transaction="true">
        <service-call name="zenith.ecommerce.EcommerceServices.update#TrackingStatus"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.ecommerce.EcomOrderView" list="orderList">
            <search-form-inputs default-order-by="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="vendorPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="eCommerce Orders"/>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Orders..." style="display:none"></span>]]></text></render-mode>
            <form-list name="EcomOrderList" list="orderList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <field name="orderId"><header-field title="Order ID" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="orderName"><header-field title="Order Name" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="entryDate"><header-field title="Date" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="statusId"><header-field title="Status" show-order-by="true">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="OrderHeader"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="grandTotal"><header-field title="Amount" show-order-by="true"/>
                        <default-field><display format="#,##,##0.00"/></default-field></field>
                    <field name="paymentMethod"><header-field title="Payment" show-order-by="true">
                            <drop-down allow-empty="true">
                                <option key="Razorpay" text="Razorpay"/>
                                <option key="COD" text="COD"/>
                                <option key="UPI" text="UPI"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="isCodOrder"><header-field title="COD?">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="deliveryPincode"><header-field title="Pincode"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="awbNumber"><header-field title="AWB"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="trackingStatus"><header-field title="Tracking" show-order-by="true">
                            <drop-down allow-empty="true">
                                <option key="Shipped"/><option key="InTransit"/>
                                <option key="OutForDelivery"/><option key="Delivered"/>
                                <option key="RTO"/><option key="Cancelled"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="razorpayPaymentId"><header-field title="Razorpay ID"/>
                        <default-field><display/></default-field></field>
                    <field name="customerPartyId"><header-field title="Customer"/>
                        <default-field><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>

        <section name="EcomOrderActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
        <container-dialog id="AssignTrackingDialog" button-text="Assign Tracking">
            <form-single name="AssignTrackingForm" transition="updateTracking">
                <field name="orderId"><default-field title="Order ID"><text-line size="20"/></default-field></field>
                <field name="shippingProviderId"><default-field title="Shipping Provider">
                    <drop-down><entity-options key="${shippingProviderId}" text="${providerName}">
                        <entity-find entity-name="zenith.erp.ecommerce.ShippingProvider">
                            <econdition field-name="isActive" value="Y"/>
                        </entity-find></entity-options></drop-down></default-field></field>
                <field name="awbNumber"><default-field title="AWB Number"><text-line size="30"/></default-field></field>
                <field name="trackingNumber"><default-field title="Tracking Number"><text-line size="30"/></default-field></field>
                <field name="submitButton"><default-field title="Assign"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <container-dialog id="UpdateStatusDialog" button-text="Update Status">
            <form-single name="UpdateStatusForm" transition="updateStatus">
                <field name="orderId"><default-field title="Order ID"><text-line size="20"/></default-field></field>
                <field name="trackingStatus"><default-field title="Status">
                    <drop-down>
                        <option key="Shipped"/><option key="InTransit" text="In Transit"/>
                        <option key="OutForDelivery" text="Out for Delivery"/>
                        <option key="Delivered"/><option key="RTO" text="RTO (Return to Origin)"/>
                        <option key="Cancelled"/>
                    </drop-down></default-field></field>
                <field name="actualDeliveryDate"><default-field title="Delivery Date"><date-time type="date"/></default-field></field>
                <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
            </form-single>
        </container-dialog>
        </widgets></section>
    </widgets>
</screen>
