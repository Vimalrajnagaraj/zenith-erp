<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Distribution Route ========== -->
    <entity entity-name="DistributionRoute" package="zenith.erp.distribution" short-alias="DistributionRoutes">
        <field name="routeId" type="id" is-pk="true"/>
        <field name="routeName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="originFacilityId" type="id"/>
        <field name="vehicleId" type="text-short"/>
        <field name="driverPartyId" type="id"/>
        <field name="dayOfWeek" type="text-short"><description>Mon,Tue,Wed,Thu,Fri,Sat,Sun or comma-separated</description></field>
        <field name="estimatedDuration" type="number-integer"><description>Minutes</description></field>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="mantle.facility.Facility">
            <key-map field-name="originFacilityId" related="facilityId"/></relationship>
        <relationship type="one" title="Driver" related="mantle.party.Party">
            <key-map field-name="driverPartyId" related="partyId"/></relationship>
    </entity>

    <!-- ========== Route Stop ========== -->
    <entity entity-name="RouteStop" package="zenith.erp.distribution" short-alias="RouteStops">
        <field name="routeId" type="id" is-pk="true"/>
        <field name="stopSeqId" type="number-integer" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="address" type="text-long"/>
        <field name="estimatedArrival" type="text-short"><description>HH:mm format</description></field>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.distribution.DistributionRoute"/>
        <relationship type="one" related="mantle.party.Party"/>
    </entity>

    <!-- ========== Delivery Run ========== -->
    <entity entity-name="DeliveryRun" package="zenith.erp.distribution" short-alias="DeliveryRuns">
        <field name="runId" type="id" is-pk="true"/>
        <field name="routeId" type="id"/>
        <field name="runDate" type="date"/>
        <field name="departureTime" type="date-time"/>
        <field name="completionTime" type="date-time"/>
        <field name="driverPartyId" type="id"/>
        <field name="vehicleId" type="text-short"/>
        <field name="totalOrders" type="number-integer"/>
        <field name="deliveredOrders" type="number-integer"/>
        <field name="totalValue" type="currency-amount"/>
        <field name="totalCollected" type="currency-amount"/>
        <field name="statusId" type="id"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.distribution.DistributionRoute"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="DeliveryRun" description="Delivery Run"/>
            <moqui.basic.StatusItem statusId="DrPlanned" statusTypeId="DeliveryRun" description="Planned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="DrLoading" statusTypeId="DeliveryRun" description="Loading" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="DrInTransit" statusTypeId="DeliveryRun" description="In Transit" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="DrCompleted" statusTypeId="DeliveryRun" description="Completed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="DrCancelled" statusTypeId="DeliveryRun" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrPlanned" toStatusId="DrLoading" transitionName="Start Loading"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrLoading" toStatusId="DrInTransit" transitionName="Depart"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrInTransit" toStatusId="DrCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrPlanned" toStatusId="DrCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== Delivery Run Order ========== -->
    <entity entity-name="DeliveryRunOrder" package="zenith.erp.distribution" short-alias="DeliveryRunOrders">
        <field name="runId" type="id" is-pk="true"/>
        <field name="orderId" type="id" is-pk="true"/>
        <field name="stopSeqId" type="number-integer"/>
        <field name="deliveryStatusId" type="id"/>
        <field name="deliveredTime" type="date-time"/>
        <field name="collectedAmount" type="currency-amount"/>
        <field name="paymentMethod" type="text-short"/>
        <field name="notes" type="text-medium"/>
        <field name="signatureRef" type="text-medium"/>
        <relationship type="one" related="zenith.erp.distribution.DeliveryRun"/>
        <relationship type="one" related="mantle.order.OrderHeader"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="DeliveryOrder" description="Delivery Run Order"/>
            <moqui.basic.StatusItem statusId="DoAssigned" statusTypeId="DeliveryOrder" description="Assigned" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="DoDelivered" statusTypeId="DeliveryOrder" description="Delivered" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="DoPartial" statusTypeId="DeliveryOrder" description="Partial Delivery" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="DoFailed" statusTypeId="DeliveryOrder" description="Failed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="DoReturned" statusTypeId="DeliveryOrder" description="Returned" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- ========== Delivery Run View ========== -->
    <view-entity entity-name="DeliveryRunDetail" package="zenith.erp.distribution">
        <member-entity entity-alias="DR" entity-name="zenith.erp.distribution.DeliveryRun"/>
        <member-entity entity-alias="RT" entity-name="zenith.erp.distribution.DistributionRoute" join-from-alias="DR">
            <key-map field-name="routeId"/></member-entity>
        <alias entity-alias="DR" name="runId"/>
        <alias entity-alias="DR" name="routeId"/>
        <alias entity-alias="DR" name="runDate"/>
        <alias entity-alias="DR" name="departureTime"/>
        <alias entity-alias="DR" name="completionTime"/>
        <alias entity-alias="DR" name="driverPartyId"/>
        <alias entity-alias="DR" name="vehicleId"/>
        <alias entity-alias="DR" name="totalOrders"/>
        <alias entity-alias="DR" name="deliveredOrders"/>
        <alias entity-alias="DR" name="totalValue"/>
        <alias entity-alias="DR" name="totalCollected"/>
        <alias entity-alias="DR" name="statusId"/>
        <alias entity-alias="RT" name="routeName"/>
        <alias entity-alias="RT" name="originFacilityId"/>
        <alias entity-alias="RT" name="organizationPartyId"/>
    </view-entity>

</entities>
