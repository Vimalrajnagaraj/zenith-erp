<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Delivery Run" default-menu-include="false">

    <parameter name="runId" required="true"/>

    <transition name="startRun">
        <service-call name="zenith.distribution.DistributionServices.start#DeliveryRun"/>
        <default-response url="."/>
    </transition>
    <transition name="completeRun">
        <service-call name="zenith.distribution.DistributionServices.complete#DeliveryRun"/>
        <default-response url="."/>
    </transition>
    <transition name="assignOrder">
        <service-call name="zenith.distribution.DistributionServices.assign#OrderToRun"/>
        <default-response url="."/>
    </transition>
    <transition name="deliverOrder">
        <service-call name="zenith.distribution.DistributionServices.deliver#Order"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.distribution.DeliveryRunDetail" value-field="run"/>
        <entity-find entity-name="zenith.erp.distribution.DeliveryRunOrder" list="orders">
            <econdition field-name="runId"/>
            <order-by field-name="stopSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Delivery Run: ${run.routeName} - ${ec.l10n.format(run.runDate, 'dd-MMM-yyyy')}" type="h4" style="text-weight-bold q-my-none"/>
            <container style="row q-gutter-sm">
                <section name="StartBtn" condition="run.statusId == 'DrPlanned'">
                    <widgets><link url="startRun" text="Start Run" btn-type="info" parameter-map="[runId:runId]"/></widgets>
                </section>
                <section name="CompleteBtn" condition="run.statusId == 'DrInTransit'">
                    <widgets><link url="completeRun" text="Complete Run" btn-type="success" parameter-map="[runId:runId]"
                                   confirmation="Mark this delivery run as completed?"/></widgets>
                </section>
            </container>
        </container>

        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${run.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Orders" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${run.deliveredOrders ?: 0} / ${run.totalOrders ?: 0}" type="h5" style="text-dark text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Collected" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(run.totalCollected ?: 0, '#,##0.00')}" type="h5" style="text-positive text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Vehicle" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${run.vehicleId ?: 'N/A'}" type="h5" style="text-dark text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>

        <!-- Orders on this run -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Delivery Orders" type="h5" style="text-weight-bold q-my-none"/>
                <section name="AssignSection" condition="run.statusId in ['DrPlanned', 'DrLoading']">
                    <widgets>
                        <container-dialog id="AssignOrder" button-text="Assign Order" type="success">
                            <form-single name="AssignOrderForm" transition="assignOrder">
                                <field name="runId" from="run.runId"><default-field><hidden/></default-field></field>
                                <field name="orderId"><default-field title="Order ID"><text-line size="15"/></default-field></field>
                                <field name="submitBtn"><default-field title="Assign"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </container>

            <form-list name="OrdersForm" list="orders" transition="deliverOrder">
                <field name="runId"><default-field><hidden/></default-field></field>
                <field name="orderId"><default-field title="Order"><display/></default-field></field>
                <field name="stopSeqId"><default-field title="Stop #"><display/></default-field></field>
                <field name="deliveryStatusId"><default-field title="Status">
                    <drop-down>
                        <option key="DoAssigned" text="Assigned"/>
                        <option key="DoDelivered" text="Delivered"/>
                        <option key="DoPartial" text="Partial"/>
                        <option key="DoFailed" text="Failed"/>
                        <option key="DoReturned" text="Returned"/>
                    </drop-down></default-field></field>
                <field name="collectedAmount"><default-field title="Collected"><text-line size="10"/></default-field></field>
                <field name="paymentMethod"><default-field title="Payment">
                    <drop-down allow-empty="true">
                        <option key="Cash" text="Cash"/><option key="Cheque" text="Cheque"/>
                        <option key="UPI" text="UPI"/><option key="Credit" text="On Credit"/>
                    </drop-down></default-field></field>
                <field name="notes"><default-field><text-line size="15"/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
