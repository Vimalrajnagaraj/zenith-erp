<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Delivery Runs" default-menu-index="3">

    <transition name="editRun"><default-response url="../EditDeliveryRun"/></transition>
    <transition name="createRun">
        <service-call name="zenith.distribution.DistributionServices.create#DeliveryRun"/>
        <default-response url="../EditDeliveryRun"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.distribution.DeliveryRunDetail" list="runs">
            <search-form-inputs default-order-by="-runDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Delivery Runs" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateRun" button-text="New Run" type="success">
                <form-single name="CreateRunForm" transition="createRun">
                    <field name="routeId"><default-field title="Route">
                        <drop-down><entity-options key="${routeId}" text="${routeName}">
                            <entity-find entity-name="zenith.erp.distribution.DistributionRoute">
                                <econdition field-name="isActive" value="Y"/>
                                <order-by field-name="routeName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="runDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                    <field name="vehicleId"><default-field title="Vehicle"><text-line size="15"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="RunsForm" list="runs" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="routeName"><default-field title="Route"><display/></default-field></field>
                <field name="runDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date">
                        <link url="editRun" text="${ec.l10n.format(runDate, 'dd-MMM-yyyy')}" parameter-map="[runId:runId]"/>
                    </default-field></field>
                <field name="vehicleId"><default-field title="Vehicle"><display/></default-field></field>
                <field name="totalOrders"><default-field title="Orders"><display/></default-field></field>
                <field name="deliveredOrders"><default-field title="Delivered"><display/></default-field></field>
                <field name="totalCollected"><default-field title="Collected"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="DrPlanned" text="Planned"/><option key="DrInTransit" text="In Transit"/>
                        <option key="DrCompleted" text="Completed"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
