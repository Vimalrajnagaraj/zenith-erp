<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Route" default-menu-include="false">

    <parameter name="routeId" required="true"/>

    <transition name="updateRoute">
        <service-call name="update#zenith.erp.distribution.DistributionRoute"/>
        <default-response url="."/>
    </transition>
    <transition name="addStop">
        <service-call name="zenith.distribution.DistributionServices.add#RouteStop"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteStop">
        <service-call name="delete#zenith.erp.distribution.RouteStop"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.distribution.DistributionRoute" value-field="route"/>
        <entity-find entity-name="zenith.erp.distribution.RouteStop" list="stops">
            <econdition field-name="routeId"/>
            <order-by field-name="stopSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Route: ${route.routeName}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Route Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="RouteForm" map="route" transition="updateRoute">
                        <field name="routeId"><default-field><hidden/></default-field></field>
                        <field name="routeName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="originFacilityId"><default-field title="Origin">
                            <drop-down><entity-options key="${facilityId}" text="${facilityName}">
                                <entity-find entity-name="mantle.facility.Facility">
                                    <order-by field-name="facilityName"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="dayOfWeek"><default-field title="Days"><text-line size="25"/></default-field></field>
                        <field name="vehicleId"><default-field title="Vehicle"><text-line size="15"/></default-field></field>
                        <field name="driverPartyId"><default-field title="Driver">
                            <drop-down allow-empty="true"><entity-options key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}">
                                <entity-find entity-name="mantle.party.PersonAndUserAccount"/>
                            </entity-options></drop-down></default-field></field>
                        <field name="estimatedDuration"><default-field title="Duration (min)"><text-line size="8"/></default-field></field>
                        <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>
            </row-col>

            <row-col lg="6" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Stops (${stops.size()})" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="AddStop" button-text="Add Stop" type="success">
                            <form-single name="AddStopForm" transition="addStop">
                                <field name="routeId" from="route.routeId"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Customer">
                                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Customer"/>
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="address"><default-field><text-area rows="2" cols="30"/></default-field></field>
                                <field name="estimatedArrival"><default-field title="ETA (HH:mm)"><text-line size="8"/></default-field></field>
                                <field name="notes"><default-field><text-line size="30"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>

                    <form-list name="StopsForm" list="stops" skip-form="true">
                        <field name="stopSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="partyId"><default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId}"/>
                        </default-field></field>
                        <field name="estimatedArrival"><default-field title="ETA"><display/></default-field></field>
                        <field name="removeBtn"><default-field title="">
                            <link url="deleteStop" text="Remove" btn-type="danger"
                                  parameter-map="[routeId:routeId, stopSeqId:stopSeqId]"
                                  confirmation="Remove this stop?"/>
                        </default-field></field>
                    </form-list>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
