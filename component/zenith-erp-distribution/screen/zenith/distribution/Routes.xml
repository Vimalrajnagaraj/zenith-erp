<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Routes" default-menu-index="2">

    <transition name="editRoute"><default-response url="../EditRoute"/></transition>
    <transition name="createRoute">
        <service-call name="zenith.distribution.DistributionServices.create#Route"/>
        <default-response url="../EditRoute"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.distribution.DistributionRoute" list="routes">
            <search-form-inputs default-order-by="routeName"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Distribution Routes" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateRoute" button-text="New Route" type="success">
                <form-single name="CreateRouteForm" transition="createRoute">
                    <field name="routeName"><default-field title="Route Name"><text-line size="25"/></default-field></field>
                    <field name="originFacilityId"><default-field title="Origin Warehouse">
                        <drop-down><entity-options key="${facilityId}" text="${facilityName}">
                            <entity-find entity-name="mantle.facility.Facility">
                                <order-by field-name="facilityName"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="dayOfWeek"><default-field title="Days"><text-line size="25"/></default-field></field>
                    <field name="vehicleId"><default-field title="Vehicle ID"><text-line size="15"/></default-field></field>
                    <field name="estimatedDuration"><default-field title="Duration (min)"><text-line size="8"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Routes..." style="display:none"></span>]]></text></render-mode>
            <form-list name="RoutesForm" list="routes" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="routeName"><header-field show-order-by="true"><text-find size="20"/></header-field>
                    <default-field title="Route">
                        <link url="editRoute" text="${routeName}" parameter-map="[routeId:routeId]"/>
                    </default-field></field>
                <field name="dayOfWeek"><default-field title="Days"><display/></default-field></field>
                <field name="vehicleId"><default-field title="Vehicle"><display/></default-field></field>
                <field name="estimatedDuration"><default-field title="Duration (min)"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
