<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.distribution.DistributionRoute" count-field="activeRoutes">
            <econdition field-name="isActive" value="Y"/>
        </entity-find-count>
        <set field="todayDate" from="new java.sql.Date(System.currentTimeMillis())"/>
        <entity-find-count entity-name="zenith.erp.distribution.DeliveryRun" count-field="todayRuns">
            <econdition field-name="runDate" from="todayDate"/>
        </entity-find-count>
        <entity-find-count entity-name="zenith.erp.distribution.DeliveryRun" count-field="inTransitRuns">
            <econdition field-name="statusId" value="DrInTransit"/>
        </entity-find-count>
        <entity-find entity-name="zenith.erp.distribution.DeliveryRunDetail" list="recentRuns" limit="10">
            <order-by field-name="-runDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Distribution Management" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Manage delivery routes, runs, and track order fulfillment." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container-row>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Active Routes" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${activeRoutes}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-blue-1 border-radius-md text-blue-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="route" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="Today's Runs" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${todayRuns}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-green-1 border-radius-md text-green-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="local_shipping" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
            <row-col lg="4" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between">
                        <container>
                            <label text="In Transit" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                            <label text="${inTransitRuns}" type="h4" style="text-dark text-weight-bold q-my-none"/>
                        </container>
                        <container style="q-pa-sm bg-orange-1 border-radius-md text-orange-8">
                            <render-mode><text type="html"><![CDATA[<q-icon name="directions_car" class="text-h4"/>]]></text></render-mode>
                        </container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Delivery Runs" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentRuns" list="recentRuns" skip-form="true">
                <field name="routeName"><default-field title="Route"><display/></default-field></field>
                <field name="runDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalOrders"><default-field title="Orders"><display/></default-field></field>
                <field name="deliveredOrders"><default-field title="Delivered"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
