<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Signature Requests" default-menu-index="1">

    <transition name="createRequest">
        <service-call name="create#zenith.erp.sign.SignatureRequest"/>
        <default-response url="."/>
    </transition>

    <transition name="updateRequest">
        <service-call name="update#zenith.erp.sign.SignatureRequest"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.sign.SignatureRequest" list="requestList">
            <search-form-inputs default-order-by="-requestedDate"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="firstName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <condition name="statusTypeId" value="SignatureStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="E-Signature Tracker Ledger"/><box-toolbar>
            <container-dialog id="NewRequestDialog" button-text="New Signature Request">
                <form-single name="NewRequestForm" transition="createRequest">
                    <field name="documentTitle"><default-field title="Document Title"><text-line size="40"/></default-field></field>
                    <field name="targetPartyId"><default-field title="Target Signer">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${firstName} ${lastName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="requestedByPartyId"><default-field title="Requested By">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${firstName} ${lastName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="requestedDate"><default-field title="Date Sent"><date-time/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="SigSent">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="documentUrl"><default-field title="Document Link (URL)"><text-line size="60"/></default-field></field>
                    <field name="notes"><default-field title="Notes"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Send Request"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="RequestListForm" list="requestList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="requestId"><default-field><hidden/></default-field></field>
                <field name="documentTitle">
                    <header-field title="Document" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="targetPartyId">
                    <header-field title="Signer">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${firstName} ${lastName}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="mantle.party.Person" text="${firstName} ${lastName}"/></default-field>
                </field>
                <field name="requestedDate">
                    <header-field title="Sent On" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <form-single name="UpdateStatusForm" transition="updateRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="statusId"><default-field title="">
                                <drop-down>
                                    <list-options list="statusList" key="${statusId}" text="${description}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="signedDate"><default-field title="Signed On"><date-time type="date"/></default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                        </form-single>
                    </default-field>
                </field>
                <field name="documentUrl">
                    <default-field title="Link"><link url="${documentUrl}" text="View Doc" url-type="plain" condition="documentUrl"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
