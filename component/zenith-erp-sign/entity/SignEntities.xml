<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="SignatureRequest" package="zenith.erp.sign">
        <field name="requestId" type="id" is-pk="true"/>
        <field name="targetPartyId" type="id"/>
        <field name="requestedByPartyId" type="id"/>
        <field name="documentTitle" type="text-medium"/>
        <field name="documentUrl" type="text-long"/>
        <field name="statusId" type="id"/>
        <field name="requestedDate" type="date-time"/>
        <field name="signedDate" type="date-time"/>
        <field name="notes" type="text-long"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" title="Target" related="mantle.party.Party">
            <key-map field-name="targetPartyId" related="partyId"/></relationship>
        <relationship type="one" title="RequestedBy" related="mantle.party.Party">
            <key-map field-name="requestedByPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="SignatureStatus" description="Signature Request Status"/>
            <moqui.basic.StatusItem statusId="SigDraft" statusTypeId="SignatureStatus" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SigSent" statusTypeId="SignatureStatus" description="Sent / Pending" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SigViewed" statusTypeId="SignatureStatus" description="Viewed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SigSigned" statusTypeId="SignatureStatus" description="Signed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="SigDeclined" statusTypeId="SignatureStatus" description="Declined" sequenceNum="5"/>
        </seed-data>
    </entity>

</entities>
