<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Signature Request Lifecycle ========== -->

    <service verb="create" noun="SignatureRequest">
        <description>Create a new signature request in SigDraft status. Requester defaults to current user.</description>
        <in-parameters>
            <parameter name="targetPartyId" required="true"/>
            <parameter name="documentTitle" required="true"/>
            <parameter name="documentUrl"/>
            <parameter name="notes"/>
            <parameter name="requestedByPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="requestId"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="SigDraft"/>
            <set field="requestedDate" from="ec.user.nowTimestamp"/>

            <!-- Default requestedByPartyId from current user -->
            <if condition="!requestedByPartyId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                    <field-map field-name="userId" from="ec.user.userId"/>
                </entity-find-one>
                <set field="requestedByPartyId" from="userAccount?.partyId"/>
            </if>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>

            <service-call name="create#zenith.erp.sign.SignatureRequest" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="send" noun="SignatureRequest">
        <description>Send a draft signature request to the target party. Updates requestedDate to now.</description>
        <in-parameters>
            <parameter name="requestId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sign.SignatureRequest" value-field="sigRequest"/>
            <if condition="!sigRequest"><return error="true" message="Signature request [${requestId}] not found."/></if>
            <if condition="sigRequest.statusId != 'SigDraft'">
                <return error="true" message="Signature request [${requestId}] must be in SigDraft status to send. Current status: ${sigRequest.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.sign.SignatureRequest"
                          in-map="[requestId: requestId, statusId: 'SigSent', requestedDate: ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="markViewed" noun="SignatureRequest">
        <description>Mark a sent signature request as viewed by the target party.</description>
        <in-parameters>
            <parameter name="requestId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sign.SignatureRequest" value-field="sigRequest"/>
            <if condition="!sigRequest"><return error="true" message="Signature request [${requestId}] not found."/></if>
            <if condition="sigRequest.statusId != 'SigSent'">
                <return error="true" message="Signature request [${requestId}] must be in SigSent status to mark as viewed. Current status: ${sigRequest.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.sign.SignatureRequest"
                          in-map="[requestId: requestId, statusId: 'SigViewed']"/>
        </actions>
    </service>

    <service verb="sign" noun="SignatureRequest">
        <description>Sign a signature request. Valid from SigSent or SigViewed status. Records signed timestamp.</description>
        <in-parameters>
            <parameter name="requestId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sign.SignatureRequest" value-field="sigRequest"/>
            <if condition="!sigRequest"><return error="true" message="Signature request [${requestId}] not found."/></if>
            <if condition="sigRequest.statusId != 'SigSent' &amp;&amp; sigRequest.statusId != 'SigViewed'">
                <return error="true" message="Signature request [${requestId}] must be in SigSent or SigViewed status to sign. Current status: ${sigRequest.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.sign.SignatureRequest"
                          in-map="[requestId: requestId, statusId: 'SigSigned', signedDate: ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="decline" noun="SignatureRequest">
        <description>Decline a signature request. Valid from SigSent or SigViewed status. Optionally records decline notes.</description>
        <in-parameters>
            <parameter name="requestId" required="true"/>
            <parameter name="notes"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sign.SignatureRequest" value-field="sigRequest"/>
            <if condition="!sigRequest"><return error="true" message="Signature request [${requestId}] not found."/></if>
            <if condition="sigRequest.statusId != 'SigSent' &amp;&amp; sigRequest.statusId != 'SigViewed'">
                <return error="true" message="Signature request [${requestId}] must be in SigSent or SigViewed status to decline. Current status: ${sigRequest.statusId}"/>
            </if>

            <set field="updateMap" from="[requestId: requestId, statusId: 'SigDeclined']"/>
            <if condition="notes"><set field="updateMap.notes" from="notes"/></if>

            <service-call name="update#zenith.erp.sign.SignatureRequest" in-map="updateMap"/>
        </actions>
    </service>

</services>
