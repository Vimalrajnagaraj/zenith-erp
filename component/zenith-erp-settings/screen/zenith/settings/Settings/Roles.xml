<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Roles &amp; Access">

    <transition name="createRole">
        <actions>
            <if condition="!ec.user.isInGroup('ADMIN')">
                <return error="true" message="Roles are managed by the platform administrator"/>
            </if>
            <if condition="!userGroupId || !userGroupId.startsWith('ZENITH_')">
                <return error="true" message="Role ID must start with ZENITH_ (e.g. ZENITH_CUSTOM) so it appears in the roles list"/>
            </if>
            <service-call name="create#moqui.security.UserGroup" in-map="[userGroupId:userGroupId, description:description]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="editRole"><default-response url="../EditRole"/></transition>

    <!-- ZE-SETTINGS-003: the platform role catalogue (role IDs, descriptions, user/module counts) is a
         PLATFORM-admin function. A tenant admin (ZENITH_ADMIN) assigns roles on the Users tab, not here —
         bounce them there by any route (menu click or direct URL) so the catalogue isn't disclosed. The
         platform super-admin (ADMIN) is the only one who manages roles here. Runs on render (pre-actions);
         the write transitions above already enforce ADMIN. -->
    <pre-actions>
        <script><![CDATA[
            if (ec.web != null && !ec.user.isInGroup('ADMIN')) {
                ec.message.addMessage("Roles are managed by the platform administrator. You can assign the available roles to your users here.")
                def _shd = (ec.web.getRequest()?.getRequestURI() ?: '').startsWith('/qapps/') ? '/qapps' : '/apps'
                sri.sendRedirectAndStopRender(_shd + "/zenith/Settings/Users")
            }
        ]]></script>
    </pre-actions>

    <actions>
        <entity-find entity-name="moqui.security.UserGroup" list="roleList">
            <econdition field-name="userGroupId" operator="like" value="ZENITH_%"/>
            <order-by field-name="description"/>
        </entity-find>
        <set field="canSettingsAdmin" from="ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN')"/>
        <!-- Custom roles and per-module access edit the platform-wide security model, so they are
             restricted to the platform administrator. Tenant admins get a read-only view. -->
        <set field="isPlatformAdmin" from="ec.user.isInGroup('ADMIN')"/>
    </actions>

    <widgets>
        <section name="SettingsViewGate" condition="canSettingsAdmin"><widgets>
        <render-mode><text type="html"><![CDATA[
        <details open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:0 0 16px 0;font-family:'Segoe UI',Arial,sans-serif">
            <summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128273; Roles &amp; Access &mdash; what this page is for <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary>
            <div style="font-size:13.5px;color:#202124;line-height:1.85;margin-top:10px">
                A <b>role</b> is a job type with a fixed set of permissions &mdash; like <b>Cashier</b>, <b>Store Manager</b> or <b>Accountant</b>. It decides which screens and actions a person can use.<br>
                You don&rsquo;t set permissions person by person. Instead you give a person a <b>role</b> (on the <b>Users</b> tab), and the role carries the permissions.<br>
                The table shows each role, <b>how many users</b> have it, and <b>how many modules</b> it can open.<br>
                The ready-made roles listed below already cover most shops &mdash; you usually don&rsquo;t need to create new ones.
            </div>
        </details>
        ]]></text></render-mode>
        <container style="zenith-grid-container glass-panel">
            <container layout="horizontal" style="items-center q-mb-md">
                <label text="Roles &amp; Access Control" type="h3"/>
                <section name="CreateRoleGate" condition="isPlatformAdmin">
                    <widgets>
                        <container-dialog id="CreateRoleDialog" button-text="Create Custom Role">
                            <form-single name="CreateRoleForm" transition="createRole">
                                <field name="userGroupId"><default-field title="Role ID (e.g. ZENITH_CUSTOM)"><text-line size="25"/></default-field></field>
                                <field name="description"><default-field title="Role Description"><text-line size="50"/></default-field></field>
                                <field name="submitButton"><default-field title="Create Role"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </container>
            <section name="RoleAdminNote" condition="!isPlatformAdmin">
                <widgets>
                    <container style="q-pa-sm q-mb-md bg-blue-1 rounded-borders">
                        <label text="Roles and per-module access are managed by the platform administrator. The list below shows the roles you can assign to your users (see the Users tab)." type="p"/>
                    </container>
                </widgets>
            </section>

            <form-list name="RoleList" list="roleList" skip-form="true">
                <field name="userGroupId">
                    <header-field title="Role ID" show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="description">
                    <header-field title="Description" show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="memberCount">
                    <header-field title="Users"/>
                    <default-field>
                        <label text="${ec.entity.find('moqui.security.UserGroupMember').condition('userGroupId', userGroupId).conditionDate('fromDate', 'thruDate', ec.user.nowTimestamp).count()} users"/>
                    </default-field>
                </field>
                <field name="moduleCount">
                    <header-field title="Modules"/>
                    <default-field>
                        <label text="${ec.entity.find('moqui.security.ArtifactAuthz').condition('userGroupId', userGroupId).count()} modules"/>
                    </default-field>
                </field>
                <field name="manageAccess">
                    <header-field title="Actions"/>
                    <default-field>
                        <section name="ManageAccessGate" condition="isPlatformAdmin">
                            <widgets>
                                <link url="editRole" text="Manage Access" icon="fa fa-key" btn-type="primary" style="q-btn--dense">
                                    <parameter name="userGroupId"/>
                                </link>
                            </widgets>
                            <fail-widgets>
                                <label text="View only" style="text-grey-6 text-caption"/>
                            </fail-widgets>
                        </section>
                    </default-field>
                </field>
            </form-list>
        </container>

        <container style="zenith-grid-container glass-panel q-mt-md">
            <label text="Pre-Defined Role Summary" type="h4" style="q-mb-md"/>
            <container style="q-pa-sm">
                <label text="ZENITH_ALL — Base access for every employee (Dashboard, Discuss, Attendance, Time Off, Expenses, Approvals, Sign, Timesheets)" type="p"/>
                <label text="ZENITH_ADMIN — Full unrestricted access to all modules + Settings" type="p"/>
                <label text="ZENITH_SALES_MGR — Sales, CRM, Contacts, Ecommerce, Sign, Pricing, Promotions + Inventory/Loyalty/Analytics (view)" type="p"/>
                <label text="ZENITH_SALES_EXEC — Sales, CRM + Contacts (view)" type="p"/>
                <label text="ZENITH_PURCHASE_MGR — Purchase, Contacts, Inventory, Integrations" type="p"/>
                <label text="ZENITH_PURCHASE_EXEC — Purchase + Contacts (view)" type="p"/>
                <label text="ZENITH_ACCOUNTANT — Accounting, Tax, Integrations + Sales/Purchase (view)" type="p"/>
                <label text="ZENITH_FINANCE_MGR — Full Accounting, Tax, Payroll, Expenses, Subscriptions + Sales/Purchase/Pricing (view)" type="p"/>
                <label text="ZENITH_HR_MGR — HR, Payroll, Attendance, Time Off, Recruitment, Expenses + Contacts (view)" type="p"/>
                <label text="ZENITH_HR_EXEC — HR, Attendance, Time Off" type="p"/>
                <label text="ZENITH_INVENTORY_MGR — Inventory + Purchase/Manufacturing (view)" type="p"/>
                <label text="ZENITH_STORE_MGR — POS, Inventory, Contacts, Sales, Promotions, Loyalty, Gift Cards, Barcode, Stores, Returns + Pricing/Analytics (view)" type="p"/>
                <label text="ZENITH_CASHIER — POS, Loyalty, Gift Cards, Returns" type="p"/>
                <label text="ZENITH_MFG_MGR — Manufacturing, Quality, PLM, Maintenance, Inventory" type="p"/>
                <label text="ZENITH_MFG_OPERATOR — Manufacturing, Quality" type="p"/>
                <label text="ZENITH_FLEET_MGR — Fleet, Field Service, Maintenance, Distribution" type="p"/>
                <label text="ZENITH_MARKETING — Marketing, Events, Ecommerce, Website + Contacts (view)" type="p"/>
                <label text="ZENITH_HELPDESK — Helpdesk + Contacts (view)" type="p"/>
                <label text="ZENITH_PROJECT_MGR — Projects, Timesheets + HR (view)" type="p"/>
                <label text="ZENITH_AUDITOR — Read-only access to Accounting, Sales, Purchase, Inventory, Payroll" type="p"/>
            </container>
        </container>
        </widgets><fail-widgets><container style="text-center q-pa-xl"><label text="Access Restricted" type="h4" style="text-negative text-weight-bold q-mt-lg"/><label text="This section is available to administrators only." type="p" style="text-grey-7 q-mt-sm"/></container></fail-widgets></section>
    </widgets>
</screen>
