<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Company Setup" default-menu-index="1">

    <transition name="createCompany">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
            <service-call name="zenith.base.CompanyServices.create#Company" in-map="context" out-map="companyOut"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="updateCompany">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
            <if condition="partyId &amp;&amp; partyId != ec.user.getPreference('ACTIVE_ORGANIZATION') &amp;&amp; !ec.user.isInGroup('ADMIN')"><return error="true" message="Cannot modify another organization"/></if>
            <service-call name="zenith.base.CompanyServices.update#Company" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="updateAddress">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
            <if condition="partyId &amp;&amp; partyId != ec.user.getPreference('ACTIVE_ORGANIZATION') &amp;&amp; !ec.user.isInGroup('ADMIN')"><return error="true" message="Cannot modify another organization"/></if>
            <!-- ZE-CONTACTS-019 follow-up: an Indian company PIN must be 6 digits (this address prints on
                 invoices/GST). Country-aware so a non-Indian org (e.g. a US 5-digit ZIP) is not blocked. Blank allowed. -->
            <if condition="countryGeoId == 'IND' &amp;&amp; postalCode &amp;&amp; !(postalCode ==~ /[0-9]{6}/)"><return error="true" message="An Indian PIN code must be exactly 6 digits (numbers only)."/></if>
            <entity-find entity-name="mantle.party.contact.PartyContactMech" list="existingCmList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="PostalPrimary"/>
                <date-filter/>
            </entity-find>
            <if condition="existingCmList">
                <set field="contactMechId" from="existingCmList[0].contactMechId"/>
                <service-call name="update#mantle.party.contact.PostalAddress"
                              in-map="[contactMechId:contactMechId, address1:address1, address2:address2,
                                       city:city, postalCode:postalCode, stateProvinceGeoId:stateProvinceGeoId,
                                       countryGeoId:countryGeoId]"/>
            <else>
                <service-call name="mantle.party.ContactServices.create#PostalAddress"
                              in-map="[partyId:partyId, address1:address1, address2:address2,
                                       city:city, postalCode:postalCode, stateProvinceGeoId:stateProvinceGeoId,
                                       countryGeoId:countryGeoId, contactMechPurposeId:'PostalPrimary']"/>
            </else>
            </if>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="updateContactInfo">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
            <if condition="partyId &amp;&amp; partyId != ec.user.getPreference('ACTIVE_ORGANIZATION') &amp;&amp; !ec.user.isInGroup('ADMIN')"><return error="true" message="Cannot modify another organization"/></if>
            <!-- Validate the email format if one was entered. Blank is allowed and CLEARS the stored email
                 (the old behaviour silently ignored an empty value, so a cleared email reverted with no
                 feedback). -->
            <script><![CDATA[
                if (emailAddress?.trim()) {
                    emailAddress = emailAddress.trim()
                    if (!(emailAddress ==~ /[^@\s]+@[^@\s]+\.[^@\s]+/)) {
                        ec.message.addError("Enter a valid company email, e.g. name@company.com.")
                    }
                }
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>

            <!-- Email: update the primary email, create it, or (when cleared) expire it so empty persists. -->
            <entity-find entity-name="mantle.party.contact.PartyContactMech" list="emailCmList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="EmailPrimary"/>
                <date-filter/>
            </entity-find>
            <if condition="emailAddress">
                <if condition="emailCmList">
                    <service-call name="update#mantle.party.contact.ContactMech"
                                  in-map="[contactMechId:emailCmList[0].contactMechId, infoString:emailAddress]"/>
                <else>
                    <service-call name="create#mantle.party.contact.ContactMech" out-map="_newEcm"
                                  in-map="[contactMechTypeEnumId:'CmtEmailAddress', infoString:emailAddress]"/>
                    <service-call name="create#mantle.party.contact.PartyContactMech"
                                  in-map="[partyId:partyId, contactMechId:_newEcm.contactMechId,
                                           contactMechPurposeId:'EmailPrimary', fromDate:ec.user.nowTimestamp]"/>
                </else>
                </if>
            <else>
                <iterate list="emailCmList" entry="_ecm">
                    <service-call name="update#mantle.party.contact.PartyContactMech"
                                  in-map="[partyId:_ecm.partyId, contactMechId:_ecm.contactMechId,
                                           contactMechPurposeId:_ecm.contactMechPurposeId, fromDate:_ecm.fromDate,
                                           thruDate:ec.user.nowTimestamp]"/>
                </iterate>
            </else>
            </if>

            <!-- Phone: same — update, create, or (when cleared) expire the primary phone. -->
            <entity-find entity-name="mantle.party.contact.PartyContactMech" list="phoneCmList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="PhonePrimary"/>
                <date-filter/>
            </entity-find>
            <if condition="phoneNumber">
                <if condition="phoneCmList">
                    <service-call name="update#mantle.party.contact.TelecomNumber"
                                  in-map="[contactMechId:phoneCmList[0].contactMechId, contactNumber:phoneNumber]"/>
                <else>
                    <service-call name="create#mantle.party.contact.ContactMech" out-map="_newPcm"
                                  in-map="[contactMechTypeEnumId:'CmtTelecomNumber']"/>
                    <service-call name="create#mantle.party.contact.TelecomNumber"
                                  in-map="[contactMechId:_newPcm.contactMechId, contactNumber:phoneNumber]"/>
                    <service-call name="create#mantle.party.contact.PartyContactMech"
                                  in-map="[partyId:partyId, contactMechId:_newPcm.contactMechId,
                                           contactMechPurposeId:'PhonePrimary', fromDate:ec.user.nowTimestamp]"/>
                </else>
                </if>
            <else>
                <iterate list="phoneCmList" entry="_pcm">
                    <service-call name="update#mantle.party.contact.PartyContactMech"
                                  in-map="[partyId:_pcm.partyId, contactMechId:_pcm.contactMechId,
                                           contactMechPurposeId:_pcm.contactMechPurposeId, fromDate:_pcm.fromDate,
                                           thruDate:ec.user.nowTimestamp]"/>
                </iterate>
            </else>
            </if>

            <message>Contact information saved.</message>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="saveSetting">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
            <service-call name="store#zenith.erp.base.CompanySettings"
                          in-map="[organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION'), settingKey:settingKey,
                                   settingValue:settingValue, description:description]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="createBranch">
        <actions>
            <if condition="!(ec.user.isInGroup('ZENITH_ADMIN') || ec.user.isInGroup('ADMIN'))"><return error="true" message="Only an administrator can change settings"/></if>
        <service-call name="create#zenith.erp.base.CompanyBranch"
                      in-map="[organizationPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION'), branchName:branchName,
                               taxRegistrationNumber:branchTaxRegNumber, isHeadOffice:isHeadOffice,
                               countryGeoId:branchCountryGeoId, regionGeoId:branchRegionGeoId,
                               currencyUomId:branchCurrencyUomId]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- Find existing internal organizations -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="organizationName"/>
        </entity-find>

        <set field="hasCompany" from="orgList ? true : false"/>

        <!-- If company exists, load its details -->
        <if condition="hasCompany">
            <set field="org" from="orgList[0]"/>
            <set field="partyId" from="org.partyId"/>

            <!-- Load primary address -->
            <entity-find entity-name="mantle.party.contact.PartyContactMechPostalAddress" list="addressList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="PostalPrimary"/>
                <date-filter/>
            </entity-find>
            <set field="addr" from="addressList ? addressList[0] : null"/>

            <!-- Load email -->
            <entity-find entity-name="mantle.party.contact.PartyContactMechInfo" list="emailList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="EmailPrimary"/>
                <date-filter/>
            </entity-find>
            <set field="companyEmail" from="emailList ? emailList[0].infoString : ''"/>

            <!-- Load phone -->
            <entity-find entity-name="mantle.party.contact.PartyContactMechTelecomNumber" list="phoneList">
                <econdition field-name="partyId"/>
                <econdition field-name="contactMechPurposeId" value="PhonePrimary"/>
                <date-filter/>
            </entity-find>
            <set field="companyPhone" from="phoneList ? phoneList[0].contactNumber : ''"/>

            <!-- Load PAN -->
            <entity-find entity-name="mantle.party.PartyIdentification" list="panList">
                <econdition field-name="partyId"/>
                <econdition field-name="partyIdTypeEnumId" value="PtidTaxId"/>
            </entity-find>
            <set field="panNumber" from="panList ? panList[0].idValue : ''"/>

            <!-- Load primary tax registration (GSTIN / EIN / VAT) so it can be edited -->
            <entity-find entity-name="zenith.erp.tax.TaxRegistration" list="taxRegList" limit="1">
                <econdition field-name="partyId"/>
                <order-by field-name="-isDefault"/>
            </entity-find>
            <set field="taxRegNumber" from="taxRegList ? taxRegList[0].registrationNumber : ''"/>

            <!-- Load company settings -->
            <entity-find entity-name="zenith.erp.base.CompanySettings" list="settingsList">
                <econdition field-name="organizationPartyId" from="partyId"/>
            </entity-find>
            <set field="settingsMap" from="[:]"/>
            <iterate list="settingsList" entry="s">
                <set field="settingsMap[s.settingKey]" from="s.settingValue"/>
            </iterate>

            <!-- Load branches -->
            <entity-find entity-name="zenith.erp.base.CompanyBranch" list="branchList">
                <econdition field-name="organizationPartyId" from="partyId"/>
                <order-by field-name="branchName"/>
            </entity-find>
        </if>

        <!-- Country list for dropdowns -->
        <entity-find entity-name="zenith.erp.base.CountryConfiguration" list="countryList">
            <order-by field-name="countryName"/>
        </entity-find>

        <!-- States/provinces of the company's country, so the address State field is a readable
             dropdown (e.g. "Tamil Nadu") instead of a raw geo code (e.g. "IND_TN").
             addr?. / settingsMap?. safely yield null when no company is loaded. -->
        <set field="stateList" from="[]"/>
        <set field="companyCountry" from="addr?.countryGeoId ?: settingsMap?.COUNTRY_GEO_ID"/>
        <if condition="companyCountry">
            <entity-find entity-name="moqui.basic.GeoAssoc" list="stateAssocList">
                <econdition field-name="geoId" from="companyCountry"/>
                <econdition field-name="geoAssocTypeEnumId" value="GAT_REGIONS"/>
            </entity-find>
            <set field="stateIds" from="stateAssocList.collect{ it.toGeoId }"/>
            <if condition="stateIds">
                <entity-find entity-name="moqui.basic.Geo" list="stateList">
                    <econdition field-name="geoId" operator="in" from="stateIds"/>
                    <order-by field-name="geoName"/>
                </entity-find>
            </if>
        </if>
    </actions>

    <widgets>
        <!-- Beginner help banner (collapsible, no JS needed — native <details>) -->
        <render-mode><text type="html"><![CDATA[
        <details open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:0 0 16px 0;font-family:'Segoe UI',Arial,sans-serif">
            <summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#127970; Company Setup &mdash; what this page is for <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary>
            <div style="font-size:13.5px;color:#202124;line-height:1.85;margin-top:10px">
                This is your business&rsquo;s <b>master profile</b>. What you enter here appears on your <b>invoices, bills and official documents</b>.<br>
                <b>1</b>&nbsp;<b>General Information</b> &mdash; your company name and tax IDs.<br>
                <b>2</b>&nbsp;<b>Registered Address</b> and <b>Contact Information</b> &mdash; where you are and how customers reach you.<br>
                <b>3</b>&nbsp;<b>Branches</b> &mdash; add a row for each extra shop or location you run (skip this if you have only one).<br>
                <div style="background:#fff3cd;border:1px solid #ffe082;border-radius:7px;padding:8px 11px;margin-top:8px;color:#6d4c00">
                    <b>Tax IDs (India), in plain words:</b> &nbsp;<b>GSTIN</b> = your GST registration number &middot; <b>PAN</b> = the company&rsquo;s PAN card number &middot; <b>TAN</b> = needed only if you deduct TDS &middot; <b>CIN</b> = only for registered companies (Pvt Ltd / Ltd). <b>Leave blank anything you don&rsquo;t have</b> &mdash; a small shop often has none of these.
                </div>
            </div>
        </details>
        ]]></text></render-mode>

        <!-- ======== NO COMPANY YET — Show Create Form ======== -->
        <section name="NoCompanySection">
            <condition><expression>!hasCompany</expression></condition>
            <widgets>
                <container style="zenith-grid-container glass-panel">
                    <label text="Company Setup" type="h3" style="q-mb-md"/>
                    <container style="q-pa-sm q-mb-md bg-amber-1 rounded-borders">
                        <label text="No company has been set up yet. Create your organization to get started with the ERP system." type="p"/>
                    </container>

                    <form-single name="CreateCompanyForm" transition="createCompany">
                        <field name="organizationName"><default-field title="Company Name"><text-line size="50"/></default-field></field>
                        <field name="orgCode"><default-field title="Organization ID (login code)"><text-line size="20"/>
                            <label text="A short unique code used to log in and identify this company (e.g. ACME, TATA001). Required." style="text-grey-6 text-caption" type="p"/></default-field></field>
                        <field name="countryGeoId"><default-field title="Country">
                            <drop-down>
                                <list-options list="countryList" key="${countryGeoId}" text="${countryName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="taxRegistrationNumber"><default-field title="Tax Reg. No. (GSTIN / EIN / VAT)"><text-line size="30"/></default-field></field>
                        <field name="panNumber"><default-field title="PAN Number (India)"><text-line size="20"/></default-field></field>
                        <field name="tanNumber"><default-field title="TAN Number (India)"><text-line size="20"/></default-field></field>
                        <field name="cinNumber"><default-field title="CIN Number (India)"><text-line size="25"/></default-field></field>
                        <field name="address1"><default-field title="Address Line 1"><text-line size="60"/></default-field></field>
                        <field name="city"><default-field title="City"><text-line size="30"/></default-field></field>
                        <field name="regionGeoId"><default-field title="State / Province"><text-line size="20"/></default-field></field>
                        <field name="postalCode"><default-field title="Postal Code"><text-line size="10"/></default-field></field>
                        <field name="emailAddress"><default-field title="Company Email"><text-line size="40"/></default-field></field>
                        <field name="phoneNumber"><default-field title="Phone"><text-line size="20"/></default-field></field>
                        <field name="currencyUomId"><default-field title="Currency">
                            <drop-down allow-empty="true">
                                <option key="INR" text="Indian Rupee (${currSymbol})"/>
                                <option key="USD" text="US Dollar (USD)"/>
                                <option key="GBP" text="British Pound (GBP)"/>
                                <option key="EUR" text="Euro (EUR)"/>
                                <option key="AED" text="UAE Dirham (AED)"/>
                                <option key="SAR" text="Saudi Riyal (SAR)"/>
                                <option key="SGD" text="Singapore Dollar (SGD)"/>
                                <option key="AUD" text="Australian Dollar (AUD)"/>
                                <option key="CAD" text="Canadian Dollar (CAD)"/>
                                <option key="JPY" text="Japanese Yen (JPY)"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Create Company"><submit/></default-field></field>

                        <field-layout>
                            <field-row><field-ref name="organizationName"/><field-ref name="orgCode"/></field-row>
                            <field-row><field-ref name="countryGeoId"/></field-row>
                            <field-row><field-ref name="taxRegistrationNumber"/><field-ref name="panNumber"/></field-row>
                            <field-row><field-ref name="tanNumber"/><field-ref name="cinNumber"/></field-row>
                            <field-row><field-ref name="address1"/></field-row>
                            <field-row><field-ref name="city"/><field-ref name="regionGeoId"/><field-ref name="postalCode"/></field-row>
                            <field-row><field-ref name="emailAddress"/><field-ref name="phoneNumber"/></field-row>
                            <field-row><field-ref name="currencyUomId"/></field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container>
            </widgets>
        </section>

        <!-- ======== COMPANY EXISTS — Show Details + Edit ======== -->
        <section name="HasCompanySection">
            <condition><expression>hasCompany</expression></condition>
            <widgets>
                <!-- Company Header -->
                <container style="zenith-grid-container glass-panel q-mb-md">
                    <container layout="horizontal" style="items-center q-mb-md">
                        <label text="Company Profile" type="h3"/>
                    </container>

                    <!-- Basic Info Card -->
                    <container-box><box-header title="General Information"/><box-body>
                        <form-single name="UpdateCompanyForm" transition="updateCompany"
                                     map="[partyId:partyId, organizationName:org.organizationName,
                                           taxRegistrationNumber:taxRegNumber, panNumber:panNumber,
                                           tanNumber:(settingsMap?.TAN_NUMBER ?: ''), cinNumber:(settingsMap?.CIN_NUMBER ?: '')]">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="organizationName"><default-field title="Company Name"><text-line size="50"/></default-field></field>
                            <field name="taxRegistrationNumber"><default-field title="Tax Reg. No. (GSTIN / EIN / VAT)"><text-line size="30"/></default-field></field>
                            <field name="panNumber"><default-field title="PAN Number"><text-line size="20"/></default-field></field>
                            <field name="tanNumber"><default-field title="TAN Number"><text-line size="20"/></default-field></field>
                            <field name="cinNumber"><default-field title="CIN Number"><text-line size="25"/></default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="organizationName"/><field-ref name="taxRegistrationNumber"/></field-row>
                                <field-row><field-ref name="panNumber"/><field-ref name="tanNumber"/><field-ref name="cinNumber"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body></container-box>
                </container>

                <!-- Address Card -->
                <container style="zenith-grid-container glass-panel q-mb-md">
                    <container-box><box-header title="Registered Address"/><box-body>
                        <form-single name="UpdateAddressForm" transition="updateAddress"
                                     map="[partyId:partyId, address1:addr?.address1, address2:addr?.address2,
                                           city:addr?.city, postalCode:addr?.postalCode,
                                           stateProvinceGeoId:addr?.stateProvinceGeoId,
                                           countryGeoId:addr?.countryGeoId ?: settingsMap?.COUNTRY_GEO_ID]">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="address1"><default-field title="Address Line 1"><text-line size="60"/></default-field></field>
                            <field name="address2"><default-field title="Address Line 2"><text-line size="60"/></default-field></field>
                            <field name="city"><default-field title="City"><text-line size="30"/></default-field></field>
                            <field name="stateProvinceGeoId">
                                <!-- Dropdown of real state names when the country has seeded states (e.g. India);
                                     falls back to a plain text box for countries without a state list. -->
                                <conditional-field title="State / Province" condition="stateList">
                                    <drop-down allow-empty="true">
                                        <list-options list="stateList" key="${geoId}" text="${geoName}"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="State / Province"><text-line size="20"/></default-field>
                            </field>
                            <field name="postalCode"><default-field title="Postal Code"><text-line size="10"/></default-field></field>
                            <field name="countryGeoId"><default-field title="Country">
                                <drop-down>
                                    <list-options list="countryList" key="${countryGeoId}" text="${countryName}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Update Address"><submit/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="address1"/></field-row>
                                <field-row><field-ref name="address2"/></field-row>
                                <field-row><field-ref name="city"/><field-ref name="stateProvinceGeoId"/><field-ref name="postalCode"/></field-row>
                                <field-row><field-ref name="countryGeoId"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body></container-box>
                </container>

                <!-- Contact Info Card -->
                <container style="zenith-grid-container glass-panel q-mb-md">
                    <container-box><box-header title="Contact Information"/><box-body>
                        <form-single name="UpdateContactForm" transition="updateContactInfo"
                                     map="[partyId:partyId, emailAddress:companyEmail, phoneNumber:companyPhone]">
                            <field name="partyId"><default-field><hidden/></default-field></field>
                            <field name="emailAddress"><default-field title="Company Email"><text-line size="40"/></default-field></field>
                            <field name="phoneNumber"><default-field title="Phone"><text-line size="20"/></default-field></field>
                            <field name="submitButton"><default-field title="Update Contact"><submit/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="emailAddress"/><field-ref name="phoneNumber"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body></container-box>
                </container>

                <!-- Settings Card -->
                <container style="zenith-grid-container glass-panel q-mb-md">
                    <container-box><box-header title="System Settings"/><box-body>
                        <container style="row q-col-gutter-md">
                            <container style="col-12 col-md-4">
                                <label text="Country" type="p" style="text-weight-bold"/>
                                <label text="${settingsMap?.COUNTRY_GEO_ID ?: 'Not Set'}" type="p"/>
                            </container>
                            <container style="col-12 col-md-4">
                                <label text="Currency" type="p" style="text-weight-bold"/>
                                <label text="${settingsMap?.CURRENCY_UOM_ID ?: 'Not Set'}" type="p"/>
                            </container>
                            <container style="col-12 col-md-4">
                                <label text="Financial Year Starts" type="p" style="text-weight-bold"/>
                                <label text="${settingsMap?.FY_START_MONTH == '4' ? 'April (Month 4)' : settingsMap?.FY_START_MONTH == '1' ? 'January (Month 1)' : 'Month ' + (settingsMap?.FY_START_MONTH ?: 'Not Set')}" type="p"/>
                            </container>
                        </container>
                    </box-body></container-box>
                </container>

                <!-- Branches Section -->
                <container style="zenith-grid-container glass-panel q-mb-md">
                    <container layout="horizontal" style="items-center q-mb-md">
                        <label text="Company Branches / Locations" type="h4"/>
                        <container-dialog id="CreateBranchDialog" button-text="Add Branch">
                            <form-single name="CreateBranchForm" transition="createBranch">
                                <field name="organizationPartyId" from="partyId"><default-field><hidden/></default-field></field>
                                <field name="branchName"><default-field title="Branch Name"><text-line size="40"/></default-field></field>
                                <field name="branchTaxRegNumber"><default-field title="Branch Tax Reg. No. (GSTIN)"><text-line size="25"/></default-field></field>
                                <field name="isHeadOffice"><default-field title="Is Head Office?">
                                    <drop-down allow-empty="false">
                                        <option key="N" text="No"/>
                                        <option key="Y" text="Yes"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="branchCountryGeoId"><default-field title="Country">
                                    <drop-down>
                                        <list-options list="countryList" key="${countryGeoId}" text="${countryName}"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="branchRegionGeoId"><default-field title="State / Region"><text-line size="15"/></default-field></field>
                                <field name="branchCurrencyUomId"><default-field title="Currency">
                                    <drop-down allow-empty="true">
                                        <option key="INR" text="INR"/><option key="USD" text="USD"/>
                                        <option key="GBP" text="GBP"/><option key="EUR" text="EUR"/>
                                        <option key="AED" text="AED"/>
                                    </drop-down>
                                </default-field></field>
                                <field name="submitButton"><default-field title="Add Branch"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>

                    <section name="BranchListSection">
                        <condition><expression>branchList</expression></condition>
                        <widgets>
                            <form-list name="BranchList" list="branchList" skip-form="true">
                                <field name="branchId">
                                    <header-field title="Branch ID"/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="branchName">
                                    <header-field title="Name" show-order-by="true"/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="taxRegistrationNumber">
                                    <header-field title="Tax Reg. No."/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="isHeadOffice">
                                    <header-field title="Head Office?"/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="countryGeoId">
                                    <header-field title="Country"/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="regionGeoId">
                                    <header-field title="State"/>
                                    <default-field><display/></default-field>
                                </field>
                            </form-list>
                        </widgets>
                        <fail-widgets>
                            <label text="No branches added yet. Click 'Add Branch' to create branch/location entries." type="p" style="text-grey-7"/>
                        </fail-widgets>
                    </section>
                </container>

                <!-- All Companies (if multiple) -->
                <section name="MultiCompanySection">
                    <condition><expression>orgList.size() > 1</expression></condition>
                    <widgets>
                        <container style="zenith-grid-container glass-panel">
                            <label text="All Organizations" type="h4" style="q-mb-md"/>
                            <form-list name="OrgList" list="orgList" skip-form="true">
                                <field name="partyId">
                                    <header-field title="Party ID"/>
                                    <default-field><display/></default-field>
                                </field>
                                <field name="organizationName">
                                    <header-field title="Organization Name" show-order-by="true"/>
                                    <default-field><display/></default-field>
                                </field>
                            </form-list>
                        </container>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
