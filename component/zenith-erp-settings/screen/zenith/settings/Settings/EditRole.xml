<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Role Access" default-menu-include="false">

    <parameter name="userGroupId" required="true"/>

    <transition name="saveAccess">
        <service-call name="zenith.settings.SettingsServices.save#RoleModuleAccess"
                      in-map="[userGroupId:userGroupId, artifactGroupId:artifactGroupId, accessLevel:accessLevel]"
                      multi="parameter"/>
        <default-response url="."/>
    </transition>
    <transition name="backToRoles"><default-response url="../Roles"/></transition>

    <actions>
        <entity-find-one entity-name="moqui.security.UserGroup" value-field="roleInfo"/>

        <entity-find entity-name="moqui.security.ArtifactGroup" list="allArtifactGroups">
            <econdition field-name="artifactGroupId" operator="like" value="Z_%"/>
            <order-by field-name="description"/>
        </entity-find>

        <entity-find entity-name="moqui.security.ArtifactAuthz" list="currentAuthzList">
            <econdition field-name="userGroupId"/>
        </entity-find>

        <set field="authzMap" from="[:]"/>
        <iterate list="currentAuthzList" entry="authz">
            <set field="authzMap[authz.artifactGroupId]" from="authz.authzActionEnumId == 'AUTHZA_ALL' ? 'FULL' : 'VIEW'"/>
        </iterate>

        <set field="moduleAccessList" from="[]"/>
        <iterate list="allArtifactGroups" entry="ag">
            <set field="currentAccess" from="authzMap[ag.artifactGroupId] ?: 'NONE'"/>
            <script>moduleAccessList.add([artifactGroupId:ag.artifactGroupId, moduleName:ag.description, accessLevel:currentAccess, userGroupId:userGroupId])</script>
        </iterate>
        <!-- Saving module access edits the platform-wide security model — platform administrator only. -->
        <set field="isPlatformAdmin" from="ec.user.isInGroup('ADMIN')"/>
    </actions>

    <widgets>
        <container style="q-pa-md">
            <container layout="horizontal" style="items-center q-mb-md q-gutter-md">
                <link url="backToRoles" text="Back to Roles" icon="fa fa-arrow-left" btn-type="default"/>
                <label text="Manage Access: ${roleInfo?.description ?: userGroupId}" type="h3"/>
            </container>

            <render-mode><text type="html"><![CDATA[
            <details open style="background:#e8f0fe;border:1px solid #4285f4;border-left:6px solid #1a73e8;border-radius:10px;padding:10px 16px;margin:0 0 16px 0;font-family:'Segoe UI',Arial,sans-serif">
                <summary style="cursor:pointer;font-weight:800;font-size:15px;color:#174ea6;outline:none">&#128273; What does each access level mean? <span style="font-weight:600;color:#5f6368;font-size:12px">(click to hide / show)</span></summary>
                <div style="font-size:13.5px;color:#202124;line-height:1.95;margin-top:10px">
                    This sets what people with this role can do in each part of the system.<br>
                    &#11044;&nbsp;<b>No Access</b> &mdash; they can&rsquo;t see or open this module at all.<br>
                    &#11044;&nbsp;<b>View Only</b> &mdash; they can look but not change anything (good for reports and auditors).<br>
                    &#11044;&nbsp;<b>Full Access</b> &mdash; they can add, edit and delete (for the people who run that area).<br>
                    Set the dropdowns you need, then click <b>Save All Access</b> once at the bottom.
                </div>
            </details>
            ]]></text></render-mode>

            <section name="ReadOnlyNotice" condition="!isPlatformAdmin">
                <widgets>
                    <container style="q-pa-sm q-mb-md bg-amber-1 rounded-borders">
                        <label text="Read-only. Module access for roles is managed by the platform administrator." type="p"/>
                    </container>
                </widgets>
            </section>

            <form-list name="ModuleAccessForm" list="moduleAccessList" transition="saveAccess" multi="true">
                <field name="userGroupId"><default-field><hidden/></default-field></field>
                <field name="artifactGroupId"><default-field><hidden/></default-field></field>
                <field name="moduleName">
                    <header-field title="Module" show-order-by="true"/>
                    <default-field><display/></default-field>
                </field>
                <field name="accessLevel">
                    <header-field title="Access Level"/>
                    <default-field>
                        <drop-down allow-empty="false" current="selected">
                            <option key="NONE" text="No Access"/>
                            <option key="VIEW" text="View Only"/>
                            <option key="FULL" text="Full Access"/>
                        </drop-down>
                    </default-field>
                </field>
                <field name="submitButton"><default-field title="">
                    <section name="SaveAccessGate" condition="isPlatformAdmin">
                        <widgets><submit text="Save All Access"/></widgets>
                    </section>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
