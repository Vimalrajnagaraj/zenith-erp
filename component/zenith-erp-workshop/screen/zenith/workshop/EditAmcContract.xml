<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit AMC" default-menu-include="false">

    <parameter name="amcContractId" required="true"/>

    <transition name="updateAmc">
        <service-call name="update#zenith.erp.workshop.AmcContract"/>
        <default-response url="."/>
    </transition>
    <transition name="recordVisit">
        <service-call name="zenith.workshop.WorkshopServices.record#AmcVisit"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.workshop.AmcContract" value-field="contract"/>
        <entity-find entity-name="zenith.erp.workshop.AmcServiceVisit" list="visits">
            <econdition field-name="amcContractId"/>
            <order-by field-name="-visitDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="AMC Contract: ${amcContractId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Contract Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="AmcForm" map="contract" transition="updateAmc">
                        <field name="amcContractId"><default-field><hidden/></default-field></field>
                        <field name="customerPartyId"><default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                        </default-field></field>
                        <field name="contractTypeEnumId"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="contractAmount"><default-field><display format="#,##0.00"/></default-field></field>
                        <field name="startDate"><default-field><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="endDate"><default-field><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <entity-options key="${toStatusId}" text="${transitionName}">
                                    <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                        <econdition field-name="statusFlowId" value="Default"/>
                                        <econdition field-name="statusId" from="contract.statusId"/>
                                    </entity-find>
                                </entity-options>
                                <option key="${contract.statusId}" text="${contract.statusId}"/>
                            </drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Service Visits" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="RecordVisit" button-text="Record Visit" type="info">
                            <form-single name="VisitForm" transition="recordVisit">
                                <field name="amcContractId" from="contract.amcContractId"><default-field><hidden/></default-field></field>
                                <field name="visitDate"><default-field><date-time type="date"/></default-field></field>
                                <field name="visitTypeEnumId"><default-field title="Type">
                                    <drop-down><entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="AmcVisitType"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="findings"><default-field><text-area rows="3" cols="40"/></default-field></field>
                                <field name="actionTaken"><default-field><text-area rows="3" cols="40"/></default-field></field>
                                <field name="nextVisitDate"><default-field><date-time type="date"/></default-field></field>
                                <field name="submitBtn"><default-field title="Record"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="VisitsForm" list="visits" skip-form="true">
                        <field name="visitDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="visitTypeEnumId"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="findings"><default-field><display/></default-field></field>
                        <field name="actionTaken"><default-field title="Action"><display/></default-field></field>
                        <field name="nextVisitDate"><default-field title="Next Visit"><display format="dd-MMM-yyyy"/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Visits" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${contract.visitsUsed ?: 0} / ${contract.visitsIncluded ?: 'Unlimited'}" type="h4" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${contract.statusId}" type="h5" style="text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
