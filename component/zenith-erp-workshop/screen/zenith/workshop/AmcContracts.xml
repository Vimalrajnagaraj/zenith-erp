<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="AMC Contracts" default-menu-index="2">

    <transition name="editAmc"><default-response url="../EditAmcContract"/></transition>
    <transition name="createAmc">
        <service-call name="zenith.workshop.WorkshopServices.create#AmcContract"/>
        <default-response url="../EditAmcContract"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.workshop.AmcContract" list="contracts">
            <search-form-inputs default-order-by="-startDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="AMC Contracts" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateAmc" button-text="New Contract" type="success">
                <form-single name="CreateAmcForm" transition="createAmc">
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down allow-empty="true"><entity-options key="${productId}" text="${productName}">
                            <entity-find entity-name="mantle.product.Product"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                    <field name="contractTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="AmcContractType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="startDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="endDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="contractAmount"><default-field><text-line size="12"/></default-field></field>
                    <field name="visitsIncluded"><default-field title="Visits Included"><text-line size="5"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AmcForm" list="contracts" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="amcContractId"><default-field title="Contract #">
                    <link url="editAmc" text="${amcContractId}" parameter-map="[amcContractId:amcContractId]"/>
                </default-field></field>
                <field name="customerPartyId"><default-field title="Customer">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="contractTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="startDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="endDate"><default-field title="End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="contractAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="visitsIncluded"><default-field title="Visits"><display/></default-field></field>
                <field name="visitsUsed"><default-field title="Used"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="AmcActive" text="Active"/><option key="AmcExpired" text="Expired"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
