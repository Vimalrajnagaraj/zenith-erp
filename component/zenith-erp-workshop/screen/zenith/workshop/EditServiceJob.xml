<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Job" default-menu-include="false">

    <parameter name="serviceJobId" required="true"/>

    <transition name="updateJob">
        <service-call name="update#zenith.erp.workshop.ServiceJob"/>
        <default-response url="."/>
    </transition>
    <transition name="addPart">
        <service-call name="zenith.workshop.WorkshopServices.add#ServiceJobPart"/>
        <default-response url="."/>
    </transition>
    <transition name="completeJob">
        <service-call name="zenith.workshop.WorkshopServices.complete#ServiceJob"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.workshop.ServiceJob" value-field="job"/>
        <entity-find entity-name="zenith.erp.workshop.ServiceJobPart" list="parts">
            <econdition field-name="serviceJobId"/></entity-find>
        <entity-find entity-name="zenith.erp.workshop.ServiceJobLabor" list="labor">
            <econdition field-name="serviceJobId"/></entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Service Job: ${serviceJobId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Job Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="JobForm" map="job" transition="updateJob">
                        <field name="serviceJobId"><default-field><hidden/></default-field></field>
                        <field name="customerPartyId"><default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                        </default-field></field>
                        <field name="brandName"><default-field><text-line size="15"/></default-field></field>
                        <field name="modelName"><default-field><text-line size="15"/></default-field></field>
                        <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                        <field name="issueDescription"><default-field title="Issue"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="technicianNotes"><default-field><text-area rows="3" cols="40"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <entity-options key="${toStatusId}" text="${transitionName}">
                                    <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                        <econdition field-name="statusFlowId" value="Default"/>
                                        <econdition field-name="statusId" from="job.statusId"/>
                                    </entity-find>
                                </entity-options>
                                <option key="${job.statusId}" text="${job.statusId}"/>
                            </drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <!-- Parts -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Parts Used" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="AddPart" button-text="Add Part" type="info">
                            <form-single name="AddPartForm" transition="addPart">
                                <field name="serviceJobId" from="job.serviceJobId"><default-field><hidden/></default-field></field>
                                <field name="productId"><default-field title="Part">
                                    <drop-down><entity-options key="${productId}" text="${productName}">
                                        <entity-find entity-name="mantle.product.Product">
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        </entity-find>
                                    </entity-options></drop-down></default-field></field>
                                <field name="quantity"><default-field><text-line size="5" default-value="1"/></default-field></field>
                                <field name="unitCost"><default-field><text-line size="10"/></default-field></field>
                                <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="PartsForm" list="parts" skip-form="true">
                        <field name="productId"><default-field title="Part">
                            <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                        </default-field></field>
                        <field name="quantity"><default-field><display/></default-field></field>
                        <field name="unitCost"><default-field><display format="#,##0.00"/></default-field></field>
                        <field name="totalCost"><default-field title="Total"><display format="#,##0.00"/></default-field></field>
                        <field name="isChargeable"><default-field title="Charge"><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${job.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Total Cost" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${zinr.inr(ec.l10n.format(job.totalCost ?: 0, '#,##0.00'))}" type="h4" style="text-dark text-weight-bold q-my-sm"/>
                </container>
                <section name="WarrantyBadge" condition="job.isUnderWarranty == 'Y'">
                    <widgets>
                        <container style="zenith-card bg-positive shadow-2 border-radius-lg q-pa-lg q-mb-md text-center text-white">
                            <label text="Under Warranty" type="h5" style="text-weight-bold"/>
                        </container>
                    </widgets>
                </section>
            </row-col>
        </container-row>
    </widgets>
</screen>
