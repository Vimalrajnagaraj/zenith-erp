<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Service Jobs" default-menu-index="1">

    <transition name="editJob"><default-response url="../EditServiceJob"/></transition>
    <transition name="createJob">
        <service-call name="zenith.workshop.WorkshopServices.create#ServiceJob"/>
        <default-response url="../EditServiceJob"/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning party -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.workshop.ServiceJobDetail" list="jobs">
            <econdition field-name="customerPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-receivedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Service Jobs" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateJob" button-text="New Job" type="success">
                <form-single name="CreateJobForm" transition="createJob">
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down allow-empty="true"><entity-options key="${productId}" text="${productName}">
                            <entity-find entity-name="mantle.product.Product">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                    <field name="brandName"><default-field><text-line size="15"/></default-field></field>
                    <field name="modelName"><default-field><text-line size="15"/></default-field></field>
                    <field name="serviceTypeEnumId"><default-field title="Service Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="ServiceType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="issueDescription"><default-field title="Issue"><text-area rows="3" cols="40"/></default-field></field>
                    <field name="estimatedCost"><default-field><text-line size="10"/></default-field></field>
                    <field name="promisedDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="JobsForm" list="jobs" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="serviceJobId"><default-field title="Job #">
                    <link url="editJob" text="${serviceJobId}" parameter-map="[serviceJobId:serviceJobId]"/>
                </default-field></field>
                <field name="firstName"><default-field title="Customer">
                    <display text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></default-field></field>
                <field name="brandName"><default-field title="Brand"><display/></default-field></field>
                <field name="modelName"><default-field title="Model"><display/></default-field></field>
                <field name="serviceTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="receivedDate"><default-field title="Received"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="promisedDate"><default-field title="Promised"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="totalCost"><default-field title="Cost"><display format="#,##0.00"/></default-field></field>
                <field name="isUnderWarranty"><default-field title="Warranty"><display/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="SjReceived" text="Received"/><option key="SjInProgress" text="In Progress"/>
                        <option key="SjCompleted" text="Completed"/><option key="SjDelivered" text="Delivered"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
