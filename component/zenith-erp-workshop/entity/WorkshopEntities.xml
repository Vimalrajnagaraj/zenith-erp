<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Service Job: repair/maintenance work order -->
    <entity entity-name="ServiceJob" package="zenith.erp.workshop" table-name="ZENITH_SERVICE_JOB" short-alias="ServiceJob">
        <field name="serviceJobId" type="id" is-pk="true"/>
        <field name="jobNumber" type="text-short"/>
        <field name="customerPartyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="serialNumber" type="text-short"/>
        <field name="brandName" type="text-medium"/>
        <field name="modelName" type="text-medium"/>
        <field name="serviceTypeEnumId" type="id"/>
        <field name="priorityEnumId" type="id"/>
        <field name="issueDescription" type="text-long"/>
        <field name="receivedDate" type="date-time"/>
        <field name="promisedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="deliveredDate" type="date-time"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="estimatedCost" type="currency-amount"/>
        <field name="actualLaborCost" type="currency-amount" default="0"/>
        <field name="actualPartsCost" type="currency-amount" default="0"/>
        <field name="totalCost" type="currency-amount" default="0"/>
        <field name="warrantyRegId" type="id"/>
        <field name="isUnderWarranty" type="text-indicator" default="'N'"/>
        <field name="statusId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="customerNotes" type="text-long"/>
        <field name="technicianNotes" type="text-long"/>
        <relationship type="one" title="Customer" related="mantle.party.Party" short-alias="customer">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ServiceType" description="Service Job Type"/>
            <moqui.basic.Enumeration enumId="SvtRepair" enumTypeId="ServiceType" description="Repair" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SvtMaintenance" enumTypeId="ServiceType" description="Maintenance" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SvtInstallation" enumTypeId="ServiceType" description="Installation" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SvtInspection" enumTypeId="ServiceType" description="Inspection" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="SvtWarranty" enumTypeId="ServiceType" description="Warranty Service" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="SvtAmc" enumTypeId="ServiceType" description="AMC Service" sequenceNum="6"/>

            <moqui.basic.EnumerationType enumTypeId="ServicePriority" description="Service Priority"/>
            <moqui.basic.Enumeration enumId="SpNormal" enumTypeId="ServicePriority" description="Normal" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SpUrgent" enumTypeId="ServicePriority" description="Urgent" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SpCritical" enumTypeId="ServicePriority" description="Critical" sequenceNum="3"/>

            <moqui.basic.StatusType statusTypeId="ServiceJob" description="Service Job Status"/>
            <moqui.basic.StatusItem statusId="SjReceived" statusTypeId="ServiceJob" description="Received" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SjDiagnosed" statusTypeId="ServiceJob" description="Diagnosed" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SjApproved" statusTypeId="ServiceJob" description="Approved by Customer" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SjInProgress" statusTypeId="ServiceJob" description="In Progress" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="SjWaitingParts" statusTypeId="ServiceJob" description="Waiting for Parts" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="SjCompleted" statusTypeId="ServiceJob" description="Completed" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="SjDelivered" statusTypeId="ServiceJob" description="Delivered" sequenceNum="7"/>
            <moqui.basic.StatusItem statusId="SjCancelled" statusTypeId="ServiceJob" description="Cancelled" sequenceNum="8"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjReceived" toStatusId="SjDiagnosed" transitionName="Diagnose"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjDiagnosed" toStatusId="SjApproved" transitionName="Customer Approved"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjApproved" toStatusId="SjInProgress" transitionName="Start Work"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjInProgress" toStatusId="SjWaitingParts" transitionName="Waiting Parts"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjWaitingParts" toStatusId="SjInProgress" transitionName="Parts Received"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjInProgress" toStatusId="SjCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjCompleted" toStatusId="SjDelivered" transitionName="Deliver"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjReceived" toStatusId="SjCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SjDiagnosed" toStatusId="SjCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- Service Job Parts Used -->
    <entity entity-name="ServiceJobPart" package="zenith.erp.workshop" short-alias="ServiceJobPart">
        <field name="serviceJobId" type="id" is-pk="true"/>
        <field name="partSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="unitCost" type="currency-amount"/>
        <field name="totalCost" type="currency-amount"/>
        <field name="isChargeable" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.workshop.ServiceJob" short-alias="job"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
    </entity>

    <!-- Service Job Labor -->
    <entity entity-name="ServiceJobLabor" package="zenith.erp.workshop" short-alias="ServiceJobLabor">
        <field name="serviceJobId" type="id" is-pk="true"/>
        <field name="laborSeqId" type="id" is-pk="true"/>
        <field name="technicianPartyId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="hoursWorked" type="number-decimal"/>
        <field name="ratePerHour" type="currency-amount"/>
        <field name="totalCost" type="currency-amount"/>
        <field name="workDate" type="date"/>
        <relationship type="one" related="zenith.erp.workshop.ServiceJob" short-alias="job"/>
    </entity>

    <!-- AMC (Annual Maintenance Contract) -->
    <entity entity-name="AmcContract" package="zenith.erp.workshop" short-alias="AmcContract">
        <field name="amcContractId" type="id" is-pk="true"/>
        <field name="contractNumber" type="text-short"/>
        <field name="customerPartyId" type="id"/>
        <field name="productId" type="id"/>
        <field name="serialNumber" type="text-short"/>
        <field name="contractTypeEnumId" type="id"/>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="contractAmount" type="currency-amount"/>
        <field name="visitsIncluded" type="number-integer"/>
        <field name="visitsUsed" type="number-integer" default="0"/>
        <field name="partsIncluded" type="text-indicator" default="'N'"/>
        <field name="maxPartsCost" type="currency-amount"/>
        <field name="statusId" type="id"/>
        <field name="renewalDate" type="date"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" title="Customer" related="mantle.party.Party" short-alias="customer">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AmcContractType" description="AMC Contract Type"/>
            <moqui.basic.Enumeration enumId="ActComprehensive" enumTypeId="AmcContractType" description="Comprehensive (Parts + Labor)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="ActNonComprehensive" enumTypeId="AmcContractType" description="Non-Comprehensive (Labor Only)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="ActPreventive" enumTypeId="AmcContractType" description="Preventive Maintenance" sequenceNum="3"/>

            <moqui.basic.StatusType statusTypeId="AmcContract" description="AMC Contract Status"/>
            <moqui.basic.StatusItem statusId="AmcDraft" statusTypeId="AmcContract" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="AmcActive" statusTypeId="AmcContract" description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="AmcExpired" statusTypeId="AmcContract" description="Expired" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="AmcRenewed" statusTypeId="AmcContract" description="Renewed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="AmcCancelled" statusTypeId="AmcContract" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="AmcDraft" toStatusId="AmcActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="AmcActive" toStatusId="AmcExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="AmcExpired" toStatusId="AmcRenewed" transitionName="Renew"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="AmcActive" toStatusId="AmcCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- AMC Service Visit -->
    <entity entity-name="AmcServiceVisit" package="zenith.erp.workshop" short-alias="AmcServiceVisit">
        <field name="visitId" type="id" is-pk="true"/>
        <field name="amcContractId" type="id"/>
        <field name="serviceJobId" type="id"/>
        <field name="visitDate" type="date"/>
        <field name="visitTypeEnumId" type="id"/>
        <field name="findings" type="text-long"/>
        <field name="actionTaken" type="text-long"/>
        <field name="technicianPartyId" type="id"/>
        <field name="nextVisitDate" type="date"/>
        <relationship type="one" related="zenith.erp.workshop.AmcContract" short-alias="contract"/>
        <relationship type="one" related="zenith.erp.workshop.ServiceJob" short-alias="job"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AmcVisitType" description="AMC Visit Type"/>
            <moqui.basic.Enumeration enumId="AvtScheduled" enumTypeId="AmcVisitType" description="Scheduled" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AvtBreakdown" enumTypeId="AmcVisitType" description="Breakdown Call" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="AvtInspection" enumTypeId="AmcVisitType" description="Inspection" sequenceNum="3"/>
        </seed-data>
    </entity>

    <!-- View: ServiceJobDetail -->
    <view-entity entity-name="ServiceJobDetail" package="zenith.erp.workshop">
        <member-entity entity-alias="SJ" entity-name="zenith.erp.workshop.ServiceJob"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="SJ" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="SJ" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <alias-all entity-alias="SJ"/>
        <alias entity-alias="ORG" name="organizationName"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>

</entities>
