<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Create Service Job -->
    <service verb="create" noun="ServiceJob">
        <in-parameters>
            <parameter name="customerPartyId" required="true"/>
            <parameter name="productId"/>
            <parameter name="serialNumber"/>
            <parameter name="brandName"/>
            <parameter name="modelName"/>
            <parameter name="serviceTypeEnumId" required="true"/>
            <parameter name="priorityEnumId" default-value="SpNormal"/>
            <parameter name="issueDescription" required="true"/>
            <parameter name="promisedDate" type="Timestamp"/>
            <parameter name="assignedToPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="estimatedCost" type="BigDecimal"/>
            <parameter name="warrantyRegId"/>
            <parameter name="currencyUomId"/>
            <parameter name="customerNotes"/>
        </in-parameters>
        <out-parameters><parameter name="serviceJobId"/></out-parameters>
        <actions>
            <set field="isUnderWarranty" value="N"/>
            <if condition="warrantyRegId">
                <entity-find-one entity-name="zenith.erp.sales.WarrantyRegistration" value-field="wr"/>
                <if condition="wr &amp;&amp; wr.statusId == 'WrActive'">
                    <set field="isUnderWarranty" value="Y"/>
                </if>
            </if>
            <service-call name="create#zenith.erp.workshop.ServiceJob"
                          in-map="context + [statusId:'SjReceived', receivedDate:ec.user.nowTimestamp,
                                              isUnderWarranty:isUnderWarranty]"
                          out-map="context"/>
        </actions>
    </service>

    <!-- Add Parts to Job -->
    <service verb="add" noun="ServiceJobPart">
        <in-parameters>
            <parameter name="serviceJobId" required="true"/>
            <parameter name="productId" required="true"/>
            <parameter name="quantity" type="BigDecimal" required="true"/>
            <parameter name="unitCost" type="BigDecimal" required="true"/>
            <parameter name="isChargeable" default-value="Y"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.workshop.ServiceJobPart" list="existing">
                <econdition field-name="serviceJobId"/></entity-find>
            <set field="seqNum" from="(existing?.size() ?: 0) + 1"/>
            <set field="totalCost" from="quantity * unitCost" type="BigDecimal"/>
            <service-call name="create#zenith.erp.workshop.ServiceJobPart"
                          in-map="[serviceJobId:serviceJobId, partSeqId:String.format('%05d', seqNum),
                                   productId:productId, quantity:quantity, unitCost:unitCost,
                                   totalCost:totalCost, isChargeable:isChargeable]"/>
            <!-- Update job parts total -->
            <entity-find entity-name="zenith.erp.workshop.ServiceJobPart" list="allParts">
                <econdition field-name="serviceJobId"/>
                <econdition field-name="isChargeable" value="Y"/>
            </entity-find>
            <set field="partsCost" from="0" type="BigDecimal"/>
            <iterate list="allParts" entry="p"><set field="partsCost" from="partsCost + (p.totalCost ?: 0)"/></iterate>
            <entity-find-one entity-name="zenith.erp.workshop.ServiceJob" value-field="job" for-update="true"/>
            <set field="job.actualPartsCost" from="partsCost"/>
            <set field="job.totalCost" from="partsCost + (job.actualLaborCost ?: 0)"/>
            <entity-update value-field="job"/>
        </actions>
    </service>

    <!-- Complete Service Job -->
    <service verb="complete" noun="ServiceJob">
        <in-parameters>
            <parameter name="serviceJobId" required="true"/>
            <parameter name="technicianNotes"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.workshop.ServiceJob" value-field="job" for-update="true"/>
            <set field="job.statusId" value="SjCompleted"/>
            <set field="job.completedDate" from="ec.user.nowTimestamp"/>
            <if condition="technicianNotes"><set field="job.technicianNotes" from="technicianNotes"/></if>
            <entity-update value-field="job"/>
        </actions>
    </service>

    <!-- Create AMC Contract -->
    <service verb="create" noun="AmcContract">
        <in-parameters>
            <parameter name="customerPartyId" required="true"/>
            <parameter name="productId"/>
            <parameter name="serialNumber"/>
            <parameter name="contractTypeEnumId" required="true"/>
            <parameter name="startDate" type="Date" required="true"/>
            <parameter name="endDate" type="Date" required="true"/>
            <parameter name="contractAmount" type="BigDecimal" required="true"/>
            <parameter name="visitsIncluded" type="Integer"/>
            <parameter name="partsIncluded" default-value="N"/>
            <parameter name="maxPartsCost" type="BigDecimal"/>
            <parameter name="currencyUomId"/>
        </in-parameters>
        <out-parameters><parameter name="amcContractId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.workshop.AmcContract"
                          in-map="context + [statusId:'AmcDraft', visitsUsed:0]" out-map="context"/>
        </actions>
    </service>

    <!-- Record AMC Visit -->
    <service verb="record" noun="AmcVisit">
        <in-parameters>
            <parameter name="amcContractId" required="true"/>
            <parameter name="serviceJobId"/>
            <parameter name="visitDate" type="Date" required="true"/>
            <parameter name="visitTypeEnumId" required="true"/>
            <parameter name="findings"/>
            <parameter name="actionTaken"/>
            <parameter name="technicianPartyId"/>
            <parameter name="nextVisitDate" type="Date"/>
        </in-parameters>
        <out-parameters><parameter name="visitId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.workshop.AmcServiceVisit" in-map="context" out-map="context"/>
            <entity-find-one entity-name="zenith.erp.workshop.AmcContract" value-field="contract" for-update="true"/>
            <set field="contract.visitsUsed" from="(contract.visitsUsed ?: 0) + 1"/>
            <entity-update value-field="contract"/>
        </actions>
    </service>

</services>
