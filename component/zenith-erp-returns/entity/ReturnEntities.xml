<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Return Request: cross-channel return/exchange -->
    <entity entity-name="ReturnRequest" package="zenith.erp.returns" short-alias="ReturnRequest">
        <field name="returnId" type="id" is-pk="true"/>
        <field name="originalOrderId" type="id"/>
        <field name="originalInvoiceId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="channelTypeEnumId" type="id"/>
        <field name="returnTypeEnumId" type="id"/>
        <field name="returnReasonEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="requestDate" type="date-time"/>
        <field name="approvedDate" type="date-time"/>
        <field name="receivedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="totalReturnAmount" type="currency-amount" default="0"/>
        <field name="refundMethodEnumId" type="id"/>
        <field name="notes" type="text-long"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" title="ReturnType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="returnTypeEnumId" related="enumId"/></relationship>
        <relationship type="one" title="ReturnReason" related="moqui.basic.Enumeration" short-alias="reason">
            <key-map field-name="returnReasonEnumId" related="enumId"/></relationship>
        <relationship type="one" title="RefundMethod" related="moqui.basic.Enumeration" short-alias="refundMethod">
            <key-map field-name="refundMethodEnumId" related="enumId"/></relationship>
        <relationship type="one" title="ReturnRequest" related="moqui.basic.StatusItem" short-alias="status">
            <key-map field-name="statusId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ReturnType" description="Return Type"/>
            <moqui.basic.Enumeration enumId="RtReturn" enumTypeId="ReturnType" description="Return" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RtExchange" enumTypeId="ReturnType" description="Exchange" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RtRefund" enumTypeId="ReturnType" description="Refund Only" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RtWarranty" enumTypeId="ReturnType" description="Warranty Claim" sequenceNum="4"/>

            <moqui.basic.EnumerationType enumTypeId="ReturnReason" description="Return Reason"/>
            <moqui.basic.Enumeration enumId="RrDefective" enumTypeId="ReturnReason" description="Defective/Damaged" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RrWrongItem" enumTypeId="ReturnReason" description="Wrong Item Received" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RrNotAsDescribed" enumTypeId="ReturnReason" description="Not as Described" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RrSizeColor" enumTypeId="ReturnReason" description="Wrong Size/Color" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RrChanged" enumTypeId="ReturnReason" description="Changed Mind" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="RrBetterPrice" enumTypeId="ReturnReason" description="Found Better Price" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="RrOther" enumTypeId="ReturnReason" description="Other" sequenceNum="7"/>

            <moqui.basic.EnumerationType enumTypeId="RefundMethod" description="Refund Method"/>
            <moqui.basic.Enumeration enumId="RmOriginalPayment" enumTypeId="RefundMethod" description="Original Payment Method" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RmCash" enumTypeId="RefundMethod" description="Cash" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RmStoreCredit" enumTypeId="RefundMethod" description="Store Credit" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RmGiftCard" enumTypeId="RefundMethod" description="Gift Card" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RmBankTransfer" enumTypeId="RefundMethod" description="Bank Transfer" sequenceNum="5"/>

            <moqui.basic.StatusType statusTypeId="ReturnRequest" description="Return Request Status"/>
            <moqui.basic.StatusItem statusId="RrRequested" statusTypeId="ReturnRequest" description="Requested" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RrApproved" statusTypeId="ReturnRequest" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RrReceived" statusTypeId="ReturnRequest" description="Received" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RrInspecting" statusTypeId="ReturnRequest" description="Inspecting" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="RrCompleted" statusTypeId="ReturnRequest" description="Completed" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="RrRejected" statusTypeId="ReturnRequest" description="Rejected" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="RrCancelled" statusTypeId="ReturnRequest" description="Cancelled" sequenceNum="7"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrRequested" toStatusId="RrApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrRequested" toStatusId="RrRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrRequested" toStatusId="RrCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrApproved" toStatusId="RrReceived" transitionName="Receive"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrReceived" toStatusId="RrInspecting" transitionName="Inspect"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrInspecting" toStatusId="RrCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RrInspecting" toStatusId="RrRejected" transitionName="Reject"/>
        </seed-data>
    </entity>

    <!-- Return Item -->
    <entity entity-name="ReturnItem" package="zenith.erp.returns" table-name="ZENITH_RETURN_ITEM" short-alias="ReturnItem">
        <field name="returnId" type="id" is-pk="true"/>
        <field name="returnItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="unitPrice" type="currency-amount"/>
        <field name="returnAmount" type="currency-amount"/>
        <field name="returnConditionEnumId" type="id"/>
        <field name="returnActionEnumId" type="id"/>
        <field name="inspectionNotes" type="text-long"/>
        <field name="restockable" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.returns.ReturnRequest" short-alias="returnRequest"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" title="ReturnCondition" related="moqui.basic.Enumeration" short-alias="condition">
            <key-map field-name="returnConditionEnumId" related="enumId"/></relationship>
        <relationship type="one" title="ReturnAction" related="moqui.basic.Enumeration" short-alias="action">
            <key-map field-name="returnActionEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ReturnCondition" description="Return Item Condition"/>
            <moqui.basic.Enumeration enumId="RcNew" enumTypeId="ReturnCondition" description="New/Unopened" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RcGood" enumTypeId="ReturnCondition" description="Good" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RcDamaged" enumTypeId="ReturnCondition" description="Damaged" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RcDefective" enumTypeId="ReturnCondition" description="Defective" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RcUsed" enumTypeId="ReturnCondition" description="Used" sequenceNum="5"/>

            <moqui.basic.EnumerationType enumTypeId="ReturnAction" description="Return Item Action"/>
            <moqui.basic.Enumeration enumId="RaRefund" enumTypeId="ReturnAction" description="Refund" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RaExchange" enumTypeId="ReturnAction" description="Exchange" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RaRepair" enumTypeId="ReturnAction" description="Repair" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RaReplace" enumTypeId="ReturnAction" description="Replace" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="RaStoreCredit" enumTypeId="ReturnAction" description="Store Credit" sequenceNum="5"/>
        </seed-data>
    </entity>

    <!-- Exchange Order: links return to replacement -->
    <entity entity-name="ExchangeOrder" package="zenith.erp.returns" short-alias="ExchangeOrder">
        <field name="exchangeOrderId" type="id" is-pk="true"/>
        <field name="returnId" type="id"/>
        <field name="newOrderId" type="id"/>
        <field name="priceDifference" type="currency-amount" default="0"/>
        <field name="differenceHandling" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.returns.ReturnRequest" short-alias="returnRequest"/>
    </entity>

    <!-- Refund Payment: tracks how refund was issued -->
    <entity entity-name="RefundPayment" package="zenith.erp.returns" short-alias="RefundPayment">
        <field name="refundPaymentId" type="id" is-pk="true"/>
        <field name="returnId" type="id"/>
        <field name="refundMethodEnumId" type="id"/>
        <field name="amount" type="currency-amount"/>
        <field name="referenceNumber" type="text-medium"/>
        <field name="storeCreditId" type="id"/>
        <field name="giftCardId" type="id"/>
        <field name="refundDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.returns.ReturnRequest" short-alias="returnRequest"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="RefundPayment" description="Refund Payment Status"/>
            <moqui.basic.StatusItem statusId="RpPending" statusTypeId="RefundPayment" description="Pending" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RpProcessed" statusTypeId="RefundPayment" description="Processed" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RpFailed" statusTypeId="RefundPayment" description="Failed" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RpPending" toStatusId="RpProcessed" transitionName="Process"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RpPending" toStatusId="RpFailed" transitionName="Fail"/>
        </seed-data>
    </entity>

    <!-- Return Policy: configurable return windows -->
    <entity entity-name="ReturnPolicy" package="zenith.erp.returns" short-alias="ReturnPolicy">
        <field name="returnPolicyId" type="id" is-pk="true"/>
        <field name="policyName" type="text-medium"/>
        <field name="returnWindowDays" type="number-integer" default="30"/>
        <field name="exchangeWindowDays" type="number-integer" default="30"/>
        <field name="requiresReceipt" type="text-indicator" default="'Y'"/>
        <field name="requiresOriginalPackaging" type="text-indicator" default="'N'"/>
        <field name="restockingFeePercent" type="number-decimal" default="0"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="productCategoryId" type="id"/>
        <field name="description" type="text-long"/>
    </entity>

    <!-- View: ReturnRequestDetail -->
    <view-entity entity-name="ReturnRequestDetail" package="zenith.erp.returns">
        <member-entity entity-alias="RR" entity-name="zenith.erp.returns.ReturnRequest"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="RR" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="RR" join-optional="true">
            <key-map field-name="customerPartyId" related="partyId"/></member-entity>
        <alias-all entity-alias="RR"/>
        <alias entity-alias="ORG" name="organizationName"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>

</entities>
