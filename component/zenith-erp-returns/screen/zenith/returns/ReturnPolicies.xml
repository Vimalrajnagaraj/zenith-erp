<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Policies" default-menu-index="3">

    <transition name="createPolicy">
        <service-call name="create#zenith.erp.returns.ReturnPolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicy">
        <service-call name="update#zenith.erp.returns.ReturnPolicy"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.returns.ReturnPolicy" list="policies">
            <order-by field-name="policyName"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Return Policies" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="AddPolicy" button-text="New Policy" type="success">
                <form-single name="AddPolicyForm" transition="createPolicy">
                    <field name="policyName"><default-field><text-line size="20"/></default-field></field>
                    <field name="returnWindowDays"><default-field title="Return Window (days)"><text-line size="5" default-value="30"/></default-field></field>
                    <field name="exchangeWindowDays"><default-field title="Exchange Window (days)"><text-line size="5" default-value="30"/></default-field></field>
                    <field name="requiresReceipt"><default-field title="Requires Receipt">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="requiresOriginalPackaging"><default-field title="Requires Packaging">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="restockingFeePercent"><default-field title="Restocking Fee %"><text-line size="5" default-value="0"/></default-field></field>
                    <field name="description"><default-field><text-area rows="3" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="PoliciesForm" list="policies" transition="updatePolicy">
                <field name="returnPolicyId"><default-field><hidden/></default-field></field>
                <field name="policyName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="returnWindowDays"><default-field title="Return Days"><text-line size="4"/></default-field></field>
                <field name="exchangeWindowDays"><default-field title="Exchange Days"><text-line size="4"/></default-field></field>
                <field name="requiresReceipt"><default-field title="Receipt">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="restockingFeePercent"><default-field title="Restock Fee %"><text-line size="4"/></default-field></field>
                <field name="isActive"><default-field title="Active">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
