<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <service-call name="zenith.returns.ReturnServices.get#ReturnDashboard" out-map="dashboard"/>
        <entity-find entity-name="zenith.erp.returns.ReturnRequestDetail" list="recentReturns" limit="10">
            <order-by field-name="-requestDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Returns Dashboard" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Pending" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.pendingReturns ?: 0}" type="h3" style="text-warning text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="In Progress" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.approvedReturns ?: 0}" type="h3" style="text-info text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Completed Today" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${dashboard.completedToday ?: 0}" type="h3" style="text-positive text-weight-bold q-my-sm"/>
                </container>
            </row-col>
            <row-col lg="3" md="6" sm="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Refunded Today" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(dashboard.totalRefundedToday ?: 0, '#,##0.00')}" type="h3" style="text-negative text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mt-md">
            <label text="Recent Returns" type="h5" style="text-weight-bold q-mb-md"/>
            <form-list name="RecentReturnsForm" list="recentReturns" skip-form="true">
                <field name="returnId"><default-field title="Return #">
                    <link url="../EditReturn" text="${returnId}" parameter-map="[returnId:returnId]"/>
                </default-field></field>
                <field name="firstName"><default-field title="Customer">
                    <display text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></default-field></field>
                <field name="returnTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="returnReasonEnumId"><default-field title="Reason">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="totalReturnAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="requestDate"><default-field title="Date"><display format="dd-MMM HH:mm"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
