<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Returns" default-menu-index="2">

    <transition name="editReturn"><default-response url="../EditReturn"/></transition>
    <transition name="createReturn">
        <service-call name="zenith.returns.ReturnServices.create#ReturnRequest"/>
        <default-response url="../EditReturn"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.returns.ReturnRequestDetail" list="returns">
            <search-form-inputs default-order-by="-requestDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Return Requests" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateReturn" button-text="New Return" type="success">
                <form-single name="CreateReturnForm" transition="createReturn">
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="originalOrderId"><default-field title="Original Order"><text-line size="15"/></default-field></field>
                    <field name="returnTypeEnumId"><default-field title="Return Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="ReturnType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="returnReasonEnumId"><default-field title="Reason">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="ReturnReason"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="refundMethodEnumId"><default-field title="Refund Method">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="RefundMethod"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="storeId"><default-field title="Store">
                        <drop-down allow-empty="true"><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="notes"><default-field><text-area rows="3" cols="40"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ReturnsForm" list="returns" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="returnId"><default-field title="Return #">
                    <link url="editReturn" text="${returnId}" parameter-map="[returnId:returnId]"/>
                </default-field></field>
                <field name="firstName"><default-field title="Customer">
                    <display text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></default-field></field>
                <field name="originalOrderId"><default-field title="Order"><display/></default-field></field>
                <field name="returnTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="returnReasonEnumId"><default-field title="Reason">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="totalReturnAmount"><header-field show-order-by="true"/>
                    <default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                <field name="refundMethodEnumId"><default-field title="Refund">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="RrRequested" text="Requested"/><option key="RrApproved" text="Approved"/>
                        <option key="RrReceived" text="Received"/><option key="RrCompleted" text="Completed"/>
                        <option key="RrRejected" text="Rejected"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
                <field name="requestDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
