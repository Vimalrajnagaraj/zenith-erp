<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Return" default-menu-include="false">

    <parameter name="returnId" required="true"/>

    <transition name="approveReturn">
        <service-call name="zenith.returns.ReturnServices.approve#Return"/>
        <default-response url="."/>
    </transition>
    <transition name="receiveReturn">
        <service-call name="zenith.returns.ReturnServices.receive#Return"/>
        <default-response url="."/>
    </transition>
    <transition name="completeReturn">
        <service-call name="zenith.returns.ReturnServices.complete#Return"/>
        <default-response url="."/>
    </transition>
    <transition name="rejectReturn">
        <service-call name="zenith.returns.ReturnServices.reject#Return"/>
        <default-response url="."/>
    </transition>
    <transition name="addItem">
        <actions>
            <!-- ZE-SB-013 (Tier 3): the returned product must belong to this org. -->
            <if condition="ec.web.parameters.productId">
                <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_pa"
                              in-map="[entityName:'mantle.product.Product', idField:'productId', idValue:ec.web.parameters.productId, orgField:'ownerPartyId']"/>
                <if condition="!_pa.allowed"><return error="true" message="Please select a valid product from your account."/></if>
            </if>
            <service-call name="create#zenith.erp.returns.ReturnItem" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="createExchange">
        <service-call name="zenith.returns.ReturnServices.create#ExchangeOrder"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.returns.ReturnRequest" value-field="returnReq"/>
        <entity-find entity-name="zenith.erp.returns.ReturnItem" list="items">
            <econdition field-name="returnId"/>
            <order-by field-name="returnItemSeqId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.returns.RefundPayment" list="refunds">
            <econdition field-name="returnId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.returns.ExchangeOrder" list="exchanges">
            <econdition field-name="returnId"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Return: ${returnId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <!-- Return Details -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Return Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="ReturnForm" map="returnReq">
                        <field name="customerPartyId"><default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                            text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                        </default-field></field>
                        <field name="originalOrderId"><default-field title="Original Order"><display/></default-field></field>
                        <field name="returnTypeEnumId"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="returnReasonEnumId"><default-field title="Reason">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="refundMethodEnumId"><default-field title="Refund Method">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="storeId"><default-field title="Store">
                            <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                        </default-field></field>
                        <field name="requestDate"><default-field><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                        <field name="notes"><default-field><display/></default-field></field>
                    </form-single>
                </container>

                <!-- Action Buttons -->
                <section name="ApproveSection" condition="returnReq.statusId == 'RrRequested'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <container style="row q-gutter-md">
                                <form-single name="ApproveForm" transition="approveReturn">
                                    <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                    <field name="submitBtn"><default-field title="Approve"><submit type="success"/></default-field></field>
                                </form-single>
                                <container-dialog id="RejectDialog" button-text="Reject" type="danger">
                                    <form-single name="RejectForm" transition="rejectReturn">
                                        <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                        <field name="notes"><default-field title="Rejection Reason"><text-area rows="3" cols="40"/></default-field></field>
                                        <field name="submitBtn"><default-field title="Reject"><submit type="danger"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </container>
                        </container>
                    </widgets>
                </section>
                <section name="ReceiveSection" condition="returnReq.statusId == 'RrApproved'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <form-single name="ReceiveForm" transition="receiveReturn">
                                <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                <field name="submitBtn"><default-field title="Mark Received"><submit type="info"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>
                <section name="CompleteSection" condition="returnReq.statusId in ['RrReceived', 'RrInspecting']">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <form-single name="CompleteForm" transition="completeReturn">
                                <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                <field name="submitBtn"><default-field title="Complete &amp; Issue Refund"><submit type="success"/></default-field></field>
                            </form-single>
                        </container>
                    </widgets>
                </section>

                <!-- Return Items -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Return Items" type="h5" style="text-weight-bold q-my-none"/>
                        <section name="AddItemSection" condition="returnReq.statusId in ['RrRequested', 'RrApproved']">
                            <widgets>
                                <container-dialog id="AddItem" button-text="Add Item" type="info">
                                    <form-single name="AddItemForm" transition="addItem">
                                        <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                        <field name="returnItemSeqId"><default-field><hidden default-value="${String.format('%05d', (items?.size() ?: 0) + 1)}"/></default-field></field>
                                        <field name="productId"><default-field title="Product">
                                            <drop-down><entity-options key="${productId}" text="${productName}">
                                                <entity-find entity-name="mantle.product.Product">
                                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                                </entity-find>
                                            </entity-options></drop-down></default-field></field>
                                        <field name="quantity"><default-field><text-line size="5" default-value="1"/></default-field></field>
                                        <field name="unitPrice"><default-field><text-line size="10"/></default-field></field>
                                        <field name="returnConditionEnumId"><default-field title="Condition">
                                            <drop-down><entity-options key="${enumId}" text="${description}">
                                                <entity-find entity-name="moqui.basic.Enumeration">
                                                    <econdition field-name="enumTypeId" value="ReturnCondition"/>
                                                </entity-find>
                                            </entity-options></drop-down></default-field></field>
                                        <field name="returnActionEnumId"><default-field title="Action">
                                            <drop-down><entity-options key="${enumId}" text="${description}">
                                                <entity-find entity-name="moqui.basic.Enumeration">
                                                    <econdition field-name="enumTypeId" value="ReturnAction"/>
                                                </entity-find>
                                            </entity-options></drop-down></default-field></field>
                                        <field name="submitBtn"><default-field title="Add"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </container>
                    <form-list name="ItemsForm" list="items" skip-form="true">
                        <field name="returnItemSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="productId"><default-field title="Product">
                            <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                        </default-field></field>
                        <field name="quantity"><default-field><display/></default-field></field>
                        <field name="unitPrice"><default-field><display format="#,##0.00"/></default-field></field>
                        <field name="returnAmount"><default-field title="Amount"><display format="#,##0.00"/></default-field></field>
                        <field name="returnConditionEnumId"><default-field title="Condition">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="returnActionEnumId"><default-field title="Action">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                        </default-field></field>
                        <field name="restockable"><default-field title="Restock"><display/></default-field></field>
                    </form-list>
                </container>

                <!-- Refund Payments -->
                <section name="RefundsSection" condition="refunds">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                            <label text="Refund Payments" type="h5" style="text-weight-bold q-mb-md"/>
                            <form-list name="RefundsForm" list="refunds" skip-form="true">
                                <field name="refundMethodEnumId"><default-field title="Method">
                                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                                </default-field></field>
                                <field name="amount"><default-field><display format="#,##0.00"/></default-field></field>
                                <field name="referenceNumber"><default-field title="Reference"><display/></default-field></field>
                                <field name="refundDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                            </form-list>
                        </container>
                    </widgets>
                </section>

                <!-- Exchange Orders -->
                <section name="ExchangeSection" condition="returnReq.returnTypeEnumId == 'RtExchange'">
                    <widgets>
                        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                            <container style="row items-center justify-between q-mb-md">
                                <label text="Exchange Orders" type="h5" style="text-weight-bold q-my-none"/>
                                <container-dialog id="NewExchange" button-text="Create Exchange" type="info">
                                    <form-single name="ExchangeForm" transition="createExchange">
                                        <field name="returnId" from="returnReq.returnId"><default-field><hidden/></default-field></field>
                                        <field name="newOrderId"><default-field title="New Order ID"><text-line size="15"/></default-field></field>
                                        <field name="priceDifference"><default-field title="Price Difference"><text-line size="10" default-value="0"/></default-field></field>
                                        <field name="differenceHandling"><default-field title="Handling">
                                            <drop-down allow-empty="true">
                                                <option key="ChargeCustomer" text="Charge Customer"/>
                                                <option key="RefundCustomer" text="Refund Customer"/>
                                                <option key="Waive" text="Waive"/>
                                            </drop-down></default-field></field>
                                        <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </container>
                            <form-list name="ExchangesForm" list="exchanges" skip-form="true">
                                <field name="newOrderId"><default-field title="New Order"><display/></default-field></field>
                                <field name="priceDifference"><default-field title="Difference"><display format="#,##0.00"/></default-field></field>
                                <field name="differenceHandling"><default-field title="Handling"><display/></default-field></field>
                                <field name="createdDate"><default-field title="Created"><display format="dd-MMM-yyyy"/></default-field></field>
                            </form-list>
                        </container>
                    </widgets>
                </section>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${returnReq.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Total Amount" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${zinr.inr(ec.l10n.format(returnReq.totalReturnAmount ?: 0, '#,##0.00'))}" type="h4" style="text-negative text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Items" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${items?.size() ?: 0}" type="h4" style="text-dark text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
