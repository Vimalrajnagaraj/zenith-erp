<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Project Entity ========== -->
    <entity entity-name="Project" package="zenith.erp.project" short-alias="Projects">
        <field name="projectId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="projectName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="projectManagerPartyId" type="id"/>
        <field name="startDate" type="date"/>
        <field name="targetEndDate" type="date"/>
        <field name="actualEndDate" type="date"/>
        <field name="statusId" type="id"/>
        <field name="priority" type="text-short"><description>High, Medium, Low</description></field>
        <field name="budgetAmount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="completionPercent" type="number-integer"/>
        <field name="createdDate" type="date-time"/>

        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="ProjectManager" related="mantle.party.Party">
            <key-map field-name="projectManagerPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="Project" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>
        <relationship type="one" related="moqui.basic.Uom">
            <key-map field-name="currencyUomId" related="uomId"/>
        </relationship>

        <seed-data>
            <!-- Status Type -->
            <moqui.basic.StatusType statusTypeId="ProjectStatus" description="Project Status"/>

            <!-- Status Items -->
            <moqui.basic.StatusItem statusId="PrjPlanning" statusTypeId="ProjectStatus"
                                    description="Planning" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="PrjActive" statusTypeId="ProjectStatus"
                                    description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="PrjOnHold" statusTypeId="ProjectStatus"
                                    description="On Hold" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="PrjCompleted" statusTypeId="ProjectStatus"
                                    description="Completed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="PrjCancelled" statusTypeId="ProjectStatus"
                                    description="Cancelled" sequenceNum="5"/>

            <!-- Status Flow Transitions -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjPlanning"
                                              toStatusId="PrjActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjPlanning"
                                              toStatusId="PrjCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjActive"
                                              toStatusId="PrjOnHold" transitionName="Put On Hold"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjActive"
                                              toStatusId="PrjCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjActive"
                                              toStatusId="PrjCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjOnHold"
                                              toStatusId="PrjActive" transitionName="Reactivate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrjOnHold"
                                              toStatusId="PrjCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== ProjectTask Entity ========== -->
    <entity entity-name="ProjectTask" package="zenith.erp.project" short-alias="ProjectTasks">
        <field name="taskId" type="id" is-pk="true"/>
        <field name="projectId" type="id"/>
        <field name="taskName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="priority" type="text-short"><description>High, Medium, Low</description></field>
        <field name="estimatedHours" type="number-decimal"/>
        <field name="actualHours" type="number-decimal"/>
        <field name="startDate" type="date"/>
        <field name="dueDate" type="date"/>
        <field name="completedDate" type="date-time"/>
        <field name="parentTaskId" type="id"><description>For subtasks - references parent task</description></field>
        <field name="sequenceNum" type="number-integer"/>

        <relationship type="one" related="zenith.erp.project.Project">
            <key-map field-name="projectId"/>
        </relationship>
        <relationship type="one" title="AssignedTo" related="mantle.party.Party">
            <key-map field-name="assignedToPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="ParentTask" related="zenith.erp.project.ProjectTask">
            <key-map field-name="parentTaskId" related="taskId"/>
        </relationship>
        <relationship type="one" title="ProjectTask" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>

        <seed-data>
            <!-- Status Type -->
            <moqui.basic.StatusType statusTypeId="ProjectTask" description="Project Task Status"/>

            <!-- Status Items -->
            <moqui.basic.StatusItem statusId="TaskNew" statusTypeId="ProjectTask"
                                    description="New" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="TaskInProgress" statusTypeId="ProjectTask"
                                    description="In Progress" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="TaskReview" statusTypeId="ProjectTask"
                                    description="In Review" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="TaskDone" statusTypeId="ProjectTask"
                                    description="Done" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="TaskCancelled" statusTypeId="ProjectTask"
                                    description="Cancelled" sequenceNum="5"/>

            <!-- Status Flow Transitions -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskNew"
                                              toStatusId="TaskInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskNew"
                                              toStatusId="TaskCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskInProgress"
                                              toStatusId="TaskReview" transitionName="Submit for Review"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskInProgress"
                                              toStatusId="TaskDone" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskInProgress"
                                              toStatusId="TaskCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskReview"
                                              toStatusId="TaskInProgress" transitionName="Return to Progress"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskReview"
                                              toStatusId="TaskDone" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TaskReview"
                                              toStatusId="TaskCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== ProjectMember Entity ========== -->
    <entity entity-name="ProjectMember" package="zenith.erp.project" short-alias="ProjectMembers">
        <field name="projectId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="roleDescription" type="text-short"><description>e.g. Developer, Tester, Analyst</description></field>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>

        <relationship type="one" related="zenith.erp.project.Project">
            <key-map field-name="projectId"/>
        </relationship>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="partyId"/>
        </relationship>
    </entity>

    <!-- ========== ProjectTaskListView View-Entity ========== -->
    <view-entity entity-name="ProjectTaskListView" package="zenith.erp.project">
        <member-entity entity-alias="PT" entity-name="zenith.erp.project.ProjectTask"/>
        <member-entity entity-alias="PRJ" entity-name="zenith.erp.project.Project" join-from-alias="PT">
            <key-map field-name="projectId"/>
        </member-entity>

        <alias entity-alias="PT" name="taskId"/>
        <alias entity-alias="PT" name="projectId"/>
        <alias entity-alias="PT" name="taskName"/>
        <alias entity-alias="PT" name="assignedToPartyId"/>
        <alias entity-alias="PT" name="statusId"/>
        <alias entity-alias="PT" name="priority"/>
        <alias entity-alias="PT" name="estimatedHours"/>
        <alias entity-alias="PT" name="actualHours"/>
        <alias entity-alias="PT" name="startDate"/>
        <alias entity-alias="PT" name="dueDate"/>
        <alias entity-alias="PT" name="completedDate"/>
        <alias entity-alias="PRJ" name="projectName"/>
    </view-entity>

</entities>
