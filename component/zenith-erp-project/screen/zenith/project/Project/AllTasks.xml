<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Tasks" default-menu-index="2">

    <actions>
        <entity-find entity-name="zenith.erp.project.ProjectTaskListView" list="taskList">
            <search-form-inputs default-order-by="dueDate,taskName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Tasks"/>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search All Tasks..." style="display:none"></span>]]></text></render-mode>
            <form-list name="AllTasksForm" list="taskList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <field name="taskName"><header-field show-order-by="true">
                        <text-find size="25" hide-options="true"/>
                    </header-field>
                        <default-field title="Task Name"><display/></default-field>
                    </field>
                    <field name="projectName"><header-field show-order-by="true">
                        <text-find size="25" hide-options="true"/>
                    </header-field>
                        <default-field title="Project"><display/></default-field>
                    </field>
                    <field name="assignedToPartyId"><header-field title="Assigned To"/>
                        <default-field>
                            <display-entity entity-name="mantle.party.PersonAndUserAccount"
                                            key-field-name="userId" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </default-field>
                    </field>
                    <field name="statusId"><header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="TaskNew" text="New"/>
                            <option key="TaskInProgress" text="In Progress"/>
                            <option key="TaskReview" text="In Review"/>
                            <option key="TaskDone" text="Done"/>
                            <option key="TaskCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                        </default-field>
                    </field>
                    <field name="priority"><header-field show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="High" text="High"/>
                            <option key="Medium" text="Medium"/>
                            <option key="Low" text="Low"/>
                        </drop-down>
                    </header-field>
                        <default-field><display/></default-field>
                    </field>
                    <field name="dueDate"><header-field title="Due Date" show-order-by="true"/>
                        <default-field><display format="yyyy-MM-dd"/></default-field>
                    </field>
                    <field name="estimatedHours"><header-field title="Est Hours" show-order-by="true"/>
                        <default-field><display/></default-field>
                    </field>
                    <field name="actualHours"><header-field title="Act Hours" show-order-by="true"/>
                        <default-field><display/></default-field>
                    </field>
                    <field name="submitButton"><header-field title="Find">
                        <submit/>
                    </header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
