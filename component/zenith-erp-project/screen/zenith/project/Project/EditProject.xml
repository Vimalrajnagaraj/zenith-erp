<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false">

    <parameter name="projectId" required="true"/>

    <transition name="updateProject">
        <service-call name="zenith.project.ProjectServices.update#Project"/>
        <default-response url="."/>
    </transition>
    <transition name="createTask">
        <service-call name="zenith.project.ProjectServices.create#ProjectTask"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTask">
        <service-call name="zenith.project.ProjectServices.update#ProjectTask"/>
        <default-response url="."/>
    </transition>
    <transition name="addMember">
        <service-call name="zenith.project.ProjectServices.add#ProjectMember"/>
        <default-response url="."/>
    </transition>
    <transition name="removeMember">
        <service-call name="zenith.project.ProjectServices.remove#ProjectMember"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.project.Project" value-field="project"/>
        <entity-find entity-name="zenith.erp.project.ProjectTask" list="taskList">
            <econdition field-name="projectId"/>
            <order-by field-name="sequenceNum,taskName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.project.ProjectMember" list="memberList">
            <econdition field-name="projectId"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="lastName,firstName"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="projectStatusList">
            <econdition field-name="statusTypeId" value="ProjectStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="taskStatusList">
            <econdition field-name="statusTypeId" value="ProjectTask"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
    </actions>

    <widgets>
        <!-- Section 1: Project Details -->
        <container-box>
            <box-header title="Project: ${project.projectName}"/>
            <box-body>
                <form-single name="EditProjectForm" map="project" transition="updateProject">
                    <field name="projectId"><default-field>
                        <hidden/>
                    </default-field></field>
                    <field name="projectName"><default-field title="Project Name">
                        <text-line size="40"/>
                    </default-field></field>
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down allow-empty="false">
                            <list-options list="orgList" key="${partyId}" text="${organizationName ?: (firstName + ' ' + lastName)}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field title="Description">
                        <text-area rows="4" cols="60"/>
                    </default-field></field>
                    <field name="projectManagerPartyId"><default-field title="Project Manager">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${userId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${userId}]"/>
                        </drop-down>
                    </default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down allow-empty="false">
                            <list-options list="projectStatusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="priority"><default-field title="Priority">
                        <drop-down allow-empty="true">
                            <option key="High" text="High"/>
                            <option key="Medium" text="Medium"/>
                            <option key="Low" text="Low"/>
                        </drop-down>
                    </default-field></field>
                    <field name="startDate"><default-field title="Start Date">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="targetEndDate"><default-field title="Target End Date">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="actualEndDate"><default-field title="Actual End Date">
                        <date-time type="date"/>
                    </default-field></field>
                    <field name="budgetAmount"><default-field title="Budget Amount">
                        <text-line size="15"/>
                    </default-field></field>
                    <field name="currencyUomId"><default-field title="Currency">
                        <drop-down allow-empty="true">
                            <entity-options key="${uomId}" text="${description} [${abbreviation}]">
                                <entity-find entity-name="moqui.basic.Uom">
                                    <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                                    <order-by field-name="description"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field></field>
                    <field name="completionPercent"><default-field title="Completion %">
                        <display/>
                    </default-field></field>
                    <field name="submitButton">
                        <conditional-field name="proj_edit_save_write" condition="modCanWrite" title="Update Project">
                            <submit/>
                        </conditional-field>
                        <default-field title="Update Project"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>

        <!-- Section 2: Tasks -->
        <container-box>
            <box-header title="Tasks"/>
            <box-toolbar>
                <section name="proj_task_create_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="NewTaskDialog" button-text="New Task">
                    <form-single name="CreateTaskForm" transition="createTask">
                        <field name="projectId"><default-field><hidden/></default-field></field>
                        <field name="taskName"><default-field title="Task Name">
                            <text-line size="40"/>
                        </default-field></field>
                        <field name="description"><default-field title="Description">
                            <text-area rows="3" cols="60"/>
                        </default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assigned To">
                            <drop-down allow-empty="true">
                                <list-options list="userList" key="${userId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${userId}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down allow-empty="true">
                                <option key="High" text="High"/>
                                <option key="Medium" text="Medium"/>
                                <option key="Low" text="Low"/>
                            </drop-down>
                        </default-field></field>
                        <field name="estimatedHours"><default-field title="Estimated Hours">
                            <text-line size="8"/>
                        </default-field></field>
                        <field name="startDate"><default-field title="Start Date">
                            <date-time type="date"/>
                        </default-field></field>
                        <field name="dueDate"><default-field title="Due Date">
                            <date-time type="date"/>
                        </default-field></field>
                        <field name="parentTaskId"><default-field title="Parent Task">
                            <drop-down allow-empty="true">
                                <list-options list="taskList" key="${taskId}" text="${taskName}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Create Task">
                            <submit/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="TaskListForm" list="taskList" transition="updateTask">
                    <field name="taskId"><default-field title="Task ID">
                        <display/>
                    </default-field></field>
                    <field name="taskName"><default-field title="Task Name">
                        <display/>
                    </default-field></field>
                    <field name="assignedToPartyId"><default-field title="Assigned To">
                        <display-entity entity-name="mantle.party.PersonAndUserAccount"
                                        key-field-name="userId" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                    </default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down allow-empty="false">
                            <list-options list="taskStatusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="priority"><default-field title="Priority">
                        <display/>
                    </default-field></field>
                    <field name="estimatedHours"><default-field title="Est Hours">
                        <display/>
                    </default-field></field>
                    <field name="actualHours"><default-field title="Act Hours">
                        <display/>
                    </default-field></field>
                    <field name="dueDate"><default-field title="Due Date">
                        <display format="yyyy-MM-dd"/>
                    </default-field></field>
                    <field name="completedDate"><default-field title="Completed">
                        <display format="yyyy-MM-dd HH:mm"/>
                    </default-field></field>
                    <field name="submitButton">
                        <conditional-field name="proj_task_update_write" condition="modCanWrite" title="Update">
                            <submit/>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>

        <!-- Section 3: Team Members -->
        <container-box>
            <box-header title="Team Members"/>
            <box-toolbar>
                <section name="proj_member_add_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddMemberDialog" button-text="Add Member">
                    <form-single name="AddMemberForm" transition="addMember">
                        <field name="projectId"><default-field><hidden/></default-field></field>
                        <field name="partyId"><default-field title="Person">
                            <drop-down allow-empty="false">
                                <list-options list="userList" key="${userId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${userId}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="roleDescription"><default-field title="Role">
                            <drop-down allow-empty="true">
                                <option key="Developer" text="Developer"/>
                                <option key="Tester" text="Tester"/>
                                <option key="Analyst" text="Analyst"/>
                                <option key="Designer" text="Designer"/>
                                <option key="Lead" text="Lead"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Add Member">
                            <submit/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="MemberListForm" list="memberList" skip-form="true">
                    <field name="partyId"><default-field title="Member">
                        <display-entity entity-name="mantle.party.PersonAndUserAccount"
                                        key-field-name="userId" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${userId}]"/>
                    </default-field></field>
                    <field name="roleDescription"><default-field title="Role">
                        <display/>
                    </default-field></field>
                    <field name="fromDate"><default-field title="From Date">
                        <display format="yyyy-MM-dd"/>
                    </default-field></field>
                    <field name="thruDate"><default-field title="Thru Date">
                        <display format="yyyy-MM-dd"/>
                    </default-field></field>
                    <field name="removeButton">
                        <conditional-field name="proj_member_remove_write" condition="modCanWrite" title="">
                        <link url="removeMember" text="Remove" link-type="hidden-form">
                            <parameter name="projectId"/>
                            <parameter name="partyId"/>
                        </link>
                        </conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
