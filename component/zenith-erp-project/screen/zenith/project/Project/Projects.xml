<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Projects" default-menu-index="1">

    <transition name="createProject">
        <service-call name="zenith.project.ProjectServices.create#Project"/>
        <default-response url="."/>
    </transition>
    <transition name="editProject">
        <default-response url="../EditProject"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.project.Project" list="projectList">
            <search-form-inputs default-order-by="projectName"/>
        </entity-find>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <!-- ZE-INV-IV-070 f/u: a tenant has exactly one org; auto-fill it (the /qapps Vue m-drop-down renders the
             get#ActiveOrgList list-options EMPTY, blocking New Project). Super-admins (no active org) keep the picker. -->
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="organizationPartyId" from="_ao"/></if>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="lastName,firstName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Projects"/>
            <box-toolbar>
                <section name="proj_create_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="NewProjectDialog" button-text="New Project">
                    <form-single name="CreateProjectForm" transition="createProject">
                        <field name="organizationPartyId">
                            <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                            <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                            <default-field title="Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="orgList" key="${partyId}" text="${organizationName ?: (firstName + ' ' + lastName)}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="projectName"><default-field title="Project Name">
                            <text-line size="40"/>
                        </default-field></field>
                        <field name="description"><default-field title="Description">
                            <text-area rows="3" cols="60"/>
                        </default-field></field>
                        <field name="projectManagerPartyId"><default-field title="Project Manager">
                            <drop-down allow-empty="true">
                                <list-options list="userList" key="${userId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()} [${userId}]"/>
                            </drop-down>
                        </default-field></field>
                        <field name="startDate"><default-field title="Start Date">
                            <date-time type="date"/>
                        </default-field></field>
                        <field name="targetEndDate"><default-field title="Target End Date">
                            <date-time type="date"/>
                        </default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down allow-empty="true">
                                <option key="High" text="High"/>
                                <option key="Medium" text="Medium"/>
                                <option key="Low" text="Low"/>
                            </drop-down>
                        </default-field></field>
                        <field name="budgetAmount"><default-field title="Budget Amount">
                            <text-line size="15"/>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Create">
                            <submit/>
                        </default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Projects..." style="display:none"></span>]]></text></render-mode>
            <form-list name="ProjectListForm" list="projectList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true">
                    <field name="projectId"><header-field show-order-by="true"/>
                        <default-field>
                            <link url="editProject" text="${projectId}" link-type="anchor">
                                <parameter name="projectId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="projectName"><header-field show-order-by="true">
                        <text-find size="25" hide-options="true"/>
                    </header-field>
                        <default-field>
                            <link url="editProject" text="${projectName}" link-type="anchor">
                                <parameter name="projectId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="statusId"><header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="PrjPlanning" text="Planning"/>
                            <option key="PrjActive" text="Active"/>
                            <option key="PrjOnHold" text="On Hold"/>
                            <option key="PrjCompleted" text="Completed"/>
                            <option key="PrjCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                        </default-field>
                    </field>
                    <field name="priority"><header-field show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="High" text="High"/>
                            <option key="Medium" text="Medium"/>
                            <option key="Low" text="Low"/>
                        </drop-down>
                    </header-field>
                        <default-field><display/></default-field>
                    </field>
                    <field name="projectManagerPartyId"><header-field title="Project Manager"/>
                        <default-field>
                            <display-entity entity-name="mantle.party.PersonAndUserAccount"
                                            key-field-name="userId" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </default-field>
                    </field>
                    <field name="startDate"><header-field show-order-by="true"/>
                        <default-field><display format="yyyy-MM-dd"/></default-field>
                    </field>
                    <field name="targetEndDate"><header-field title="Target End" show-order-by="true"/>
                        <default-field><display format="yyyy-MM-dd"/></default-field>
                    </field>
                    <field name="completionPercent"><header-field title="% Complete"/>
                        <default-field><display/></default-field>
                    </field>
                    <field name="submitButton"><header-field title="Find">
                        <submit/>
                    </header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
