<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Project" default-menu-index="50">

    <always-actions>
        <set field="html_title" value="Project"/>
    </always-actions>

    <subscreens default-item="Projects">
        <subscreens-item name="EditProject" location="component://zenith-erp-project/screen/zenith/project/Project/EditProject.xml"
                         menu-include="false"/>
    </subscreens>

    <transition name="goTimesheets"><default-response url="/apps/zenith/timesheets/MyTimesheets"/></transition>
    <transition name="goHr"><default-response url="/apps/zenith/Hr/Employees"/></transition>

    <widgets>
        <container style="text-right">
            <section name="gate_timesheets_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('timesheets'))"><widgets><link url="goTimesheets" text="Timesheets" link-type="anchor"/></widgets></section>
            <section name="gate_hr_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('hr'))"><widgets><link url="goHr" text="HR / Employees" link-type="anchor"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
