<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Create Project ========== -->
    <service verb="create" noun="Project">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="projectName" required="true"/>
            <parameter name="description"/>
            <parameter name="projectManagerPartyId"/>
            <parameter name="startDate" type="Date"/>
            <parameter name="targetEndDate" type="Date"/>
            <parameter name="priority"/>
            <parameter name="budgetAmount" type="BigDecimal"/>
            <parameter name="currencyUomId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="projectId" required="true"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="PrjPlanning"/>
            <set field="completionPercent" value="0" type="Integer"/>
            <set field="createdDate" from="ec.user.nowTimestamp"/>
            <if condition="!projectManagerPartyId">
                <!-- ZE-INV-IV-070 f/u: default to the caller's PARTY (projectManagerPartyId FKs to party), not
                     ec.user.userId (a user id) — the latter FK-violates whenever a project is created without a
                     manager picked. -->
                <set field="projectManagerPartyId" from="ec.user.userAccount?.partyId"/>
            </if>
            <service-call name="create#zenith.erp.project.Project" in-map="context" out-map="context"/>
        </actions>
    </service>

    <!-- ========== Update Project ========== -->
    <service verb="update" noun="Project">
        <in-parameters>
            <parameter name="projectId" required="true"/>
            <parameter name="organizationPartyId"/>
            <parameter name="projectName"/>
            <parameter name="description"/>
            <parameter name="projectManagerPartyId"/>
            <parameter name="startDate" type="Date"/>
            <parameter name="targetEndDate" type="Date"/>
            <parameter name="actualEndDate" type="Date"/>
            <parameter name="statusId"/>
            <parameter name="priority"/>
            <parameter name="budgetAmount" type="BigDecimal"/>
            <parameter name="currencyUomId"/>
            <parameter name="completionPercent" type="Integer"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.project.Project" in-map="context"/>
        </actions>
    </service>

    <!-- ========== Create Project Task ========== -->
    <service verb="create" noun="ProjectTask">
        <in-parameters>
            <parameter name="projectId" required="true"/>
            <parameter name="taskName" required="true"/>
            <parameter name="description"/>
            <parameter name="assignedToPartyId"/>
            <parameter name="priority"/>
            <parameter name="estimatedHours" type="BigDecimal"/>
            <parameter name="startDate" type="Date"/>
            <parameter name="dueDate" type="Date"/>
            <parameter name="parentTaskId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taskId" required="true"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="TaskNew"/>
            <service-call name="create#zenith.erp.project.ProjectTask" in-map="context" out-map="context"/>
            <service-call name="zenith.project.ProjectServices.recalculate#ProjectCompletion"
                          in-map="[projectId: projectId]"/>
        </actions>
    </service>

    <!-- ========== Update Project Task ========== -->
    <service verb="update" noun="ProjectTask">
        <in-parameters>
            <parameter name="taskId" required="true"/>
            <parameter name="taskName"/>
            <parameter name="description"/>
            <parameter name="assignedToPartyId"/>
            <parameter name="statusId"/>
            <parameter name="priority"/>
            <parameter name="estimatedHours" type="BigDecimal"/>
            <parameter name="actualHours" type="BigDecimal"/>
            <parameter name="startDate" type="Date"/>
            <parameter name="dueDate" type="Date"/>
            <parameter name="parentTaskId"/>
            <parameter name="sequenceNum" type="Integer"/>
        </in-parameters>
        <actions>
            <!-- If status changed to TaskDone, set completedDate -->
            <if condition="statusId == 'TaskDone'">
                <set field="completedDate" from="ec.user.nowTimestamp"/>
            </if>

            <!-- Look up the task to get projectId for recalculation -->
            <entity-find-one entity-name="zenith.erp.project.ProjectTask" value-field="task">
                <field-map field-name="taskId"/>
            </entity-find-one>

            <service-call name="update#zenith.erp.project.ProjectTask" in-map="context"/>

            <!-- Recalculate project completion -->
            <service-call name="zenith.project.ProjectServices.recalculate#ProjectCompletion"
                          in-map="[projectId: task.projectId]"/>
        </actions>
    </service>

    <!-- ========== Recalculate Project Completion ========== -->
    <service verb="recalculate" noun="ProjectCompletion">
        <in-parameters>
            <parameter name="projectId" required="true"/>
        </in-parameters>
        <actions>
            <!-- Count total tasks -->
            <entity-find-count entity-name="zenith.erp.project.ProjectTask" count-field="totalTasks">
                <econdition field-name="projectId"/>
            </entity-find-count>

            <!-- Count done tasks -->
            <entity-find-count entity-name="zenith.erp.project.ProjectTask" count-field="doneTasks">
                <econdition field-name="projectId"/>
                <econdition field-name="statusId" value="TaskDone"/>
            </entity-find-count>

            <!-- Calculate percentage -->
            <set field="completionPercent" value="0" type="Integer"/>
            <if condition="totalTasks &gt; 0">
                <set field="completionPercent" from="((doneTasks * 100) / totalTasks) as Integer"/>
            </if>

            <!-- Update Project -->
            <service-call name="update#zenith.erp.project.Project"
                          in-map="[projectId: projectId, completionPercent: completionPercent]"/>
        </actions>
    </service>

    <!-- ========== Add Project Member ========== -->
    <service verb="add" noun="ProjectMember">
        <in-parameters>
            <parameter name="projectId" required="true"/>
            <parameter name="partyId" required="true"/>
            <parameter name="roleDescription"/>
        </in-parameters>
        <actions>
            <set field="fromDate" from="ec.user.nowTimestamp"/>
            <service-call name="store#zenith.erp.project.ProjectMember" in-map="context"/>
        </actions>
    </service>

    <!-- ========== Remove Project Member ========== -->
    <service verb="remove" noun="ProjectMember">
        <in-parameters>
            <parameter name="projectId" required="true"/>
            <parameter name="partyId" required="true"/>
        </in-parameters>
        <actions>
            <set field="thruDate" from="ec.user.nowTimestamp"/>
            <service-call name="store#zenith.erp.project.ProjectMember" in-map="context"/>
        </actions>
    </service>

</services>
