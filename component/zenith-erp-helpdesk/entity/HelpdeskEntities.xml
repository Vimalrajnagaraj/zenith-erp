<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Help Department ========== -->
    <entity entity-name="HelpDepartment" package="zenith.erp.helpdesk" short-alias="HelpDepartments">
        <field name="departmentId" type="id" is-pk="true"/>
        <field name="departmentName" type="text-medium"/>
        <field name="managerPartyId" type="id"/>
        <field name="email" type="text-medium"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Ticket Category ========== -->
    <entity entity-name="TicketCategory" package="zenith.erp.helpdesk" short-alias="TicketCategories">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="departmentId" type="id"/>
        <field name="defaultPriority" type="text-short"/>
        <field name="slaPolicyId" type="id"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.helpdesk.HelpDepartment" fk-name="FK_TKCAT_DEPT"/>
        <relationship type="one" related="zenith.erp.helpdesk.SlaPolicy" fk-name="FK_TKCAT_SLA">
            <key-map field-name="slaPolicyId" related="policyId"/></relationship>
    </entity>

    <!-- ========== SLA Policy ========== -->
    <entity entity-name="SlaPolicy" package="zenith.erp.helpdesk" short-alias="SlaPolicies">
        <field name="policyId" type="id" is-pk="true"/>
        <field name="policyName" type="text-medium"/>
        <field name="priorityLevel" type="text-short"/>
        <field name="firstResponseHours" type="number-integer"/>
        <field name="resolutionHours" type="number-integer"/>
        <field name="businessHoursOnly" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Ticket ========== -->
    <entity entity-name="Ticket" package="zenith.erp.helpdesk" short-alias="Tickets">
        <field name="ticketId" type="id" is-pk="true"/>
        <field name="ticketNumber" type="text-short"/>
        <field name="categoryId" type="id"/>
        <field name="departmentId" type="id"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="customerName" type="text-medium"/>
        <field name="customerEmail" type="text-medium"/>
        <field name="customerPhone" type="text-short"/>
        <field name="subject" type="text-medium"/>
        <field name="description" type="text-very-long"/>
        <field name="priority" type="text-short"/>
        <field name="channel" type="text-short"/>
        <field name="statusId" type="id"/>
        <field name="entryDate" type="date-time"/>
        <field name="slaResponseDeadline" type="date-time"/>
        <field name="slaResolutionDeadline" type="date-time"/>
        <field name="firstResponseDate" type="date-time"/>
        <field name="resolvedDate" type="date-time"/>
        <field name="closedDate" type="date-time"/>
        <field name="satisfaction" type="number-integer"/>
        <field name="satisfactionComment" type="text-long"/>
        <field name="slaBreached" type="text-indicator"/>
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="mantle.party.Party" title="Organization"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.helpdesk.TicketCategory"/>
        <relationship type="one" related="zenith.erp.helpdesk.HelpDepartment"/>
        <relationship type="one" title="Ticket" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Ticket" description="Helpdesk Ticket"/>
            <moqui.basic.StatusItem statusId="TkNew" statusTypeId="Ticket" description="New" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="TkOpen" statusTypeId="Ticket" description="Open" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="TkInProgress" statusTypeId="Ticket" description="In Progress" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="TkWaiting" statusTypeId="Ticket" description="Waiting on Customer" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="TkEscalated" statusTypeId="Ticket" description="Escalated" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="TkResolved" statusTypeId="Ticket" description="Resolved" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="TkClosed" statusTypeId="Ticket" description="Closed" sequenceNum="7"/>
            <moqui.basic.StatusItem statusId="TkReopened" statusTypeId="Ticket" description="Reopened" sequenceNum="8"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkNew" toStatusId="TkOpen" transitionName="Open"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkNew" toStatusId="TkInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkOpen" toStatusId="TkInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkOpen" toStatusId="TkEscalated" transitionName="Escalate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkInProgress" toStatusId="TkWaiting" transitionName="Wait"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkInProgress" toStatusId="TkEscalated" transitionName="Escalate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkInProgress" toStatusId="TkResolved" transitionName="Resolve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkWaiting" toStatusId="TkInProgress" transitionName="Resume"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkEscalated" toStatusId="TkInProgress" transitionName="De-escalate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkResolved" toStatusId="TkClosed" transitionName="Close"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkResolved" toStatusId="TkReopened" transitionName="Reopen"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkClosed" toStatusId="TkReopened" transitionName="Reopen"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TkReopened" toStatusId="TkInProgress" transitionName="Start"/>
        </seed-data>
    </entity>

    <!-- ========== Ticket Comment ========== -->
    <entity entity-name="TicketComment" package="zenith.erp.helpdesk" short-alias="TicketComments">
        <field name="commentId" type="id" is-pk="true"/>
        <field name="ticketId" type="id"/>
        <field name="commentText" type="text-very-long"/>
        <field name="commentType" type="text-short"/>
        <field name="authorPartyId" type="id"/>
        <field name="commentDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.helpdesk.Ticket"/>
    </entity>

    <!-- ========== Canned Response ========== -->
    <entity entity-name="CannedResponse" package="zenith.erp.helpdesk" short-alias="CannedResponses">
        <field name="responseId" type="id" is-pk="true"/>
        <field name="responseName" type="text-medium"/>
        <field name="responseText" type="text-very-long"/>
        <field name="categoryId" type="id"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.helpdesk.TicketCategory"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="TicketView" package="zenith.erp.helpdesk">
        <member-entity entity-alias="TK" entity-name="zenith.erp.helpdesk.Ticket"/>
        <member-entity entity-alias="TC" entity-name="zenith.erp.helpdesk.TicketCategory" join-from-alias="TK" join-optional="true">
            <key-map field-name="categoryId"/></member-entity>
        <member-entity entity-alias="HD" entity-name="zenith.erp.helpdesk.HelpDepartment" join-from-alias="TK" join-optional="true">
            <key-map field-name="departmentId"/></member-entity>
        <alias-all entity-alias="TK"/>
        <alias entity-alias="TC" name="categoryName"/>
        <alias entity-alias="HD" name="departmentName"/>
    </view-entity>
</entities>
