<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Ticket Detail" default-menu-index="2" default-menu-include="false">

    <parameter name="ticketId" required="true"/>

    <transition name="updateTicket" begin-transaction="true">
        <service-call name="update#zenith.erp.helpdesk.Ticket"/>
        <default-response url="."/>
    </transition>
    <transition name="assignTicket" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.assign#Ticket"/>
        <default-response url="."/>
    </transition>
    <transition name="updateStatus" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.updateStatus#Ticket"/>
        <default-response url="."/>
    </transition>
    <transition name="addComment" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.add#TicketComment"/>
        <default-response url="."/>
    </transition>
    <transition name="rateTicket" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.rate#Ticket"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.helpdesk.Ticket" value-field="ticket"/>
        <entity-find entity-name="zenith.erp.helpdesk.TicketComment" list="commentList">
            <econdition field-name="ticketId"/>
            <order-by field-name="commentDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <!-- Ticket Detail -->
                <container-box><box-header title="${ticket.ticketNumber}: ${ticket.subject}"/>
                <box-body>
                    <form-single name="TicketForm" transition="updateTicket" map="ticket">
                        <field name="ticketId"><default-field><hidden/></default-field></field>
                        <field name="ticketNumber"><default-field title="Number"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="subject"><default-field title="Subject"><text-line size="40"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="4" cols="40"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.helpdesk.TicketCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down><option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/></drop-down></default-field></field>
                        <field name="channel"><default-field title="Channel"><display/></default-field></field>
                        <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                        <field name="customerEmail"><default-field title="Email"><display/></default-field></field>
                        <field name="customerPhone"><default-field title="Phone"><display/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <!-- SLA Info -->
                <container-box><box-header title="SLA"/>
                <box-body>
                    <form-single name="SlaInfo" map="ticket">
                        <field name="entryDate"><default-field title="Created"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="slaResponseDeadline"><default-field title="Response Deadline"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="firstResponseDate"><default-field title="First Response"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="slaResolutionDeadline"><default-field title="Resolution Deadline"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="resolvedDate"><default-field title="Resolved"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="closedDate"><default-field title="Closed"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="slaBreached"><default-field title="SLA Breached"><display/></default-field></field>
                        <field name="satisfaction"><default-field title="Satisfaction"><display/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Actions -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <container-dialog id="AssignDialog" button-text="Assign">
                        <form-single name="AssignForm" transition="assignTicket">
                            <field name="ticketId"><default-field><hidden/></default-field></field>
                            <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="20"/></default-field></field>
                            <field name="submitButton"><default-field title="Assign"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="StatusDialog" button-text="Change Status">
                        <form-single name="StatusForm" transition="updateStatus">
                            <field name="ticketId"><default-field><hidden/></default-field></field>
                            <field name="statusId"><default-field title="New Status">
                                <drop-down><entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Ticket"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="RateDialog" button-text="Customer Feedback">
                        <form-single name="RateForm" transition="rateTicket">
                            <field name="ticketId"><default-field><hidden/></default-field></field>
                            <field name="satisfaction"><default-field title="Rating (1-5)">
                                <drop-down><option key="1" text="1 - Very Poor"/><option key="2" text="2 - Poor"/>
                                    <option key="3" text="3 - Average"/><option key="4" text="4 - Good"/>
                                    <option key="5" text="5 - Excellent"/></drop-down></default-field></field>
                            <field name="satisfactionComment"><default-field title="Comment"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-body></container-box>

                <!-- Comments / Conversation -->
                <container-box><box-header title="Conversation"/>
                <box-toolbar>
                    <container-dialog id="AddCommentDialog" button-text="Add Reply">
                        <form-single name="AddCommentForm" transition="addComment">
                            <field name="ticketId"><default-field><hidden/></default-field></field>
                            <field name="commentText"><default-field title="Reply"><text-area rows="5" cols="50"/></default-field></field>
                            <field name="commentType"><default-field title="Type">
                                <drop-down no-current-selected-key="Public">
                                    <option key="Public"/><option key="Internal Note"/>
                                </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Send"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <link url="." text="Generate AI Draft" icon="glyphicon glyphicon-flash" class="btn btn-info" tooltip="Draft a response using Generative AI"/>
                    <link url="." text="Summarize Thread" icon="glyphicon glyphicon-list-alt" class="btn btn-warning" tooltip="Summarize long customer threads for internal notes"/>
                </box-toolbar>

                <box-body>
                    <form-list name="CommentList" list="commentList" skip-form="true">
                        <field name="commentDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="authorPartyId"><default-field title="Author"><display/></default-field></field>
                        <field name="commentType"><default-field title="Type"><display/></default-field></field>
                        <field name="commentText"><default-field title="Message"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
