<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Departments" default-menu-index="3">

    <transition name="createDept" begin-transaction="true">
        <service-call name="create#zenith.erp.helpdesk.HelpDepartment"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDept" begin-transaction="true">
        <service-call name="update#zenith.erp.helpdesk.HelpDepartment"/>
        <default-response url="."/>
    </transition>
    <transition name="createCategory" begin-transaction="true">
        <service-call name="create#zenith.erp.helpdesk.TicketCategory"/>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <service-call name="update#zenith.erp.helpdesk.TicketCategory"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment" list="deptList">
            <order-by field-name="departmentName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.helpdesk.TicketCategory" list="catList">
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Departments"/>
            <box-toolbar>
                <container-dialog id="CreateDeptDialog" button-text="New Department">
                    <form-single name="CreateDeptForm" transition="createDept">
                        <field name="departmentId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="departmentName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="managerPartyId"><default-field title="Manager Party ID"><text-line size="15"/></default-field></field>
                        <field name="email"><default-field title="Department Email"><text-line size="30"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="DeptList" list="deptList" transition="updateDept">
                    <field name="departmentId"><default-field title="ID"><display/></default-field></field>
                    <field name="departmentName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="managerPartyId"><default-field title="Manager"><text-line size="12"/></default-field></field>
                    <field name="email"><default-field title="Email"><text-line size="25"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Ticket Categories"/>
            <box-toolbar>
                <container-dialog id="CreateCatDialog" button-text="New Category">
                    <form-single name="CreateCatForm" transition="createCategory">
                        <field name="categoryId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="categoryName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="departmentId"><default-field title="Department">
                            <drop-down><entity-options key="${departmentId}" text="${departmentName}">
                                <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="defaultPriority"><default-field title="Default Priority">
                            <drop-down no-current-selected-key="Medium">
                                <option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/>
                            </drop-down></default-field></field>
                        <field name="slaPolicyId"><default-field title="SLA Policy">
                            <drop-down allow-empty="true"><entity-options key="${policyId}" text="${policyName}">
                                <entity-find entity-name="zenith.erp.helpdesk.SlaPolicy">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="CatList" list="catList" transition="updateCategory">
                    <field name="categoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="departmentId"><default-field title="Department">
                        <drop-down><entity-options key="${departmentId}" text="${departmentName}">
                            <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="defaultPriority"><default-field title="Priority">
                        <drop-down><option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/></drop-down></default-field></field>
                    <field name="slaPolicyId"><default-field title="SLA">
                        <drop-down allow-empty="true"><entity-options key="${policyId}" text="${policyName}">
                            <entity-find entity-name="zenith.erp.helpdesk.SlaPolicy"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
