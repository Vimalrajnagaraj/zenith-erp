<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Departments" default-menu-index="3">

    <transition name="createDept" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4/5): a dept manager must be a member of your org; the dept is stamped private
                 (a no-org admin authors a global shared dept). -->
            <if condition="managerPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ma" in-map="[partyId:managerPartyId]"/>
                <if condition="!_ma.allowed"><return error="true" message="That manager isn't part of your organization."/></if>
            </if>
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.helpdesk.HelpDepartment" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateDept" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): edit only your own dept (global seeds are read-only to tenants). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.helpdesk.HelpDepartment', idField:'departmentId', idValue:departmentId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Department not found for your account."/></if>
            <if condition="managerPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_ma" in-map="[partyId:managerPartyId]"/>
                <if condition="!_ma.allowed"><return error="true" message="That manager isn't part of your organization."/></if>
            </if>
            <service-call name="update#zenith.erp.helpdesk.HelpDepartment" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="createCategory" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4, global+private): tenant-created category is private; a no-org admin authors a global one. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.helpdesk.TicketCategory" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): edit only your own category (global seeds are read-only to tenants). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.helpdesk.TicketCategory', idField:'categoryId', idValue:categoryId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Category not found for your account."/></if>
            <service-call name="update#zenith.erp.helpdesk.TicketCategory" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment" list="deptList">
            <!-- ZE-SB-013 (Tier 4): this org's depts + global shared seeds. -->
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="departmentName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.helpdesk.TicketCategory" list="catList">
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Departments"/>
            <box-toolbar>
                <section name="hd_CreateDept_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateDeptDialog" button-text="New Department">
                    <form-single name="CreateDeptForm" transition="createDept">
                        <field name="departmentId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="departmentName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="managerPartyId"><default-field title="Manager Party ID"><text-line size="15"/></default-field></field>
                        <field name="email"><default-field title="Department Email"><text-line size="30"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DeptList" list="deptList" transition="updateDept">
                    <field name="departmentId"><default-field title="ID"><display/></default-field></field>
                    <field name="departmentName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="managerPartyId"><default-field title="Manager"><text-line size="12"/></default-field></field>
                    <field name="email"><default-field title="Email"><text-line size="25"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="hd_dept_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Ticket Categories"/>
            <box-toolbar>
                <section name="hd_CreateCat_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCatDialog" button-text="New Category">
                    <form-single name="CreateCatForm" transition="createCategory">
                        <field name="categoryId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="categoryName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="departmentId"><default-field title="Department">
                            <drop-down><entity-options key="${departmentId}" text="${departmentName}">
                                <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own depts + global shared seeds. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="defaultPriority"><default-field title="Default Priority">
                            <drop-down no-current-selected-key="Medium">
                                <option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/>
                            </drop-down></default-field></field>
                        <field name="slaPolicyId"><default-field title="SLA Policy">
                            <drop-down allow-empty="true"><entity-options key="${policyId}" text="${policyName}">
                                <entity-find entity-name="zenith.erp.helpdesk.SlaPolicy">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own policies + global shared seeds. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CatList" list="catList" transition="updateCategory">
                    <field name="categoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="departmentId"><default-field title="Department">
                        <drop-down><entity-options key="${departmentId}" text="${departmentName}">
                            <entity-find entity-name="zenith.erp.helpdesk.HelpDepartment"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="defaultPriority"><default-field title="Priority">
                        <drop-down><option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/></drop-down></default-field></field>
                    <field name="slaPolicyId"><default-field title="SLA">
                        <drop-down allow-empty="true"><entity-options key="${policyId}" text="${policyName}">
                            <entity-find entity-name="zenith.erp.helpdesk.SlaPolicy"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="hd_cat_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
