<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="SLA Policies" default-menu-index="4">

    <transition name="createPolicy" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4, global+private): tenant-created policy is private; a no-org admin authors a global one. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.helpdesk.SlaPolicy" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicy" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): edit only your own policy (global seeds are read-only to tenants). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.helpdesk.SlaPolicy', idField:'policyId', idValue:policyId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Policy not found for your account."/></if>
            <service-call name="update#zenith.erp.helpdesk.SlaPolicy" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="checkBreach" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.check#SlaBreach" out-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.helpdesk.SlaPolicy" list="policyList">
            <!-- ZE-SB-013 (Tier 4): this org's policies + global shared seeds. -->
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="priorityLevel"/>
        </entity-find>
        <!-- Breached tickets count -->
        <entity-find entity-name="zenith.erp.helpdesk.Ticket" list="breachedList">
            <econdition field-name="slaBreached" value="Y"/>
            <econdition field-name="statusId" operator="in" value="TkNew,TkOpen,TkInProgress,TkWaiting,TkEscalated"/>
            <!-- ZE-SB-013 (Tier 4): show only this org's breached tickets. -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="SLA Policies"/>
            <box-toolbar>
                <section name="hd_SlaToolbar_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreatePolicyDialog" button-text="New Policy">
                    <form-single name="CreatePolicyForm" transition="createPolicy">
                        <field name="policyId"><default-field title="Policy ID"><text-line size="15"/></default-field></field>
                        <field name="policyName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="priorityLevel"><default-field title="Priority">
                            <drop-down><option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/></drop-down></default-field></field>
                        <field name="firstResponseHours"><default-field title="First Response (hours)"><text-line size="5"/></default-field></field>
                        <field name="resolutionHours"><default-field title="Resolution (hours)"><text-line size="5"/></default-field></field>
                        <field name="businessHoursOnly"><default-field title="Business Hours Only">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No (24x7)"/></drop-down></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <link url="checkBreach" text="Check SLA Breaches" confirmation="Scan all open tickets for SLA breaches?"/>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="PolicyList" list="policyList" transition="updatePolicy">
                    <field name="policyId"><default-field title="ID"><display/></default-field></field>
                    <field name="policyName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="priorityLevel"><default-field title="Priority">
                        <drop-down><option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/></drop-down></default-field></field>
                    <field name="firstResponseHours"><default-field title="Response (hrs)"><text-line size="4"/></default-field></field>
                    <field name="resolutionHours"><default-field title="Resolution (hrs)"><text-line size="4"/></default-field></field>
                    <field name="businessHoursOnly"><default-field title="Biz Hours">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="24x7"/></drop-down></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="hd_policy_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Active SLA Breaches (${breachedList.size()})"/>
            <box-body>
                <form-list name="BreachedList" list="breachedList" skip-form="true">
                    <field name="ticketId"><default-field title="Ticket"><display/></default-field></field>
                    <field name="ticketNumber"><default-field title="Number"><display/></default-field></field>
                    <field name="subject"><default-field title="Subject"><display/></default-field></field>
                    <field name="priority"><default-field title="Priority"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="slaResolutionDeadline"><default-field title="Deadline"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="assignedToPartyId"><default-field title="Assigned"><display/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
