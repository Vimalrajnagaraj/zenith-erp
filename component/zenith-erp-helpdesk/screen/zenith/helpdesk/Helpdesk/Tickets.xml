<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tickets" default-menu-index="1">

    <transition name="createTicket" begin-transaction="true">
        <service-call name="zenith.helpdesk.HelpdeskServices.create#Ticket"/>
        <default-response url="../EditTicket"/>
    </transition>
    <transition name="editTicket"><default-response url="../EditTicket"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.helpdesk.TicketView" list="ticketList">
            <search-form-inputs default-order-by="-entryDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate the support desk — a tenant sees only its own tickets (org set on
                 create from the raising user's active org); super-admin/vendor sees all (ignore-if-empty). -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="bg-indigo-9 text-white shadow-2 q-pa-md q-mb-md border-radius-md row items-center justify-between">
            <container style="row items-center">
                <render-mode><text type="html"><![CDATA[<q-icon name="headset_mic" class="q-mr-sm text-h5"/>]]></text></render-mode>
                <label text="Help Desk Support:" type="strong" style="q-mr-md text-subtitle1"/>
                <label text="Sarveshwar (+91 63806 80997)" type="span" style="q-mr-md text-indigo-1"/>
                <label text="|  +91 86670 72716" type="span" style="q-mr-md text-indigo-1"/>
                <label text="|  vishnurajen1@gmail.com" type="span" style="text-indigo-1"/>
            </container>
        </container>

        <container-box>
            <box-header title="Support Tickets"/>
            <box-toolbar>
                <section name="hd_CreateTicket_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateTicketDialog" button-text="New Ticket">
                    <form-single name="CreateTicketForm" transition="createTicket">
                        <field name="subject"><default-field title="Subject"><text-line size="50"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="5" cols="50"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.helpdesk.TicketCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own categories + global shared seeds. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down no-current-selected-key="Medium">
                                <option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/>
                            </drop-down></default-field></field>
                        <field name="channel"><default-field title="Channel">
                            <drop-down no-current-selected-key="Portal">
                                <option key="Portal"/><option key="Email"/><option key="Phone"/>
                                <option key="WhatsApp"/><option key="Chat"/>
                            </drop-down></default-field></field>
                        <field name="customerName"><default-field title="Customer Name"><text-line size="30"/></default-field></field>
                        <field name="customerEmail"><default-field title="Customer Email"><text-line size="30"/></default-field></field>
                        <field name="customerPhone"><default-field title="Customer Phone"><text-line size="15"/></default-field></field>
                        <field name="submitButton"><default-field title="Create Ticket"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Tickets..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TicketList" list="ticketList" skip-form="true" header-dialog="true"
                           select-columns="true" saved-finds="true" show-csv-button="true" show-all-button="true">
                    <field name="ticketId"><default-field title="ID">
                        <link url="editTicket" text="${ticketId}" link-type="anchor"
                              parameter-map="[ticketId:ticketId]"/></default-field></field>
                    <field name="ticketNumber"><header-field title="Number" show-order-by="true"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="subject"><header-field title="Subject"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="categoryName"><header-field title="Category" show-order-by="true"/>
                        <default-field><display/></default-field></field>
                    <field name="departmentName"><header-field title="Department"/>
                        <default-field><display/></default-field></field>
                    <field name="priority"><header-field title="Priority" show-order-by="true">
                            <drop-down allow-empty="true">
                                <option key="Low"/><option key="Medium"/><option key="High"/><option key="Critical"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="channel"><header-field title="Channel">
                            <drop-down allow-empty="true">
                                <option key="Portal"/><option key="Email"/><option key="Phone"/>
                                <option key="WhatsApp"/><option key="Chat"/>
                            </drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="statusId"><header-field title="Status" show-order-by="true">
                            <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Ticket"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="customerName"><header-field title="Customer"><text-find/></header-field>
                        <default-field><display/></default-field></field>
                    <field name="assignedToPartyId"><header-field title="Assigned To"/>
                        <default-field><display/></default-field></field>
                    <field name="entryDate"><header-field title="Created" show-order-by="true"><date-period/></header-field>
                        <default-field><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="slaBreached"><header-field title="SLA Breach">
                            <drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></header-field>
                        <default-field><display/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
