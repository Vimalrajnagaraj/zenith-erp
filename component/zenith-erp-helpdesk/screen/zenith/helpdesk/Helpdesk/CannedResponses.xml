<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Canned Responses" default-menu-index="5">

    <transition name="createResponse" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4, global+private): a tenant-created response is private; a no-org admin authors a global one. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.helpdesk.CannedResponse" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateResponse" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): edit only your own response (global seeds are read-only to tenants). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.helpdesk.CannedResponse', idField:'responseId', idValue:responseId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Response not found for your account."/></if>
            <service-call name="update#zenith.erp.helpdesk.CannedResponse" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteResponse" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): delete only your own response (can't delete a global seed or another org's). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.helpdesk.CannedResponse', idField:'responseId', idValue:responseId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Response not found for your account."/></if>
            <service-call name="delete#zenith.erp.helpdesk.CannedResponse" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.helpdesk.CannedResponse" list="responseList">
            <!-- ZE-SB-013 (Tier 4): this org's responses + global shared seeds. -->
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="responseName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Canned Responses"/>
            <box-toolbar>
                <section name="hd_CreateResponse_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateResponseDialog" button-text="New Response">
                    <form-single name="CreateResponseForm" transition="createResponse">
                        <field name="responseId"><default-field title="Response ID"><text-line size="15"/></default-field></field>
                        <field name="responseName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.helpdesk.TicketCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own categories + global shared seeds. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="responseText"><default-field title="Response Text"><text-area rows="6" cols="50"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="ResponseList" list="responseList" transition="updateResponse">
                    <field name="responseId"><default-field title="ID"><display/></default-field></field>
                    <field name="responseName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="categoryId"><default-field title="Category">
                        <drop-down allow-empty="true"><entity-options key="${categoryId}" text="${categoryName}">
                            <entity-find entity-name="zenith.erp.helpdesk.TicketCategory"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="responseText"><default-field title="Response"><text-area rows="3" cols="40"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="hd_resp_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                    <field name="deleteBtn">
                        <conditional-field name="hd_resp_delete_write" condition="modCanWrite" title="">
                        <link url="deleteResponse" text="X" parameter-map="[responseId:responseId]"
                              confirmation="Delete this response?"/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
