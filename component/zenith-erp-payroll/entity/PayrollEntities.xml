<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Salary Structure Template (generic) ========== -->
    <entity entity-name="SalaryStructure" package="zenith.erp.payroll" short-alias="SalaryStructures">
        <field name="salaryStructureId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="structureName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="basicPercentOfGross" type="number-decimal"/>
        <field name="conveyanceMonthly" type="currency-amount"/>
        <field name="medicalMonthly" type="currency-amount"/>
        <field name="isDefault" type="text-indicator"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- ========== Payroll Run (Monthly Batch) ========== -->
    <entity entity-name="PayrollRun" package="zenith.erp.payroll" short-alias="PayrollRuns">
        <field name="payrollRunId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="runName" type="text-medium"/>
        <field name="periodYear" type="number-integer"/>
        <field name="periodMonth" type="number-integer"/>
        <field name="fromDate" type="date"/>
        <field name="toDate" type="date"/>
        <field name="totalWorkingDays" type="number-integer"/>
        <field name="statusId" type="text-short"/>
        <field name="processedDate" type="date-time"/>
        <field name="finalizedDate" type="date-time"/>
        <field name="paidDate" type="date-time"/>
        <field name="totalGrossEarnings" type="currency-amount"/>
        <field name="totalDeductions" type="currency-amount"/>
        <field name="totalNetPay" type="currency-amount"/>
        <field name="totalEmployerCost" type="currency-amount"/>
        <field name="employeeCount" type="number-integer"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="PayrollRun" description="Payroll Run"/>
            <moqui.basic.StatusItem statusId="PrDraft" statusTypeId="PayrollRun" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="PrProcessed" statusTypeId="PayrollRun" description="Processed" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="PrFinalized" statusTypeId="PayrollRun" description="Finalized" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="PrPaid" statusTypeId="PayrollRun" description="Paid" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrDraft" toStatusId="PrProcessed" transitionName="Process"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrProcessed" toStatusId="PrFinalized" transitionName="Finalize"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrFinalized" toStatusId="PrPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrProcessed" toStatusId="PrDraft" transitionName="Revert to Draft"/>
        </seed-data>
    </entity>

    <!-- ========== Payslip (generic) ========== -->
    <entity entity-name="Payslip" package="zenith.erp.payroll" short-alias="Payslips">
        <field name="payslipId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="payrollRunId" type="id"/>
        <field name="employeeId" type="id"/>
        <field name="periodYear" type="number-integer"/>
        <field name="periodMonth" type="number-integer"/>

        <field name="totalDaysInMonth" type="number-integer"/>
        <field name="workingDays" type="number-integer"/>
        <field name="presentDays" type="number-decimal"/>
        <field name="lwpDays" type="number-decimal"/>
        <field name="paidDays" type="number-decimal"/>

        <field name="basicPay" type="currency-amount"/>
        <field name="specialAllowance" type="currency-amount"/>
        <field name="otherEarnings" type="currency-amount"/>
        <field name="grossEarnings" type="currency-amount"/>

        <field name="incomeTax" type="currency-amount"/>
        <field name="advanceRecovery" type="currency-amount"/>
        <field name="otherDeductions" type="currency-amount"/>
        <field name="totalDeductions" type="currency-amount"/>

        <field name="netPay" type="currency-amount"/>
        <field name="totalEmployerCost" type="currency-amount"/>
        <field name="statusId" type="text-short"/>

        <relationship type="one" related="zenith.erp.payroll.PayrollRun"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>

        <seed-data>
            <moqui.basic.StatusType statusTypeId="Payslip" description="Payslip"/>
            <moqui.basic.StatusItem statusId="PsDraft" statusTypeId="Payslip" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="PsCalculated" statusTypeId="Payslip" description="Calculated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="PsApproved" statusTypeId="Payslip" description="Approved" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="PsPaid" statusTypeId="Payslip" description="Paid" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PsDraft" toStatusId="PsCalculated" transitionName="Calculate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PsCalculated" toStatusId="PsApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PsApproved" toStatusId="PsPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PsCalculated" toStatusId="PsDraft" transitionName="Recalculate"/>
        </seed-data>
    </entity>

    <!-- ========== Salary Advance / Loan ========== -->
    <entity entity-name="SalaryAdvance" package="zenith.erp.payroll" short-alias="SalaryAdvances">
        <field name="salaryAdvanceId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="employeeId" type="id"/>
        <field name="advanceDate" type="date"/>
        <field name="amount" type="currency-amount"/>
        <field name="reason" type="text-long"/>
        <field name="monthlyRecoveryAmount" type="currency-amount"/>
        <field name="totalRecovered" type="currency-amount"/>
        <field name="balanceAmount" type="currency-amount"/>
        <field name="statusId" type="text-short"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="SalaryAdvance" description="Salary Advance"/>
            <moqui.basic.StatusItem statusId="SaApproved" statusTypeId="SalaryAdvance" description="Approved" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="SaRecovering" statusTypeId="SalaryAdvance" description="Recovering" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="SaCompleted" statusTypeId="SalaryAdvance" description="Completed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="SaCancelled" statusTypeId="SalaryAdvance" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SaApproved" toStatusId="SaRecovering" transitionName="Start Recovery"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SaRecovering" toStatusId="SaCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SaApproved" toStatusId="SaCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="PayslipView" package="zenith.erp.payroll">
        <member-entity entity-alias="PS" entity-name="zenith.erp.payroll.Payslip"/>
        <member-entity entity-alias="EMP" entity-name="zenith.erp.hr.Employee" join-from-alias="PS">
            <key-map field-name="employeeId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="EMP">
            <key-map field-name="partyId"/></member-entity>
        <!-- alias-all PS exposes Payslip.organizationPartyId (stamped from active org) for org-isolation filtering -->
        <alias-all entity-alias="PS"/>
        <alias entity-alias="EMP" name="employeeCode"/>
        <alias entity-alias="EMP" name="departmentId"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>

    <view-entity entity-name="SalaryAdvanceView" package="zenith.erp.payroll">
        <member-entity entity-alias="SA" entity-name="zenith.erp.payroll.SalaryAdvance"/>
        <member-entity entity-alias="EMP" entity-name="zenith.erp.hr.Employee" join-from-alias="SA">
            <key-map field-name="employeeId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="EMP">
            <key-map field-name="partyId"/></member-entity>
        <!-- alias-all SA exposes SalaryAdvance.organizationPartyId (stamped from active org) for org-isolation filtering -->
        <alias-all entity-alias="SA"/>
        <alias entity-alias="EMP" name="employeeCode"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
    </view-entity>
</entities>
