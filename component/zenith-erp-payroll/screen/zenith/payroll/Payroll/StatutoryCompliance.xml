<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Statutory Compliance" default-menu-index="7">

    <transition name="calculateAll">
        <actions>
            <entity-find entity-name="zenith.erp.hr.Employee" list="activeEmployees">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="statusId" operator="in" value="EmpActive,EmpProbation"/>
            </entity-find>
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="year" from="cal.get(java.util.Calendar.YEAR)"/>
            <set field="month" from="cal.get(java.util.Calendar.MONTH) + 1"/>
            <set field="processedCount" from="0"/>
            <iterate list="activeEmployees" entry="emp">
                <if condition="emp.ctcAnnual &amp;&amp; emp.ctcAnnual > 0">
                    <set field="monthlyGross" from="emp.ctcAnnual / 12" type="BigDecimal"/>
                    <set field="basicPay" from="monthlyGross * 0.40" type="BigDecimal"/>
                    <service-call name="zenith.india.StatutoryPayrollServices.calculate#AllStatutoryDeductions"
                        in-map="[employeeId: emp.employeeId, basicPay: basicPay, grossPay: monthlyGross,
                                 stateCode: emp.regionGeoId ?: 'MH', periodYear: year, periodMonth: month,
                                 organizationPartyId: emp.organizationPartyId]"/>
                    <set field="processedCount" from="processedCount + 1"/>
                </if>
            </iterate>
            <message>Calculated statutory deductions for ${processedCount} employees.</message>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="currentMonth" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="filterYear" from="ec.web?.requestParameters?.filterYear ?: currentYear"/>
        <set field="filterMonth" from="ec.web?.requestParameters?.filterMonth ?: currentMonth"/>

        <!-- Get contributions for the period -->
        <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="contributions">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="periodYear" from="filterYear"/>
            <econdition field-name="periodMonth" from="filterMonth"/>
            <order-by field-name="employeeCode"/>
        </entity-find>

        <!-- Totals -->
        <set field="totalEpfEmployee" from="0" type="BigDecimal"/>
        <set field="totalEpfEmployer" from="0" type="BigDecimal"/>
        <set field="totalEsiEmployee" from="0" type="BigDecimal"/>
        <set field="totalEsiEmployer" from="0" type="BigDecimal"/>
        <set field="totalPt" from="0" type="BigDecimal"/>
        <set field="totalTds" from="0" type="BigDecimal"/>
        <script>
            for (def c : contributions) {
                totalEpfEmployee += (c.epfEmployeeAmount ?: 0)
                totalEpfEmployer += ((c.epfEmployerPfAmount ?: 0) + (c.epfEmployerPensionAmount ?: 0))
                totalEsiEmployee += (c.esiEmployeeAmount ?: 0)
                totalEsiEmployer += (c.esiEmployerAmount ?: 0)
                totalPt += (c.professionalTaxAmount ?: 0)
                totalTds += (c.incomeTaxAmount ?: 0)
            }
        </script>

        <set field="monthNames" from="['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Statutory Compliance Dashboard" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="EPF, ESI, Professional Tax, and TDS summary — ${monthNames[(filterMonth as int)]} ${filterYear}" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-sm">
                <link url="calculateAll" text="Calculate All" icon="fa fa-calculator"
                      btn-type="primary" style="text-weight-bold q-px-lg"
                      confirmation="Calculate statutory deductions for all active employees?"/>
            </container>
        </container>

        <!-- Summary Cards -->
        <container-row>
            <row-col lg="2">
                <container style="bg-blue-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="EPF (Employee)" type="p" style="text-primary text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEpfEmployee, '#,##,##0')}" type="h5" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-blue-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="EPF (Employer)" type="p" style="text-primary text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEpfEmployer, '#,##,##0')}" type="h5" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-green-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="ESI (Employee)" type="p" style="text-positive text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEsiEmployee, '#,##,##0')}" type="h5" style="text-positive text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-green-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="ESI (Employer)" type="p" style="text-positive text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEsiEmployer, '#,##,##0')}" type="h5" style="text-positive text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-orange-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Prof. Tax" type="p" style="text-warning text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalPt, '#,##,##0')}" type="h5" style="text-warning text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-red-1 shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="TDS" type="p" style="text-negative text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalTds, '#,##,##0')}" type="h5" style="text-negative text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- Detailed Contribution Table -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="ContributionList" list="contributions" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="employeeCode"><default-field title="Emp Code"><display/></default-field></field>
                <field name="firstName"><default-field title="Name">
                    <display text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                </default-field></field>
                <field name="uanNumber"><default-field title="UAN"><display/></default-field></field>
                <field name="basicPay"><default-field title="Basic"><display format="#,##0"/></default-field></field>
                <field name="grossPay"><default-field title="Gross"><display format="#,##0"/></default-field></field>
                <field name="epfEmployeeAmount"><default-field title="EPF (EE)"><display format="#,##0"/></default-field></field>
                <field name="epfEmployerPfAmount"><default-field title="EPF (ER)"><display format="#,##0"/></default-field></field>
                <field name="epfEmployerPensionAmount"><default-field title="Pension"><display format="#,##0"/></default-field></field>
                <field name="esiEmployeeAmount"><default-field title="ESI (EE)"><display format="#,##0"/></default-field></field>
                <field name="esiEmployerAmount"><default-field title="ESI (ER)"><display format="#,##0"/></default-field></field>
                <field name="professionalTaxAmount"><default-field title="PT"><display format="#,##0"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
