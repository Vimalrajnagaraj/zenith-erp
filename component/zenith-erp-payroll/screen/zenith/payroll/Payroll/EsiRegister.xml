<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="ESI Register" default-menu-index="9">

    <transition name="updateEsiConfig">
        <service-call name="update#zenith.erp.india.EsiConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="createEsiConfig">
        <service-call name="create#zenith.erp.india.EsiConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="exportEsiCsv" read-only="true">
        <!-- ZE-DF-001 f/u (IV-110): this is the ESI contribution *register* (reference CSV for Excel) — NOT
             the ESIC return portal-upload file. The UI button is relabelled accordingly; a real ESIC-return
             export is a separate feature pending its statutory spec (do not guess the format). Fixes:
             type="none" (was <default-response url="."/> which appended a "500 Committed" error to the file);
             sep=,/CRLF/quoted fields so Excel splits columns. -->
        <default-response type="none"/>
        <actions>
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="year" from="((ec.web?.requestParameters?.year ?: cal.get(java.util.Calendar.YEAR)).toString()) as Integer"/>
            <set field="month" from="((ec.web?.requestParameters?.month ?: (cal.get(java.util.Calendar.MONTH) + 1)).toString()) as Integer"/>
            <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="data">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="periodYear" from="year"/>
                <econdition field-name="periodMonth" from="month"/>
                <econdition field-name="esiEmployeeAmount" operator="greater" from="0"/>
                <order-by field-name="employeeCode"/>
            </entity-find>
            <script><![CDATA[
                def esc = { v -> '"' + (v == null ? '' : v.toString()).replace('"', '""') + '"' }
                def sb = new StringBuilder()
                sb.append("sep=,\r\n")
                sb.append("ESI Number,Employee Code,Name,Gross Wages,Employee ESI (0.75%),Employer ESI (3.25%),Total\r\n")
                for (def d : data) {
                    def total = (d.esiEmployeeAmount ?: 0) + (d.esiEmployerAmount ?: 0)
                    def name = ((d.firstName ?: '') + ' ' + (d.lastName ?: '')).trim()
                    sb.append([esc(d.esiNumber ?: ''), esc(d.employeeCode ?: ''), esc(name),
                               esc(d.grossPay ?: 0), esc(d.esiEmployeeAmount ?: 0), esc(d.esiEmployerAmount ?: 0), esc(total)].join(',')).append("\r\n")
                }
                ec.web.response.setContentType("text/csv; charset=UTF-8")
                ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"esi_register_${year}_${month}.csv\"")
                def w = ec.web.response.getWriter(); w.write(sb.toString()); w.flush()
            ]]></script>
        </actions>
    </transition>

    <transition name="exportEsicMcDraft" read-only="true">
        <!-- ZE-DF-001 f/u (IV-110): DRAFT ESIC Monthly Contribution upload (CSV, standard columns). NOT verified
             against the ESIC portal. "No of Days" = the payslip's paid days (blank ONLY if no payslip is linked
             to the contribution — check those rows). Reason Code defaults to 0, Last Working Day blank, Total
             Monthly Wages = gross pay (rounded). Confirm the exact ESIC template against your ESIC login before
             filing. -->
        <default-response type="none"/>
        <actions>
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="year" from="((ec.web?.requestParameters?.year ?: cal.get(java.util.Calendar.YEAR)).toString()) as Integer"/>
            <set field="month" from="((ec.web?.requestParameters?.month ?: (cal.get(java.util.Calendar.MONTH) + 1)).toString()) as Integer"/>
            <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="data">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="periodYear" from="year"/>
                <econdition field-name="periodMonth" from="month"/>
                <econdition field-name="esiEmployeeAmount" operator="greater" from="0"/>
                <order-by field-name="esiNumber"/>
            </entity-find>
            <script><![CDATA[
                def esc = { v -> '"' + (v == null ? '' : v.toString()).replace('"','""') + '"' }
                def rup = { v -> (v == null) ? 0L : Math.round((v as BigDecimal).doubleValue()) }
                def sb = new StringBuilder()
                sb.append("sep=,\r\n")
                sb.append("IP Number,IP Name,No of Days,Total Monthly Wages,Reason Code,Last Working Day\r\n")
                for (def d : data) {
                    if (!d.esiNumber) continue   // ESIC requires an IP number per member
                    def name = ((d.firstName ?: '') + ' ' + (d.lastName ?: '')).trim()
                    sb.append([esc(d.esiNumber), esc(name), esc(d.paidDays != null ? rup(d.paidDays) : ''),
                               esc(rup(d.grossPay)), esc('0'), esc('')].join(',')).append("\r\n")   // No of Days = payslip paid days
                }
                ec.web.response.setContentType("text/csv; charset=UTF-8")
                ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"ESIC_MC_DRAFT_${year}_${month}.csv\"")
                def w = ec.web.response.getWriter(); w.write(sb.toString()); w.flush()
            ]]></script>
        </actions>
    </transition>

    <actions>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="currentMonth" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="filterYear" from="((ec.web?.requestParameters?.filterYear ?: currentYear).toString()) as Integer"/>
        <set field="filterMonth" from="((ec.web?.requestParameters?.filterMonth ?: currentMonth).toString()) as Integer"/>

        <!-- ESI Configuration -->
        <entity-find entity-name="zenith.erp.india.EsiConfiguration" list="esiConfigs">
            <econdition field-name="isActive" value="Y"/>
        </entity-find>

        <!-- ESI contributions -->
        <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="esiData">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="periodYear" from="filterYear"/>
            <econdition field-name="periodMonth" from="filterMonth"/>
            <econdition field-name="esiEmployeeAmount" operator="greater" from="0"/>
            <order-by field-name="employeeCode"/>
        </entity-find>

        <!-- Totals -->
        <set field="totalGrossWages" from="0" type="BigDecimal"/>
        <set field="totalEsiEmployee" from="0" type="BigDecimal"/>
        <set field="totalEsiEmployer" from="0" type="BigDecimal"/>
        <script>
            for (def d : esiData) {
                totalGrossWages += (d.grossPay ?: 0)
                totalEsiEmployee += (d.esiEmployeeAmount ?: 0)
                totalEsiEmployer += (d.esiEmployerAmount ?: 0)
            }
        </script>
        <set field="totalEsiRemittance" from="totalEsiEmployee + totalEsiEmployer" type="BigDecimal"/>

        <set field="monthNames" from="['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']"/>

        <!-- ZE-DF-001 f/u (IV-110): pre-upload checks — flag rows likely to be rejected by the ESIC MC portal
             so they can be fixed before filing. Read-only; does not affect the export. -->
        <script><![CDATA[
            def two = new BigDecimal('2'); def three = new BigDecimal('3'); def cap = new BigDecimal(21000)
            esiIssues = []
            for (def d : esiData) {
                def name = ((d.firstName ?: '') + ' ' + (d.lastName ?: '')).trim()
                def probs = []
                def ip = (d.esiNumber ?: '').toString().trim()
                if (!ip) probs.add('IP/ESI number missing')
                else if (!ip.matches('[0-9]{10}')) probs.add('IP number not 10 digits')
                if (!name) probs.add('Name blank')
                def gross = (d.grossPay ?: 0) as BigDecimal
                if (gross <= 0) probs.add('Gross wages are 0')
                if (gross > cap) probs.add('Gross > 21000 (ESI should not apply)')
                def eeExp = gross.multiply(new BigDecimal('0.0075'))
                def ee = (d.esiEmployeeAmount ?: 0) as BigDecimal
                if ((ee - eeExp).abs() > two) probs.add('Employee ESI not ~0.75% of gross (has ' + ee + ', expected ~' + eeExp.setScale(0, java.math.RoundingMode.HALF_UP) + ')')
                def erExp = gross.multiply(new BigDecimal('0.0325'))
                def er = (d.esiEmployerAmount ?: 0) as BigDecimal
                if ((er - erExp).abs() > three) probs.add('Employer ESI not ~3.25% of gross (has ' + er + ', expected ~' + erExp.setScale(0, java.math.RoundingMode.HALF_UP) + ')')
                if (d.paidDays == null || !d.payslipId) probs.add('No payslip linked — "No of Days" is blank')
                if (probs) esiIssues.add([code: (d.employeeCode ?: '?'), name: (name ?: '?'), ip: ip, problems: probs.join('; ')])
            }
            esiReadyCount = esiData.size() - esiIssues.size()
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="ESI Register" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Employees' State Insurance — contribution register (applicable if gross ≤ ₹21,000)" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-sm">
                <link url="exportEsiCsv" text="Export ESI Register (CSV)" icon="fa fa-download"
                      btn-type="info" style="q-btn--dense"
                      parameter-map="[year: filterYear, month: filterMonth]"/>
                <link url="exportEsicMcDraft" text="Export ESIC MC (DRAFT)" icon="fa fa-file-text-o"
                      btn-type="warning" style="q-btn--dense"
                      parameter-map="[year: filterYear, month: filterMonth]"
                      confirmation="DRAFT ESIC Monthly Contribution file — NOT verified against the ESIC portal, and 'No of Days' is left BLANK (fill actual paid days per employee) — do not upload before completing and verifying it."/>
                <section name="EsiConfig_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="EsiConfigDialog" button-text="ESI Settings" width="500"
                                  button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-grey-7 text-white q-btn--actionable q-focusable q-hoverable q-btn--dense">
                    <section name="ExistingEsiConfig" condition="esiConfigs">
                        <widgets>
                            <form-list name="EsiConfigForm" list="esiConfigs" transition="updateEsiConfig">
                                <field name="esiConfigId"><default-field><hidden/></default-field></field>
                                <field name="esiCode"><default-field title="ESI Code"><text-line size="20"/></default-field></field>
                                <field name="employeeContributionPercent"><default-field title="Employee %"><text-line size="5"/></default-field></field>
                                <field name="employerContributionPercent"><default-field title="Employer %"><text-line size="5"/></default-field></field>
                                <field name="grossWagesCeiling"><default-field title="Wages Ceiling"><text-line size="8"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-list>
                        </widgets>
                    </section>
                    <section name="NewEsiConfig" condition="!esiConfigs">
                        <widgets>
                            <form-single name="CreateEsiConfigForm" transition="createEsiConfig">
                                <field name="esiCode"><default-field title="ESI Code"><text-line size="20"/></default-field></field>
                                <field name="submitButton"><default-field title="Create ESI Config"><submit/></default-field></field>
                            </form-single>
                        </widgets>
                    </section>
                </container-dialog>
                </widgets></section>
            </container>
        </container>

        <!-- ZE-DF-001 f/u (IV-110): pre-upload validation panel -->
        <container-row>
            <row-col lg="12">
                <section name="EsiIssuesPanel"><condition><expression>esiIssues</expression></condition><widgets>
                    <container style="bg-orange-1 shadow-2 q-pa-md q-mb-md border-radius-lg">
                        <label text="⚠ Pre-upload checks: ${esiIssues.size()} of ${esiData.size()} employees need attention before you file the ESIC MC (${esiReadyCount} look ready). Fix these, then re-download." type="p" style="text-orange-9 text-weight-bold q-mb-sm"/>
                        <form-list name="EsiIssuesForm" list="esiIssues" skip-form="true">
                            <field name="code"><header-field title="Emp Code"/><default-field><display/></default-field></field>
                            <field name="name"><header-field title="Name"/><default-field><display/></default-field></field>
                            <field name="ip"><header-field title="IP Number"/><default-field><display/></default-field></field>
                            <field name="problems"><header-field title="Issues to fix before filing"/><default-field><display/></default-field></field>
                        </form-list>
                    </container>
                </widgets></section>
                <section name="EsiReadyPanel"><condition><expression>!esiIssues &amp;&amp; esiData</expression></condition><widgets>
                    <container style="bg-green-1 shadow-2 q-pa-sm q-mb-md border-radius-lg">
                        <label text="✓ Pre-upload checks passed — all ${esiData.size()} employees look ready for the ESIC MC. Still verify one file on the ESIC portal before relying on it." type="p" style="text-green-9 text-weight-bold q-my-none"/>
                    </container>
                </widgets></section>
            </row-col>
        </container-row>

        <!-- Summary Cards -->
        <container-row>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                    <label text="Covered Employees" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${esiData.size()}" type="h3" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                    <label text="Employee ESI (0.75%)" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${ec.l10n.format(totalEsiEmployee, '#,##,##0')}" type="h4" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                    <label text="Employer ESI (3.25%)" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${ec.l10n.format(totalEsiEmployer, '#,##,##0')}" type="h4" style="text-warning text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="3">
                <container style="bg-white shadow-3 q-pa-lg text-center q-mb-md border-radius-lg">
                    <label text="Total Remittance" type="p" style="text-grey-7 text-weight-bold q-mb-sm"/>
                    <label text="${ec.l10n.format(totalEsiRemittance, '#,##,##0')}" type="h4" style="text-positive text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- ESI Register Table -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="EsiRegisterList" list="esiData" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="employeeCode"><default-field title="Code"><display/></default-field></field>
                <field name="firstName"><default-field title="Name"><display text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/></default-field></field>
                <field name="esiNumber"><default-field title="ESI No"><display/></default-field></field>
                <field name="grossPay"><default-field title="Gross Wages"><display format="#,##0"/></default-field></field>
                <field name="esiEmployeeAmount"><default-field title="Employee (0.75%)"><display format="#,##0"/></default-field></field>
                <field name="esiEmployerAmount"><default-field title="Employer (3.25%)"><display format="#,##0"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
