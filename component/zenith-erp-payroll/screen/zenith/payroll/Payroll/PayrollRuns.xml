<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Payroll Runs" default-menu-index="1">

    <transition name="createRun">
        <service-call name="zenith.payroll.PayrollServices.create#PayrollRun"/>
        <default-response url="../EditPayrollRun"/>
    </transition>
    <transition name="editRun">
        <default-response url="../EditPayrollRun"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.payroll.PayrollRun" list="runList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-periodYear,-periodMonth"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Payroll Runs"/><box-toolbar>
            <section name="NewRun_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewRunDialog" button-text="New Payroll Run">
                <form-single name="NewRunForm" transition="createRun">
                    <field name="periodMonth"><default-field title="Month">
                        <drop-down>
                            <option key="1" text="January"/><option key="2" text="February"/>
                            <option key="3" text="March"/><option key="4" text="April"/>
                            <option key="5" text="May"/><option key="6" text="June"/>
                            <option key="7" text="July"/><option key="8" text="August"/>
                            <option key="9" text="September"/><option key="10" text="October"/>
                            <option key="11" text="November"/><option key="12" text="December"/>
                        </drop-down>
                    </default-field></field>
                    <field name="periodYear"><default-field title="Year"><text-line size="6" default-value="2026"/></default-field></field>
                    <field name="totalWorkingDays"><default-field title="Working Days"><text-line size="4" default-value="26"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Payroll Runs..." style="display:none"></span>]]></text></render-mode>
            <form-list name="RunListForm" list="runList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="runName">
                    <header-field title="Period"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><link url="editRun" text="${runName}"
                        parameter-map="[payrollRunId:payrollRunId]"/></default-field>
                </field>
                <field name="totalWorkingDays"><default-field title="Working Days"><display/></default-field></field>
                <field name="employeeCount"><default-field title="Employees"><display/></default-field></field>
                <field name="totalGrossEarnings"><default-field title="Gross">
                    <display format="#,##,##0"/></default-field></field>
                <field name="totalDeductions"><default-field title="Deductions">
                    <display format="#,##,##0"/></default-field></field>
                <field name="totalNetPay"><default-field title="Net Pay">
                    <display format="#,##,##0"/></default-field></field>
                <field name="totalEmployerCost"><default-field title="Employer Cost">
                    <display format="#,##,##0"/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="PrDraft" text="Draft"/><option key="PrProcessed" text="Processed"/>
                            <option key="PrFinalized" text="Finalized"/><option key="PrPaid" text="Paid"/>
                        </drop-down>
                    </header-field>
                    <default-field><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
