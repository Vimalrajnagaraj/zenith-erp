<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Payroll Run Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="payrollRunId" required="true"/>

    <transition name="processRun">
        <service-call name="zenith.payroll.PayrollServices.process#PayrollRun"/>
        <default-response url="."/>
    </transition>
    <transition name="finalizeRun">
        <service-call name="zenith.payroll.PayrollServices.finalize#PayrollRun"/>
        <default-response url="."/>
    </transition>
    <transition name="markPaidRun">
        <service-call name="zenith.payroll.PayrollServices.markPaid#PayrollRun"/>
        <default-response url="."/>
    </transition>
    <transition name="viewPayslip">
        <default-response url="../ViewPayslip"/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.payroll.PayrollRun" value-field="run"/>
        <!-- Org-isolation ownership check: prevent opening another tenant's run by id (IDOR) -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="!run || (activeOrg &amp;&amp; run.organizationPartyId &amp;&amp; run.organizationPartyId != activeOrg)">
            <return error="true" message="Not authorized: payroll run belongs to another organization"/></if>
        <entity-find entity-name="zenith.erp.payroll.PayslipView" list="payslipList">
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="payrollRunId"/>
            <order-by field-name="employeeCode"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="${run.runName} — Payroll Run" type="h4"/>
        <label text="Status: ${run.statusId} | Working Days: ${run.totalWorkingDays} | Employees: ${run.employeeCount ?: 0}" type="div" style="text-muted"/>

        <container-box><box-header title="Actions &amp; Summary"/><box-toolbar>
            <link url="processRun" text="Process Payroll" parameter-map="[payrollRunId:payrollRunId]"
                  condition="modCanWrite &amp;&amp; run.statusId == 'PrDraft'" confirmation="Process payroll for all active employees?"/>
            <link url="finalizeRun" text="Finalize" parameter-map="[payrollRunId:payrollRunId]"
                  condition="modCanWrite &amp;&amp; run.statusId == 'PrProcessed'" confirmation="Finalize this payroll run? Payslips will be locked."/>
            <link url="markPaidRun" text="Mark Paid" parameter-map="[payrollRunId:payrollRunId]"
                  condition="modCanWrite &amp;&amp; run.statusId == 'PrFinalized'" confirmation="Mark all payslips as paid?"/>
        </box-toolbar><box-body>
            <container-row>
                <row-col lg="3"><label text="Gross Earnings" type="div" style="text-muted"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(run.totalGrossEarnings ?: 0, '#,##,##0'))}" type="h5"/></row-col>
                <row-col lg="3"><label text="Total Deductions" type="div" style="text-muted"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(run.totalDeductions ?: 0, '#,##,##0'))}" type="h5"/></row-col>
                <row-col lg="3"><label text="Net Payable" type="div" style="text-muted"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(run.totalNetPay ?: 0, '#,##,##0'))}" type="h5" style="text-success"/></row-col>
                <row-col lg="3"><label text="Total Employer Cost" type="div" style="text-muted"/>
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(run.totalEmployerCost ?: 0, '#,##,##0'))}" type="h5"/></row-col>
            </container-row>
        </box-body></container-box>

        <container-box><box-header title="Payslips"/><box-body>
            <form-list name="PayslipListForm" list="payslipList" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="employeeCode"><default-field title="Code">
                    <link url="viewPayslip" text="${employeeCode}" parameter-map="[payslipId:payslipId]"/>
                </default-field></field>
                <field name="firstName"><default-field title="Name">
                    <link url="viewPayslip" text="${firstName} ${lastName ?: ''}" parameter-map="[payslipId:payslipId]"/>
                </default-field></field>
                <field name="basicPay"><default-field title="Basic"><display format="#,##,##0"/></default-field></field>
                <field name="hra"><default-field title="HRA"><display format="#,##,##0"/></default-field></field>
                <field name="grossEarnings"><default-field title="Gross"><display format="#,##,##0"/></default-field></field>
                <field name="epfEmployee"><default-field title="EPF"><display format="#,##,##0"/></default-field></field>
                <field name="professionalTax"><default-field title="PT"><display format="#,##,##0"/></default-field></field>
                <field name="incomeTax"><default-field title="TDS"><display format="#,##,##0"/></default-field></field>
                <field name="totalDeductions"><default-field title="Deductions"><display format="#,##,##0"/></default-field></field>
                <field name="netPay"><default-field title="Net Pay"><display format="#,##,##0"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
