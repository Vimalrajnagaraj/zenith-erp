<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Salary Structures" default-menu-index="2">

    <transition name="createStructure">
        <actions>
            <!-- Stamp active org for isolation -->
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <service-call name="create#zenith.erp.payroll.SalaryStructure" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateStructure">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (prevent cross-tenant IDOR edit) -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="zenith.erp.payroll.SalaryStructure" value-field="curStruct"/>
            <if condition="curStruct == null || (activeOrg &amp;&amp; curStruct.organizationPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Salary structure not found for your account."/>
            </if>
            <service-call name="update#zenith.erp.payroll.SalaryStructure" in-map="[salaryStructureId:salaryStructureId, structureName:structureName, description:description, basicPercentOfGross:basicPercentOfGross, hraPercentOfBasic:hraPercentOfBasic, daPercentOfBasic:daPercentOfBasic, conveyanceMonthly:conveyanceMonthly, medicalMonthly:medicalMonthly, ltaPercentOfBasic:ltaPercentOfBasic, includeEpfInCtc:includeEpfInCtc, includeEsiInCtc:includeEsiInCtc, includeGratuityInCtc:includeGratuityInCtc, isDefault:isDefault, isActive:isActive]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.payroll.SalaryStructure" list="structureList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="structureName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Salary Structures"/><box-toolbar>
            <container-dialog id="NewStructureDialog" button-text="New Structure">
                <form-single name="NewStructureForm" transition="createStructure">
                    <field name="structureName"><default-field title="Name"><text-line size="30"/></default-field></field>
                    <field name="description"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="basicPercentOfGross"><default-field title="Basic % of Gross">
                        <text-line size="6" default-value="40"/></default-field></field>
                    <field name="hraPercentOfBasic"><default-field title="HRA % of Basic">
                        <text-line size="6" default-value="50"/></default-field></field>
                    <field name="daPercentOfBasic"><default-field title="DA % of Basic">
                        <text-line size="6" default-value="0"/></default-field></field>
                    <field name="conveyanceMonthly"><default-field title="Conveyance (Monthly ₹)">
                        <text-line size="8" default-value="1600"/></default-field></field>
                    <field name="medicalMonthly"><default-field title="Medical (Monthly ₹)">
                        <text-line size="8" default-value="1250"/></default-field></field>
                    <field name="ltaPercentOfBasic"><default-field title="LTA % of Basic">
                        <text-line size="6" default-value="0"/></default-field></field>
                    <field name="includeEpfInCtc"><default-field title="EPF in CTC">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="includeEsiInCtc"><default-field title="ESI in CTC">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="includeGratuityInCtc"><default-field title="Gratuity in CTC">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="isDefault"><default-field title="Default Structure">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="StructureListForm" list="structureList" skip-form="true" transition="updateStructure">
                <field name="salaryStructureId"><default-field><hidden/></default-field></field>
                <field name="structureName"><default-field title="Name"><display/></default-field></field>
                <field name="basicPercentOfGross"><default-field title="Basic %"><display/></default-field></field>
                <field name="hraPercentOfBasic"><default-field title="HRA %"><display/></default-field></field>
                <field name="daPercentOfBasic"><default-field title="DA %"><display/></default-field></field>
                <field name="conveyanceMonthly"><default-field title="Conv ₹"><display format="#,##0"/></default-field></field>
                <field name="medicalMonthly"><default-field title="Med ₹"><display format="#,##0"/></default-field></field>
                <field name="includeEpfInCtc"><default-field title="EPF in CTC"><display/></default-field></field>
                <field name="includeGratuityInCtc"><default-field title="Gratuity in CTC"><display/></default-field></field>
                <field name="isDefault"><default-field title="Default"><display/></default-field></field>
                <field name="isActive"><default-field title="Active"><display/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
