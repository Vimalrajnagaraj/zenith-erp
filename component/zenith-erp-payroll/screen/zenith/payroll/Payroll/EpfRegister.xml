<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="EPF Register" default-menu-index="8">

    <transition name="updateEpfConfig">
        <service-call name="update#zenith.erp.india.EpfConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="createEpfConfig">
        <service-call name="create#zenith.erp.india.EpfConfiguration"/>
        <default-response url="."/>
    </transition>
    <transition name="exportEpfCsv" read-only="true">
        <!-- ZE-DF-001 f/u (IV-110): this is the EPF *register* (reference CSV for Excel) — NOT the EPFO ECR
             (#~#-delimited, no header) portal-upload file. The UI button is relabelled accordingly; a real
             ECR export is a separate feature pending its statutory spec (do not guess the format). Fixes:
             type="none" (was <default-response url="."/> which re-rendered on the committed response and
             appended a "500 Committed" error to the file); sep=,/CRLF/quoted fields so Excel splits columns. -->
        <default-response type="none"/>
        <actions>
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="year" from="((ec.web?.requestParameters?.year ?: cal.get(java.util.Calendar.YEAR)).toString()) as Integer"/>
            <set field="month" from="((ec.web?.requestParameters?.month ?: (cal.get(java.util.Calendar.MONTH) + 1)).toString()) as Integer"/>
            <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="data">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="periodYear" from="year"/>
                <econdition field-name="periodMonth" from="month"/>
                <order-by field-name="employeeCode"/>
            </entity-find>
            <script><![CDATA[
                def esc = { v -> '"' + (v == null ? '' : v.toString()).replace('"', '""') + '"' }
                def sb = new StringBuilder()
                sb.append("sep=,\r\n")
                sb.append("UAN,Employee Code,Name,EPF Wages,Employee PF,Employer PF,Employer Pension,Admin Charges,EDLI\r\n")
                for (def d : data) {
                    def name = ((d.firstName ?: '') + ' ' + (d.lastName ?: '')).trim()
                    sb.append([esc(d.uanNumber ?: ''), esc(d.employeeCode ?: ''), esc(name),
                               esc(d.epfWages ?: 0), esc(d.epfEmployeeAmount ?: 0), esc(d.epfEmployerPfAmount ?: 0),
                               esc(d.epfEmployerPensionAmount ?: 0), esc(d.epfAdminCharges ?: 0), esc(d.edliCharges ?: 0)].join(',')).append("\r\n")
                }
                ec.web.response.setContentType("text/csv; charset=UTF-8")
                ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"epf_register_${year}_${month}.csv\"")
                def w = ec.web.response.getWriter(); w.write(sb.toString()); w.flush()
            ]]></script>
        </actions>
    </transition>

    <transition name="exportEcrDraft" read-only="true">
        <!-- ZE-DF-001 f/u (IV-110): DRAFT EPFO ECR v2.0 upload file (#~#-delimited, 11 fields, no header, .txt).
             Built from the commonly-documented ECR layout — NOT verified against the live EPFO portal.
             DRAFT ASSUMPTIONS you MUST verify before filing: EPS Wages & EDLI Wages = min(EPF Wages, 15000)
             statutory cap; NCP Days = the payslip's LWP (loss-of-pay) days; Refund of Advances = 0 (no advance
             data in the model); all amounts rounded to whole rupees. Field order: UAN, Member Name,
             Gross Wages, EPF Wages, EPS Wages, EDLI Wages, EPF Contribution (EE), EPS Contribution,
             Difference EPF-EPS (ER share), NCP Days, Refund of Advances. -->
        <default-response type="none"/>
        <actions>
            <set field="cal" from="new java.util.GregorianCalendar()"/>
            <set field="year" from="((ec.web?.requestParameters?.year ?: cal.get(java.util.Calendar.YEAR)).toString()) as Integer"/>
            <set field="month" from="((ec.web?.requestParameters?.month ?: (cal.get(java.util.Calendar.MONTH) + 1)).toString()) as Integer"/>
            <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="data">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="periodYear" from="year"/>
                <econdition field-name="periodMonth" from="month"/>
                <econdition field-name="epfEmployeeAmount" operator="greater" from="0"/>
                <order-by field-name="uanNumber"/>
            </entity-find>
            <script><![CDATA[
                def rup = { v -> (v == null) ? 0L : Math.round((v as BigDecimal).doubleValue()) }
                def cap = new BigDecimal(15000)
                def sb = new StringBuilder()
                for (def d : data) {
                    if (!d.uanNumber) continue   // ECR requires a UAN per member; rows without one are skipped
                    def name = ((d.firstName ?: '') + ' ' + (d.lastName ?: '')).trim()
                    def epfW = (d.epfWages ?: 0) as BigDecimal
                    def epsW = epfW.min(cap)   // DRAFT: EPS/EDLI wage cap of 15000
                    sb.append([d.uanNumber, name, rup(d.grossPay), rup(epfW), rup(epsW), rup(epsW),
                               rup(d.epfEmployeeAmount), rup(d.epfEmployerPensionAmount), rup(d.epfEmployerPfAmount),
                               rup(d.lwpDays), 0].join('#~#')).append("\r\n")   // NCP Days = payslip LWP days; Refund = 0
                }
                ec.web.response.setContentType("text/plain; charset=UTF-8")
                ec.web.response.setHeader("Content-Disposition", "attachment; filename=\"ECR_DRAFT_${year}_${month}.txt\"")
                def w = ec.web.response.getWriter(); w.write(sb.toString()); w.flush()
            ]]></script>
        </actions>
    </transition>

    <actions>
        <set field="cal" from="new java.util.GregorianCalendar()"/>
        <set field="currentYear" from="cal.get(java.util.Calendar.YEAR)"/>
        <set field="currentMonth" from="cal.get(java.util.Calendar.MONTH) + 1"/>
        <set field="filterYear" from="ec.web?.requestParameters?.filterYear ?: currentYear"/>
        <set field="filterMonth" from="ec.web?.requestParameters?.filterMonth ?: currentMonth"/>

        <!-- EPF Configuration -->
        <entity-find entity-name="zenith.erp.india.EpfConfiguration" list="epfConfigs">
            <econdition field-name="isActive" value="Y"/>
        </entity-find>

        <!-- EPF contributions for the period -->
        <entity-find entity-name="zenith.erp.india.StatutoryContributionView" list="epfData">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="periodYear" from="filterYear"/>
            <econdition field-name="periodMonth" from="filterMonth"/>
            <econdition field-name="epfEmployeeAmount" operator="greater" from="0"/>
            <order-by field-name="employeeCode"/>
        </entity-find>

        <!-- Totals -->
        <set field="totalEpfWages" from="0" type="BigDecimal"/>
        <set field="totalEmpPf" from="0" type="BigDecimal"/>
        <set field="totalErPf" from="0" type="BigDecimal"/>
        <set field="totalPension" from="0" type="BigDecimal"/>
        <set field="totalAdmin" from="0" type="BigDecimal"/>
        <set field="totalEdli" from="0" type="BigDecimal"/>
        <script>
            for (def d : epfData) {
                totalEpfWages += (d.epfWages ?: 0)
                totalEmpPf += (d.epfEmployeeAmount ?: 0)
                totalErPf += (d.epfEmployerPfAmount ?: 0)
                totalPension += (d.epfEmployerPensionAmount ?: 0)
                totalAdmin += (d.epfAdminCharges ?: 0)
                totalEdli += (d.edliCharges ?: 0)
            }
        </script>
        <set field="totalEmployerCost" from="totalErPf + totalPension + totalAdmin + totalEdli" type="BigDecimal"/>
        <set field="totalRemittance" from="totalEmpPf + totalEmployerCost" type="BigDecimal"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="EPF Register" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Employees' Provident Fund — monthly contribution register (reference CSV for review; the ECR portal-upload file is a separate format)" type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="row q-gutter-sm">
                <link url="exportEpfCsv" text="Export EPF Register (CSV)" icon="fa fa-download"
                      btn-type="info" style="q-btn--dense"
                      parameter-map="[year: filterYear, month: filterMonth]"/>
                <link url="exportEcrDraft" text="Export EPFO ECR (DRAFT)" icon="fa fa-file-text-o"
                      btn-type="warning" style="q-btn--dense"
                      parameter-map="[year: filterYear, month: filterMonth]"
                      confirmation="DRAFT ECR built from the standard EPFO #~# format — NOT verified against the EPFO portal. NCP days default to 0 and EPS/EDLI wages are capped at 15000; verify every field and your totals against your EPFO login before filing."/>
                <section name="EpfConfig_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="EpfConfigDialog" button-text="EPF Settings" width="600"
                                  button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-grey-7 text-white q-btn--actionable q-focusable q-hoverable q-btn--dense">
                    <section name="ExistingConfig" condition="epfConfigs">
                        <widgets>
                            <form-list name="EpfConfigForm" list="epfConfigs" transition="updateEpfConfig">
                                <field name="epfConfigId"><default-field><hidden/></default-field></field>
                                <field name="establishmentCode"><default-field title="Est. Code"><text-line size="15"/></default-field></field>
                                <field name="employeeContributionPercent"><default-field title="Employee %"><text-line size="5"/></default-field></field>
                                <field name="employerContributionPercent"><default-field title="Employer %"><text-line size="5"/></default-field></field>
                                <field name="pensionFundPercent"><default-field title="Pension %"><text-line size="5"/></default-field></field>
                                <field name="wagesCeiling"><default-field title="Wages Ceiling"><text-line size="8"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-list>
                        </widgets>
                    </section>
                    <section name="NewConfig" condition="!epfConfigs">
                        <widgets>
                            <form-single name="CreateEpfConfigForm" transition="createEpfConfig">
                                <field name="establishmentCode"><default-field title="Establishment Code"><text-line size="15"/></default-field></field>
                                <field name="epfNumber"><default-field title="EPF Number"><text-line size="20"/></default-field></field>
                                <field name="submitButton"><default-field title="Create EPF Config"><submit/></default-field></field>
                            </form-single>
                        </widgets>
                    </section>
                </container-dialog>
                </widgets></section>
            </container>
        </container>

        <!-- Summary -->
        <container-row>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Employees" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${epfData.size()}" type="h4" style="text-primary text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="EPF Wages" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEpfWages, '#,##,##0')}" type="h5" style="text-grey-8 text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Employee PF" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalEmpPf, '#,##,##0')}" type="h5" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Employer PF" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalErPf, '#,##,##0')}" type="h5" style="text-info text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Pension" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalPension, '#,##,##0')}" type="h5" style="text-warning text-weight-bolder q-my-none"/>
                </container>
            </row-col>
            <row-col lg="2">
                <container style="bg-white shadow-3 q-pa-md text-center q-mb-md border-radius-lg">
                    <label text="Total Remittance" type="p" style="text-grey-7 text-weight-bold q-mb-xs text-caption"/>
                    <label text="${ec.l10n.format(totalRemittance, '#,##,##0')}" type="h5" style="text-positive text-weight-bolder q-my-none"/>
                </container>
            </row-col>
        </container-row>

        <!-- EPF Register Table -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="EpfRegisterList" list="epfData" skip-form="true"
                       show-csv-button="true" show-xlsx-button="true">
                <field name="employeeCode"><default-field title="Code"><display/></default-field></field>
                <field name="firstName"><default-field title="Name"><display text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/></default-field></field>
                <field name="uanNumber"><default-field title="UAN"><display/></default-field></field>
                <field name="pfNumber"><default-field title="PF No"><display/></default-field></field>
                <field name="epfWages"><default-field title="EPF Wages"><display format="#,##0"/></default-field></field>
                <field name="epfEmployeeAmount"><default-field title="EE PF (12%)"><display format="#,##0"/></default-field></field>
                <field name="epfEmployerPfAmount"><default-field title="ER PF (3.67%)"><display format="#,##0"/></default-field></field>
                <field name="epfEmployerPensionAmount"><default-field title="Pension (8.33%)"><display format="#,##0"/></default-field></field>
                <field name="epfAdminCharges"><default-field title="Admin"><display format="#,##0"/></default-field></field>
                <field name="edliCharges"><default-field title="EDLI"><display format="#,##0"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
