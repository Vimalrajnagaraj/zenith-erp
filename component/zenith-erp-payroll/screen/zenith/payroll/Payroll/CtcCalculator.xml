<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="CTC Calculator" default-menu-index="5">

    <transition name="calculateCtc">
        <service-call name="zenith.payroll.PayrollServices.project#CtcBreakdown"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.payroll.SalaryStructure" list="structureList">
            <econdition field-name="isActive" value="Y"/><order-by field-name="structureName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="CTC to Take-Home Calculator"/><box-body>
            <form-single name="CtcForm" transition="calculateCtc">
                <field name="ctcAnnual"><default-field title="Annual CTC (${currSymbol})"><text-line size="12"/></default-field></field>
                <field name="salaryStructureId"><default-field title="Salary Structure">
                    <drop-down allow-empty="true">
                        <list-options list="structureList" key="${salaryStructureId}" text="${structureName}"/>
                    </drop-down>
                </default-field></field>
                <field name="isMetroCity"><default-field title="Metro City (HRA)">
                    <drop-down><option key="N" text="No (40% HRA)"/><option key="Y" text="Yes (50% HRA)"/></drop-down>
                </default-field></field>
                <field name="pfApplicable"><default-field title="PF Applicable">
                    <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                </default-field></field>
                <field name="esiApplicable"><default-field title="ESI Applicable">
                    <drop-down><option key="N" text="No (Gross > ₹21,000)"/><option key="Y" text="Yes (Gross ≤ ₹21,000)"/></drop-down>
                </default-field></field>
                <field name="submitButton"><default-field title="Calculate"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>

        <section name="ResultSection" condition="breakdown">
            <widgets>
                <container-row>
                    <row-col lg="6">
                        <container-box><box-header title="Monthly Breakdown"/><box-body>
                            <form-single name="MonthlyForm" map="breakdown">
                                <field name="ctcMonthly"><default-field title="CTC (Monthly)"><display format="#,##,##0"/></default-field></field>
                                <field name="grossMonthly"><default-field title="Gross Salary"><display format="#,##,##0"/></default-field></field>
                                <field name="basic"><default-field title="Basic Pay"><display format="#,##,##0"/></default-field></field>
                                <field name="hra"><default-field title="HRA"><display format="#,##,##0"/></default-field></field>
                                <field name="da"><default-field title="DA"><display format="#,##,##0"/></default-field></field>
                                <field name="conveyance"><default-field><display format="#,##,##0"/></default-field></field>
                                <field name="medical"><default-field><display format="#,##,##0"/></default-field></field>
                                <field name="lta"><default-field title="LTA"><display format="#,##,##0"/></default-field></field>
                                <field name="specialAllowance"><default-field title="Special Allowance"><display format="#,##,##0"/></default-field></field>
                            </form-single>
                        </box-body></container-box>
                    </row-col>
                    <row-col lg="6">
                        <container-box><box-header title="Deductions &amp; Employer Cost"/><box-body>
                            <form-single name="DedForm" map="breakdown">
                                <field name="epfEmployee"><default-field title="EPF Employee (12%)"><display format="#,##,##0"/></default-field></field>
                                <field name="esiEmployee"><default-field title="ESI Employee (0.75%)"><display format="#,##,##0"/></default-field></field>
                                <field name="epfEmployer"><default-field title="EPF Employer (3.67%)"><display format="#,##,##0"/></default-field></field>
                                <field name="epsEmployer"><default-field title="EPS Employer (8.33%)"><display format="#,##,##0"/></default-field></field>
                                <field name="esiEmployer"><default-field title="ESI Employer (3.25%)"><display format="#,##,##0"/></default-field></field>
                                <field name="gratuityProvision"><default-field title="Gratuity Provision"><display format="#,##,##0"/></default-field></field>
                                <field name="estimatedNetMonthly"><default-field title="Est. Monthly Take-Home"><display format="#,##,##0"/></default-field></field>
                                <field name="estimatedNetAnnual"><default-field title="Est. Annual Take-Home"><display format="#,##,##0"/></default-field></field>
                            </form-single>
                        </box-body></container-box>
                    </row-col>
                </container-row>
            </widgets>
        </section>
    </widgets>
</screen>
