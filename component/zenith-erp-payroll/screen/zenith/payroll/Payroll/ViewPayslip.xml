<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Payslip" default-menu-index="0" default-menu-include="false">

    <parameter name="payslipId" required="true"/>

    <actions>
        <entity-find-one entity-name="zenith.erp.payroll.Payslip" value-field="ps"/>
        <entity-find-one entity-name="zenith.erp.hr.Employee" value-field="emp">
            <field-map field-name="employeeId" from="ps.employeeId"/></entity-find-one>
        <entity-find-one entity-name="mantle.party.Person" value-field="person">
            <field-map field-name="partyId" from="emp.partyId"/></entity-find-one>
        <entity-find-one entity-name="zenith.erp.hr.Department" value-field="dept">
            <field-map field-name="departmentId" from="emp.departmentId"/></entity-find-one>
        <entity-find-one entity-name="zenith.erp.hr.Designation" value-field="desig">
            <field-map field-name="designationId" from="emp.designationId"/></entity-find-one>
        <set field="monthNames" from="['','January','February','March','April','May','June','July','August','September','October','November','December']"/>
    </actions>

    <widgets>
        <label text="Payslip — ${monthNames[ps.periodMonth]} ${ps.periodYear}" type="h4"/>
        <label text="${person.firstName} ${person.lastName ?: ''} (${emp.employeeCode}) | ${dept?.departmentName ?: '-'} | ${desig?.designationName ?: '-'}" type="div" style="text-muted"/>
        <label text="PAN: ${emp.panNumber ?: '-'} | UAN: ${emp.uanNumber ?: '-'} | Bank: ${emp.bankAccountNumber ?: '-'} (${emp.ifscCode ?: ''})" type="div" style="text-muted"/>
        <label text="Status: ${ps.statusId} | Working Days: ${ps.workingDays} | Paid Days: ${ps.paidDays} | LWP: ${ps.lwpDays}" type="div"/>

        <container-row>
            <!-- Earnings Column -->
            <row-col lg="6">
                <container-box><box-header title="Earnings"/><box-body>
                    <form-single name="EarningsForm" map="ps">
                        <field name="basicPay"><default-field title="Basic Pay"><display format="#,##,##0"/></default-field></field>
                        <field name="hra"><default-field title="House Rent Allowance"><display format="#,##,##0"/></default-field></field>
                        <field name="da"><default-field title="Dearness Allowance"><display format="#,##,##0"/></default-field></field>
                        <field name="conveyance"><default-field title="Conveyance"><display format="#,##,##0"/></default-field></field>
                        <field name="medicalAllowance"><default-field title="Medical Allowance"><display format="#,##,##0"/></default-field></field>
                        <field name="specialAllowance"><default-field title="Special Allowance"><display format="#,##,##0"/></default-field></field>
                        <field name="lta"><default-field title="Leave Travel Allowance"><display format="#,##,##0"/></default-field></field>
                        <field name="otherEarnings"><default-field title="Other Earnings"><display format="#,##,##0"/></default-field></field>
                        <field name="grossEarnings"><default-field title="Gross Earnings"><display format="#,##,##0"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
            <!-- Deductions Column -->
            <row-col lg="6">
                <container-box><box-header title="Deductions"/><box-body>
                    <form-single name="DeductionsForm" map="ps">
                        <field name="epfEmployee"><default-field title="EPF (Employee 12%)"><display format="#,##,##0"/></default-field></field>
                        <field name="esiEmployee"><default-field title="ESI (Employee 0.75%)"><display format="#,##,##0"/></default-field></field>
                        <field name="professionalTax"><default-field title="Professional Tax"><display format="#,##,##0"/></default-field></field>
                        <field name="incomeTax"><default-field title="Income Tax (TDS)"><display format="#,##,##0"/></default-field></field>
                        <field name="advanceRecovery"><default-field title="Advance Recovery"><display format="#,##,##0"/></default-field></field>
                        <field name="otherDeductions"><default-field title="Other Deductions"><display format="#,##,##0"/></default-field></field>
                        <field name="totalDeductions"><default-field title="Total Deductions"><display format="#,##,##0"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Net Pay -->
        <container-box><box-header title="Net Pay"/><box-body>
            <label text="${currSymbol}${ec.l10n.format(ps.netPay ?: 0, '#,##,##0')}" type="h3" style="text-success"/>
        </box-body></container-box>

        <!-- Employer Contributions -->
        <container-box><box-header title="Employer Contributions (not deducted from employee)"/><box-body>
            <form-single name="EmployerForm" map="ps">
                <field name="epfEmployer"><default-field title="EPF Employer (3.67%)"><display format="#,##,##0"/></default-field></field>
                <field name="epsEmployer"><default-field title="EPS Employer (8.33%)"><display format="#,##,##0"/></default-field></field>
                <field name="epfAdminCharges"><default-field title="EPF Admin (0.5%)"><display format="#,##,##0"/></default-field></field>
                <field name="edliContribution"><default-field title="EDLI (0.5%)"><display format="#,##,##0"/></default-field></field>
                <field name="esiEmployer"><default-field title="ESI Employer (3.25%)"><display format="#,##,##0"/></default-field></field>
                <field name="gratuityProvision"><default-field title="Gratuity Provision"><display format="#,##,##0"/></default-field></field>
                <field name="totalEmployerCost"><default-field title="Total Cost to Company (Monthly)"><display format="#,##,##0"/></default-field></field>
            </form-single>
        </box-body></container-box>
    </widgets>
</screen>
