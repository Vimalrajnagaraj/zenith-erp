<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Salary Advances" default-menu-index="4">

    <transition name="createAdvance">
        <service-call name="zenith.payroll.PayrollServices.create#SalaryAdvance"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelAdvance">
        <service-call name="update#zenith.erp.payroll.SalaryAdvance"
            in-map="[salaryAdvanceId:salaryAdvanceId, statusId:'SaCancelled']"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.payroll.SalaryAdvanceView" list="advanceList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-advanceDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.hr.Employee" list="empList">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="statusId" operator="in" value="EmpActive,EmpProbation"/>
            <order-by field-name="employeeCode"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Salary Advances &amp; Loans"/><box-toolbar>
            <section name="NewAdvance_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewAdvanceDialog" button-text="New Advance">
                <form-single name="NewAdvanceForm" transition="createAdvance">
                    <field name="employeeId"><default-field title="Employee">
                        <drop-down>
                            <list-options list="empList" key="${employeeId}" text="${employeeCode}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="amount"><default-field title="Advance Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                    <field name="monthlyRecoveryAmount"><default-field title="Monthly Recovery (${currSymbol})"><text-line size="10"/></default-field></field>
                    <field name="reason"><default-field><text-area rows="2" cols="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="AdvanceListForm" list="advanceList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <field name="employeeCode"><default-field title="Code"><display/></default-field></field>
                <field name="firstName"><default-field title="Name">
                    <display text="${firstName} ${lastName ?: ''}"/></default-field></field>
                <field name="advanceDate"><default-field title="Date"><display format="dd/MM/yyyy"/></default-field></field>
                <field name="amount"><default-field title="Amount"><display format="#,##,##0"/></default-field></field>
                <field name="monthlyRecoveryAmount"><default-field title="Monthly EMI"><display format="#,##,##0"/></default-field></field>
                <field name="totalRecovered"><default-field title="Recovered"><display format="#,##,##0"/></default-field></field>
                <field name="balanceAmount"><default-field title="Balance"><display format="#,##,##0"/></default-field></field>
                <field name="reason"><default-field><display/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="SaApproved" text="Approved"/><option key="SaRecovering" text="Recovering"/>
                            <option key="SaCompleted" text="Completed"/><option key="SaCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="actions"><default-field title="">
                    <link url="cancelAdvance" text="Cancel"
                          parameter-map="[salaryAdvanceId:salaryAdvanceId]"
                          condition="modCanWrite &amp;&amp; statusId == 'SaApproved'" confirmation="Cancel this advance?"/>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
