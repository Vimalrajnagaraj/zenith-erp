<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Declarations" default-menu-index="3">

    <transition name="createDeclaration">
        <service-call name="create#zenith.erp.india.IncomeTaxDeclaration"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDeclaration">
        <service-call name="update#zenith.erp.india.IncomeTaxDeclaration"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <!-- IncomeTaxDeclaration has no org column: restrict to this org's employees (no ignore-if-empty so an org with 0 employees shows nothing) -->
        <entity-find entity-name="zenith.erp.hr.Employee" list="orgEmpList">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <select-field field-name="employeeId"/>
        </entity-find>
        <set field="orgEmpIds" from="orgEmpList.collect{ it.employeeId }"/>
        <entity-find entity-name="zenith.erp.india.IncomeTaxDeclaration" list="decList">
            <econdition field-name="employeeId" operator="in" from="orgEmpIds"/>
            <search-form-inputs default-order-by="-financialYear"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.hr.Employee" list="empList">
            <econdition field-name="organizationPartyId" from="activeOrg" ignore-if-empty="true"/>
            <econdition field-name="statusId" operator="in" value="EmpActive,EmpProbation"/>
            <order-by field-name="employeeCode"/>
        </entity-find>
        <entity-find entity-name="mantle.party.Person" list="personList"/>
    </actions>

    <widgets>
        <container-box><box-header title="Income Tax Declarations"/><box-toolbar>
            <section name="NewDec_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewDecDialog" button-text="New Declaration">
                <form-single name="NewDecForm" transition="createDeclaration">
                    <field name="employeeId"><default-field title="Employee">
                        <drop-down>
                            <list-options list="empList" key="${employeeId}" text="${employeeCode}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="financialYear"><default-field title="Financial Year">
                        <text-line size="10" default-value="2025-26"/>
                    </default-field></field>
                    <field name="selectedRegime"><default-field title="Tax Regime">
                        <drop-down><option key="New" text="New Regime"/><option key="Old" text="Old Regime"/></drop-down>
                    </default-field></field>
                    <field name="section80c"><default-field title="80C (PPF, ELSS, LIC, etc.) max ₹1,50,000">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="section80d"><default-field title="80D (Medical Insurance) max ₹1,00,000">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="section80e"><default-field title="80E (Education Loan Interest)">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="section80g"><default-field title="80G (Donations)">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="section80tta"><default-field title="80TTA (Savings Interest) max ₹10,000">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="hraExemptionClaimed"><default-field title="HRA Exemption Claimed">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="ltaExemptionClaimed"><default-field title="LTA Exemption Claimed">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="homeLoanInterest"><default-field title="Home Loan Interest (Sec 24) max ₹2,00,000">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="npsContribution"><default-field title="NPS 80CCD(1B) max ₹50,000">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="otherExemptions"><default-field title="Other Exemptions">
                        <text-line size="10" default-value="0"/></default-field></field>
                    <field name="submitButton"><default-field title="Submit Declaration"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="DecListForm" list="decList" skip-form="true" transition="updateDeclaration"
                       show-csv-button="true" show-page-size="true">
                <field name="declarationId"><default-field><hidden/></default-field></field>
                <field name="employeeId">
                    <header-field title="Employee"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="financialYear">
                    <header-field title="FY"><text-find size="8" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="selectedRegime"><default-field title="Regime"><display/></default-field></field>
                <field name="section80c"><default-field title="80C"><display format="#,##,##0"/></default-field></field>
                <field name="section80d"><default-field title="80D"><display format="#,##,##0"/></default-field></field>
                <field name="hraExemptionClaimed"><default-field title="HRA"><display format="#,##,##0"/></default-field></field>
                <field name="homeLoanInterest"><default-field title="Home Loan"><display format="#,##,##0"/></default-field></field>
                <field name="npsContribution"><default-field title="NPS"><display format="#,##,##0"/></default-field></field>
                <field name="isVerified"><default-field title="Verified">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field>
                    <conditional-field name="dec_update_write" condition="modCanWrite"><submit text="Update"/></conditional-field>
                    <default-field><label text="" type="span"/></default-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
