<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Delegations" default-menu-index="4">

    <transition name="createDelegation" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.delegate#Approval"/>
        <default-response url="."/>
    </transition>
    <transition name="updateDelegation" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update a delegation your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_da"
                          in-map="[entityName:'zenith.erp.approvals.ApprovalDelegation', idField:'delegationId', idValue:delegationId, orgField:'organizationPartyId']"/>
            <if condition="!_da.allowed"><return error="true" message="Delegation not found for your account."/></if>
            <!-- ZE-SB-013 (Tier 5): a submitted delegator/delegate must be a member of your org. -->
            <if condition="fromPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_fa" in-map="[partyId:fromPartyId]"/>
                <if condition="!_fa.allowed"><return error="true" message="The delegating party isn't part of your organization."/></if>
            </if>
            <if condition="toPartyId">
                <service-call name="zenith.base.SecurityServices.assert#PartyOrgMembership" out-map="_toa" in-map="[partyId:toPartyId]"/>
                <if condition="!_toa.allowed"><return error="true" message="The delegate isn't part of your organization."/></if>
            </if>
            <service-call name="update#zenith.erp.approvals.ApprovalDelegation" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.approvals.ApprovalDelegation" list="delList">
            <!-- ZE-SB-013 (Tier 4): only this org's delegations (was leaking ALL tenants'). -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="-fromDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Approval Delegations"/>
            <box-toolbar>
                <section name="apr_newdel_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateDelDialog" button-text="New Delegation">
                    <form-single name="CreateDelForm" transition="createDelegation">
                        <field name="fromPartyId"><default-field title="From (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="toPartyId"><default-field title="To (Party ID)"><text-line size="15"/></default-field></field>
                        <field name="workflowId"><default-field title="Workflow (optional)">
                            <drop-down allow-empty="true"><entity-options key="${workflowId}" text="${workflowName}">
                                <entity-find entity-name="zenith.erp.approvals.ApprovalWorkflow">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own workflows + global shared templates. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="fromDate"><default-field title="From Date"><date-time type="date"/></default-field></field>
                        <field name="thruDate"><default-field title="To Date"><date-time type="date"/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="DelList" list="delList" transition="updateDelegation">
                    <field name="delegationId"><default-field title="ID"><display/></default-field></field>
                    <field name="fromPartyId"><default-field title="From"><display/></default-field></field>
                    <field name="toPartyId"><default-field title="To"><display/></default-field></field>
                    <field name="workflowId"><default-field title="Workflow">
                        <display-entity entity-name="zenith.erp.approvals.ApprovalWorkflow"
                                        key-field-name="workflowId" text="${workflowName}"/></default-field></field>
                    <field name="fromDate"><default-field title="From"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="thruDate"><default-field title="Until"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="apr_del_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title="Save"><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
