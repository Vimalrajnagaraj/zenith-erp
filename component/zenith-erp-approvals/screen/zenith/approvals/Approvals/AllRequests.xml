<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Requests" default-menu-index="2">

    <transition name="createRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.create#ApprovalRequest"/>
        <default-response url="."/>
    </transition>
    <transition name="editRequest"><default-response url="../EditRequest"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.approvals.ApprovalRequestView" list="requestList">
            <search-form-inputs default-order-by="-requestDate"/>
            <!-- ZE-SB-013 (Tier 4): only this org's requests. -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="-requestDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Approval Requests"/>
            <box-toolbar>
                <section name="apr_newreq_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateReqDialog" button-text="New Request">
                    <form-single name="CreateReqForm" transition="createRequest">
                        <field name="workflowId"><default-field title="Workflow">
                            <drop-down><entity-options key="${workflowId}" text="${workflowName}">
                                <entity-find entity-name="zenith.erp.approvals.ApprovalWorkflow">
                                    <econdition field-name="isActive" value="Y"/>
                                    <!-- ZE-SB-013 (Tier 4): own workflows + global shared templates. -->
                                    <econditions combine="or">
                                        <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <econdition field-name="organizationPartyId" operator="is-null"/>
                                    </econditions>
                                    <order-by field-name="workflowName"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="requestTitle"><default-field title="Title"><text-line size="35"/></default-field></field>
                        <field name="requestDescription"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="amount"><default-field title="Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="moduleEnumId"><default-field title="Module">
                            <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApprovalModule"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down no-current-selected-key="ApPri_NORMAL"><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApprovalPriority"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                        <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="RequestList" list="requestList" skip-form="true">
                    <field name="requestNumber"><default-field title="Req #"><display/></default-field></field>
                    <field name="workflowName"><default-field title="Workflow"><display/></default-field></field>
                    <field name="requestTitle"><default-field title="Title"><display/></default-field></field>
                    <field name="amount"><default-field title="Amount"><display format="#,##,##0.00"/></default-field></field>
                    <field name="priority"><default-field title="Priority">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="requestDate"><default-field title="Requested"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="currentStepNumber"><default-field title="Step"><display/></default-field></field>
                    <field name="viewBtn"><default-field title="">
                        <link url="editRequest" text="Detail" parameter-map="[requestId:requestId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
