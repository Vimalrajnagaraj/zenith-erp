<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Request Detail" default-menu-include="false">

    <parameter name="requestId" required="true"/>

    <transition name="approveRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.approve#Request"/>
        <default-response url="."/>
    </transition>
    <transition name="rejectRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.reject#Request"/>
        <default-response url="."/>
    </transition>
    <transition name="returnRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.return#Request"/>
        <default-response url="."/>
    </transition>
    <transition name="escalateRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.escalate#Request"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelRequest" begin-transaction="true">
        <service-call name="zenith.approvals.ApprovalServices.cancel#Request"/>
        <default-response url="."/>
    </transition>
    <transition name="updateRequest" begin-transaction="true">
        <service-call name="update#zenith.erp.approvals.ApprovalRequest"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.approvals.ApprovalRequest" value-field="req"/>
        <entity-find-one entity-name="zenith.erp.approvals.ApprovalWorkflow" value-field="workflow">
            <field-map field-name="workflowId" from="req?.workflowId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.approvals.ApprovalStep" list="stepList">
            <econdition field-name="workflowId" from="req?.workflowId"/>
            <order-by field-name="stepNumber"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.approvals.ApprovalDecision" list="decisionList">
            <econdition field-name="requestId"/>
            <order-by field-name="-decisionDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.approvals.ApprovalNotification" list="notifList">
            <econdition field-name="requestId"/>
            <order-by field-name="-sentDate"/>
            <limit count="10"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <!-- Request Detail -->
                <container-box><box-header title="${req?.requestNumber}: ${req?.requestTitle}"/>
                <box-body>
                    <form-single name="ReqForm" transition="updateRequest" map="req">
                        <field name="requestId"><default-field><hidden/></default-field></field>
                        <field name="requestNumber"><default-field title="Req #"><display/></default-field></field>
                        <field name="workflowId"><default-field title="Workflow">
                            <display-entity entity-name="zenith.erp.approvals.ApprovalWorkflow"
                                            key-field-name="workflowId" text="${workflowName}"/></default-field></field>
                        <field name="requestTitle"><default-field title="Title"><display/></default-field></field>
                        <field name="requestDescription"><default-field title="Description"><display/></default-field></field>
                        <field name="amount"><default-field title="Amount (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                        <field name="moduleEnumId"><default-field title="Module">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApprovalPriority"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="currentStepNumber"><default-field title="Current Step"><display/></default-field></field>
                        <field name="requestedByPartyId"><default-field title="Requested By"><display/></default-field></field>
                        <field name="requestDate"><default-field title="Requested"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="dueDate"><default-field title="Due Date"><date-time type="date"/></default-field></field>
                        <field name="completedDate"><default-field title="Completed"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="entityName"><default-field title="Entity"><display/></default-field></field>
                        <field name="primaryKeyValue"><default-field title="Record ID"><display/></default-field></field>
                        <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <!-- Workflow Steps -->
                <container-box><box-header title="Approval Steps"/>
                <box-body>
                    <form-list name="StepList" list="stepList" skip-form="true">
                        <field name="stepNumber"><default-field title="Step"><display/></default-field></field>
                        <field name="stepName"><default-field title="Name"><display/></default-field></field>
                        <field name="approverType"><default-field title="Approver Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="minAmount"><default-field title="Min Amt"><display format="#,##,##0"/></default-field></field>
                        <field name="maxAmount"><default-field title="Max Amt"><display format="#,##,##0"/></default-field></field>
                        <field name="isRequired"><default-field title="Req"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Actions -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <container-dialog id="ApproveDialog" button-text="Approve">
                        <form-single name="ApproveForm" transition="approveRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="comments"><default-field title="Comments"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Approve"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="RejectDialog" button-text="Reject">
                        <form-single name="RejectForm" transition="rejectRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="comments"><default-field title="Reason (required)"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Reject"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ReturnDialog" button-text="Return for Revision">
                        <form-single name="ReturnForm" transition="returnRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="comments"><default-field title="Feedback (required)"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Return"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="EscalateDialog" button-text="Escalate">
                        <form-single name="EscalateForm" transition="escalateRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="comments"><default-field title="Reason"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Escalate"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="CancelDialog" button-text="Cancel Request">
                        <form-single name="CancelForm" transition="cancelRequest">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="comments"><default-field title="Reason"><text-area rows="2" cols="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Cancel Request"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-body></container-box>

                <!-- Decision History -->
                <container-box><box-header title="Decision History"/>
                <box-body>
                    <form-list name="DecisionList" list="decisionList" skip-form="true">
                        <field name="stepNumber"><default-field title="Step"><display/></default-field></field>
                        <field name="decision"><default-field title="Decision">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="approverPartyId"><default-field title="By"><display/></default-field></field>
                        <field name="comments"><default-field title="Comments"><display/></default-field></field>
                        <field name="decisionDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Notifications -->
                <container-box><box-header title="Notifications"/>
                <box-body>
                    <form-list name="NotifList" list="notifList" skip-form="true">
                        <field name="notificationType"><default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="recipientPartyId"><default-field title="To"><display/></default-field></field>
                        <field name="sentDate"><default-field title="Sent"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="isRead"><default-field title="Read"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
