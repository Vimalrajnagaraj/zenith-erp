<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Workflows" default-menu-index="3">

    <transition name="createWorkflow" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): a tenant-created workflow is private to their org; a no-org admin authors a
                 global (NULL-org) shared template. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.approvals.ApprovalWorkflow" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="editWorkflow"><default-response url="../EditWorkflow"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.approvals.ApprovalWorkflow" list="wfList">
            <!-- ZE-SB-013 (Tier 4): this org's workflows + global (NULL-org) shared templates. -->
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="workflowName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Approval Workflows"/>
            <box-toolbar>
                <section name="apr_newwf_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateWfDialog" button-text="New Workflow">
                    <form-single name="CreateWfForm" transition="createWorkflow">
                        <field name="workflowId"><default-field title="ID"><text-line size="20"/></default-field></field>
                        <field name="workflowName"><default-field title="Name"><text-line size="30"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="entityName"><default-field title="Target Entity"><text-line size="30"/></default-field></field>
                        <field name="triggerStatusId"><default-field title="Trigger Status"><text-line size="15"/></default-field></field>
                        <field name="approvedStatusId"><default-field title="Approved Status"><text-line size="15"/></default-field></field>
                        <field name="rejectedStatusId"><default-field title="Rejected Status"><text-line size="15"/></default-field></field>
                        <field name="autoApproveAmount"><default-field title="Auto-Approve Below (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="amountFieldName"><default-field title="Amount Field Name"><text-line size="20"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="WfList" list="wfList" skip-form="true">
                    <field name="workflowId"><default-field title="ID"><display/></default-field></field>
                    <field name="workflowName"><default-field title="Name"><display/></default-field></field>
                    <field name="entityName"><default-field title="Entity"><display/></default-field></field>
                    <field name="autoApproveAmount"><default-field title="Auto Below"><display format="#,##,##0"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><display/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editWorkflow" text="Configure" parameter-map="[workflowId:workflowId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
