<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Approvals" default-menu-index="1">

    <transition name="editRequest"><default-response url="../EditRequest"/></transition>

    <actions>
        <set field="currentPartyId" from="ec.user.userAccount?.partyId"/>
        <!-- Pending requests needing my approval (simplified: shows all pending/in-review) -->
        <entity-find entity-name="zenith.erp.approvals.ApprovalRequest" list="pendingList">
            <econdition field-name="statusId" operator="in" value="ArPending,ArInReview,ArEscalated"/>
            <!-- ZE-SB-013 (Tier 4): only this org's pending requests (was leaking ALL tenants'). -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="-requestDate"/>
        </entity-find>
        <!-- My submitted requests -->
        <entity-find entity-name="zenith.erp.approvals.ApprovalRequest" list="myRequestList">
            <econdition field-name="requestedByPartyId" from="currentPartyId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <order-by field-name="-requestDate"/>
            <limit count="50"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6" md="12">
                <container-box>
                    <box-header title="Pending My Approval"/>
                    <box-body>
                        <form-list name="PendingList" list="pendingList" skip-form="true">
                            <field name="requestNumber"><default-field title="Req #"><display/></default-field></field>
                            <field name="requestTitle"><default-field title="Title"><display/></default-field></field>
                            <field name="amount"><default-field title="Amount"><display format="#,##,##0.00"/></default-field></field>
                            <field name="priority"><default-field title="Priority">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                            <field name="requestDate"><default-field title="Requested"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                            <field name="viewBtn"><default-field title="">
                                <link url="editRequest" text="Review" parameter-map="[requestId:requestId]"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6" md="12">
                <container-box>
                    <box-header title="My Submitted Requests"/>
                    <box-body>
                        <form-list name="MyRequestList" list="myRequestList" skip-form="true">
                            <field name="requestNumber"><default-field title="Req #"><display/></default-field></field>
                            <field name="requestTitle"><default-field title="Title"><display/></default-field></field>
                            <field name="amount"><default-field title="Amount"><display format="#,##,##0.00"/></default-field></field>
                            <field name="requestDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                            <field name="viewBtn"><default-field title="">
                                <link url="editRequest" text="Detail" parameter-map="[requestId:requestId]"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
