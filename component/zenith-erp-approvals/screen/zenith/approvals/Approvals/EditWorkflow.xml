<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Workflow Detail" default-menu-include="false">

    <parameter name="workflowId" required="true"/>

    <transition name="updateWorkflow" begin-transaction="true">
        <service-call name="update#zenith.erp.approvals.ApprovalWorkflow"/>
        <default-response url="."/>
    </transition>
    <transition name="addStep" begin-transaction="true">
        <service-call name="create#zenith.erp.approvals.ApprovalStep"/>
        <default-response url="."/>
    </transition>
    <transition name="updateStep" begin-transaction="true">
        <service-call name="update#zenith.erp.approvals.ApprovalStep"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.approvals.ApprovalWorkflow" value-field="wf"/>
        <entity-find entity-name="zenith.erp.approvals.ApprovalStep" list="stepList">
            <econdition field-name="workflowId"/>
            <order-by field-name="stepNumber"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box><box-header title="Workflow: ${wf?.workflowName}"/>
                <box-body>
                    <form-single name="WfForm" transition="updateWorkflow" map="wf">
                        <field name="workflowId"><default-field title="ID"><display/></default-field></field>
                        <field name="workflowName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="entityName"><default-field title="Target Entity"><text-line size="30"/></default-field></field>
                        <field name="triggerStatusId"><default-field title="Trigger Status"><text-line size="15"/></default-field></field>
                        <field name="approvedStatusId"><default-field title="Approved Status"><text-line size="15"/></default-field></field>
                        <field name="rejectedStatusId"><default-field title="Rejected Status"><text-line size="15"/></default-field></field>
                        <field name="autoApproveAmount"><default-field title="Auto-Approve Below (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="amountFieldName"><default-field title="Amount Field"><text-line size="20"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <container-box><box-header title="Approval Steps"/>
                <box-toolbar>
                    <container-dialog id="AddStepDialog" button-text="Add Step">
                        <form-single name="AddStepForm" transition="addStep">
                            <field name="workflowId"><default-field><hidden/></default-field></field>
                            <field name="stepNumber"><default-field title="Step #"><text-line size="4"/></default-field></field>
                            <field name="stepName"><default-field title="Step Name"><text-line size="25"/></default-field></field>
                            <field name="approverType"><default-field title="Approver Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="ApproverType"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="approverPartyId"><default-field title="Specific Approver (Party ID)"><text-line size="15"/></default-field></field>
                            <field name="minAmount"><default-field title="Min Amount"><text-line size="10"/></default-field></field>
                            <field name="maxAmount"><default-field title="Max Amount"><text-line size="10"/></default-field></field>
                            <field name="autoApproveHours"><default-field title="Auto-Approve After (hours)"><text-line size="5"/></default-field></field>
                            <field name="isRequired"><default-field title="Required">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body>
                    <form-list name="StepList" list="stepList" transition="updateStep">
                        <field name="workflowId"><default-field><hidden/></default-field></field>
                        <field name="stepNumber"><default-field title="Step"><display/></default-field></field>
                        <field name="stepName"><default-field title="Name"><text-line size="15"/></default-field></field>
                        <field name="approverType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="ApproverType"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="approverPartyId"><default-field title="Approver"><text-line size="10"/></default-field></field>
                        <field name="minAmount"><default-field title="Min"><text-line size="8"/></default-field></field>
                        <field name="maxAmount"><default-field title="Max"><text-line size="8"/></default-field></field>
                        <field name="autoApproveHours"><default-field title="Auto Hrs"><text-line size="4"/></default-field></field>
                        <field name="isRequired"><default-field title="Req">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
