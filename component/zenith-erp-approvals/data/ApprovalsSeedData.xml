        stepName="Manager Approval" approverType="ApType_MANAGER" isRequired="Y"
        minAmount="10000" maxAmount="100000" autoApproveHours="48"/>
    <zenith.erp.approvals.ApprovalStep workflowId="AWF_PURCHASE_ORDER" stepNumber="2"
        stepName="Director Approval" approverType="ApType_DEPT_HEAD" isRequired="Y"
        minAmount="100000" maxAmount="1000000" autoApproveHours="72"/>

