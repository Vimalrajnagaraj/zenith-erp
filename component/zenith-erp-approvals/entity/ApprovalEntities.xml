<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Approval Workflow Template -->
    <entity entity-name="ApprovalWorkflow" package="zenith.erp.approvals" short-alias="ApprovalWorkflows">
        <field name="workflowId" type="id" is-pk="true"/>
        <field name="workflowName" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="entityName" type="text-medium"/>
        <field name="triggerStatusId" type="id"/>
        <field name="approvedStatusId" type="id"/>
        <field name="rejectedStatusId" type="id"/>
        <field name="autoApproveAmount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="amountFieldName" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- Approval Step (multi-level approval chain) -->
    <entity entity-name="ApprovalStep" package="zenith.erp.approvals" short-alias="ApprovalSteps">
        <field name="workflowId" type="id" is-pk="true"/>
        <field name="stepNumber" type="number-integer" is-pk="true"/>
        <field name="stepName" type="text-medium"/>
        <field name="approverType" type="id"/>
        <field name="approverPartyId" type="id"/>
        <field name="approverRoleTypeId" type="id"/>
        <field name="minAmount" type="currency-precise"/>
        <field name="maxAmount" type="currency-precise"/>
        <field name="autoApproveHours" type="number-integer"/>
        <field name="isRequired" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.approvals.ApprovalWorkflow"/>
    </entity>

    <!-- Approval Request -->
    <entity entity-name="ApprovalRequest" package="zenith.erp.approvals" short-alias="ApprovalRequests">
        <field name="requestId" type="id" is-pk="true"/>
        <field name="requestNumber" type="text-short"/>
        <field name="workflowId" type="id"/>
        <field name="entityName" type="text-medium"/>
        <field name="primaryKeyValue" type="text-medium"/>
        <field name="requestTitle" type="text-medium"/>
        <field name="requestDescription" type="text-long"/>
        <field name="amount" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="requestedByPartyId" type="id"/>
        <field name="requestDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="currentStepNumber" type="number-integer" default="1"/>
        <field name="completedDate" type="date-time"/>
        <field name="moduleEnumId" type="id"/>
        <field name="priority" type="id"/>
        <field name="dueDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.approvals.ApprovalWorkflow"/>
        <relationship type="one" title="ApprovalRequest" related="moqui.basic.StatusItem"/>
    </entity>

    <!-- Individual Approval Decision -->
    <entity entity-name="ApprovalDecision" package="zenith.erp.approvals" short-alias="ApprovalDecisions">
        <field name="decisionId" type="id" is-pk="true"/>
        <field name="requestId" type="id"/>
        <field name="stepNumber" type="number-integer"/>
        <field name="approverPartyId" type="id"/>
        <field name="decision" type="id"/>
        <field name="comments" type="text-long"/>
        <field name="decisionDate" type="date-time"/>
        <field name="delegatedToPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.approvals.ApprovalRequest"/>
    </entity>

    <!-- Approval Delegation -->
    <entity entity-name="ApprovalDelegation" package="zenith.erp.approvals" short-alias="ApprovalDelegations">
        <field name="delegationId" type="id" is-pk="true"/>
        <field name="fromPartyId" type="id"/>
        <field name="toPartyId" type="id"/>
        <field name="workflowId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <field name="reason" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.approvals.ApprovalWorkflow" fk-name="FK_APDEL_WF"/>
    </entity>

    <!-- Approval Notification Log -->
    <entity entity-name="ApprovalNotification" package="zenith.erp.approvals" short-alias="ApprovalNotifications">
        <field name="notificationId" type="id" is-pk="true"/>
        <field name="requestId" type="id"/>
        <field name="recipientPartyId" type="id"/>
        <field name="notificationType" type="id"/>
        <field name="sentDate" type="date-time"/>
        <field name="isRead" type="text-indicator" default="'N'"/>
        <field name="readDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.approvals.ApprovalRequest" fk-name="FK_APNOTIF_REQ"/>
    </entity>

    <!-- View: Approval Request with workflow info -->
    <view-entity entity-name="ApprovalRequestView" package="zenith.erp.approvals">
        <member-entity entity-alias="AR" entity-name="zenith.erp.approvals.ApprovalRequest"/>
        <member-entity entity-alias="AW" entity-name="zenith.erp.approvals.ApprovalWorkflow" join-from-alias="AR">
            <key-map field-name="workflowId"/></member-entity>
        <alias-all entity-alias="AR"/>
        <alias entity-alias="AW" name="workflowName"/>
    </view-entity>
</entities>
