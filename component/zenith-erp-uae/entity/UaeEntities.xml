<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- UAE-specific Party fields -->
    <extend-entity entity-name="Party" package="mantle.party">
        <field name="trnNumber" type="text-short"><description>Tax Registration Number (UAE VAT)</description></field>
        <field name="emiratesIdNumber" type="text-short"><description>Emirates ID</description></field>
        <field name="tradeLicenseNumber" type="text-short"><description>Trade License Number</description></field>
        <field name="freeZoneCode" type="text-short"><description>Free Zone code if registered in a free zone</description></field>
    </extend-entity>

    <!-- UAE-specific Employee fields -->
    <extend-entity entity-name="Employee" package="zenith.erp.hr">
        <field name="emiratesId" type="text-short"/>
        <field name="labourCardNumber" type="text-short"/>
        <field name="visaNumber" type="text-short"/>
        <field name="visaExpiryDate" type="date"/>
        <field name="wpsPersonId" type="text-short"><description>WPS Wages Protection System ID</description></field>
        <field name="molReference" type="text-short"><description>Ministry of Labour reference</description></field>
    </extend-entity>

    <!-- UAE VAT Return -->
    <entity entity-name="UaeVatReturn" package="zenith.erp.uae" short-alias="UaeVatReturn">
        <field name="vatReturnId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="trnNumber" type="text-short"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="standardRatedSales" type="currency-amount" default="0"/>
        <field name="zeroRatedSales" type="currency-amount" default="0"/>
        <field name="exemptSales" type="currency-amount" default="0"/>
        <field name="reverseChargeSales" type="currency-amount" default="0"/>
        <field name="outputVat" type="currency-amount" default="0"/>
        <field name="standardRatedPurchases" type="currency-amount" default="0"/>
        <field name="inputVat" type="currency-amount" default="0"/>
        <field name="netVatDue" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <field name="filingDeadline" type="date"/>
        <field name="ftaReferenceNumber" type="text-medium"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="UaeVatReturn" description="UAE VAT Return Status"/>
            <moqui.basic.StatusItem statusId="UvrDraft" statusTypeId="UaeVatReturn" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="UvrCalculated" statusTypeId="UaeVatReturn" description="Calculated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="UvrFiled" statusTypeId="UaeVatReturn" description="Filed with FTA" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="UvrPaid" statusTypeId="UaeVatReturn" description="Paid" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="UvrDraft" toStatusId="UvrCalculated" transitionName="Calculate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="UvrCalculated" toStatusId="UvrFiled" transitionName="File"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="UvrFiled" toStatusId="UvrPaid" transitionName="Mark Paid"/>
        </seed-data>
    </entity>

    <!-- WPS Payroll Batch -->
    <entity entity-name="WpsBatch" package="zenith.erp.uae" short-alias="WpsBatch">
        <field name="wpsBatchId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="batchMonth" type="number-integer"/>
        <field name="batchYear" type="number-integer"/>
        <field name="totalEmployees" type="number-integer" default="0"/>
        <field name="totalAmount" type="currency-amount" default="0"/>
        <field name="statusId" type="id"/>
        <field name="submittedDate" type="date-time"/>
        <field name="fileContent" type="text-very-long"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="WpsBatch" description="WPS Batch Status"/>
            <moqui.basic.StatusItem statusId="WbDraft" statusTypeId="WpsBatch" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="WbGenerated" statusTypeId="WpsBatch" description="File Generated" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="WbSubmitted" statusTypeId="WpsBatch" description="Submitted" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="WbProcessed" statusTypeId="WpsBatch" description="Processed" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WbDraft" toStatusId="WbGenerated" transitionName="Generate File"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WbGenerated" toStatusId="WbSubmitted" transitionName="Submit"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WbSubmitted" toStatusId="WbProcessed" transitionName="Processed"/>
        </seed-data>
    </entity>

    <!-- WPS Batch Detail: per employee row -->
    <entity entity-name="WpsBatchDetail" package="zenith.erp.uae" short-alias="WpsBatchDetail">
        <field name="wpsBatchId" type="id" is-pk="true"/>
        <field name="employeePartyId" type="id" is-pk="true"/>
        <field name="wpsPersonId" type="text-short"/>
        <field name="basicSalary" type="currency-amount"/>
        <field name="housingAllowance" type="currency-amount" default="0"/>
        <field name="transportAllowance" type="currency-amount" default="0"/>
        <field name="otherAllowance" type="currency-amount" default="0"/>
        <field name="totalDeductions" type="currency-amount" default="0"/>
        <field name="netSalary" type="currency-amount"/>
        <field name="bankCode" type="text-short"/>
        <field name="accountNumber" type="text-medium"/>
        <relationship type="one" related="zenith.erp.uae.WpsBatch" short-alias="batch"/>
    </entity>

    <!-- Free Zone Entity Registration -->
    <entity entity-name="FreeZoneRegistration" package="zenith.erp.uae" short-alias="FreeZoneRegistration">
        <field name="registrationId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="freeZoneEnumId" type="id"/>
        <field name="licenseNumber" type="text-medium"/>
        <field name="licenseType" type="text-short"/>
        <field name="issueDate" type="date"/>
        <field name="expiryDate" type="date"/>
        <field name="isDesignatedZone" type="text-indicator" default="'N'"/>
        <relationship type="one" related="mantle.party.Party" short-alias="party"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="UaeFreeZone" description="UAE Free Zone"/>
            <moqui.basic.Enumeration enumId="FzJafza" enumTypeId="UaeFreeZone" description="JAFZA (Jebel Ali)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="FzDmcc" enumTypeId="UaeFreeZone" description="DMCC" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="FzDifc" enumTypeId="UaeFreeZone" description="DIFC" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="FzDafza" enumTypeId="UaeFreeZone" description="DAFZA (Airport)" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="FzAdgm" enumTypeId="UaeFreeZone" description="ADGM" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="FzRakez" enumTypeId="UaeFreeZone" description="RAKEZ" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="FzSaif" enumTypeId="UaeFreeZone" description="SAIF Zone" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="FzIfza" enumTypeId="UaeFreeZone" description="IFZA" sequenceNum="8"/>
        </seed-data>
    </entity>

</entities>
