<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- UAE VAT Calculator: implements the pluggable tax engine interface -->
    <service verb="calculate" noun="Tax">
        <description>UAE VAT calculation (5% standard, 0% zero-rated, exempt).
            Registered as TAX_CALCULATION_SERVICE for UAE companies.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="customerPartyId"/>
            <parameter name="items" type="List" required="true">
                <parameter name="itemEntry" type="Map">
                    <parameter name="productId"/>
                    <parameter name="productTaxCode"/>
                    <parameter name="taxCategoryId"/>
                    <parameter name="quantity" type="BigDecimal" required="true"/>
                    <parameter name="unitAmount" type="BigDecimal" required="true"/>
                    <parameter name="discountAmount" type="BigDecimal"/>
                    <parameter name="isTaxInclusive" default-value="N"/>
                </parameter>
            </parameter>
            <parameter name="originRegionGeoId"/>
            <parameter name="destinationRegionGeoId"/>
            <parameter name="originCountryGeoId"/>
            <parameter name="destinationCountryGeoId"/>
            <parameter name="currencyUomId"/>
            <parameter name="transactionDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="transactionType" default-value="SALE"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taxedItems" type="List"/>
            <parameter name="totalTaxableAmount" type="BigDecimal"/>
            <parameter name="totalTaxAmount" type="BigDecimal"/>
            <parameter name="totalAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <set field="taxedItems" from="[]"/>
            <set field="totalTaxableAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="totalTaxAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="totalAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="standardRate" from="5" type="BigDecimal"/>

            <!-- Check if seller is in a designated free zone -->
            <entity-find entity-name="zenith.erp.uae.FreeZoneRegistration" list="sellerFz">
                <econdition field-name="partyId" from="organizationPartyId"/>
                <econdition field-name="isDesignatedZone" value="Y"/>
            </entity-find>

            <set field="itemIndex" from="0" type="Integer"/>
            <iterate list="items" entry="item">
                <set field="lineAmount" from="((item.quantity ?: 0) as BigDecimal) * ((item.unitAmount ?: 0) as BigDecimal)" type="BigDecimal"/>
                <set field="lineDiscount" from="(item.discountAmount ?: 0) as BigDecimal"/>
                <set field="taxableAmount" from="lineAmount - lineDiscount" type="BigDecimal"/>
                <set field="vatRate" from="standardRate" type="BigDecimal"/>

                <!-- Zero-rated supplies -->
                <if condition="item.productTaxCode == 'UAE_ZERO'">
                    <set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/>
                </if>
                <if condition="item.productTaxCode == 'UAE_EXEMPT'">
                    <set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/>
                </if>
                <if condition="item.productTaxCode == 'UAE_EXPORT'">
                    <set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/>
                </if>

                <!-- Export: destination outside UAE -->
                <if condition="destinationCountryGeoId &amp;&amp; destinationCountryGeoId != 'ARE'">
                    <set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/>
                </if>

                <!-- Designated zone to designated zone: no VAT -->
                <if condition="sellerFz &amp;&amp; customerPartyId">
                    <entity-find entity-name="zenith.erp.uae.FreeZoneRegistration" list="buyerFz">
                        <econdition field-name="partyId" from="customerPartyId"/>
                        <econdition field-name="isDesignatedZone" value="Y"/>
                    </entity-find>
                    <if condition="buyerFz">
                        <set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/>
                    </if>
                </if>

                <!-- Check customer exemption -->
                <if condition="customerPartyId">
                    <service-call name="zenith.tax.TaxServices.check#TaxExemption" ignore-error="true"
                                  in-map="[partyId:customerPartyId, productId:item.productId,
                                           transactionDate:transactionDate]"
                                  out-map="exemptResult"/>
                    <if condition="exemptResult?.isExempt"><set field="vatRate" from="BigDecimal.ZERO" type="BigDecimal"/></if>
                </if>

                <!-- Handle tax-inclusive pricing -->
                <if condition="item.isTaxInclusive == 'Y' &amp;&amp; vatRate &gt; 0">
                    <set field="taxableAmount" from="(taxableAmount / (1 + vatRate / 100)).setScale(2, java.math.RoundingMode.HALF_UP)" type="BigDecimal"/>
                </if>

                <set field="vatAmount" from="(taxableAmount * vatRate / 100).setScale(2, java.math.RoundingMode.HALF_UP)" type="BigDecimal"/>
                <set field="breakdowns" from="[]"/>
                <if condition="vatRate &gt; 0">
                    <script>breakdowns.add([taxName:'VAT', taxRate:vatRate,
                        taxableAmount:taxableAmount, taxAmount:vatAmount,
                        taxAuthorityId:'ARE_FTA', countryGeoId:'ARE',
                        isIncludedInPrice:item.isTaxInclusive ?: 'N'])</script>
                </if>

                <script>taxedItems.add([itemIndex:itemIndex, taxableAmount:taxableAmount,
                    totalTaxAmount:vatAmount, taxBreakdowns:breakdowns])</script>
                <set field="totalTaxableAmount" from="totalTaxableAmount + taxableAmount"/>
                <set field="totalTaxAmount" from="totalTaxAmount + vatAmount"/>
                <set field="totalAmount" from="totalAmount + taxableAmount + vatAmount"/>
                <set field="itemIndex" from="itemIndex + 1"/>
            </iterate>
        </actions>
    </service>

    <!-- Generate UAE VAT Return -->
    <service verb="generate" noun="VatReturn">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="periodStart" type="Date" required="true"/>
            <parameter name="periodEnd" type="Date" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="vatReturnId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.party.Party" value-field="org">
                <field-map field-name="partyId" from="organizationPartyId"/>
            </entity-find-one>

            <service-call name="create#zenith.erp.uae.UaeVatReturn"
                          in-map="[organizationPartyId:organizationPartyId, trnNumber:org?.trnNumber,
                                   periodStart:periodStart, periodEnd:periodEnd, statusId:'UvrDraft']"
                          out-map="context"/>
        </actions>
    </service>

    <!-- Generate WPS Batch -->
    <service verb="generate" noun="WpsBatch">
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="batchMonth" type="Integer" required="true"/>
            <parameter name="batchYear" type="Integer" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="wpsBatchId"/></out-parameters>
        <actions>
            <service-call name="create#zenith.erp.uae.WpsBatch"
                          in-map="[organizationPartyId:organizationPartyId, batchMonth:batchMonth,
                                   batchYear:batchYear, statusId:'WbDraft']"
                          out-map="context"/>
        </actions>
    </service>

</services>
