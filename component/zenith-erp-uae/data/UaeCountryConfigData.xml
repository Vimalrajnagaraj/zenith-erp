<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <!-- UAE Country Configuration -->
    <zenith.erp.base.CountryConfiguration countryGeoId="ARE" countryName="United Arab Emirates"
            fiscalYearStartMonth="1" dateFormat="dd/MM/yyyy" numberFormat="###,###.##"
            defaultCurrencyUomId="AED" taxSystemType="VAT"
            amountToWordsService="zenith.uae.UaeServices.convert#AmountToWords"/>

    <!-- UAE Emirates as regions -->
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_AUH" countryGeoId="ARE" regionName="Abu Dhabi" regionCode="AUH" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_DXB" countryGeoId="ARE" regionName="Dubai" regionCode="DXB" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_SHJ" countryGeoId="ARE" regionName="Sharjah" regionCode="SHJ" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_AJM" countryGeoId="ARE" regionName="Ajman" regionCode="AJM" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_UAQ" countryGeoId="ARE" regionName="Umm Al Quwain" regionCode="UAQ" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_RAK" countryGeoId="ARE" regionName="Ras Al Khaimah" regionCode="RAK" hasTaxJurisdiction="Y"/>
    <zenith.erp.base.RegionConfiguration regionGeoId="ARE_FUJ" countryGeoId="ARE" regionName="Fujairah" regionCode="FUJ" hasTaxJurisdiction="Y"/>

    <!-- Party Identification Types for UAE -->
    <moqui.basic.EnumerationType enumTypeId="PartyIdentificationType" description="Party Identification Type"/>
    <moqui.basic.Enumeration enumId="PtidTrn" enumTypeId="PartyIdentificationType" description="TRN (Tax Registration Number)"/>
    <moqui.basic.Enumeration enumId="PtidEmiratesId" enumTypeId="PartyIdentificationType" description="Emirates ID"/>
    <moqui.basic.Enumeration enumId="PtidTradeLicense" enumTypeId="PartyIdentificationType" description="Trade License Number"/>
    <moqui.basic.Enumeration enumId="PtidLabourCard" enumTypeId="PartyIdentificationType" description="Labour Card Number"/>
</entity-facade-xml>
