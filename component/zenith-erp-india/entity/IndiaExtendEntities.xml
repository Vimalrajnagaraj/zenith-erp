<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ================================================================== -->
    <!-- India-specific entity extensions for Mantle and Zenith core entities -->
    <!-- These fields are only loaded when zenith-erp-india component is active -->
    <!-- Zero-downtime: columns already exist in DB from prior definitions   -->
    <!-- ================================================================== -->

    <!-- ========== ORDER HEADER — India GST Fields ========== -->
    <extend-entity entity-name="OrderHeader" package="mantle.order">
        <field name="placeOfSupplyStateCode" type="text-short"/>
        <field name="isReverseCharge" type="text-indicator" default="'N'"/>
        <field name="isExport" type="text-indicator" default="'N'"/>
        <field name="lutBondNumber" type="text-short"/>
        <field name="shippingBillNumber" type="text-short"/>
        <field name="shippingBillDate" type="date"/>
        <field name="portCode" type="text-short"/>
        <field name="buyerGstin" type="text-short"/>
        <field name="supplierGstin" type="text-short"/>
        <field name="supplierStateCode" type="text-short"/>
        <field name="isSezSupply" type="text-indicator" default="'N'"/>
        <field name="tcsApplicable" type="text-indicator" default="'N'"/>
        <field name="tcsAmount" type="currency-precise"/>
        <field name="totalCgst" type="currency-precise"/>
        <field name="totalSgst" type="currency-precise"/>
        <field name="totalIgst" type="currency-precise"/>
        <field name="totalCess" type="currency-precise"/>
    </extend-entity>

    <!-- ========== ORDER ITEM — India GST per-line ========== -->
    <extend-entity entity-name="OrderItem" package="mantle.order">
        <field name="hsnSacCode" type="text-short"/>
        <field name="gstSlabId" type="id"/>
        <field name="cgstRate" type="number-decimal"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstRate" type="number-decimal"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstRate" type="number-decimal"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessRate" type="number-decimal"/>
        <field name="cessAmount" type="currency-precise"/>
    </extend-entity>

    <!-- ========== INVOICE — India GST, Transport, E-Invoice, Purchase ========== -->
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="gstInvoiceNumber" type="text-short"/>
        <field name="placeOfSupplyStateCode" type="text-short"/>
        <field name="supplierStateCode" type="text-short"/>
        <field name="buyerGstin" type="text-short"/>
        <field name="supplierGstin" type="text-short"/>
        <field name="isReverseCharge" type="text-indicator" default="'N'"/>
        <field name="isExport" type="text-indicator" default="'N'"/>
        <field name="isSezSupply" type="text-indicator" default="'N'"/>
        <field name="isWithPayment" type="text-indicator" default="'N'"/>
        <field name="lutBondNumber" type="text-short"/>
        <field name="shippingBillNumber" type="text-short"/>
        <field name="shippingBillDate" type="date"/>
        <field name="portCode" type="text-short"/>
        <field name="einvoiceId" type="id"/>
        <field name="ewayBillId" type="id"/>
        <field name="totalCgst" type="currency-precise"/>
        <field name="totalSgst" type="currency-precise"/>
        <field name="totalIgst" type="currency-precise"/>
        <field name="totalCess" type="currency-precise"/>
        <field name="tcsApplicable" type="text-indicator" default="'N'"/>
        <field name="tcsRate" type="number-decimal"/>
        <field name="tcsAmount" type="currency-precise"/>
        <field name="b2bB2cType" type="text-short"/>
        <field name="advanceReceiptAdjusted" type="currency-precise"/>
        <field name="transporterId" type="id"/>
        <field name="transporterName" type="text-medium"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="lrNumber" type="text-short"/>
        <field name="dispatchFromPincode" type="text-short"/>
        <field name="deliveryToPincode" type="text-short"/>
        <field name="distanceKm" type="number-integer"/>
        <field name="isCompositionDealer" type="text-indicator" default="'N'"/>
        <field name="itcEligible" type="text-indicator" default="'Y'"/>
        <field name="itcIneligibleReason" type="text-medium"/>
        <field name="gstr2bMatchStatus" type="text-short"/>
        <field name="gstr2bMatchDate" type="date-time"/>
    </extend-entity>

    <!-- ========== INVOICE ITEM — India GST per-line ========== -->
    <extend-entity entity-name="InvoiceItem" package="mantle.account.invoice">
        <field name="hsnSacCode" type="text-short"/>
        <field name="gstSlabId" type="id"/>
        <field name="cgstRate" type="number-decimal"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstRate" type="number-decimal"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstRate" type="number-decimal"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessRate" type="number-decimal"/>
        <field name="cessAmount" type="currency-precise"/>
    </extend-entity>

    <!-- ========== PARTY — India Tax & Legal IDs ========== -->
    <extend-entity entity-name="Party" package="mantle.party">
        <field name="panNumber" type="text-short"/>
        <field name="gstRegistrationType" type="text-short"/>
        <field name="msmeUdyamNumber" type="text-short"/>
        <field name="tdsApplicable" type="text-indicator" default="'N'"/>
        <field name="defaultTdsSectionId" type="id"/>
        <field name="tanNumber" type="text-short"/>
        <field name="cinNumber" type="text-short"/>
        <field name="businessStructureEnumId" type="id"/>
        <field name="msmeStatusEnumId" type="id"/>
        <field name="fssaiLicense" type="text-short"/>
        <field name="drugLicense" type="text-short"/>
        <field name="tradeLicense" type="text-short"/>
        <field name="upiVpa" type="text-short"/>
        <field name="bankBeneficiaryStatus" type="text-short"/>
        <field name="bankIfscCode" type="text-short"/>
    </extend-entity>

    <!-- ========== PRODUCT — India HSN/GST ========== -->
    <extend-entity entity-name="Product" package="mantle.product">
        <field name="hsnCode" type="text-short"/>
        <field name="sacCode" type="text-short"/>
        <field name="gstSlabId" type="id"/>
        <field name="uqcEnumId" type="id"/>
        <field name="isGstExempt" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.india.IndiaGstSlab" short-alias="gstSlab">
            <key-map field-name="gstSlabId"/></relationship>
    </extend-entity>

    <!-- ========== FACILITY — India GST ========== -->
    <extend-entity entity-name="Facility" package="mantle.facility">
        <field name="gstStateCode" type="text-short"/>
        <field name="facilityGstin" type="text-short"/>
    </extend-entity>

    <!-- ========== GL ACCOUNT — India Schedule III ========== -->
    <extend-entity entity-name="GlAccount" package="mantle.ledger.account">
        <field name="scheduleIiiGroup" type="text-short"/>
        <field name="scheduleIiiSubGroup" type="text-short"/>
        <field name="isGstAccount" type="text-indicator" default="'N'"/>
        <field name="gstAccountType" type="text-short"/>
    </extend-entity>

    <!-- ========== POS TERMINAL — India GST/UPI ========== -->
    <extend-entity entity-name="PosTerminal" package="zenith.erp.pos">
        <field name="gstin" type="text-short"/>
        <field name="stateCode" type="text-short"/>
        <field name="upiVpa" type="text-medium"/>
    </extend-entity>

    <!-- ========== POS TRANSACTION — India GST Totals ========== -->
    <extend-entity entity-name="PosTransaction" package="zenith.erp.pos">
        <field name="customerGstin" type="text-short"/>
        <field name="isB2b" type="text-indicator"/>
        <field name="placeOfSupplyStateCode" type="text-short"/>
        <field name="cgstTotal" type="currency-amount"/>
        <field name="sgstTotal" type="currency-amount"/>
        <field name="igstTotal" type="currency-amount"/>
        <field name="cessTotal" type="currency-amount"/>
    </extend-entity>

    <!-- ========== POS TRANSACTION ITEM — India GST per-line ========== -->
    <extend-entity entity-name="PosTransactionItem" package="zenith.erp.pos">
        <field name="hsnCode" type="text-short"/>
        <field name="gstRate" type="number-decimal"/>
        <field name="cgstRate" type="number-decimal"/>
        <field name="cgstAmount" type="currency-amount"/>
        <field name="sgstRate" type="number-decimal"/>
        <field name="sgstAmount" type="currency-amount"/>
        <field name="igstRate" type="number-decimal"/>
        <field name="igstAmount" type="currency-amount"/>
        <field name="cessAmount" type="currency-amount"/>
    </extend-entity>

    <!-- ========== STOCK TRANSFER — India E-Way Bill ========== -->
    <extend-entity entity-name="StockTransfer" package="zenith.erp.inventory">
        <field name="transporterGstin" type="text-short"/>
        <field name="ewayBillId" type="id"/>
        <field name="igstInvoiceId" type="id"/>
        <relationship type="one" related="zenith.erp.india.IndiaEwayBill">
            <key-map field-name="ewayBillId"/></relationship>
    </extend-entity>

    <!-- ========== STOCK TRANSFER ITEM — India HSN ========== -->
    <extend-entity entity-name="StockTransferItem" package="zenith.erp.inventory">
        <field name="hsnCode" type="text-short"/>
    </extend-entity>

    <!-- ========== EMPLOYEE — India Statutory IDs ========== -->
    <extend-entity entity-name="Employee" package="zenith.erp.hr">
        <field name="panNumber" type="text-short"/>
        <field name="aadhaarNumber" type="text-short"/>
        <field name="uanNumber" type="text-short"/>
        <field name="pfNumber" type="text-short"/>
        <field name="esiNumber" type="text-short"/>
        <field name="ifscCode" type="text-short"/>
        <field name="stateCode" type="text-short"/>
        <field name="isMetroCity" type="text-indicator" default="'N'"/>
        <field name="incomeTaxRegime" type="text-short" default="'New'"/>
        <field name="pfApplicable" type="text-indicator" default="'Y'"/>
        <field name="esiApplicable" type="text-indicator" default="'N'"/>
        <field name="ptApplicable" type="text-indicator" default="'Y'"/>
        <field name="gratuityContinuousYears" type="number-decimal"/>
    </extend-entity>

    <!-- ========== PAYSLIP — India Statutory Components ========== -->
    <extend-entity entity-name="Payslip" package="zenith.erp.payroll">
        <field name="hra" type="currency-amount"/>
        <field name="da" type="currency-amount"/>
        <field name="conveyance" type="currency-amount"/>
        <field name="medicalAllowance" type="currency-amount"/>
        <field name="lta" type="currency-amount"/>
        <field name="epfEmployee" type="currency-amount"/>
        <field name="esiEmployee" type="currency-amount"/>
        <field name="professionalTax" type="currency-amount"/>
        <field name="epfEmployer" type="currency-amount"/>
        <field name="epsEmployer" type="currency-amount"/>
        <field name="epfAdminCharges" type="currency-amount"/>
        <field name="edliContribution" type="currency-amount"/>
        <field name="esiEmployer" type="currency-amount"/>
        <field name="gratuityProvision" type="currency-amount"/>
    </extend-entity>

    <!-- ========== SALARY STRUCTURE — India Salary Components ========== -->
    <extend-entity entity-name="SalaryStructure" package="zenith.erp.payroll">
        <field name="hraPercentOfBasic" type="number-decimal"/>
        <field name="daPercentOfBasic" type="number-decimal"/>
        <field name="ltaPercentOfBasic" type="number-decimal"/>
        <field name="includeEpfInCtc" type="text-indicator"/>
        <field name="includeEsiInCtc" type="text-indicator"/>
        <field name="includeGratuityInCtc" type="text-indicator"/>
    </extend-entity>

    <!-- ========== LEAD — India Tax IDs ========== -->
    <extend-entity entity-name="Lead" package="zenith.erp.crm">
        <field name="gstin" type="text-short"/>
        <field name="panNumber" type="text-short"/>
    </extend-entity>

    <!-- ========== India-specific Contact List View ========== -->
    <view-entity entity-name="IndiaContactListView" package="zenith.erp.india">
        <member-entity entity-alias="PTY" entity-name="mantle.party.Party"/>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="GST" entity-name="zenith.erp.india.IndiaGstin" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias entity-alias="PTY" name="partyId"/>
        <alias entity-alias="PTY" name="partyTypeEnumId"/>
        <alias entity-alias="PTY" name="panNumber"/>
        <alias entity-alias="PTY" name="gstRegistrationType"/>
        <alias entity-alias="PTY" name="msmeUdyamNumber"/>
        <alias entity-alias="PTY" name="tdsApplicable"/>
        <alias entity-alias="PTY" name="tanNumber"/>
        <alias entity-alias="PTY" name="cinNumber"/>
        <alias entity-alias="PTY" name="businessStructureEnumId"/>
        <alias entity-alias="PTY" name="msmeStatusEnumId"/>
        <alias entity-alias="PTY" name="fssaiLicense"/>
        <alias entity-alias="PTY" name="drugLicense"/>
        <alias entity-alias="PTY" name="tradeLicense"/>
        <alias entity-alias="PTY" name="upiVpa"/>
        <alias entity-alias="PTY" name="bankIfscCode"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="ORG" name="organizationName"/>
        <alias entity-alias="GST" name="gstin"/>
        <alias entity-alias="GST" name="stateCode" field="stateCode"/>
    </view-entity>

    <!-- ========== India Sales Invoice GST View (moved from sales) ========== -->
    <view-entity entity-name="SalesInvoiceGstView" package="zenith.erp.india">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="FPTY" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="TPTY" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="FORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="TORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="TPER" entity-name="mantle.party.Person" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias entity-alias="INV" name="invoiceId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="dueDate"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="gstInvoiceNumber"/>
        <alias entity-alias="INV" name="financialYearPrefix"/>
        <alias entity-alias="INV" name="placeOfSupplyStateCode"/>
        <alias entity-alias="INV" name="supplierGstin"/>
        <alias entity-alias="INV" name="buyerGstin"/>
        <alias entity-alias="INV" name="isReverseCharge"/>
        <alias entity-alias="INV" name="isExport"/>
        <alias entity-alias="INV" name="totalCgst"/>
        <alias entity-alias="INV" name="totalSgst"/>
        <alias entity-alias="INV" name="totalIgst"/>
        <alias entity-alias="INV" name="totalCess"/>
        <alias entity-alias="INV" name="totalTaxableAmount"/>
        <alias entity-alias="INV" name="amountInWords"/>
        <alias entity-alias="INV" name="originalInvoiceId"/>
        <alias entity-alias="INV" name="creditDebitNoteType"/>
        <alias entity-alias="INV" name="documentType"/>
        <alias entity-alias="INV" name="b2bB2cType"/>
        <alias entity-alias="INV" name="tcsApplicable"/>
        <alias entity-alias="INV" name="tcsAmount"/>
        <alias entity-alias="INV" name="transporterId"/>
        <alias entity-alias="INV" name="transporterName"/>
        <alias entity-alias="INV" name="vehicleNumber"/>
        <alias entity-alias="INV" name="lrNumber"/>
        <alias entity-alias="INV" name="dispatchFromPincode"/>
        <alias entity-alias="INV" name="deliveryToPincode"/>
        <alias entity-alias="INV" name="distanceKm"/>
        <alias entity-alias="FORG" name="supplierName" field="organizationName"/>
        <alias entity-alias="TORG" name="buyerOrgName" field="organizationName"/>
        <alias entity-alias="TPER" name="buyerFirstName" field="firstName"/>
        <alias entity-alias="TPER" name="buyerLastName" field="lastName"/>
    </view-entity>

    <!-- ========== India Purchase Invoice View (moved from purchase) ========== -->
    <view-entity entity-name="IndiaPurchaseInvoiceView" package="zenith.erp.india">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="VORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="BORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias entity-alias="INV" name="invoiceId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="invoiceTotal"/>
        <alias entity-alias="INV" name="gstInvoiceNumber"/>
        <alias entity-alias="INV" name="vendorInvoiceNumber"/>
        <alias entity-alias="INV" name="vendorInvoiceDate"/>
        <alias entity-alias="INV" name="supplierGstin"/>
        <alias entity-alias="INV" name="buyerGstin"/>
        <alias entity-alias="INV" name="placeOfSupplyStateCode"/>
        <alias entity-alias="INV" name="isReverseCharge"/>
        <alias entity-alias="INV" name="isImportPurchase"/>
        <alias entity-alias="INV" name="itcEligible"/>
        <alias entity-alias="INV" name="gstr2bMatchStatus"/>
        <alias entity-alias="INV" name="totalCgst"/>
        <alias entity-alias="INV" name="totalSgst"/>
        <alias entity-alias="INV" name="totalIgst"/>
        <alias entity-alias="INV" name="totalTaxableAmount"/>
        <alias entity-alias="VORG" name="vendorName" field="organizationName"/>
        <alias entity-alias="BORG" name="buyerName" field="organizationName"/>
    </view-entity>

</entities>
