<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="Gstr1Filing" package="zenith.erp.india.gstr1" short-alias="Gstr1Filing">
        <field name="filingId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="returnPeriod" type="text-short"/> <!-- Format: MMYYYY -->
        <field name="financialYear" type="text-short"/>
        <field name="filingDate" type="date-time"/>
        <field name="acknowledgementNumber" type="text-medium"/>
        <field name="statusId" type="text-short" default="'DRAFT'"/>
        <field name="jsonPayload" type="text-very-long"/>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <entity entity-name="Gstr1B2bRecord" package="zenith.erp.india.gstr1" short-alias="Gstr1B2bRecord">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="buyerGstin" type="text-short"/>
        <field name="buyerName" type="text-medium"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="invoiceDate" type="date"/>
        <field name="invoiceValue" type="currency-precise"/>
        <field name="placeOfSupply" type="text-short"/>
        <field name="reverseCharge" type="text-indicator" default="'N'"/>
        <field name="invoiceType" type="text-short" default="'Regular'"/> <!-- Regular, SEZ supplies with payment, SEZ supplies without payment -->
        <field name="rate" type="number-decimal"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
    </entity>

    <entity entity-name="Gstr1B2clRecord" package="zenith.erp.india.gstr1" short-alias="Gstr1B2clRecord">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="invoiceDate" type="date"/>
        <field name="invoiceValue" type="currency-precise"/>
        <field name="placeOfSupply" type="text-short"/>
        <field name="rate" type="number-decimal"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
    </entity>

    <entity entity-name="Gstr1B2csRecord" package="zenith.erp.india.gstr1" short-alias="Gstr1B2csRecord">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="placeOfSupply" type="text-short"/>
        <field name="rate" type="number-decimal"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
    </entity>

    <entity entity-name="Gstr1CdnrRecord" package="zenith.erp.india.gstr1" short-alias="Gstr1CdnrRecord">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="invoiceId" type="id"/> <!-- CDN Invoice ID -->
        <field name="buyerGstin" type="text-short"/>
        <field name="buyerName" type="text-medium"/>
        <field name="noteNumber" type="text-short"/>
        <field name="noteDate" type="date"/>
        <field name="noteType" type="text-short"/> <!-- C or D -->
        <field name="placeOfSupply" type="text-short"/>
        <field name="noteValue" type="currency-precise"/>
        <field name="rate" type="number-decimal"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
    </entity>

    <entity entity-name="Gstr1HsnSummary" package="zenith.erp.india.gstr1" short-alias="Gstr1HsnSummary">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="hsnSacCode" type="text-short"/>
        <field name="description" type="text-medium"/>
        <field name="uom" type="text-short"/>
        <field name="totalQuantity" type="number-decimal"/>
        <field name="totalValue" type="currency-precise"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
    </entity>

    <entity entity-name="Gstr1ExportRecord" package="zenith.erp.india.gstr1" short-alias="Gstr1ExportRecord">
        <field name="recordId" type="id" is-pk="true"/>
        <field name="filingId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="exportType" type="text-short"/> <!-- WPAY (With Payment), WOPAY (Without Payment) -->
        <field name="invoiceNumber" type="text-short"/>
        <field name="invoiceDate" type="date"/>
        <field name="invoiceValue" type="currency-precise"/>
        <field name="portCode" type="text-short"/>
        <field name="shippingBillNumber" type="text-short"/>
        <field name="shippingBillDate" type="date"/>
        <field name="rate" type="number-decimal"/>
        <field name="taxableValue" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.gstr1.Gstr1Filing"/>
    </entity>

</entities>
