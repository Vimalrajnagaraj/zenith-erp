<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Entities moved from zenith-erp-accounting to India plugin ========== -->

    <!-- TDS Transaction records -->
    <entity entity-name="TdsTransaction" package="zenith.erp.india" short-alias="TdsTransaction">
        <field name="tdsTransactionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="deducteePartyId" type="id"/>
        <field name="tdsSectionId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="transactionDate" type="date-time"/>
        <field name="grossAmount" type="currency-precise"/>
        <field name="tdsRate" type="number-decimal"/>
        <field name="tdsAmount" type="currency-precise"/>
        <field name="netAmount" type="currency-precise"/>
        <field name="panNumber" type="text-short"/>
        <field name="challanNumber" type="text-short"/>
        <field name="challanDate" type="date"/>
        <field name="bsrCode" type="text-short"/>
        <field name="statusId" type="id"/>
        <field name="financialYear" type="text-short"/>
        <field name="quarter" type="text-short"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.party.Party" title="Deductee">
            <key-map field-name="deducteePartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.india.IndiaTdsSection"/>
        <relationship type="one-nofk" related="mantle.account.invoice.Invoice"/>
        <relationship type="one-nofk" related="mantle.account.payment.Payment"/>
    </entity>

    <!-- TDS Certificate (Form 16A) -->
    <entity entity-name="TdsCertificate" package="zenith.erp.india" short-alias="TdsCertificate">
        <field name="certificateId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="deducteePartyId" type="id"/>
        <field name="certificateNumber" type="text-short"/>
        <field name="financialYear" type="text-short"/>
        <field name="quarter" type="text-short"/>
        <field name="totalTdsDeducted" type="currency-precise"/>
        <field name="totalTdsDeposited" type="currency-precise"/>
        <field name="issueDate" type="date"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.party.Party" title="Deductee">
            <key-map field-name="deducteePartyId" related="partyId"/></relationship>
    </entity>

    <!-- TDS Return (Form 26Q/27Q) -->
    <entity entity-name="TdsReturn" package="zenith.erp.india" short-alias="TdsReturn">
        <field name="tdsReturnId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="formType" type="text-short"/>
        <field name="financialYear" type="text-short"/>
        <field name="quarter" type="text-short"/>
        <field name="periodFromDate" type="date"/>
        <field name="periodThruDate" type="date"/>
        <field name="totalTdsDeducted" type="currency-precise"/>
        <field name="totalTdsDeposited" type="currency-precise"/>
        <field name="filingDate" type="date"/>
        <field name="acknowledgementNumber" type="text-short"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>

    <!-- GST Ledger (Electronic Cash, Credit, Liability) -->
    <entity entity-name="GstLedger" package="zenith.erp.india" short-alias="GstLedger">
        <field name="gstLedgerId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="ledgerType" type="text-short"/>
        <field name="taxType" type="text-short"/>
        <field name="transactionDate" type="date-time"/>
        <field name="debitAmount" type="currency-precise"/>
        <field name="creditAmount" type="currency-precise"/>
        <field name="balance" type="currency-precise"/>
        <field name="description" type="text-medium"/>
        <field name="referenceId" type="id"/>
        <field name="referenceType" type="text-short"/>
        <field name="returnPeriod" type="text-short"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>

    <!-- ITC (Input Tax Credit) Register -->
    <entity entity-name="ItcRegister" package="zenith.erp.india" short-alias="ItcRegister">
        <field name="itcRegisterId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="supplierPartyId" type="id"/>
        <field name="supplierGstin" type="text-short"/>
        <field name="invoiceDate" type="date"/>
        <field name="taxableAmount" type="currency-precise"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="cessAmount" type="currency-precise"/>
        <field name="itcEligibility" type="text-short"/>
        <field name="itcAvailed" type="currency-precise"/>
        <field name="itcReversed" type="currency-precise"/>
        <field name="reversalReason" type="text-medium"/>
        <field name="gstr2bMatched" type="text-indicator" default="'N'"/>
        <field name="returnPeriod" type="text-short"/>
        <relationship type="one" related="mantle.party.Party" title="Organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one-nofk" related="mantle.account.invoice.Invoice"/>
    </entity>

    <!-- View: TDS Transaction with party names -->
    <view-entity entity-name="TdsTransactionView" package="zenith.erp.india">
        <member-entity entity-alias="TDS" entity-name="zenith.erp.india.TdsTransaction"/>
        <member-entity entity-alias="SEC" entity-name="zenith.erp.india.IndiaTdsSection" join-from-alias="TDS">
            <key-map field-name="tdsSectionId"/></member-entity>
        <member-entity entity-alias="DPTY" entity-name="mantle.party.Party" join-from-alias="TDS">
            <key-map field-name="deducteePartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="DORG" entity-name="mantle.party.Organization" join-from-alias="DPTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="DPER" entity-name="mantle.party.Person" join-from-alias="DPTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias entity-alias="TDS" name="tdsTransactionId"/>
        <alias entity-alias="TDS" name="organizationPartyId"/>
        <alias entity-alias="TDS" name="deducteePartyId"/>
        <alias entity-alias="TDS" name="transactionDate"/>
        <alias entity-alias="TDS" name="grossAmount"/>
        <alias entity-alias="TDS" name="tdsRate"/>
        <alias entity-alias="TDS" name="tdsAmount"/>
        <alias entity-alias="TDS" name="netAmount"/>
        <alias entity-alias="TDS" name="panNumber"/>
        <alias entity-alias="TDS" name="challanNumber"/>
        <alias entity-alias="TDS" name="statusId"/>
        <alias entity-alias="TDS" name="financialYear"/>
        <alias entity-alias="TDS" name="quarter"/>
        <alias entity-alias="SEC" name="sectionCode"/>
        <alias entity-alias="SEC" name="sectionDescription" field="description"/>
        <alias entity-alias="DORG" name="deducteeName" field="organizationName"/>
        <alias entity-alias="DPER" name="deducteeFirstName" field="firstName"/>
        <alias entity-alias="DPER" name="deducteeLastName" field="lastName"/>
    </view-entity>

</entities>
