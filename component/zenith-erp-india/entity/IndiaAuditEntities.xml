<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- MCA Mandatory Audit Trail Extensions -->
    <!-- Enable strict entity-audit for financial transactions to log old/new values, timestamp, and user -->
    
    <extend-entity entity-name="AcctgTrans" package="mantle.ledger.transaction" enable-audit-log="true"/>
    <extend-entity entity-name="AcctgTransEntry" package="mantle.ledger.transaction" enable-audit-log="true"/>
    <extend-entity entity-name="Invoice" package="mantle.account.invoice" enable-audit-log="true"/>
    <extend-entity entity-name="Payment" package="mantle.account.payment" enable-audit-log="true"/>

</entities>
