<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Entities moved from zenith-erp-sales to India plugin ========== -->

    <!-- TCS Cumulative Tracker -->
    <entity entity-name="TcsCumulativeTracker" package="zenith.erp.india">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="customerPartyId" type="id" is-pk="true"/>
        <field name="financialYear" type="text-short" is-pk="true"/>
        <field name="cumulativeSalesAmount" type="currency-precise"/>
        <field name="tcsStartDate" type="date"/>
        <field name="isThresholdCrossed" type="text-indicator" default="'N'"/>
    </entity>

    <!-- Advance Receipt Voucher (GST on advance received) -->
    <entity entity-name="AdvanceReceiptVoucher" package="zenith.erp.india">
        <field name="voucherId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="receiptDate" type="date"/>
        <field name="amount" type="currency-precise"/>
        <field name="paymentId" type="id"/>
        <field name="gstSlabId" type="id"/>
        <field name="cgstAmount" type="currency-precise"/>
        <field name="sgstAmount" type="currency-precise"/>
        <field name="igstAmount" type="currency-precise"/>
        <field name="invoiceIdAdjusted" type="id"/>
        <field name="statusId" type="id"/>
    </entity>

    <!-- Delivery Challan -->
    <entity entity-name="DeliveryChallan" package="zenith.erp.india" table-name="INDIA_DELIVERY_CHALLAN">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="challanNumber" type="text-short"/>
        <field name="organizationPartyId" type="id"/>
        <field name="toPartyId" type="id"/>
        <field name="challanDate" type="date"/>
        <field name="challanType" type="text-short"/>
        <field name="fromAddressId" type="id"/>
        <field name="toAddressId" type="id"/>
        <field name="ewayBillId" type="id"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="transporterId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="returnDueDate" type="date"/>
        <field name="actualReturnDate" type="date"/>
    </entity>

    <entity entity-name="DeliveryChallanItem" package="zenith.erp.india" table-name="INDIA_DLVRY_CHALLAN_ITEM">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="quantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <field name="hsnSacCode" type="text-short"/>
        <field name="estimatedValue" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.india.DeliveryChallan">
            <key-map field-name="challanId"/></relationship>
    </entity>

</entities>
