<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="IndiaTdsSection" package="zenith.erp.india" short-alias="IndiaTdsSection">
        <field name="tdsSectionId" type="id" is-pk="true"/>
        <field name="sectionCode" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="rateIndividual" type="number-decimal"/>
        <field name="rateCompany" type="number-decimal"/>
        <field name="thresholdAmount" type="number-decimal"/>
        <field name="surchargeApplicable" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <entity entity-name="IndiaTcsSection" package="zenith.erp.india" short-alias="IndiaTcsSection">
        <field name="tcsSectionId" type="id" is-pk="true"/>
        <field name="sectionCode" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="rate" type="number-decimal"/>
        <field name="thresholdAmount" type="number-decimal"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <entity entity-name="IndiaTdsTransaction" package="zenith.erp.india" short-alias="IndiaTdsTransaction">
        <field name="tdsTransactionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="deducteePartyId" type="id"/>
        <field name="tdsSectionId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="transactionDate" type="date-time"/>
        <field name="grossAmount" type="currency-precise"/>
        <field name="tdsRate" type="number-decimal"/>
        <field name="tdsAmount" type="currency-precise"/>
        <field name="netAmount" type="currency-precise"/>
        <field name="panNumber" type="text-short"/>
        <field name="challanNumber" type="text-medium"/>
        <field name="challanDate" type="date-time"/>
        <field name="statusId" type="text-short"/>
        <relationship type="one" related="zenith.erp.india.IndiaTdsSection"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="Deductee" related="mantle.party.Party">
            <key-map field-name="deducteePartyId" related="partyId"/>
        </relationship>
    </entity>

    <entity entity-name="IndiaProfessionalTaxSlab" package="zenith.erp.india" short-alias="IndiaProfessionalTaxSlab">
        <field name="ptSlabId" type="id" is-pk="true"/>
        <field name="stateCode" type="text-short"/>
        <field name="salaryFrom" type="currency-precise"/>
        <field name="salaryTo" type="currency-precise"/>
        <field name="monthlyTax" type="currency-precise"/>
        <field name="frequency" type="text-short" default="'Monthly'"/>
        <field name="effectiveFrom" type="date"/>
        <relationship type="one" related="zenith.erp.india.IndiaState"/>
    </entity>
    <entity entity-name="IndiaPartyTaxProfile" package="zenith.erp.india" short-alias="IndiaPartyTaxProfile">
        <field name="partyId" type="id" is-pk="true"/>
        <field name="tdsSectionId" type="id"/>
        <field name="panNumber" type="text-short"/>
        <field name="isMsme" type="text-indicator" default="'N'"/>
        <field name="udyamRegistrationNumber" type="text-medium"/>
        <field name="lowerDeductionCert" type="text-medium"/>
        <field name="lowerDeductionRate" type="number-decimal"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" related="zenith.erp.india.IndiaTdsSection"/>
    </entity>

</entities>
