<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Entities moved from zenith-erp-purchase to India plugin ========== -->

    <!-- GSTR-2B Reconciliation Record -->
    <entity entity-name="Gstr2bRecord" package="zenith.erp.india">
        <field name="gstr2bRecordId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="returnPeriod" type="text-short"><description>MMYYYY format e.g. 012027</description></field>
        <field name="supplierGstin" type="text-short"/>
        <field name="supplierName" type="text-medium"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="invoiceDate" type="date"/>
        <field name="invoiceType" type="text-short"><description>B2B, CDNR, ISD, IMPG, IMPS</description></field>
        <field name="taxableAmount" type="currency-amount"/>
        <field name="cgstAmount" type="currency-amount"/>
        <field name="sgstAmount" type="currency-amount"/>
        <field name="igstAmount" type="currency-amount"/>
        <field name="cessAmount" type="currency-amount"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="placeOfSupply" type="text-short"/>
        <field name="itcAvailable" type="text-indicator"/>
        <field name="matchStatus" type="text-short"/>
        <field name="matchedInvoiceId" type="id"/>
        <field name="matchDate" type="date-time"/>
        <field name="mismatchReasons" type="text-medium"/>
        <relationship type="one" title="Matched" related="mantle.account.invoice.Invoice">
            <key-map field-name="matchedInvoiceId" related="invoiceId"/></relationship>
    </entity>

    <!-- Job Work Challan -->
    <entity entity-name="JobWorkChallan" package="zenith.erp.india">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="jobWorkerPartyId" type="id"/>
        <field name="challanNumber" type="text-short"/>
        <field name="issueDate" type="date-time"/>
        <field name="expectedReturnDate" type="date-time"/>
        <field name="actualReturnDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="isDeemedSale" type="text-indicator" default="'N'"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="JobWorker" related="mantle.party.Party">
            <key-map field-name="jobWorkerPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="JobWorkChallanItem" package="zenith.erp.india">
        <field name="challanId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="issuedQuantity" type="number-decimal"/>
        <field name="returnedQuantity" type="number-decimal"/>
        <field name="scrapQuantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <relationship type="one" related="zenith.erp.india.JobWorkChallan"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- GSTR-2B Reconciliation View -->
    <view-entity entity-name="Gstr2bReconView" package="zenith.erp.india">
        <member-entity entity-alias="G2B" entity-name="zenith.erp.india.Gstr2bRecord"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="G2B" join-optional="true">
            <key-map field-name="matchedInvoiceId" related="invoiceId"/></member-entity>
        <alias entity-alias="G2B" name="gstr2bRecordId"/>
        <alias entity-alias="G2B" name="organizationPartyId"/>
        <alias entity-alias="G2B" name="returnPeriod"/>
        <alias entity-alias="G2B" name="supplierGstin"/>
        <alias entity-alias="G2B" name="supplierName"/>
        <alias entity-alias="G2B" name="invoiceNumber"/>
        <alias entity-alias="G2B" name="invoiceDate"/>
        <alias entity-alias="G2B" name="invoiceType"/>
        <alias entity-alias="G2B" name="taxableAmount"/>
        <alias entity-alias="G2B" name="igstAmount"/>
        <alias entity-alias="G2B" name="cgstAmount"/>
        <alias entity-alias="G2B" name="sgstAmount"/>
        <alias entity-alias="G2B" name="totalAmount"/>
        <alias entity-alias="G2B" name="matchStatus"/>
        <alias entity-alias="G2B" name="matchedInvoiceId"/>
        <alias entity-alias="G2B" name="mismatchReasons"/>
        <alias entity-alias="G2B" name="itcAvailable"/>
        <alias entity-alias="INV" name="bookInvoiceNumber" field="vendorInvoiceNumber"/>
        <alias entity-alias="INV" name="bookInvoiceDate" field="invoiceDate"/>
        <alias entity-alias="INV" name="bookTaxableAmount" field="totalTaxableAmount"/>
    </view-entity>

</entities>
