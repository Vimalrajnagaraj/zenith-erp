<?xml version="1.0" encoding="UTF-8"?>
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">

    <!-- Auto-TDS Deduction on AP Invoice Finalization -->
    <eeca entity="mantle.account.invoice.Invoice" on-update="true" run-on-error="false">
        <condition>
            <expression>invoiceTypeEnumId == 'InvoiceAp' &amp;&amp; statusId == 'InvoiceFinalized' &amp;&amp; oldValue?.statusId != 'InvoiceFinalized'</expression>
        </condition>
        <actions>
            <service-call name="zenith.erp.india.TdsServices.autoDeduct#TdsForInvoice" in-map="[invoiceId:invoiceId]" ignore-error="true"/>
        </actions>
    </eeca>

    <!-- TCS on Sales tracking (> 50 Lakhs) on AR Invoice Finalization -->
    <eeca entity="mantle.account.invoice.Invoice" on-update="true" run-on-error="false">
        <condition>
            <expression>invoiceTypeEnumId == 'InvoiceSales' &amp;&amp; statusId == 'InvoiceFinalized' &amp;&amp; oldValue?.statusId != 'InvoiceFinalized'</expression>
        </condition>
        <actions>
            <service-call name="zenith.erp.india.TdsServices.checkAndApply#TcsOnSales" in-map="[invoiceId:invoiceId]" ignore-error="true"/>
        </actions>
    </eeca>
    <!-- Multi-State Branch Accounting: Auto-book IGST on inter-branch internal invoices -->
    <eeca entity="mantle.account.invoice.Invoice" on-update="true" run-on-error="false">
        <condition>
            <expression>invoiceTypeEnumId == 'InvoiceSales' &amp;&amp; statusId == 'InvoiceFinalized' &amp;&amp; oldValue?.statusId != 'InvoiceFinalized'</expression>
        </condition>
        <actions>
            <!-- Call service to check if fromPartyId and toPartyId are both Internal Orgs in different states -->
            <service-call name="zenith.erp.india.GstServices.apply#CrossChargeIgst" in-map="[invoiceId:invoiceId]" ignore-error="true"/>
        </actions>
    </eeca>

</eecas>
