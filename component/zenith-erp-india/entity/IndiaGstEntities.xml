<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="IndiaState" package="zenith.erp.india" short-alias="IndiaState">
        <field name="stateCode" type="text-short" is-pk="true"/>
        <field name="stateName" type="text-medium"/>
        <field name="stateType" type="text-short"/>
        <field name="gstStateCode" type="text-short"/>
        <field name="isUnionTerritory" type="text-indicator" default="'N'"/>
    </entity>

    <entity entity-name="IndiaGstSlab" package="zenith.erp.india" short-alias="IndiaGstSlab">
        <field name="gstSlabId" type="id" is-pk="true"/>
        <field name="slabName" type="text-medium"/>
        <field name="gstRate" type="number-decimal"/>
        <field name="cgstRate" type="number-decimal"/>
        <field name="sgstRate" type="number-decimal"/>
        <field name="igstRate" type="number-decimal"/>
        <field name="cessRate" type="number-decimal" default="0"/>
        <field name="cessType" type="text-short"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <entity entity-name="IndiaHsnCode" package="zenith.erp.india" short-alias="IndiaHsnCode">
        <field name="hsnCode" type="text-short" is-pk="true"/>
        <field name="description" type="text-long"/>
        <field name="parentHsnCode" type="text-short"/>
        <field name="defaultGstSlabId" type="id"/>
        <field name="codeType" type="text-short" default="'HSN'"/>
        <relationship type="one" related="zenith.erp.india.IndiaGstSlab">
            <key-map field-name="defaultGstSlabId" related="gstSlabId"/>
        </relationship>
    </entity>

    <entity entity-name="IndiaGstin" package="zenith.erp.india" short-alias="IndiaGstin">
        <field name="gstinId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="gstin" type="text-short"/>
        <field name="gstRegistrationType" type="text-short"/>
        <field name="stateCode" type="text-short"/>
        <field name="isCompositionScheme" type="text-indicator" default="'N'"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" related="zenith.erp.india.IndiaState"/>
        <index name="IDX_GSTIN_PARTY"><index-field name="partyId"/></index>
        <index name="IDX_GSTIN_NUM" unique="true"><index-field name="gstin"/></index>
    </entity>

    <entity entity-name="IndiaGstConfig" package="zenith.erp.india" short-alias="IndiaGstConfig">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="gstin" type="text-short"/>
        <field name="legalName" type="text-medium"/>
        <field name="stateCode" type="text-short"/>
        <field name="registrationType" type="text-short"/>
        <field name="isCompositionScheme" type="text-indicator" default="'N'"/>
        <field name="compositionRate" type="number-decimal"/>
        <field name="einvoiceEnabled" type="text-indicator" default="'N'"/>
        <field name="einvoiceTurnoverThreshold" type="number-decimal" default="50000000"/>
        <field name="ewayBillThreshold" type="number-decimal" default="50000"/>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="zenith.erp.india.IndiaState"/>
    </entity>

    <entity entity-name="IndiaEinvoice" package="zenith.erp.india" short-alias="IndiaEinvoice">
        <field name="einvoiceId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="irn" type="text-long"/>
        <field name="ackNumber" type="text-medium"/>
        <field name="ackDate" type="date-time"/>
        <field name="signedQrCode" type="text-very-long"/>
        <field name="signedInvoice" type="text-very-long"/>
        <field name="statusId" type="text-short"/>
        <field name="cancelReason" type="text-medium"/>
        <field name="cancelDate" type="date-time"/>
        <field name="jsonPayload" type="text-very-long"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
    </entity>

    <entity entity-name="IndiaEwayBill" package="zenith.erp.india" short-alias="IndiaEwayBill">
        <field name="ewayBillId" type="id" is-pk="true"/>
        <field name="ewayBillNumber" type="text-medium"/>
        <field name="shipmentId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="supplyType" type="text-short"/>
        <field name="docType" type="text-short"/>
        <field name="fromStateCode" type="text-short"/>
        <field name="toStateCode" type="text-short"/>
        <field name="transportMode" type="text-short"/>
        <field name="transporterId" type="text-medium"/>
        <field name="vehicleNumber" type="text-short"/>
        <field name="vehicleType" type="text-short"/>
        <field name="validFrom" type="date-time"/>
        <field name="validUpto" type="date-time"/>
        <field name="statusId" type="text-short"/>
        <field name="jsonPayload" type="text-very-long"/>
        <relationship type="one" related="mantle.shipment.Shipment"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
    </entity>

    <entity entity-name="IndiaApiConfig" package="zenith.erp.india" short-alias="IndiaApiConfig">
        <field name="configId" type="id" is-pk="true"/>
        <field name="apiType" type="text-short"/> <!-- EINVOICE, EWAYB -->
        <field name="environment" type="text-short" default="'SANDBOX'"/> <!-- SANDBOX, PRODUCTION -->
        <field name="clientId" type="text-medium"/>
        <field name="clientSecret" type="text-long"/>
        <field name="username" type="text-medium"/>
        <field name="password" type="text-long"/>
        <field name="baseUrl" type="text-medium"/>
        <field name="tokenUrl" type="text-medium"/>
        <field name="currentToken" type="text-very-long"/>
        <field name="tokenExpiry" type="date-time"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

</entities>
