<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== India-specific HR/Payroll entities moved from core ========== -->

    <!-- Professional Tax Slab (State-wise) -->
    <entity entity-name="ProfessionalTaxSlab" package="zenith.erp.india" short-alias="ProfessionalTaxSlabs">
        <field name="professionalTaxSlabId" type="id" is-pk="true"/>
        <field name="stateCode" type="text-short"/>
        <field name="fromAmount" type="currency-amount"/>
        <field name="toAmount" type="currency-amount"/>
        <field name="monthlyTax" type="currency-amount"/>
        <field name="februaryTax" type="currency-amount"/>
        <field name="isActive" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.india.IndiaState">
            <key-map field-name="stateCode"/></relationship>
    </entity>

    <!-- Income Tax Slab -->
    <entity entity-name="IncomeTaxSlab" package="zenith.erp.india" short-alias="IncomeTaxSlabs">
        <field name="incomeTaxSlabId" type="id" is-pk="true"/>
        <field name="regime" type="text-short"/>
        <field name="financialYear" type="text-short"/>
        <field name="fromAmount" type="currency-amount"/>
        <field name="toAmount" type="currency-amount"/>
        <field name="taxRatePercent" type="number-decimal"/>
        <field name="isActive" type="text-indicator"/>
    </entity>

    <!-- Employee Income Tax Declaration (Old Regime Deductions) -->
    <entity entity-name="IncomeTaxDeclaration" package="zenith.erp.india" short-alias="IncomeTaxDeclarations">
        <field name="declarationId" type="id" is-pk="true"/>
        <field name="employeeId" type="id"/>
        <field name="financialYear" type="text-short"/>
        <field name="selectedRegime" type="text-short"/>
        <field name="section80c" type="currency-amount"/>
        <field name="section80d" type="currency-amount"/>
        <field name="section80e" type="currency-amount"/>
        <field name="section80g" type="currency-amount"/>
        <field name="section80tta" type="currency-amount"/>
        <field name="hraExemptionClaimed" type="currency-amount"/>
        <field name="ltaExemptionClaimed" type="currency-amount"/>
        <field name="homeLoanInterest" type="currency-amount"/>
        <field name="npsContribution" type="currency-amount"/>
        <field name="otherExemptions" type="currency-amount"/>
        <field name="isVerified" type="text-indicator"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <!-- ========== EPF Configuration ========== -->
    <entity entity-name="EpfConfiguration" package="zenith.erp.india" short-alias="EpfConfigurations">
        <field name="epfConfigId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="establishmentCode" type="text-short"/>
        <field name="epfNumber" type="text-short"/>
        <field name="employeeContributionPercent" type="number-decimal" default="12"/>
        <field name="employerContributionPercent" type="number-decimal" default="12"/>
        <field name="pensionFundPercent" type="number-decimal" default="8.33"/>
        <field name="epfAdminChargesPercent" type="number-decimal" default="0.50"/>
        <field name="edliChargesPercent" type="number-decimal" default="0.50"/>
        <field name="wagesCeiling" type="currency-amount" default="15000"><description>Basic wages ceiling for EPF</description></field>
        <field name="pensionWagesCeiling" type="currency-amount" default="15000"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== ESI Configuration ========== -->
    <entity entity-name="EsiConfiguration" package="zenith.erp.india" short-alias="EsiConfigurations">
        <field name="esiConfigId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="esiCode" type="text-short"/>
        <field name="employeeContributionPercent" type="number-decimal" default="0.75"/>
        <field name="employerContributionPercent" type="number-decimal" default="3.25"/>
        <field name="grossWagesCeiling" type="currency-amount" default="21000"><description>ESI applicable if gross is at or below this ceiling</description></field>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- ========== Employee Statutory Details (India-specific) ========== -->
    <entity entity-name="EmployeeStatutoryDetail" package="zenith.erp.india" short-alias="EmployeeStatutoryDetails">
        <field name="employeeId" type="id" is-pk="true"/>
        <field name="panNumber" type="text-short"/>
        <field name="aadhaarNumber" type="text-short"/>
        <field name="uanNumber" type="text-short"><description>Universal Account Number for EPF</description></field>
        <field name="pfNumber" type="text-short"/>
        <field name="esiNumber" type="text-short"/>
        <field name="isPfApplicable" type="text-indicator" default="'Y'"/>
        <field name="isEsiApplicable" type="text-indicator" default="'Y'"/>
        <field name="isPtApplicable" type="text-indicator" default="'Y'"/>
        <field name="pfWages" type="currency-amount"><description>PF contribution base (if different from basic)</description></field>
        <field name="voluntaryPfPercent" type="number-decimal"><description>Additional voluntary PF %</description></field>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <!-- ========== Statutory Contribution Record (per payslip) ========== -->
    <entity entity-name="StatutoryContribution" package="zenith.erp.india" short-alias="StatutoryContributions">
        <field name="contributionId" type="id" is-pk="true"/>
        <field name="payslipId" type="id"/>
        <field name="employeeId" type="id"/>
        <field name="periodYear" type="number-integer"/>
        <field name="periodMonth" type="number-integer"/>
        <field name="basicPay" type="currency-amount"/>
        <field name="grossPay" type="currency-amount"/>
        <!-- EPF -->
        <field name="epfWages" type="currency-amount"/>
        <field name="epfEmployeeAmount" type="currency-amount"/>
        <field name="epfEmployerPfAmount" type="currency-amount"><description>Employer PF (3.67%)</description></field>
        <field name="epfEmployerPensionAmount" type="currency-amount"><description>Employer Pension (8.33%)</description></field>
        <field name="epfAdminCharges" type="currency-amount"/>
        <field name="edliCharges" type="currency-amount"/>
        <!-- ESI -->
        <field name="esiEmployeeAmount" type="currency-amount"/>
        <field name="esiEmployerAmount" type="currency-amount"/>
        <!-- PT -->
        <field name="professionalTaxAmount" type="currency-amount"/>
        <field name="stateCode" type="text-short"/>
        <!-- TDS -->
        <field name="incomeTaxAmount" type="currency-amount"/>
        <relationship type="one" related="zenith.erp.payroll.Payslip"/>
        <relationship type="one" related="zenith.erp.hr.Employee"/>
    </entity>

    <!-- ========== Statutory Contribution View ========== -->
    <view-entity entity-name="StatutoryContributionView" package="zenith.erp.india">
        <member-entity entity-alias="SC" entity-name="zenith.erp.india.StatutoryContribution"/>
        <member-entity entity-alias="EMP" entity-name="zenith.erp.hr.Employee" join-from-alias="SC">
            <key-map field-name="employeeId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="EMP">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ESD" entity-name="zenith.erp.india.EmployeeStatutoryDetail" join-from-alias="SC" join-optional="true">
            <key-map field-name="employeeId"/></member-entity>
        <!-- ZE-DF-001 f/u (IV-110): expose the payslip's paid/LOP days so the ECR (NCP Days) and ESIC (No of
             Days) exports can populate them instead of leaving them blank/0. join-optional: a contribution may
             predate the payslip link. -->
        <member-entity entity-alias="PSL" entity-name="zenith.erp.payroll.Payslip" join-from-alias="SC" join-optional="true">
            <key-map field-name="payslipId"/></member-entity>
        <alias-all entity-alias="SC"/>
        <alias entity-alias="EMP" name="employeeCode"/>
        <alias entity-alias="EMP" name="organizationPartyId"/>
        <alias entity-alias="PER" name="firstName"/>
        <alias entity-alias="PER" name="lastName"/>
        <alias entity-alias="ESD" name="uanNumber"/>
        <alias entity-alias="ESD" name="pfNumber"/>
        <alias entity-alias="ESD" name="esiNumber"/>
        <alias entity-alias="ESD" name="panNumber"/>
        <alias entity-alias="PSL" name="paidDays"/>
        <alias entity-alias="PSL" name="lwpDays"/>
    </view-entity>

</entities>
