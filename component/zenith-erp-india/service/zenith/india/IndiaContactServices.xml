<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== India-specific Contact Services (moved from core zenith-erp-contacts) ========== -->

    <service verb="add" noun="ContactGstin">
        <description>Add a GSTIN record to a contact (India-specific)</description>
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="gstin" required="true"/>
            <parameter name="gstRegistrationType" default-value="Regular"/>
            <parameter name="stateCode"/>
        </in-parameters>
        <actions>
            <service-call name="zenith.india.GstServices.validate#Gstin" in-map="[gstin:gstin]" out-map="gstinResult"/>
            <if condition="!gstinResult.isValid">
                <return error="true" message="Invalid GSTIN: ${gstinResult.validationMessage}"/>
            </if>
            <set field="derivedStateCode" from="stateCode ?: gstin.substring(0,2)"/>
            <service-call name="create#zenith.erp.india.IndiaGstin"
                          in-map="[partyId:partyId, gstin:gstin, gstRegistrationType:gstRegistrationType,
                                   stateCode:derivedStateCode, isCompositionScheme:(gstRegistrationType == 'Composition' ? 'Y' : 'N')]"/>

            <!-- Also create a TaxRegistration record for the generic system -->
            <service-call name="zenith.tax.TaxServices.create#TaxRegistration" ignore-error="true"
                          in-map="[partyId:partyId, taxAuthorityId:'IND_NATIONAL',
                                   registrationTypeEnumId:'TrtGstin',
                                   registrationNumber:gstin, regionGeoId:derivedStateCode]"/>
        </actions>
    </service>

    <service verb="create" noun="IndiaContact">
        <description>Create a contact with India-specific fields (wraps generic create#Contact)</description>
        <in-parameters>
            <parameter name="partyTypeEnumId" required="true"/>
            <parameter name="organizationName"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="roleTypeId" default-value="Customer"/>
            <parameter name="emailAddress"/>
            <parameter name="countryCode" default-value="91"/>
            <parameter name="contactNumber"/>
            <parameter name="gstin"/>
            <parameter name="gstRegistrationType" default-value="Regular"/>
            <parameter name="panNumber"/>
            <parameter name="msmeUdyamNumber"/>
            <parameter name="tdsApplicable" default-value="N"/>
            <parameter name="defaultTdsSectionId"/>
            <parameter name="stateCode"/>
        </in-parameters>
        <out-parameters>
            <parameter name="partyId"/>
        </out-parameters>
        <actions>
            <!-- Create the generic contact -->
            <service-call name="zenith.contacts.ContactServices.create#Contact" out-map="context"
                          in-map="[partyTypeEnumId:partyTypeEnumId, organizationName:organizationName,
                                   firstName:firstName, lastName:lastName, roleTypeId:roleTypeId,
                                   emailAddress:emailAddress, countryCode:countryCode,
                                   contactNumber:contactNumber, countryGeoId:'IND',
                                   regionGeoId:stateCode]"/>

            <!-- Set India-specific fields on Party extend-entity -->
            <service-call name="update#mantle.party.Party"
                          in-map="[partyId:partyId, panNumber:panNumber,
                                   gstRegistrationType:gstRegistrationType,
                                   msmeUdyamNumber:msmeUdyamNumber, tdsApplicable:tdsApplicable,
                                   defaultTdsSectionId:defaultTdsSectionId]"/>

            <!-- Create GSTIN if provided -->
            <if condition="gstin">
                <service-call name="zenith.india.IndiaContactServices.add#ContactGstin"
                              in-map="[partyId:partyId, gstin:gstin, gstRegistrationType:gstRegistrationType,
                                       stateCode:stateCode]" ignore-error="true"/>
            </if>

            <!-- Store PAN as party identification -->
            <if condition="panNumber">
                <service-call name="create#mantle.party.PartyIdentification"
                              in-map="[partyId:partyId, partyIdTypeEnumId:'PtidTaxId', idValue:panNumber]"/>
            </if>
        </actions>
    </service>

</services>
