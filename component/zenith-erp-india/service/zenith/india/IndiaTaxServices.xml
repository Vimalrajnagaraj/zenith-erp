<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== INDIA TAX CALCULATION — implements zenith.tax.TaxServices.calculate#Tax interface ========== -->

    <service verb="calculate" noun="Tax">
        <description>India-specific tax calculation implementing the generic calculate#Tax interface.
            Determines CGST+SGST (intra-state) or IGST (inter-state) plus cess.
            Dispatched via CompanySettings key TAX_CALCULATION_SERVICE.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="customerPartyId"/>
            <parameter name="items" type="List" required="true">
                <parameter name="itemEntry" type="Map">
                    <parameter name="productId"/>
                    <parameter name="productTaxCode"/>
                    <parameter name="taxCategoryId"/>
                    <parameter name="quantity" type="BigDecimal" required="true"/>
                    <parameter name="unitAmount" type="BigDecimal" required="true"/>
                    <parameter name="discountAmount" type="BigDecimal"/>
                    <parameter name="isTaxInclusive" default-value="N"/>
                </parameter>
            </parameter>
            <parameter name="originRegionGeoId"/>
            <parameter name="destinationRegionGeoId"/>
            <parameter name="originCountryGeoId"/>
            <parameter name="destinationCountryGeoId"/>
            <parameter name="currencyUomId"/>
            <parameter name="transactionDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="transactionType" default-value="SALE"/>
            <parameter name="isReverseCharge" default-value="N"/>
            <parameter name="isSezSupply" default-value="N"/>
            <parameter name="isWithPayment" default-value="N">
                <description>For export/SEZ: supplied WITH payment of IGST (Y) vs under LUT/Bond at 0% (N, default)</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="taxedItems" type="List"/>
            <parameter name="totalTaxableAmount" type="BigDecimal"/>
            <parameter name="totalTaxAmount" type="BigDecimal"/>
            <parameter name="totalAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <service-call name="zenith.tax.TaxAccessServices.assert#Organization" in-map="context" out-map="context"/>
            <service-call name="zenith.tax.TaxAccessServices.assert#Subject" in-map="[organizationPartyId:organizationPartyId,partyId:customerPartyId]"/>
            <iterate list="items" entry="taxInput"><service-call name="zenith.tax.TaxAccessServices.assert#Subject" in-map="[organizationPartyId:organizationPartyId,productId:taxInput.productId]"/></iterate>
            <!-- Resolve seller state code -->
            <set field="supplierStateCode" from="originRegionGeoId"/>
            <if condition="!supplierStateCode">
                <entity-find entity-name="zenith.erp.india.IndiaGstConfig" list="gstConfigs" limit="1">
                    <econdition field-name="organizationPartyId"/>
                </entity-find>
                <set field="supplierStateCode" from="gstConfigs ? gstConfigs[0].stateCode : null"/>
            </if>

            <!-- Resolve buyer state code -->
            <set field="buyerStateCode" from="destinationRegionGeoId"/>
            <if condition="!buyerStateCode &amp;&amp; customerPartyId">
                <service-call name="zenith.tax.TaxServices.get#PartyTaxRegistration" in-map="[partyId:customerPartyId,countryGeoId:'IND',registrationTypeEnumId:'TrtGstin']" out-map="buyerRegistration"/>
                <set field="buyerStateCode" from="buyerRegistration.regionGeoId ?: (buyerRegistration.registrationNumber?.length() == 15 ? buyerRegistration.registrationNumber.substring(0,2) : null)"/>
            </if>
            <if condition="!buyerStateCode">
                <set field="buyerStateCode" from="supplierStateCode"/>
            </if>

            <!-- SEZ comes from the isSezSupply input (can't be inferred from country). Export is inferred
                 from a non-India destination country. Both are zero-rated (LUT 0% unless isWithPayment=Y). -->
            <set field="isExport" value="N"/>
            <if condition="destinationCountryGeoId &amp;&amp; destinationCountryGeoId != 'IND'">
                <set field="isExport" value="Y"/>
            </if>

            <!-- Composition dealer: sells under the composition scheme, issues a Bill of Supply, and pays
                 a fixed composition tax out of its own pocket. It must NOT charge GST to the customer, so
                 every line is zero-tax here. (No-op for Regular dealers — MARUTHI is Regular.) -->
            <entity-find entity-name="zenith.erp.india.IndiaGstConfig" list="orgGstCfg" limit="1">
                <econdition field-name="organizationPartyId"/>
            </entity-find>
            <!-- For a Purchase the organization is the buyer; its scheme cannot zero the supplier's GST.
                 Supplier composition is carried by the stored Purchase bill and handled by its line service. -->
            <set field="isComposition" from="transactionType != 'PURCHASE' &amp;&amp; orgGstCfg &amp;&amp; orgGstCfg[0].isCompositionScheme == 'Y'"/>

            <!-- Process each item -->
            <set field="taxedItems" from="[]"/>
            <set field="totalTaxableAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="totalTaxAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="totalAmount" from="BigDecimal.ZERO" type="BigDecimal"/>
            <set field="itemIndex" from="0" type="Integer"/>

            <iterate list="items" entry="item">
                <!-- Reject invalid line amounts before any tax is calculated. -->
                <if condition="item.quantity == null || item.unitAmount == null || item.quantity &lt; 0 || item.unitAmount &lt; 0 || (item.discountAmount ?: 0) &lt; 0 || (item.discountAmount ?: 0) &gt; item.quantity * item.unitAmount">
                    <return error="true" message="Quantity, price and discount must be non-negative; discount cannot exceed the line amount."/>
                </if>
                <!-- Calculate line amount -->
                <set field="lineAmount" from="((item.quantity ?: 0) as BigDecimal) * ((item.unitAmount ?: 0) as BigDecimal)" type="BigDecimal"/>
                <set field="lineDiscount" from="(item.discountAmount ?: 0) as BigDecimal"/>
                <set field="taxableAmount" from="lineAmount - lineDiscount" type="BigDecimal"/>

                <!-- Composition dealer collects no GST from the customer (Bill of Supply). -->
                <if condition="isComposition">
                    <script>taxedItems.add([itemIndex:itemIndex, taxableAmount:taxableAmount,
                        totalTaxAmount:BigDecimal.ZERO, taxBreakdowns:[]])</script>
                    <set field="totalTaxableAmount" from="totalTaxableAmount + taxableAmount"/>
                    <set field="totalAmount" from="totalAmount + taxableAmount"/>
                    <set field="itemIndex" from="itemIndex + 1"/>
                    <continue/>
                </if>

                <!-- The explicit product exemption always wins over caller-supplied slab/HSN. -->
                <set field="product" from="null"/>
                <if condition="item.productId">
                    <entity-find-one entity-name="mantle.product.Product" value-field="product"><field-map field-name="productId" from="item.productId"/></entity-find-one>
                </if>
                <!-- Resolve GST slab from productTaxCode (HSN) or taxCategoryId or product -->
                <set field="gstSlabId" from="item.taxCategoryId"/>
                <if condition="!gstSlabId &amp;&amp; item.productTaxCode">
                    <entity-find-one entity-name="zenith.erp.india.IndiaHsnCode" value-field="hsnRecord">
                        <field-map field-name="hsnCode" from="item.productTaxCode"/>
                    </entity-find-one>
                    <set field="gstSlabId" from="hsnRecord?.defaultGstSlabId"/>
                </if>
                <if condition="!gstSlabId &amp;&amp; item.productId">
                    <entity-find-one entity-name="mantle.product.Product" value-field="product">
                        <field-map field-name="productId" from="item.productId"/>
                    </entity-find-one>
                    <!-- Explicit GST-exempt flag wins -->
                    <if condition="product?.isGstExempt == 'Y'"><set field="gstSlabId" value="GST_EXEMPT"/></if>
                    <!-- Native product GST slab (set via product screen), else generic tax category -->
                    <if condition="!gstSlabId"><set field="gstSlabId" from="product?.gstSlabId ?: product?.taxCategoryId"/></if>
                    <!-- Native HSN code (set via product screen), else generic tax code -> HSN master -> slab -->
                    <if condition="!gstSlabId &amp;&amp; (product?.hsnCode ?: product?.productTaxCode)">
                        <entity-find-one entity-name="zenith.erp.india.IndiaHsnCode" value-field="hsnRec2">
                            <field-map field-name="hsnCode" from="product.hsnCode ?: product.productTaxCode"/>
                        </entity-find-one>
                        <set field="gstSlabId" from="hsnRec2?.defaultGstSlabId"/>
                    </if>
                </if>

                <if condition="product?.isGstExempt == 'Y'"><set field="gstSlabId" value="GST_EXEMPT"/></if>
                <if condition="!gstSlabId">
                    <!-- No GST slab found — zero tax -->
                    <script>taxedItems.add([itemIndex:itemIndex, taxableAmount:taxableAmount,
                        totalTaxAmount:BigDecimal.ZERO, taxBreakdowns:[]])</script>
                    <set field="totalTaxableAmount" from="totalTaxableAmount + taxableAmount"/>
                    <set field="totalAmount" from="totalAmount + taxableAmount"/>
                    <set field="itemIndex" from="itemIndex + 1"/>
                    <continue/>
                </if>

                <!-- Resolve the actually collected rates, including cess and zero-tax flags. -->
                <set field="inclusiveAmount" from="taxableAmount"/>
                <if condition="item.isTaxInclusive == 'Y'">
                    <service-call name="zenith.india.GstServices.calculate#Gst"
                        in-map="[supplierStateCode:supplierStateCode, buyerStateCode:buyerStateCode, gstSlabId:gstSlabId,
                            taxableAmount:100, isSezSupply:isSezSupply, isExport:isExport,
                            isWithPayment:isWithPayment, isReverseCharge:isReverseCharge]" out-map="rateResult"/>
                    <set field="taxableAmount" from="(inclusiveAmount * 100 / (100 + ['cgst','sgst','igst','cess'].sum { rateResult[it + 'Amount'] &gt; 0 ? rateResult[it + 'Rate'] : 0 })).setScale(2, java.math.RoundingMode.HALF_UP)"/>
                </if>

                <!-- Calculate GST using existing engine -->
                <service-call name="zenith.india.GstServices.calculate#Gst"
                              in-map="[supplierStateCode:supplierStateCode, buyerStateCode:buyerStateCode,
                                       gstSlabId:gstSlabId, taxableAmount:taxableAmount,
                                       isSezSupply:isSezSupply, isExport:isExport,
                                       isWithPayment:isWithPayment, isReverseCharge:isReverseCharge]"
                              out-map="gstResult"/>

                <if condition="item.isTaxInclusive == 'Y'">
                    <script><![CDATA[
                        // Assign the rounding residual to the final collected component. The
                        // inclusive price is authoritative; never increase/decrease it by a paisa.
                        def targetTax = inclusiveAmount.setScale(2, java.math.RoundingMode.HALF_UP) - taxableAmount
                        def collected = ['cgstAmount','sgstAmount','igstAmount','cessAmount'].findAll { gstResult[it] > 0 }
                        if (collected) {
                            def last = collected[-1]
                            gstResult[last] += targetTax - gstResult.totalTaxAmount
                        }
                        gstResult.totalTaxAmount = targetTax
                    ]]></script>
                </if>

                <!-- Build generic tax breakdowns -->
                <set field="breakdowns" from="[]"/>
                <if condition="(gstResult.cgstRate ?: 0) &gt; 0">
                    <script>breakdowns.add([taxName:'CGST', taxRate:gstResult.cgstRate,
                        taxableAmount:taxableAmount, taxAmount:gstResult.cgstAmount,
                        taxAuthorityId:'IND_CENTRAL', countryGeoId:'IND',
                        regionGeoId:supplierStateCode, isIncludedInPrice:item.isTaxInclusive])</script>
                </if>
                <if condition="(gstResult.sgstRate ?: 0) &gt; 0">
                    <script>breakdowns.add([taxName:'SGST', taxRate:gstResult.sgstRate,
                        taxableAmount:taxableAmount, taxAmount:gstResult.sgstAmount,
                        taxAuthorityId:'IND_' + supplierStateCode, countryGeoId:'IND',
                        regionGeoId:supplierStateCode, isIncludedInPrice:item.isTaxInclusive])</script>
                </if>
                <if condition="(gstResult.igstRate ?: 0) &gt; 0">
                    <script>breakdowns.add([taxName:'IGST', taxRate:gstResult.igstRate,
                        taxableAmount:taxableAmount, taxAmount:gstResult.igstAmount,
                        taxAuthorityId:'IND_CENTRAL', countryGeoId:'IND',
                        isIncludedInPrice:item.isTaxInclusive])</script>
                </if>
                <if condition="(gstResult.cessRate ?: 0) &gt; 0">
                    <script>breakdowns.add([taxName:'CESS', taxRate:gstResult.cessRate,
                        taxableAmount:taxableAmount, taxAmount:gstResult.cessAmount,
                        taxAuthorityId:'IND_CENTRAL', countryGeoId:'IND',
                        isIncludedInPrice:item.isTaxInclusive])</script>
                </if>

                <set field="itemTotalTax" from="gstResult.totalTaxAmount ?: BigDecimal.ZERO" type="BigDecimal"/>

                <script>taxedItems.add([itemIndex:itemIndex, taxableAmount:taxableAmount,
                    totalTaxAmount:itemTotalTax, taxBreakdowns:breakdowns])</script>

                <set field="totalTaxableAmount" from="totalTaxableAmount + taxableAmount"/>
                <set field="totalTaxAmount" from="totalTaxAmount + itemTotalTax"/>
                <set field="totalAmount" from="totalAmount + taxableAmount + itemTotalTax"/>
                <set field="itemIndex" from="itemIndex + 1"/>
            </iterate>
        </actions>
    </service>

</services>
