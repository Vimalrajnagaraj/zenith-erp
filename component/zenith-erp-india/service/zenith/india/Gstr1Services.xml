<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="generate" noun="Gstr1Data">
        <description>Aggregate all sales invoices for a return period into GSTR-1 format</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="returnPeriod" required="true"/> <!-- MMYYYY -->
        </in-parameters>
        <out-parameters>
            <parameter name="filingId"/>
        </out-parameters>
        <actions>
            <!-- Mock implementation for demo purposes -->
            <entity-make-value entity-name="zenith.erp.india.gstr1.Gstr1Filing" value-field="filing"/>
            <set field="filing.organizationPartyId" from="organizationPartyId"/>
            <set field="filing.returnPeriod" from="returnPeriod"/>
            <set field="filing.filingDate" from="ec.user.nowTimestamp"/>
            <set field="filing.statusId" value="DRAFT"/>
            <entity-create value-field="filing"/>
            <set field="filingId" from="filing.filingId"/>

            <!-- In a real implementation, we would query Invoice and InvoiceItem, 
                 group by B2B/B2C, Export, HSN, and insert into the respective GSTR1 entities -->
            
            <service-call name="zenith.india.Gstr1Services.generate#Gstr1HsnSummary" in-map="[filingId:filingId]"/>
        </actions>
    </service>

    <service verb="generate" noun="Gstr1HsnSummary">
        <in-parameters>
            <parameter name="filingId" required="true"/>
        </in-parameters>
        <actions>
            <!-- Mock HSN Summary Generation -->
        </actions>
    </service>

    <service verb="export" noun="Gstr1Json">
        <in-parameters>
            <parameter name="filingId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="jsonPayload"/>
        </out-parameters>
        <actions>
            <!-- Mock JSON generation matching the GSTN schema -->
            <set field="jsonPayload" value="{&quot;gstin&quot;:&quot;MOCKGSTIN&quot;,&quot;fp&quot;:&quot;042023&quot;,&quot;b2b&quot;:[],&quot;b2cs&quot;:[],&quot;hsn&quot;:[]}"/>
        </actions>
    </service>

</services>
