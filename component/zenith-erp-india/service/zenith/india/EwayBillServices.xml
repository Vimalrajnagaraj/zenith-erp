<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="authenticate" noun="EwayBillApi">
        <description>Authenticate with E-Way Bill Portal Sandbox/Production</description>
        <in-parameters>
            <parameter name="configId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="authToken"/>
            <parameter name="sek"/>
        </out-parameters>
        <actions><return error="true" message="Government API integration is unavailable. No statutory document or token has been generated or changed."/></actions>
    </service>

    <service verb="generate" noun="EwayBill">
        <description>Generate JSON Payload and push to EWB Portal</description>
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
            <parameter name="transporterId"/>
            <parameter name="transporterName"/>
            <parameter name="vehicleNumber"/>
            <parameter name="distanceKm" type="Long"/>
            <parameter name="transportMode" default-value="1"/> <!-- 1-Road, 2-Rail, 3-Air, 4-Ship -->
        </in-parameters>
        <out-parameters>
            <parameter name="ewayBillId"/>
            <parameter name="ewayBillNumber"/>
            <parameter name="validUpto" type="Timestamp"/>
        </out-parameters>
        <actions><return error="true" message="Government API integration is unavailable. No statutory document or token has been generated or changed."/></actions>
    </service>

    <service verb="update" noun="EwayBillPartB">
        <in-parameters>
            <parameter name="ewayBillNumber" required="true"/>
            <parameter name="vehicleNumber" required="true"/>
            <parameter name="transporterId"/>
        </in-parameters>
        <actions><return error="true" message="Government API integration is unavailable. No statutory document or token has been generated or changed."/></actions>
    </service>

    <service verb="cancel" noun="EwayBill">
        <in-parameters>
            <parameter name="ewayBillNumber" required="true"/>
            <parameter name="cancelReason" required="true"/>
        </in-parameters>
        <actions><return error="true" message="Government API integration is unavailable. No statutory document or token has been generated or changed."/></actions>
    </service>

    <service verb="extend" noun="EwayBillValidity">
        <in-parameters>
            <parameter name="ewayBillNumber" required="true"/>
            <parameter name="extendReason" required="true"/>
            <parameter name="remainingDistance" type="Long" required="true"/>
        </in-parameters>
        <actions><return error="true" message="Government API integration is unavailable. No statutory document or token has been generated or changed."/></actions>
    </service>

    <service verb="calculate" noun="EwayBillDistance">
        <in-parameters>
            <parameter name="fromPincode" required="true"/>
            <parameter name="toPincode" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="distanceKm" type="Long"/>
        </out-parameters>
        <actions><return error="true" message="PIN-to-PIN distance integration is unavailable. Enter a verified transport distance."/></actions>
    </service>

    <service verb="check" noun="EwayBillRequired">
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="isRequired"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
            <if condition="!invoice"><return error="true" message="Invoice not found."/></if>
            <service-call name="zenith.india.GstServices.get#ChargedInvoiceTax" in-map="context" out-map="invoiceTax"/>
            <set field="total" from="invoiceTax.taxable + invoiceTax.cgst + invoiceTax.sgst + invoiceTax.igst + invoiceTax.cess"/>
            <script>
                isRequired = total > 50000 ? "Y" : "N"
            </script>
        </actions>
    </service>

</services>
