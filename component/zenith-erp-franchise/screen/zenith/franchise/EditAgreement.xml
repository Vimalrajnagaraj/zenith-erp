<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit Agreement" default-menu-include="false">

    <parameter name="agreementId" required="true"/>

    <transition name="updateAgreement">
        <service-call name="update#zenith.erp.franchise.FranchiseAgreement"/>
        <default-response url="."/>
    </transition>
    <transition name="calculateRoyalty">
        <service-call name="zenith.franchise.FranchiseServices.calculate#Royalty"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.franchise.FranchiseAgreement" value-field="agreement"/>
        <entity-find entity-name="zenith.erp.franchise.RoyaltyCalculation" list="royalties">
            <econdition field-name="agreementId"/>
            <order-by field-name="-periodStart"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.franchise.FranchiseCompliance" list="audits">
            <econdition field-name="agreementId"/>
            <order-by field-name="-auditDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Franchise Agreement: ${agreementId}" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container-row>
            <row-col lg="8" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <label text="Agreement Details" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-single name="AgreementForm" map="agreement" transition="updateAgreement">
                        <field name="agreementId"><default-field><hidden/></default-field></field>
                        <field name="franchiseePartyId"><default-field title="Franchisee">
                            <display-entity entity-name="mantle.party.Organization" key-field-name="partyId" text="${organizationName}"/>
                        </default-field></field>
                        <field name="storeId"><default-field title="Store">
                            <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                        </default-field></field>
                        <field name="royaltyTypeEnumId"><default-field title="Royalty Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="RoyaltyType"/>
                                </entity-find>
                            </entity-options></drop-down></default-field></field>
                        <field name="royaltyRate"><default-field title="Rate %"><text-line size="8"/></default-field></field>
                        <field name="fixedRoyalty"><default-field title="Fixed Royalty"><text-line size="12"/></default-field></field>
                        <field name="marketingFeePercent"><default-field title="Marketing Fee %"><text-line size="8"/></default-field></field>
                        <field name="territory"><default-field><text-line size="25"/></default-field></field>
                        <field name="exclusiveTerritory"><default-field title="Exclusive?">
                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                        </default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down>
                                <entity-options key="${toStatusId}" text="${transitionName}">
                                    <entity-find entity-name="moqui.basic.StatusFlowTransition">
                                        <econdition field-name="statusFlowId" value="Default"/>
                                        <econdition field-name="statusId" from="agreement.statusId"/>
                                    </entity-find>
                                </entity-options>
                                <option key="${agreement.statusId}" text="${agreement.statusId}"/>
                            </drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
                    </form-single>
                </container>

                <!-- Royalty History -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md">
                    <container style="row items-center justify-between q-mb-md">
                        <label text="Royalty Calculations" type="h5" style="text-weight-bold q-my-none"/>
                        <container-dialog id="CalcRoyalty" button-text="Calculate" type="info">
                            <form-single name="CalcRoyaltyForm" transition="calculateRoyalty">
                                <field name="agreementId" from="agreement.agreementId"><default-field><hidden/></default-field></field>
                                <field name="periodStart"><default-field><date-time type="date"/></default-field></field>
                                <field name="periodEnd"><default-field><date-time type="date"/></default-field></field>
                                <field name="submitBtn"><default-field title="Calculate"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                    <form-list name="RoyaltiesForm" list="royalties" skip-form="true">
                        <field name="periodStart"><default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="periodEnd"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="salesAmount"><default-field title="Sales"><display format="#,##0.00"/></default-field></field>
                        <field name="royaltyAmount"><default-field title="Royalty"><display format="#,##0.00"/></default-field></field>
                        <field name="totalDue"><default-field title="Total Due"><display format="#,##0.00"/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display/></default-field></field>
                    </form-list>
                </container>

                <!-- Compliance Audits -->
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="Compliance Audits" type="h5" style="text-weight-bold q-mb-md"/>
                    <form-list name="AuditsForm" list="audits" skip-form="true">
                        <field name="auditDate"><default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                        <field name="auditorName"><default-field title="Auditor"><display/></default-field></field>
                        <field name="overallScore"><default-field title="Score"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status"><display/></default-field></field>
                    </form-list>
                </container>
            </row-col>

            <row-col lg="4" md="12">
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Status" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${agreement.statusId}" type="h5" style="text-primary text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-md text-center">
                    <label text="Royalty Rate" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${agreement.royaltyRate ?: 0}%" type="h4" style="text-dark text-weight-bold q-my-sm"/>
                </container>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg text-center">
                    <label text="Contract Period" type="p" style="text-grey-7 text-uppercase text-weight-bold q-mb-xs"/>
                    <label text="${ec.l10n.format(agreement.startDate, 'MMM yyyy')} - ${agreement.endDate ? ec.l10n.format(agreement.endDate, 'MMM yyyy') : 'Open'}"
                           type="h6" style="text-dark text-weight-bold q-my-sm"/>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
