<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Compliance" default-menu-index="3">

    <transition name="createAudit">
        <service-call name="zenith.franchise.FranchiseServices.create#ComplianceAudit"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owning FranchiseAgreement -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.franchise.FranchiseAgreement" list="_expOwnerRows"><econdition field-name="franchisorPartyId" from="_expOrg"/><select-field field-name="agreementId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.agreementId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.franchise.FranchiseCompliance" list="audits">
            <search-form-inputs default-order-by="-auditDate"/>
            <econdition field-name="agreementId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Compliance Audits" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="NewAudit" button-text="New Audit" type="success">
                <form-single name="NewAuditForm" transition="createAudit">
                    <field name="agreementId"><default-field title="Agreement">
                        <drop-down><entity-options key="${agreementId}" text="${agreementId}">
                            <entity-find entity-name="zenith.erp.franchise.FranchiseAgreement">
                                <econdition field-name="statusId" value="FaActive"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store">
                                <econdition field-name="storeTypeEnumId" value="StFranchise"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="auditDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="auditorName"><default-field><text-line size="20"/></default-field></field>
                    <field name="brandingScore"><default-field title="Branding (0-100)"><text-line size="5"/></default-field></field>
                    <field name="cleanlinessScore"><default-field title="Cleanliness (0-100)"><text-line size="5"/></default-field></field>
                    <field name="serviceScore"><default-field title="Service (0-100)"><text-line size="5"/></default-field></field>
                    <field name="inventoryScore"><default-field title="Inventory (0-100)"><text-line size="5"/></default-field></field>
                    <field name="findings"><default-field><text-area rows="3" cols="40"/></default-field></field>
                    <field name="correctiveActions"><default-field title="Actions Required"><text-area rows="3" cols="40"/></default-field></field>
                    <field name="nextAuditDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Submit"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="AuditsForm" list="audits" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="storeId"><default-field title="Store">
                    <display-entity entity-name="zenith.erp.stores.Store" key-field-name="storeId" text="${storeName}"/>
                </default-field></field>
                <field name="auditDate"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="Date"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="auditorName"><default-field title="Auditor"><display/></default-field></field>
                <field name="overallScore"><header-field show-order-by="true"/>
                    <default-field title="Score"><display/></default-field></field>
                <field name="brandingScore"><default-field title="Brand"><display/></default-field></field>
                <field name="cleanlinessScore"><default-field title="Clean"><display/></default-field></field>
                <field name="serviceScore"><default-field title="Service"><display/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
                <field name="nextAuditDate"><default-field title="Next Audit"><display format="dd-MMM-yyyy"/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
