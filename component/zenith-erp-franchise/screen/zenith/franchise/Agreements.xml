<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Agreements" default-menu-index="1">

    <transition name="editAgreement"><default-response url="../EditAgreement"/></transition>
    <transition name="createAgreement">
        <service-call name="zenith.franchise.FranchiseServices.create#FranchiseAgreement"/>
        <default-response url="../EditAgreement"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.franchise.FranchiseAgreementDetail" list="agreements">
            <search-form-inputs default-order-by="-startDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export -->
            <econdition field-name="franchisorPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <label text="Franchise Agreements" type="h4" style="text-weight-bold q-my-none"/>
            <container-dialog id="CreateAgreement" button-text="New Agreement" type="success">
                <form-single name="CreateAgreementForm" transition="createAgreement">
                    <field name="franchiseePartyId"><default-field title="Franchisee">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}">
                            <entity-find entity-name="mantle.party.Organization"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="franchisorPartyId"><default-field title="Franchisor">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}">
                            <entity-find entity-name="mantle.party.Organization"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="storeId"><default-field title="Store">
                        <drop-down><entity-options key="${storeId}" text="${storeName}">
                            <entity-find entity-name="zenith.erp.stores.Store">
                                <econdition field-name="storeTypeEnumId" value="StFranchise"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="startDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="endDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="royaltyTypeEnumId"><default-field title="Royalty Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="RoyaltyType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="royaltyRate"><default-field title="Royalty Rate %"><text-line size="8"/></default-field></field>
                    <field name="franchiseFee"><default-field title="Franchise Fee"><text-line size="12"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Agreements..." style="display:none"></span>]]></text></render-mode>
            <form-list name="AgreementsForm" list="agreements" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true">
                <field name="franchiseeName"><default-field title="Franchisee">
                    <link url="editAgreement" text="${franchiseeName}" parameter-map="[agreementId:agreementId]"/>
                </default-field></field>
                <field name="storeName"><default-field title="Store"><display/></default-field></field>
                <field name="storeCode"><default-field title="Code"><display/></default-field></field>
                <field name="royaltyTypeEnumId"><default-field title="Royalty">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="royaltyRate"><default-field title="Rate"><display format="#0.##%"/></default-field></field>
                <field name="startDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="endDate"><default-field title="End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="statusId"><header-field show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="FaDraft" text="Draft"/><option key="FaActive" text="Active"/>
                        <option key="FaExpired" text="Expired"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <!-- ZE-PRC-004 sweep: Find submit button so the header-dialog filters can be applied (was a dead dialog). -->
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
