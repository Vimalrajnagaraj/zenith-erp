<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Royalties" default-menu-index="2">

    <actions>
        <entity-find entity-name="zenith.erp.franchise.RoyaltyCalculation" list="royalties">
            <search-form-inputs default-order-by="-periodStart"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-lg">
            <label text="Royalty Calculations" type="h4" style="text-weight-bold q-my-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="RoyaltiesForm" list="royalties" skip-form="true" header-dialog="true"
                       select-columns="true" show-csv-button="true" show-xlsx-button="true">
                <field name="agreementId"><default-field title="Agreement"><display/></default-field></field>
                <field name="periodStart"><header-field show-order-by="true"><date-find type="date"/></header-field>
                    <default-field title="From"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="periodEnd"><default-field title="To"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="salesAmount"><default-field title="Sales"><display format="#,##0.00"/></default-field></field>
                <field name="royaltyAmount"><default-field title="Royalty"><display format="#,##0.00"/></default-field></field>
                <field name="marketingFeeAmount"><default-field title="Marketing Fee"><display format="#,##0.00"/></default-field></field>
                <field name="totalDue"><header-field show-order-by="true"/>
                    <default-field title="Total Due"><display format="#,##0.00"/></default-field></field>
                <field name="statusId"><header-field>
                    <drop-down allow-empty="true">
                        <option key="RcCalculated" text="Calculated"/>
                        <option key="RcInvoiced" text="Invoiced"/>
                        <option key="RcPaid" text="Paid"/>
                    </drop-down></header-field>
                    <default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
