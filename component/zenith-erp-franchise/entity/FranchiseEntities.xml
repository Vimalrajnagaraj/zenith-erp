<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Franchise Agreement ========== -->
    <entity entity-name="FranchiseAgreement" package="zenith.erp.franchise" short-alias="FranchiseAgreements">
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="franchiseePartyId" type="id"/>
        <field name="franchisorPartyId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="agreementDate" type="date"/>
        <field name="startDate" type="date"/>
        <field name="endDate" type="date"/>
        <field name="renewalDate" type="date"/>
        <field name="royaltyTypeEnumId" type="id"/>
        <field name="royaltyRate" type="number-decimal"/>
        <field name="fixedRoyalty" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="franchiseFee" type="currency-amount"/>
        <field name="marketingFeePercent" type="number-decimal"/>
        <field name="reportingFrequencyEnumId" type="id"/>
        <field name="territory" type="text-medium"/>
        <field name="exclusiveTerritory" type="text-indicator" default="'N'"/>
        <field name="statusId" type="id"/>
        <field name="termsAndConditions" type="text-very-long"/>
        <relationship type="one" title="Franchisee" related="mantle.party.Party">
            <key-map field-name="franchiseePartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.stores.Store"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="RoyaltyType" description="Royalty Type"/>
            <moqui.basic.Enumeration enumId="RtPercentSales" enumTypeId="RoyaltyType" description="Percentage of Sales" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RtFixedMonthly" enumTypeId="RoyaltyType" description="Fixed Monthly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RtPercentProfit" enumTypeId="RoyaltyType" description="Percentage of Profit" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="RtHybrid" enumTypeId="RoyaltyType" description="Hybrid (Fixed + %)" sequenceNum="4"/>

            <moqui.basic.EnumerationType enumTypeId="ReportingFrequency" description="Reporting Frequency"/>
            <moqui.basic.Enumeration enumId="RfWeekly" enumTypeId="ReportingFrequency" description="Weekly" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="RfMonthly" enumTypeId="ReportingFrequency" description="Monthly" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="RfQuarterly" enumTypeId="ReportingFrequency" description="Quarterly" sequenceNum="3"/>

            <moqui.basic.StatusType statusTypeId="FranchiseAgreement" description="Franchise Agreement"/>
            <moqui.basic.StatusItem statusId="FaDraft" statusTypeId="FranchiseAgreement" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="FaActive" statusTypeId="FranchiseAgreement" description="Active" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="FaSuspended" statusTypeId="FranchiseAgreement" description="Suspended" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="FaExpired" statusTypeId="FranchiseAgreement" description="Expired" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="FaTerminated" statusTypeId="FranchiseAgreement" description="Terminated" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaDraft" toStatusId="FaActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaSuspended" transitionName="Suspend"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaSuspended" toStatusId="FaActive" transitionName="Reactivate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaExpired" transitionName="Expire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FaActive" toStatusId="FaTerminated" transitionName="Terminate"/>
        </seed-data>
    </entity>

    <!-- ========== Royalty Calculation ========== -->
    <entity entity-name="RoyaltyCalculation" package="zenith.erp.franchise" short-alias="RoyaltyCalculations">
        <field name="royaltyId" type="id" is-pk="true"/>
        <field name="agreementId" type="id"/>
        <field name="periodStart" type="date"/>
        <field name="periodEnd" type="date"/>
        <field name="salesAmount" type="currency-amount"/>
        <field name="royaltyAmount" type="currency-amount"/>
        <field name="marketingFeeAmount" type="currency-amount"/>
        <field name="totalDue" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="calculatedDate" type="date-time"/>
        <field name="invoiceId" type="id"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.franchise.FranchiseAgreement"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="RoyaltyCalc" description="Royalty Calculation"/>
            <moqui.basic.StatusItem statusId="RcCalculated" statusTypeId="RoyaltyCalc" description="Calculated" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RcInvoiced" statusTypeId="RoyaltyCalc" description="Invoiced" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RcPaid" statusTypeId="RoyaltyCalc" description="Paid" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RcCalculated" toStatusId="RcInvoiced" transitionName="Invoice"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RcInvoiced" toStatusId="RcPaid" transitionName="Mark Paid"/>
        </seed-data>
    </entity>

    <!-- ========== Franchise Compliance ========== -->
    <entity entity-name="FranchiseCompliance" package="zenith.erp.franchise" short-alias="FranchiseCompliances">
        <field name="complianceId" type="id" is-pk="true"/>
        <field name="agreementId" type="id"/>
        <field name="storeId" type="id"/>
        <field name="auditDate" type="date"/>
        <field name="auditorName" type="text-medium"/>
        <field name="overallScore" type="number-integer"><description>0-100</description></field>
        <field name="brandingScore" type="number-integer"/>
        <field name="cleanlinessScore" type="number-integer"/>
        <field name="serviceScore" type="number-integer"/>
        <field name="inventoryScore" type="number-integer"/>
        <field name="findings" type="text-very-long"/>
        <field name="correctiveActions" type="text-very-long"/>
        <field name="nextAuditDate" type="date"/>
        <field name="statusId" type="id"/>
        <relationship type="one" related="zenith.erp.franchise.FranchiseAgreement"/>
        <relationship type="one" related="zenith.erp.stores.Store"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="FranchiseAudit" description="Franchise Compliance Audit"/>
            <moqui.basic.StatusItem statusId="FcDraft" statusTypeId="FranchiseAudit" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="FcSubmitted" statusTypeId="FranchiseAudit" description="Submitted" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="FcActioned" statusTypeId="FranchiseAudit" description="Corrective Actions Taken" sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FcDraft" toStatusId="FcSubmitted" transitionName="Submit"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="FcSubmitted" toStatusId="FcActioned" transitionName="Actions Taken"/>
        </seed-data>
    </entity>

    <!-- ========== Franchise Agreement View ========== -->
    <view-entity entity-name="FranchiseAgreementDetail" package="zenith.erp.franchise">
        <member-entity entity-alias="FA" entity-name="zenith.erp.franchise.FranchiseAgreement"/>
        <member-entity entity-alias="FP" entity-name="mantle.party.Organization" join-from-alias="FA" join-optional="true">
            <key-map field-name="franchiseePartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="ST" entity-name="zenith.erp.stores.Store" join-from-alias="FA" join-optional="true">
            <key-map field-name="storeId"/></member-entity>
        <alias entity-alias="FA" name="agreementId"/>
        <alias entity-alias="FA" name="franchiseePartyId"/>
        <alias entity-alias="FA" name="storeId"/>
        <alias entity-alias="FA" name="startDate"/>
        <alias entity-alias="FA" name="endDate"/>
        <alias entity-alias="FA" name="royaltyTypeEnumId"/>
        <alias entity-alias="FA" name="royaltyRate"/>
        <alias entity-alias="FA" name="statusId"/>
        <alias entity-alias="FP" name="franchiseeName" field="organizationName"/>
        <alias entity-alias="ST" name="storeName"/>
        <alias entity-alias="ST" name="storeCode"/>
    </view-entity>

</entities>
