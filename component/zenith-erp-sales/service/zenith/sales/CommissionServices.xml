<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Create Commission Structure (tenant-scoped) -->
    <service verb="create" noun="CommissionStructure">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="commissionTypeEnumId" required="true"/>
            <parameter name="rate" type="BigDecimal" required="true"/>
            <parameter name="productCategoryId"/>
            <parameter name="minAmount" type="BigDecimal"/>
            <parameter name="validFrom" type="Date"/>
            <parameter name="validTo" type="Date"/>
        </in-parameters>
        <out-parameters><parameter name="commissionId"/></out-parameters>
        <actions>
            <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <set field="isActive" value="Y"/>
            <service-call name="create#zenith.erp.sales.CommissionStructure" in-map="context" out-map="context"/>
        </actions>
    </service>

    <!-- Calculate Commission for an Order (tenant-scoped) -->
    <service verb="calculate" noun="Commission">
        <in-parameters>
            <parameter name="orderId" required="true"/>
            <parameter name="partyId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="commissionTxnId"/>
            <parameter name="commissionAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>
            <if condition="order">
                <entity-find entity-name="zenith.erp.sales.CommissionStructure" list="structures">
                    <econdition field-name="partyId"/>
                    <econdition field-name="isActive" value="Y"/>
                    <order-by field-name="-validFrom"/>
                </entity-find>
                <set field="commissionAmount" from="0" type="BigDecimal"/>
                <set field="structId" from="null"/>
                <if condition="structures">
                    <set field="struct" from="structures[0]"/>
                    <set field="structId" from="struct.commissionId"/>
                    <set field="commissionAmount" from="((order.grandTotal ?: 0) * (struct.rate ?: 0)) / 100" type="BigDecimal"/>
                </if>
                <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
                <service-call name="create#zenith.erp.sales.CommissionTransaction"
                              in-map="[commissionId:structId, orderId:orderId, orderAmount:(order.grandTotal ?: 0),
                                       commissionAmount:commissionAmount, currencyUomId:order.currencyUomId,
                                       statusId:'ComCalculated', calculatedDate:ec.user.nowTimestamp,
                                       organizationPartyId:organizationPartyId]"
                              out-map="context"/>
                <else>
                    <script>ec.message.addError("Order " + orderId + " not found or not accessible.")</script>
                </else>
            </if>
        </actions>
    </service>

</services>
