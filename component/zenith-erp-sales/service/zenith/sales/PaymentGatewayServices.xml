<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- Existing mock gateway only; these services do not contact a payment provider. -->
    <service verb="create" noun="PaymentLink" authenticate="true">
        <in-parameters><parameter name="invoiceId" required="true"/><parameter name="gatewayType" default-value="RAZORPAY"/></in-parameters>
        <out-parameters><parameter name="paymentLinkId"/><parameter name="paymentUrl"/></out-parameters>
        <actions>
            <service-call name="zenith.sales.SalesLineServices.get#InvoicePayable" in-map="[invoiceId:invoiceId]" out-map="due"/>
            <if condition="ec.message.hasError()"><return/></if>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice" for-update="true"/>
            <if condition="!(invoice.statusId in ['InvoiceInProcess','InvoiceFinalized','InvoiceApproved','InvoiceSent','InvoiceAcked']) || due.payableAmount &lt;= 0">
                <return error="true" message="This invoice has no payable balance."/>
            </if>
            <if condition="!(gatewayType in ['RAZORPAY','CCAVENUE'])"><return error="true" message="Select a supported mock payment gateway."/></if>
            <set field="externalLinkId" from="'plink_' + java.util.UUID.randomUUID().toString()"/>
            <set field="paymentUrl" value="https://checkout.${gatewayType.toLowerCase()}.com/pay/${externalLinkId}"/>
            <service-call name="create#zenith.erp.sales.PaymentLink" out-map="created" in-map="[invoiceId:invoiceId,externalLinkId:externalLinkId,paymentUrl:paymentUrl,amount:due.payableAmount,statusId:'CREATED',expiryDate:(ec.user.nowTimestamp + 30)]"/>
            <set field="paymentLinkId" from="created.paymentLinkId"/>
        </actions>
    </service>
    <service verb="check" noun="PaymentStatus" authenticate="true">
        <in-parameters><parameter name="paymentLinkId" required="true"/></in-parameters>
        <out-parameters><parameter name="statusId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sales.PaymentLink" value-field="plink"/>
            <if condition="plink == null"><return error="true" message="Payment link not found."/></if>
            <service-call name="zenith.sales.SalesLineServices.get#InvoicePayable" in-map="[invoiceId:plink.invoiceId]" out-map="due"/>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="statusId" from="plink.statusId"/>
        </actions>
    </service>
    <service verb="process" noun="PaymentCallback" authenticate="true">
        <in-parameters><parameter name="externalLinkId" required="true"/><parameter name="status" required="true"/><parameter name="transactionId"/></in-parameters>
        <actions>
            <script>plink=ec.entity.find('zenith.erp.sales.PaymentLink').condition('externalLinkId',externalLinkId).forUpdate(true).one()</script>
            <if condition="plink == null"><return error="true" message="Payment link not found."/></if>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice" for-update="true"><field-map field-name="invoiceId" from="plink.invoiceId"/></entity-find-one>
            <service-call name="zenith.sales.SalesLineServices.get#InvoicePayable" in-map="[invoiceId:plink.invoiceId]" out-map="due"/>
            <if condition="ec.message.hasError()"><return/></if>
            <!-- Lock the link and invoice before deciding to settle. Retries and late failures are harmless. -->
            <if condition="plink.statusId == 'PAID'"><return/></if>
            <if condition="status == 'failed'"><set field="plink.statusId" value="CANCELLED"/><entity-update value-field="plink"/><return/></if>
            <if condition="status != 'paid'"><return error="true" message="Unsupported mock payment status."/></if>
            <if condition="invoice.statusId == 'InvoicePmtRecvd'"><return/></if>
            <if condition="!(invoice.statusId in ['InvoiceInProcess','InvoiceFinalized','InvoiceApproved','InvoiceSent','InvoiceAcked']) || plink.amount != due.payableAmount || due.payableAmount &lt;= 0">
                <return error="true" message="The invoice balance has changed; create a new payment link."/>
            </if>
            <!-- Preserve this instance's existing status-based settlement; do not introduce GL posting. -->
            <service-call name="create#mantle.account.payment.Payment" out-map="payment" in-map="[fromPartyId:invoice.toPartyId,toPartyId:invoice.fromPartyId,forInvoiceId:invoice.invoiceId,paymentTypeEnumId:'PtInvoicePayment',paymentInstrumentEnumId:'PiWireTransfer',amount:plink.amount,amountUomId:invoice.currencyUomId,effectiveDate:ec.user.nowTimestamp,paymentRefNum:transactionId,statusId:'PmntPromised']"/>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="invoice.appliedPaymentsTotal" from="(invoice.appliedPaymentsTotal ?: 0) + plink.amount"/>
            <set field="invoice.unpaidTotal" from="0"/><set field="invoice.statusId" value="InvoicePmtRecvd"/><entity-update value-field="invoice"/>
            <set field="plink.statusId" value="PAID"/><entity-update value-field="plink"/>
        </actions>
    </service>
    <service verb="generate" noun="UpiPaymentQr" authenticate="true">
        <in-parameters><parameter name="invoiceId" required="true"/><parameter name="upiId" required="true"/><parameter name="merchantName" required="true"/><parameter name="currencyCode" default-value="INR"/></in-parameters>
        <out-parameters><parameter name="upiString"/></out-parameters>
        <actions>
            <service-call name="zenith.sales.SalesLineServices.get#InvoicePayable" in-map="[invoiceId:invoiceId]" out-map="due"/>
            <if condition="ec.message.hasError()"><return/></if>
            <if condition="due.payableAmount &lt;= 0"><return error="true" message="This invoice has no payable balance."/></if>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
            <script><![CDATA[
                def values=[pa:upiId,pn:merchantName,tr:(invoice.customInvoiceNumber ?: invoice.invoiceId),am:due.payableAmount.toPlainString(),cu:currencyCode]
                upiString='upi://pay?' + values.collect { key,value -> key+'='+java.net.URLEncoder.encode(value.toString(),'UTF-8') }.join('&')
            ]]></script>
        </actions>
    </service>
</services>
