<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="PaymentLink">
        <description>Generates a mock payment link for an invoice via Razorpay/CCAvenue</description>
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
            <parameter name="gatewayType" default-value="RAZORPAY"/>
        </in-parameters>
        <out-parameters>
            <parameter name="paymentLinkId"/>
            <parameter name="paymentUrl"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
            <if condition="!invoice">
                <return error="true" message="Invoice ${invoiceId} not found."/>
            </if>
            <!-- ZE-SB-013: a payment link exposes the invoice total and mints a payable link — only for THIS
                 org's own (sales) invoices. The seller org is fromPartyId. Super-admin exempt. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ia"
                          in-map="[entityName:'mantle.account.invoice.Invoice', idField:'invoiceId', idValue:invoiceId, orgField:'fromPartyId']"/>
            <if condition="!_ia.allowed"><return error="true" message="You do not have access to that invoice."/></if>
            <set field="amount" from="invoice.invoiceTotal"/>
            
            <!-- Generate a mock external link ID and URL -->
            <set field="externalLinkId" value="plink_${ec.l10n.format(ec.user.nowTimestamp, 'yyyyMMddHHmmss')}"/>
            <set field="paymentUrl" value="https://checkout.${gatewayType.toLowerCase()}.com/pay/${externalLinkId}"/>

            <!-- Create PaymentLink record via the auto CrUD service so the sequenced primary key is
                 generated (a raw entity-create left paymentLinkId null → not-null violation). -->
            <service-call name="create#zenith.erp.sales.PaymentLink" out-map="plCreate"
                in-map="[invoiceId:invoiceId, externalLinkId:externalLinkId, paymentUrl:paymentUrl,
                         amount:amount, statusId:'CREATED', expiryDate:(ec.user.nowTimestamp + 30)]"/>
            <set field="paymentLinkId" from="plCreate.paymentLinkId"/>

            <!-- In a real scenario, an HTTP request to the gateway API would be placed here -->
            <message>Mock Payment Link Generated: ${paymentUrl}</message>
        </actions>
    </service>

    <service verb="check" noun="PaymentStatus">
        <in-parameters>
            <parameter name="paymentLinkId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="statusId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.sales.PaymentLink" value-field="plink"/>
            <if condition="!plink">
                <return error="true" message="Payment Link ${paymentLinkId} not found."/>
            </if>

            <!-- Mock API check -->
            <!-- Typically we'd query Razorpay here to get the status. We just return the DB status. -->
            <set field="statusId" from="plink.statusId"/>
        </actions>
    </service>

    <service verb="process" noun="PaymentCallback">
        <in-parameters>
            <parameter name="externalLinkId" required="true"/>
            <parameter name="status" required="true"/> <!-- e.g., 'paid', 'failed' -->
            <parameter name="transactionId"/>
        </in-parameters>
        <actions>
            <entity-find entity-name="zenith.erp.sales.PaymentLink" list="links">
                <econdition field-name="externalLinkId"/>
            </entity-find>
            <set field="plink" from="links?.first()"/>
            <if condition="!plink">
                <return error="true" message="Payment link not found for ${externalLinkId}"/>
            </if>

            <if condition="status == 'paid'">
                <!-- Idempotency: settle the invoice only once, even if the gateway retries the callback. -->
                <if condition="plink.statusId != 'PAID'">
                    <set field="plink.statusId" value="PAID"/>
                    <entity-update value-field="plink"/>

                    <!-- Record the payment and mark the invoice paid. Previously this was only a comment, so the
                         link flipped to PAID but the invoice stayed unpaid and no Payment was recorded.
                         We record a Payment linked to the invoice (fromParty=customer, toParty=organization) for
                         the audit trail, then set the invoice to InvoicePmtRecvd. The Payment is kept at
                         PmntPromised so it does NOT trigger Mantle's GL-posting/auto-apply cascade: this instance
                         tracks invoices by status, not double-entry ledger (the revenue control account is a
                         non-postable summary account, so full GL posting is not used here). -->
                    <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="inv">
                        <field-map field-name="invoiceId" from="plink.invoiceId"/>
                    </entity-find-one>
                    <if condition="inv != null &amp;&amp; inv.statusId != 'InvoicePmtRecvd' &amp;&amp; inv.statusId != 'InvoiceCancelled' &amp;&amp; inv.statusId != 'InvoiceWriteOff'">
                        <!-- Record a Payment linked to the invoice for the audit trail. Kept at PmntPromised so it
                             does not trigger Mantle's GL-posting/auto-apply cascade. -->
                        <service-call name="create#mantle.account.payment.Payment" out-map="payOut"
                            in-map="[fromPartyId:inv.toPartyId, toPartyId:inv.fromPartyId, forInvoiceId:inv.invoiceId,
                                     paymentTypeEnumId:'PtInvoicePayment', paymentInstrumentEnumId:'PiWireTransfer',
                                     amount:plink.amount, amountUomId:inv.currencyUomId, effectiveDate:ec.user.nowTimestamp,
                                     paymentRefNum:transactionId, statusId:'PmntPromised']"/>
                        <!-- Mark the invoice paid. A direct entity-update is used (not update#Invoice) because this
                             instance tracks invoices by status rather than Mantle double-entry GL: the revenue
                             control account is a non-postable summary account, so the Payment cannot be applied
                             through the ledger, and the update#Invoice service's status flow rejects
                             ->InvoicePmtRecvd while unpaidTotal is non-zero ("Invoice not fully paid"). We settle
                             the header fields directly to reflect the gateway payment. -->
                        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invUpd">
                            <field-map field-name="invoiceId" from="plink.invoiceId"/>
                        </entity-find-one>
                        <set field="invUpd.statusId" value="InvoicePmtRecvd"/>
                        <set field="invUpd.appliedPaymentsTotal" from="inv.invoiceTotal ?: plink.amount"/>
                        <set field="invUpd.unpaidTotal" from="0"/>
                        <entity-update value-field="invUpd"/>
                    </if>
                </if>
            </if>
            <if condition="status == 'failed'">
                <set field="plink.statusId" value="CANCELLED"/>
                <entity-update value-field="plink"/>
            </if>
        </actions>
    </service>

    <service verb="generate" noun="UpiPaymentQr">
        <description>Generates a dynamic UPI QR code string for the invoice.
            UPI is India-specific; for the full implementation see zenith.india.IndiaPosServices.generate#UpiQrString</description>
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
            <parameter name="upiId" required="true"/>
            <parameter name="merchantName" required="true"/>
            <parameter name="currencyCode" default-value="INR"/>
        </in-parameters>
        <out-parameters>
            <parameter name="upiString"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
            <set field="amount" from="ec.l10n.format(invoice.invoiceTotal, '0.00')"/>
            <set field="orderId" from="invoice.customInvoiceNumber ?: invoice.invoiceId"/>

            <set field="upiString" value="upi://pay?pa=${upiId}&amp;pn=${merchantName}&amp;tr=${orderId}&amp;am=${amount}&amp;cu=${currencyCode}"/>
        </actions>
    </service>

</services>
