<?xml version="1.0" encoding="UTF-8"?>
<test-suite xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-test-3.xsd">
    <test-case name="TestGstCalculation">
        <actions>
            <script>
                ec.user.loginUser("john.doe", "moqui")
            </script>
            <service-call name="zenith.sales.SalesInvoiceServices.create#SalesInvoiceHeader"
                          in-map="[organizationPartyId:'ORG_ZINC', customerPartyId:'FedEx', documentType:'Tax Invoice']"
                          out-map="createInvoiceOut"/>
            
            <service-call name="mantle.account.invoice.InvoiceServices.create#InvoiceItem"
                          in-map="[invoiceId:createInvoiceOut.invoiceId, itemTypeEnumId:'ItemSales', productId:'DemoProduct', quantity:10, amount:500]"
                          out-map="createItemOut"/>
            
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice">
                <field-map field-name="invoiceId" from="createInvoiceOut.invoiceId"/>
            </entity-find-one>
            
            <script>
                ec.logger.warn("==================================================")
                ec.logger.warn("Test Invoice ID: " + invoice.invoiceId)
                ec.logger.warn("Taxable Amount: " + invoice.totalTaxableAmount)
                ec.logger.warn("CGST Amount: " + invoice.totalCgst)
                ec.logger.warn("SGST Amount: " + invoice.totalSgst)
                ec.logger.warn("Grand Total: " + invoice.invoiceTotal)
                ec.logger.warn("==================================================")
            </script>
        </actions>
    </test-case>
</test-suite>
