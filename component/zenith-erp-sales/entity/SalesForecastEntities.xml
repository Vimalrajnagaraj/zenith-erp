<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- One forecasted period (day/week) for a dimension (overall or a category). Calibrated later
         by filling actualAmount + accuracyPct once the period's real sales are known. -->
    <entity entity-name="SalesRevenueForecast" package="zenith.erp.sales" short-alias="salesRevForecasts">
        <field name="forecastId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="runDate" type="date-time"><description>When this forecast was generated</description></field>
        <field name="granularity" type="text-short"><description>Daily | Weekly</description></field>
        <field name="dimension" type="text-short"><description>Overall | Category</description></field>
        <field name="dimensionValue" type="text-medium"><description>ALL, or the category name</description></field>
        <field name="periodDate" type="date"><description>The forecasted period (start date)</description></field>
        <field name="predictedAmount" type="currency-amount"/>
        <field name="lowerBound" type="currency-amount"/>
        <field name="upperBound" type="currency-amount"/>
        <field name="method" type="text-medium"><description>Backtest-selected method label</description></field>
        <field name="confidencePct" type="number-integer"/>
        <field name="trafficForecast" type="number-decimal"><description>Predicted transaction count (driver)</description></field>
        <field name="aovForecast" type="currency-amount"><description>Predicted average order value (driver)</description></field>
        <field name="actualAmount" type="currency-amount"/>
        <field name="accuracyPct" type="number-integer"/>
        <field name="createdStamp" type="date-time"/>
        <index name="idxSalesForecastOrg"><index-field name="organizationPartyId"/><index-field name="dimension"/><index-field name="periodDate"/></index>
    </entity>

    <!-- POS line items joined to their transaction (for date/status/org) and product category, so a
         category's daily revenue series can be built for category-level sales forecasting. -->
    <view-entity entity-name="PosCategorySalesView" package="zenith.erp.sales">
        <member-entity entity-alias="PI" entity-name="zenith.erp.pos.PosTransactionItem"/>
        <member-entity entity-alias="PT" entity-name="zenith.erp.pos.PosTransaction" join-from-alias="PI"><key-map field-name="transactionId"/></member-entity>
        <member-entity entity-alias="PCM" entity-name="mantle.product.category.ProductCategoryMember" join-from-alias="PI"><key-map field-name="productId"/></member-entity>
        <alias entity-alias="PI" name="lineTotal"/>
        <alias entity-alias="PI" name="transactionId"/>
        <alias entity-alias="PI" name="productId"/>
        <alias entity-alias="PT" name="entryDate"/>
        <alias entity-alias="PT" name="statusId"/>
        <alias entity-alias="PT" name="transactionType"/>
        <alias entity-alias="PT" name="organizationPartyId"/>
        <alias entity-alias="PCM" name="productCategoryId"/>
    </view-entity>

    <!-- Invoice line items joined to their invoice (date/status/party/type) and product category.
         Source for category sales forecasting from ALL sales invoices (POS-synced + Sales-module). -->
    <view-entity entity-name="InvoiceCategorySalesView" package="zenith.erp.sales">
        <member-entity entity-alias="II" entity-name="mantle.account.invoice.InvoiceItem"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="II"><key-map field-name="invoiceId"/></member-entity>
        <member-entity entity-alias="PCM" entity-name="mantle.product.category.ProductCategoryMember" join-from-alias="II"><key-map field-name="productId"/></member-entity>
        <alias entity-alias="II" name="invoiceId"/>
        <alias entity-alias="II" name="productId"/>
        <alias entity-alias="II" name="taxableAmount"/>
        <alias entity-alias="II" name="totalTaxAmount"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <alias entity-alias="PCM" name="productCategoryId"/>
    </view-entity>

</entities>
