<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="PaymentGatewayConfig" package="zenith.erp.sales" table-name="ZENITH_PAY_GW_CONFIG" short-alias="PaymentGatewayConfig">
        <field name="paymentGatewayConfigId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="gatewayType" type="text-short"/> <!-- RAZORPAY, CCAVENUE, BILLDESK, UPI -->
        <field name="merchantId" type="text-medium"/>
        <field name="apiKey" type="text-long"/>
        <field name="apiSecret" type="text-long"/>
        <field name="webhookSecret" type="text-long"/>
        <field name="environment" type="text-short" default="'TEST'"/> <!-- TEST, LIVE -->
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="mantle.party.Organization">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>

    <entity entity-name="PaymentLink" package="zenith.erp.sales" short-alias="PaymentLink">
        <field name="paymentLinkId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="paymentGatewayConfigId" type="id"/>
        <field name="externalLinkId" type="text-medium"/> <!-- ID returned by Razorpay -->
        <field name="paymentUrl" type="text-very-long"/>
        <field name="amount" type="currency-precise"/>
        <field name="statusId" type="text-short" default="'CREATED'"/> <!-- CREATED, PAID, CANCELLED, EXPIRED -->
        <field name="expiryDate" type="date-time"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" related="zenith.erp.sales.PaymentGatewayConfig"/>
    </entity>

</entities>
