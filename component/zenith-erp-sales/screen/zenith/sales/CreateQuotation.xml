<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New Quote" default-menu-include="false">

    <parameter name="customerPartyId"/>

    <transition name="createQuotation">
        <actions>
            <!-- ZE-SALES: set currencyUomId explicitly (mantle's create#Order otherwise defaults to USD; this is an
                 India-only ERP, so quotes/orders/invoices are all INR — matches CreateInvoice/CreateCreditNote). -->
            <service-call name="mantle.order.OrderServices.create#Order" in-map="[orderName:'New Quotation', entryDate:orderDate, statusId:'OrderProposed', currencyUomId:'INR', vendorPartyId:ec.user.getPreference('ACTIVE_ORGANIZATION'), customerPartyId:customerPartyId]" out-map="createOut"/>
            <!-- ZE-SALES: assign a formatted per-org, financial-year quotation number (QTN/26-27/00001) via the
                 shared sequence service, stored on the order so the print/screen show it. Fail-open: if the org
                 has no QUOTATION sequence, the print falls back to the order id and quote creation never breaks. -->
            <script><![CDATA[
                try {
                    def _org = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    // Only call get#NextSequence when the org actually has this sequence configured: for a missing
                    // sequence it RETURNS AN ERROR (not an exception, so the try/catch misses it) which would roll
                    // back the whole quote. The doc number is best-effort — quote creation must never break.
                    def _hasSeq = _org && ec.entity.find("zenith.erp.base.SystemSequence").condition("organizationPartyId", _org).condition("sequenceType", "QUOTATION").disableAuthz().count() > 0
                    if (_hasSeq) {
                        def _seq = ec.service.sync().name("zenith.base.SequenceServices.get#NextSequence")
                                    .parameters([organizationPartyId:_org, sequenceType:'QUOTATION']).call()
                        if (_seq?.sequenceValue) {
                            // ZE-SALES-0308 f/u: also store the formatted number in mantle's standard customer-facing
                            // displayId, so the Find list ("displayId ?: orderId") and the Quote No. search show/find
                            // the QTN number, not the raw order id. zenithDocNumber stays for the print/title.
                            ec.service.sync().name("update#mantle.order.OrderHeader")
                                .parameters([orderId:createOut.orderId, zenithDocNumber:_seq.sequenceValue, displayId:_seq.sequenceValue, documentType:'QUOTATION']).call()
                        }
                    }
                } catch (Exception e) { ec.logger.warn("Quotation number generation skipped: " + e.message) }
            ]]></script>
        </actions>
        <default-response url="../EditQuotation">
            <parameter name="orderId" from="createOut.orderId"/>
        </default-response>
    </transition>
    <transition name="findQuotation"><default-response url="../FindQuotation"/></transition>
    <transition name="getCustomers" read-only="true">
        <parameter name="term"/>
        <actions>
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="partyList" limit="20" distinct="true">
                <econdition field-name="roleTypeId" value="Customer"/>
                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econditions combine="or">
                    <econdition field-name="partyId" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true"/>
                </econditions>
                <select-field field-name="partyId,organizationName,firstName,lastName"/>
                <order-by field-name="organizationName,firstName,lastName"/>
            </entity-find>
            <script>
                def outList = []
                for (party in partyList) outList.add([value:party.partyId, label:party.organizationName ?: ((party.firstName?:'') + ' ' + (party.lastName?:'')).trim() + ' [' + party.partyId + ']'])
                if (customerPartyId) {
                    def existing = ec.entity.find("mantle.party.PartyDetailAndRole").condition("partyId", customerPartyId).one()
                    if (existing) {
                        outList.add(0, [value:existing.partyId, label:existing.organizationName ?: ((existing.firstName?:'') + ' ' + (existing.lastName?:'')).trim() + ' [' + existing.partyId + ']'])
                    }
                }
                ec.web.sendJsonResponse(outList)
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="mantle.party.Organization" value-field="activeOrg">
            <field-map field-name="partyId" from="activeOrgId"/>
        </entity-find-one>
        <set field="activeOrgName" from="activeOrg?.organizationName ?: activeOrgId"/>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="findQuotation" text="Back to Quotes" icon="fa fa-arrow-left" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <container-row>
            <row-col lg="8" md="10" sm="12" style="q-mx-auto">
                <container style="zenith-card bg-white shadow-4 border-radius-xl q-pa-xl q-mt-md">
                    <container-row>
                        <row-col>
                            <container style="row items-center q-mb-lg">
                                <container style="q-pa-md bg-indigo-1 border-radius-md q-mr-md text-indigo-8">
                                    <render-mode><text type="html"><![CDATA[<q-icon name="request_quote" class="text-h3"/>]]></text></render-mode>
                                </container>
                                <container>
                                    <label text="Create Sales Quotation" type="h4" style="text-dark text-weight-bolder q-mt-none q-mb-xs"/>
                                    <label text="Pick the customer and date to start a new price quote." type="p" style="text-grey-7 text-subtitle1 q-mb-none"/>
                                </container>
                            </container>
                            <label text="" type="hr" style="q-mb-xl bg-grey-3" size="1"/>
                        </row-col>
                    </container-row>

                    <form-single name="CreateQuoteForm" transition="createQuotation">
                        <field name="organizationPartyId"><default-field><hidden default-value="${activeOrgId}"/></default-field></field>
                        <field name="supplierName"><default-field title="From (Supplier)"><display text="${activeOrgName}"/></default-field></field>
                        <field name="customerPartyId"><default-field title="To (Customer)">
                            <drop-down allow-empty="true">
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetailAndRole" distinct="true">
                                        <econdition field-name="roleTypeId" value="Customer"/>
                                        <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <order-by field-name="organizationName,firstName,lastName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="orderDate"><default-field title="Quote Date"><date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/></default-field></field>
                        <field name="settlementTermId"><default-field title="Payment Terms">
                            <drop-down allow-empty="true">
                                <entity-options key="${settlementTermId}" text="${description}">
                                    <entity-find entity-name="mantle.account.invoice.SettlementTerm">
                                        <order-by field-name="description"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="isReverseCharge"><default-field title="Reverse Charge">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No"/><option key="Y" text="Yes"/>
                            </drop-down>
                        </default-field></field>
                        <field name="isExport"><default-field title="Export Quote">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No"/><option key="Y" text="Yes"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                                <submit text="Create Quotation" icon="request_quote" style="bg-indigo-8 text-white shadow-3 q-px-xl q-py-sm text-subtitle1 text-weight-bold q-mt-lg glossy"/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>

                        <field-layout>
                            <field-row>
                                <field-ref name="supplierName"/>
                                <field-ref name="customerPartyId"/>
                            </field-row>
                            <field-ref name="organizationPartyId"/>
                            <field-row>
                                <field-ref name="orderDate"/>
                                <field-ref name="settlementTermId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="isReverseCharge"/>
                                <field-ref name="isExport"/>
                            </field-row>
                            <field-row>
                                <field-ref name="submitButton"/>
                            </field-row>
                        </field-layout>
                    </form-single>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
