<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Order" default-menu-include="false">

    <parameter name="orderId" required="true"/>

    <transition name="findOrder"><default-response url="../FindOrder"/></transition>
    <transition name="updateStatus">
        <service-call name="update#mantle.order.OrderHeader"/>
        <default-response url="."/>
    </transition>
    <transition name="addItem">
        <actions>
            <script>
                // Sync price with Inventory &amp; Pricing: auto-fill when the user leaves Unit Price blank
                def price = new BigDecimal(unitAmount ?: 0)
                if (price.signum() == 0 &amp;&amp; productId) {
                    def _org = ec.user.getPreference('ACTIVE_ORGANIZATION')
                    def _qty = new BigDecimal(quantity ?: 1)
                    try {
                        def _pr = ec.service.sync().name("zenith.pricing.PricingServices.calculate#Price")
                                    .parameters([productId:productId, quantity:(_qty.signum()>0?_qty:1), organizationPartyId:_org]).call()
                        if (_pr?.unitPrice != null &amp;&amp; (_pr.unitPrice as BigDecimal).signum() == 1) price = _pr.unitPrice as BigDecimal
                    } catch (Exception e) { }
                    if (price.signum() == 0) {
                        def _p = ec.entity.find("mantle.product.Product").condition("productId", productId).one()
                        if (_p?.mrpAmount != null) price = _p.mrpAmount as BigDecimal
                    }
                }
                // ZE-SALES-0309 / ZE-SALES-024 (SL-084): create#OrderItem requires an EXISTING OrderPart. mantle
                // create#Order normally makes one (seq '01'), but an order with none (odd creation path / import)
                // broke Add Item — first with "Field cannot be empty (Order Part Seq ID)", and after 0309's blind
                // '01' fallback, with an FK violation (order_part_seq_id '01' not present in order_part). So look
                // up the part, and CREATE one when the order has none, before adding the item.
                def _parts = ec.entity.find("mantle.order.OrderPart").condition("orderId", orderId).orderBy("orderPartSeqId").list()
                def _partSeq
                if (_parts) {
                    _partSeq = _parts[0].orderPartSeqId
                } else {
                    // A minimal part satisfies create#OrderItem's FK; its parties (nullable on OrderPart) can be
                    // set elsewhere. OrderHeader carries no vendor/customer — those live on OrderPart.
                    ec.service.sync().name("create#mantle.order.OrderPart")
                        .parameters([orderId: orderId, orderPartSeqId: '01']).call()
                    _partSeq = '01'
                }
                def inMap = context + [unitAmount: price, orderPartSeqId: _partSeq]
                ec.service.sync().name("mantle.order.OrderServices.create#OrderItem").parameters(inMap).call()
            </script>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="printOrder" read-only="true">
        <!-- ZE-SALES-0311: don't emit a zero-value PDF for an item-less order; send the user back with a note. -->
        <actions>
            <entity-find-count entity-name="mantle.order.OrderItem" count-field="itemCount"><econdition field-name="orderId"/></entity-find-count>
            <if condition="itemCount == 0"><message>This order has no items yet. Add at least one item before downloading the PDF.</message></if>
        </actions>
        <conditional-response url="." url-type="screen">
            <condition><expression>itemCount == 0</expression></condition>
        </conditional-response>
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/OrderPrint" url-type="plain">
            <parameter name="orderId"/>
            <parameter name="filename" value="Order-${orderId}.pdf"/>
        </default-response>
    </transition>
    <transition name="convertToInvoice">
        <actions>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <script><![CDATA[
                def parts = ec.entity.find("mantle.order.OrderPart").condition("orderId", orderId).list()
                def part = parts ? parts.first() : null
                if (part == null || part.vendorPartyId != activeOrg) {
                    ec.message.addError("Order not found for your account."); return
                }
                def billed = ec.entity.find("mantle.order.OrderItemBilling").condition("orderId", orderId).list()
                if (billed) {
                    targetInvoiceId = billed.first().invoiceId
                    ec.message.addMessage("This order has already been invoiced (" + targetInvoiceId + ").")
                    return
                }
                def oItems = ec.entity.find("mantle.order.OrderItem").condition("orderId", orderId)
                    .condition("orderPartSeqId", part.orderPartSeqId).orderBy("orderItemSeqId").list()
                def items = []; def billOItems = []
                for (oi in oItems) {
                    if (!oi.productId) continue
                    items.add([productId:oi.productId, itemDescription:oi.itemDescription,
                               quantity:oi.quantity, unitAmount:oi.unitAmount])
                    billOItems.add(oi)
                }
                if (!items) { ec.message.addError("Order has no billable product items."); return }
                // ZE-SALES-020 (SL-075) sweep f/u: create#SalesInvoice requires customerPartyId. A customer-less
                // order would otherwise fail on the raw framework error "Field cannot be empty (Customer Party Id)".
                // This path already surfaces errors to the user (<error-response url="."/>), so it's not the silent
                // poison trap — just give a plain-language pre-check instead of the cryptic field error.
                if (!part.customerPartyId) {
                    ec.message.addError("Add a customer to this order before converting it to an invoice."); return
                }
                def oh = ec.entity.find("mantle.order.OrderHeader").condition("orderId", orderId).one()
                def inv = ec.service.sync().name("zenith.sales.SalesInvoiceServices.create#SalesInvoice")
                    .parameters([organizationPartyId:activeOrg, customerPartyId:part.customerPartyId,
                                 currencyUomId:oh?.currencyUomId, items:items]).call()
                targetInvoiceId = inv.invoiceId
                def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem")
                    .condition("invoiceId", targetInvoiceId).condition("itemTypeEnumId","ItemProduct")
                    .orderBy("invoiceItemSeqId").list()
                for (int i = 0; i < billOItems.size() && i < invItems.size(); i++) {
                    ec.service.sync().name("create#mantle.order.OrderItemBilling").parameters([
                        orderId:orderId, orderItemSeqId:billOItems[i].orderItemSeqId,
                        invoiceId:targetInvoiceId, invoiceItemSeqId:invItems[i].invoiceItemSeqId,
                        quantity:billOItems[i].quantity, amount:billOItems[i].unitAmount]).call()
                }
            ]]></script>
        </actions>
        <default-response url="../EditInvoice"><parameter name="invoiceId" value="${targetInvoiceId}"/></default-response>
        <error-response url="."/>
    </transition>

    <!-- ZE-SALES-024 (SL-084): assign a salesperson to this order and calculate their commission from the
         configured rate. Wires up CommissionServices.calculate#Commission, which had NO caller (orphaned) — so
         a salesperson could never be assigned to an order and no commission was ever calculated. -->
    <transition name="calculateCommission">
        <actions>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.order.OrderHeader" value-field="_ord"/>
            <entity-find entity-name="mantle.order.OrderPart" list="_ordParts"><econdition field-name="orderId"/></entity-find>
            <set field="_ovendor" from="_ordParts ? _ordParts[0].vendorPartyId : null"/>
            <if condition="_ord == null || (activeOrg &amp;&amp; _ovendor &amp;&amp; _ovendor != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Order not found for your account."/>
            </if>
            <if condition="!partyId">
                <return error="true" message="Select a salesperson to calculate commission."/>
            </if>
            <!-- idempotent: clear any not-yet-approved commission for THIS order so re-assigning recalculates
                 cleanly (keeps Approved/Paid rows). Scoped by orderId (globally unique) so disableAuthz is safe. -->
            <script>
                ec.entity.find("zenith.erp.sales.CommissionTransaction").condition("orderId", orderId).condition("statusId", "ComCalculated").disableAuthz().deleteAll()
            </script>
            <service-call name="zenith.sales.CommissionServices.calculate#Commission" in-map="[orderId:orderId, partyId:partyId]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>
        
        <entity-find entity-name="mantle.order.OrderPart" list="orderParts">
            <econdition field-name="orderId"/>
        </entity-find>
        <set field="orderPart" from="orderParts?.getFirst()"/>

        <!-- ZE-SALES-0312: currency symbol for the banner (the screen showed amounts with no symbol). INR tenant -> Rs. -->
        <set field="currSymbol" from="order?.currencyUomId == 'INR' ? '₹' : (order?.currencyUomId == 'USD' ? '$' : ((order?.currencyUomId ?: '') + ' '))"/>

        <!-- ZE-SALES-0310: offer only the current status + its valid next states (from the order status flow),
             so the dropdown no longer lists e-commerce statuses (Wish List / Gift Registry / Auto Reorder) or
             transitions the backend would reject. -->
        <entity-find entity-name="moqui.basic.StatusFlowTransition" list="_stTrans">
            <econdition field-name="statusId" from="order?.statusId"/>
        </entity-find>
        <set field="allowedStatusIds" from="(([order?.statusId] + _stTrans.collect{ it.toStatusId }).findAll{ it }).unique()"/>

        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customer">
            <field-map field-name="partyId" from="orderPart?.customerPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>

        <!-- ZE-SALES-024 (SL-084): configured salespeople (for the assign dropdown) + any commission already
             calculated for this order. -->
        <entity-find entity-name="zenith.erp.sales.CommissionStructure" list="commStructures">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="isActive" value="Y"/>
            <order-by field-name="partyId"/>
        </entity-find>
        <script><![CDATA[
            def _sp = []; def _seen = [:]
            for (cs in commStructures) {
                if (_seen[cs.partyId]) continue
                _seen[cs.partyId] = true
                def pd = ec.entity.find("mantle.party.PartyDetail").condition("partyId", cs.partyId).one()
                def nm = ((pd?.firstName ?: '') + ' ' + (pd?.lastName ?: '')).trim() ?: cs.partyId
                _sp.add([partyId: cs.partyId, label: nm + '  (' + (cs.rate ?: 0) + '%)'])
            }
            commSalespeople = _sp
        ]]></script>
        <entity-find entity-name="zenith.erp.sales.CommissionTransaction" list="orderCommissions">
            <econdition field-name="orderId"/>
            <order-by field-name="-calculatedDate"/>
        </entity-find>
        <script><![CDATA[
            def _oc = []
            for (t in orderCommissions) {
                def m = new LinkedHashMap(t)
                def cs = t.commissionId ? ec.entity.find("zenith.erp.sales.CommissionStructure").condition("commissionId", t.commissionId).one() : null
                def pd = cs?.partyId ? ec.entity.find("mantle.party.PartyDetail").condition("partyId", cs.partyId).one() : null
                m.salespersonName = pd ? (((pd.firstName ?: '') + ' ' + (pd.lastName ?: '')).trim() ?: cs.partyId) : (cs?.partyId ?: 'Unassigned')
                _oc.add(m)
            }
            orderCommissions = _oc
        ]]></script>
    </actions>

    <widgets>
        <link url="findOrder" text="Back to Orders" link-type="anchor"/>
        
        <container style="zenith-profile-banner q-pa-xl bg-white shadow-4 border-radius-xl q-mb-lg zenith-card">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="q-pa-md bg-teal-1 border-radius-md q-mr-md text-teal-8">
                        <render-mode><text type="html"><![CDATA[<q-icon name="shopping_cart_checkout" class="text-h3"/>]]></text></render-mode>
                    </container>
                    <container style="column">
                        <label text="Order ${order?.displayId ?: orderId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="${currSymbol}${ec.l10n.format(order.grandTotal ?: 0, '#,##,##0.00')}" type="p" style="text-grey-7 text-h6 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateStatus" map="order">
                        <field name="orderId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="OrderHeader"/>
                                        <econdition field-name="statusId" operator="in" from="allowedStatusIds"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title=""><submit text="Update Status" icon="check_circle" style="bg-teal-7 text-white text-weight-bold q-ml-sm border-radius-sm"/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-end q-gutter-md">
                <link url="printOrder" text="Download PDF" parameter-map="[orderId:orderId]" target-window="_blank"
                      icon="picture_as_pdf" style="q-btn q-btn--flat bg-dark text-white text-weight-bold q-px-lg border-radius-sm"/>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Customer Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Name" type="strong" style="text-grey-7 block"/><label text="${customer?.organizationName ?: ((customer?.firstName ?: '') + ' ' + (customer?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Customer ID" type="strong" style="text-grey-7 block"/>
                            <section name="CustomerLink" condition="customer?.partyId"><widgets>
                                <link url="/vapps/zenith/contacts/Contacts/EditContact" text="${customer.partyId}" parameter-map="[partyId:customer.partyId]" link-type="anchor" style="text-primary text-weight-bold"/>
                            </widgets><fail-widgets><label text="N/A" type="span" style="text-dark"/></fail-widgets></section>
                        </container>
                    </container>
                </container>

                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Order Info" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Entry Date" type="strong" style="text-grey-7 block"/><label text="${ec.l10n.format(order.entryDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Placed Date" type="strong" style="text-grey-7 block"/><label text="${order.placedDate ? ec.l10n.format(order.placedDate, 'dd MMM yyyy') : 'N/A'}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Channel" type="strong" style="text-grey-7 block"/><label text="${order.salesChannelEnumId ?: 'N/A'}" type="span" style="text-dark"/></container>
                    </container>
                </container>
            </row-col>
            
            <row-col lg="6">
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Your Business (Seller)" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Name" type="strong" style="text-grey-7 block"/><label text="${vendor?.organizationName ?: ((vendor?.firstName ?: '') + ' ' + (vendor?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Vendor ID" type="strong" style="text-grey-7 block"/>
                            <section name="VendorLink" condition="vendor?.partyId"><widgets>
                                <link url="/vapps/zenith/contacts/Contacts/EditContact" text="${vendor.partyId}" parameter-map="[partyId:vendor.partyId]" link-type="anchor" style="text-primary text-weight-bold"/>
                            </widgets><fail-widgets><label text="N/A" type="span" style="text-dark"/></fail-widgets></section>
                        </container>
                    </container>
                </container>

                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Summary" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Total Items" type="strong" style="text-grey-7 block"/><label text="${orderItems?.size() ?: 0}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Grand Total" type="strong" style="text-grey-7 block"/><label text="${currSymbol}${ec.l10n.format(order.grandTotal ?: 0, '#,##,##0.00')}" type="h4" style="text-primary q-my-none"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- ZE-SALES-024 (SL-084): assign a salesperson to this order + auto-calculate their commission. -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <label text="Salesperson &amp; Commission" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
            <container style="row items-center justify-between q-mb-md">
                <label text="Assign a salesperson to earn commission on this order — the amount is calculated automatically from their configured rate on the order total (${currSymbol}${ec.l10n.format(order.grandTotal ?: 0, '#,##,##0.00')})." type="p" style="text-grey-7 text-caption q-my-none"/>
                <section name="AssignCommission" condition="commSalespeople"><widgets>
                    <form-single name="CommissionForm" transition="calculateCommission">
                        <field name="orderId"><default-field><hidden default-value="${orderId}"/></default-field></field>
                        <field name="partyId"><default-field title="Salesperson">
                            <drop-down><list-options list="commSalespeople" key="${partyId}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title=""><submit text="Assign &amp; Calculate" icon="calculate" style="bg-teal-7 text-white text-weight-bold q-ml-sm border-radius-sm"/></default-field></field>
                        <field-layout><field-row><field-ref name="partyId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </widgets><fail-widgets>
                    <label text="No commission structures configured yet — set one up in Sales → Commissions first." type="span" style="text-caption text-warning text-weight-bold"/>
                </fail-widgets></section>
            </container>
            <form-list name="OrderCommissionList" list="orderCommissions" skip-form="true">
                <field name="salespersonName"><default-field title="Salesperson"><label text="${salespersonName}" type="strong" style="text-dark"/></default-field></field>
                <field name="calculatedDate"><default-field title="Calculated"><display format="dd-MMM-yyyy HH:mm"/></default-field></field>
                <field name="orderAmount"><default-field title="Order Total"><label text="${currSymbol}${ec.l10n.format(orderAmount ?: 0, '#,##,##0.00')}" type="span"/></default-field></field>
                <field name="commissionAmount"><default-field title="Commission"><label text="${currSymbol}${ec.l10n.format(commissionAmount ?: 0, '#,##,##0.00')}" type="strong" style="text-teal-8"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/></default-field></field>
            </form-list>
        </container>

        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Order Items" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <container style="row items-center q-gutter-sm">
                    <link url="convertToInvoice" text="Convert to Invoice" icon="receipt_long" style="q-btn q-btn--flat bg-indigo-7 text-white text-weight-bold q-px-md border-radius-sm"/>
                    
                    <container-dialog id="AddItemDialog" button-text="Add Item" button-icon="add_circle" button-class="q-btn--flat bg-teal-8 text-white text-weight-bold q-px-md border-radius-sm">
                        <form-single name="AddItemForm" transition="addItem">
                            <field name="orderId"><default-field><hidden/></default-field></field>
                            <field name="itemDescription"><default-field title="Description"><text-line size="60"/></default-field></field>
                            <field name="productId"><default-field title="Product">
                                <drop-down allow-empty="true">
                                    <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                        <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field></field>
                            <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                            <field name="unitAmount"><default-field title="Unit Price"><text-line size="12"/></default-field></field>
                            <!-- Mock GST fields -->
                            <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="8"/></default-field></field>
                            <field name="mrpAmount"><default-field title="MRP"><text-line size="12"/></default-field></field>
                            <field name="submitButton"><default-field title="Add Item"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>
            </container>
            <form-list name="OrderItemsForm" list="orderItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="orderItemSeqId"><default-field title="#"><label text="${orderItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="itemDescription"><default-field title="Description"><label text="${itemDescription ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="unitAmount"><default-field title="Unit Price"><label text="${ec.l10n.format(unitAmount, '#,##,##0.00')}" type="span"/></default-field></field>
                <field name="mrpAmount"><default-field title="MRP"><label text="${ec.l10n.format(mrpAmount?:0, '#,##,##0.00')}" type="span"/></default-field></field>
                <field name="total"><default-field title="Total"><label text="${ec.l10n.format((quantity ?: 0) * (unitAmount ?: 0), '#,##,##0.00')}" type="span" style="text-weight-bold"/></default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>
    </widgets>
</screen>
