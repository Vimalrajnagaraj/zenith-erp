<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" standalone="true">

    <parameter name="challanId" required="true"/>
    
    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find entity-name="zenith.erp.sales.DeliveryChallan" list="challanMatch">
            <econdition field-name="challanId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <set field="challan" from="challanMatch ? challanMatch[0] : null"/>
        
        <set field="challanItems" from="[]"/>
        <if condition="challan != null">
            <entity-find entity-name="zenith.erp.sales.DeliveryChallanItem" list="challanItems">
                <econdition field-name="challanId"/>
                <order-by field-name="itemSeqId"/>
            </entity-find>
        </if>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="fromParty">
            <field-map field-name="partyId" from="challan?.organizationPartyId"/>
        </entity-find-one>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
            <field-map field-name="partyId" from="challan?.toPartyId"/>
        </entity-find-one>
    </actions>

    <widgets>
        <render-mode>
            <text type="xsl-fo" location="component://zenith-erp-sales/template/sales/ChallanPrint.xsl-fo.ftl" template="true" encode="false" no-boundary-comment="true"/>
        </render-mode>
    </widgets>
</screen>
