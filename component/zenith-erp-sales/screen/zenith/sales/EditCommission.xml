<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Update Commission" default-menu-include="false" require-authentication="true">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <!-- SL-084 f/u: edit an existing commission structure's rate/validity. Org-guarded on BOTH the view
         (below) and the update transition so a user can't read or change another tenant's structure. -->
    <transition name="updateStructure">
        <parameter name="rate" type="BigDecimal"/>
        <parameter name="validFrom" type="Date"/>
        <parameter name="validTo" type="Date"/>
        <actions>
            <entity-find-one entity-name="zenith.erp.sales.CommissionStructure" value-field="_cs"><field-map field-name="commissionId"/></entity-find-one>
            <set field="_org" from="_salesOrgId"/>
            <if condition="_cs == null || ((!_org || _cs.organizationPartyId != _org) &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Commission structure not found for your account."/>
            </if>
            <script><![CDATA[
                if (!rate?.toString()?.trim()) { ec.message.addError('Enter a commission rate.'); return }
                def percent=_cs.commissionTypeEnumId in ['CmtPercentage','CmtTiered']
                def input=ec.service.sync().name('zenith.sales.SalesLineServices.validate#LineInput').parameters([quantity:1,unitAmount:rate,discountPercent:(percent ? rate : 0)]).call()
                if (!input?.valid) return
                def from, to
                try {
                    from=validFrom?.toString()?.trim() ? java.sql.Date.valueOf(validFrom.toString().trim()) : null
                    to=validTo?.toString()?.trim() ? java.sql.Date.valueOf(validTo.toString().trim()) : null
                } catch (IllegalArgumentException ignored) { ec.message.addError('Enter valid commission dates.'); return }
                if ((from != null && to != null && to < from) || (isActive && !(isActive in ['Y','N']))) {
                    ec.message.addError('Enter a valid commission date range and active setting.'); return
                }
                ec.service.sync().name('update#zenith.erp.sales.CommissionStructure').parameters([commissionId:commissionId,rate:input.unitAmountValue,validFrom:from,validTo:to,isActive:isActive]).call()
            ]]></script>
            <return message="Commission structure updated."/>
        </actions>
        <default-response url="../Commissions"/>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.sales.CommissionStructure" value-field="structure"/>
        <set field="_org" from="_salesOrgId"/>
        <!-- deny cross-tenant read: blank out the structure so the form never renders another org's data -->
        <if condition="structure != null &amp;&amp; (!_org || structure.organizationPartyId != _org) &amp;&amp; !ec.user.isInGroup('ADMIN')">
            <set field="structure" from="null"/>
        </if>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="_pd"><field-map field-name="partyId" from="structure?.partyId"/></entity-find-one>
        <set field="salespersonName" from="((_pd?.firstName ?: '') + ' ' + (_pd?.lastName ?: '')).trim() ?: structure?.partyId"/>
        <entity-find-one entity-name="moqui.basic.Enumeration" value-field="_en"><field-map field-name="enumId" from="structure?.commissionTypeEnumId"/></entity-find-one>
        <set field="typeDesc" from="_en?.description ?: structure?.commissionTypeEnumId"/>
    </actions>

    <widgets>
        <container style="zsec-hdr row items-center justify-between q-mb-lg">
            <container style="column">
                <label text="Update Commission Structure" type="h4" style="text-weight-bold q-my-none"/>
                <label text="Adjust the rate and validity${salespersonName ? ' for ' + salespersonName : ''}." type="p" style="text-grey-7 text-caption q-mb-none"/>
            </container>
            <link url="Commissions" text="Back to Commissions" icon="arrow_back" style="z-obtn"/>
        </container>

        <section name="EditCard">
            <condition><expression>structure != null</expression></condition>
            <widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <form-single name="EditForm" transition="updateStructure" map="structure">
                        <field name="commissionId"><default-field><hidden/></default-field></field>
                        <field name="salesperson"><default-field title="Salesperson"><label text="${salespersonName}" type="strong" style="text-dark"/></default-field></field>
                        <field name="commissionTypeDisp"><default-field title="Type"><label text="${typeDesc}" type="span" style="text-dark"/></default-field></field>
                        <field name="rate"><default-field title="Rate / Amount (% or ₹, per the Type above)"><text-line size="10"/></default-field></field>
                        <field name="validFrom"><default-field title="From"><date-time type="date"/></default-field></field>
                        <field name="validTo"><default-field title="To"><date-time type="date"/></default-field></field>
                        <field name="isActive"><default-field title="Active"><drop-down no-current-selected="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitBtn"><default-field title="Save Changes"><submit/></default-field></field>
                    </form-single>
                </container>
            </widgets>
            <fail-widgets>
                <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <label text="This commission structure isn't available for your account." type="span" style="text-warning text-weight-bold"/>
                </container>
            </fail-widgets>
        </section>
    </widgets>
</screen>
