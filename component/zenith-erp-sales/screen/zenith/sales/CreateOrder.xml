<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New Order" default-menu-include="false">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <parameter name="customerPartyId"/>

    <transition name="createOrder">
        <actions>
            <if condition="!_salesOrgId"><return error="true" message="Select an organization before creating a Sales document."/></if>
            <!-- ZE-SB-013 (Tier 1): the customer must belong to this org (mirror CreateInvoice). Guard only when
                 a customerPartyId is supplied so null-customer flows are untouched; a foreign party is rejected. -->
            <if condition="ec.web.parameters.customerPartyId">
                <service-call name="zenith.sales.SalesAccessServices.assert#RecordOrgAccess" out-map="_ca"
                              in-map="[entityName:'mantle.party.Party', idField:'partyId', idValue:ec.web.parameters.customerPartyId, orgField:'ownerPartyId']"/>
                <if condition="!_ca.allowed"><return error="true" message="Please select a valid customer from your account."/></if>
            </if>
            <!-- ZE-PRC-018 f/u: resolve the order's SELLING org. Prefer the user's active org; if none (e.g. a
                 super-admin with no active org) fall back to the selected customer's owner org. A sales order MUST
                 carry a vendor org — without it pricing can't resolve a price list (falls to MRP, so volume/list
                 pricing is ignored, cf. EditOrder/addItem) and org isolation breaks. Reject rather than persist a
                 null-vendor order. -->
            <script><![CDATA[
                _sellOrg = _salesOrgId
                if ((!_sellOrg || _sellOrg == '_NA_') && customerPartyId)
                    _sellOrg = ec.entity.find("mantle.party.Party").condition("partyId", customerPartyId).disableAuthz().one()?.ownerPartyId
            ]]></script>
            <if condition="!_sellOrg || _sellOrg == '_NA_'">
                <return error="true" message="Select an active organization (or a customer) before creating an order."/>
            </if>
            <!-- ZE-SALES: set currencyUomId explicitly (mantle's create#Order otherwise defaults to USD; India-only
                 ERP → INR, matching the quotation and invoice flows). -->
            <service-call name="mantle.order.OrderServices.create#Order" in-map="[orderName:'New Sales Order', entryDate:orderDate, statusId:'OrderPlaced', currencyUomId:'INR', vendorPartyId:_sellOrg, customerPartyId:customerPartyId]" out-map="createOut"/>
            <!-- ZE-SALES: assign a formatted per-org, financial-year sales-order number (SO/26-27/00001). Fail-open
                 to the order id if the org has no SALES_ORDER sequence, so order creation never breaks. -->
            <script><![CDATA[
                try {
                    def _org = _sellOrg   // the resolved selling org (active org, else the customer's owner org)
                    // Only call get#NextSequence when the org has this sequence configured: for a missing sequence
                    // it RETURNS AN ERROR (not an exception) that would roll back the whole order. Best-effort number.
                    def _hasSeq = _org && ec.entity.find("zenith.erp.base.SystemSequence").condition("organizationPartyId", _org).condition("sequenceType", "SALES_ORDER").disableAuthz().count() > 0
                    if (_hasSeq) {
                        def _seq = ec.service.sync().name("zenith.base.SequenceServices.get#NextSequence")
                                    .parameters([organizationPartyId:_org, sequenceType:'SALES_ORDER']).call()
                        if (_seq?.sequenceValue) {
                            // ZE-SALES-0308 f/u: also store the formatted number in mantle's standard customer-facing
                            // displayId so FindOrder ("displayId ?: orderId") and the Order No. search show/find the SO
                            // number, not the raw order id. zenithDocNumber stays for the print/title.
                            ec.service.sync().name("update#mantle.order.OrderHeader")
                                .parameters([orderId:createOut.orderId, zenithDocNumber:_seq.sequenceValue, displayId:_seq.sequenceValue, documentType:'SALES_ORDER']).call()
                        }
                    }
                } catch (Exception e) { ec.logger.warn("Sales-order number generation skipped: " + e.message) }
            ]]></script>
        </actions>
        <default-response url="../EditOrder">
            <parameter name="orderId" from="createOut.orderId"/>
        </default-response>
    <error-response url="."/>
    </transition>
    <transition name="findOrder"><default-response url="../FindOrder"/></transition>
    <transition name="getCustomers" read-only="true">
        <parameter name="term"/>
        <actions>
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="partyList" limit="20" distinct="true">
                <econdition field-name="roleTypeId" value="Customer"/>
                <econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                <econditions combine="or">
                    <econdition field-name="partyId" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true"/>
                </econditions>
                <select-field field-name="partyId,organizationName,firstName,lastName"/>
                <order-by field-name="organizationName,firstName,lastName"/>
            </entity-find>
            <script>
                def outList = []
                for (party in partyList) outList.add([value:party.partyId, label:party.organizationName ?: ((party.firstName?:'') + ' ' + (party.lastName?:'')).trim() + ' [' + party.partyId + ']'])
                if (customerPartyId) {
                    // Org isolation (ZE-SEC-JSON): scope the re-display lookup to the active org too (mirror the
                    // search above) so a forged partyId can't echo another tenant's customer name.
                    def _reAo = _salesOrgId
                    def _reF = ec.entity.find("mantle.party.PartyDetailAndRole").condition("partyId", customerPartyId)
                    _reF.condition("ownerPartyId", _reAo ?: "__NO_SALES_ORGANIZATION__")
                    def existing = _reF.one()
                    if (existing) {
                        outList.add(0, [value:existing.partyId, label:existing.organizationName ?: ((existing.firstName?:'') + ' ' + (existing.lastName?:'')).trim() + ' [' + existing.partyId + ']'])
                    }
                }
                ec.web.sendJsonResponse(outList)
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="activeOrgId" from="_salesOrgId"/>
        <entity-find-one entity-name="mantle.party.Organization" value-field="activeOrg">
            <field-map field-name="partyId" from="activeOrgId"/>
        </entity-find-one>
        <set field="activeOrgName" from="activeOrg?.organizationName ?: activeOrgId"/>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="findOrder" text="Back to Orders" icon="fa fa-arrow-left" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <container-row>
            <row-col lg="8" md="10" sm="12" style="q-mx-auto">
                <container style="zenith-card bg-white shadow-4 border-radius-xl q-pa-xl q-mt-md">
                    <container-row>
                        <row-col>
                            <container style="row items-center q-mb-lg">
                                <container style="q-pa-md bg-indigo-1 border-radius-md q-mr-md text-indigo-8">
                                    <render-mode><text type="html"><![CDATA[<q-icon name="shopping_cart" class="text-h3"/>]]></text></render-mode>
                                </container>
                                <container>
                                    <label text="Create Sales Order" type="h4" style="text-dark text-weight-bolder q-mt-none q-mb-xs"/>
                                    <label text="Pick the customer and date to start a new order." type="p" style="text-grey-7 text-subtitle1 q-mb-none"/>
                                </container>
                            </container>
                            <label text="" type="hr" style="q-mb-xl bg-grey-3" size="1"/>
                        </row-col>
                    </container-row>

                    <form-single name="CreateOrderForm" transition="createOrder">
                        <field name="organizationPartyId"><default-field><hidden default-value="${activeOrgId}"/></default-field></field>
                        <field name="supplierName"><default-field title="From (Supplier)"><display text="${activeOrgName}"/></default-field></field>
                        <field name="customerPartyId"><default-field title="To (Customer)">
                            <drop-down allow-empty="true">
                                <entity-options key="${partyId}" text="${(organizationName ?: ((firstName?:'') + ' ' + (lastName?:'')).trim()) ?: partyId} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetailAndRole" distinct="true">
                                        <econdition field-name="roleTypeId" value="Customer"/>
                                        <econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                                        <order-by field-name="organizationName,firstName,lastName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="orderDate"><default-field title="Order Date"><date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/></default-field></field>
                        <field name="settlementTermId"><default-field title="Payment Terms">
                            <drop-down allow-empty="true">
                                <entity-options key="${settlementTermId}" text="${description}">
                                    <entity-find entity-name="mantle.account.invoice.SettlementTerm">
                                        <order-by field-name="description"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="isReverseCharge"><default-field title="Reverse Charge">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No"/><option key="Y" text="Yes"/>
                            </drop-down>
                        </default-field></field>
                        <field name="isExport"><default-field title="Export Order">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No"/><option key="Y" text="Yes"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="isSezSupply"><default-field title="SEZ Supply">
                            <drop-down no-current-selected-key="N">
                                <option key="N" text="No"/><option key="Y" text="Yes (with payment)"/>
                            </drop-down>
                        </default-field></field>
                        <field name="lutBondNumber"><default-field title="LUT/Bond No."><text-line size="20"/></default-field></field>

                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                                <submit text="Create Order" icon="add_circle" style="bg-indigo-8 text-white shadow-3 q-px-xl q-py-sm text-subtitle1 text-weight-bold q-mt-lg glossy"/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>

                        <field-layout>
                            <field-row>
                                <field-ref name="supplierName"/>
                                <field-ref name="customerPartyId"/>
                            </field-row>
                            <field-ref name="organizationPartyId"/>
                            <field-row>
                                <field-ref name="orderDate"/>
                                <field-ref name="settlementTermId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="isReverseCharge"/>
                                <field-ref name="isExport"/>
                            </field-row>
                            <field-row>
                                <field-ref name="isSezSupply"/>
                                <field-ref name="lutBondNumber"/>
                            </field-row>
                            <field-row>
                                <field-ref name="submitButton"/>
                            </field-row>
                        </field-layout>
                    </form-single>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
