<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Quotation" default-menu-include="false">

    <parameter name="orderId" required="true"/>

    <transition name="findQuotation"><default-response url="../FindQuotation"/></transition>
    <transition name="updateStatus">
        <service-call name="update#mantle.order.OrderHeader"/>
        <default-response url="."/>
    </transition>
    
    <transition name="updateTerms">
        <service-call name="update#mantle.order.OrderPart"/>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <!-- ZE-SALES-0306 f/u: this was a BARE <script> under <transition>, which executes but its writes do
             NOT commit (Moqui gotcha; same defect fixed earlier on EditInvoice) — so quote line items silently
             never persisted. Wrap in <actions> so create#OrderItem commits. -->
        <actions>
        <script>
            // Get addresses to determine IGST vs CGST/SGST
            def orderPart = ec.entity.find("mantle.order.OrderPart").condition("orderId", orderId).one()
            def orderHeader = ec.entity.find("mantle.order.OrderHeader").condition("orderId", orderId).one()

            // GST intra/inter-state from the parties' registered state (tax-registration regionGeoId),
            // matching the invoice service. (Was reading stateProvinceGeoId off PartyContactMechInfo,
            // which has no such field, so it errored or fell back to IGST.)
            // ZE-SALES-020 (SL-075): guard the lookup — partyId is REQUIRED on get#PartyTaxRegistration, so a
            // null customer (a quote with no customer party set) fails its required-field validation, and that
            // error POISONS the rest of the transition (Moqui refuses to run every later service, incl.
            // create#OrderItem) -> "Add Item" silently adds nothing. Only call when the party is set; the elvis
            // chain below already null-tolerates a null registration.
            def _sReg = orderPart.vendorPartyId ? ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:orderPart.vendorPartyId]).call() : null
            def _bReg = orderPart.customerPartyId ? ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:orderPart.customerPartyId]).call() : null
            // ZE-SALES-019 f/u (SL-041): the quote header carries buyer/supplier GSTIN + placeOfSupply (same as
            // an invoice); use those first (place of supply for THIS quote) then the party registration, so an
            // inter-state GSTIN entered on the quote is taxed IGST even when the customer has no saved registration.
            def _st2 = { s -> (s &amp;&amp; s.toString().trim().length() >= 2 &amp;&amp; s.toString().trim().substring(0,2) ==~ /[0-9]{2}/) ? s.toString().trim().substring(0,2) : null }
            def _c2 = { s -> (s &amp;&amp; s.toString().trim() ==~ /[0-9]{2}/) ? s.toString().trim() : null }
            def sellerState = _st2(orderHeader?.supplierGstin) ?: _c2(orderHeader?.supplierStateCode) ?: _c2(_sReg?.regionGeoId) ?: _st2(_sReg?.registrationNumber)
            def buyerState = _st2(orderHeader?.buyerGstin) ?: _c2(orderHeader?.placeOfSupplyStateCode) ?: _c2(_bReg?.regionGeoId) ?: _st2(_bReg?.registrationNumber)
            // ZE-SALES-0306 f/u: default to INTRA-state (CGST+SGST), matching EditInvoice. An unregistered /
            // no-GSTIN buyer has no state, so the place of supply is the seller's state (a local sale) -> intra.
            // Only charge IGST when the buyer's state is KNOWN and differs from the seller's.
            def isInterstate = false
            if (sellerState &amp;&amp; buyerState &amp;&amp; sellerState != buyerState) {
                isInterstate = true
            }

            def qty = new BigDecimal(quantity ?: 0)
            def price = new BigDecimal(unitAmount ?: 0)
            // Sync price with Inventory and Pricing: auto-fill when the user leaves Unit Price blank
            if (price.signum() == 0 &amp;&amp; productId) {
                try {
                    def _pr = ec.service.sync().name("zenith.pricing.PricingServices.calculate#Price")
                                .parameters([productId:productId, quantity:(qty.signum()>0?qty:1), organizationPartyId:orderPart.vendorPartyId, customerPartyId:orderPart.customerPartyId]).call()
                    if (_pr?.unitPrice != null &amp;&amp; (_pr.unitPrice as BigDecimal).signum() == 1) price = _pr.unitPrice as BigDecimal
                } catch (Exception e) { }
                if (price.signum() == 0) {
                    def _p = ec.entity.find("mantle.product.Product").condition("productId", productId).one()
                    if (_p?.mrpAmount != null) price = _p.mrpAmount as BigDecimal
                }
            }
            // ZE-SALES-020 f/u (SL-042): line discount — GST is charged on the DISCOUNTED taxable value.
            def gross = qty.multiply(price)
            def discPct = new BigDecimal(discountPercent ?: 0)
            def discAmt = gross.multiply(discPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
            def taxableVal = gross.subtract(discAmt)
            def taxPct = new BigDecimal(taxPercentage ?: 0)

            def igstRate = 0.0
            def cgstRate = 0.0
            def sgstRate = 0.0
            def igstAmount = 0.0
            def cgstAmount = 0.0
            def sgstAmount = 0.0

            if (taxPct > 0) {
                if (isInterstate) {
                    igstRate = taxPct
                    igstAmount = taxableVal.multiply(taxPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                } else {
                    cgstRate = taxPct.divide(new BigDecimal(2), 2, java.math.RoundingMode.HALF_UP)
                    sgstRate = cgstRate
                    cgstAmount = taxableVal.multiply(cgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                    sgstAmount = cgstAmount
                }
            }

            // Call standard create item service
            def inMap = context + [
                orderPartSeqId: orderPart.orderPartSeqId,
                unitAmount: price,
                taxableAmount: taxableVal,
                discountPercent: discPct, discountAmount: discAmt,
                igstRate: igstRate, igstAmount: igstAmount,
                cgstRate: cgstRate, cgstAmount: cgstAmount,
                sgstRate: sgstRate, sgstAmount: sgstAmount
            ]
            ec.service.sync().name("mantle.order.OrderServices.create#OrderItem").parameters(inMap).call()
        </script>
        </actions>
        <default-response url="."/>
    </transition>
    
    <transition name="createRevision">
        <!-- Clone the current order -->
        <service-call name="mantle.order.OrderServices.clone#Order" in-map="[baseOrderId:orderId]" out-map="cloneOut"/>
        <script>
            // Set cloned order to OrderProposed, increment revision name
            def oldHeader = ec.entity.find("mantle.order.OrderHeader").condition("orderId", orderId).one()
            def revNo = (oldHeader.orderRevision ?: 1) + 1
            def newName = oldHeader.orderName ? (oldHeader.orderName.contains("-v") ? oldHeader.orderName.replaceAll(/-v\d+/, "-v" + revNo) : oldHeader.orderName + "-v" + revNo) : ("Quote-v" + revNo)
            
            ec.service.sync().name("update#mantle.order.OrderHeader").parameters([
                orderId: cloneOut.orderId, 
                statusId: 'OrderProposed',
                orderRevision: revNo,
                orderName: newName
            ]).call()
        </script>
        <default-response url="." parameter-map="[orderId:cloneOut.orderId]"/>
    </transition>

    <transition name="printQuotation" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/OrderPrint" url-type="plain">
            <parameter name="orderId"/>
            <parameter name="printType" value="Quotation"/>
            <parameter name="filename" value="Quotation-${orderId}.pdf"/>
        </default-response>
    </transition>

    <transition name="printProforma" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/OrderPrint" url-type="plain">
            <parameter name="orderId"/>
            <parameter name="printType" value="Proforma"/>
            <parameter name="filename" value="Proforma-${orderId}.pdf"/>
        </default-response>
    </transition>

    <transition name="convertToOrder">
        <actions>
            <!-- ZE-SALES-0307 (SL-016/SL-024): block an ITEM-LESS quote gracefully instead of converting it into
                 an empty order (and guarding against the "Cannot invoke method minus() on null object" crash if the
                 place/total logic ever runs on a null total). Mirrors EditOrder's convertToInvoice guard; also
                 org-scoped so a user can't convert another tenant's quote. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find entity-name="mantle.order.OrderPart" list="_parts"><econdition field-name="orderId"/></entity-find>
            <set field="_ovendor" from="_parts ? _parts[0].vendorPartyId : null"/>
            <if condition="!_parts || (activeOrg &amp;&amp; _ovendor &amp;&amp; _ovendor != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Quote not found for your account."/>
            </if>
            <entity-find-count entity-name="mantle.order.OrderItem" count-field="_itemCnt"><econdition field-name="orderId"/></entity-find-count>
            <if condition="_itemCnt == 0">
                <return error="true" message="This quote has no items yet — add at least one product before converting it to a sales order."/>
            </if>
            <!-- ZE-SALES-0308 f/u: converting a quote makes it a REAL order — reclassify documentType to
                 SALES_ORDER and mint a fresh SO/26-27/xxxxx number so it reads as an order (list/print), not the
                 old QTN quote number, and so a later cancellation is treated as a cancelled ORDER (not a dead
                 quote that FindOrder hides). Fail-open, and mint only on the FIRST conversion (guarded by the
                 current documentType) so a re-convert never double-consumes the SO sequence. -->
            <script><![CDATA[
                def _oh = ec.entity.find("mantle.order.OrderHeader").condition("orderId", orderId).one()
                def _upd = [orderId:orderId, statusId:'OrderPlaced', documentType:'SALES_ORDER']
                if (_oh?.documentType != 'SALES_ORDER') {
                    // preserve the quote's number for traceability before it is renumbered to the SO series
                    if (_oh?.zenithDocNumber) _upd.originatingQuoteNumber = _oh.zenithDocNumber
                    try {
                        def _hasSeq = activeOrg && ec.entity.find("zenith.erp.base.SystemSequence").condition("organizationPartyId", activeOrg).condition("sequenceType", "SALES_ORDER").disableAuthz().count() > 0
                        if (_hasSeq) {
                            def _seq = ec.service.sync().name("zenith.base.SequenceServices.get#NextSequence")
                                        .parameters([organizationPartyId:activeOrg, sequenceType:'SALES_ORDER']).call()
                            if (_seq?.sequenceValue) { _upd.zenithDocNumber = _seq.sequenceValue; _upd.displayId = _seq.sequenceValue }
                        }
                    } catch (Exception e) { ec.logger.warn("SO number on convert skipped: " + e.message) }
                }
                ec.service.sync().name("update#mantle.order.OrderHeader").parameters(_upd).call()
            ]]></script>
        </actions>
        <default-response url="../EditOrder"><parameter name="orderId" value="${orderId}"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>
        
        <entity-find entity-name="mantle.order.OrderPart" list="orderParts">
            <econdition field-name="orderId"/>
        </entity-find>
        <set field="orderPart" from="orderParts?.getFirst()"/>

        <!-- ZE-SALES-0302 (same pattern as the order status bug ZE-SALES-0310): offer only the current status +
             its valid next states, so the dropdown drops e-commerce statuses and backend-rejected transitions. -->
        <entity-find entity-name="moqui.basic.StatusFlowTransition" list="_stTrans">
            <econdition field-name="statusId" from="order?.statusId"/>
        </entity-find>
        <set field="allowedStatusIds" from="(([order?.statusId] + _stTrans.collect{ it.toStatusId }).findAll{ it }).unique()"/>

        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customer">
            <field-map field-name="partyId" from="orderPart?.customerPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>

        <!-- Terms Data Lookups -->
        <entity-find entity-name="moqui.basic.Enumeration" list="tradeTermList">
            <econdition field-name="enumTypeId" value="TradeTerm"/>
            <order-by field-name="description"/>
        </entity-find>
        <entity-find entity-name="mantle.account.invoice.SettlementTerm" list="settlementTermList">
            <order-by field-name="description"/>
        </entity-find>
    </actions>

    <widgets>
        <link url="findQuotation" text="Back to Quotes" link-type="anchor"/>
        
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-3 border-radius-xl q-mb-xl">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="q-pa-md bg-indigo-1 border-radius-md q-mr-md text-indigo-8 shadow-1">
                        <render-mode><text type="html"><![CDATA[<q-icon name="request_quote" class="text-h3"/>]]></text></render-mode>
                    </container>
                    <container style="column">
                        <label text="Quotation ${order?.zenithDocNumber ?: (order?.orderName ?: orderId)}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Revision: ${order.orderRevision ?: 1}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateStatus" map="order">
                        <field name="orderId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="OrderHeader"/>
                                        <econdition field-name="statusId" operator="in" from="allowedStatusIds"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="quoteStatus_write" condition="modCanWrite" title=""><submit text="Update Status" icon="update" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-py-xs q-px-md border-radius-sm shadow-2"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-lg justify-end q-gutter-md border-top q-pt-md">
                <section name="newVersion_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <link url="createRevision" text="New Version" icon="history" style="q-btn q-btn-item non-selectable no-outline q-btn--flat bg-grey-2 text-dark border-radius-sm"/>
                </widgets></section>
                <link url="printQuotation" text="Quotation PDF" parameter-map="[orderId:orderId]" target-window="_blank"
                      icon="fa fa-file-pdf-o" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-grey-9 text-white border-radius-sm shadow-2"/>
                <link url="printProforma" text="Draft Bill (Proforma) PDF" parameter-map="[orderId:orderId]" target-window="_blank"
                      icon="fa fa-file-text-o" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white border-radius-sm shadow-2"/>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Customer Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Name" type="strong" style="text-grey-7 block"/><label text="${customer?.organizationName ?: ((customer?.firstName ?: '') + ' ' + (customer?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Customer ID" type="strong" style="text-grey-7 block"/><label text="${customer?.partyId ?: 'N/A'}" type="span" style="text-dark"/></container>
                    </container>
                </container>

                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Terms &amp; Conditions" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="TermsForm" transition="updateTerms" map="orderPart">
                        <field name="orderId"><default-field><hidden/></default-field></field>
                        <field name="orderPartSeqId"><default-field><hidden/></default-field></field>
                        <field name="validThruDate"><default-field title="Validity Date"><date-time type="date"/></default-field></field>
                        <field name="tradeTermEnumId"><default-field title="Freight Terms">
                            <drop-down allow-empty="true">
                                <list-options list="tradeTermList" key="${enumId}" text="${description}"/>
                                <option key="EXW" text="Ex Works (EXW)"/>
                                <option key="FOR" text="Free on Road (FOR Destination)"/>
                            </drop-down>
                        </default-field></field>
                        <field name="settlementTermId"><default-field title="Payment Terms">
                            <drop-down allow-empty="true">
                                <list-options list="settlementTermList" key="${settlementTermId}" text="${description}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="termsSave_write" condition="modCanWrite" title=""><submit text="Save Terms" icon="save" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-7 text-white q-py-xs q-px-md border-radius-sm shadow-2"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Your Business (Seller)" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Name" type="strong" style="text-grey-7 block"/><label text="${vendor?.organizationName ?: ((vendor?.firstName ?: '') + ' ' + (vendor?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Vendor ID" type="strong" style="text-grey-7 block"/><label text="${vendor?.partyId ?: 'N/A'}" type="span" style="text-dark"/></container>
                    </container>
                </container>

                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Estimated Total Summary" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md">
                        <container style="col-12 col-md-6"><label text="Total Items" type="strong" style="text-grey-7 block"/><label text="${orderItems?.size() ?: 0}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Estimated Grand Total" type="strong" style="text-grey-7 block"/><label text="₹${ec.l10n.format(order.grandTotal ?: 0, '#,##,##0.00')}" type="h4" style="text-primary q-my-none"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Quote Items &amp; Estimated GST" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <section name="quoteItemActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container style="row items-center q-gutter-md">
                    <link url="convertToOrder" text="Convert to Sales Order" icon="fa fa-shopping-cart" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-teal-7 text-white border-radius-sm shadow-2"/>
                    
                    <container-dialog id="AddItemDialog" button-text="Add Item" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white border-radius-sm shadow-2">
                        <form-single name="AddItemForm" transition="addItem">
                            <field name="orderId"><default-field><hidden/></default-field></field>
                            <field name="itemDescription"><default-field title="Description"><text-line size="60"/></default-field></field>
                            <field name="productId"><default-field title="Product">
                                <drop-down allow-empty="true">
                                    <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                        <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field></field>
                            <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                            <field name="unitAmount"><default-field title="Unit Price"><text-line size="12"/></default-field></field>
                            
                            <!-- GST Fields -->
                            <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                            <field name="taxPercentage"><default-field title="GST Rate (%)">
                                <drop-down no-current-selected-key="18">
                                    <option key="0" text="0% (Exempt)"/>
                                    <option key="5" text="5%"/>
                                    <option key="12" text="12%"/>
                                    <option key="18" text="18%"/>
                                    <option key="28" text="28%"/>
                                </drop-down>
                            </default-field></field>
                            <!-- ZE-SALES-020 f/u (SL-042): line discount — GST charged on the discounted value -->
                            <field name="discountPercent"><default-field title="Discount (%)"><text-line size="8" default-value="0"/></default-field></field>

                            <field name="submitButton"><default-field title=""><submit text="Add Item" icon="add" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white border-radius-sm shadow-2"/></default-field></field>
                        </form-single>
                    </container-dialog>
                </container>
                </widgets></section>
            </container>
            <form-list name="OrderItemsForm" list="orderItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="orderItemSeqId"><default-field title="#"><label text="${orderItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="itemDescription"><default-field title="Description"><label text="${itemDescription ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="unitAmount"><default-field title="Unit Price"><label text="${ec.l10n.format(unitAmount, '#,##,##0.00')}" type="span"/></default-field></field>
                <!-- ZE-SALES-020 f/u (SL-042): line discount column -->
                <field name="discount"><default-field title="Discount">
                    <label text="${(discountPercent ?: 0) != 0 ? (discountPercent + '% (₹' + ec.l10n.format(discountAmount ?: 0, '#,##,##0.00') + ')') : '-'}" type="span" style="text-grey-8 text-caption"/>
                </default-field></field>

                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Est. GST">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (₹' + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (₹' + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (₹' + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total (Inc GST)">
                    <label text="${ec.l10n.format((taxableAmount != null ? taxableAmount : ((quantity ?: 0) * (unitAmount ?: 0))) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0), '#,##,##0.00')}" type="span" style="text-weight-bold"/>
                </default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>
    </widgets>
</screen>
