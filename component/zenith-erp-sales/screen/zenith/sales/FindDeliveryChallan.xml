<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Delivery Challans" default-menu-index="6">

    <transition name="createChallan"><default-response url="../CreateDeliveryChallan"/></transition>
    <transition name="editChallan"><default-response url="../EditDeliveryChallan"/></transition>
    <transition name="findChallan"><default-response url="."/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.sales.DeliveryChallan" list="challanList">
            <search-form-inputs default-order-by="-challanDate,challanId"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        
        <!-- Map status colors for the UI -->
        <set field="statusColorMap" from="[
            'ChallanDraft': 'warning',
            'ChallanDispatched': 'primary',
            'ChallanDelivered': 'success',
            'ChallanReturned': 'info',
            'ChallanCancelled': 'danger'
        ]"/>
    </actions>

    <widgets>
        <!-- Moqui <submit> ignores style= (renders bare btn-primary), which ZE-BTN-OUTLINE would outline.
             The mockup wants the Apply CTA SOLID -> force it via id (button-only, so the Clear <a> sharing
             the field id stays outline). /apps-only (#content); /qapps uses the theme CSS id rule. -->
        <render-mode><text type="html"><![CDATA[<style>
#content button#SearchChallanForm_submitButton.btn.btn-primary{background:var(--z-primary,#7C3AED)!important;border-color:var(--z-primary,#7C3AED)!important;color:#fff!important;text-shadow:none!important}
#content button#SearchChallanForm_submitButton.btn.btn-primary:hover{filter:brightness(.93)}
</style>]]></text></render-mode>
        <container style="zsec-hdr row items-center justify-between q-mb-lg">
            <container>
                <label text="Delivery Notes (Challans)" type="h4" style="text-primary text-weight-bold q-my-none"/>
                <label text="A note that travels with goods when you send them out without an invoice — for job work, approval, or transfer." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <section name="NewChallanBtn_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                    <link url="createChallan" text="New Challan" icon="add" style="z-solid q-btn--flat bg-primary text-white border-radius-md q-px-md"/>
                </widgets>
            </section>
        </container>

        <!-- Premium Search & Filter Card -->
        <container style="bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="z-cardhdr">
                <label text="filter_alt" type="span" style="material-icons z-filterbadge"/>
                <label text="Search Challans" type="h6" style="text-dark text-weight-bold q-my-none"/>
            </container>
            <form-single name="SearchChallanForm" transition="findChallan">
                <field name="challanNumber"><default-field title="Challan #"><text-line size="15"/></default-field></field>
                <field name="toPartyId">
                    <default-field title="Receiver Party"><drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]"><entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Customer"/><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find></entity-options></drop-down></default-field>
                </field>
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="ChallanDraft" text="Draft"/>
                            <option key="ChallanDispatched" text="Dispatched"/>
                            <option key="ChallanDelivered" text="Delivered"/>
                            <option key="ChallanReturned" text="Returned"/>
                            <option key="ChallanCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field>
                </field>
                <field name="challanDate"><default-field title="Date"><date-find/></default-field></field>
                <field name="submitButton"><default-field title="">
                    <submit text="Apply" icon="filter_alt" style="q-btn q-btn--flat bg-primary text-white text-weight-medium q-px-md border-radius-sm"/>
                    <link url="." text="Clear" style="q-btn q-btn--flat text-grey-8 q-ml-sm"/>
                </default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="challanNumber"/>
                        <field-ref name="toPartyId"/>
                        <field-ref name="statusId"/>
                        <field-ref name="challanDate"/>
                    </field-row>
                    <field-row>
                        <field-ref name="submitButton"/>
                    </field-row>
                </field-layout>
            </form-single>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-none">
            <form-list name="FindChallanList" list="challanList" header-dialog="true" show-csv-button="true" show-page-size="true" show-xlsx-button="true">

                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                </row-actions>

                <field name="challanId"><header-field title="ID" show-order-by="true"/><default-field><hidden/></default-field></field>
                <field name="challanNumber">
                    <header-field title="Challan #" show-order-by="true"/>
                    <default-field>
                        <link url="editChallan" text="${challanNumber ?: challanId}" parameter-map="[challanId:challanId]" style="z-idbadge"/>
                    </default-field>
                </field>

                <field name="challanDate">
                    <header-field title="Date" show-order-by="true"/>
                    <default-field><label text="${ec.l10n.format(challanDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="toPartyId">
                    <header-field title="Receiver Party"/>
                    <default-field><label text="${toParty?.organizationName ?: (((toParty?.firstName ?: '') + ' ' + (toParty?.lastName ?: '')).trim() ?: 'Walk-in')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="challanType">
                    <header-field title="Type" show-order-by="true"/>
                    <default-field><label text="${challanType ?: '—'}" type="span" style="${challanType ? 'text-grey-8' : 'text-grey-6'}"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Challan', '') : 'Draft'}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="ewayBillId">
                    <header-field title="E-Way Bill"/>
                    <default-field><label text="${ewayBillId ?: '—'}" type="span" style="${ewayBillId ? 'text-grey-8' : 'text-grey-6'}"/></default-field>
                </field>

                <field name="editLink"><header-field title="Actions"/><default-field>
                    <link url="editChallan" text="Review Challan" parameter-map="[challanId:challanId]" style="z-obtn"/>
                </default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
