<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Credit/Debit Note" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="findCreditNote"><default-response url="../FindCreditNote"/></transition>
    
    <transition name="updateInvoice">
        <actions>
            <!-- Org-isolation: verify the note belongs to the active org before any status/field change
                 (block a cross-tenant IDOR), matching the item transitions. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="This credit/debit note was not found for your account."/>
            </if>
            <!-- ZE-SALES-007 (SL-063 f/u): don't let an item-less note be finalized/issued. mantle auto-marks a
                 zero-balance invoice "Payment Received" on finalize, which reads as a broken status change. Only
                 fires on an actual change TO an issued status; draft edits, reason edits, and Cancel stay allowed. -->
            <set field="_newStatus" from="ec.web.parameters.statusId"/>
            <if condition="_newStatus &amp;&amp; _newStatus != curInv.statusId &amp;&amp; _newStatus != 'InvoiceInProcess' &amp;&amp; _newStatus != 'InvoiceCancelled'">
                <entity-find-count entity-name="mantle.account.invoice.InvoiceItem" count-field="_itemCnt">
                    <econdition field-name="invoiceId"/>
                </entity-find-count>
                <if condition="_itemCnt == 0">
                    <return error="true" message="Add at least one item before finalizing or issuing this credit/debit note."/>
                </if>
            </if>
            <service-call name="update#mantle.account.invoice.Invoice" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <actions>
        <!-- ZE-SB-013 (Tier 2): the line-item product must belong to this org. -->
        <if condition="ec.web.parameters.productId">
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_pa"
                          in-map="[entityName:'mantle.product.Product', idField:'productId', idValue:ec.web.parameters.productId, orgField:'ownerPartyId']"/>
            <if condition="!_pa.allowed"><return error="true" message="Please select a valid product from your account."/></if>
        </if>
        <!-- ZE-SALES-002 f/u: match EditInvoice - org-isolation + draft-only guard, and run inside <actions>
             so the new item actually commits (a bare <script> under <transition> does not persist its writes). -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
        <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
            <return error="true" message="Credit note not found for your account."/>
        </if>
        <if condition="curInv.statusId != 'InvoiceInProcess'">
            <return error="true" message="This credit/debit note has been issued (status: ${curInv.statusId}) so its items can no longer be changed."/>
        </if>
        <script>
            // Get state codes
            def invoice = ec.entity.find("mantle.account.invoice.Invoice").condition("invoiceId", invoiceId).one()
            
            // GST intra/inter-state from the parties' registered state (tax-registration regionGeoId),
            // matching the invoice service. (Was reading stateProvinceGeoId off PartyContactMechInfo,
            // which has no such field, so it errored or fell back to IGST.)
            // ZE-SALES-020 (SL-075): guard the lookup — partyId is REQUIRED on get#PartyTaxRegistration, so a
            // null buyer/seller (e.g. a note against a B2C/POS cash-sale invoice with no customer party) makes
            // the service fail its required-field validation, and that error POISONS the rest of the transition
            // (Moqui refuses to run every later service, incl. create#InvoiceItem) -> "Add Adjustment" adds
            // nothing. Only call when the party is set; the elvis chain below already null-tolerates a null reg.
            def _sReg = invoice.fromPartyId ? ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:invoice.fromPartyId]).call() : null
            def _bReg = invoice.toPartyId ? ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:invoice.toPartyId]).call() : null
            // ZE-SALES-019 (SL-041): prefer the note's OWN GSTIN / place-of-supply (what's entered + displayed)
            // over only the party's saved registration, so a GSTIN-on-the-note inter-state case is taxed IGST.
            def _st2 = { s -> (s &amp;&amp; s.toString().trim().length() >= 2 &amp;&amp; s.toString().trim().substring(0,2) ==~ /[0-9]{2}/) ? s.toString().trim().substring(0,2) : null }
            def _c2 = { s -> (s &amp;&amp; s.toString().trim() ==~ /[0-9]{2}/) ? s.toString().trim() : null }
            def sellerState = _st2(invoice.supplierGstin) ?: _c2(invoice.supplierStateCode) ?: _c2(_sReg?.regionGeoId) ?: _st2(_sReg?.registrationNumber)
            def buyerState = _st2(invoice.buyerGstin) ?: _c2(invoice.placeOfSupplyStateCode) ?: _c2(_bReg?.regionGeoId) ?: _st2(_bReg?.registrationNumber)
            // ZE-SALES-0306 f/u: default to INTRA-state (CGST+SGST), matching EditInvoice / the original bill.
            // A no-GSTIN buyer has no state -> place of supply is the seller's state (local) -> intra. Only IGST
            // when the buyer's state is KNOWN and differs from the seller's.
            def isInterstate = false
            if (sellerState &amp;&amp; buyerState &amp;&amp; sellerState != buyerState) {
                isInterstate = true
            }

            def qty = new BigDecimal(quantity ?: 0)
            def price = new BigDecimal(amount ?: 0)
            // ZE-SALES-020 f/u (SL-042): line discount — GST is charged on the DISCOUNTED taxable value.
            def gross = qty.multiply(price)
            def discPct = new BigDecimal(discountPercent ?: 0)
            def discAmt = gross.multiply(discPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
            def taxableVal = gross.subtract(discAmt)
            def taxPct = new BigDecimal(taxPercentage ?: 0)

            def igstRate = 0.0
            def cgstRate = 0.0
            def sgstRate = 0.0
            def igstAmount = 0.0
            def cgstAmount = 0.0
            def sgstAmount = 0.0

            if (taxPct > 0) {
                if (isInterstate) {
                    igstRate = taxPct
                    igstAmount = taxableVal.multiply(taxPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                } else {
                    cgstRate = taxPct.divide(new BigDecimal(2), 2, java.math.RoundingMode.HALF_UP)
                    sgstRate = cgstRate
                    cgstAmount = taxableVal.multiply(cgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                    sgstAmount = cgstAmount
                }
            }

            def inMap = context + [
                itemTypeEnumId: 'ItemSales',
                taxableAmount: taxableVal,
                discountPercent: discPct, discountAmount: discAmt,
                igstRate: igstRate, igstAmount: igstAmount,
                cgstRate: cgstRate, cgstAmount: cgstAmount,
                sgstRate: sgstRate, sgstAmount: sgstAmount
            ]
            ec.service.sync().name("create#mantle.account.invoice.InvoiceItem").parameters(inMap).call()
            
            // Trigger recalculation of totals
            ec.service.sync().name("mantle.account.InvoiceServices.update#InvoiceTotals").parameters([invoiceId:invoiceId]).call()
        </script>
        
        <!-- Custom script to aggregate Indian GST values -->
        <script>
            def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
            def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
            for (def it : invItems) {
                tCgst += (it.cgstAmount ?: 0.0)
                tSgst += (it.sgstAmount ?: 0.0)
                tIgst += (it.igstAmount ?: 0.0)
                tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
            }
            ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                invoiceId: invoiceId,
                invoiceTotal: tTaxable, unpaidTotal: tTaxable,
                totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
            ]).call()
        </script>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="deleteItem">
        <actions>
        <!-- ZE-SALES-002 f/u: match EditInvoice - org-isolation + draft-only guard, inside <actions> so the
             totals recompute commits. -->
        <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
        <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
            <return error="true" message="Credit note not found for your account."/>
        </if>
        <if condition="curInv.statusId != 'InvoiceInProcess'">
            <return error="true" message="This credit/debit note has been issued so its items can no longer be changed."/>
        </if>
        <service-call name="delete#mantle.account.invoice.InvoiceItem" in-map="context"/>
        <script>
            ec.service.sync().name("mantle.account.InvoiceServices.update#InvoiceTotals").parameters([invoiceId:invoiceId]).call()
            
            // Re-aggregate GST values
            def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
            def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
            for (def it : invItems) {
                tCgst += (it.cgstAmount ?: 0.0)
                tSgst += (it.sgstAmount ?: 0.0)
                tIgst += (it.igstAmount ?: 0.0)
                tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
            }
            ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                invoiceId: invoiceId,
                invoiceTotal: tTaxable, unpaidTotal: tTaxable,
                totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
            ]).call()
        </script>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ZE-SALES-002 f/u: edit a line's quantity / unit price (mirrors EditInvoice updateItem). Same guards;
         recompute the line's GST amounts from its stored rates, then refresh the note + Indian-GST totals. -->
    <transition name="updateItem">
        <actions>
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Credit note not found for your account."/>
            </if>
            <if condition="curInv.statusId != 'InvoiceInProcess'">
                <return error="true" message="This credit/debit note has been issued (status: ${curInv.statusId}) so its items can no longer be changed."/>
            </if>
            <script><![CDATA[
                def item = ec.entity.find("mantle.account.invoice.InvoiceItem")
                            .condition("invoiceId", invoiceId).condition("invoiceItemSeqId", invoiceItemSeqId).one()
                if (item == null) { ec.message.addError("Line item not found."); return }
                def qty = new BigDecimal(quantity ?: 0)
                def price = new BigDecimal(amount ?: 0)
                if (qty.signum() <= 0) { ec.message.addError("Quantity must be greater than zero."); return }
                if (price.signum() < 0) { ec.message.addError("Unit price cannot be negative."); return }
                // ZE-SALES-020 f/u (SL-042): keep the line discount when qty/price is edited (use the posted
                // discount if the edit form changed it, else the stored one); GST stays on the discounted value.
                def discPct = new BigDecimal(discountPercent ?: (item.discountPercent ?: 0))
                def gross = qty.multiply(price)
                def discAmt = gross.multiply(discPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                def taxableVal = gross.subtract(discAmt)
                def cgstRate = (item.cgstRate ?: 0.0) as BigDecimal
                def sgstRate = (item.sgstRate ?: 0.0) as BigDecimal
                def igstRate = (item.igstRate ?: 0.0) as BigDecimal
                def cgstAmount = taxableVal.multiply(cgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                def sgstAmount = taxableVal.multiply(sgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                def igstAmount = taxableVal.multiply(igstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                if (curInv.isReverseCharge == 'Y') { cgstAmount = 0.0; sgstAmount = 0.0; igstAmount = 0.0 }
                ec.service.sync().name("update#mantle.account.invoice.InvoiceItem").parameters([
                    invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId,
                    quantity:qty, amount:price, taxableAmount:taxableVal,
                    discountPercent:discPct, discountAmount:discAmt,
                    cgstAmount:cgstAmount, sgstAmount:sgstAmount, igstAmount:igstAmount]).call()
                ec.service.sync().name("mantle.account.InvoiceServices.update#InvoiceTotals").parameters([invoiceId:invoiceId]).call()
                def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
                def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
                for (def it : invItems) {
                    tCgst += (it.cgstAmount ?: 0.0); tSgst += (it.sgstAmount ?: 0.0); tIgst += (it.igstAmount ?: 0.0)
                    tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
                }
                ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                    invoiceId:invoiceId, invoiceTotal:tTaxable, unpaidTotal:tTaxable, totalCgst:tCgst, totalSgst:tSgst, totalIgst:tIgst, totalTaxableAmount:tTaxable]).call()
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="printCreditNote" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/CreditNotePrint" url-type="plain">
            <parameter name="invoiceId"/>
            <parameter name="filename" value="Note-${invoiceId}.pdf"/>
        </default-response>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
        <!-- ZE-SALES-017 (SL-071): explicit org guard on the DISPLAY load — the MANTLE_ACTIVE_ORG authz filter
             is bypassed in a standalone/CSV render, so a crafted invoiceId could otherwise dump another
             tenant's items + change-history. Null a foreign note; super-admin/ADMIN (no active org) see all. -->
        <set field="_dispOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <if condition="invoice != null &amp;&amp; _dispOrg &amp;&amp; invoice.fromPartyId != _dispOrg &amp;&amp; !ec.user.isInGroup('ADMIN')">
            <set field="invoice" from="null"/>
        </if>
        <!-- ZE-SALES-002 f/u: editable only while a draft (In-Process); gate the add/edit/delete controls. -->
        <set field="isDraft" from="invoice?.statusId == 'InvoiceInProcess'"/>

        <!-- ZE-SALES-004 (SL-060): a credit/debit note is a sales (receivable) document; offer only the current
             status + its valid next states in the InvoiceReceivable flow, so the dropdown no longer lists
             statuses the backend rejects (Payment Sent / Received / Acknowledged are not valid moves here). -->
        <entity-find entity-name="moqui.basic.StatusFlowTransition" list="_stTrans">
            <econdition field-name="statusFlowId" value="InvoiceReceivable"/>
            <econdition field-name="statusId" from="invoice?.statusId"/>
        </entity-find>
        <set field="allowedStatusIds" from="(([invoice?.statusId] + _stTrans.collect{ it.toStatusId }).findAll{ it }).unique()"/>

        <set field="invoiceItems" from="[]"/>
        <if condition="invoice != null">
            <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
                <econdition field-name="invoiceId"/>
                <order-by field-name="invoiceItemSeqId"/>
            </entity-find>
        </if>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="supplier">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customer">
            <field-map field-name="partyId" from="invoice?.toPartyId"/>
        </entity-find-one>
        
        <!-- Find original invoice details -->
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="origInv">
            <field-map field-name="invoiceId" from="invoice?.originalInvoiceId"/>
        </entity-find-one>
        
        <set field="docTitle" from="invoice.documentType ?: 'Credit Note'"/>
        <set field="avatarColor" from="invoice.documentType == 'Debit Note' ? 'linear-gradient(135deg, #f59e0b, #d97706)' : 'linear-gradient(135deg, #10b981, #059669)'"/>

        <!-- ZE-SALES-017 (SL-071): change history for THIS note. Moqui auto-logs field changes to
             EntityAuditLog (who/when/old/new); surface them here. Scoped to invoice != null (org-checked
             above) so it can't leak another tenant's history. Whitelist meaningful fields — hide the internal
             payment/GL/timestamp churn. -->
        <set field="historyFieldMap" from="[statusId:'Status', gstInvoiceNumber:'Note Number', supplierGstin:'Supplier GSTIN', buyerGstin:'Buyer GSTIN', isReverseCharge:'Reverse Charge', placeOfSupplyStateCode:'Place of Supply', invoiceMessage:'Reason', documentType:'Document Type', invoiceTotal:'Total Amount', totalTaxableAmount:'Taxable Amount', totalTaxAmount:'Tax Amount', totalCgst:'CGST', totalSgst:'SGST', totalIgst:'IGST', originalInvoiceId:'Original Invoice', toPartyId:'Customer', invoiceDate:'Note Date']"/>
        <set field="noteHistory" from="[]"/>
        <if condition="invoice != null">
            <entity-find entity-name="moqui.entity.EntityAuditLog" list="noteHistory">
                <econdition field-name="changedEntityName" value="mantle.account.invoice.Invoice"/>
                <econdition field-name="pkPrimaryValue" from="invoiceId"/>
                <econdition field-name="changedFieldName" operator="in" value="statusId,gstInvoiceNumber,supplierGstin,buyerGstin,isReverseCharge,placeOfSupplyStateCode,invoiceMessage,documentType,invoiceTotal,totalTaxableAmount,totalTaxAmount,totalCgst,totalSgst,totalIgst,originalInvoiceId,toPartyId,invoiceDate"/>
                <order-by field-name="-changedDate"/>
                <limit count="200"/>
            </entity-find>
        </if>
    </actions>

    <widgets>
        <!-- ZE-SALES-004 (SL-060): the Back link had no icon and no button styling; give it a FontAwesome
             back icon (/apps uses FontAwesome, so Material names like arrow_back render nothing). -->
        <container style="q-mb-md">
            <link url="findCreditNote" text="Back to Notes" icon="fa fa-arrow-left" link-type="anchor" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white; border-radius:12px; background:${avatarColor};">
                        <label text="CDN" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="${docTitle} ${invoice?.gstInvoiceNumber ?: invoiceId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Total: ₹ ${zinr.inr(ec.l10n.format(invoice?.invoiceTotal ?: 0, '#,##,##0.00'))} - Date: ${ec.l10n.format(invoice?.invoiceDate, 'dd MMM yyyy')}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Invoice"/>
                                        <econdition field-name="statusId" operator="in" from="allowedStatusIds"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="cnStatus_write" condition="modCanWrite" title="Update Status"><submit/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-between">
                <container style="bg-grey-2 q-pa-sm border-radius-md">
                    <label text="Linked to Original Invoice: ${origInv?.gstInvoiceNumber ?: origInv?.invoiceId} (Dated ${ec.l10n.format(origInv?.invoiceDate, 'dd MMM yyyy')})" type="span" style="text-dark text-weight-bold"/>
                    <label text=" | Reason: ${invoice?.invoiceMessage ?: 'Sales Return'}" type="span" style="text-grey-7"/>
                </container>
                <link url="printCreditNote" text="Print ${docTitle}" parameter-map="[invoiceId:invoiceId]" target-window="_blank"
                      icon="fa fa-file-pdf-o" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable"/>
            </container>
        </container>

        <!-- Main Sections -->
        <container-row>
            <row-col lg="6">
                <!-- E-Invoice (IRN) & Reason -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Tax &amp; E-Invoice Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="StatutoryForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="einvoiceId"><default-field title="IRN (Invoice Reference Number)"><text-line size="64"/></default-field></field>
                        <field name="buyerGstin"><default-field title="Buyer GSTIN"><text-line size="20"/></default-field></field>
                        <field name="supplierGstin"><default-field title="Supplier GSTIN"><text-line size="20"/></default-field></field>
                        <field name="placeOfSupplyStateCode"><default-field title="Place of Supply (State Code)"><text-line size="4"/></default-field></field>
                        
                        <field name="invoiceMessage">
                            <default-field title="Reason for Issuance">
                                <drop-down>
                                    <option key="Sales Return" text="01 - Sales Return"/>
                                    <option key="Post Sale Discount" text="02 - Post Sale Discount"/>
                                    <option key="Deficiency in Services" text="03 - Deficiency in Services"/>
                                    <option key="Correction in Invoice" text="04 - Correction in Invoice"/>
                                    <option key="Change in POS" text="05 - Change in POS"/>
                                    <option key="Other" text="06 - Other"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="submitButton">
                            <conditional-field name="cnStatutory_write" condition="modCanWrite" title="Save Details"><submit/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Totals Dashboard -->
                <container style="zenith-card q-pa-md bg-indigo-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="Adjustment Tax Breakdown" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md text-center">
                        <container style="col-3"><label text="Taxable" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##0.00'))}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="IGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalIgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="CGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalCgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="SGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalSgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- CDN Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Adjustment Items" type="h5" style="text-primary text-weight-bold q-my-none"/>

                <section name="AddItemSec" condition="isDraft &amp;&amp; modCanWrite"><widgets>
                <container-dialog id="AddItemDialog" button-text="Add Adjustment" button-class="q-btn--flat bg-primary text-white border-radius-md">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                        <field name="amount"><default-field title="Unit Price (Adjustment)"><text-line size="15"/></default-field></field>
                        
                        <!-- GST Field -->
                        <field name="taxPercentage"><default-field title="GST Rate (%)">
                            <drop-down no-current-selected-key="18">
                                <option key="0" text="0% (Exempt)"/>
                                <option key="5" text="5%"/>
                                <option key="12" text="12%"/>
                                <option key="18" text="18%"/>
                                <option key="28" text="28%"/>
                            </drop-down>
                        </default-field></field>
                        <!-- ZE-SALES-020 f/u (SL-042): line discount — GST charged on the discounted value -->
                        <field name="discountPercent"><default-field title="Discount (%)"><text-line size="8" default-value="0"/></default-field></field>

                        <field name="submitButton"><default-field title="Add Item"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets><fail-widgets>
                    <label text="Issued note - locked. Items can no longer be changed; reverse it with an opposite note if needed." type="span" style="text-caption text-warning text-weight-bold"/>
                </fail-widgets></section>
            </container>

            <form-list name="InvoiceItemsForm" list="invoiceItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="invoiceItemSeqId"><default-field title="#"><label text="${invoiceItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><label text="${zinr.inr(ec.l10n.format(amount ?: 0, '#,##,##0.00'))}" type="span"/></default-field></field>
                <!-- ZE-SALES-020 f/u (SL-042): line discount column -->
                <field name="discount"><default-field title="Discount">
                    <label text="${(discountPercent ?: 0) != 0 ? (discountPercent + '% (₹' + zinr.inr(ec.l10n.format(discountAmount ?: 0, '#,##,##0.00')) + ')') : '-'}" type="span" style="text-grey-8 text-caption"/>
                </default-field></field>

                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Calculated GST">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (₹' + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (₹' + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (₹' + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total (Inc GST)">
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format((taxableAmount != null ? taxableAmount : ((quantity ?: 0) * (amount ?: 0))) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0), '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/>
                </default-field></field>
                
                <!-- ZE-SALES-002 f/u: per-row Edit (qty / unit price) on a DRAFT, mirroring EditInvoice. -->
                <field name="editItem"><default-field title="">
                    <section name="EditItemSec" condition="isDraft &amp;&amp; modCanWrite"><widgets>
                        <container-dialog id="EditItemDialog" button-text="Edit" button-class="q-btn--flat text-primary">
                            <form-single name="EditItemForm" transition="updateItem">
                                <field name="invoiceId"><default-field><hidden default-value="${invoiceId}"/></default-field></field>
                                <field name="invoiceItemSeqId"><default-field><hidden default-value="${invoiceItemSeqId}"/></default-field></field>
                                <field name="itemLabel"><default-field title="Item"><label text="${description ?: ('#' + invoiceItemSeqId)}" type="span" style="text-dark text-weight-bold"/></default-field></field>
                                <field name="quantity"><default-field title="Quantity"><text-line size="10" default-value="${quantity}"/></default-field></field>
                                <field name="amount"><default-field title="Unit Price"><text-line size="15" default-value="${amount}"/></default-field></field>
                                <field name="discountPercent"><default-field title="Discount (%)"><text-line size="8" default-value="${discountPercent ?: 0}"/></default-field></field>
                                <field name="submitButton"><default-field title=""><submit text="Save" style="q-btn bg-primary text-white border-radius-sm glossy"/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets></section>
                </default-field></field>
                <!-- ZE-SALES-002 f/u: delete carries text so /apps renders its FontAwesome icon; gated to drafts. -->
                <field name="deleteItem"><default-field title=" ">
                    <section name="DeleteItemSec" condition="isDraft &amp;&amp; modCanWrite"><widgets>
                        <link url="deleteItem" text="Remove" parameter-map="[invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId]" icon="fa fa-trash-o" class="q-btn--flat text-negative" confirmation="Remove item?"/>
                    </widgets></section>
                </default-field></field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>

        <!-- ZE-SALES-017 (SL-071): Change History / audit trail for this note -->
        <container style="zenith-card bg-white shadow-1 border-radius-lg q-pa-lg q-mt-lg">
            <label text="Change History" type="h5" style="text-primary text-weight-bold q-my-none"/>
            <label text="Every edit to this note is recorded automatically — who changed it, when, and the old and new value." type="p" style="text-grey-7 q-mt-xs q-mb-md"/>
            <form-list name="NoteHistoryForm" list="noteHistory" skip-form="true">
                <row-actions>
                    <entity-find-one entity-name="moqui.security.UserAccount" value-field="_hu"><field-map field-name="userId" from="changedByUserId"/></entity-find-one>
                    <set field="whoChanged" from="_hu?.username ?: (changedByUserId ?: 'System')"/>
                    <set field="fieldLabel" from="historyFieldMap[changedFieldName] ?: changedFieldName"/>
                    <set field="oldVal" from="oldValueText != null ? (oldValueText.startsWith('Invoice') ? oldValueText.substring(7) : oldValueText) : '(none)'"/>
                    <set field="newVal" from="newValueText != null ? (newValueText.startsWith('Invoice') ? newValueText.substring(7) : newValueText) : '-'"/>
                </row-actions>
                <field name="changedDate"><header-field title="When" show-order-by="true"/><default-field><display format="dd MMM yyyy, hh:mm a"/></default-field></field>
                <field name="whoCol"><header-field title="Changed By"/><default-field><display text="${whoChanged}"/></default-field></field>
                <field name="fieldCol"><header-field title="Field"/><default-field><display text="${fieldLabel}" style="text-weight-bold"/></default-field></field>
                <field name="oldCol"><header-field title="Old Value"/><default-field><display text="${oldVal}" style="text-grey-7"/></default-field></field>
                <field name="newCol"><header-field title="New Value"/><default-field><display text="${newVal}" style="text-weight-bold text-primary"/></default-field></field>
            </form-list>
            <label text="No changes recorded yet." type="p" style="text-grey-6 q-pa-md text-center" condition="!noteHistory"/>
        </container>

    </widgets>
</screen>
