<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Credit/Debit Note" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="findCreditNote"><default-response url="../FindCreditNote"/></transition>
    
    <transition name="updateInvoice">
        <service-call name="update#mantle.account.invoice.Invoice"/>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <script>
            // Get state codes
            def invoice = ec.entity.find("mantle.account.invoice.Invoice").condition("invoiceId", invoiceId).one()
            
            // GST intra/inter-state from the parties' registered state (tax-registration regionGeoId),
            // matching the invoice service. (Was reading stateProvinceGeoId off PartyContactMechInfo,
            // which has no such field, so it errored or fell back to IGST.)
            def _sReg = ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:invoice.fromPartyId]).call()
            def _bReg = ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:invoice.toPartyId]).call()
            def sellerState = _sReg?.regionGeoId
            def buyerState = _bReg?.regionGeoId
            def isInterstate = true
            if (sellerState &amp;&amp; buyerState &amp;&amp; sellerState == buyerState) {
                isInterstate = false
            }

            def qty = new BigDecimal(quantity ?: 0)
            def price = new BigDecimal(amount ?: 0)
            def taxableVal = qty.multiply(price)
            def taxPct = new BigDecimal(taxPercentage ?: 0)

            def igstRate = 0.0
            def cgstRate = 0.0
            def sgstRate = 0.0
            def igstAmount = 0.0
            def cgstAmount = 0.0
            def sgstAmount = 0.0

            if (taxPct > 0) {
                if (isInterstate) {
                    igstRate = taxPct
                    igstAmount = taxableVal.multiply(taxPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                } else {
                    cgstRate = taxPct.divide(new BigDecimal(2), 2, java.math.RoundingMode.HALF_UP)
                    sgstRate = cgstRate
                    cgstAmount = taxableVal.multiply(cgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                    sgstAmount = cgstAmount
                }
            }

            def inMap = context + [
                itemTypeEnumId: 'ItemSales',
                taxableAmount: taxableVal,
                igstRate: igstRate, igstAmount: igstAmount,
                cgstRate: cgstRate, cgstAmount: cgstAmount,
                sgstRate: sgstRate, sgstAmount: sgstAmount
            ]
            ec.service.sync().name("create#mantle.account.invoice.InvoiceItem").parameters(inMap).call()
            
            // Trigger recalculation of totals
            ec.service.sync().name("mantle.account.InvoiceServices.calculate#InvoiceTotal").parameters([invoiceId:invoiceId]).call()
        </script>
        
        <!-- Custom script to aggregate Indian GST values -->
        <script>
            def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
            def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
            for (def it : invItems) {
                tCgst += (it.cgstAmount ?: 0.0)
                tSgst += (it.sgstAmount ?: 0.0)
                tIgst += (it.igstAmount ?: 0.0)
                tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
            }
            ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                invoiceId: invoiceId,
                totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
            ]).call()
        </script>

        <default-response url="."/>
    </transition>

    <transition name="deleteItem">
        <service-call name="delete#mantle.account.invoice.InvoiceItem"/>
        <script>
            ec.service.sync().name("mantle.account.InvoiceServices.calculate#InvoiceTotal").parameters([invoiceId:invoiceId]).call()
            
            // Re-aggregate GST values
            def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
            def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
            for (def it : invItems) {
                tCgst += (it.cgstAmount ?: 0.0)
                tSgst += (it.sgstAmount ?: 0.0)
                tIgst += (it.igstAmount ?: 0.0)
                tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
            }
            ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                invoiceId: invoiceId,
                totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
            ]).call()
        </script>
        <default-response url="."/>
    </transition>

    <transition name="printCreditNote" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/CreditNotePrint" url-type="plain">
            <parameter name="invoiceId"/>
            <parameter name="filename" value="Note-${invoiceId}.pdf"/>
        </default-response>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
        
        <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
            <econdition field-name="invoiceId"/>
            <order-by field-name="invoiceItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="supplier">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customer">
            <field-map field-name="partyId" from="invoice?.toPartyId"/>
        </entity-find-one>
        
        <!-- Find original invoice details -->
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="origInv">
            <field-map field-name="invoiceId" from="invoice?.originalInvoiceId"/>
        </entity-find-one>
        
        <set field="docTitle" from="invoice.documentType ?: 'Credit Note'"/>
        <set field="avatarColor" from="invoice.documentType == 'Debit Note' ? 'linear-gradient(135deg, #f59e0b, #d97706)' : 'linear-gradient(135deg, #10b981, #059669)'"/>
    </actions>

    <widgets>
        <link url="findCreditNote" text="Back to Notes" link-type="anchor"/>
        
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white; border-radius:12px; background:${avatarColor};">
                        <label text="CDN" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="${docTitle} ${invoice?.gstInvoiceNumber ?: invoiceId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Total: ₹ ${ec.l10n.format(invoice?.invoiceTotal ?: 0, '#,##,##0.00')} - Date: ${ec.l10n.format(invoice?.invoiceDate, 'dd MMM yyyy')}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Invoice"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title="Update Status"><submit/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-between">
                <container style="bg-grey-2 q-pa-sm border-radius-md">
                    <label text="Linked to Original Invoice: ${origInv?.gstInvoiceNumber ?: origInv?.invoiceId} (Dated ${ec.l10n.format(origInv?.invoiceDate, 'dd MMM yyyy')})" type="span" style="text-dark text-weight-bold"/>
                    <label text=" | Reason: ${invoice?.invoiceMessage ?: 'Sales Return'}" type="span" style="text-grey-7"/>
                </container>
                <link url="printCreditNote" text="Print ${docTitle}" parameter-map="[invoiceId:invoiceId]" target-window="_blank"
                      icon="fa fa-file-pdf-o" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable"/>
            </container>
        </container>

        <!-- Main Sections -->
        <container-row>
            <row-col lg="6">
                <!-- E-Invoice (IRN) & Reason -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Tax &amp; E-Invoice Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="StatutoryForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="einvoiceId"><default-field title="IRN (Invoice Reference Number)"><text-line size="64"/></default-field></field>
                        <field name="buyerGstin"><default-field title="Buyer GSTIN"><text-line size="20"/></default-field></field>
                        <field name="supplierGstin"><default-field title="Supplier GSTIN"><text-line size="20"/></default-field></field>
                        <field name="placeOfSupplyStateCode"><default-field title="Place of Supply (State Code)"><text-line size="4"/></default-field></field>
                        
                        <field name="invoiceMessage">
                            <default-field title="Reason for Issuance">
                                <drop-down>
                                    <option key="Sales Return" text="01 - Sales Return"/>
                                    <option key="Post Sale Discount" text="02 - Post Sale Discount"/>
                                    <option key="Deficiency in Services" text="03 - Deficiency in Services"/>
                                    <option key="Correction in Invoice" text="04 - Correction in Invoice"/>
                                    <option key="Change in POS" text="05 - Change in POS"/>
                                    <option key="Other" text="06 - Other"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="submitButton"><default-field title="Save Details"><submit/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Totals Dashboard -->
                <container style="zenith-card q-pa-md bg-indigo-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="Adjustment Tax Breakdown" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md text-center">
                        <container style="col-3"><label text="Taxable" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="IGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalIgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="CGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalCgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="SGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalSgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- CDN Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Adjustment Items" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <container-dialog id="AddItemDialog" button-text="Add Adjustment" button-class="q-btn--flat bg-primary text-white border-radius-md">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                        <field name="amount"><default-field title="Unit Price (Adjustment)"><text-line size="15"/></default-field></field>
                        
                        <!-- GST Field -->
                        <field name="taxPercentage"><default-field title="GST Rate (%)">
                            <drop-down no-current-selected-key="18">
                                <option key="0" text="0% (Exempt)"/>
                                <option key="5" text="5%"/>
                                <option key="12" text="12%"/>
                                <option key="18" text="18%"/>
                                <option key="28" text="28%"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="submitButton"><default-field title="Add Item"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>

            <form-list name="InvoiceItemsForm" list="invoiceItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="invoiceItemSeqId"><default-field title="#"><label text="${invoiceItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><label text="${ec.l10n.format(amount ?: 0, '#,##,##0.00')}" type="span"/></default-field></field>
                
                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Calculated GST">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (₹' + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (₹' + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (₹' + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total (Inc GST)">
                    <label text="${currSymbol}${ec.l10n.format(((quantity ?: 0) * (amount ?: 0)) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0), '#,##,##0.00')}" type="span" style="text-weight-bold text-dark"/>
                </default-field></field>
                
                <field name="deleteItem">
                    <default-field title=" ">
                        <link url="deleteItem" parameter-map="[invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId]" icon="delete" style="text-danger" confirmation="Remove item?"/>
                    </default-field>
                </field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>

    </widgets>
</screen>
