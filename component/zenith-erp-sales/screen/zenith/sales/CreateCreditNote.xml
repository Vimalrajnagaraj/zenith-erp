<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Create Credit/Debit Note" default-menu-include="false">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <transition name="createCreditNote">
        <parameter name="originalInvoiceId"/>
        <parameter name="documentType"/>
        <parameter name="invoiceDate" type="Timestamp"/>
        <!-- ZE-SALES-005 (SL-061): the "Reason for Issuance" (invoiceMessage) was submitted but never declared
             or saved, so the credit note was created with a null reason. Declare + persist it below. -->
        <parameter name="invoiceMessage"/>
        <actions>
            <if condition="!_salesOrgId"><return error="true" message="Select an organization before creating a Sales document."/></if>
            <entity-find-one entity-name="mantle.party.Party" value-field="_numberOrg" for-update="true"><field-map field-name="partyId" from="_salesOrgId"/></entity-find-one>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="origInv">
                <field-map field-name="invoiceId" from="originalInvoiceId"/>
            </entity-find-one>
            <set field="__activeOrg" from="_salesOrgId"/>
            <if condition="origInv != null &amp;&amp; origInv.fromPartyId == __activeOrg">
                <set field="cnType" from="documentType == 'Debit Note' ? 'InvoiceSalesDebit' : 'InvoiceSalesReturn'"/>
                <!-- ZE-SALES-005 f/u: a manually-entered Note Number must be unique within the org (mirrors
                     CreateInvoice; different tenants may reuse numbers, so scope by fromPartyId). Matches any
                     invoice OR note in the org, so a note number can't collide with an invoice number. -->
                <set field="manualNum" from="ec.web.parameters.gstInvoiceNumber?.trim()"/>
                <if condition="manualNum">
                    <entity-find entity-name="mantle.account.invoice.Invoice" list="dupNotes">
                        <econdition field-name="fromPartyId" from="__activeOrg"/>
                        <econdition field-name="gstInvoiceNumber" from="manualNum"/>
                    </entity-find>
                    <if condition="dupNotes">
                        <return error="true" message="Note number '${manualNum}' is already used by another document in your organization. Enter a unique number, or leave it blank to auto-generate."/>
                    </if>
                </if>
                <service-call name="create#mantle.account.invoice.Invoice" out-map="createOut"
                    in-map="[invoiceTypeEnumId:cnType, statusId:'InvoiceInProcess', fromPartyId:origInv.fromPartyId, toPartyId:origInv.toPartyId, originalInvoiceId:originalInvoiceId, documentType:documentType, invoiceMessage:invoiceMessage, invoiceDate:(invoiceDate ?: ec.user.nowTimestamp), currencyUomId:(origInv.currencyUomId ?: 'INR')]"/>
                <!-- ZE-SALES-005 f/u: assign the note number - honor a manual one, else auto-generate a per-FY
                     series (CN/26-27/<id> for a credit note, DN/... for a debit note), like the invoice number. -->
                <if condition="manualNum">
                    <service-call name="update#mantle.account.invoice.Invoice" in-map="[invoiceId:createOut.invoiceId, gstInvoiceNumber:manualNum]"/>
                    <else>
                        <service-call name="zenith.base.LocalizationServices.get#FinancialYearDates" out-map="_fy" in-map="[organizationPartyId:_salesOrgId, referenceDate:(ec.web.parameters.invoiceDate ?: ec.user.nowTimestamp)]"/>
                <set field="__fy" from="ec.l10n.format(_fy.fyStartDate, 'yy') + (ec.l10n.format(_fy.fyStartDate, 'yy') != ec.l10n.format(_fy.fyEndDate, 'yy') ? '-' + ec.l10n.format(_fy.fyEndDate, 'yy') : '')"/>
                        <set field="__pfx" from="documentType == 'Debit Note' ? 'DN' : 'CN'"/>
                        <service-call name="update#mantle.account.invoice.Invoice" in-map="[invoiceId:createOut.invoiceId, gstInvoiceNumber:(__pfx + '/' + __fy + '/' + createOut.invoiceId), financialYearPrefix:__fy]"/>
                    </else>
                </if>
                <!-- ZE-SHOP: the credit/debit note inherits the original invoice's shop -->
                <if condition="origInv.facilityId">
                    <service-call name="update#mantle.account.invoice.Invoice" in-map="[invoiceId:createOut.invoiceId, facilityId:origInv.facilityId]"/>
                </if>
                <else>
                    <script>ec.message.addError("Original Invoice " + (originalInvoiceId ?: '') + " not found.")</script>
                </else>
            </if>
        </actions>
        <default-response url="../EditCreditNote">
            <parameter name="invoiceId" value="${createOut?.invoiceId}"/>
        </default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="mantle.account.invoice.Invoice" list="originalInvoices">
            <econdition field-name="invoiceTypeEnumId" value="InvoiceSales"/>
            <econdition field-name="fromPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
            <order-by field-name="-invoiceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="../FindCreditNote" text="Back to Credit Notes" icon="fa fa-arrow-left" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <container-row>
            <row-col lg="8" md="10" sm="12" style="q-mx-auto">
                <container style="zenith-card bg-white shadow-4 border-radius-xl q-pa-xl q-mt-md">
                    <container-row>
                        <row-col>
                            <container style="row items-center q-mb-lg">
                                <container style="q-pa-md bg-blue-1 border-radius-md q-mr-md text-blue-8">
                                    <render-mode><text type="html"><![CDATA[<q-icon name="keyboard_return" class="text-h3"/>]]></text></render-mode>
                                </container>
                                <container>
                                    <label text="Create Credit / Debit Note" type="h4" style="text-dark text-weight-bolder q-mt-none q-mb-xs"/>
                                    <label text="Start a credit or debit note linked to the original invoice you're correcting." type="p" style="text-grey-7 text-subtitle1 q-mb-none"/>
                                </container>
                            </container>
                            <label text="" type="hr" style="q-mb-xl bg-grey-3" size="1"/>
                        </row-col>
                    </container-row>

                    <form-single name="CreateCDNForm" transition="createCreditNote">
                        <field name="documentType">
                            <default-field title="Document Type">
                                <drop-down no-current-selected-key="Credit Note">
                                    <option key="Credit Note" text="Credit Note (Reduce Tax Liability)"/>
                                    <option key="Debit Note" text="Debit Note (Increase Tax Liability)"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="originalInvoiceId">
                            <default-field title="Original Tax Invoice">
                                <drop-down allow-empty="false">
                                    <list-options list="originalInvoices" key="${invoiceId}" text="${gstInvoiceNumber?:invoiceId} - ${currSymbol}${invoiceTotal?:0}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="invoiceMessage">
                            <default-field title="Reason for Issuance">
                                <drop-down allow-empty="false" no-current-selected-key="Sales Return">
                                    <option key="Sales Return" text="01 - Sales Return"/>
                                    <option key="Post Sale Discount" text="02 - Post Sale Discount"/>
                                    <option key="Deficiency in Services" text="03 - Deficiency in Services"/>
                                    <option key="Correction in Invoice" text="04 - Correction in Invoice"/>
                                    <option key="Change in POS" text="05 - Change in POS"/>
                                    <option key="Other" text="06 - Other"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="invoiceDate">
                            <default-field title="Note Date">
                                <date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/>
                            </default-field>
                        </field>
                        
                        <field name="gstInvoiceNumber">
                            <default-field title="Note Number (Optional)">
                                <text-line/>
                            </default-field>
                        </field>

                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                                <submit text="Create CDN" style="q-btn bg-blue-8 text-white glossy full-width q-py-sm text-subtitle1 q-mt-md"/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
