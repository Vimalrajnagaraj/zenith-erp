<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" standalone="true">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <parameter name="orderId" required="true"/>

    <actions>
        <set field="activeOrgId" from="_salesOrgId"/>
        <service-call name="zenith.sales.SalesAccessServices.assert#RecordOrgAccess" in-map="[entityName:'mantle.order.OrderPart', idField:'orderId', idValue:orderId, orgField:'vendorPartyId']" out-map="_printAccess"/>
        <!-- Stop before fetching private records or producing an FO/PDF response. -->
        <if condition="!_printAccess.allowed">
            <script>throw new org.moqui.context.ArtifactAuthorizationException('Order print access denied.')</script>
        </if>
        <entity-find-one entity-name="mantle.order.OrderHeader" value-field="order"/>
        <entity-find entity-name="mantle.order.OrderPart" list="orderParts">
            <econdition field-name="orderId"/>
        </entity-find>
        <set field="orderPart" from="orderParts?.getFirst()"/>
        <set field="orderItems" from="[]"/>
        <if condition="order != null">
            <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
                <econdition field-name="orderId"/>
                <order-by field-name="orderItemSeqId"/>
            </entity-find>
        </if>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customerParty">
            <field-map field-name="partyId" from="orderPart?.customerPartyId"/>
        </entity-find-one>
        
        <if condition="orderPart?.vendorPartyId">
            <service-call name="mantle.party.ContactServices.get#PartyContactInfo" in-map="[partyId:orderPart?.vendorPartyId]" out-map="vendorContactInfo"/>
        </if>
        <if condition="orderPart?.customerPartyId">
            <service-call name="mantle.party.ContactServices.get#PartyContactInfo" in-map="[partyId:orderPart?.customerPartyId]" out-map="customerContactInfo"/>
        </if>

        <set field="templateLocation" value="component://zenith-erp-sales/template/sales/OrderPrint.xsl-fo.ftl"/>
    </actions>
    <widgets>
        <render-mode><text type="xsl-fo" location="${templateLocation}" template="true" encode="false" no-boundary-comment="true"/></render-mode>
    </widgets>
</screen>
