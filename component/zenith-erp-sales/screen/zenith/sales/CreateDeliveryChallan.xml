<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Create Challan" default-menu-include="false">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <transition name="createChallan">
        <actions>
            <if condition="!_salesOrgId"><return error="true" message="Select an organization before creating a Sales document."/></if>
            <!-- ZE-SB-013 (Tier 1): the recipient (customerPartyId) must belong to this org; guard only when supplied. -->
            <if condition="ec.web.parameters.customerPartyId">
                <service-call name="zenith.sales.SalesAccessServices.assert#RecordOrgAccess" out-map="_ca"
                              in-map="[entityName:'mantle.party.Party', idField:'partyId', idValue:ec.web.parameters.customerPartyId, orgField:'ownerPartyId']"/>
                <if condition="!_ca.allowed"><return error="true" message="Please select a valid customer from your account."/></if>
            </if>
            <if condition="!customerPartyId"><return error="true" message="Select a customer before creating a delivery challan."/></if>
            <service-call name="create#zenith.erp.sales.DeliveryChallan" in-map="[customerPartyId:customerPartyId,challanNumber:challanNumber,challanDate:challanDate,challanType:challanType,returnDueDate:returnDueDate,vehicleNumber:vehicleNumber,transporterId:transporterId,lrNumber:lrNumber,notes:notes,statusId:'DcDraft',organizationPartyId:_salesOrgId]" out-map="createOut"/>
            <!-- Generate generic Challan Number if not provided -->
            <script>
                if (!challanNumber) {
                    def chNum = "CH-" + createOut.challanId
                    ec.service.sync().name("update#zenith.erp.sales.DeliveryChallan")
                      .parameters([challanId:createOut.challanId, challanNumber:chNum]).call()
                }
            </script>
        </actions>
        <default-response url="../EditDeliveryChallan">
            <parameter name="challanId" value="${createOut.challanId}"/>
        </default-response>
    <error-response url="."/>
    </transition>

    <actions>
        <!-- Get active internal organizations -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <!-- Org isolation: tenant sees only its own org in the picker (admin with no active org sees all). -->
            <econdition field-name="partyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <order-by field-name="organizationName"/>
        </entity-find>
        <set field="defaultOrgId" from="orgList?.getFirst()?.partyId"/>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="../FindDeliveryChallan" text="Back to Challans" icon="fa fa-arrow-left" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <container-row>
            <row-col lg="8" md="10" sm="12" style="q-mx-auto">
                <container style="zenith-card bg-white shadow-4 border-radius-xl q-pa-xl q-mt-md">
                    <container-row>
                        <row-col>
                            <container style="row items-center q-mb-lg">
                                <container style="q-pa-md bg-indigo-1 border-radius-md q-mr-md text-indigo-8">
                                    <render-mode><text type="html"><![CDATA[<q-icon name="local_shipping" class="text-h3"/>]]></text></render-mode>
                                </container>
                                <container>
                                    <label text="Create Delivery Challan" type="h4" style="text-dark text-weight-bolder q-mt-none q-mb-xs"/>
                                    <label text="Start a delivery note for goods you're sending out without an invoice." type="p" style="text-grey-7 text-subtitle1 q-mb-none"/>
                                </container>
                            </container>
                            <label text="" type="hr" style="q-mb-xl bg-grey-3" size="1"/>
                        </row-col>
                    </container-row>

                    <form-single name="CreateChallanForm" transition="createChallan">
                        <field name="organizationPartyId">
                            <default-field title="From Organization">
                                <drop-down current="selected">
                                    <list-options list="orgList" key="${partyId}" text="${organizationName}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="customerPartyId">
                            <default-field title="To Party (Customer/Receiver)">
                                <drop-down>
                                    <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Customer"/>
                                            <econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="challanType">
                            <default-field title="Challan Type">
                                <drop-down no-current-selected-key="Job Work">
                                    <option key="Job Work" text="Job Work"/>
                                    <option key="Sent on Approval" text="Sent on Approval"/>
                                    <option key="Liquid Gas Supply" text="Liquid Gas Supply"/>
                                    <option key="Exhibition" text="Exhibition"/>
                                    <option key="Line Sales" text="Line Sales"/>
                                    <option key="Other" text="Other"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="challanDate">
                            <default-field title="Challan Date">
                                <date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/>
                            </default-field>
                        </field>
                        
                        <field name="challanNumber">
                            <default-field title="Challan Number (Optional)"><text-line/></default-field>
                        </field>

                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="">
                                <submit text="Create Challan" icon="local_shipping" style="bg-indigo-8 text-white shadow-3 q-px-xl q-py-sm text-subtitle1 text-weight-bold q-mt-lg glossy"/>
                            </conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>

                        <field-layout>
                            <field-row>
                                <field-ref name="organizationPartyId"/>
                                <field-ref name="customerPartyId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="challanType"/>
                                <field-ref name="challanDate"/>
                            </field-row>
                            <field-row>
                                <field-ref name="challanNumber"/>
                            </field-row>
                            <field-row>
                                <field-ref name="submitButton"/>
                            </field-row>
                        </field-layout>
                    </form-single>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
