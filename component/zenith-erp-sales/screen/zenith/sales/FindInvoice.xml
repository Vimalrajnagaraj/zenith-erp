<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices" default-menu-index="3">

    <transition name="editInvoice"><default-response url="../EditInvoice"/></transition>
    <transition name="findInvoice"><default-response url="."/></transition>

    <actions>
        <set field="statusColorMap" from="[
            'InvoiceIn-Process': 'grey',
            'InvoiceApproved': 'primary',
            'InvoiceSent': 'info',
            'InvoiceReady': 'warning',
            'InvoicePaid': 'success',
            'InvoiceCancelled': 'danger'
        ]"/>
        
        <entity-find entity-name="mantle.account.invoice.Invoice" list="invoiceList">
            <search-form-inputs default-order-by="-invoiceDate,invoiceId"/>
            <econdition field-name="fromPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Invoices" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Bills you send customers for what they've bought. GST is worked out automatically on every sale." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <section name="NewInvoiceBtn_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                    <link url="../CreateInvoice" text="New Invoice" icon="post_add" style="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md"/>
                </widgets>
            </section>
        </container>

        <!-- Premium Search & Filter Card -->
        <container style="bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container-row>
                <row-col><label text="Search Invoices" type="h6" style="text-dark text-weight-bold q-mt-none q-mb-md"/></row-col>
            </container-row>
            <form-single name="SearchInvoiceForm" transition="findInvoice">
                <field name="gstInvoiceNumber"><default-field title="Invoice No."><text-line size="15"/></default-field></field>
                <field name="toPartyId">
                    <default-field title="Customer"><drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]"><entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Customer"/><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find></entity-options></drop-down></default-field>
                </field>
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIn-Process" text="In Process"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoiceSent" text="Sent"/>
                            <option key="InvoiceReady" text="Ready"/>
                            <option key="InvoicePaid" text="Paid"/>
                            <option key="InvoiceCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field>
                </field>
                <field name="invoiceDate"><default-field title="Date"><date-find/></default-field></field>
                <field name="submitButton"><default-field title="">
                    <submit text="Apply" icon="filter_alt" style="q-btn q-btn--flat bg-indigo-7 text-white text-weight-medium q-px-md border-radius-sm"/>
                    <link url="." text="Clear" style="q-btn q-btn--flat text-grey-8 q-ml-sm"/>
                </default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="gstInvoiceNumber"/>
                        <field-ref name="toPartyId"/>
                        <field-ref name="statusId"/>
                        <field-ref name="invoiceDate"/>
                    </field-row>
                    <field-row>
                        <field-ref name="submitButton"/>
                    </field-row>
                </field-layout>
            </form-single>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-none">
            <form-list name="FindInvoiceList" list="invoiceList" header-dialog="true" show-csv-button="true" show-page-size="true" show-xlsx-button="true">

                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="customerName" from="toParty?.organizationName ?: ((toParty?.firstName ?: '') + ' ' + (toParty?.lastName ?: '')).trim()"/>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                    <!-- If this invoice came from a POS counter sale, surface how it was paid and when the
                         sale was started/closed. Blank for manually-raised invoices. -->
                    <script><![CDATA[
                        posPayment = ''; posSaleStarted = null; posSaleClosed = null
                        def posTxn = ec.entity.find("zenith.erp.pos.PosTransaction")
                            .condition("linkedInvoiceId", invoiceId).list().find { true }
                        if (posTxn) {
                            posSaleStarted = posTxn.entryDate
                            posSaleClosed = posTxn.completedDate
                            def pays = ec.entity.find("zenith.erp.pos.PosPayment")
                                .condition("transactionId", posTxn.transactionId).orderBy("paymentDate").list()
                            if (pays) {
                                posPayment = pays.collect { it.paymentMethod ?: 'Other' }.unique().join(', ')
                                if (!posSaleClosed) { def pd = pays.collect { it.paymentDate }.findAll { it }; if (pd) posSaleClosed = pd.max() }
                            } else if (posTxn.isCredit == 'Y') { posPayment = 'Credit' }
                            if (!posSaleClosed) posSaleClosed = posTxn.lastUpdatedStamp
                        }
                    ]]></script>
                </row-actions>

                <field name="invoiceId"><header-field title="ID" show-order-by="true"/><default-field><hidden/></default-field></field>
                
                <field name="gstInvoiceNumber">
                    <header-field title="Invoice No." show-order-by="true">
                        <text-find default-operator="contains"/>
                    </header-field>
                    <default-field>
                        <link url="editInvoice" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="text-weight-bold text-indigo-8 text-decoration-none"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><label text="${ec.l10n.format(invoiceDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="toPartyId">
                    <header-field title="Customer"><drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]"><entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Customer"/><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find></entity-options></drop-down></header-field>
                    <default-field>
                        <section name="gate_contacts_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="/apps/zenith/Contacts/EditContact" text="${customerName}" style="text-primary text-weight-bold" parameter-map="[partyId:toPartyId]" link-type="anchor"/></widgets></section>
                    </default-field>
                </field>
                
                <field name="buyerGstin">
                    <header-field title="GSTIN"><text-find default-operator="contains"/></header-field>
                    <default-field><label text="${buyerGstin ?: 'Unregistered'}" type="span" style="${buyerGstin ? 'text-dark' : 'text-grey-7'}"/></default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Total (${currSymbol})" show-order-by="true"/>
                    <default-field><label text="${ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00')}" type="span" style="text-weight-bold text-dark"/></default-field>
                </field>

                <field name="posPayment">
                    <header-field title="Payment (POS)"/>
                    <default-field>
                        <label text="${posPayment ?: '—'}" type="span" style="${posPayment ? ('zenith-badge ' + (posPayment == 'Credit' ? 'warning' : 'success')) : 'text-grey-6'}"/>
                    </default-field>
                </field>

                <field name="posSaleStarted">
                    <header-field title="Sale Started"/>
                    <default-field><label text="${posSaleStarted ? ec.l10n.format(posSaleStarted, 'dd MMM, hh:mm:ss a') : '—'}" type="span" style="${posSaleStarted ? 'text-grey-8' : 'text-grey-6'}"/></default-field>
                </field>

                <field name="posSaleClosed">
                    <header-field title="Sale Closed"/>
                    <default-field><label text="${posSaleClosed ? ec.l10n.format(posSaleClosed, 'dd MMM, hh:mm:ss a') : '—'}" type="span" style="${posSaleClosed ? 'text-grey-8' : 'text-grey-6'}"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIn-Process" text="In Process"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoiceSent" text="Sent"/>
                            <option key="InvoiceReady" text="Ready"/>
                            <option key="InvoicePaid" text="Paid"/>
                            <option key="InvoiceCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Invoice', '') : 'In Process'}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="einvoiceId">
                    <header-field title="E-Invoice (IRN)"><text-find default-operator="contains"/></header-field>
                    <default-field><label text="${einvoiceId ? 'Yes' : 'No'}" type="span" style="zenith-badge ${einvoiceId ? 'success' : 'grey'}"/></default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <section name="gate_accounting_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('accounting'))"><widgets><link url="/apps/zenith/Accounting/Invoices" text="Ledger" icon="account_balance_wallet" class="q-btn q-btn--outline q-btn--rectangle q-btn--sm text-secondary bg-white" parameter-map="[invoiceId:invoiceId]" link-type="anchor"/></widgets></section>
                    </default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
