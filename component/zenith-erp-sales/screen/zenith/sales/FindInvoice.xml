<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoices" default-menu-index="3">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <transition name="editInvoice"><default-response url="../EditInvoice"/></transition>
    <transition name="findInvoice"><default-response url="."/></transition>

    <actions>
        <!-- Pill/icon colour by REAL invoice status (mockup: Finalized=green, InProcess=blue, Cancelled=red). -->
        <set field="statusColorMap" from="[
            'InvoiceFinalized': 'success',
            'InvoiceInProcess': 'info',
            'InvoiceCancelled': 'danger',
            'InvoicePmtRecvd': 'success',
            'InvoiceReceived': 'info',
            'InvoiceIncoming': 'warning',
            'InvoiceSent': 'info',
            'InvoiceApproved': 'primary',
            'InvoiceReady': 'warning',
            'InvoicePaid': 'success'
        ]"/>

        <entity-find entity-name="mantle.account.invoice.Invoice" list="invoiceList">
            <search-form-inputs skip-fields="organizationPartyId,fromPartyId,vendorPartyId,ownerPartyId,invoiceTypeEnumId" default-order-by="-invoiceDate,invoiceId"/>
            <econdition field-name="fromPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
            <econdition field-name="invoiceTypeEnumId" value="InvoiceSales"/>
        </entity-find>
        <!-- ZE-SALES-014 (SL-068) sweep: (1) gate the page title/subtitle + Search block to screen-only so
             they don't leak onto line 1 of the CSV export; (2) set currSymbol (was unset -> "Total ()") and use
             an ASCII label in CSV so the '₹' (no BOM) doesn't mojibake as "â‚¹" in Excel. -->
        <set field="isCsv" from="sri.getRenderMode() == 'csv'"/>
        <set field="currSymbol" from="isCsv ? 'Rs.' : '₹'"/>
    </actions>

    <widgets>
        <section name="ScreenOnlyChrome" condition="!isCsv"><widgets>
        <!-- Moqui <submit> ignores style= (renders bare btn-primary), which ZE-BTN-OUTLINE would outline.
             The mockup wants the Apply CTA SOLID -> force it via id (button-only, so the Clear <a> sharing
             the field id stays outline). /apps-only (#content); /qapps uses the theme CSS id rule. -->
        <render-mode><text type="html"><![CDATA[<style>
#content button#SearchInvoiceForm_submitButton.btn.btn-primary{background:var(--z-primary,#7C3AED)!important;border-color:var(--z-primary,#7C3AED)!important;color:#fff!important;text-shadow:none!important}
#content button#SearchInvoiceForm_submitButton.btn.btn-primary:hover{filter:brightness(.93)}
</style>]]></text></render-mode>
        <container style="zsec-hdr row items-center justify-between q-mb-lg">
            <container>
                <label text="Invoices" type="h4" style="text-primary text-weight-bold q-my-none"/>
                <label text="Bills you send customers for what they've bought. GST is worked out automatically on every sale." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <section name="NewInvoiceBtn_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                    <link url="../CreateInvoice" text="New Invoice" icon="add" style="z-solid q-btn--flat bg-primary text-white border-radius-md q-px-md"/>
                </widgets>
            </section>
        </container>

        <!-- Premium Search & Filter Card -->
        <container style="bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container style="z-cardhdr">
                <label text="filter_alt" type="span" style="material-icons z-filterbadge"/>
                <label text="Search Invoices" type="h6" style="text-dark text-weight-bold q-my-none"/>
            </container>
            <form-single name="SearchInvoiceForm" transition="findInvoice">
                <field name="gstInvoiceNumber"><default-field title="Invoice No."><text-line size="15"/></default-field></field>
                <field name="toPartyId">
                    <default-field title="Customer"><drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]"><entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Customer"/><econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/></entity-find></entity-options></drop-down></default-field>
                </field>
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceInProcess" text="In Process"/>
                        <option key="InvoiceFinalized" text="Finalized"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoiceSent" text="Sent"/>
                            <option key="InvoiceAcked" text="Acknowledged"/>
                            <option key="InvoicePmtRecvd" text="Payment Received"/>
                            <option key="InvoiceCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field>
                </field>
                <field name="invoiceDate"><default-field title="Date"><date-find/></default-field></field>
                <field name="submitButton"><default-field title="">
                    <submit text="Apply" icon="filter_alt" style="q-btn q-btn--flat bg-primary text-white text-weight-medium q-px-md border-radius-sm"/>
                    <link url="." text="Clear" style="q-btn q-btn--flat text-grey-8 q-ml-sm"/>
                </default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="gstInvoiceNumber"/>
                        <field-ref name="toPartyId"/>
                        <field-ref name="statusId"/>
                        <field-ref name="invoiceDate"/>
                    </field-row>
                    <field-row>
                        <field-ref name="submitButton"/>
                    </field-row>
                </field-layout>
            </form-single>
        </container>

        </widgets></section>
        <container style="zenith-card z-fitlist bg-white shadow-2 border-radius-lg q-pa-none z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search invoices..." style="display:none"></span>]]></text></render-mode>
            <section name="SalesHtmlList" condition="!isCsv"><widgets>
            <form-list name="FindInvoiceList" list="invoiceList" header-dialog="true" show-csv-button="true" show-page-size="true" show-xlsx-button="true">

                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="customerName" from="toParty?.organizationName ?: ((toParty?.firstName ?: '') + ' ' + (toParty?.lastName ?: '')).trim()"/>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                    <!-- If this invoice came from a POS counter sale, surface how it was paid and when the
                         sale was started/closed. Blank for manually-raised invoices. -->
                    <script><![CDATA[
                        posPayment = ''; posSaleStarted = null; posSaleClosed = null
                        def posTxn = ec.entity.find("zenith.erp.pos.PosTransaction")
                            .condition("linkedInvoiceId", invoiceId).list().find { true }
                        if (posTxn) {
                            posSaleStarted = posTxn.entryDate
                            posSaleClosed = posTxn.completedDate
                            def pays = ec.entity.find("zenith.erp.pos.PosPayment")
                                .condition("transactionId", posTxn.transactionId).orderBy("paymentDate").list()
                            if (pays) {
                                posPayment = pays.collect { it.paymentMethod ?: 'Other' }.unique().join(', ')
                                if (!posSaleClosed) { def pd = pays.collect { it.paymentDate }.findAll { it }; if (pd) posSaleClosed = pd.max() }
                            } else if (posTxn.isCredit == 'Y') { posPayment = 'Credit' }
                            if (!posSaleClosed) posSaleClosed = posTxn.lastUpdatedStamp
                        }
                    ]]></script>
                </row-actions>

                <field name="invoiceId"><header-field title="ID" show-order-by="true"/><default-field><hidden/></default-field></field>

                <field name="statusIcon">
                    <header-field title=""/>
                    <default-field><label text="receipt_long" type="span" style="material-icons z-sico ${statusColor}"/></default-field>
                    <csv-field><ignored/></csv-field>
                </field>

                <field name="gstInvoiceNumber">
                    <header-field title="Invoice No." show-order-by="true"/>
                    <default-field>
                        <link url="editInvoice" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="z-idbadge"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <default-field><label text="event" type="span" style="material-icons z-cellico"/><label text="${ec.l10n.format(invoiceDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="toPartyId">
                    <header-field title="Customer"/>
                    <default-field>
                        <container style="z-custwrap">
                            <label text="person" type="span" style="material-icons z-cellico"/>
                            <section name="gate_contacts_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="/apps/zenith/Contacts/ContactProfile" text="${customerName}" style="text-primary text-weight-bold z-custlink" parameter-map="[partyId:toPartyId]" link-type="anchor"/></widgets></section>
                        </container>
                    </default-field>
                </field>

                <field name="buyerGstin">
                    <header-field title="GSTIN"/>
                    <default-field><label text="${buyerGstin ?: 'Unregistered'}" type="span" style="${buyerGstin ? 'text-dark' : 'text-grey-7'}"/></default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Taxable (${currSymbol})" show-order-by="true"/>
                    <default-field><label text="${zinr.inr(ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/></default-field>
                </field>

                <!-- ZE-SALES: POS payment + sale times kept in the CSV export only (mockup drops them from the
                     on-screen table for a cleaner 8-column layout). -->
                <field name="posPayment">
                    <header-field title="Payment (POS)"/>
                    <default-field><ignored/></default-field>
                    <csv-field><display text="${posPayment ?: ''}"/></csv-field>
                </field>

                <field name="posSaleStarted">
                    <header-field title="Sale Started"/>
                    <default-field><ignored/></default-field>
                    <csv-field><display text="${posSaleStarted ? ec.l10n.format(posSaleStarted, 'yyyy-MM-dd HH:mm:ss') : ''}"/></csv-field>
                </field>

                <field name="posSaleClosed">
                    <header-field title="Sale Closed"/>
                    <default-field><ignored/></default-field>
                    <csv-field><display text="${posSaleClosed ? ec.l10n.format(posSaleClosed, 'yyyy-MM-dd HH:mm:ss') : ''}"/></csv-field>
                </field>

                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${statusItem?.description ?: (statusId ? statusId.replace('Invoice', '') : 'In Process')}" type="span" style="zenith-badge nd ${statusColor}"/>
                    </default-field>
                </field>

                <field name="einvoiceId">
                    <header-field title="E-Invoice (IRN)"><text-find default-operator="contains"/></header-field>
                    <default-field><ignored/></default-field>
                    <csv-field><display text="${einvoiceId ? 'Yes' : 'No'}"/></csv-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <default-field>
                        <link url="editInvoice" text="View" icon="visibility" style="z-obtn" parameter-map="[invoiceId:invoiceId]"/>
                        <link url="/fop/apps/zenith/sales/InvoicePrint" text="" icon="download" style="z-obtn z-obtn-ico q-ml-xs" parameter-map="[invoiceId:invoiceId]" link-type="anchor" url-type="plain" target="_blank"/>
                    </default-field>
                </field>
            </form-list>
            </widgets></section>
        </container>

        <!-- CSV uses plain display fields on the already filtered/scoped list. HTML
             links/icons and the shell's zinr formatter are unavailable in CSV mode. -->
        <section name="SalesCsvExport" condition="isCsv"><widgets>
            <form-list name="FindInvoiceCsv" list="invoiceList">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="_csvParty"><field-map field-name="partyId" from="toPartyId"/></entity-find-one>
                    <set field="_csvCustomer" from="_csvParty?.organizationName ?: ((_csvParty?.firstName ?: '') + ' ' + (_csvParty?.lastName ?: '')).trim()"/>
                </row-actions>
                <field name="gstInvoiceNumber"><header-field title="Invoice No."/><default-field><display text="${gstInvoiceNumber ?: invoiceId}"/></default-field></field>
                <field name="invoiceDate"><header-field title="Date"/><default-field><display text="${ec.l10n.format(invoiceDate, 'yyyy-MM-dd')}"/></default-field></field>
                <field name="toPartyId"><header-field title="Customer"/><default-field><display text="${_csvCustomer}"/></default-field></field>
                <field name="buyerGstin"><header-field title="GSTIN"/><default-field><display text="${buyerGstin ?: ''}"/></default-field></field>
                <field name="invoiceTotal"><header-field title="Taxable (INR)"/><default-field><display text="${invoiceTotal ?: 0}"/></default-field></field>
                <field name="totalTaxAmount"><header-field title="GST (INR)"/><default-field><display text="${totalTaxAmount ?: 0}"/></default-field></field>
                <field name="statusId"><header-field title="Status"/><default-field><display text="${statusId}"/></default-field></field>
            </form-list>
        </widgets></section>
    </widgets>
</screen>
