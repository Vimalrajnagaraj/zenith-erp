<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Orders" default-menu-index="2">

    <transition name="findOrder"><default-response url="."/></transition>
    <transition name="editOrder"><default-response url="../EditOrder"/></transition>
    <transition name="createOrder"><default-response url="../CreateOrder"/></transition>

    <actions>
        <!-- ZE-SALES-0308 (same as FindQuotation): the Customer box is a free-text NAME search, but customerPartyId
             holds a party id, so a typed name never matched. Resolve the name to matching customer party ids first. -->
        <set field="customerSearch" from="ec.context.customerSearch"/>
        <if condition="customerSearch">
            <set field="_likeVal" from="'%' + customerSearch.toString().trim() + '%'"/>
            <entity-find entity-name="mantle.party.PartyDetail" list="_custMatches" distinct="true">
                <select-field field-name="partyId"/>
                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" from="_likeVal" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" from="_likeVal" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" from="_likeVal" ignore-case="true"/>
                </econditions>
            </entity-find>
            <set field="_custIds" from="_custMatches.collect{ it.partyId } ?: ['__NO_MATCH__']"/>
        </if>
        <!-- ZE-SALES-0308 f/u: Order No. is a CONTAINS search over the internal orderId AND the customer-facing
             displayId (the SO/26-27/00001 number), not an exact orderId equals. Empty box -> _qno null -> skipped. -->
        <set field="_qno" from="ec.context.orderNoSearch ? '%' + ec.context.orderNoSearch.toString().trim() + '%' : null"/>
        <!-- ZE-SALES-0308 f/u: a QUOTATION that was CANCELLED (never became an order) leaked into the Orders list,
             because OrderCancelled isn't in the excluded Proposed/Rejected set. documentType lives on the base
             OrderHeader, not the OrderHeaderAndPart view, so collect those dead-quote ids here and exclude them
             below. A CONVERTED quote (QUOTATION + OrderPlaced) is NOT collected -> it correctly stays in Orders. -->
        <entity-find entity-name="mantle.order.OrderHeader" list="_deadQuotes">
            <econdition field-name="documentType" value="QUOTATION"/>
            <econdition field-name="statusId" value="OrderCancelled"/>
            <select-field field-name="orderId"/>
        </entity-find>
        <set field="_deadQuoteIds" from="_deadQuotes.collect{ it.orderId } ?: ['__NONE__']"/>
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="orderList">
            <search-form-inputs default-order-by="-entryDate"/>
<!-- ZE-SALES-014 f/u (cross-tenant CSV leak): source the active org DIRECTLY, not via the parent-set
                 activeOrgId var, which is empty in the CSV/standalone render -> ignore-if-empty then skipped the
                 filter and the CSV dumped every tenant's orders (incl. MARUTHI). -->
            <econdition field-name="vendorPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <econdition field-name="statusId" operator="not-in" value="OrderProposed,OrderRejected"/>
            <econdition field-name="orderId" operator="not-in" from="_deadQuoteIds"/>
            <econdition field-name="customerPartyId" operator="in" from="_custIds" ignore-if-empty="true"/>
            <econditions combine="or">
                <econdition field-name="orderId" operator="like" from="_qno" ignore-if-empty="true" ignore-case="true"/>
                <econdition field-name="displayId" operator="like" from="_qno" ignore-if-empty="true" ignore-case="true"/>
            </econditions>
        </entity-find>
        <!-- ZE-SALES-014 (SL-068) sweep: in a CSV export Moqui renders the whole screen, so the page
             title/subtitle + Search block leak onto line 1 before the real column headers. Gate them to screen-only. -->
        <set field="isCsv" from="sri.getRenderMode() == 'csv'"/>
    </actions>

    <widgets>
        <section name="ScreenOnlyChrome" condition="!isCsv"><widgets>
        <container style="q-mb-md">
            <container style="row items-center justify-between">
                <container>
                    <label text="Sales Orders" type="h4" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Orders your customers have placed. Track them here, then turn them into invoices when you deliver." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                </container>
                <container>
                    <section name="NewOrderBtn_write">
                        <condition><expression>modCanWrite</expression></condition>
                        <widgets>
                            <link url="createOrder" text="New Order" icon="add" style="q-btn--flat bg-primary text-white border-radius-md q-px-md"/>
                        </widgets>
                    </section>
                </container>
            </container>
        </container>

        <!-- Premium Search & Filter Card -->
        <container style="bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container-row>
                <row-col><label text="Search Orders" type="h6" style="text-dark text-weight-bold q-mt-none q-mb-md"/></row-col>
            </container-row>
            <form-single name="SearchOrderForm" transition="findOrder">
                <field name="orderNoSearch"><default-field title="Order No."><text-line size="15"/></default-field></field>
                <field name="customerSearch"><default-field title="Customer"><text-line size="15" placeholder="Name…"/></default-field></field>
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="OrderHeader"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </default-field>
                </field>
                <field name="entryDate"><default-field title="Date"><date-find/></default-field></field>
                <field name="submitButton"><default-field title="">
                    <submit text="Apply" icon="filter_alt" style="bg-indigo-7 text-white text-weight-medium q-px-md border-radius-sm"/>
                    <link url="findOrder" text="Clear" style="q-btn--flat text-grey-8 q-ml-sm"/>
                </default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="orderNoSearch"/>
                        <field-ref name="customerSearch"/>
                        <field-ref name="statusId"/>
                        <field-ref name="entryDate"/>
                    </field-row>
                    <field-row>
                        <field-ref name="submitButton"/>
                    </field-row>
                </field-layout>
            </form-single>
        </container>

        </widgets></section>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-none">
            <form-list name="OrderListForm" list="orderList" header-dialog="true"
                       show-csv-button="true" show-page-size="true" show-xlsx-button="true">
                <row-actions>
                    <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                    <set field="statusColor" from="statusId == 'OrderApproved' ? 'primary' : (statusId == 'OrderCompleted' ? 'success' : (statusId == 'OrderCancelled' ? 'danger' : 'warning'))"/>
                    <entity-find-one entity-name="moqui.basic.Enumeration" value-field="channelEnum">
                        <field-map field-name="enumId" from="salesChannelEnumId"/>
                    </entity-find-one>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customerDetail">
                        <field-map field-name="partyId" from="customerPartyId"/>
                    </entity-find-one>
                    <set field="customerName" from="customerDetail?.organizationName ?: ((customerDetail?.firstName ?: '') + ' ' + (customerDetail?.lastName ?: '')).trim()"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="Order No." show-order-by="true"/>
                    <default-field><link url="editOrder" text="${displayId ?: orderId}" style="text-weight-bold text-indigo-8 text-decoration-none" parameter-map="[orderId:orderId]"/></default-field>
                    <csv-field><display text="${displayId ?: orderId}"/></csv-field>
                </field>
                <field name="orderName">
                    <default-field><ignored/></default-field>
                    <csv-field title="Order Name"><display/></csv-field>
                </field>
                <field name="entryDate">
                    <header-field title="Date" show-order-by="true"/>
                    <default-field><label text="${ec.l10n.format(entryDate, 'dd MMM yyyy')}" type="span" style="text-grey-9"/></default-field>
                    <csv-field><display text="${ec.l10n.format(entryDate, 'yyyy-MM-dd')}"/></csv-field>
                </field>
                <field name="placedDate">
                    <default-field><ignored/></default-field>
                    <csv-field title="Placed Date"><display text="${placedDate ? ec.l10n.format(placedDate, 'yyyy-MM-dd') : ''}"/></csv-field>
                </field>
                <field name="customerPartyId">
                    <header-field title="Customer"/>
                    <default-field>
                        <section name="gate_contacts_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="/apps/zenith/Contacts/ContactProfile" text="${customerName}" style="text-primary text-weight-bold" parameter-map="[partyId:customerPartyId]" link-type="anchor"/></widgets></section>
                    </default-field>
                    <csv-field><display text="${customerName}"/></csv-field>
                </field>
                <field name="vendorPartyId">
                    <default-field><ignored/></default-field>
                    <csv-field title="Supplier"><display-entity entity-name="mantle.party.PartyDetail" text="${(pseudoId ?: partyId)}: ${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></csv-field>
                </field>
                <field name="grandTotal">
                    <header-field title="Total" show-order-by="true"/>
                    <default-field><label text="${currSymbol}${zinr.inr(ec.l10n.format(grandTotal ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/></default-field>
                    <csv-field><display text="${grandTotal ?: 0}"/></csv-field>
                </field>
                <field name="currencyUomId">
                    <default-field><ignored/></default-field>
                    <csv-field title="Currency"><display/></csv-field>
                </field>
                <field name="salesChannelEnumId">
                    <default-field><ignored/></default-field>
                    <csv-field title="Sales Channel"><display text="${channelEnum?.description ?: salesChannelEnumId ?: ''}"/></csv-field>
                </field>
                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field><label text="${statusItem?.description ?: statusId}" type="span" style="zenith-badge ${statusColor}"/></default-field>
                    <csv-field><display text="${statusItem?.description ?: statusId}"/></csv-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
