<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Delivery Challan" default-menu-include="false">

    <parameter name="challanId" required="true"/>

    <transition name="findChallan"><default-response url="../FindDeliveryChallan"/></transition>
    
    <transition name="updateChallan">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.sales.DeliveryChallan', idField:'challanId', idValue:challanId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="update#zenith.erp.sales.DeliveryChallan" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <actions>
            <!-- ZE-SB-013 (Tier 2): the line-item product must belong to this org. -->
            <if condition="ec.web.parameters.productId">
                <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_pa"
                              in-map="[entityName:'mantle.product.Product', idField:'productId', idValue:ec.web.parameters.productId, orgField:'ownerPartyId']"/>
                <if condition="!_pa.allowed"><return error="true" message="Please select a valid product from your account."/></if>
            </if>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.sales.DeliveryChallan', idField:'challanId', idValue:challanId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="create#zenith.erp.sales.DeliveryChallanItem" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="deleteItem">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.sales.DeliveryChallan', idField:'challanId', idValue:challanId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="delete#zenith.erp.sales.DeliveryChallanItem" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="printChallan" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/ChallanPrint" url-type="plain">
            <parameter name="challanId"/>
            <parameter name="filename" value="DeliveryChallan-${challanId}.pdf"/>
        </default-response>
    </transition>

    <actions>
        <!-- ZE-SALES cross-tenant IDOR render guard: only the owning org (super-admins exempt) may open this
             challan. Deterministic org check. Load NOTHING when blocked; widgets show a plain no-access panel
             instead of another tenant's challan / sender / receiver data. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.sales.DeliveryChallan', idField:'challanId', idValue:challanId, orgField:'organizationPartyId']" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.sales.DeliveryChallan" value-field="challan"/>

        <entity-find entity-name="zenith.erp.sales.DeliveryChallanItem" list="challanItems">
            <econdition field-name="challanId"/>
            <order-by field-name="itemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="fromParty">
            <field-map field-name="partyId" from="challan?.organizationPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
            <field-map field-name="partyId" from="challan?.toPartyId"/>
        </entity-find-one>
        
        <!-- Get Transporter List -->
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="transporterList">
            <econdition field-name="roleTypeId" value="Carrier"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        </if>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="findChallan" text="Back to Challans" icon="fa fa-arrow-left" style="q-btn q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <!-- Cross-tenant / missing delivery challan — plain notice, never another org's challan data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That delivery challan isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use the back link above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white; border-radius:12px; background:linear-gradient(135deg, #10b981, #059669);">
                        <label text="DC" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="Delivery Challan ${challan?.challanNumber ?: challanId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="${challan?.challanType ?: 'Job Work'} - ${ec.l10n.format(challan?.challanDate, 'dd MMM yyyy')}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateChallan" map="challan">
                        <field name="challanId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <option key="ChallanDraft" text="Draft"/>
                                <option key="ChallanDispatched" text="Dispatched"/>
                                <option key="ChallanDelivered" text="Delivered"/>
                                <option key="ChallanReturned" text="Returned"/>
                                <option key="ChallanCancelled" text="Cancelled"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton">
                            <conditional-field name="challanStatus_write" condition="modCanWrite" title=""><submit text="Update Status" style="q-btn q-btn--flat bg-primary text-white border-radius-sm"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-end q-gutter-sm">
                <link url="printChallan" text="Print Delivery Note" parameter-map="[challanId:challanId]" target-window="_blank"
                      icon="fa fa-print" class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable"/>
            </container>
        </container>

        <container-row>
            <row-col lg="6">
                <!-- Receiver Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Sender &amp; Receiver" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md q-mb-md">
                        <container style="col-12 col-md-6"><label text="Sender" type="strong" style="text-grey-7 block"/><label text="${fromParty?.organizationName ?: ((fromParty?.firstName ?: '') + ' ' + (fromParty?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                        <container style="col-12 col-md-6"><label text="Receiver" type="strong" style="text-grey-7 block"/><label text="${toParty?.organizationName ?: ((toParty?.firstName ?: '') + ' ' + (toParty?.lastName ?: '')).trim()}" type="span" style="text-dark"/></container>
                    </container>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- Transporter & E-Way Bill Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Transport &amp; E-Way Bill" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="TransportForm" transition="updateChallan" map="challan">
                        <field name="challanId"><default-field><hidden/></default-field></field>
                        
                        <field name="ewayBillId"><default-field title="E-Way Bill No."><text-line size="20"/></default-field></field>
                        <field name="vehicleNumber"><default-field title="Vehicle No."><text-line size="15"/></default-field></field>
                        <field name="transporterId"><default-field title="Transporter">
                            <drop-down allow-empty="true">
                                <list-options list="transporterList" key="${partyId}" text="${organizationName?:firstName} ${lastName?:''}"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="submitButton">
                            <conditional-field name="challanTransport_write" condition="modCanWrite" title=""><submit text="Save Transport Details" style="q-btn q-btn--flat bg-indigo-7 text-white text-weight-bold q-px-md border-radius-sm"/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </container>
            </row-col>
        </container-row>

        <!-- Challan Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Challan Goods" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <section name="addGoods_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddItemDialog" button-text="Add Goods" button-icon="add_circle" button-class="q-btn q-btn--flat bg-teal-8 text-white text-weight-bold q-px-md border-radius-sm">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="challanId"><default-field><hidden/></default-field></field>
                        
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                        <field name="uomId"><default-field title="Unit of Measure">
                            <drop-down allow-empty="true">
                                <entity-options key="${uomId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Uom"><econdition field-name="uomTypeEnumId" operator="in" value="UomVolume,UomWeight,UomLength,UomArea,UomQuantity"/><order-by field-name="description"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="estimatedValue"><default-field title="Est. Taxable Value (${currSymbol})"><text-line size="15"/></default-field></field>
                        
                        <field name="submitButton"><default-field title=""><submit text="Add Goods" style="q-btn q-btn--flat bg-primary text-white border-radius-sm"/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>

            <form-list name="ChallanItemsForm" list="challanItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <row-actions>
                    <entity-find-one entity-name="moqui.basic.Uom" value-field="uom"/>
                </row-actions>
                <field name="itemSeqId"><default-field title="#"><label text="${itemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity} ${uom?.description ?: ''}" type="span" style="text-dark"/></default-field></field>
                <field name="estimatedValue"><default-field title="Est. Taxable Value"><label text="${currSymbol}${zinr.inr(ec.l10n.format(estimatedValue ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold"/></default-field></field>
                
                <field name="deleteItem">
                    <conditional-field name="delChallan_write" condition="modCanWrite" title=" ">
                        <link url="deleteItem" parameter-map="[challanId:challanId, itemSeqId:itemSeqId]" icon="delete" style="text-danger" confirmation="Remove item?"/>
                    </conditional-field>
                    <default-field title=" "><label text="" type="span"/></default-field>
                </field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>
        </widgets>
        </section>

    </widgets>
</screen>
