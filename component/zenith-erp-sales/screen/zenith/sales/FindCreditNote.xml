<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Credit/Debit Notes" default-menu-index="7">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <transition name="editCreditNote"><default-response url="../EditCreditNote"/></transition>
    <transition name="findCreditNote"><default-response url="."/></transition>
    <!-- ZE-SALES-011 (SL-065): delete a DRAFT credit/debit note. An issued note is a legal record and must
         be cancelled (status), not deleted. Org-isolated. A draft's only child rows are its items (verified). -->
    <transition name="deleteCreditNote">
        <actions>
            <set field="activeOrg" from="_salesOrgId"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || ((!activeOrg || curInv.fromPartyId != activeOrg) &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="This credit/debit note was not found for your account."/>
            </if>
            <if condition="curInv.invoiceTypeEnumId != 'InvoiceSalesReturn' &amp;&amp; curInv.invoiceTypeEnumId != 'InvoiceSalesDebit'">
                <return error="true" message="This is not a credit or debit note."/>
            </if>
            <if condition="curInv.statusId != 'InvoiceInProcess'">
                <return error="true" message="This note has been issued and can't be deleted. Change its status to Cancelled instead."/>
            </if>
            <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="_items">
                <econdition field-name="invoiceId"/>
            </entity-find>
            <iterate list="_items" entry="_it"><entity-delete value-field="_it"/></iterate>
            <service-call name="delete#mantle.account.invoice.Invoice" in-map="[invoiceId:invoiceId]"/>
            <message>Draft note deleted.</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- CDN pill colours (mockup): Cancelled=orange, Finalized=green, InProcess=blue. -->
        <set field="statusColorMap" from="[
            'InvoiceInProcess': 'info',
            'InvoiceFinalized': 'success',
            'InvoiceCancelled': 'warning',
            'InvoicePmtRecvd': 'success',
            'InvoiceApproved': 'primary',
            'InvoiceSent': 'info',
            'InvoiceReceived': 'info'
        ]"/>

        <entity-find entity-name="mantle.account.invoice.InvoiceFindView" list="cdnList">
            <search-form-inputs skip-fields="organizationPartyId,fromPartyId,vendorPartyId,ownerPartyId" default-order-by="-invoiceDate,invoiceId"/>
            <econdition field-name="invoiceTypeEnumId" operator="in" value="InvoiceSalesReturn,InvoiceSalesDebit"/>
            <!-- ZE-SALES-014 f/u (cross-tenant leak): the MANTLE_ACTIVE_ORG authz filter scopes the HTML
                 render but NOT the CSV/standalone export, so the CSV was dumping every tenant's notes
                 (incl. MARUTHI/100000) to any signed-in user. Scope explicitly by the selling org so both
                 render paths are isolated; an empty active org (super-admin) is ignored and sees all. -->
            <econdition field-name="fromPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
        </entity-find>

        <!-- ZE-SALES-014 (SL-068): in CSV export the whole screen is rendered, so the page title/subtitle and
             the Search &amp; Filter block leak into the CSV before the real column headers (the subtitle even
             has a comma, breaking column alignment). isCsv gates those to screen-only. currSymbol was unset
             -> the "Total (null)" header; set it so the header reads "Total (₹)".
             ZE-SALES-014 f/u: the CSV has no UTF-8 BOM, so Excel (double-click, Windows) decodes the '₹'
             (bytes e2 82 b9) as mojibake "â‚¹" — the same garbling class the report's evidence shows. Use an
             ASCII currency label ('Rs.') in the CSV so the downloaded file is pure-ASCII and opens clean
             everywhere; the on-screen header keeps the '₹' glyph. -->
        <set field="isCsv" from="sri.getRenderMode() == 'csv'"/>
        <set field="currSymbol" from="isCsv ? 'Rs.' : '₹'"/>
    </actions>

    <widgets>
        <!-- ZE-SALES-014 (SL-068): page header + Search/Filter block render only on screen, not into the CSV. -->
        <section name="ScreenOnlyChrome" condition="!isCsv"><widgets>
        <!-- Moqui <submit> ignores style= (renders bare btn-primary), which ZE-BTN-OUTLINE would outline.
             The mockup wants the Apply CTA SOLID -> force it via id. /apps-only (#content); /qapps uses the theme id rule. -->
        <render-mode><text type="html"><![CDATA[<style>
#content button#SearchCdnForm_submitButton.btn.btn-primary{background:var(--z-primary,#7C3AED)!important;border-color:var(--z-primary,#7C3AED)!important;color:#fff!important;text-shadow:none!important}
#content button#SearchCdnForm_submitButton.btn.btn-primary:hover{filter:brightness(.93)}
</style>]]></text></render-mode>
        <container style="zsec-hdr row items-center justify-between q-mb-lg">
            <container>
                <label text="Credit &amp; Debit Notes" type="h4" style="text-primary text-weight-bold q-my-none"/>
                <label text="Used to fix or refund an invoice — a credit note gives money back, a debit note charges a bit more." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <section name="NewCdnBtn_write">
                <condition><expression>modCanWrite</expression></condition>
                <widgets>
                    <link url="../CreateCreditNote" text="New CDN" icon="add" style="z-solid q-btn--flat bg-primary text-white border-radius-md q-px-md"/>
                </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-1 border-radius-lg q-mb-lg q-pa-lg">
            <container style="z-cardhdr">
                <label text="shopping_cart" type="span" style="material-icons z-filterbadge"/>
                <label text="Search &amp; Filter" type="h6" style="text-primary text-weight-bold q-my-none"/>
            </container>

            <form-single name="SearchCdnForm" transition="findCreditNote">
                <field name="gstInvoiceNumber"><default-field title="Note No."><text-find hide-options="true"/></default-field></field>
                <field name="toPartyId"><default-field title="Customer">
                    <drop-down allow-empty="true"><entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''}"><entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Customer"/><econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/></entity-find></entity-options></drop-down>
                </default-field></field>
                <field name="originalInvoiceId"><default-field title="Original Invoice ID"><text-find hide-options="true"/></default-field></field>
                <field name="statusId"><default-field title="Status">
                    <drop-down allow-empty="true">
                        <option key="InvoiceInProcess" text="In Process"/>
                        <option key="InvoiceFinalized" text="Finalized"/>
                        <option key="InvoiceApproved" text="Approved"/>
                        <option key="InvoiceSent" text="Sent"/>
                        <option key="InvoiceAcked" text="Acknowledged"/>
                        <option key="InvoicePmtRecvd" text="Payment Received"/>
                        <option key="InvoiceCancelled" text="Cancelled"/>
                    </drop-down>
                </default-field></field>

                <field name="submitButton"><default-field title=""><submit text="Apply Filters" icon="filter_alt" style="q-btn bg-primary text-white border-radius-sm q-px-md"/></default-field></field>
                <field name="clearButton"><default-field title=""><link url="findCreditNote" text="Clear" icon="refresh" style="q-btn q-btn--flat text-grey-8 q-ml-sm"/></default-field></field>

                <field-layout>
                    <field-row><field-ref name="gstInvoiceNumber"/><field-ref name="toPartyId"/><field-ref name="originalInvoiceId"/><field-ref name="statusId"/></field-row>
                    <field-row><field-ref name="submitButton"/><field-ref name="clearButton"/></field-row>
                </field-layout>
            </form-single>
        </container>
        </widgets></section>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search credit notes..." style="display:none"></span>]]></text></render-mode>
            <section name="SalesHtmlList" condition="!isCsv"><widgets>
            <form-list name="FindCreditNoteList" list="cdnList" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <!-- Note No.: formatted (CN/26-27/…) -> outlined badge; legacy numeric -> plain text (mockup §9) -->
                    <set field="noteStyle" from="(gstInvoiceNumber &amp;&amp; gstInvoiceNumber.toString().contains('/')) ? 'z-idbadge' : 'z-plainlink'"/>
                    <set field="typeCls" from="documentType == 'Debit Note' ? 'text-warning' : 'text-success'"/>
                </row-actions>

                <field name="invoiceId"><header-field title="ID" show-order-by="true"/><default-field><hidden/></default-field></field>

                <field name="documentType">
                    <header-field title="Type" show-order-by="true"/>
                    <default-field>
                        <label text="description" type="span" style="material-icons z-typeico ${typeCls}"/>
                        <label text="${documentType ?: 'Credit Note'}" type="span" style="text-weight-bold ${typeCls}"/>
                    </default-field>
                </field>

                <field name="gstInvoiceNumber">
                    <header-field title="Note No." show-order-by="true"/>
                    <default-field>
                        <link url="editCreditNote" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="${noteStyle}"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Date" show-order-by="true"/>
                    <default-field><label text="${ec.l10n.format(invoiceDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="toPartyId">
                    <header-field title="Customer"/>
                    <default-field><label text="${toParty?.organizationName ?: (((toParty?.firstName ?: '') + ' ' + (toParty?.lastName ?: '')).trim() ?: 'Walk-in Customer')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="originalInvoiceId">
                    <header-field title="Original Invoice ID"/>
                    <default-field><label text="${originalInvoiceId ?: '-'}" type="span" style="text-grey-7"/></default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Taxable (${currSymbol})" show-order-by="true"/>
                    <default-field><label text="${zinr.inr(ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Invoice', '') : 'In Process'}" type="span" style="zenith-badge nd ${statusColor}"/>
                    </default-field>
                </field>
                <!-- ZE-SALES-011 (SL-065): Delete for a DRAFT note; an issued note shows it's locked (cancel via
                     status instead), so the restriction is clearly communicated. -->
                <field name="deleteNote"><header-field title="Actions"/>
                    <default-field>
                        <section name="ActionsScreenOnly" condition="!isCsv"><widgets>
                        <section name="DelDraftSec" condition="statusId == 'InvoiceInProcess'"><widgets>
                            <section name="CdnDeleteBtn_write">
                                <condition><expression>modCanWrite</expression></condition>
                                <widgets>
                                    <link url="deleteCreditNote" text="Delete" icon="fa fa-trash-o" parameter-map="[invoiceId:invoiceId]"
                                          class="z-obtn z-red" confirmation="Delete this draft note? This cannot be undone."/>
                                </widgets>
                            </section>
                        </widgets><fail-widgets>
                            <label text="lock" type="span" style="material-icons z-typeico text-grey-6"/>
                            <label text="Locked (cancel only)" type="span" style="text-caption text-grey-6"/>
                        </fail-widgets></section>
                        </widgets></section>
                    </default-field>
                </field>
                </form-list>
            </widgets></section>
        </container>

        <!-- CSV uses plain display fields on the already filtered/scoped list. HTML
             links/icons and the shell's zinr formatter are unavailable in CSV mode. -->
        <section name="SalesCsvExport" condition="isCsv"><widgets>
            <form-list name="FindCreditNoteCsv" list="cdnList">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="_csvParty"><field-map field-name="partyId" from="toPartyId"/></entity-find-one>
                    <set field="_csvCustomer" from="_csvParty?.organizationName ?: ((_csvParty?.firstName ?: '') + ' ' + (_csvParty?.lastName ?: '')).trim()"/>
                </row-actions>
                <field name="documentType"><header-field title="Type"/><default-field><display text="${documentType ?: 'Credit Note'}"/></default-field></field>
                <field name="gstInvoiceNumber"><header-field title="Note No."/><default-field><display text="${gstInvoiceNumber ?: invoiceId}"/></default-field></field>
                <field name="invoiceDate"><header-field title="Date"/><default-field><display text="${ec.l10n.format(invoiceDate, 'yyyy-MM-dd')}"/></default-field></field>
                <field name="toPartyId"><header-field title="Customer"/><default-field><display text="${_csvCustomer}"/></default-field></field>
                <field name="originalInvoiceId"><header-field title="Original Invoice"/><default-field><display text="${originalInvoiceId}"/></default-field></field>
                <field name="invoiceTotal"><header-field title="Taxable (INR)"/><default-field><display text="${invoiceTotal ?: 0}"/></default-field></field>
                <field name="totalTaxAmount"><header-field title="GST (INR)"/><default-field><display text="${totalTaxAmount ?: 0}"/></default-field></field>
                <field name="statusId"><header-field title="Status"/><default-field><display text="${statusId}"/></default-field></field>
            </form-list>
        </widgets></section>
    </widgets>
</screen>
