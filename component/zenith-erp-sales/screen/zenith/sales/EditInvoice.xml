<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tax Invoice" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="findInvoice"><default-response url="../FindInvoice"/></transition>

    <transition name="updateInvoice">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before update (block cross-tenant IDOR). Sales invoice org = fromPartyId. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Invoice not found for your account."/>
            </if>
            <service-call name="update#mantle.account.invoice.Invoice" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before mutating (block cross-tenant IDOR). Sales invoice org = fromPartyId. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Invoice not found for your account."/>
            </if>
            <!-- Issued-invoice immutability: a tax invoice is only editable while it is a draft (In-Process).
                 Once finalized/sent/etc. it is a legal record and its line items must not change. -->
            <if condition="curInv.statusId != 'InvoiceInProcess'">
                <return error="true" message="This invoice has been issued (status: ${curInv.statusId}) so its line items can no longer be changed. To correct it, raise a credit or debit note."/>
            </if>
            <script>
                // GST intra/inter-state is decided by the parties' registered state (tax-registration
                // regionGeoId) — the same source the invoice service uses. (Previously read stateProvinceGeoId
                // off PartyContactMechInfo, which has no such field, so it errored or always fell back to IGST.)
                def _sReg = ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:curInv.fromPartyId]).call()
                def _bReg = ec.service.sync().name("zenith.tax.TaxServices.get#PartyTaxRegistration").parameters([partyId:curInv.toPartyId]).call()
                def sellerState = _sReg?.regionGeoId
                def buyerState = _bReg?.regionGeoId
                def isInterstate = true
                if (sellerState &amp;&amp; buyerState &amp;&amp; sellerState == buyerState) {
                    isInterstate = false
                }

                def qty = new BigDecimal(quantity ?: 0)
                def price = new BigDecimal(amount ?: 0)
                // Sync price with Inventory and Pricing: auto-fill when the user leaves Unit Price blank
                if (price.signum() == 0 &amp;&amp; productId) {
                    try {
                        def _pr = ec.service.sync().name("zenith.pricing.PricingServices.calculate#Price")
                                    .parameters([productId:productId, quantity:(qty.signum()>0?qty:1), organizationPartyId:curInv.fromPartyId, customerPartyId:curInv.toPartyId]).call()
                        if (_pr?.unitPrice != null &amp;&amp; (_pr.unitPrice as BigDecimal).signum() == 1) price = _pr.unitPrice as BigDecimal
                    } catch (Exception e) { }
                    if (price.signum() == 0) {
                        def _p = ec.entity.find("mantle.product.Product").condition("productId", productId).one()
                        if (_p?.mrpAmount != null) price = _p.mrpAmount as BigDecimal
                    }
                }
                def taxableVal = qty.multiply(price)
                def taxPct = new BigDecimal(taxPercentage ?: 0)

                def igstRate = 0.0
                def cgstRate = 0.0
                def sgstRate = 0.0
                def igstAmount = 0.0
                def cgstAmount = 0.0
                def sgstAmount = 0.0

                if (taxPct > 0) {
                    if (isInterstate) {
                        igstRate = taxPct
                        igstAmount = taxableVal.multiply(taxPct).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                    } else {
                        cgstRate = taxPct.divide(new BigDecimal(2), 2, java.math.RoundingMode.HALF_UP)
                        sgstRate = cgstRate
                        cgstAmount = taxableVal.multiply(cgstRate).divide(new BigDecimal(100), 2, java.math.RoundingMode.HALF_UP)
                        sgstAmount = cgstAmount
                    }
                }

                // Call standard create item service but pass extended fields
                def inMap = context + [
                    itemTypeEnumId: 'ItemSales',
                    amount: price,
                    taxableAmount: taxableVal,
                    igstRate: igstRate, igstAmount: igstAmount,
                    cgstRate: cgstRate, cgstAmount: cgstAmount,
                    sgstRate: sgstRate, sgstAmount: sgstAmount
                ]
                ec.service.sync().name("create#mantle.account.invoice.InvoiceItem").parameters(inMap).call()

                // Refresh the header grand total (invoiceTotal/unpaidTotal) from the items.
                ec.service.sync().name("mantle.account.InvoiceServices.update#InvoiceTotals").parameters([invoiceId:invoiceId]).call()

                // Aggregate Indian GST totals onto the invoice header (custom fields).
                def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
                def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
                for (def it : invItems) {
                    tCgst += (it.cgstAmount ?: 0.0)
                    tSgst += (it.sgstAmount ?: 0.0)
                    tIgst += (it.igstAmount ?: 0.0)
                    tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
                }
                ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                    invoiceId: invoiceId,
                    totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
                ]).call()
            </script>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="deleteItem">
        <actions>
            <!-- Org-isolation: re-check ownership by PK before delete (block cross-tenant IDOR). Sales invoice org = fromPartyId. -->
            <set field="activeOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="curInv"/>
            <if condition="curInv == null || (activeOrg &amp;&amp; curInv.fromPartyId != activeOrg &amp;&amp; !ec.user.isInGroup('ADMIN'))">
                <return error="true" message="Invoice not found for your account."/>
            </if>
            <!-- Issued-invoice immutability: items can only be removed while the invoice is a draft (In-Process). -->
            <if condition="curInv.statusId != 'InvoiceInProcess'">
                <return error="true" message="This invoice has been issued and its line items can no longer be changed. Raise a credit or debit note to correct it."/>
            </if>
            <service-call name="delete#mantle.account.invoice.InvoiceItem" in-map="context"/>
        <script>
            ec.service.sync().name("mantle.account.InvoiceServices.update#InvoiceTotals").parameters([invoiceId:invoiceId]).call()

            // Re-aggregate GST values
            def invItems = ec.entity.find("mantle.account.invoice.InvoiceItem").condition("invoiceId", invoiceId).list()
            def tCgst = 0.0, tSgst = 0.0, tIgst = 0.0, tTaxable = 0.0
            for (def it : invItems) {
                tCgst += (it.cgstAmount ?: 0.0)
                tSgst += (it.sgstAmount ?: 0.0)
                tIgst += (it.igstAmount ?: 0.0)
                tTaxable += (it.taxableAmount ?: ((it.quantity?:1)*(it.amount?:0)))
            }
            ec.service.sync().name("update#mantle.account.invoice.Invoice").parameters([
                invoiceId: invoiceId,
                totalCgst: tCgst, totalSgst: tSgst, totalIgst: tIgst, totalTaxableAmount: tTaxable
            ]).call()
        </script>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="printInvoice" read-only="true">
        <default-response url="${ec.web.getWebappRootUrl(false, null)}/fop/apps/zenith/sales/InvoicePrint" url-type="plain">
            <parameter name="invoiceId"/>
            <parameter name="filename" value="TaxInvoice-${invoiceId}.pdf"/>
        </default-response>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
        
        <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
            <econdition field-name="invoiceId"/>
            <order-by field-name="invoiceItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="supplier">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customer">
            <field-map field-name="partyId" from="invoice?.toPartyId"/>
        </entity-find-one>
        
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="transporterList">
            <econdition field-name="roleTypeId" value="Carrier"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        
        <set field="docTitle" from="invoice.documentType ?: 'Tax Invoice'"/>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="findInvoice" text="Back to Invoices" icon="arrow_back" style="q-btn bg-grey-2 text-dark border-radius-md q-px-md glossy"/>
        </container>
        
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg text-white; border-radius:12px; background:linear-gradient(135deg, #3b82f6, #1d4ed8);">
                        <label text="INV" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="${docTitle} ${invoice?.gstInvoiceNumber ?: invoiceId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Total: ₹ ${ec.l10n.format(invoice?.invoiceTotal ?: 0, '#,##,##0.00')} - Date: ${ec.l10n.format(invoice?.invoiceDate, 'dd MMM yyyy')}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Invoice"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><default-field title=""><submit text="Update Status" style="q-btn bg-primary text-white border-radius-sm glossy"/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-end q-gutter-sm">
                <link url="printInvoice" text="Print ${docTitle}" parameter-map="[invoiceId:invoiceId]" target-window="_blank"
                      icon="fa fa-file-pdf-o" style="q-btn bg-indigo-8 text-white glossy"/>
            </container>
        </container>

        <!-- Main Invoice Sections -->
        <container-row>
            <row-col lg="6">
                <!-- Statutory Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Tax Details (GST)" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="StatutoryForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="buyerGstin"><default-field title="Buyer GSTIN"><text-line size="20"/></default-field></field>
                        <field name="supplierGstin"><default-field title="Supplier GSTIN"><text-line size="20"/></default-field></field>
                        <field name="placeOfSupplyStateCode"><default-field title="Place of Supply (State Code)"><text-line size="4"/></default-field></field>
                        
                        <field name="isReverseCharge"><default-field title="Reverse Charge (RCM)?">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        
                        <field name="isExport"><default-field title="Export Supply?">
                            <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                        </default-field></field>
                        
                        <field name="lutBondNumber"><default-field title="LUT / Bond No. (For Exports)"><text-line/></default-field></field>
                        <field name="shippingBillNumber"><default-field title="Shipping Bill No. (For Exports)"><text-line/></default-field></field>

                        <field name="submitButton"><default-field title=""><submit text="Save Details" style="q-btn bg-indigo-7 text-white text-weight-bold q-px-md border-radius-sm glossy"/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- E-Invoice and Transport -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="E-Invoice &amp; Transport" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="EInvoiceTransportForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="einvoiceId"><default-field title="IRN (Invoice Reference Number)"><text-line size="64"/></default-field></field>
                        <field name="ewayBillId"><default-field title="E-Way Bill No."><text-line size="20"/></default-field></field>
                        
                        <field name="transporterId"><default-field title="Transporter">
                            <drop-down allow-empty="true">
                                <list-options list="transporterList" key="${partyId}" text="${organizationName?:firstName} ${lastName?:''}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="vehicleNumber"><default-field title="Vehicle No."><text-line size="15"/></default-field></field>
                        <field name="lrNumber"><default-field title="LR / Docket No."><text-line size="15"/></default-field></field>

                        <field name="submitButton"><default-field title=""><submit text="Save Transport Data" style="q-btn bg-indigo-7 text-white text-weight-bold q-px-md border-radius-sm glossy"/></default-field></field>
                    </form-single>
                </container>
                
                <!-- Totals Dashboard -->
                <container style="zenith-card q-pa-md bg-indigo-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="Tax Breakdown" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md text-center">
                        <container style="col-3"><label text="Taxable" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="IGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalIgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="CGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalCgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="SGST" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${ec.l10n.format(invoice.totalSgst ?: 0, '#,##0.00')}" type="p" style="q-my-none"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Invoice Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Line Items &amp; GST" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <container-dialog id="AddItemDialog" button-text="Add Item" button-icon="add_circle" button-class="q-btn bg-teal-8 text-white text-weight-bold q-px-md border-radius-sm glossy">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                        <field name="amount"><default-field title="Unit Price"><text-line size="15"/></default-field></field>
                        
                        <!-- GST Field -->
                        <field name="taxPercentage"><default-field title="GST Rate (%)">
                            <drop-down no-current-selected-key="18">
                                <option key="0" text="0% (Exempt)"/>
                                <option key="5" text="5%"/>
                                <option key="12" text="12%"/>
                                <option key="18" text="18%"/>
                                <option key="28" text="28%"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="submitButton"><default-field title=""><submit text="Add Item" style="q-btn bg-primary text-white border-radius-sm glossy"/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>

            <form-list name="InvoiceItemsForm" list="invoiceItems" skip-form="true" header-dialog="true" show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="invoiceItemSeqId"><default-field title="#"><label text="${invoiceItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><label text="${ec.l10n.format(amount ?: 0, '#,##,##0.00')}" type="span"/></default-field></field>
                
                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Calculated GST">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (₹' + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (₹' + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (₹' + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total (Inc GST)">
                    <label text="${currSymbol}${ec.l10n.format(((quantity ?: 0) * (amount ?: 0)) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0), '#,##,##0.00')}" type="span" style="text-weight-bold text-dark"/>
                </default-field></field>
                
                <field name="deleteItem">
                    <default-field title=" ">
                        <link url="deleteItem" parameter-map="[invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId]" icon="delete" style="text-danger" confirmation="Remove item?"/>
                    </default-field>
                </field>
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
                </form-list>
        </container>

    </widgets>
</screen>
