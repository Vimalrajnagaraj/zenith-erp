<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Quotations" default-menu-index="2">

    <transition name="findQuotation"><default-response url="."/></transition>
    <transition name="editQuotation"><default-response url="../EditQuotation"/></transition>
    <transition name="createQuotation"><default-response url="../CreateQuotation"/></transition>

    <actions>
        <!-- ZE-SALES-0308: the Customer box is a free-text NAME search (users type "kana"), but the column it
             targeted (customerPartyId) holds a party id (103060 / MTCC20260034), so a typed name never matched
             and every customer search returned nothing. Resolve the typed name to matching customer party ids
             first, then filter the quotes by those ids. No name typed -> _custIds stays null -> filter skipped. -->
        <set field="customerSearch" from="ec.context.customerSearch"/>
        <if condition="customerSearch">
            <set field="_likeVal" from="'%' + customerSearch.toString().trim() + '%'"/>
            <entity-find entity-name="mantle.party.PartyDetail" list="_custMatches" distinct="true">
                <select-field field-name="partyId"/>
                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" from="_likeVal" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" from="_likeVal" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" from="_likeVal" ignore-case="true"/>
                </econditions>
            </entity-find>
            <!-- a set NAME with no match must return zero, not everything -> sentinel id -->
            <set field="_custIds" from="_custMatches.collect{ it.partyId } ?: ['__NO_MATCH__']"/>
        </if>

        <!-- ZE-SALES-0308 f/u: Quote No. is a CONTAINS search over both the internal orderId and the customer-
             facing displayId (search-form-inputs did an exact orderId equals, so a partial number matched nothing,
             and a formatted displayId was never searched). Empty box -> _qno null -> both econditions skipped. -->
        <set field="_qno" from="ec.context.quoteNoSearch ? '%' + ec.context.quoteNoSearch.toString().trim() + '%' : null"/>

        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="quoteList">
            <search-form-inputs default-order-by="-entryDate"/>
<!-- ZE-SALES-014 f/u (cross-tenant CSV leak): source the active org DIRECTLY, not via the parent-set
                 activeOrgId var, which is empty in the CSV/standalone render -> ignore-if-empty then skipped the
                 filter and the CSV dumped every tenant's quotations (incl. MARUTHI). -->
            <econdition field-name="vendorPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <!-- ZE-SALES-0308 f/u: a CANCELLED quotation used to vanish from this screen entirely (the hard
                 filter kept only Proposed/Rejected), so a cancelled quote couldn't be found, viewed, or audited
                 (e.g. QTN/26-27/00001 / order 100765). Also match cancelled QUOTATIONS — the documentType guard
                 keeps cancelled SALES ORDERS out (they share the OrderCancelled status and live on Find Orders). -->
            <econditions combine="or">
                <econdition field-name="statusId" operator="in" value="OrderProposed,OrderRejected"/>
                <econditions combine="and">
                    <econdition field-name="statusId" value="OrderCancelled"/>
                    <econdition field-name="documentType" value="QUOTATION"/>
                </econditions>
            </econditions>
            <econdition field-name="customerPartyId" operator="in" from="_custIds" ignore-if-empty="true"/>
            <econditions combine="or">
                <econdition field-name="orderId" operator="like" from="_qno" ignore-if-empty="true" ignore-case="true"/>
                <econdition field-name="displayId" operator="like" from="_qno" ignore-if-empty="true" ignore-case="true"/>
            </econditions>
        </entity-find>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <container style="row items-center justify-between">
                <container>
                    <label text="Sales Quotations" type="h4" style="text-primary text-weight-bold q-my-none"/>
                    <label text="Price quotes you send to customers before they buy. Create one, send it, and turn it into an order when they agree." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
                </container>
                <container>
                    <section name="NewQuoteBtn_write">
                        <condition><expression>modCanWrite</expression></condition>
                        <widgets>
                            <link url="createQuotation" text="New Quote" icon="add" style="q-btn--flat bg-primary text-white border-radius-md q-px-md"/>
                        </widgets>
                    </section>
                </container>
            </container>
        </container>

        <!-- Premium Search & Filter Card -->
        <container style="bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <container-row>
                <row-col><label text="Search Quotes" type="h6" style="text-dark text-weight-bold q-mt-none q-mb-md"/></row-col>
            </container-row>
            <form-single name="SearchQuoteForm" transition="findQuotation">
                <field name="quoteNoSearch"><default-field title="Quote No."><text-line size="15"/></default-field></field>
                <field name="customerSearch"><default-field title="Customer"><text-line size="15" placeholder="Name…"/></default-field></field>
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="OrderProposed" text="Proposed / Draft"/>
                            <option key="OrderRejected" text="Rejected"/>
                            <option key="OrderCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field>
                </field>
                <field name="entryDate"><default-field title="Date"><date-find/></default-field></field>
                <field name="submitButton"><default-field title="">
                    <submit text="Apply" icon="filter_alt" style="bg-indigo-7 text-white text-weight-medium q-px-md border-radius-sm"/>
                    <link url="findQuotation" text="Clear" style="q-btn--flat text-grey-8 q-ml-sm"/>
                </default-field></field>
                <field-layout>
                    <field-row>
                        <field-ref name="quoteNoSearch"/>
                        <field-ref name="customerSearch"/>
                        <field-ref name="statusId"/>
                        <field-ref name="entryDate"/>
                    </field-row>
                    <field-row>
                        <field-ref name="submitButton"/>
                    </field-row>
                </field-layout>
            </form-single>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-none">
            <form-list name="QuoteListForm" list="quoteList" header-dialog="true"
                       show-csv-button="true" show-page-size="true" show-xlsx-button="true">
                <row-actions>
                    <entity-find-one entity-name="moqui.basic.StatusItem" value-field="statusItem"/>
                    <set field="statusColor" from="statusId == 'OrderProposed' ? 'primary' : (statusId == 'OrderCancelled' ? 'grey' : 'danger')"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="Quote No." show-order-by="true"/>
                    <default-field><link url="editQuotation" text="${displayId ?: orderId}" style="text-weight-bold text-indigo-8 text-decoration-none" parameter-map="[orderId:orderId]"/></default-field>
                    <csv-field><display text="${displayId ?: orderId}"/></csv-field>
                </field>
                <field name="entryDate">
                    <header-field title="Date" show-order-by="true"/>
                    <default-field><label text="${ec.l10n.format(entryDate, 'dd MMM yyyy')}" type="span" style="text-grey-9"/></default-field>
                    <csv-field><display text="${ec.l10n.format(entryDate, 'yyyy-MM-dd')}"/></csv-field>
                </field>
                <field name="customerPartyId">
                    <header-field title="Customer"/>
                    <!-- ZE-SALES-0305: PartyNameTemplate renders "${pseudoId}: ${name}" and a customer with no
                         pseudoId (a person created without a code, e.g. KANAGARAJ) printed a literal "null:" prefix.
                         Guard it: fall back pseudoId -> partyId, and null-safe the name. -->
                    <default-field><display-entity entity-name="mantle.party.PartyDetail" text="${(pseudoId ?: partyId)}: ${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}" style="text-dark text-weight-medium"/></default-field>
                    <csv-field><display-entity entity-name="mantle.party.PartyDetail" text="${(pseudoId ?: partyId)}: ${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/></csv-field>
                </field>
                <field name="grandTotal">
                    <header-field title="Total" show-order-by="true"/>
                    <default-field><label text="${currSymbol}${ec.l10n.format(grandTotal ?: 0, '#,##,##0.00')}" type="span" style="text-weight-bold text-dark"/></default-field>
                    <csv-field><display text="${grandTotal ?: 0}"/></csv-field>
                </field>
                <field name="statusId">
                    <header-field title="Status"/>
                    <default-field><label text="${statusItem?.description ?: statusId}" type="span" style="zenith-badge ${statusColor}"/></default-field>
                    <csv-field><display text="${statusItem?.description ?: statusId}"/></csv-field>
                </field>
                
                <field name="convertToOrder">
                    <header-field title=""/>
                    <default-field>
                        <link url="editQuotation" text="Review Quote" style="q-btn--flat bg-indigo-1 text-indigo-8 border-radius-sm" parameter-map="[orderId:orderId]"/>
                    </default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
