<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Warranty" default-menu-index="7">
    <always-actions>
        <service-call name="zenith.sales.SalesAccessServices.get#AuthorizedActiveOrganization" out-map="_salesScope"/>
        <set field="_salesOrgId" from="_salesScope.activeOrgId"/>
    </always-actions>


    <transition name="createPolicy">
        <service-call name="zenith.sales.DeliveryChallanServices.create#WarrantyPolicy"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="updatePolicy">
        <actions>
            <!-- ZE-SALES-037: org-guard the write (the list is now org-scoped; block a forged warrantyPolicyId
                 from editing another tenant's policy; super-admin exempt). -->
            <service-call name="zenith.sales.SalesAccessServices.assert#RecordOrgAccess" out-map="access" in-map="[entityName:'zenith.erp.sales.WarrantyPolicy',idField:'warrantyPolicyId',idValue:warrantyPolicyId,orgField:'organizationPartyId']"/>
            <if condition="!access.allowed"><return error="true" message="Warranty policy not found for your account."/></if>
            <service-call name="update#zenith.erp.sales.WarrantyPolicy" in-map="[warrantyPolicyId:warrantyPolicyId,policyName:policyName]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="registerWarranty">
        <service-call name="zenith.sales.DeliveryChallanServices.register#Warranty"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="fileClaim">
        <service-call name="zenith.sales.DeliveryChallanServices.file#WarrantyClaim"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="_salesOrgId"/>
        <set field="_expOwnerIds" from="['__NO_SALES_ORGANIZATION__']"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.sales.WarrantyPolicy" list="policies">
            <order-by field-name="policyName"/>
            <!-- ZE-SALES-014 f/u: multi-list screen — isolate the policies list too (CSV renders every list) -->
            <econdition field-name="organizationPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.sales.WarrantyRegistration" list="registrations">
            <search-form-inputs skip-fields="organizationPartyId,fromPartyId,vendorPartyId,ownerPartyId" default-order-by="-warrantyStartDate"/>
            <econdition field-name="customerPartyId" operator="in" from="_expOwnerIds"/>
        </entity-find>
        <!-- ZE-SALES-014 f/u (Tier D): scope claims via reg -> customer -> owner (multi-hop; reuses _expOwnerIds) -->
        <set field="_expClaimRegIds" from="['__NO_SALES_ORGANIZATION__']"/>
        <if condition="_expOrg">
            <entity-find entity-name="zenith.erp.sales.WarrantyRegistration" list="_expClaimRegs"><econdition field-name="customerPartyId" operator="in" from="_expOwnerIds"/><select-field field-name="warrantyRegId"/></entity-find>
            <set field="_expClaimRegIds" from="_expClaimRegs ? _expClaimRegs.collect{it.warrantyRegId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.sales.WarrantyClaim" list="claims">
            <order-by field-name="-claimDate"/>
            <econdition field-name="warrantyRegId" operator="in" from="_expClaimRegIds"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Warranty Policies -->
        <container style="row items-center justify-between q-mb-lg zsec-hdr">
            <container>
                <label text="Warranty Policies" type="h4" style="text-weight-bold q-my-none"/>
                <label text="Set up what's covered and for how long, then register warranties for the items you sell." type="p" style="text-grey-7 text-caption q-mb-none"/>
            </container>
            <section name="createPolicy_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="CreatePolicy" button-text="Add Policy" type="success">
                <form-single name="CreatePolicyForm" transition="createPolicy">
                    <field name="policyName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="warrantyTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="WarrantyType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="durationMonths"><default-field title="Duration (months)"><text-line size="5"/></default-field></field>
                    <field name="isExtendable"><default-field title="Extendable">
                        <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <!-- ZE-SALES-025 (SL-085): Extended months/cost are gated on Extendable=Yes (JS at the foot of
                         this screen disables + clears them when 'No'); the create service also drops them server-side. -->
                    <field name="extendedMonths"><default-field title="Extended (months)"><text-line size="5"/></default-field></field>
                    <field name="extendedCost"><default-field title="Extension Cost"><text-line size="10"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="PoliciesForm" list="policies" transition="updatePolicy">
                <field name="warrantyPolicyId"><default-field><hidden/></default-field></field>
                <field name="policyName"><default-field title="Name"><text-line size="24"/></default-field></field>
                <field name="warrantyTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="durationMonths"><default-field title="Months"><display/></default-field></field>
                <field name="isExtendable"><default-field title="Extendable"><display/></default-field></field>
                <field name="submitBtn">
                    <conditional-field name="polUpdate_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>

        <!-- Warranty Registrations -->
        <container style="row items-center justify-between q-mb-md zsec-hdr">
            <label text="Registered Warranties" type="h5" style="text-weight-bold q-my-none"/>
            <section name="regWarranty_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="RegWarranty" button-text="Register Warranty" type="info">
                <form-single name="RegForm" transition="registerWarranty">
                    <field name="warrantyPolicyId"><default-field title="Policy">
                        <drop-down><entity-options key="${warrantyPolicyId}" text="${policyName}">
                            <entity-find entity-name="zenith.erp.sales.WarrantyPolicy">
                                <econdition field-name="organizationPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down><entity-options key="${productId}" text="${productName}">
                            <entity-find entity-name="mantle.product.Product">
                                <econdition field-name="ownerPartyId" from="_salesOrgId ?: '__NO_SALES_ORGANIZATION__'"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                    <field name="purchaseDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Register"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="RegForm" list="registrations" skip-form="true" show-csv-button="true">
                <field name="warrantyRegId"><default-field title="Reg #"><display/></default-field></field>
                <field name="customerPartyId"><default-field title="Customer">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="productId"><default-field title="Product">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="serialNumber"><default-field><display/></default-field></field>
                <field name="warrantyStartDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="warrantyEndDate"><default-field title="End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
                <field name="fileClaim"><default-field title="Actions">
                    <section name="FileActiveClaim" condition="modCanWrite &amp;&amp; statusId == 'WrActive' &amp;&amp; warrantyStartDate != null &amp;&amp; warrantyEndDate != null &amp;&amp; warrantyStartDate &lt;= java.sql.Date.valueOf(ec.l10n.format(ec.user.nowTimestamp,'yyyy-MM-dd')) &amp;&amp; warrantyEndDate &gt;= java.sql.Date.valueOf(ec.l10n.format(ec.user.nowTimestamp,'yyyy-MM-dd'))"><widgets>
                        <container-dialog id="ClaimDialog" button-text="File Claim" button-class="q-btn--flat text-primary">
                            <form-single name="ClaimForm" transition="fileClaim">
                                <field name="warrantyRegId"><default-field><hidden default-value="${warrantyRegId}"/></default-field></field>
                                <field name="issueDescription"><default-field title="Issue"><text-area/></default-field></field>
                                <field name="submitButton"><default-field><submit text="File Claim"/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets></section>
                </default-field></field>

            </form-list>
        </container>

        <!-- Claims -->
        <container style="q-mb-md">
            <label text="Warranty Claims" type="h5" style="text-weight-bold q-my-none"/>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ClaimsForm" list="claims" skip-form="true" show-csv-button="true">
                <field name="claimId"><default-field title="Claim #"><display/></default-field></field>
                <field name="warrantyRegId"><default-field title="Registration"><display/></default-field></field>
                <field name="issueDescription"><default-field title="Issue"><display/></default-field></field>
                <field name="claimDate"><default-field title="Filed"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="resolutionEnumId"><default-field title="Resolution">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="statusId"><default-field title="Status"><display text="${ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()?.description ?: statusId}"/></default-field></field>
            </form-list>
        </container>

        <!-- ZE-SALES-025 (SL-085): gate the Add-Policy Extended fields on Extendable=Yes. The create service
             already drops these values server-side, but the UI must disable + clear them when 'No'. The original
             <script> in a type="html" block ran on /apps ONLY — /qapps (Quasar) strips <script> AND drops a
             type="html" block, so there the fields stayed editable (the reported bug). Fix: bootstrap via an
             <img onload> inline IIFE in a type="html,vuet,qvt" block (survives the /qapps script-strip) and POLL
             every 300ms so it re-applies through Quasar's re-renders. The hidden backing <select name="isExtendable">
             holds the live Y/N on BOTH surfaces (verified it tracks the q-select) — disable + clear
             extendedMonths/extendedCost when it isn't 'Y'. -->
        <render-mode><text type="html,vuet,qvt"><![CDATA[
        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" style="display:none" onload="if(!window._zWpExtGate){window._zWpExtGate=1;setInterval(function(){var ext=document.querySelector('select[name=isExtendable]');if(!ext)return;var on=(ext.value==='Y');['extendedMonths','extendedCost'].forEach(function(n){[].forEach.call(document.querySelectorAll('input[name='+n+']'),function(x){if(!on){if(x.value!==''){x.value='';x.dispatchEvent(new Event('input',{bubbles:true}));}x.disabled=true;x.readOnly=true;}else{if(x.disabled){x.disabled=false;x.readOnly=false;}}});});},300);}">
        ]]></text></render-mode>
    </widgets>
</screen>
