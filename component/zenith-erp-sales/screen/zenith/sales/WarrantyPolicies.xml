<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Warranty" default-menu-index="7">

    <transition name="createPolicy">
        <service-call name="zenith.sales.DeliveryChallanServices.create#WarrantyPolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePolicy">
        <service-call name="update#zenith.erp.sales.WarrantyPolicy"/>
        <default-response url="."/>
    </transition>
    <transition name="registerWarranty">
        <service-call name="zenith.sales.DeliveryChallanServices.register#Warranty"/>
        <default-response url="."/>
    </transition>
    <transition name="fileClaim">
        <service-call name="zenith.sales.DeliveryChallanServices.file#WarrantyClaim"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.sales.WarrantyPolicy" list="policies">
            <order-by field-name="policyName"/>
            <!-- ZE-SALES-014 f/u: multi-list screen — isolate the policies list too (CSV renders every list) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.sales.WarrantyRegistration" list="registrations">
            <search-form-inputs default-order-by="-warrantyStartDate"/>
            <econdition field-name="customerPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.sales.WarrantyClaim" list="claims">
            <order-by field-name="-claimDate"/>
        </entity-find>
    </actions>

    <widgets>
        <!-- Warranty Policies -->
        <container style="row items-center justify-between q-mb-lg">
            <label text="Warranty Policies" type="h4" style="text-weight-bold q-my-none"/>
            <label text="Set up what's covered and for how long, then register warranties for the items you sell." type="p" style="text-grey-7 text-caption q-mb-none"/>
            <container-dialog id="CreatePolicy" button-text="Add Policy" type="success">
                <form-single name="CreatePolicyForm" transition="createPolicy">
                    <field name="policyName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="warrantyTypeEnumId"><default-field title="Type">
                        <drop-down><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="WarrantyType"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="durationMonths"><default-field title="Duration (months)"><text-line size="5"/></default-field></field>
                    <field name="isExtendable"><default-field title="Extendable">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </default-field></field>
                    <field name="extendedMonths"><default-field title="Extended (months)"><text-line size="5"/></default-field></field>
                    <field name="extendedCost"><default-field title="Extension Cost"><text-line size="10"/></default-field></field>
                    <field name="submitBtn"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="PoliciesForm" list="policies" transition="updatePolicy">
                <field name="warrantyPolicyId"><default-field><hidden/></default-field></field>
                <field name="policyName"><default-field title="Name"><text-line size="15"/></default-field></field>
                <field name="warrantyTypeEnumId"><default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="durationMonths"><default-field title="Months"><display/></default-field></field>
                <field name="isExtendable"><default-field title="Extendable"><display/></default-field></field>
                <field name="submitBtn"><default-field title="Update"><submit/></default-field></field>
            </form-list>
        </container>

        <!-- Warranty Registrations -->
        <container style="row items-center justify-between q-mb-md">
            <label text="Registered Warranties" type="h5" style="text-weight-bold q-my-none"/>
            <container-dialog id="RegWarranty" button-text="Register Warranty" type="info">
                <form-single name="RegForm" transition="registerWarranty">
                    <field name="warrantyPolicyId"><default-field title="Policy">
                        <drop-down><entity-options key="${warrantyPolicyId}" text="${policyName}">
                            <entity-find entity-name="zenith.erp.sales.WarrantyPolicy"/>
                        </entity-options></drop-down></default-field></field>
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down><entity-options key="${partyId}" text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}">
                            <entity-find entity-name="mantle.party.PartyDetail">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="productId"><default-field title="Product">
                        <drop-down><entity-options key="${productId}" text="${productName}">
                            <entity-find entity-name="mantle.product.Product">
                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                            </entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="serialNumber"><default-field><text-line size="15"/></default-field></field>
                    <field name="purchaseDate"><default-field><date-time type="date"/></default-field></field>
                    <field name="submitBtn"><default-field title="Register"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg q-mb-lg">
            <form-list name="RegForm" list="registrations" skip-form="true" show-csv-button="true">
                <field name="warrantyRegId"><default-field title="Reg #"><display/></default-field></field>
                <field name="customerPartyId"><default-field title="Customer">
                    <display-entity entity-name="mantle.party.PartyDetail" key-field-name="partyId"
                                    text="${organizationName}${firstName ? firstName : ''} ${lastName ? lastName : ''}"/>
                </default-field></field>
                <field name="productId"><default-field title="Product">
                    <display-entity entity-name="mantle.product.Product" key-field-name="productId" text="${productName}"/>
                </default-field></field>
                <field name="serialNumber"><default-field><display/></default-field></field>
                <field name="warrantyStartDate"><default-field title="Start"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="warrantyEndDate"><default-field title="End"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>

        <!-- Claims -->
        <container style="q-mb-md">
            <label text="Warranty Claims" type="h5" style="text-weight-bold q-my-none"/>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
            <form-list name="ClaimsForm" list="claims" skip-form="true" show-csv-button="true">
                <field name="warrantyClaimId"><default-field title="Claim #"><display/></default-field></field>
                <field name="warrantyRegId"><default-field title="Registration"><display/></default-field></field>
                <field name="issueDescription"><default-field title="Issue"><display/></default-field></field>
                <field name="claimDate"><default-field title="Filed"><display format="dd-MMM-yyyy"/></default-field></field>
                <field name="resolutionEnumId"><default-field title="Resolution">
                    <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                </default-field></field>
                <field name="statusId"><default-field title="Status"><display/></default-field></field>
            </form-list>
        </container>
    </widgets>
</screen>
