<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vendor Bill" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="findInvoice"><default-response url="../FindPurchaseInvoice"/></transition>
    
    <transition name="updateInvoice">
        <actions><script><![CDATA[
            def patch=ec.web.parameters.findAll { k,v -> k in ['vendorInvoiceNumber','supplierGstin','isReverseCharge','itcEligible','dueDate','statusId'] }
            ec.service.sync().name('zenith.purchase.PurchaseInvoiceServices.update#VendorBill').parameters([invoiceId:invoiceId,updates:patch]).call()
        ]]></script></actions><default-response url="."/><error-response url="."/>
    </transition>
    <transition name="addItem"><service-call name="zenith.purchase.PurchaseInvoiceServices.add#VendorBillLine"/><default-response url="."/><error-response url="."/></transition>
    <transition name="deleteItem"><service-call name="zenith.purchase.PurchaseInvoiceServices.delete#VendorBillLine"/><default-response url="."/><error-response url="."/></transition>

    <actions>
        <!-- ZE-PUR-IDOR: explicit cross-tenant render guard — only the owning org (super-admins exempt) may open
             this vendor bill. Load NOTHING when blocked; widgets show a plain no-access panel instead of
             another tenant's invoice/vendor/GST data. The same stored-record guard protects the typed write paths. -->
        <service-call name="zenith.purchase.PurchaseInvoiceServices.assert#VendorBillAccess" in-map="[invoiceId:invoiceId,errorOnDenied:false]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>

        <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
            <econdition field-name="invoiceId"/>
            <order-by field-name="invoiceItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="buyer">
            <field-map field-name="partyId" from="invoice?.toPartyId"/>
        </entity-find-one>
        
        <entity-find-one entity-name="zenith.erp.india.IndiaPartyTaxProfile" value-field="taxProfile">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>
        <set field="billEditable" from="invoice.statusId in ['InvoiceIncoming','InvoiceInProcess','InvoiceReceived']"/>
        <script><![CDATA[
            def statusFlow=invoice.statusId=='InvoiceInProcess' ? 'Default' : 'InvoicePayable'
            billStatusOptions=[[statusId:invoice.statusId,description:invoice.statusId.replace('Invoice','')]]
            if(billEditable) ec.entity.find('moqui.basic.StatusFlowTransition').condition('statusFlowId',statusFlow).condition('statusId',invoice.statusId).list().each { transition ->
                if(transition.toStatusId in ['InvoiceReceived','InvoiceApproved','InvoiceCancelled'] &&
                    (!transition.userPermissionId || ec.user.hasPermission(transition.userPermissionId))) {
                    def status=ec.entity.find('moqui.basic.StatusItem').condition('statusId',transition.toStatusId).one()
                    billStatusOptions.add([statusId:transition.toStatusId,description:status?.description ?: transition.toStatusId.replace('Invoice','')])
                }
            }
        ]]></script>
        <set field="currSymbol" from="invoice.currencyUomId == 'INR' ? '₹ ' : invoice.currencyUomId + ' '"/>
        <set field="payableAmount" from="(invoice.invoiceTotal ?: 0)+(invoice.roundOffAmount ?: 0)-(invoice.appliedPaymentsTotal ?: 0)"/>
        <set field="isMsme" from="taxProfile?.isMsme == 'Y'"/>
        <!-- Use the saved due date and payable balance; do not invent a statutory deadline or tax outcome. -->
        <set field="isOverdueMsme" from="isMsme &amp;&amp; invoice.dueDate != null &amp;&amp; invoice.dueDate.before(ec.user.nowTimestamp) &amp;&amp; payableAmount &gt; 0 &amp;&amp; invoice.statusId != 'InvoiceCancelled'"/>

        <set field="statusColorMap" from="[
            'InvoiceInProcess': 'grey', 'InvoiceIncoming': 'grey',
            'InvoiceApproved': 'primary',
            'InvoiceReceived': 'warning',
            'InvoicePmtSent': 'success',
            'InvoiceCancelled': 'danger'
        ]"/>
        <set field="statusColor" from="statusColorMap[invoice?.statusId] ?: 'dark'"/>
        <set field="itcColor" from="invoice?.itcEligible == 'Y' ? 'text-success' : 'text-danger'"/>
        </if>
    </actions>

    <widgets>
        <container style="zvbill-page">
        <link url="findInvoice" text="Back to Vendor Bills" link-type="anchor"/>

        <!-- ZE-PUR-IDOR: cross-tenant / missing invoice — plain notice, never another org's bill data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That purchase invoice isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist. Use “Back to Vendor Bills” above to return to your list." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <section name="VendorMsmeOverdue"><condition><expression>isOverdueMsme</expression></condition><widgets>
        <container style="bg-negative text-white q-pa-md border-radius-md q-mb-lg">
            <label text="MSME payment overdue" type="h5" style="text-weight-bold q-my-none text-white"/>
            <label text="This vendor is marked as an MSME. The bill's saved payment due date has passed and an outstanding balance remains." type="p" style="q-my-none q-mt-sm text-white"/>
        </container>

        </widgets></section>
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center vbill-identity">
                    <container style="zenith-avatar q-mr-lg text-white">
                        <label text="BILL" type="span" style="font-weight:bold; font-size:1.2rem;"/>
                    </container>
                    <container style="column">
                        <label text="Vendor Bill: ${invoice?.vendorInvoiceNumber ?: invoiceId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Total: ${currSymbol}${zinr.inr(ec.l10n.format((invoice?.invoiceTotal ?: 0)+(invoice?.roundOffAmount ?: 0), '#,##,##0.00'))} - Date: ${invoice?.invoiceDate ? ec.l10n.format(invoice.invoiceDate, 'dd MMM yyyy') : 'N/A'}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                        <label text="Outstanding: ${currSymbol}${zinr.inr(ec.l10n.format(payableAmount, '#,##0.00'))}" type="p" style="text-grey-7 q-my-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <list-options list="billStatusOptions" key="${statusId}" text="${description}"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite &amp;&amp; billEditable" title="Update Status"><submit/></conditional-field><default-field title="Update Status"><label text="${billEditable ? 'You have view-only access — changes are disabled.' : 'This bill is closed for editing.'}" type="span" style="text-grey-7"/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-between">
                <container style="bg-grey-2 q-pa-sm border-radius-md">
                    <label text="Supplier: ${vendor?.organizationName ?: (vendor?.firstName ? vendor.firstName + ' ' + (vendor.lastName?:'') : 'Unknown Vendor')} [${invoice?.fromPartyId ?: 'N/A'}]" type="span" style="text-dark text-weight-bold"/>
                    <label text=" | PO No: ${invoice?.purchaseOrderNumber ?: 'None'}" type="span" style="text-grey-7"/>
                </container>
                <container>
                    <label text="${invoice?.statusId ? invoice.statusId.replace('Invoice', '') : 'In Process'}" type="span" style="zenith-badge ${statusColor} q-mr-sm"/>
                    <label text="ITC: ${invoice?.itcEligible == 'Y' ? 'Eligible' : 'Ineligible'}" type="span" style="zenith-badge ${invoice?.itcEligible == 'Y' ? 'success' : 'danger'}"/>
                </container>
            </container>
        </container>

        <!-- Main Sections -->
        <container-row>
            <row-col lg="6">
                <!-- Vendor & Statutory Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Vendor &amp; Statutory Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="StatutoryForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="vendorInvoiceNumber"><default-field title="Vendor Invoice No."><text-line size="20"/></default-field></field>
                        <field name="supplierGstin"><default-field title="Supplier GSTIN"><text-line size="20"/></default-field></field>
                        <field name="isReverseCharge">
                            <default-field title="Reverse Charge (RCM)">
                                <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field>
                        </field>
                        <field name="itcEligible">
                            <default-field title="Claim ITC?">
                                <drop-down><option key="Y" text="Yes - Eligible for Credit"/><option key="N" text="No - Ineligible"/></drop-down>
                            </default-field>
                        </field>
                        
                        <field name="dueDate">
                            <default-field title="Payment Due Date"><date-time type="date"/></default-field>
                        </field>
                        
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite &amp;&amp; billEditable" title="Save Details"><submit/></conditional-field><default-field title="Save Details"><label text="${billEditable ? 'You have view-only access — changes are disabled.' : 'This bill is closed for editing.'}" type="span" style="text-grey-7"/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- ITC Dashboard -->
                <container style="zenith-card vbill-itc-summary q-pa-md bg-indigo-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="Tax &amp; ITC Summary" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md text-center">
                        <container style="col-3"><label text="Taxable Base" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##0.00'))}" type="p" style="q-my-none"/></container>
                        <container style="col-3"><label text="IGST Charged" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalIgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none ${itcColor}"/></container>
                        <container style="col-3"><label text="CGST Charged" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalCgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none ${itcColor}"/></container>
                        <container style="col-3"><label text="Cess Charged" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalCess ?: 0, '#,##0.00'))}" type="p" style="q-my-none ${itcColor}"/></container>
                        <container style="col-3"><label text="SGST Charged" type="strong" style="text-indigo-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalSgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none ${itcColor}"/></container>
                    </container>
                </container>
                
                <!-- GSTR-2B Matching Widget -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="GSTR-2B Reconciliation Status" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row items-center justify-between">
                        <label text="${invoice.gstr2bMatchStatus ?: 'Unmatched'}" type="h4" style="text-weight-bold ${invoice.gstr2bMatchStatus == 'Matched' ? 'text-success' : 'text-warning'} q-my-none"/>
                        <label text="Matched reconciliation data." type="p" style="text-grey-7 q-my-none" condition="invoice.gstr2bMatchStatus == 'Matched'"/>
                        <label text="No matched reconciliation data." type="p" style="text-grey-7 q-my-none" condition="invoice.gstr2bMatchStatus != 'Matched'"/>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Bill Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Bill Items (Expenses/Assets)" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <section name="VBillAddItem_write"><condition><expression>modCanWrite &amp;&amp; billEditable</expression></condition><widgets>
                <container-dialog id="AddItemDialog" button-text="Add Item" button-class="q-btn--flat bg-primary text-white border-radius-md">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>

                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                        <field name="amount"><default-field title="Unit Price"><text-line size="15"/></default-field></field>
                        
                        <!-- GST Field -->
                        <field name="taxPercentage"><default-field title="GST Rate (%)">
                            <drop-down no-current-selected-key="18">
                                <option key="0" text="0% (Exempt)"/>
                                <option key="5" text="5%"/>
                                <option key="12" text="12%"/>
                                <option key="18" text="18%"/>
                                <option key="28" text="28%"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="discountPercent"><default-field title="Discount (%)">
                            <text-line size="8" input-type="number" default-value="0"/>
                        </default-field></field>

                        <field name="submitButton"><default-field title="Add Item"><submit icon="fa fa-plus" type="primary"/></default-field></field>

                        <field-layout>
                            <field-ref name="productId"/>
                            <field-ref name="description"/>
                            <field-row>
                                <field-ref name="hsnSacCode"/>
                                <field-ref name="quantity"/>
                            </field-row>
                            <field-row>
                                <field-ref name="amount"/>
                                <field-ref name="taxPercentage"/>
                            </field-row>
                            <field-ref name="discountPercent"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>

            <form-list name="InvoiceItemsForm" list="invoiceItems" skip-form="true">
                <field name="invoiceItemSeqId"><default-field title="#"><label text="${invoiceItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><label text="${zinr.inr(ec.l10n.format(amount ?: 0, '#,##,##0.00'))}" type="span"/></default-field></field>

                <field name="lineDisc"><default-field title="Discount">
                    <label text="${(discountPercent &amp;&amp; discountPercent &gt; 0) ? (discountPercent + '% (' + currSymbol + zinr.inr(ec.l10n.format(discountAmount ?: 0, '#,##0.00')) + ')') : '-'}" type="span" style="text-orange-9"/>
                </default-field></field>

                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Tax Paid">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (' + currSymbol + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (' + currSymbol + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (' + currSymbol + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cessRate ? ('CESS: ' + cessRate + '% (' + currSymbol + cessAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate &amp;&amp; !cessRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total (Inc Tax)">
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format((taxableAmount != null ? taxableAmount : ((quantity ?: 0) * (amount ?: 0))) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0) + (cessAmount ?: 0), '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/>
                </default-field></field>
                
                <field name="deleteItem">
                    <conditional-field name="del_write" condition="modCanWrite &amp;&amp; billEditable" title=" ">
                        <link url="deleteItem" parameter-map="[invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId]" icon="fa fa-trash" style="text-danger" confirmation="Remove item?"/>
                    </conditional-field>
                    <default-field title=" "><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
        </widgets>
        </section>

        </container>
    </widgets>
</screen>
