<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New Purchase Order" default-menu-include="false">

    <parameter name="vendorPartyId"/>

    <transition name="createPo">
        <!-- Currency from the buying org's configured currency (CompanySettings CURRENCY_UOM_ID),
             falling back to INR. Mirrors FindPurchaseOrder/createOrder. -->
        <entity-find-one entity-name="zenith.erp.base.CompanySettings" value-field="currSetting">
            <field-map field-name="organizationPartyId" from="organizationPartyId"/>
            <field-map field-name="settingKey" value="CURRENCY_UOM_ID"/>
        </entity-find-one>
        <!-- create#Order builds the OrderHeader AND the OrderPart (vendor+customer) together; raw
             create#OrderHeader/OrderPart leaves a part-less order. Pass the org's currency (INR)
             into create#Order (it otherwise defaults to USD). -->
        <service-call name="mantle.order.OrderServices.create#Order" out-map="createOut"
                      in-map="[orderName:'New Purchase Order', entryDate:ec.user.nowTimestamp, statusId:'OrderOpen',
                               currencyUomId:(currSetting?.settingValue ?: 'INR'),
                               vendorPartyId:vendorPartyId, customerPartyId:organizationPartyId]"/>
        <default-response url="../EditPurchaseOrder">
            <parameter name="orderId" value="${createOut.orderId}"/>
        </default-response>
    </transition>
    <transition name="findOrder"><default-response url="../FindPurchaseOrder"/></transition>

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find-one entity-name="mantle.party.Organization" value-field="activeOrg">
            <field-map field-name="partyId" from="activeOrgId"/>
        </entity-find-one>
        <set field="activeOrgName" from="activeOrg?.organizationName ?: activeOrgId"/>

        <entity-find-one entity-name="mantle.party.PartyDetailAndRole" value-field="vendorParty">
            <field-map field-name="partyId" from="vendorPartyId"/>
        </entity-find-one>
        <set field="vendorName" from="vendorParty?.organizationName ?: ((vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')).trim()"/>
        <set field="vendorName" from="vendorName ?: vendorPartyId"/>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <link url="findOrder" text="Back to Purchase Orders" icon="arrow_back" style="q-btn--flat bg-grey-2 text-dark border-radius-md q-px-md"/>
        </container>

        <container-row>
            <row-col lg="8" md="10" sm="12" style="q-mx-auto">
                <container style="zenith-card bg-white shadow-4 border-radius-xl q-pa-xl q-mt-md">
                    <container-row>
                        <row-col>
                            <container style="row items-center q-mb-lg">
                                <container style="q-pa-md bg-deep-orange-1 border-radius-md q-mr-md text-deep-orange-8">
                                    <render-mode><text type="html"><![CDATA[<q-icon name="local_shipping" class="text-h3"/>]]></text></render-mode>
                                </container>
                                <container>
                                    <label text="Create Purchase Order" type="h4" style="text-dark text-weight-bolder q-mt-none q-mb-xs"/>
                                    <label text="Start a new purchase order for this vendor, then add items." type="p" style="text-grey-7 text-subtitle1 q-mb-none"/>
                                </container>
                            </container>
                            <label text="" type="hr" style="q-mb-xl bg-grey-3" size="1"/>
                        </row-col>
                    </container-row>

                    <form-single name="CreatePoForm" transition="createPo">
                        <field name="organizationPartyId"><default-field><hidden default-value="${activeOrgId}"/></default-field></field>
                        <field name="vendorPartyId"><default-field><hidden default-value="${vendorPartyId}"/></default-field></field>
                        <field name="buyerName"><default-field title="Buying Organization"><display text="${activeOrgName}"/></default-field></field>
                        <field name="vendorDisplay"><default-field title="Vendor (Supplier)"><display text="${vendorName} [${vendorPartyId}]"/></default-field></field>

                        <field name="submitButton"><default-field title="">
                            <submit text="Create Purchase Order" icon="add_circle" style="bg-deep-orange-8 text-white shadow-3 q-px-xl q-py-sm text-subtitle1 text-weight-bold q-mt-lg glossy"/>
                        </default-field></field>

                        <field-layout>
                            <field-row>
                                <field-ref name="buyerName"/>
                                <field-ref name="vendorDisplay"/>
                            </field-row>
                            <field-ref name="organizationPartyId"/>
                            <field-ref name="vendorPartyId"/>
                            <field-row>
                                <field-ref name="submitButton"/>
                            </field-row>
                        </field-layout>
                    </form-single>
                </container>
            </row-col>
        </container-row>
    </widgets>
</screen>
