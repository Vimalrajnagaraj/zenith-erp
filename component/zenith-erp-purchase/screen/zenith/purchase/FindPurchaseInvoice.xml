<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vendor Bills (ITC)" default-menu-index="6">

    <transition name="editInvoice"><default-response url="../EditPurchaseInvoice"/></transition>

    <actions>
        <!-- real invoice status ids (were stale: InvoicePaid / InvoiceIn-Process never matched -> all grey) -->
        <set field="statusColorMap" from="[
            'InvoiceInProcess': 'warning', 'InvoiceIncoming': 'grey',
            'InvoiceApproved': 'primary', 'InvoiceAcked': 'primary', 'InvoiceSent': 'primary',
            'InvoiceReceived': 'warning',
            'InvoiceFinalized': 'success', 'InvoicePmtRecvd': 'success', 'InvoicePmtSent': 'success', 'InvoiceBilledThrough': 'success',
            'InvoiceCancelled': 'danger', 'InvoiceWriteOff': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="zsec-hdr row items-center justify-between q-mb-lg">
            <container>
                <label text="Vendor Bills (ITC)" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Log supplier invoices and claim Input Tax Credit (ITC)." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <!-- ZE-PUR: Log Vendor Bill is a write action — hidden for view-only users -->
            <section name="LogVendorBillWrite">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
            <link url="../CreatePurchaseInvoice" text="Log Vendor Bill" icon="post_add" style="z-solid q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md"/>
              </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="FindInvoiceList" list="invoiceList" skip-form="true" header-dialog="true" show-csv-button="true">
                <entity-find entity-name="zenith.erp.purchase.PurchaseInvoiceView" list="invoiceList">
                    <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/>
                    <search-form-inputs default-order-by="-invoiceDate,invoiceId"/>
                    <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
                    <econdition field-name="toPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                </entity-find>

                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <set field="_si" from="ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()"/>
                    <set field="statusLabel" from="_si?.description ?: (statusId ? statusId.replace('Invoice','') : 'In Process')"/>
                    <!-- vendor name via PartyDetail (the view's VORG org-join returns null for these parties) -->
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="_vd"><field-map field-name="partyId" from="fromPartyId"/></entity-find-one>
                    <set field="vendorName2" from="_vd ? (_vd.organizationName ?: ((_vd.firstName ?: '') + ' ' + (_vd.lastName ?: '')).trim()) : fromPartyId"/>
                    <set field="gstrLabel" from="(gstr2bMatchStatus == null || gstr2bMatchStatus == 'Unmatched') ? 'Not Matched' : gstr2bMatchStatus"/>
                    <set field="gstrColor" from="gstr2bMatchStatus == 'Matched' ? 'primary' : 'danger'"/>
                    <!-- IRN validated tracks ITC-eligibility (reliable field; supplierGstin alias returns null) -->
                    <set field="irnYes" from="itcEligible == 'Y'"/>
                </row-actions>

                <field name="invoiceId"><header-field title="ID" show-order-by="true"/><default-field><hidden/></default-field></field>

                <field name="vendorInvoiceNumber">
                    <header-field title="Vendor Bill No." show-order-by="true">
                        <text-find default-operator="contains"/>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${vendorInvoiceNumber ?: invoiceId}"/></conditional-field>
                    <default-field>
                        <link url="editInvoice" text="${vendorInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="z-idbadge"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Bill Date" show-order-by="true"><date-find/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${ec.l10n.format(invoiceDate, 'dd MMM yyyy')}" type="span" style="text-dark"/>
                    </default-field>
                </field>

                <field name="fromPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole"><econdition field-name="roleTypeId" value="Supplier"/><econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/></entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${vendorName2}"/></conditional-field>
                    <default-field>
                        <link url="/vapps/zenith/Contacts/ContactProfile" text="${vendorName2}" style="text-primary text-weight-bold" parameter-map="[partyId:fromPartyId]" link-type="anchor"/>
                    </default-field>
                </field>

                <field name="totalTaxableAmount">
                    <header-field title="Taxable (${currSymbol})" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${totalTaxableAmount ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(totalTaxableAmount ?: 0, '#,##,##0.00'))}" type="span"/></default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Total (${currSymbol})" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${invoiceTotal ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold z-amt-green"/></default-field>
                </field>
                
                <field name="itcEligible">
                    <header-field title="ITC Eligible">
                        <drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${itcEligible == 'Y' ? 'Yes' : 'No'}"/></conditional-field>
                    <default-field>
                        <label text="${itcEligible == 'Y' ? 'Yes' : 'No'}" type="span" style="zenith-badge nd ${itcEligible == 'Y' ? 'success' : 'danger'}"/>
                    </default-field>
                </field>
                
                <field name="gstr2bMatchStatus">
                    <header-field title="GSTR-2B Status">
                        <drop-down allow-empty="true">
                            <option key="Matched" text="Matched"/>
                            <option key="Unmatched" text="Unmatched"/>
                            <option key="MissingInBooks" text="Missing in Books"/>
                            <option key="MissingInPortal" text="Missing in Portal"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${gstrLabel}"/></conditional-field>
                    <default-field>
                        <label text="${gstrLabel}" type="span" style="zenith-badge nd ${gstrColor}"/>
                    </default-field>
                </field>
                
                <field name="irnValid">
                    <header-field title="IRN Validated"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${irnYes ? 'Yes' : 'No'}"/></conditional-field>
                    <default-field>
                        <label text="${irnYes ? 'Yes' : 'No'}" type="span" style="text-weight-bold ${irnYes ? 'z-amt-green' : 'z-txt-red'}"/>
                    </default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIn-Process" text="In Process"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoiceReceived" text="Received"/>
                            <option key="InvoicePaid" text="Paid"/>
                            <option key="InvoiceCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${statusLabel}"/></conditional-field>
                    <default-field>
                        <label text="${statusLabel}" type="span" style="zenith-badge z-stbadge ${statusColor}"/>
                    </default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><ignored/></conditional-field>
                    <default-field>
                        <link url="editInvoice" text="⋮" parameter-map="[invoiceId:invoiceId]" style="z-kebab"/>
                    </default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
