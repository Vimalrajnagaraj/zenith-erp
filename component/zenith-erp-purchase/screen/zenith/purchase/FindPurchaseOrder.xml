<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase Orders" default-menu-index="4">

    <transition name="editOrder"><default-response url="../EditPurchaseOrder"/></transition>
    
    <transition name="createOrder">
        <service-call name="create#mantle.order.OrderHeader" out-map="createOut"
                      in-map="[statusId:'OrderOpen', currencyUomId:companyCurrency]"/>
        <service-call name="create#mantle.order.OrderPart"
                      in-map="[orderId:createOut.orderId, vendorPartyId:vendorPartyId, customerPartyId:organizationPartyId]"/>
        <default-response url="../EditPurchaseOrder">
            <parameter name="orderId" value="${createOut.orderId}"/>
        </default-response>
    </transition>

    <actions>
        <entity-find entity-name="mantle.party.PartyRole" list="internalOrgRoles">
            <econdition field-name="roleTypeId" operator="in" value="OrgInternal,InternalOrganization"/>
        </entity-find>
        <set field="internalOrgIdList" from="internalOrgRoles.partyId"/>
        <set field="activeOrgId" from="ec.user.getPreference('ActiveOrgId') ?: (internalOrgIdList ? internalOrgIdList[0] : null)"/>
        
        <set field="statusColorMap" from="[
            'OrderOpen': 'info',
            'OrderProposed': 'warning',
            'OrderPlaced': 'primary',
            'OrderApproved': 'success',
            'OrderCompleted': 'dark',
            'OrderCancelled': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="row" id="po-header">
            <container style="col-md-8 col-sm-7">
                <label text="Purchase Orders" type="h3" style="text-primary"/>
                <label text="Manage outgoing purchase orders to vendors and suppliers." type="p" style="text-muted"/>
            </container>
            
            <container style="col-md-4 col-sm-5 text-right">
                <!-- Quick Create PO Dialog -->
                <container-dialog id="CreatePoDialog" button-text="New Purchase Order" button-class="btn btn-primary btn-lg">
                    <form-single name="CreatePoForm" transition="createOrder">
                        <field name="vendorPartyId">
                            <default-field title="Vendor (Supplier)">
                                <drop-down allow-empty="false">
                                    <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Supplier"/>
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="organizationPartyId">
                            <default-field title="Buying Organization">
                                <drop-down allow-empty="false" no-current-selected-key="${activeOrgId}">
                                    <entity-options key="${partyId}" text="${organizationName} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" operator="in" value="OrgInternal,InternalOrganization"/>
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submitButton"><default-field title="Create PO"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <container style="panel panel-default">
            <container style="panel-body">
            <form-list name="FindPoList" list="poList" skip-form="true" header-dialog="true" show-csv-button="true">
                <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="poList">
                    <econdition field-name="customerPartyId" operator="in" from="internalOrgIdList"/>
                    <econdition field-name="vendorPartyId" operator="is-not-null"/>
                    <search-form-inputs default-order-by="-entryDate,orderId"/>
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="PO Number" show-order-by="true"><text-line/></header-field>
                    <default-field>
                        <link url="editOrder" text="${orderId}" parameter-map="[orderId:orderId]" style="text-weight-bold text-indigo-8 text-decoration-none"/>
                    </default-field>
                </field>

                <field name="entryDate">
                    <header-field title="Order Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field><label text="${ec.l10n.format(entryDate, 'dd MMM yyyy')}" type="span" style="text-dark"/></default-field>
                </field>

                <field name="vendorPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                    <econdition field-name="roleTypeId" value="Supplier"/>
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${vendorParty?.organizationName ?: ((vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')).trim()}"/>
                    </conditional-field>
                    <default-field>
                        <link url="/vapps/zenith/contacts/Contacts/EditContact" text="${vendorParty?.organizationName ?: ((vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')).trim()}" style="text-primary text-weight-bold" parameter-map="[partyId:vendorPartyId]" link-type="anchor"/>
                    </default-field>
                </field>

                <field name="grandTotal">
                    <header-field title="Grand Total (${currSymbol})" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${grandTotal ?: 0}"/></conditional-field>
                    <default-field><label text="${ec.l10n.format(grandTotal ?: 0, '#,##,##0.00')}" type="span" style="text-weight-bold text-dark"/></default-field>
                </field>

                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="OrderOpen" text="Draft"/>
                            <option key="OrderProposed" text="Proposed"/>
                            <option key="OrderPlaced" text="Placed"/>
                            <option key="OrderApproved" text="Approved"/>
                            <option key="OrderCompleted" text="Completed"/>
                            <option key="OrderCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${statusId ? statusId.replace('Order', '') : 'Open'}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Order', '') : 'Open'}" type="span" style="label label-${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="findButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
            </container>
        </container>
    </widgets>
</screen>
