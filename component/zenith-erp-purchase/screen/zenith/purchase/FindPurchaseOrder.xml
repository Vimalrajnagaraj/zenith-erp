<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase Orders" default-menu-index="4">

    <transition name="editOrder"><default-response url="../EditPurchaseOrder"/></transition>
    
    <transition name="createOrder"><actions>
        <service-call name="zenith.purchase.OperationsServices.create#PurchaseOrder" in-map="[vendorPartyId:vendorPartyId,organizationPartyId:organizationPartyId]" out-map="createOut"/>
    </actions><default-response url="../EditPurchaseOrder"><parameter name="orderId" value="${createOut.orderId}"/></default-response><error-response url="."/></transition>

    <actions>
        <script><![CDATA[
            // Export only supported search fields, never request/session attributes or scope overrides.
            csvFilters=[:]
            def fields=['orderId', 'orderName', 'entryDate', 'vendorPartyId', 'statusId']
            def suffixes=['','_op','_not','_ic','_from','_thru','_period','_poffset']
            fields.each {field -> suffixes.each {suffix ->
                def key=field+suffix
                if(ec.web.requestParameters[key]!=null) csvFilters[key]=ec.web.requestParameters[key]
            }}
            if(ec.web.requestParameters.orderByField) csvFilters.orderByField=ec.web.requestParameters.orderByField
        ]]></script>
        <service-call name="zenith.purchase.OperationsServices.get#PurchaseOrganization" out-map="scope"/>
        <set field="_org" from="scope.organizationPartyId ?: '__NO_ORGANIZATION__'"/>
        <service-call name="zenith.purchase.OperationsServices.get#PurchaseOrderIds" out-map="poScope"/>
        <set field="_hasActiveOrg" from="scope.organizationPartyId != null"/>
        <set field="organizationPartyId" from="scope.organizationPartyId"/>
        <set field="activeOrgId" from="scope.organizationPartyId"/>
        <!-- mockup dot-pills: Open(blue), Pending(orange), Approved(green) -->
        <set field="statusColorMap" from="[
            'OrderOpen': 'info', 'OrderProposed': 'warning', 'OrderPlaced': 'warning',
            'OrderApproved': 'success', 'OrderCompleted': 'success', 'OrderCancelled': 'danger'
        ]"/>
        <set field="statusLabelMap" from="[
            'OrderOpen': 'Open', 'OrderProposed': 'Pending', 'OrderPlaced': 'Pending',
            'OrderApproved': 'Approved', 'OrderCompleted': 'Completed', 'OrderCancelled': 'Cancelled'
        ]"/>
        <set field="currSymbol" from="currSymbol ?: '₹'"/>
    </actions>

    <widgets><container style="zpur-page">
      <!-- exclude the page header from the CSV standalone render so Export CSV is clean (table only) -->
      <section name="PoHeaderSec">
        <condition><expression>!(sri.getRenderMode() in ['csv','xlsx'])</expression></condition>
        <widgets>
        <container style="zsec-hdr row items-center justify-between q-mb-lg z-newbtn-wrap" id="po-header">
            <container>
                <label text="Purchase Orders" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Manage outgoing purchase orders to vendors and suppliers." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>

            <container style="z-hdractions">
                <!-- ZE-PUR: New Purchase Order is a write action — hidden for view-only users -->
                <section name="NewPoWrite">
                  <condition><expression>modCanWrite</expression></condition>
                  <widgets>
                <container-dialog id="CreatePoDialog" button-text="+ New Purchase Order" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                    <form-single name="CreatePoForm" transition="createOrder">
                        <field name="vendorPartyId">
                            <default-field title="Vendor (Supplier)">
                                <drop-down allow-empty="false">
                                    <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" operator="in" value="Vendor,Supplier"/><econdition field-name="disabled" value="N" or-null="true"/>
                                            <econdition field-name="ownerPartyId" from="_org"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="organizationPartyId">
                            <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                            <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                            <default-field title="Buying Organization"><display text="Select your active organization before creating a PO."/></default-field>
                        </field>
                        <field name="submitButton"><default-field title="Create PO"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                  </widgets>
                </section>
                <link url="." text="Export CSV" icon="download" link-type="anchor" style="z-obtn" parameter-map="csvFilters + [renderMode:'csv', pageNoLimit:'true', saveFilename:'PurchaseOrders.csv', lastStandalone:'true']"/>
            </container>
        </container>
        </widgets>
      </section>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search purchase orders..." style="display:none"></span>]]></text></render-mode>
            <form-list name="FindPoList" list="poList" skip-form="true" header-dialog="true">
                <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="poList">
                    <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
                    <econdition field-name="customerPartyId" from="_org"/><econdition field-name="orderId" operator="in" from="poScope.orderIds ?: ['__NO_ORGANIZATION__']"/>
                    <econdition field-name="vendorPartyId" operator="is-not-null"/>
                    <search-form-inputs skip-fields="organizationPartyId,ownerPartyId,customerPartyId,toPartyId,orderPartSeqId" default-order-by="-entryDate,orderId"/>
                </entity-find>

                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="vendorName2" from="vendorParty?.organizationName ?: ((vendorParty?.firstName ?: '') + ' ' + (vendorParty?.lastName ?: '')).trim()"/>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <set field="statusLabel" from="statusLabelMap[statusId] ?: (statusId ? statusId.replace('Order','') : 'Open')"/>
                </row-actions>

                <field name="orderId">
                    <header-field title="PO Number" show-order-by="true"><text-line/></header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display text="${orderId}"/></conditional-field>
                    <default-field>
                        <link url="editOrder" text="${orderId}" parameter-map="[orderId:orderId]" style="z-idbadge"/>
                    </default-field>
                </field>

                <field name="entryDate">
                    <header-field title="Order Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${ec.l10n.format(entryDate, 'dd MMM yyyy')}" type="span" style="text-dark"/>
                    </default-field>
                </field>

                <field name="vendorPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                    <econdition field-name="roleTypeId" operator="in" value="Vendor,Supplier"/><econdition field-name="disabled" value="N" or-null="true"/>
                                    <econdition field-name="ownerPartyId" from="_org"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']">
                        <display text="${vendorName2}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${vendorName2}" type="span" style="text-dark"/>
                    </default-field>
                </field>

                <field name="grandTotal">
                    <header-field title="Grand Total" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display text="${grandTotal ?: 0}"/></conditional-field>
                    <default-field>
                        <label text="${currencyUomId}" type="span" style="text-grey-6 q-mr-xs"/>
                        <label text="${ec.l10n.format(grandTotal ?: 0, '#,##,##0.00')}" type="span" style="text-weight-bold z-amt-green"/>
                    </default-field>
                </field>

                <field name="currencyUomId"><header-field title="Currency"/><conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display/></conditional-field><default-field><display/></default-field></field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="OrderOpen" text="Draft"/>
                            <option key="OrderProposed" text="Proposed"/>
                            <option key="OrderPlaced" text="Placed"/>
                            <option key="OrderApproved" text="Approved"/>
                            <option key="OrderCompleted" text="Completed"/>
                            <option key="OrderCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']">
                        <display text="${statusLabel}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${statusLabel}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                
                <field name="actions">
                    <!-- CSV: render an empty cell (not <ignored/>) so header + body column counts match (RFC-4180) -->
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display text=""/></conditional-field>
                    <default-field title="Actions">
                        <link url="editOrder" text="View" parameter-map="[orderId:orderId]" style="z-kebab"/>
                    </default-field>
                </field>
            </form-list>
        </container>
</container>    </widgets>
</screen>
