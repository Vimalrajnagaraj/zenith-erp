<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase" default-menu-index="4">

    <always-actions>
        <set field="html_title" value="Purchase"/>
    </always-actions>

    <subscreens default-item="GoodsReceipt">
        <subscreens-item name="FindPurchaseOrder" location="component://zenith-erp-purchase/screen/zenith/purchase/FindPurchaseOrder.xml"/>
        <subscreens-item name="EditPurchaseOrder" location="component://zenith-erp-purchase/screen/zenith/purchase/EditPurchaseOrder.xml"/>
        <subscreens-item name="CreatePurchaseOrder" location="component://zenith-erp-purchase/screen/zenith/purchase/CreatePurchaseOrder.xml" menu-include="false"/>
        <subscreens-item name="OrderPrint" location="component://zenith-erp-purchase/screen/zenith/purchase/OrderPrint.xml" menu-include="false"/>
        
        <subscreens-item name="FindPurchaseInvoice" location="component://zenith-erp-purchase/screen/zenith/purchase/FindPurchaseInvoice.xml"/>
        <subscreens-item name="CreatePurchaseInvoice" location="component://zenith-erp-purchase/screen/zenith/purchase/CreatePurchaseInvoice.xml"/>
        <subscreens-item name="EditPurchaseInvoice" location="component://zenith-erp-purchase/screen/zenith/purchase/EditPurchaseInvoice.xml" menu-include="false"/>
        
        <subscreens-item name="GoodsReceipt" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/GoodsReceipt.xml"/>
        <subscreens-item name="JobWorkChallan" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/JobWorkChallan.xml"/>
        <subscreens-item name="JobWorkChallanDetail" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/JobWorkChallanDetail.xml" menu-include="false"/>
        <subscreens-item name="PurchaseReturns" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/PurchaseReturns.xml"/>
        <subscreens-item name="PurchaseReturnDetail" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/PurchaseReturnDetail.xml" menu-include="false"/>
        <subscreens-item name="PurchaseInvoices" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/PurchaseInvoices.xml"/>
        <subscreens-item name="RfqList" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/RfqList.xml"/>
        <subscreens-item name="EditRfq" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/EditRfq.xml" menu-include="false"/>
        <subscreens-item name="Gstr2bRecon" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/Gstr2bRecon.xml"/>
        <subscreens-item name="VendorEvaluation" location="component://zenith-erp-purchase/screen/zenith/purchase/Purchase/VendorEvaluation.xml"/>
    </subscreens>
    
    <transition name="goSales"><default-response url="../sales/SalesDashboard"/></transition>
    <transition name="goContacts"><default-response url="../Contacts/Vendors"/></transition>
    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>
    <transition name="goAccounting"><default-response url="../Accounting/Invoices"/></transition>
    <transition name="goIntegrations"><default-response url="../integrations/Einvoice"/></transition>
    <transition name="goManufacturing"><default-response url="../manufacturing/WorkOrders"/></transition>

    <widgets>
        <render-mode><text type="html,qvt"><![CDATA[
        <img alt="" style="display:none" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" onload="if(!document.getElementById('zc-purchase-css')){var l=document.createElement('link');l.id='zc-purchase-css';l.rel='stylesheet';l.href='/zenithstatic/css/purchase.css?v=2';document.head.appendChild(l);}if(!document.getElementById('zc-purchase-js')){var s=document.createElement('script');s.id='zc-purchase-js';s.src='/zenithstatic/js/purchase-ui.js?v=1';document.head.appendChild(s);}"/>
        ]]></text></render-mode>
        <container style="zc-purchase-page"><subscreens-active/></container>
    </widgets>
</screen>
