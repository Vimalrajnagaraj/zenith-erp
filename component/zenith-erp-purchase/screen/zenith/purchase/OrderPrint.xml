<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" standalone="true">

    <parameter name="orderId" required="true"/>

    <actions>
        <!-- ZE-INV-IV-035 f/u: tenant isolation on the fop PRINT path (a direct /fop URL bypasses the screen
             transition's guard). Only the buyer/vendor org may print this PO; a cross-tenant (or forged) id
             returns "not found" — never another tenant's PO/vendor/price data. -->
        <service-call name="zenith.purchase.OperationsServices.assert#PurchaseOrder" in-map="[orderId:orderId,errorOnDenied:'N']" out-map="access"/>
        <if condition="!access.allowed"><script>throw new org.moqui.context.ArtifactAuthorizationException('Purchase order print access denied.')</script></if>
        <set field="order" from="access.order"/><set field="orderPart" from="access.part"/>
        <entity-find entity-name="mantle.order.OrderItem" list="orderItems">
            <econdition field-name="orderId"/><econdition field-name="orderPartSeqId" value="01"/>
            <order-by field-name="orderItemSeqId"/>
        </entity-find>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorParty">
            <field-map field-name="partyId" from="orderPart?.vendorPartyId"/>
        </entity-find-one>
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="customerParty">
            <field-map field-name="partyId" from="orderPart?.customerPartyId"/>
        </entity-find-one>
        
        <if condition="orderPart?.vendorPartyId">
            <service-call name="mantle.party.ContactServices.get#PartyContactInfo" in-map="[partyId:orderPart?.vendorPartyId]" out-map="vendorContactInfo"/>
        </if>
        <if condition="orderPart?.customerPartyId">
            <service-call name="mantle.party.ContactServices.get#PartyContactInfo" in-map="[partyId:orderPart?.customerPartyId]" out-map="customerContactInfo"/>
        </if>

        <set field="templateLocation" value="component://zenith-erp-purchase/template/purchase/OrderPrint.xsl-fo.ftl"/>
    </actions>
    <widgets>
        <render-mode><text type="xsl-fo" location="${templateLocation}" template="true" encode="false" no-boundary-comment="true"/></render-mode>
    </widgets>
</screen>
