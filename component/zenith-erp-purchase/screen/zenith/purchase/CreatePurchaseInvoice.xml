<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Log Vendor Bill" default-menu-index="3" default-menu-include="true">

    <parameter name="purchaseOrderId"/>
    <parameter name="vendorPartyId"/>

    <transition name="createInvoice">
        <service-call name="create#mantle.account.invoice.Invoice" out-map="createOut"
            in-map="[invoiceTypeEnumId:'InvoicePurchase', statusId:'InvoiceInProcess', fromPartyId:ec.web.parameters.fromPartyId, toPartyId:(ec.web.parameters.toPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')), invoiceDate:(ec.web.parameters.invoiceDate ?: ec.user.nowTimestamp), itcEligible:(ec.web.parameters.itcEligible ?: 'Y'), currencyUomId:'INR']"/>
        <default-response url="../EditPurchaseInvoice">
            <parameter name="invoiceId" value="${createOut.invoiceId}"/>
        </default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="openPos">
            <econdition field-name="customerPartyId" from="activeOrgId" ignore-if-empty="true"/>
            <econdition field-name="vendorPartyId" operator="is-not-null"/>
            <econdition field-name="statusId" operator="in" value="OrderApproved,OrderCompleted"/>
            <order-by field-name="-entryDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="row" id="invoice-header">
            <container style="col-md-12">
                <link url="../FindPurchaseInvoice" text="Back to List" icon="glyphicon glyphicon-arrow-left" class="btn btn-default"/>
                <link url="." text="Upload via AI (OCR)" icon="glyphicon glyphicon-cloud-upload" class="btn btn-success" tooltip="Use Google DocumentAI/Textract to auto-fill this bill"/>
                <label text="Log Vendor Bill" type="h3" style="text-primary"/>
                <label text="Record a supplier invoice to capture expenses and claim ITC." type="p" style="text-muted"/>
            </container>
        </container>

        <container style="row">
            <container style="col-md-8 col-sm-10">
                <container style="panel panel-default">
                    <container style="panel-body">
                    <form-single name="CreateVendorBillForm" transition="createInvoice">
                        <field name="fromPartyId">
                            <default-field title="Vendor (Supplier)">
                                <drop-down allow-empty="false" current="selected">
                                    <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Supplier"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="toPartyId">
                            <default-field title="Buying Organization">
                                <drop-down allow-empty="false">
                                    <entity-options key="${partyId}" text="${organizationName} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="OrgInternal"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="purchaseOrderNumber">
                            <default-field title="Link to Purchase Order (Optional)">
                                <drop-down allow-empty="true" current="selected">
                                    <list-options list="openPos" key="${orderId}" text="PO #${orderId} - ₹${grandTotal?:0}"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="vendorInvoiceNumber">
                            <default-field title="Vendor's Invoice No." tooltip="Crucial for GSTR-2B matching">
                                <text-line size="20"/>
                            </default-field>
                        </field>

                        <field name="invoiceDate">
                            <default-field title="Bill Date">
                                <date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/>
                            </default-field>
                        </field>
                        
                        <field name="itcEligible">
                            <default-field title="ITC Eligible">
                                <drop-down no-current-selected-key="Y">
                                    <option key="Y" text="Yes - Claim Input Tax Credit"/>
                                    <option key="N" text="No - Ineligible for Credit"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="submitButton">
                            <default-field title="Log Bill"><submit/></default-field>
                        </field>
                    </form-single>
                    </container>
                </container>
            </container>
        </container>
    </widgets>
</screen>
