<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Log Vendor Bill" default-menu-index="3" default-menu-include="true">

    <parameter name="purchaseOrderId"/>
    <parameter name="vendorPartyId"/>

    <transition name="createInvoice">
        <actions>
            <!-- ITC treatment by supply nature:
                 COMPOSITION (Bill of Supply from a composition dealer) -> no GST charged -> ITC = No.
                 RCM (reverse charge) -> recipient self-pays the GST and may claim ITC -> keep the user's
                 choice (default Yes), and flag the bill as reverse charge.
                 REGULAR -> the user's ITC choice stands. -->
            <set field="supplyNature" from="ec.web.parameters.supplyNature ?: 'REGULAR'"/>
            <set field="itcVal" from="ec.web.parameters.itcEligible ?: 'Y'"/>
            <set field="rcm" value="N"/>
            <set field="itcReason" from="null"/>
            <set field="composition" value="N"/>
            <if condition="supplyNature == 'COMPOSITION'">
                <set field="itcVal" value="N"/>
                <set field="composition" value="Y"/>
                <set field="itcReason" value="Purchase from a composition dealer (Bill of Supply) — no GST charged, so no ITC."/>
                <else-if condition="supplyNature == 'RCM'">
                    <set field="rcm" value="Y"/>
                </else-if>
            </if>
            <if condition="!(supplyNature in ['REGULAR','RCM','COMPOSITION'])"><return error="true" message="Choose a valid supply nature."/></if>
            <service-call name="zenith.purchase.PurchaseServices.create#PurchaseInvoice" out-map="createOut"
                in-map="[organizationPartyId:ec.web.parameters.toPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION'),
                         vendorPartyId:ec.web.parameters.fromPartyId, invoiceDate:ec.web.parameters.invoiceDate ?: ec.user.nowTimestamp,
                         vendorInvoiceNumber:ec.web.parameters.vendorInvoiceNumber, purchaseOrderNumber:ec.web.parameters.purchaseOrderNumber,
                         itcEligible:itcVal, isReverseCharge:rcm, isCompositionDealer:composition]"/>
        </actions>
        <default-response url="../EditPurchaseInvoice">
            <parameter name="invoiceId" value="${createOut.invoiceId}"/>
        </default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        <!-- ZE-INV-IV-070 f/u: a tenant has exactly one org; auto-fill it (the /qapps Vue m-drop-down renders the
             get#ActiveOrgList list-options EMPTY, blocking the form). Super-admins (no active org) keep the picker. -->
        <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_hasActiveOrg" from="(_ao != null &amp;&amp; _ao != '' &amp;&amp; _ao != '_NA_')"/>
        <if condition="_hasActiveOrg"><set field="toPartyId" from="_ao"/></if>
        <entity-find entity-name="mantle.order.OrderHeaderAndPart" list="openPos">
            <econdition field-name="customerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="vendorPartyId" operator="is-not-null"/><econdition field-name="documentType" value="PURCHASE_ORDER"/>
            <econdition field-name="statusId" operator="in" value="OrderApproved,OrderCompleted"/>
            <order-by field-name="-entryDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zvbill-page">
        <container style="z-btnrow q-mb-md" id="invoice-header">
            <link url="../FindPurchaseInvoice" text="Back to List" icon="fa fa-arrow-left" style="z-obtn"/>
        </container>
        <container style="q-mb-lg">
            <label text="Log Vendor Bill" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Record a supplier invoice to capture expenses and claim ITC." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-lg">
                    <form-single name="CreateVendorBillForm" transition="createInvoice">
                        <field name="fromPartyId">
                            <default-field title="Vendor (Supplier)">
                                <drop-down allow-empty="false" current="selected">
                                    <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                        <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                            <econdition field-name="roleTypeId" value="Supplier"/>
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field>
                        </field>
                        
                        <field name="toPartyId">
                            <!-- ZE-INV-IV-070 f/u: tenant -> hidden auto-fill; super-admin -> picker (see actions). -->
                            <conditional-field name="orgAutoFill" condition="_hasActiveOrg"><hidden/></conditional-field>
                            <default-field title="Buying Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="orgList" key="${partyId}" text="${organizationName} [${partyId}]"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="purchaseOrderNumber">
                            <default-field title="Link to Purchase Order (Optional)">
                                <drop-down allow-empty="true" current="selected">
                                    <list-options list="openPos" key="${orderId}" text="PO #${orderId} - ₹${grandTotal?:0}"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="vendorInvoiceNumber">
                            <default-field title="Vendor's Invoice No." tooltip="Crucial for GSTR-2B matching">
                                <text-line size="20"/>
                            </default-field>
                        </field>

                        <field name="invoiceDate">
                            <default-field title="Bill Date">
                                <date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/>
                            </default-field>
                        </field>
                        
                        <field name="supplyNature">
                            <default-field title="Supply Nature" tooltip="Composition = Bill of Supply (no GST, no ITC); Reverse Charge = you self-pay the GST and may claim ITC">
                                <drop-down no-current-selected-key="REGULAR">
                                    <option key="REGULAR" text="Regular (GST charged by supplier)"/>
                                    <option key="RCM" text="Reverse Charge (you pay the GST)"/>
                                    <option key="COMPOSITION" text="Composition supplier (Bill of Supply, no ITC)"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="itcEligible">
                            <default-field title="ITC Eligible" tooltip="Auto-set to No for a composition (Bill of Supply) purchase">
                                <drop-down no-current-selected-key="Y">
                                    <option key="Y" text="Yes - Claim Input Tax Credit"/>
                                    <option key="N" text="No - Ineligible for Credit"/>
                                </drop-down>
                            </default-field>
                        </field>

                        <field name="submitButton">
                            <conditional-field name="save_write" condition="modCanWrite" title="Log Bill"><submit/></conditional-field>
                            <default-field title=""><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
        </container>
        </container>
    </widgets>
</screen>
