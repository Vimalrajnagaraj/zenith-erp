<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoice Detail" default-menu-index="0" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="addItem">
        <service-call name="zenith.purchase.PurchaseServices.add#PurchaseInvoiceItem"/>
        <default-response url="."/>
    </transition>
    <transition name="payWithTds">
        <service-call name="zenith.purchase.PurchaseServices.create#PurchasePaymentWithTds"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-PUR-IDOR: explicit cross-tenant render guard — only the owning org (super-admins exempt) may open
             this vendor bill. Load NOTHING when blocked; widgets show a plain no-access panel instead of
             another tenant's invoice/vendor/GST data. RENDER guard only (transitions untouched). -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'mantle.account.invoice.Invoice', idField:'invoiceId', idValue:invoiceId, orgField:'toPartyId']" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
        <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="items">
            <econdition field-name="invoiceId"/>
            <order-by field-name="invoiceItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.Organization" value-field="vendorOrg">
            <field-map field-name="partyId" from="invoice.fromPartyId"/></entity-find-one>
        <entity-find-one entity-name="mantle.party.Organization" value-field="buyerOrg">
            <field-map field-name="partyId" from="invoice.toPartyId"/></entity-find-one>

        <entity-find entity-name="zenith.erp.india.IndiaGstSlab" list="gstSlabs">
            <order-by field-name="gstRate"/></entity-find>
        <entity-find entity-name="zenith.erp.india.IndiaTdsSection" list="tdsSections">
            <order-by field-name="sectionCode"/></entity-find>

        <set field="isIntraState" from="invoice.supplierStateCode == invoice.placeOfSupplyStateCode"/>
        </if>
    </actions>

    <widgets>
        <!-- ZE-PUR-IDOR: cross-tenant / missing invoice — plain notice, never another org's bill data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That purchase invoice isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <!-- Header Info -->
        <container-row>
            <row-col lg="4">
                <container-box><box-header title="Vendor (Supplier)"/><box-body>
                    <section name="VendorLink" condition="invoice.fromPartyId"><widgets>
                        <link url="/vapps/zenith/contacts/Contacts/EditContact" text="${vendorOrg?.organizationName ?: invoice.fromPartyId}" parameter-map="[partyId:invoice.fromPartyId]" link-type="anchor" style="text-primary text-weight-bold" class="text-h5 q-mb-sm block"/>
                    </widgets><fail-widgets>
                        <label text="${vendorOrg?.organizationName ?: invoice.fromPartyId}" type="h5"/>
                    </fail-widgets></section>
                    <label text="GSTIN: ${invoice.supplierGstin ?: 'N/A'}" type="div"/>
                    <label text="State: ${invoice.supplierStateCode ?: 'N/A'}" type="div"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="4">
                <container-box><box-header title="Organization (Buyer)"/><box-body>
                    <label text="${buyerOrg?.organizationName ?: invoice.toPartyId}" type="h5"/>
                    <label text="GSTIN: ${invoice.buyerGstin ?: 'N/A'}" type="div"/>
                    <label text="Place of Supply: ${invoice.placeOfSupplyStateCode ?: 'N/A'}" type="div"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="4">
                <container-box><box-header title="Invoice Info"/><box-body>
                    <label text="Invoice ID: ${invoiceId}" type="div"/>
                    <label text="Vendor Inv#: ${invoice.vendorInvoiceNumber ?: 'N/A'}" type="div"/>
                    <label text="Date: ${ec.l10n.format(invoice.invoiceDate, 'dd/MM/yyyy')}" type="div"/>
                    <label text="Status: ${invoice.statusId}" type="div"/>
                    <label text="RCM: ${invoice.isReverseCharge == 'Y' ? 'Yes' : 'No'}" type="div" condition="invoice.isReverseCharge == 'Y'"/>
                    <label text="Import: Yes" type="div" condition="invoice.isImportPurchase == 'Y'"/>
                    <label text="ITC: ${invoice.itcEligible == 'Y' ? 'Eligible' : 'Ineligible - ' + (invoice.itcIneligibleReason ?: '')}" type="div"/>
                    <label text="GSTR-2B: ${invoice.gstr2bMatchStatus ?: 'Not reconciled'}" type="div"/>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Tax Summary -->
        <container-row>
            <row-col lg="12">
                <container-box><box-header title="Tax Summary"/><box-body>
                    <container-row>
                        <row-col lg="2"><label text="Taxable: ₹${ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##,##0.00')}" type="div" style="text-info"/></row-col>
                        <row-col lg="2" condition="isIntraState"><label text="CGST: ₹${ec.l10n.format(invoice.totalCgst ?: 0, '#,##,##0.00')}" type="div"/></row-col>
                        <row-col lg="2" condition="isIntraState"><label text="SGST: ₹${ec.l10n.format(invoice.totalSgst ?: 0, '#,##,##0.00')}" type="div"/></row-col>
                        <row-col lg="2" condition="!isIntraState"><label text="IGST: ₹${ec.l10n.format(invoice.totalIgst ?: 0, '#,##,##0.00')}" type="div"/></row-col>
                        <row-col lg="2"><label text="Total: ₹${ec.l10n.format(invoice.invoiceTotal ?: 0, '#,##,##0.00')}" type="div" style="text-primary"/></row-col>
                    </container-row>
                    <label text="${invoice.amountInWords ?: ''}" type="div" style="text-muted" condition="invoice.amountInWords"/>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Line Items -->
        <container-box><box-header title="Line Items"/><box-toolbar>
            <section name="PurchInvActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="AddItemDialog" button-text="Add Item">
                <form-single name="AddItemForm" transition="addItem">
                    <field name="invoiceId"><default-field><hidden/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="quantity"><default-field><text-line size="8"/></default-field></field>
                    <field name="unitAmount"><default-field title="Unit Price"><text-line size="12"/></default-field></field>
                    <field name="hsnSacCode"><default-field title="HSN/SAC"><text-line size="10"/></default-field></field>
                    <field name="gstSlabId"><default-field title="GST Slab">
                        <drop-down allow-empty="true">
                            <list-options list="gstSlabs" key="${gstSlabId}" text="${gstRate}%${cessRate ? ' + ' + cessRate + '% Cess' : ''}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="discountPercent"><default-field title="Discount %"><text-line size="6"/></default-field></field>
                    <field name="submitButton"><default-field title="Add Item"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="PayWithTdsDialog" button-text="Record Payment">
                <form-single name="PayWithTdsForm" transition="payWithTds">
                    <field name="invoiceId"><default-field><hidden/></default-field></field>
                    <field name="tdsSectionId"><default-field title="TDS Section (optional)">
                        <drop-down allow-empty="true">
                            <list-options list="tdsSections" key="${tdsSectionId}" text="${sectionCode} - ${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="paymentDate"><default-field title="Payment Date"><date-time type="date"/></default-field></field>
                    <field name="paymentMethodEnumId"><default-field title="Method">
                        <drop-down>
                            <option key="PmtBankAccount" text="Bank Transfer (NEFT/RTGS)"/>
                            <option key="PmtCompanyCheck" text="Cheque"/>
                            <option key="PmtCash" text="Cash"/>
                        </drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Record Payment"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="InvoiceItemsForm" list="items" skip-form="true">
                <field name="invoiceItemSeqId"><default-field title="#"><display/></default-field></field>
                <field name="description"><default-field><display/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><display/></default-field></field>
                <field name="quantity"><default-field title="Qty"><display format="#,##0.##"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><display format="#,##,##0.00"/></default-field></field>
                <field name="discountPercent"><default-field title="Disc%"><display format="0.##"/></default-field></field>
                <field name="taxableAmount"><default-field title="Taxable"><display format="#,##,##0.00"/></default-field></field>
                <field name="cgstAmount" condition="isIntraState"><default-field title="CGST"><display format="#,##,##0.00"/></default-field></field>
                <field name="sgstAmount" condition="isIntraState"><default-field title="SGST"><display format="#,##,##0.00"/></default-field></field>
                <field name="igstAmount" condition="!isIntraState"><default-field title="IGST"><display format="#,##,##0.00"/></default-field></field>
            </form-list>
        </box-body></container-box>
        </widgets>
        </section>
    </widgets>
</screen>
