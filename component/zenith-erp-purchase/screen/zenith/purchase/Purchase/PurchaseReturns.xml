<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase Returns (Debit Notes)" default-menu-index="5">

    <transition name="createDebitNote">
        <!-- ZE-SB-013 (Tier 1): the vendor (fromPartyId) must belong to this org; guard only when supplied. -->
        <if condition="ec.web.parameters.vendorPartyId">
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'mantle.party.Party', idField:'partyId', idValue:ec.web.parameters.vendorPartyId, orgField:'ownerPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Please select a valid vendor from your account."/></if>
        </if>
        <service-call name="create#mantle.account.invoice.Invoice" out-map="createOut"
            in-map="[invoiceTypeEnumId:'InvoiceDebitNote', statusId:'InvoiceInProcess', fromPartyId:ec.web.parameters.vendorPartyId, toPartyId:(ec.web.parameters.organizationPartyId ?: ec.user.getPreference('ACTIVE_ORGANIZATION')), invoiceDate:(ec.web.parameters.invoiceDate ?: ec.user.nowTimestamp), currencyUomId:'INR']"/>
        <default-response url="../PurchaseReturnDetail">
            <parameter name="invoiceId" value="${createOut.invoiceId}"/>
        </default-response>
        <error-response url="."/>
    </transition>

    <transition name="viewDebitNote"><default-response url="../PurchaseReturnDetail"/></transition>

    <actions>
        <entity-find entity-name="mantle.party.PartyRole" list="internalOrgRoles">
            <econdition field-name="roleTypeId" operator="in" value="OrgInternal,InternalOrganization"/>
        </entity-find>
        <set field="internalOrgIdList" from="internalOrgRoles.partyId"/>
        <set field="activeOrgId" from="ec.user.getPreference('ActiveOrgId') ?: (internalOrgIdList ? internalOrgIdList[0] : null)"/>

        <entity-find entity-name="mantle.account.invoice.Invoice" list="debitNoteList">
            <econdition field-name="invoiceTypeEnumId" value="InvoiceDebitNote"/>
            <econdition field-name="toPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
            <search-form-inputs default-order-by="-invoiceDate"/>
        </entity-find>
        
        <!-- real invoice status ids (InvoicePaid / InvoiceIn-Process were stale -> all grey);
             mapped to the mockup's Completed(green)/Waiting(orange)/Not Done Yet(red) -->
        <set field="statusColorMap" from="[
            'InvoiceFinalized': 'success', 'InvoicePmtRecvd': 'success', 'InvoicePmtSent': 'success', 'InvoiceApproved': 'success', 'InvoiceBilledThrough': 'success',
            'InvoiceInProcess': 'warning', 'InvoiceReceived': 'warning', 'InvoiceIncoming': 'warning', 'InvoiceSent': 'warning', 'InvoiceAcked': 'warning',
            'InvoiceCancelled': 'danger', 'InvoiceWriteOff': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="zsec-hdr row items-center justify-between q-mb-lg z-newbtn-wrap">
            <container>
                <label text="Purchase Returns" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Returns you made to vendors and the amount reduced." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <!-- ZE-PUR: New Debit Note (return) is a write action — hidden for view-only users -->
            <section name="NewDebitNoteWrite">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
            <container-dialog id="CreateDebitNoteDialog" button-text="+ New Debit Note" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                <form-single name="CreateDebitNoteForm" transition="createDebitNote">
                    <field name="vendorPartyId">
                        <default-field title="Vendor (Supplier)">
                            <drop-down allow-empty="false">
                                <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                        <econdition field-name="roleTypeId" value="Supplier"/>
                                        <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Buying Organization">
                            <drop-down allow-empty="false" no-current-selected-key="${activeOrgId}">
                                <entity-options key="${partyId}" text="${organizationName} [${partyId}]">
                                    <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                        <econdition field-name="roleTypeId" operator="in" value="OrgInternal,InternalOrganization"/>
                                        <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="invoiceDate"><default-field title="Return Date"><date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/></default-field></field>
                    <field name="submitButton"><default-field title="Create Debit Note"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Purchase Returns (Debit Notes)..." style="display:none"></span>]]></text></render-mode>
            <form-list name="DebitNoteList" list="debitNoteList" skip-form="true" header-dialog="true" show-csv-button="true">
                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <set field="_si" from="ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()"/>
                    <set field="statusLabel" from="_si?.description ?: (statusId ? statusId.replace('Invoice','') : 'In Process')"/>
                </row-actions>

                <field name="invoiceId">
                    <header-field title="Debit Note No." show-order-by="true">
                        <text-find default-operator="contains" hide-options="true"/>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${gstInvoiceNumber ?: invoiceId}"/></conditional-field>
                    <default-field>
                        <link url="viewDebitNote" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="z-vlink"/>
                    </default-field>
                </field>
                
                <field name="fromPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                    <econdition field-name="roleTypeId" value="Supplier"/>
                                    <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                </entity-find>
                            </entity-options>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <display-entity entity-name="mantle.party.PartyDetail" text="${organizationName?:firstName} ${lastName?:''}"/>
                    </default-field>
                </field>

                <field name="invoiceDate">
                    <header-field title="Return Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${ec.l10n.format(invoiceDate, 'dd MMM yyyy')}" type="span" style="text-dark"/>
                    </default-field>
                </field>

                <field name="invoiceTotal">
                    <header-field title="Amount (${currSymbol})" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${invoiceTotal ?: 0}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${zinr.inr(ec.l10n.format(invoiceTotal ?: 0, '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/>
                    </default-field>
                </field>
                
                <field name="statusId">
                    <header-field title="Status" show-order-by="true">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIn-Process" text="Draft"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoicePaid" text="Settled / Adjusted"/>
                            <option key="InvoiceCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${statusLabel}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${statusLabel}" type="span" style="zenith-badge z-stbadge ${statusColor}"/>
                    </default-field>
                </field>

                <field name="actions">
                    <header-field title="Actions"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><ignored/></conditional-field>
                    <default-field>
                        <link url="viewDebitNote" text="⋮" parameter-map="[invoiceId:invoiceId]" style="z-kebab"/>
                    </default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
