<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vendor Evaluation" default-menu-index="10">

    <transition name="createEvaluation">
        <service-call name="create#zenith.erp.purchase.VendorEvaluation"/>
        <default-response url="."/>
    </transition>
    <transition-include name="searchPartyList" location="component://SimpleScreens/template/party/PartyForms.xml"/>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.purchase.VendorEvaluation" list="evalList">
            <search-form-inputs default-order-by="-evaluationDate"/>
            <econdition field-name="vendorPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Vendor Evaluations" type="h5" style="text-dark text-weight-bold q-my-none"/>
                <container-dialog id="NewEvalDialog" button-text="New Evaluation" width="800" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                    <container style="q-px-md q-pt-md">
                        <form-single name="NewEvalForm" transition="createEvaluation">
                            <field name="vendorPartyId"><default-field title="Vendor">
                                <drop-down>
                                    <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                                </drop-down>
                            </default-field></field>
                            <field name="evaluationDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                            <field name="qualityScore"><default-field title="Quality (1-10)"><text-line/></default-field></field>
                            <field name="deliveryScore"><default-field title="Delivery (1-10)"><text-line/></default-field></field>
                            <field name="priceScore"><default-field title="Price (1-10)"><text-line/></default-field></field>
                            <field name="overallScore"><default-field title="Overall Score"><text-line/></default-field></field>
                            <field name="remarks"><default-field><text-area rows="3"/></default-field></field>
                            <field name="submitButton"><default-field title="Save Evaluation"><submit/></default-field></field>
                            
                            <field-layout>
                                <field-ref name="vendorPartyId"/>
                                <field-ref name="evaluationDate"/>
                                <field-row><field-ref name="qualityScore"/><field-ref name="deliveryScore"/></field-row>
                                <field-row><field-ref name="priceScore"/><field-ref name="overallScore"/></field-row>
                                <field-ref name="remarks"/>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container>
                </container-dialog>
            </container>
            
            <form-list name="EvalListForm" list="evalList" skip-box="true" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorDetail">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="vendorName" from="ec.resource.expand('PartyNameTemplate', null, vendorDetail)"/>
                </row-actions>
                <field name="vendorPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${vendorName}"/>
                    </conditional-field>
                    <default-field>
                        <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                    </default-field>
                </field>
                <field name="evaluationDate">
                    <header-field title="Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field><display format="dd MMM yyyy"/></default-field>
                </field>
                <field name="qualityScore"><default-field title="Quality"><display/></default-field></field>
                <field name="deliveryScore"><default-field title="Delivery"><display/></default-field></field>
                <field name="priceScore"><default-field title="Price"><display/></default-field></field>
                <field name="overallScore">
                    <header-field title="Overall" show-order-by="true"/>
                    <default-field><display format="0.0"/></default-field>
                </field>
                <field name="remarks"><default-field><display/></default-field></field>
                <field name="submitButton">
                    <header-field title="Find"><submit/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><ignored/></conditional-field>
                    <default-field><ignored/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
