<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Vendor Evaluation" default-menu-index="10">

    <transition name="createEvaluation">
        <actions><service-call name="zenith.purchase.VendorEvaluationServices.create#VendorEvaluation" in-map="ec.web.parameters"/></actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteEvaluation">
        <actions><service-call name="zenith.purchase.VendorEvaluationServices.delete#VendorEvaluation" in-map="[evaluationId:evaluationId]"/></actions>
        <default-response url="."/>
    </transition>
    <!-- Fixed supplier roles and canonical ownership apply to exact IDs as well as type-ahead. -->
    <transition name="searchVendorList" read-only="true">
        <parameter name="term"/>
        <actions>
            <service-call name="zenith.purchase.VendorEvaluationServices.get#EvaluationOrganization" out-map="scope"/>
            <set field="term" from="(ec.web.parameters.term ?: '').toString().trim()"/>
            <if condition="!scope.organizationPartyId || !term"><script>ec.web.sendJsonResponse([])</script><return/></if>
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="vendors" limit="25" distinct="true">
                <econdition field-name="ownerPartyId" from="scope.organizationPartyId"/>
                <econdition field-name="roleTypeId" operator="in" from="['Vendor','Supplier']"/>
                <econditions combine="or"><econdition field-name="disabled" value="N"/><econdition field-name="disabled" operator="is-null"/></econditions>
                <econditions combine="or">
                    <econdition field-name="partyId" from="term"/>
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true"/>
                </econditions>
                <order-by field-name="organizationName,firstName,lastName"/>
            </entity-find>
            <script><![CDATA[
                ec.web.sendJsonResponse(vendors.collect { [value:it.partyId,label:ec.resource.expand('PartyNameTemplate','',it)] }.unique {it.value})
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>
    <actions>
        <service-call name="zenith.purchase.VendorEvaluationServices.get#EvaluationOrganization" out-map="scope"/>
        <entity-find entity-name="mantle.party.Party" list="ownedVendors">
            <econdition field-name="ownerPartyId" from="scope.organizationPartyId ?: '__NO_ORGANIZATION__'"/>
            <select-field field-name="partyId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.purchase.VendorEvaluation" list="evalList">
            <search-form-inputs default-order-by="-evaluationDate" skip-fields="ownerPartyId,organizationPartyId"/>
            <econdition field-name="vendorPartyId" operator="in" from="ownedVendors ? ownedVendors.collect {it.partyId} : ['__NO_ORGANIZATION__']"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zveval-page">
        <container style="column q-mb-lg z-newbtn-wrap zveval-header">
            <label text="Vendor Evaluations" type="h4" style="text-dark text-weight-bold q-my-none q-mb-sm"/>
            <!-- ZE-PUR: New Evaluation (save-evaluation) is a write action — hidden for view-only users -->
            <section name="NewEvalWrite">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
                <container-dialog id="NewEvalDialog" button-text="+ New Evaluation" width="800" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                    <container style="q-px-md q-pt-md">
                        <form-single name="NewEvalForm" transition="createEvaluation">
                            <field name="vendorPartyId"><default-field title="Vendor" required="true">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="searchVendorList" server-search="true" min-length="2"/>
                                </drop-down>
                            </default-field></field>
                            <field name="evaluationDate"><default-field title="Date" required="true"><date-time type="date"/></default-field></field>
                            <field name="qualityScore"><default-field title="Quality (1-5)" required="true"><text-line size="8"/></default-field></field>
                            <field name="deliveryScore"><default-field title="Delivery (1-5)" required="true"><text-line size="8"/></default-field></field>
                            <field name="priceScore"><default-field title="Price (1-5)" required="true"><text-line size="8"/></default-field></field>
                            <field name="remarks"><default-field><text-area rows="3"/></default-field></field>
                            <field name="submitButton"><default-field title="Save Evaluation"><submit/></default-field></field>

                            <field-layout>
                                <field-ref name="vendorPartyId"/>
                                <field-ref name="evaluationDate"/>
                                <field-row><field-ref name="qualityScore"/><field-ref name="deliveryScore"/></field-row>
                                <field-ref name="priceScore"/>
                                <field-ref name="remarks"/>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container>
                </container-dialog>
              </widgets>
            </section>
        </container>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Vendor Evaluation..." style="display:none"></span>]]></text></render-mode>
            <form-list name="EvalListForm" list="evalList" skip-box="true" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                <row-actions>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendorDetail">
                        <field-map field-name="partyId" from="vendorPartyId"/>
                    </entity-find-one>
                    <set field="vendorName" from="vendorDetail ? (vendorDetail.organizationName ?: ((vendorDetail.firstName ?: '') + ' ' + (vendorDetail.lastName ?: '')).trim()) : ''"/>
                    <!-- 5-star render as two labels (filled amber ★ + empty grey ☆, no raw HTML) + colour-coded overall (mockup §6) -->
                    <script><![CDATA[
                        def _st = { n ->
                            if(n == null) return ['Not recorded','']
                            def value=n as BigDecimal
                            if(value < 1 || value > 5 || value.remainder(BigDecimal.ONE) != 0) return [value.toPlainString() + ' (legacy)','']
                            int f=value.intValueExact()
                            return ['★' * f, '☆' * (5 - f)]
                        }
                        def _q = _st(qualityScore);  qualityOn  = _q[0]; qualityOff  = _q[1]
                        def _d = _st(deliveryScore); deliveryOn = _d[0]; deliveryOff = _d[1]
                        def _p = _st(priceScore);    priceOn    = _p[0]; priceOff    = _p[1]
                        def _ov = overallScore == null ? null : overallScore as BigDecimal
                        overallDisp = _ov == null ? 'Not recorded' : _ov.setScale(2, java.math.RoundingMode.HALF_UP).toString()
                        overallCls = (_ov != null && _ov >= 4.0 && _ov <= 5.0) ? 'z-score-hi' : 'z-score-lo'
                    ]]></script>
                </row-actions>
                <field name="vendorPartyId">
                    <header-field title="Vendor">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="searchVendorList" server-search="true" min-length="2"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']">
                        <display text="${vendorName}"/>
                    </conditional-field>
                    <default-field>
                        <display-entity entity-name="mantle.party.PartyDetail" text="${organizationName ?: ((firstName ?: '') + ' ' + (lastName ?: '')).trim()}"/>
                    </default-field>
                </field>
                <field name="evaluationDate">
                    <header-field title="Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <display format="dd MMM yyyy"/>
                    </default-field>
                </field>
                <field name="qualityScore">
                    <header-field title="Quality"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display/></conditional-field>
                    <default-field><label text="${qualityOn}" type="span" style="z-stars z-star-on"/><label text="${qualityOff}" type="span" style="z-stars z-star-off"/></default-field>
                </field>
                <field name="deliveryScore">
                    <header-field title="Delivery"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display/></conditional-field>
                    <default-field><label text="${deliveryOn}" type="span" style="z-stars z-star-on"/><label text="${deliveryOff}" type="span" style="z-stars z-star-off"/></default-field>
                </field>
                <field name="priceScore">
                    <header-field title="Price"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display/></conditional-field>
                    <default-field><label text="${priceOn}" type="span" style="z-stars z-star-on"/><label text="${priceOff}" type="span" style="z-stars z-star-off"/></default-field>
                </field>
                <field name="overallScore">
                    <header-field title="Overall" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display format="0.00"/></conditional-field>
                    <default-field><label text="${overallDisp}" type="span" style="text-weight-bold ${overallCls}"/></default-field>
                </field>
                <field name="remarks"><conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><display/></conditional-field><default-field title="Remarks"><label text="${remarks ?: ''}" type="span" style="text-grey-7"/></default-field></field>
                <field name="rowActions">
                    <header-field title="Actions"/>
                    <conditional-field condition="sri.getRenderMode() in ['csv','xlsx']"><ignored/></conditional-field>
                    <conditional-field name="act_write" condition="modCanWrite">
                        <link url="deleteEvaluation" text="Delete" parameter-map="[evaluationId:evaluationId]" style="zveval-delete" confirmation="Delete this evaluation? This can't be undone."/>
                    </conditional-field>
                    <default-field><ignored/></default-field>
                </field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
