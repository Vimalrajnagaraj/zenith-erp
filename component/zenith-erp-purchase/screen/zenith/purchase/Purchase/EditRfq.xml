<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit RFQ" default-menu-include="false">

    <parameter name="rfqId" required="true"/>

    <transition name="updateRfq">
        <service-call name="zenith.purchase.RfqServices.update#Rfq"/>
        <default-response url="."/>
    </transition>

    <transition name="createRfqItem">
        <service-call name="zenith.purchase.RfqServices.set#RfqItem"/>
        <default-response url="."/>
    </transition>

    <transition name="updateRfqItem">
        <service-call name="zenith.purchase.RfqServices.set#RfqItem"/>
        <default-response url="."/>
    </transition>

    <transition name="deleteRfqItem">
        <service-call name="zenith.purchase.RfqServices.delete#RfqItem"/>
        <default-response url="."/>
    </transition>

    <transition name="createVendorResponse">
        <service-call name="zenith.purchase.RfqServices.set#VendorResponse"/>
        <default-response url="."/>
    </transition>

    <transition name="updateVendorResponse">
        <service-call name="zenith.purchase.RfqServices.set#VendorResponse"/>
        <default-response url="."/>
    </transition>

    <transition name="deleteVendorResponse">
        <service-call name="zenith.purchase.RfqServices.delete#VendorResponse"/>
        <default-response url="."/>
    </transition>

    <!-- ZE-SEC-JSON f/u: org-scoped party picker (stock SimpleScreens searchPartyList leaks cross-tenant). -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <!-- ZE-PUR-IDOR: explicit cross-tenant render guard — only the owning org (super-admins exempt) may open
             this RFQ. Load NOTHING when blocked; widgets show a plain no-access panel instead of another
             tenant's RFQ / vendor-response data. RENDER guard only (transitions untouched). -->
        <service-call name="zenith.purchase.RfqServices.assert#RfqAccess" in-map="[rfqId:rfqId]" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.purchase.PurchaseRfq" value-field="rfq"/>
        <if condition="rfq == null"><return error="true" message="RFQ not found with ID ${rfqId}"/></if>

        <entity-find entity-name="zenith.erp.purchase.PurchaseRfqItem" list="itemList">
            <econdition field-name="rfqId"/>
            <order-by field-name="rfqItemSeqId"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.purchase.RfqVendorResponse" list="responseList">
            <econdition field-name="rfqId"/>
            <order-by field-name="responseDate"/>
        </entity-find>

        <set field="statusColorMap" from="[
            'RfqDraft': 'grey',
            'RfqSent': 'info',
            'RfqClosed': 'success',
            'RfqCancelled': 'danger'
        ]"/>
        <set field="statusColor" from="statusColorMap[rfq.statusId] ?: 'dark'"/>
        <set field="statusText" from="rfq.statusId ? rfq.statusId.replace('Rfq', '') : 'Draft'"/>
        </if>
    </actions>

    <widgets>
        <container style="zrfq-page">
        <!-- ZE-PUR-IDOR: cross-tenant / missing RFQ — plain notice, never another org's RFQ data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container style="zenith-card q-pa-lg bg-white shadow-1 border-radius-md q-mt-md text-center">
                    <label text="That RFQ isn't part of your account." type="h5" style="text-grey-8 q-mb-xs"/>
                    <label text="It may belong to another organization, or it may not exist." type="p" style="text-grey-6 q-mb-none"/>
                </container>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="RFQ ${rfq.rfqNumber}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="${rfq.description}" type="p" style="text-grey-7 q-mt-sm q-mb-none" condition="rfq.description"/>
            </container>
            <container>
                <label text="${statusText}" type="span" style="zenith-badge ${statusColor} text-h6 q-mr-md"/>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg">
            <label text="RFQ Details" type="h5" style="text-dark text-weight-bold q-mb-md"/>
            <form-single name="UpdateRfqForm" transition="updateRfq" map="rfq">
                <field name="rfqId"><default-field><hidden/></default-field></field>
                <field name="organizationPartyId"><default-field title="Organization">
                    <display-entity entity-name="mantle.party.PartyDetail" text="${organizationName}"/>
                </default-field></field>
                
                <field name="rfqDate"><default-field title="RFQ Date"><display format="dd MMM yyyy HH:mm"/></default-field></field>
                <field name="closingDate"><default-field title="Closing Date"><date-time type="date"/></default-field></field>
                
                <field name="statusId">
                    <default-field title="Status">
                        <drop-down>
                            <option key="RfqDraft" text="Draft"/>
                            <option key="RfqSent" text="Sent to Vendors"/>
                            <option key="RfqClosed" text="Closed (Awarded)"/>
                            <option key="RfqCancelled" text="Cancelled"/>
                        </drop-down>
                    </default-field>
                </field>
                
                <field name="description"><default-field><text-line/></default-field></field>
                <field name="remarks"><default-field><text-area rows="3"/></default-field></field>
                
                <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite" title="Update RFQ"><submit type="primary"/></conditional-field><default-field title="Update RFQ"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                
                <field-layout>
                    <field-row><field-ref name="organizationPartyId"/><field-ref name="statusId"/></field-row>
                    <field-row><field-ref name="rfqDate"/><field-ref name="closingDate"/></field-row>
                    <field-row><field-ref name="description"/></field-row>
                    <field-row><field-ref name="remarks"/></field-row>
                    <field-ref name="submitButton"/>
                </field-layout>
            </form-single>
        </container>

        <!-- Items Section -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md q-mb-lg">
            <container style="row items-center justify-between q-mb-md">
                <label text="Requested Items" type="h5" style="text-dark text-weight-bold q-my-none"/>
                <section name="RfqAddItem_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddItemDialog" button-text="Add Item" width="800" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                    <container style="q-px-md q-pt-md">
                        <form-single name="AddItemForm" transition="createRfqItem">
                            <field name="rfqId"><default-field><hidden/></default-field></field>
                            <field name="productId"><default-field title="Product">
                                <drop-down allow-empty="true">
                                    <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                        <entity-find entity-name="mantle.product.Product">
                                            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
                                            <order-by field-name="pseudoId"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down>
                            </default-field></field>
                            <field name="description"><default-field title="Item Description"><text-line/></default-field></field>
                            <field name="quantity"><default-field><text-line/></default-field></field>
                            <field name="uomId"><default-field title="UOM"><text-line/></default-field></field>
                            <field name="productTaxCode"><default-field title="HSN/SAC"><text-line/></default-field></field>
                            <field name="requiredByDate"><default-field title="Required By"><date-time type="date"/></default-field></field>
                            <field name="submitButton"><default-field title="Add Item"><submit/></default-field></field>
                            
                            <field-layout>
                                <field-row><field-ref name="productId"/></field-row>
                                <field-row><field-ref name="description"/></field-row>
                                <field-row><field-ref name="quantity"/><field-ref name="uomId"/></field-row>
                                <field-row><field-ref name="productTaxCode"/><field-ref name="requiredByDate"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container>
                </container-dialog>
                </widgets></section>
            </container>
            <form-list name="ItemListForm" list="itemList" skip-box="true" skip-form="false" transition="updateRfqItem">
                <field name="rfqId"><default-field><hidden/></default-field></field>
                <field name="rfqItemSeqId"><default-field><hidden/></default-field></field>
                
                <field name="productId"><default-field title="Product ID"><text-line size="15"/></default-field></field>
                <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                <field name="quantity"><default-field title="Quantity"><text-line size="10"/></default-field></field>
                <field name="uomId"><default-field title="UOM"><text-line size="10"/></default-field></field>
                <field name="productTaxCode"><default-field title="HSN/SAC"><text-line size="15"/></default-field></field>
                <field name="requiredByDate"><default-field title="Required By"><date-time type="date"/></default-field></field>
                
                <field name="submitButton"><conditional-field name="row_write" condition="modCanWrite" title="Update"><submit/></conditional-field><default-field title="Update"><label text="" type="span"/></default-field></field>
                <field name="deleteLink">
                    <conditional-field name="del_write" condition="modCanWrite" title="">
                    <link url="deleteRfqItem" text="Delete" parameter-map="[rfqId:rfqId, rfqItemSeqId:rfqItemSeqId]" confirmation="Delete this item?" style="text-danger"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>

        <!-- Vendor Responses Section -->
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <container style="row items-center justify-between q-mb-md">
                <label text="Vendor Responses" type="h5" style="text-dark text-weight-bold q-my-none"/>
                <section name="RfqAddResponse_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="AddResponseDialog" button-text="Add Response" width="800" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-teal-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                    <container style="q-px-md q-pt-md">
                        <form-single name="AddResponseForm" transition="createVendorResponse">
                            <field name="rfqId"><default-field><hidden/></default-field></field>
                            <field name="vendorPartyId"><default-field title="Vendor">
                                <drop-down>
                                    <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                                </drop-down>
                            </default-field></field>
                            <field name="responseDate"><default-field title="Response Date"><date-time type="date-time" default-value="${ec.user.nowTimestamp}"/></default-field></field>
                            <field name="totalAmount"><default-field title="Total Quote Amount"><text-line/></default-field></field>
                            <field name="deliveryDays"><default-field title="Delivery (Days)"><text-line/></default-field></field>
                            <field name="paymentTerms"><default-field title="Payment Terms"><text-line/></default-field></field>
                            <field name="isSelected"><default-field title="Selected (Winner)">
                                <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field></field>
                            <field name="remarks"><default-field title="Remarks"><text-area rows="3"/></default-field></field>
                            <field name="submitButton"><default-field title="Log Response"><submit/></default-field></field>
                            
                            <field-layout>
                                <field-row><field-ref name="vendorPartyId"/></field-row>
                                <field-row><field-ref name="responseDate"/><field-ref name="totalAmount"/></field-row>
                                <field-row><field-ref name="deliveryDays"/><field-ref name="paymentTerms"/></field-row>
                                <field-row><field-ref name="isSelected"/></field-row>
                                <field-row><field-ref name="remarks"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container>
                </container-dialog>
                </widgets></section>
            </container>
            <form-list name="ResponseListForm" list="responseList" skip-box="true" skip-form="false" transition="updateVendorResponse">
                <field name="rfqId"><default-field><hidden/></default-field></field>
                <field name="rfqResponseId"><default-field><hidden/></default-field></field>
                
                <field name="vendorPartyId"><default-field title="Vendor">
                    <display-entity entity-name="mantle.party.PartyDetail" text="${organizationName?:firstName} ${lastName?:''}"/>
                </default-field></field>
                <field name="responseDate"><default-field title="Response Date"><date-time type="date-time"/></default-field></field>
                <field name="totalAmount"><default-field title="Amount Quote"><text-line size="10"/></default-field></field>
                <field name="deliveryDays"><default-field title="Delivery Days"><text-line size="5"/></default-field></field>
                <field name="paymentTerms"><default-field title="Payment Terms"><text-line size="15"/></default-field></field>
                <field name="isSelected"><default-field title="Winner?">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                </default-field></field>
                
                <field name="submitButton"><conditional-field name="row_write" condition="modCanWrite" title="Update"><submit/></conditional-field><default-field title="Update"><label text="" type="span"/></default-field></field>
                <field name="deleteLink">
                    <conditional-field name="del_write" condition="modCanWrite" title="">
                    <link url="deleteVendorResponse" text="Delete" parameter-map="[rfqId:rfqId, rfqResponseId:rfqResponseId]" confirmation="Delete this response?" style="text-danger"/>
                    </conditional-field>
                    <default-field title=""><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
        </widgets>
        </section>

        </container>
    </widgets>
</screen>
