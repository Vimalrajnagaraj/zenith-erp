<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Goods Receipt Note (GRN)" default-menu-index="1">

    <transition name="createGrn"><actions><service-call name="zenith.purchase.OperationsServices.create#GoodsReceiptNote" in-map="[purchaseOrderId:purchaseOrderId,receiptDate:receiptDate,freightAmount:freightAmount,insuranceAmount:insuranceAmount,customsDutyAmount:customsDutyAmount]"/></actions><default-response url="."/><error-response url="."/></transition>

    <transition name="exportCsv" read-only="true"><actions><script><![CDATA[
        exportFilters=[:]
        ['grnId','purchaseOrderId','receiptDate'].each {field -> ['', '_op','_not','_ic','_from','_thru','_period','_poffset'].each {suffix ->
            def key=field+suffix
            if(ec.web.requestParameters[key]!=null) exportFilters[key]=ec.web.requestParameters[key]
        }}
        if(ec.web.requestParameters.orderByField) exportFilters.orderByField=ec.web.requestParameters.orderByField
    ]]></script></actions><default-response url="." parameter-map="exportFilters + [renderMode:'csv',pageNoLimit:'true',saveFilename:'GoodsReceipt.csv',lastStandalone:'true']"/></transition>

    <actions>
        <script><![CDATA[
            // Export only supported search fields, never request/session attributes or scope overrides.
            csvFilters=[:]
            def fields=['grnId', 'purchaseOrderId', 'receiptDate']
            def suffixes=['','_op','_not','_ic','_from','_thru','_period','_poffset']
            fields.each {field -> suffixes.each {suffix ->
                def key=field+suffix
                if(ec.web.requestParameters[key]!=null) csvFilters[key]=ec.web.requestParameters[key]
            }}
            if(ec.web.requestParameters.orderByField) csvFilters.orderByField=ec.web.requestParameters.orderByField
        ]]></script>
        <service-call name="zenith.purchase.OperationsServices.get#PurchaseOrganization" out-map="scope"/>
        <set field="_org" from="scope.organizationPartyId ?: '__NO_ORGANIZATION__'"/>
        <set field="currSymbol" from="currSymbol ?: '₹'"/>
        <set field="activeOrgId" from="_org"/><service-call name="zenith.purchase.OperationsServices.get#PurchaseOrderIds" out-map="poScope"/>
        <entity-find entity-name="zenith.erp.purchase.GoodsReceiptNoteView" list="grnList">
            <search-form-inputs skip-fields="organizationPartyId,ownerPartyId,customerPartyId,toPartyId,orderPartSeqId" default-order-by="-receiptDate"/>
            <!-- ZE-SALES-014 f/u: org-isolate the list (buying org lives on the joined OrderHeader) -->
            <econdition field-name="customerPartyId" from="_org"/><econdition field-name="purchaseOrderId" operator="in" from="poScope.orderIds ?: ['__NO_ORGANIZATION__']"/>
        </entity-find>
    </actions>

    <widgets><container style="zpur-page">
        <section name="GrnHeader" condition="!(sri.getRenderMode() in ['csv','xlsx'])"><widgets>
        <!-- Page header: title + subtitle (left); Export CSV (violet outline) + New GRN (solid) (right) -->
        <container style="zsec-hdr row items-center justify-between q-mb-lg z-newbtn-wrap">
            <container style="column">
                <label text="Goods Receipt Notes" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Record receipt references and landed surcharges. Manage inventory receipts in Inventory." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container style="z-hdractions">
                <link url="." parameter-map="csvFilters + [renderMode:'csv',pageNoLimit:'true',saveFilename:'GoodsReceipt.csv',lastStandalone:'true']" text="Export CSV" icon="download" link-type="anchor" style="z-obtn"/>
                <!-- ZE-PUR: New GRN (receive goods) is a write action — hidden for view-only users -->
                <section name="NewGrnWrite">
                  <condition><expression>modCanWrite</expression></condition>
                  <widgets>
                    <container-dialog id="CreateGrnDialog" button-text="+ New GRN"
                        button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                        <form-single name="CreateGrnForm" transition="createGrn">
                            <field name="purchaseOrderId">
                                <default-field title="Purchase Order">
                                    <drop-down allow-empty="false">
                                        <entity-options key="${orderId}" text="PO-${orderId} [${vendorPartyId}]">
                                            <entity-find entity-name="mantle.order.OrderHeaderAndPart">
                                                <econdition field-name="customerPartyId" from="_org"/><econdition field-name="orderId" operator="in" from="poScope.orderIds ?: ['__NO_ORGANIZATION__']"/>
                                                <econdition field-name="vendorPartyId" operator="is-not-null"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="receiptDate"><default-field><date-time type="date"/></default-field></field>
                            <field name="freightAmount"><default-field title="Freight Charges"><text-line size="15"/></default-field></field>
                            <field name="insuranceAmount"><default-field title="Insurance Charges"><text-line size="15"/></default-field></field>
                            <field name="customsDutyAmount"><default-field title="Customs Duty (Imports)"><text-line size="15"/></default-field></field>
                            <field name="submitButton"><default-field title="Create GRN"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                  </widgets>
                </section>
            </container>
        </container>

        </widgets></section>
        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <container style="zsec-hdr row items-center justify-between q-mb-md">
                <container-dialog id="FindOptionsDialog" button-text="Find Options" button-class="btn btn-default">
                    <form-single name="FindOptionsForm" transition="." type="find">
                        <field name="grnId"><default-field title="GRN No."><text-find hide-options="true"/></default-field></field>
                        <field name="purchaseOrderId"><default-field title="Purchase Order"><text-find hide-options="true"/></default-field></field>
                        <field name="receiptDate"><default-field title="Receipt Date"><date-find/></default-field></field>
                        <field name="searchButton"><default-field title=""><submit text="Search" icon="fa fa-search"/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>

            <form-list name="GrnList" list="grnList" skip-form="true">
                <row-actions>
                    <set field="vendorLookupId" from="poVendorPartyId ?: vendorPartyId"/>
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
                        <field-map field-name="partyId" from="vendorLookupId"/>
                    </entity-find-one>
                    <script><![CDATA[
                        def grp = { v -> ec.l10n.format((v ?: 0.0) as BigDecimal, '#,##,##0.00') }
                        vendorDisp = ((vendor?.organizationName ?: vendor?.firstName ?: '') + ' ' + (vendor?.lastName ?: '')).trim() ?: '—'
                        freightDisp = grp(freightAmount)
                        insuranceDisp = grp(insuranceAmount)
                        customsDisp = grp(customsDutyAmount)
                        totalLanded = (freightAmount ?: 0.0G) + (insuranceAmount ?: 0.0G) + (customsDutyAmount ?: 0.0G)
                        totalDisp = grp(totalLanded)
                        receiptDisp = receiptDate ? ec.l10n.format(receiptDate, 'dd MMM yyyy') : '—'
                        isCsv = ec.web?.parameters?.renderMode == 'csv' || ec.web?.parameters?.renderMode == 'xlsx'
                    ]]></script>
                </row-actions>

                <field name="grnId">
                    <header-field title="GRN No." show-order-by="true"/>
                    <conditional-field condition="isCsv"><display text="${grnId}"/></conditional-field>
                    <default-field><label text="${grnId}" type="span" style="z-pillid"/></default-field>
                </field>
                <field name="purchaseOrderId">
                    <header-field title="Purchase Order"/>
                    <default-field><label text="${purchaseOrderId}" type="span" style="text-dark"/></default-field>
                </field>
                <field name="vendorName">
                    <header-field title="Vendor"/>
                    <default-field><label text="${vendorDisp}" type="span" style="text-dark"/></default-field>
                </field>
                <field name="receiptDate">
                    <header-field title="Receipt Date" show-order-by="true"/>
                    <conditional-field condition="isCsv"><display format="dd MMM yyyy"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico-primary"/>
                        <label text="${receiptDisp}" type="span" style="text-dark"/>
                    </default-field>
                </field>
                <field name="currencyUomId"><header-field title="Currency"/><default-field><display/></default-field></field>
                <field name="freightAmount">
                    <header-field title="Freight"/>
                    <conditional-field condition="isCsv"><display format="#,##,##0.00"/></conditional-field>
                    <default-field><label text="${freightDisp}" type="span" style="z-amt-green text-weight-medium"/></default-field>
                </field>
                <field name="insuranceAmount">
                    <header-field title="Insurance"/>
                    <conditional-field condition="isCsv"><display format="#,##,##0.00"/></conditional-field>
                    <default-field><label text="${insuranceDisp}" type="span" style="z-amt-blue text-weight-medium"/></default-field>
                </field>
                <field name="customsDutyAmount">
                    <header-field title="Customs Duty"/>
                    <conditional-field condition="isCsv"><display format="#,##,##0.00"/></conditional-field>
                    <default-field><label text="${customsDisp}" type="span" style="z-txt-orange text-weight-medium"/></default-field>
                </field>
                <field name="totalLanded">
                    <header-field title="Total Landed Surcharges"/>
                    <conditional-field condition="isCsv"><display text="${totalDisp}"/></conditional-field>
                    <default-field><label text="${totalDisp}" type="span" style="text-dark text-weight-medium"/></default-field>
                </field>
                <field name="rowAction">
                    <header-field title=""/>
                    <conditional-field condition="isCsv"><display text=""/></conditional-field>
                    <default-field><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>
</container>    </widgets>
</screen>
