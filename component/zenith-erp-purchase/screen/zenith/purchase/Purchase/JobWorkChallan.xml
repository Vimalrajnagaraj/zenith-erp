<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job Work Challan" default-menu-index="2">
    <transition name="createChallan">
        <service-call name="zenith.purchase.JobWorkServices.create#Challan"/>
        <default-response url="."/>
    </transition>

    <transition name="receiveChallan">
        <actions>
            <if condition="!actualReturnDate"><return error="true" message="Please enter the return date."/></if>
            <service-call name="zenith.purchase.JobWorkServices.update#ChallanStatus" in-map="[challanId:challanId,actualReturnDate:actualReturnDate]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="nowTimestamp" from="ec.user.nowTimestamp"/>
        <set field="thirtyDaysFromNow" from="new java.sql.Timestamp(nowTimestamp.getTime() + (30L * 24L * 60L * 60L * 1000L))"/>
        
        <!-- Active = out at job worker, comfortably within deadline (EXCLUDES the approaching-30d window
             so the 4 cards are mutually exclusive, matching the mockup) -->
        <entity-find-count entity-name="zenith.erp.india.JobWorkChallan" count-field="activeCount">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="actualReturnDate" operator="is-null"/>
            <econdition field-name="isDeemedSale" operator="not-equals" value="Y" or-null="true"/>
            <econdition field-name="expectedReturnDate" operator="greater" from="thirtyDaysFromNow" or-null="true"/>
        </entity-find-count>
        
        <entity-find-count entity-name="zenith.erp.india.JobWorkChallan" count-field="approachingDeadlineCount">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="actualReturnDate" operator="is-null"/>
            <econdition field-name="isDeemedSale" operator="not-equals" value="Y" or-null="true"/>
            <econdition field-name="expectedReturnDate" operator="greater-equals" from="nowTimestamp"/>
            <econdition field-name="expectedReturnDate" operator="less-equals" from="thirtyDaysFromNow"/>
        </entity-find-count>
        
        <entity-find-count entity-name="zenith.erp.india.JobWorkChallan" count-field="overdueCount">
            <econdition field-name="actualReturnDate" operator="is-null"/>
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <econditions combine="or">
                <econdition field-name="isDeemedSale" value="Y"/>
                <econditions combine="and">
                    <econdition field-name="actualReturnDate" operator="is-null"/>
                    <econdition field-name="expectedReturnDate" operator="less" from="nowTimestamp"/>
                </econditions>
            </econditions>
        </entity-find-count>
        
        <entity-find-count entity-name="zenith.erp.india.JobWorkChallan" count-field="returnedCount">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <econdition field-name="actualReturnDate" operator="is-not-null"/>
        </entity-find-count>

        <entity-find entity-name="zenith.erp.india.JobWorkChallan" list="challanList">
            <search-form-inputs default-order-by="-issueDate" skip-fields="organizationPartyId"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zjwc-page">
        <container style="q-mb-lg">
            <label text="Job Work Challan Management" type="h3" style="text-primary text-weight-bold q-my-none"/>
            <label text="Track raw materials sent for subcontracting (1-year return deadline under GST)." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
        </container>

        <!-- KPI stat cards (mockup §3): Active(violet)/Approaching(orange)/Overdue(red)/Returned(green), each with a trailing ↗ -->
        <container style="z-statrow">
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge lg primary"><label text="inventory_2" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label text="${activeCount ?: 0}" type="span" style="z-statnum z-txt-primary"/>
                        <label text="Active Challans" type="span" style="z-statlabel"/>
                        <label text="Materials at job worker premises" type="span" style="z-statdesc"/>
                    </container>
                    <label text="north_east" type="span" style="material-icons z-statarrow z-txt-primary"/>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge lg orange"><label text="schedule" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label text="${approachingDeadlineCount ?: 0}" type="span" style="z-statnum z-txt-orange"/>
                        <label text="Approaching Deadline" type="span" style="z-statlabel"/>
                        <label text="Deadline within 30 days" type="span" style="z-statdesc"/>
                    </container>
                    <label text="north_east" type="span" style="material-icons z-statarrow z-txt-orange"/>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge lg red"><label text="error" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label text="${overdueCount ?: 0}" type="span" style="z-statnum z-txt-red"/>
                        <label text="Overdue (Deemed Sale)" type="span" style="z-statlabel"/>
                        <label text="Breached 1-year GST deadline" type="span" style="z-statdesc"/>
                    </container>
                    <label text="north_east" type="span" style="material-icons z-statarrow z-txt-red"/>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge lg green"><label text="check_circle" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label text="${returnedCount ?: 0}" type="span" style="z-statnum z-amt-green"/>
                        <label text="Successfully Returned" type="span" style="z-statlabel"/>
                        <label text="Returned within statutory timeline" type="span" style="z-statdesc"/>
                    </container>
                    <label text="north_east" type="span" style="material-icons z-statarrow z-amt-green"/>
                </container>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <container style="zsec-hdr row items-center justify-between q-mb-md">
                <container style="column">
                    <label text="Job Work Challans" type="h6" style="text-weight-bold q-my-none"/>
                    <label text="Track raw materials sent for subcontracting (1-year return deadline under GST)." type="p" style="text-grey-7 text-caption q-mb-none q-mt-none"/>
                </container>
                <container style="z-btnrow">
                    <container-dialog id="FindOptionsDialog" button-text="Find Options" button-class="btn btn-default">
                        <form-single name="FindOptionsForm" transition="." type="find">
                            <field name="challanId"><default-field title="Challan ID"><text-find hide-options="true"/></default-field></field>
                            <field name="jobWorkerPartyId">
                                <default-field title="Job Worker">
                                    <drop-down allow-empty="true">
                                        <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                            <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                                <econdition field-name="roleTypeId" value="Supplier"/>
                                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="isDeemedSale">
                                <default-field title="Status Flag">
                                    <drop-down allow-empty="true">
                                        <option key="N" text="Normal"/>
                                        <option key="Y" text="Deemed Sale"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="searchButton"><default-field title=""><submit text="Search" icon="fa fa-search"/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <section name="JwcCreate_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container style="z-newbtn-wrap">
                    <container-dialog id="CreateChallanDialog" button-text="+ New Challan" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                        <form-single name="CreateChallanForm" transition="createChallan">
                            <field name="jobWorkerPartyId">
                                <default-field title="Job Worker">
                                    <drop-down allow-empty="false">
                                        <entity-options key="${partyId}" text="${organizationName?:firstName} ${lastName?:''} [${partyId}]">
                                            <entity-find entity-name="mantle.party.PartyDetailAndRole">
                                                <econdition field-name="roleTypeId" value="Supplier"/>
                                                <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="issueDate"><default-field title="Issue Date"><date-time type="date" default-value="${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}"/></default-field></field>
                            <field name="submitButton"><default-field title=""><submit text="Create Challan" type="success"/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </container>
                    </widgets></section>
                </container>
            </container>

            <form-list name="JobWorkList" list="challanList" skip-form="true">
                <row-actions>
                    <script><![CDATA[
                        def now = ec.user.nowTimestamp
                        def thirty = new java.sql.Timestamp(now.getTime() + 30L*24*60*60*1000)
                        isReturned = actualReturnDate != null
                        isOverdue = !isReturned && (isDeemedSale == 'Y' || (expectedReturnDate != null && expectedReturnDate < now))
                        isApproaching = !isReturned && !isOverdue && expectedReturnDate != null && expectedReturnDate <= thirty
                        if (isReturned) { statusText='Returned'; statusColor='grey' }
                        else if (isOverdue) { statusText='Overdue'; statusColor='danger' }
                        else if (isApproaching) { statusText='Approaching Deadline'; statusColor='warning' }
                        else { statusText='Active'; statusColor='success' }
                        atRisk = isOverdue || isApproaching
                        formattedDeadline = expectedReturnDate ? ec.l10n.format(expectedReturnDate, 'dd MMM yyyy') : '—'
                        formattedIssue = issueDate ? ec.l10n.format(issueDate, 'dd MMM yyyy') : '—'
                        isCsv = ec.web?.parameters?.renderMode == 'csv' || ec.web?.parameters?.renderMode == 'xlsx'
                    ]]></script>
                </row-actions>
                <field name="challanId">
                    <header-field title="ID" show-order-by="true"/>
                    <conditional-field condition="isCsv"><display text="${challanNumber ?: challanId}"/></conditional-field>
                    <default-field><link text="${challanNumber ?: challanId}" url="../JobWorkChallanDetail" parameter-map="[challanId:challanId]" style="z-vlink"/></default-field>
                </field>
                <field name="jobWorkerPartyId">
                    <header-field title="Job Worker"/>
                    <default-field><display-entity entity-name="mantle.party.PartyDetail" text="${organizationName?:firstName} ${lastName?:''}"/></default-field>
                </field>
                <field name="issueDate">
                    <header-field title="Issue Date"/>
                    <conditional-field condition="isCsv"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${formattedIssue}" type="span" style="text-dark"/>
                    </default-field>
                </field>
                <field name="expectedReturnDate">
                    <header-field title="Return Deadline (1 Year)"/>
                    <conditional-field condition="isCsv"><display text="${formattedDeadline}"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico ${atRisk ? 'z-txt-red' : ''}"/>
                        <label text="${formattedDeadline}" type="span" style="text-weight-medium ${atRisk ? 'z-txt-red' : 'text-dark'}"/>
                    </default-field>
                </field>
                <field name="isDeemedSale">
                    <header-field title="Status"/>
                    <conditional-field condition="isCsv"><display text="${statusText}"/></conditional-field>
                    <default-field><label text="${statusText}" type="span" style="zenith-badge nd ${statusColor}"/></default-field>
                </field>
                <field name="receiveAction">
                    <header-field title="Action"/>
                    <conditional-field condition="isCsv"><display text=""/></conditional-field>
                    <default-field><link text="⋮" url="../JobWorkChallanDetail" parameter-map="[challanId:challanId]" style="z-kebab"/></default-field>
                </field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
