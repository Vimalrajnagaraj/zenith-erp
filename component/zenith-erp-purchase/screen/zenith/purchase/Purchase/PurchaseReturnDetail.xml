<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Debit Note Detail" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <transition name="findInvoice"><default-response url="../PurchaseReturns"/></transition>
    
    <transition name="updateInvoice"><actions><service-call name="zenith.purchase.ReturnServices.update#PurchaseReturn" in-map="[invoiceId:invoiceId,updates:[vendorInvoiceNumber:ec.web.requestParameters.vendorInvoiceNumber,purchaseOrderNumber:ec.web.requestParameters.purchaseOrderNumber,description:ec.web.requestParameters.description,statusId:ec.web.requestParameters.statusId]]"/></actions><default-response url="."/><error-response url="."/></transition>

    <transition name="addItem"><actions><service-call name="zenith.purchase.ReturnServices.add#PurchaseReturnLine" in-map="[invoiceId:invoiceId,productId:productId,description:description,hsnSacCode:hsnSacCode,quantity:quantity,amount:amount,taxPercentage:taxPercentage]"/></actions><default-response url="."/><error-response url="."/></transition>
        
    <transition name="deleteItem"><actions><service-call name="zenith.purchase.ReturnServices.delete#PurchaseReturnLine" in-map="[invoiceId:invoiceId,invoiceItemSeqId:invoiceItemSeqId]"/></actions><default-response url="."/><error-response url="."/></transition>

    <actions>
        <service-call name="zenith.purchase.ReturnServices.assert#PurchaseReturn" in-map="[invoiceId:invoiceId,errorOnDenied:'N']" out-map="access"/>
        <set field="noAccess" from="!access.allowed"/>
        <if condition="access.allowed">
        <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice"/>
        
        <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
            <econdition field-name="invoiceId"/>
            <order-by field-name="invoiceItemSeqId"/>
        </entity-find>

        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="vendor">
            <field-map field-name="partyId" from="invoice?.fromPartyId"/>
        </entity-find-one>

        <set field="statusColorMap" from="[
            'InvoiceInProcess': 'grey',
            'InvoiceApproved': 'primary',
            'InvoiceReceived': 'warning',
            'InvoiceFinalized': 'success',
            'InvoiceCancelled': 'danger'
        ]"/>
        <set field="statusColor" from="statusColorMap[invoice?.statusId] ?: 'dark'"/>
        <set field="currSymbol" from="invoice?.currencyUomId ?: ''"/>
        </if>
    </actions>

    <widgets><container style="zpur-page">
        <link url="findInvoice" text="Back to Debit Notes" link-type="anchor"/>

        <section name="ReturnNoAccess" condition="noAccess"><widgets><label text="This debit note is not part of your account." type="p"/></widgets></section>
        <section name="ReturnDetails" condition="!noAccess"><widgets>
        <!-- Profile Banner -->
        <container style="zenith-profile-banner q-pa-lg bg-white shadow-1 border-radius-lg q-mb-lg q-mt-md">
            <container style="row items-center justify-between no-wrap">
                <container style="row items-center">
                    <container style="zenith-avatar q-mr-lg zpur-return-avatar">
                        <label text="DR" type="span" style="zpur-avatar-label"/>
                    </container>
                    <container style="column">
                        <label text="Debit Note: ${invoiceId}" type="h3" style="text-primary text-weight-bold q-my-none"/>
                        <label text="Recorded Return Value: ${currSymbol} ${zinr.inr(ec.l10n.format(invoice?.invoiceTotal ?: 0, '#,##,##0.00'))} - Date: ${invoice?.invoiceDate ? ec.l10n.format(invoice.invoiceDate, 'dd MMM yyyy') : 'N/A'}" type="p" style="text-grey-7 text-subtitle2 q-mt-xs q-mb-none"/>
                    </container>
                </container>
                
                <container style="row items-center">
                    <form-single name="StatusForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        <field name="statusId"><default-field title="">
                            <drop-down current="selected">
                                <option key="InvoiceInProcess" text="Draft"/>
                                <option key="InvoiceFinalized" text="Finalize"/>

                                <option key="InvoiceCancelled" text="Cancelled"/>
                            </drop-down>
                        </default-field></field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite &amp;&amp; invoice?.statusId=='InvoiceInProcess'" title="Update Status"><submit/></conditional-field><default-field title="Update Status"><label text="Changes are unavailable for your account or this record." type="span" style="text-grey-7"/></default-field></field>
                        <field-layout><field-row><field-ref name="statusId"/><field-ref name="submitButton"/></field-row></field-layout>
                    </form-single>
                </container>
            </container>
            
            <container style="row items-center q-mt-md justify-between">
                <container style="bg-grey-2 q-pa-sm border-radius-md">
                    <label text="Supplier: ${vendor?.organizationName ?: (vendor?.firstName ? vendor.firstName + ' ' + (vendor.lastName?:'') : 'Unknown Vendor')} [${invoice?.fromPartyId ?: 'N/A'}]" type="span" style="text-dark text-weight-bold"/>
                    <label text=" | Ref PO: ${invoice?.purchaseOrderNumber ?: 'None'}" type="span" style="text-grey-7"/>
                </container>
                <container>
                    <label text="${invoice?.statusId ? invoice.statusId.replace('Invoice', '') : 'Draft'}" type="span" style="zenith-badge ${statusColor} q-mr-sm"/>
                </container>
            </container>
        </container>

        <!-- Main Sections -->
        <container-row>
            <row-col lg="6">
                <!-- Reference Details -->
                <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-md">
                    <label text="Reference Details" type="h5" style="text-primary text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <form-single name="StatutoryForm" transition="updateInvoice" map="invoice">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="vendorInvoiceNumber"><default-field title="Original Vendor Bill No."><text-line size="20"/></default-field></field>
                        <field name="purchaseOrderNumber"><default-field title="Original PO No."><text-line size="20"/></default-field></field>
                        <field name="description"><default-field title="Reason for Return"><text-area rows="3" cols="60"/></default-field></field>
                        
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite &amp;&amp; invoice?.statusId=='InvoiceInProcess'" title="Save Details"><submit/></conditional-field><default-field title="Save Details"><label text="Changes are unavailable for your account or this record." type="span" style="text-grey-7"/></default-field></field>
                    </form-single>
                </container>
            </row-col>
            
            <row-col lg="6">
                <!-- ITC Reversal Dashboard -->
                <container style="zenith-card q-pa-md bg-red-9 text-white shadow-1 border-radius-md q-mb-md">
                    <label text="Return Tax Summary" type="h5" style="text-white text-weight-bold q-mb-md border-bottom q-pb-sm"/>
                    <container style="row q-col-gutter-md text-center">
                        <container style="col-3"><label text="Taxable Base" type="strong" style="text-red-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalTaxableAmount ?: 0, '#,##0.00'))}" type="p" style="q-my-none text-white"/></container>
                        <container style="col-3"><label text="IGST" type="strong" style="text-red-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalIgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none text-white"/></container>
                        <container style="col-3"><label text="CGST" type="strong" style="text-red-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalCgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none text-white"/></container>
                        <container style="col-3"><label text="SGST" type="strong" style="text-red-2 block"/><label text="${currSymbol}${zinr.inr(ec.l10n.format(invoice.totalSgst ?: 0, '#,##0.00'))}" type="p" style="q-my-none text-white"/></container>
                    </container>
                </container>
            </row-col>
        </container-row>

        <!-- Returned Items -->
        <container style="zenith-card q-pa-md bg-white shadow-1 border-radius-md q-mb-lg">
            <container style="row justify-between items-center q-mb-md border-bottom q-pb-sm">
                <label text="Returned Items" type="h5" style="text-primary text-weight-bold q-my-none"/>
                
                <section name="DebitAddItem_write"><condition><expression>modCanWrite &amp;&amp; invoice?.statusId=='InvoiceInProcess'</expression></condition><widgets>
                <container-dialog id="AddItemDialog" button-text="Add Returned Item" button-class="q-btn--flat bg-primary text-white border-radius-md">
                    <form-single name="AddItemForm" transition="addItem">
                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                        
                        <field name="productId"><default-field title="Product">
                            <drop-down allow-empty="true">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product"><econdition field-name="ownerPartyId" from="invoice?.toPartyId ?: '__NO_ORGANIZATION__'"/><order-by field-name="productName"/></entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="60"/></default-field></field>
                        
                        <field name="hsnSacCode"><default-field title="HSN/SAC Code"><text-line size="10"/></default-field></field>
                        <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                        <field name="amount"><default-field title="Unit Price"><text-line size="15"/></default-field></field>
                        
                        <!-- GST Field -->
                        <field name="taxPercentage"><default-field title="GST Rate (%)">
                            <drop-down allow-empty="true">
                                <option key="0" text="0% (Exempt)"/>
                                <option key="5" text="5%"/>
                                <option key="12" text="12%"/>
                                <option key="18" text="18%"/>
                                <option key="28" text="28%"/>
                            </drop-down>
                        </default-field></field>
                        
                        <field name="submitButton"><default-field title="Add Item"><submit icon="fa fa-plus" type="primary"/></default-field></field>
                        
                        <field-layout>
                            <field-ref name="productId"/>
                            <field-ref name="description"/>
                            <field-row>
                                <field-ref name="hsnSacCode"/>
                                <field-ref name="quantity"/>
                            </field-row>
                            <field-row>
                                <field-ref name="amount"/>
                                <field-ref name="taxPercentage"/>
                            </field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </container>

            <form-list name="InvoiceItemsForm" list="invoiceItems" skip-form="true">
                <field name="invoiceItemSeqId"><default-field title="#"><label text="${invoiceItemSeqId}" type="span" style="text-grey-7"/></default-field></field>
                <field name="description"><default-field title="Description"><label text="${description ?: 'N/A'}" type="strong" style="text-dark"/></default-field></field>
                <field name="hsnSacCode"><default-field title="HSN/SAC"><label text="${hsnSacCode ?: '-'}" type="span" style="zenith-badge grey"/></default-field></field>
                <field name="quantity"><default-field><label text="${quantity}" type="span" style="text-dark"/></default-field></field>
                <field name="amount"><default-field title="Unit Price"><label text="${zinr.inr(ec.l10n.format(amount ?: 0, '#,##,##0.00'))}" type="span"/></default-field></field>
                
                <!-- GST Breakdown -->
                <field name="gstBreakdown"><default-field title="Tax Reversed">
                    <label text="${igstRate ? ('IGST: ' + igstRate + '% (' + currSymbol + igstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${cgstRate ? ('CGST: ' + cgstRate + '% (' + currSymbol + cgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${sgstRate ? ('SGST: ' + sgstRate + '% (' + currSymbol + sgstAmount + ')') : ''}" type="span" style="block text-grey-8 text-caption"/>
                    <label text="${!igstRate &amp;&amp; !cgstRate ? '-' : ''}" type="span" style="block text-grey-8 text-caption"/>
                </default-field></field>

                <field name="total"><default-field title="Total Reversed">
                    <label text="${currSymbol}${zinr.inr(ec.l10n.format(((quantity ?: 0) * (amount ?: 0)) + (igstAmount ?: 0) + (cgstAmount ?: 0) + (sgstAmount ?: 0), '#,##,##0.00'))}" type="span" style="text-weight-bold text-dark"/>
                </default-field></field>
                
                <field name="deleteItem">
                    <conditional-field name="del_write" condition="modCanWrite &amp;&amp; invoice?.statusId=='InvoiceInProcess'" title=" ">
                        <link url="deleteItem" parameter-map="[invoiceId:invoiceId, invoiceItemSeqId:invoiceItemSeqId]" icon="delete" style="text-danger" confirmation="Remove item?"/>
                    </conditional-field>
                    <default-field title=" "><label text="" type="span"/></default-field>
                </field>
            </form-list>
        </container>

        </widgets></section>
</container>    </widgets>
</screen>
