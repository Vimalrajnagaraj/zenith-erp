<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="RFQs" default-menu-index="8">

    <transition name="createRfq">
        <service-call name="zenith.purchase.PurchaseServices.create#PurchaseRfq"/>
        <default-response url="."/>
    </transition>
    <transition name="editRfq">
        <default-response url="../EditRfq"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.purchase.PurchaseRfq" list="rfqList">
            <search-form-inputs default-order-by="-rfqDate"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
        </entity-find>

        <entity-find entity-name="mantle.party.PartyRole" list="internalOrgRoles">
            <econdition field-name="roleTypeId" operator="in" value="OrgInternal,InternalOrganization"/>
        </entity-find>
        <set field="internalOrgIdList" from="internalOrgRoles.partyId"/>
        <set field="activeOrgId" from="ec.user.getPreference('ActiveOrgId') ?: (internalOrgIdList ? internalOrgIdList[0] : null)"/>
        
        <set field="statusColorMap" from="[
            'RfqDraft': 'grey',
            'RfqSent': 'info',
            'RfqClosed': 'success',
            'RfqCancelled': 'danger'
        ]"/>
    </actions>

    <widgets>
        <container style="row items-center justify-between q-mb-lg">
            <container>
                <label text="Requests for Quotation" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Manage requests for quotation sent to suppliers." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <container-dialog id="NewRfqDialog" button-text="New RFQ" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-indigo-8 text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md">
                <form-single name="NewRfqForm" transition="createRfq">
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down allow-empty="false" no-current-selected-key="${activeOrgId}">
                            <list-options list="orgList" key="${partyId}" text="${organizationName} [${partyId}]"/>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field><text-line/></default-field></field>
                    <field name="closingDate"><default-field title="Closing Date"><date-time type="date"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="3"/></default-field></field>
                    <field name="submitButton"><default-field title="Create RFQ"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md">
            <form-list name="RfqListForm" list="rfqList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                
                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'dark'"/>
                </row-actions>

                <field name="rfqNumber">
                    <header-field title="RFQ #" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${rfqNumber}"/></conditional-field>
                    <default-field>
                        <link url="editRfq" text="${rfqNumber}" parameter-map="[rfqId:rfqId]" style="text-weight-bold text-indigo-8 text-decoration-none"/>
                    </default-field>
                </field>
                <field name="rfqDate">
                    <header-field title="Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field><display format="dd MMM yyyy"/></default-field>
                </field>
                <field name="description">
                    <header-field><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="closingDate">
                    <header-field title="Closing" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field><display format="dd MMM yyyy"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="RfqDraft" text="Draft"/>
                            <option key="RfqSent" text="Sent"/>
                            <option key="RfqClosed" text="Closed"/>
                            <option key="RfqCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${statusId ? statusId.replace('Rfq', '') : 'Draft'}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${statusId ? statusId.replace('Rfq', '') : 'Draft'}" type="span" style="zenith-badge ${statusColor}"/>
                    </default-field>
                </field>
                <field name="submitButton">
                    <header-field title="Find"><submit/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><ignored/></conditional-field>
                    <default-field><ignored/></default-field>
                </field>
            </form-list>
        </container>
    </widgets>
</screen>
