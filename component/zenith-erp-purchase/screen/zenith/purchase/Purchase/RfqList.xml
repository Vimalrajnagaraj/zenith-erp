<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="RFQs" default-menu-index="8">

    <transition name="createRfq">
        <service-call name="zenith.purchase.PurchaseServices.create#PurchaseRfq"/>
        <default-response url="."/>
    </transition>
    <transition name="editRfq">
        <default-response url="../EditRfq"/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.purchase.PurchaseRfq" list="rfqList">
            <search-form-inputs default-order-by="-rfqDate" skip-fields="organizationPartyId"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="orgList" from="[]"/>
        <if condition="activeOrgId &amp;&amp; activeOrgId != '_NA_'">
            <service-call name="zenith.base.SecurityServices.get#ActiveOrgList" out-map="context"/>
        </if>

        <!-- KPI counts across ALL org RFQs (unpaginated) for the stat cards -->
        <entity-find entity-name="zenith.erp.purchase.PurchaseRfq" list="allRfqs">
            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
            <select-field field-name="statusId"/>
        </entity-find>
        <set field="rfqOpen" from="allRfqs.count{ it.statusId == 'RfqSent' }"/>
        <set field="rfqDraft" from="allRfqs.count{ it.statusId == 'RfqDraft' }"/>
        <set field="rfqClosed" from="allRfqs.count{ it.statusId == 'RfqClosed' || it.statusId == 'RfqCancelled' }"/>
        <set field="rfqTotal" from="allRfqs.size()"/>

        <!-- Sent = 'Open' (awaiting supplier response), Closed/Cancelled per mockup palette (green/blue) -->
        <set field="statusColorMap" from="[
            'RfqDraft': 'grey', 'RfqSent': 'success', 'RfqClosed': 'info', 'RfqCancelled': 'danger'
        ]"/>
        <set field="statusLabelMap" from="[
            'RfqDraft': 'Draft', 'RfqSent': 'Open', 'RfqClosed': 'Closed', 'RfqCancelled': 'Cancelled'
        ]"/>
    </actions>

    <widgets>
        <container style="zrfq-page">
        <container style="zsec-hdr row items-center justify-between q-mb-lg z-newbtn-wrap">
            <container>
                <label condition="sri.getRenderMode() != 'csv'" text="Requests for Quotation (RFQ)" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label condition="sri.getRenderMode() != 'csv'" text="Create and track RFQs sent to your suppliers." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <!-- ZE-PUR: New RFQ is a write action — hidden for view-only users -->
            <section name="NewRfqWrite">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewRfqDialog" button-text="+ New RFQ" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                <form-single name="NewRfqForm" transition="createRfq">
                    <field name="organizationPartyId"><default-field title="Organization">
                        <drop-down allow-empty="false" no-current-selected-key="${activeOrgId}">
                            <list-options list="orgList" key="${partyId}" text="${organizationName} [${partyId}]"/>
                        </drop-down>
                    </default-field></field>
                    <field name="description"><default-field><text-line/></default-field></field>
                    <field name="closingDate"><default-field title="Closing Date"><date-time type="date"/></default-field></field>
                    <field name="remarks"><default-field><text-area rows="3"/></default-field></field>
                    <field name="submitButton"><default-field title="Create RFQ"><submit/></default-field></field>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </container>

        <!-- KPI stat cards (mockup §5): Open/Draft/Closed/Total, tinted icon badges green/orange/violet/blue -->
        <container style="z-statrow">
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge zrfq-icon zc-purchase-icon green"><label condition="sri.getRenderMode() != 'csv'" text="description" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label condition="sri.getRenderMode() != 'csv'" text="${rfqOpen}" type="span" style="z-statnum"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="Open" type="span" style="z-statlabel"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="RFQs awaiting supplier response" type="span" style="z-statdesc"/>
                    </container>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge zrfq-icon zc-purchase-icon orange"><label condition="sri.getRenderMode() != 'csv'" text="drafts" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label condition="sri.getRenderMode() != 'csv'" text="${rfqDraft}" type="span" style="z-statnum"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="Draft" type="span" style="z-statlabel"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="Not yet sent to suppliers" type="span" style="z-statdesc"/>
                    </container>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge zrfq-icon zc-purchase-icon primary"><label condition="sri.getRenderMode() != 'csv'" text="check_circle" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label condition="sri.getRenderMode() != 'csv'" text="${rfqClosed}" type="span" style="z-statnum"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="Closed" type="span" style="z-statlabel"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="RFQs closed / No longer active" type="span" style="z-statdesc"/>
                    </container>
                </container>
            </container>
            <container style="z-statcell zenith-card bg-white border-radius-lg q-pa-md">
                <container style="z-statinner">
                    <container style="z-icobadge zrfq-icon zc-purchase-icon blue"><label condition="sri.getRenderMode() != 'csv'" text="receipt_long" type="span" style="material-icons"/></container>
                    <container style="z-statmeta">
                        <label condition="sri.getRenderMode() != 'csv'" text="${rfqTotal}" type="span" style="z-statnum"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="Total RFQs" type="span" style="z-statlabel"/>
                        <label condition="sri.getRenderMode() != 'csv'" text="All RFQs created" type="span" style="z-statdesc"/>
                    </container>
                </container>
            </container>
        </container>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-csv-violet z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search RFQs..." style="display:none"></span>]]></text></render-mode>
            <form-list name="RfqListForm" list="rfqList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">
                
                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <set field="statusLabel" from="statusLabelMap[statusId] ?: (statusId ? statusId.replace('Rfq','') : 'Draft')"/>
                </row-actions>

                <field name="rfqNumber">
                    <header-field title="RFQ Number" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${rfqNumber}"/></conditional-field>
                    <default-field>
                        <link url="editRfq" text="${rfqNumber}" parameter-map="[rfqId:rfqId]" style="z-vlink"/>
                    </default-field>
                </field>
                <field name="description">
                    <header-field title="Description"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><label text="${description ?: ''}" type="span" style="text-dark"/></default-field>
                </field>
                <field name="rfqDate">
                    <header-field title="Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${ec.l10n.format(rfqDate, 'dd MMM yyyy')}" type="span" style="text-dark"/>
                    </default-field>
                </field>
                <field name="closingDate">
                    <header-field title="Closing Date" show-order-by="true"><date-find type="date"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field>
                        <label text="event" type="span" style="material-icons z-cellico"/>
                        <label text="${ec.l10n.format(closingDate, 'dd MMM yyyy')}" type="span" style="text-dark"/>
                    </default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="RfqDraft" text="Draft"/>
                            <option key="RfqSent" text="Open"/>
                            <option key="RfqClosed" text="Closed"/>
                            <option key="RfqCancelled" text="Cancelled"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'">
                        <display text="${statusLabel}"/>
                    </conditional-field>
                    <default-field>
                        <label text="${statusLabel}" type="span" style="zenith-badge nd ${statusColor}"/>
                    </default-field>
                </field>
                <field name="actions" hide="sri.getRenderMode() == 'csv'">
                    <header-field title="Actions"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><ignored/></conditional-field>
                    <default-field>
                        <link url="editRfq" text="⋮" parameter-map="[rfqId:rfqId]" style="z-kebab"/>
                    </default-field>
                </field>
                <field name="findButton">
                    <header-field title=""><submit text="Apply Filters"/></header-field>
                    <default-field><ignored/></default-field>
                </field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
