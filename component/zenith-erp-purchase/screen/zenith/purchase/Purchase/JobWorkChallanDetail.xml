<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Challan Detail" default-menu-include="false">

    <parameter name="challanId" required="true"/>

    <transition name="updateChallan">
        <service-call name="update#zenith.erp.purchase.JobWorkChallan" in-map="context"/>
        <default-response url="."/>
    </transition>

    <transition name="addItem">
        <actions>
            <script>
                def newItem = ec.entity.makeValue("zenith.erp.purchase.JobWorkChallanItem")
                newItem.setAll(context)
                newItem.setSequencedIdSecondary()
                newItem.create()
            </script>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="updateItem">
        <service-call name="update#zenith.erp.purchase.JobWorkChallanItem" in-map="context"/>
        <default-response url="."/>
    </transition>

    <transition name="deleteItem">
        <service-call name="delete#zenith.erp.purchase.JobWorkChallanItem" in-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.purchase.JobWorkChallan" value-field="challan"/>
        <if condition="challan == null"><return error="true" message="Challan not found with ID ${challanId}"/></if>
        
        <entity-find-one entity-name="mantle.party.PartyDetail" value-field="jobWorker">
            <field-map field-name="partyId" from="challan.jobWorkerPartyId"/>
        </entity-find-one>

        <entity-find entity-name="zenith.erp.purchase.JobWorkChallanItem" list="itemList">
            <econdition field-name="challanId"/>
            <order-by field-name="itemSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <link text="Back to Challans List" url="../JobWorkChallan" icon="fa fa-arrow-left" link-type="hidden-form" class="btn btn-default mb-2"/>
        <label text="Challan ${challan.challanNumber ?: challan.challanId} - Line Items" type="h4"/>

        <!-- Header info -->
        <container-row>
            <row-col lg="12">
                <container-box><box-header title="Challan Summary &amp; Status"/><box-body>
                    <form-single name="UpdateChallan" transition="updateChallan" map="challan">
                        <field name="challanId"><default-field><hidden/></default-field></field>
                        <field name="jobWorkerPartyId"><default-field title="Job Worker"><display text="${jobWorker?.organizationName?:jobWorker?.firstName} ${jobWorker?.lastName?:''} [${challan.jobWorkerPartyId}]"/></default-field></field>
                        <field name="issueDate"><default-field><display format="dd MMM yyyy"/></default-field></field>
                        <field name="expectedReturnDate"><default-field title="1-Year Deadline"><display format="dd MMM yyyy" style="text-danger"/></default-field></field>
                        
                        <!-- Manual final status resolution -->
                        <field name="actualReturnDate"><default-field title="Final Return Date" tooltip="Set this when ALL items are fully returned/resolved"><date-time type="date"/></default-field></field>
                        <field name="isDeemedSale">
                            <default-field title="Overdue Flag">
                                <drop-down>
                                    <option key="N" text="Normal"/>
                                    <option key="Y" text="Deemed Sale (Penalty Applied)"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submitButton"><conditional-field name="save_write" condition="modCanWrite" title="Save Status"><submit type="primary"/></conditional-field><default-field title="Save Status"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </row-col>
        </container-row>

        <!-- Line Items -->
        <container-box><box-header title="Received &amp; Issued Items Tracking"/><box-toolbar>
            <section name="JwcdAddItem_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="AddItemDialog" button-text="Add Item" button-class="btn btn-success">
                <form-single name="AddItemForm" transition="addItem">
                    <field name="challanId"><default-field><hidden/></default-field></field>
                    <field name="productId">
                        <default-field title="Product/Material">
                            <drop-down allow-empty="false">
                                <entity-options key="${productId}" text="${pseudoId} - ${productName}">
                                    <entity-find entity-name="mantle.product.Product">
                                        <econdition field-name="ownerPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                        <order-by field-name="productName"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="issuedQuantity"><default-field><text-line size="10" default-value="1"/></default-field></field>
                    <field name="uomId">
                        <default-field title="Unit of Measure">
                            <drop-down allow-empty="true">
                                <entity-options key="${uomId}" text="${description} [${abbreviation}]">
                                    <entity-find entity-name="moqui.basic.Uom">
                                        <order-by field-name="description"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title=""><submit text="Add Item" type="success" icon="fa fa-plus"/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="productId"/></field-row>
                        <field-row>
                            <field-ref name="issuedQuantity"/>
                            <field-ref name="uomId"/>
                        </field-row>
                        <field-row><field-ref name="submitButton"/></field-row>
                    </field-layout>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <form-list name="ItemsList" list="itemList" transition="updateItem">
                <row-actions>
                    <script><![CDATA[
                        def product = ec.entity.find("mantle.product.Product").condition("productId", productId).one()
                        productName = product ? "${product.pseudoId ?: productId} - ${product.productName}" : productId
                        
                        def uom = uomId ? ec.entity.find("moqui.basic.Uom").condition("uomId", uomId).one() : null
                        uomDesc = uom ? uom.description : ''
                        
                        pendingQuantity = (issuedQuantity ?: 0) - (returnedQuantity ?: 0) - (scrapQuantity ?: 0)
                    ]]></script>
                </row-actions>
                
                <field name="challanId"><default-field><hidden/></default-field></field>
                <field name="itemSeqId"><default-field><hidden/></default-field></field>

                <field name="productId">
                    <header-field title="Product"/>
                    <default-field><display text="${productName}"/></default-field>
                </field>
                
                <field name="issuedQuantity">
                    <header-field title="Issued Qty"/>
                    <default-field><display text="${issuedQuantity} ${uomDesc}"/></default-field>
                </field>

                <field name="returnedQuantity">
                    <header-field title="Returned Qty"/>
                    <default-field><text-line size="8"/></default-field>
                </field>

                <field name="scrapQuantity">
                    <header-field title="Scrap/Waste Qty"/>
                    <default-field><text-line size="8"/></default-field>
                </field>

                <field name="pendingQuantity">
                    <header-field title="Pending Qty"/>
                    <default-field>
                        <display text="${pendingQuantity}" style="text-strong ${pendingQuantity > 0 ? 'text-danger' : 'text-success'}"/>
                    </default-field>
                </field>

                <field name="updateButton"><conditional-field name="row_write" condition="modCanWrite" title="Update"><submit type="primary" icon="fa fa-save"/></conditional-field><default-field title="Update"><label text="" type="span"/></default-field></field>

                <field name="deleteAction">
                    <header-field title=""/>
                    <conditional-field name="del_write" condition="modCanWrite">
                        <link text="" icon="fa fa-trash" url="deleteItem" parameter-map="[challanId:challanId, itemSeqId:itemSeqId]" confirmation="Delete this item?" class="btn btn-danger btn-sm"/>
                    </conditional-field>
                    <default-field>
                        <label text="" type="span"/>
                    </default-field>
                </field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
