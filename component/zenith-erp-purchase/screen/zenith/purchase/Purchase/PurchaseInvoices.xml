<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase Invoices" default-menu-index="7">

    <transition name="createPurchaseInvoice">
        <service-call name="zenith.purchase.PurchaseServices.create#PurchaseInvoice"/>
        <default-response url="../EditPurchaseInvoice"/>
    </transition>
    <transition name="editInvoice">
        <default-response url="../EditPurchaseInvoice"/>
    </transition>
    <!-- ZE-SEC-JSON f/u: org-scoped party picker (stock SimpleScreens searchPartyList leaks cross-tenant). -->
    <transition-include name="searchPartyList" location="component://zenith-erp-base/screen/include/PartyPicker.xml"/>

    <actions>
        <!-- mockup status pills: Completed(green)/Waiting(orange)/Not Done Yet(red) -->
        <set field="statusColorMap" from="[
            'InvoiceFinalized': 'success', 'InvoicePmtRecvd': 'success', 'InvoicePmtSent': 'success', 'InvoiceApproved': 'success', 'InvoiceBilledThrough': 'success',
            'InvoiceReceived': 'warning', 'InvoiceIncoming': 'warning', 'InvoiceInProcess': 'warning',
            'InvoiceCancelled': 'danger', 'InvoiceWriteOff': 'danger'
        ]"/>
        <!-- mockup 2B Match: Matched(green)/Partial Match(orange)/Not Matched(red) -->
        <set field="matchColorMap" from="[ 'Matched': 'success', 'Unmatched': 'warning', 'MissingInBooks': 'danger', 'MissingInPortal': 'danger' ]"/>
        <set field="matchLabelMap" from="[ 'Matched': 'Matched', 'Unmatched': 'Not Matched', 'MissingInBooks': 'Not Matched', 'MissingInPortal': 'Not Matched' ]"/>
        <entity-find entity-name="zenith.erp.purchase.PurchaseInvoiceView" list="invoiceList">
            <search-form-inputs default-order-by="-invoiceDate" skip-fields="toPartyId,invoiceTypeEnumId"/>
            <econdition field-name="invoiceTypeEnumId" value="InvoicePurchase"/>
            <econdition field-name="toPartyId" operator="is-not-null"/>
            <!-- ZE-SALES-014 f/u: org-isolate CSV/XLSX export (standalone render bypasses the MANTLE_ACTIVE_ORG authz filter) -->
            <econdition field-name="toPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
        <set field="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find entity-name="mantle.party.PartyDetailAndRole" list="orgList">
            <econdition field-name="roleTypeId" value="OrgInternal"/>
            <econdition field-name="disabled" value="N" or-null="true"/>
            <econdition field-name="partyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION') ?: '__NO_ORGANIZATION__'"/>
        </entity-find>
    </actions>

    <widgets>
        <container style="zvbill-page">
      <!-- exclude the page header from the CSV standalone render so Export CSV is clean (table only) -->
      <section name="PiHeaderSec"><condition><expression>!(sri.getRenderMode() in ['csv','xlsx'])</expression></condition><widgets>
        <container style="zsec-hdr row items-center justify-between q-mb-lg z-newbtn-wrap">
            <container>
                <label text="Purchase Invoices &amp; GSTR-2B" type="h3" style="text-primary text-weight-bold q-my-none"/>
                <label text="Comprehensive view of all purchase invoices, tax calculations, and GSTR-2B matching status." type="p" style="text-grey-7 q-mt-sm q-mb-none"/>
            </container>
            <!-- ZE-PUR: New Purchase Invoice is a write action — hidden for view-only users -->
            <section name="NewPurchaseInvWrite">
              <condition><expression>modCanWrite</expression></condition>
              <widgets>
            <container-dialog id="NewPurchaseInvDialog" button-text="+ New Purchase Invoice" button-class="q-btn q-btn-item non-selectable no-outline q-btn--standard q-btn--rectangle bg-primary text-white q-btn--actionable q-focusable q-hoverable text-weight-bold q-px-md z-newbtn">
                <form-single name="NewPurchaseInvForm" transition="createPurchaseInvoice">
                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                    <field name="vendorPartyId"><default-field title="Vendor (Supplier)">
                        <drop-down>
                            <dynamic-options transition="searchPartyList" server-search="true" min-length="2"/>
                        </drop-down>
                    </default-field></field>
                    
                    <field name="vendorInvoiceNumber"><default-field title="Vendor Invoice #"><text-line size="20"/></default-field></field>
                    <field name="vendorInvoiceDate"><default-field title="Vendor Invoice Date"><date-time type="date"/></default-field></field>
                    
                    <field name="invoiceDate"><default-field title="Book Date"><date-time type="date"/></default-field></field>
                    <field name="isReverseCharge"><default-field title="Reverse Charge (RCM)">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    
                    <field name="isImportPurchase"><default-field title="Import Purchase">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                    </default-field></field>
                    <field name="isCompositionDealer"><default-field title="Composition Dealer">
                        <drop-down><option key="N" text="No"/><option key="Y" text="Yes - No ITC"/></drop-down>
                    </default-field></field>
                    
                    <field name="submitButton"><default-field title="Create Invoice "><submit icon="fa fa-plus" type="primary"/></default-field></field>
                    
                    <field-layout>
                        <field-row><field-ref name="organizationPartyId"/><field-ref name="vendorPartyId"/></field-row>
                        <field-row><field-ref name="vendorInvoiceNumber"/><field-ref name="vendorInvoiceDate"/></field-row>
                        <field-row><field-ref name="invoiceDate"/><field-ref name="isReverseCharge"/></field-row>
                        <field-row><field-ref name="isImportPurchase"/><field-ref name="isCompositionDealer"/></field-row>
                        <field-ref name="submitButton"/>
                    </field-layout>
                </form-single>
            </container-dialog>
              </widgets>
            </section>
        </container>
        </widgets></section>

        <container style="zenith-card bg-white shadow-2 border-radius-lg q-pa-md z-listchrome">
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Purchase Invoices..." style="display:none"></span>]]></text></render-mode>
            <form-list name="PurchaseInvListForm" list="invoiceList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-page-size="true">

                <row-actions>
                    <set field="statusColor" from="statusColorMap[statusId] ?: 'grey'"/>
                    <set field="_si" from="ec.entity.find('moqui.basic.StatusItem').condition('statusId', statusId).useCache(true).one()"/>
                    <set field="statusLabel" from="_si?.description ?: (statusId ? statusId.replace('Invoice','') : 'In Process')"/>
                    <set field="matchColor" from="matchColorMap[gstr2bMatchStatus] ?: 'grey'"/>
                    <set field="matchLabel" from="matchLabelMap[gstr2bMatchStatus] ?: (gstr2bMatchStatus ?: 'Pending')"/>
                </row-actions>

                <field name="invoiceId">
                    <header-field title="ID" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${gstInvoiceNumber ?: invoiceId}"/></conditional-field>
                    <default-field><link url="editInvoice" text="${gstInvoiceNumber ?: invoiceId}" parameter-map="[invoiceId:invoiceId]" style="z-vlink"/></default-field>
                </field>
                <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                <field name="vendorInvoiceNumber">
                    <header-field title="Vendor Inv #"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="invoiceDate">
                    <header-field title="Date" show-order-by="true"><date-find/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display format="yyyy-MM-dd"/></conditional-field>
                    <default-field><display format="dd MMM yyyy"/></default-field>
                </field>
                <field name="vendorName">
                    <header-field title="Vendor"><text-find default-operator="contains" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="supplierGstin">
                    <header-field title="Vendor GSTIN"><text-find size="15" hide-options="true"/></header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${supplierGstin ?: ''}"/></conditional-field>
                    <default-field>
                        <label text="${supplierGstin ?: '—'}" type="span" style="text-dark z-gstin"/>
                    </default-field>
                </field>
                
                <!-- Financials -->
                <field name="invoiceTotal"><default-field title="Grand Total"><display format="#,##0.00"/></default-field></field>
                <field name="roundOffAmount"><default-field title="Round Off"><display format="#,##0.00"/></default-field></field>
                <field name="outstanding"><default-field title="Outstanding"><display text="${ec.l10n.format((invoiceTotal ?: 0)+(roundOffAmount ?: 0)-(appliedPaymentsTotal ?: 0), '#,##0.00')}"/></default-field></field>
                <field name="totalTaxableAmount">
                    <header-field title="Taxable" show-order-by="true"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${totalTaxableAmount ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(totalTaxableAmount ?: 0, '#,##,##0.00'))}" type="span" style="text-dark"/></default-field>
                </field>
                <field name="totalCgst">
                    <header-field title="CGST"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${totalCgst ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(totalCgst ?: 0, '#,##,##0.00'))}" type="span" style="z-amt-blue"/></default-field>
                </field>
                <field name="totalSgst">
                    <header-field title="SGST"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${totalSgst ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(totalSgst ?: 0, '#,##,##0.00'))}" type="span" style="z-amt-blue"/></default-field>
                </field>
                <field name="totalIgst">
                    <header-field title="IGST"/>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${totalIgst ?: 0}"/></conditional-field>
                    <default-field><label text="${zinr.inr(ec.l10n.format(totalIgst ?: 0, '#,##,##0.00'))}" type="span" style="text-grey-8"/></default-field>
                </field>
                
                <!-- Compliance -->
                <field name="totalCess"><default-field title="Cess"><display format="#,##0.00"/></default-field></field>
                <field name="isReverseCharge">
                    <header-field title="RCM">
                        <drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${isReverseCharge == 'Y' ? 'Yes' : 'No'}"/></conditional-field>
                    <default-field><label text="${isReverseCharge == 'Y' ? 'Yes' : 'No'}" type="span" style="text-dark"/></default-field>
                </field>
                <field name="itcEligible">
                    <header-field title="ITC">
                        <drop-down allow-empty="true"><option key="Y" text="Eligible"/><option key="N" text="Ineligible"/></drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${itcEligible == 'Y' ? 'Yes' : 'No'}"/></conditional-field>
                    <default-field><label text="${itcEligible == 'Y' ? 'Yes' : 'No'}" type="span" style="text-weight-bold ${itcEligible == 'Y' ? 'z-amt-green' : 'z-txt-red'}"/></default-field>
                </field>
                <field name="gstr2bMatchStatus">
                    <header-field title="2B Match">
                        <drop-down allow-empty="true">
                            <option key="Matched"/><option key="Unmatched"/>
                            <option key="MissingInBooks" text="Missing in Books"/>
                            <option key="MissingInPortal" text="Missing in Portal"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${matchLabel}"/></conditional-field>
                    <default-field><label text="${matchLabel}" type="span" style="zenith-badge nd ${matchColor}"/></default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <option key="InvoiceIncoming" text="Incoming"/>
                            <option key="InvoiceReceived" text="Received"/>
                            <option key="InvoiceApproved" text="Approved"/>
                            <option key="InvoicePmtSent" text="Payment Sent"/>
                        </drop-down>
                    </header-field>
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text="${statusLabel}"/></conditional-field>
                    <default-field>
                        <label text="${statusLabel}" type="span" style="zenith-badge z-stbadge ${statusColor}"/>
                    </default-field>
                </field>

                <field name="actions">
                    <conditional-field condition="sri.getRenderMode() == 'csv'"><display text=""/></conditional-field>
                    <default-field title="Actions">
                        <link url="editInvoice" text="⋮" parameter-map="[invoiceId:invoiceId]" style="z-kebab"/>
                    </default-field>
                </field>
                <field name="findButton">
                    <header-field title=""><submit text="Apply Filters"/></header-field>
                    <default-field><ignored/></default-field>
                </field>
            </form-list>
        </container>
        </container>
    </widgets>
</screen>
