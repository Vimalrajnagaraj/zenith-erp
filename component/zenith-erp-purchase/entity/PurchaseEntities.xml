<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Generic Purchase Invoice Extensions ========== -->
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="purchaseOrderNumber" type="text-short"/>
        <field name="vendorInvoiceNumber" type="text-short"><description>Supplier's own invoice number</description></field>
        <field name="vendorInvoiceDate" type="date"/>
        <field name="customsDutyAmount" type="currency-amount"/>
        <field name="billOfEntryNumber" type="text-short"/>
        <field name="billOfEntryDate" type="date"/>
        <field name="portOfImport" type="text-short"/>
        <field name="isImportPurchase" type="text-indicator" default="'N'"/>
    </extend-entity>

    <!-- ========== RFQ (Request for Quotation) ========== -->
    <entity entity-name="PurchaseRfq" package="zenith.erp.purchase">
        <field name="rfqId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="rfqNumber" type="text-short"/>
        <field name="rfqDate" type="date-time"/>
        <field name="closingDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="remarks" type="text-long"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="PurchaseRfq" description="Purchase RFQ"/>
            <moqui.basic.StatusItem statusId="RfqDraft" statusTypeId="PurchaseRfq" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RfqSent" statusTypeId="PurchaseRfq" description="Sent to Vendors" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RfqClosed" statusTypeId="PurchaseRfq" description="Closed" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="RfqCancelled" statusTypeId="PurchaseRfq" description="Cancelled" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RfqDraft" toStatusId="RfqSent" transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RfqSent" toStatusId="RfqClosed" transitionName="Close"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RfqDraft" toStatusId="RfqCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <entity entity-name="PurchaseRfqItem" package="zenith.erp.purchase">
        <field name="rfqId" type="id" is-pk="true"/>
        <field name="rfqItemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="quantity" type="number-decimal"/>
        <field name="uomId" type="id"/>
        <field name="productTaxCode" type="text-short"/>
        <field name="requiredByDate" type="date"/>
        <relationship type="one" related="zenith.erp.purchase.PurchaseRfq"/>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>

    <!-- ========== RFQ Vendor Response ========== -->
    <entity entity-name="RfqVendorResponse" package="zenith.erp.purchase">
        <field name="rfqResponseId" type="id" is-pk="true"/>
        <field name="rfqId" type="id"/>
        <field name="vendorPartyId" type="id"/>
        <field name="responseDate" type="date-time"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="deliveryDays" type="number-integer"/>
        <field name="paymentTerms" type="text-medium"/>
        <field name="remarks" type="text-long"/>
        <field name="isSelected" type="text-indicator" default="'N'"/>
        <relationship type="one" related="zenith.erp.purchase.PurchaseRfq"/>
        <relationship type="one" title="Vendor" related="mantle.party.Party">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
    </entity>

    <entity entity-name="RfqVendorResponseItem" package="zenith.erp.purchase">
        <field name="rfqResponseId" type="id" is-pk="true"/>
        <field name="rfqItemSeqId" type="id" is-pk="true"/>
        <field name="unitPrice" type="currency-amount"/>
        <field name="quantity" type="number-decimal"/>
        <field name="remarks" type="text-medium"/>
        <relationship type="one" related="zenith.erp.purchase.RfqVendorResponse"/>
    </entity>

    <!-- ========== Vendor Evaluation ========== -->
    <entity entity-name="VendorEvaluation" package="zenith.erp.purchase">
        <field name="evaluationId" type="id" is-pk="true"/>
        <field name="vendorPartyId" type="id"/>
        <field name="evaluationDate" type="date"/>
        <field name="qualityScore" type="number-integer"><description>1-10</description></field>
        <field name="deliveryScore" type="number-integer"/>
        <field name="priceScore" type="number-integer"/>
        <field name="overallScore" type="number-decimal"/>
        <field name="remarks" type="text-long"/>
        <field name="evaluatedBy" type="id"/>
        <relationship type="one" title="Vendor" related="mantle.party.Party">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
    </entity>

    <!-- ========== Purchase Agreement ========== -->
    <entity entity-name="PurchaseAgreement" package="zenith.erp.purchase">
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="vendorPartyId" type="id"/>
        <field name="agreementNumber" type="text-short"/>
        <field name="fromDate" type="date"/>
        <field name="thruDate" type="date"/>
        <field name="statusId" type="id"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Vendor" related="mantle.party.Party">
            <key-map field-name="vendorPartyId" related="partyId"/></relationship>
    </entity>

    <!-- ========== Three-Way Matching ========== -->
    <entity entity-name="ThreeWayMatch" package="zenith.erp.purchase">
        <field name="matchId" type="id" is-pk="true"/>
        <field name="purchaseOrderId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="receiptAssetId" type="id"/>
        <field name="matchDate" type="date-time"/>
        <field name="poQuantity" type="number-decimal"/>
        <field name="receiptQuantity" type="number-decimal"/>
        <field name="invoiceQuantity" type="number-decimal"/>
        <field name="poAmount" type="currency-amount"/>
        <field name="invoiceAmount" type="currency-amount"/>
        <field name="matchStatus" type="text-short"><description>FullMatch, QuantityMismatch, PriceMismatch, NotMatched</description></field>
        <field name="varianceAmount" type="currency-amount"/>
        <relationship type="one" title="PurchaseOrder" related="mantle.order.OrderHeader">
            <key-map field-name="purchaseOrderId" related="orderId"/></relationship>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
    </entity>

    <!-- ========== Goods Receipt Note ========== -->
    <entity entity-name="GoodsReceiptNote" package="zenith.erp.purchase">
        <field name="grnId" type="id" is-pk="true"/>
        <field name="purchaseOrderId" type="id"/>
        <field name="vendorPartyId" type="id"/>
        <field name="receiptDate" type="date-time"/>
        <field name="freightAmount" type="currency-amount"/>
        <field name="insuranceAmount" type="currency-amount"/>
        <field name="customsDutyAmount" type="currency-amount"/>
        <field name="otherChargesAmount" type="currency-amount"/>
        <field name="statusId" type="id"/>
        <relationship type="one" title="PurchaseOrder" related="mantle.order.OrderHeader">
            <key-map field-name="purchaseOrderId" related="orderId"/></relationship>
    </entity>

    <entity entity-name="GoodsReceiptNoteItem" package="zenith.erp.purchase">
        <field name="grnId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="receivedQuantity" type="number-decimal"/>
        <field name="acceptedQuantity" type="number-decimal"/>
        <field name="rejectedQuantity" type="number-decimal"/>
        <field name="apportionedCost" type="currency-amount"/>
        <relationship type="one" related="zenith.erp.purchase.GoodsReceiptNote"/>
    </entity>

    <!-- ========== Generic Purchase Invoice View ========== -->
    <view-entity entity-name="PurchaseInvoiceView" package="zenith.erp.purchase">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="VORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="BORG" entity-name="mantle.party.Organization" join-from-alias="INV" join-optional="true">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias entity-alias="INV" name="invoiceId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="invoiceTotal"/>
        <alias entity-alias="INV" name="customInvoiceNumber"/>
        <alias entity-alias="INV" name="vendorInvoiceNumber"/>
        <alias entity-alias="INV" name="vendorInvoiceDate"/>
        <alias entity-alias="INV" name="isImportPurchase"/>
        <alias entity-alias="INV" name="totalTaxableAmount"/>
        <alias entity-alias="INV" name="totalTaxAmount"/>
        <alias entity-alias="VORG" name="vendorName" field="organizationName"/>
        <alias entity-alias="BORG" name="buyerName" field="organizationName"/>
    </view-entity>

</entities>
