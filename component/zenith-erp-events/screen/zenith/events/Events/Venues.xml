<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Venues" default-menu-index="4">

    <transition name="createVenue" begin-transaction="true">
        <service-call name="create#zenith.erp.events.Venue"/>
        <default-response url="."/>
    </transition>
    <transition name="updateVenue" begin-transaction="true">
        <service-call name="update#zenith.erp.events.Venue"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.events.Venue" list="venues">
            <order-by field-name="venueName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Venues"/>
            <box-toolbar>
                <section name="evt_newvenue_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateVenueDialog" button-text="New Venue">
                    <form-single name="CreateVenueForm" transition="createVenue">
                        <field name="venueName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="venueType"><default-field title="Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="VenueType"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="address"><default-field title="Address"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="city"><default-field title="City"><text-line size="20"/></default-field></field>
                        <field name="stateCode"><default-field title="State Code"><text-line size="4"/></default-field></field>
                        <field name="pincode"><default-field title="Pincode"><text-line size="8"/></default-field></field>
                        <field name="capacity"><default-field title="Capacity"><text-line size="6"/></default-field></field>
                        <field name="contactPerson"><default-field title="Contact Person"><text-line size="20"/></default-field></field>
                        <field name="contactPhone"><default-field title="Phone"><text-line size="15"/></default-field></field>
                        <field name="contactEmail"><default-field title="Email"><text-line size="25"/></default-field></field>
                        <field name="rentalCostPerDay"><default-field title="Rental/Day (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="amenities"><default-field title="Amenities"><text-area rows="2" cols="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="VenueList" list="venues" transition="updateVenue">
                    <field name="venueId"><default-field><hidden/></default-field></field>
                    <field name="venueName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="venueType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="city"><default-field title="City"><display/></default-field></field>
                    <field name="capacity"><default-field title="Capacity"><display/></default-field></field>
                    <field name="rentalCostPerDay"><default-field title="Rental/Day (${currSymbol})"><display format="#,##,##0"/></default-field></field>
                    <field name="contactPerson"><default-field title="Contact"><display/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="evt_venue_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
