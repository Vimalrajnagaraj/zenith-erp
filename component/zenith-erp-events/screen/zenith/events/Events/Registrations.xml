<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Registrations" default-menu-index="3">

    <transition name="checkIn" begin-transaction="true">
        <service-call name="zenith.events.EventServices.checkIn#Attendee"/>
        <default-response url="."/>
    </transition>
    <transition name="editEvent"><default-response url="../EditEvent"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.events.EventRegistrationView" list="regList">
            <search-form-inputs default-order-by="-registrationDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="All Registrations"/>
            <box-body>
                <form-list name="AllRegList" list="regList" skip-form="true" header-dialog="true">
                    <field name="registrationNumber"><header-field show-order-by="true"/>
                        <default-field title="Reg #"><display/></default-field></field>
                    <field name="eventName"><default-field title="Event">
                        <link url="editEvent" text="${eventName}" link-type="anchor">
                            <parameter name="eventId"/>
                        </link>
                    </default-field></field>
                    <field name="attendeeName"><header-field title="Attendee"><text-find size="15" hide-options="true"/></header-field>
                        <default-field title="Attendee"><display/></default-field></field>
                    <field name="attendeeEmail"><default-field title="Email"><display/></default-field></field>
                    <field name="ticketName"><default-field title="Ticket"><display/></default-field></field>
                    <field name="ticketQuantity"><default-field title="Qty"><display/></default-field></field>
                    <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="EventRegistration"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field>
                    </field>
                    <field name="registrationDate"><header-field show-order-by="true"/>
                        <default-field title="Registered"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="checkedIn"><default-field title="In"><display/></default-field></field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
