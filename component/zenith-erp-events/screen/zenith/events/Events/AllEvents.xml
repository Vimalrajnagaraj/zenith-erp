<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All Events" default-menu-index="1">

    <transition name="createEvent" begin-transaction="true">
        <service-call name="zenith.events.EventServices.create#Event"/>
        <default-response url="../EditEvent"/>
    </transition>
    <transition name="editEvent"><default-response url="../EditEvent"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.events.Event" list="eventList">
            <search-form-inputs default-order-by="-startDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Events"/>
            <box-toolbar>
                <container-dialog id="CreateEventDialog" button-text="New Event">
                    <form-single name="CreateEventForm" transition="createEvent">
                        <field name="eventName"><default-field title="Event Name"><text-line size="30"/></default-field></field>
                        <field name="eventType"><default-field title="Type"><drop-down>
                            <entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="EventType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="categoryId"><default-field title="Category"><drop-down allow-empty="true">
                            <entity-options key="${categoryId}" text="${categoryName}">
                                <entity-find entity-name="zenith.erp.events.EventCategory">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="venueId"><default-field title="Venue"><drop-down allow-empty="true">
                            <entity-options key="${venueId}" text="${venueName}">
                                <entity-find entity-name="zenith.erp.events.Venue">
                                    <econdition field-name="isActive" value="Y"/>
                                </entity-find>
                            </entity-options>
                        </drop-down></default-field></field>
                        <field name="startDate"><default-field title="Start"><date-time/></default-field></field>
                        <field name="endDate"><default-field title="End"><date-time/></default-field></field>
                        <field name="maxAttendees"><default-field title="Max Attendees"><text-line size="6"/></default-field></field>
                        <field name="isFreeEvent"><default-field title="Free Event"><drop-down>
                            <option key="N" text="No"/><option key="Y" text="Yes"/>
                        </drop-down></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="50"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="EventListForm" list="eventList" skip-form="true" header-dialog="true">
                    <field name="eventNumber"><header-field show-order-by="true"/>
                        <default-field title="Event #">
                            <link url="editEvent" text="${eventNumber}" link-type="anchor">
                                <parameter name="eventId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="eventName"><header-field show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                        <default-field title="Name"><display/></default-field></field>
                    <field name="eventType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                    </default-field></field>
                    <field name="startDate"><header-field show-order-by="true"/>
                        <default-field title="Start"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="endDate"><default-field title="End"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                    <field name="maxAttendees"><default-field title="Capacity"><display/></default-field></field>
                    <field name="currentRegistrations"><default-field title="Registered"><display/></default-field></field>
                    <field name="statusId"><header-field title="Status"><drop-down allow-empty="true">
                            <entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Event"/>
                                </entity-find></entity-options></drop-down></header-field>
                        <default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field>
                    </field>
                    <field name="find"><header-field title="Find"><submit/></header-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
