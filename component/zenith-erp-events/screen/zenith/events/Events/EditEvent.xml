<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Event Detail" default-menu-index="2" default-menu-include="false">

    <parameter name="eventId" required="true"/>

    <transition name="updateEvent" begin-transaction="true">
        <service-call name="update#zenith.erp.events.Event"/>
        <default-response url="."/>
    </transition>
    <transition name="createTicketType" begin-transaction="true">
        <service-call name="create#zenith.erp.events.TicketType"/>
        <default-response url="."/>
    </transition>
    <transition name="updateTicketType" begin-transaction="true">
        <service-call name="update#zenith.erp.events.TicketType"/>
        <default-response url="."/>
    </transition>
    <transition name="registerAttendee" begin-transaction="true">
        <service-call name="zenith.events.EventServices.register#Attendee"/>
        <default-response url="."/>
    </transition>
    <transition name="createSession" begin-transaction="true">
        <service-call name="create#zenith.erp.events.EventSession"/>
        <default-response url="."/>
    </transition>
    <transition name="updateSession" begin-transaction="true">
        <service-call name="update#zenith.erp.events.EventSession"/>
        <default-response url="."/>
    </transition>
    <transition name="createSponsor" begin-transaction="true">
        <service-call name="create#zenith.erp.events.EventSponsor"/>
        <default-response url="."/>
    </transition>
    <transition name="checkInAttendee" begin-transaction="true">
        <service-call name="zenith.events.EventServices.checkIn#Attendee"/>
        <default-response url="."/>
    </transition>
    <transition name="cancelRegistration" begin-transaction="true">
        <service-call name="zenith.events.EventServices.cancel#Registration"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.events.Event" value-field="event"/>
        <entity-find entity-name="zenith.erp.events.TicketType" list="tickets">
            <econdition field-name="eventId"/>
            <order-by field-name="price"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.events.EventRegistration" list="registrations">
            <econdition field-name="eventId"/>
            <order-by field-name="-registrationDate"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.events.EventSession" list="sessions">
            <econdition field-name="eventId"/>
            <order-by field-name="sequenceNum,startTime"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.events.EventSponsor" list="sponsors">
            <econdition field-name="eventId"/>
            <order-by field-name="sponsorLevel"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6">
                <!-- Event Detail -->
                <container-box>
                    <box-header title="Event — ${event.eventNumber}"/>
                    <box-body>
                        <form-single name="EventForm" map="event" transition="updateEvent">
                            <field name="eventId"><default-field><hidden/></default-field></field>
                            <field name="eventNumber"><default-field title="Event #"><display/></default-field></field>
                            <field name="eventName"><default-field title="Name"><text-line size="30"/></default-field></field>
                            <field name="eventType"><default-field title="Type"><drop-down>
                                <entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="EventType"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="categoryId"><default-field title="Category"><drop-down allow-empty="true">
                                <entity-options key="${categoryId}" text="${categoryName}">
                                    <entity-find entity-name="zenith.erp.events.EventCategory">
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="venueId"><default-field title="Venue"><drop-down allow-empty="true">
                                <entity-options key="${venueId}" text="${venueName}">
                                    <entity-find entity-name="zenith.erp.events.Venue">
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="startDate"><default-field title="Start"><date-time/></default-field></field>
                            <field name="endDate"><default-field title="End"><date-time/></default-field></field>
                            <field name="maxAttendees"><default-field title="Max Attendees"><text-line size="6"/></default-field></field>
                            <field name="currentRegistrations"><default-field title="Registered"><display/></default-field></field>
                            <field name="statusId"><default-field title="Status"><drop-down>
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Event"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down></default-field></field>
                            <field name="isFreeEvent"><default-field title="Free Event"><drop-down>
                                <option key="N" text="No"/><option key="Y" text="Yes"/>
                            </drop-down></default-field></field>
                            <field name="contactEmail"><default-field title="Contact Email"><text-line size="25"/></default-field></field>
                            <field name="contactPhone"><default-field title="Contact Phone"><text-line size="15"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="3" cols="50"/></default-field></field>
                            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                        </form-single>
                    </box-body>
                </container-box>

                <!-- Sessions / Agenda -->
                <container-box>
                    <box-header title="Agenda / Sessions"/>
                    <box-toolbar>
                        <container-dialog id="AddSessionDialog" button-text="Add Session">
                            <form-single name="AddSessionForm" transition="createSession">
                                <field name="eventId"><default-field><hidden/></default-field></field>
                                <field name="sessionTitle"><default-field title="Title"><text-line size="30"/></default-field></field>
                                <field name="speakerName"><default-field title="Speaker"><text-line size="20"/></default-field></field>
                                <field name="sessionType"><default-field title="Type"><drop-down>
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="SessionType"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="startTime"><default-field title="Start"><date-time/></default-field></field>
                                <field name="endTime"><default-field title="End"><date-time/></default-field></field>
                                <field name="roomName"><default-field title="Room"><text-line size="15"/></default-field></field>
                                <field name="sequenceNum"><default-field title="Order"><text-line size="3"/></default-field></field>
                                <field name="description"><default-field title="Description"><text-area rows="2" cols="40"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="SessionList" list="sessions" transition="updateSession">
                            <field name="sessionId"><default-field><hidden/></default-field></field>
                            <field name="eventId"><default-field><hidden/></default-field></field>
                            <field name="sequenceNum"><default-field title="#"><display/></default-field></field>
                            <field name="sessionTitle"><default-field title="Title"><text-line size="15"/></default-field></field>
                            <field name="speakerName"><default-field title="Speaker"><display/></default-field></field>
                            <field name="startTime"><default-field title="Start"><display format="HH:mm"/></default-field></field>
                            <field name="endTime"><default-field title="End"><display format="HH:mm"/></default-field></field>
                            <field name="sessionType"><default-field title="Type">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
            <row-col lg="6">
                <!-- Ticket Types -->
                <container-box>
                    <box-header title="Ticket Types"/>
                    <box-toolbar>
                        <container-dialog id="AddTicketDialog" button-text="Add Ticket Type">
                            <form-single name="AddTicketForm" transition="createTicketType">
                                <field name="eventId"><default-field><hidden/></default-field></field>
                                <field name="ticketName"><default-field title="Ticket Name"><text-line size="20"/></default-field></field>
                                <field name="price"><default-field title="Price (${currSymbol})"><text-line size="10"/></default-field></field>
                                <field name="gstRate"><default-field title="GST %"><text-line size="4" default-value="18"/></default-field></field>
                                <field name="maxQuantity"><default-field title="Max Quantity"><text-line size="5"/></default-field></field>
                                <field name="earlyBirdPrice"><default-field title="Early Bird Price (${currSymbol})"><text-line size="10"/></default-field></field>
                                <field name="earlyBirdEndDate"><default-field title="Early Bird Ends"><date-time type="date"/></default-field></field>
                                <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="TicketList" list="tickets" transition="updateTicketType">
                            <field name="ticketTypeId"><default-field><hidden/></default-field></field>
                            <field name="eventId"><default-field><hidden/></default-field></field>
                            <field name="ticketName"><default-field title="Name"><display/></default-field></field>
                            <field name="price"><default-field title="Price (${currSymbol})"><text-line size="8"/></default-field></field>
                            <field name="gstRate"><default-field title="GST %"><display/></default-field></field>
                            <field name="maxQuantity"><default-field title="Max"><display/></default-field></field>
                            <field name="soldCount"><default-field title="Sold"><display/></default-field></field>
                            <field name="isActive"><default-field title="Active"><drop-down>
                                <option key="Y" text="Yes"/><option key="N" text="No"/>
                            </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>

                <!-- Registrations -->
                <container-box>
                    <box-header title="Registrations"/>
                    <box-toolbar>
                        <container-dialog id="RegisterDialog" button-text="Register Attendee">
                            <form-single name="RegisterForm" transition="registerAttendee">
                                <field name="eventId"><default-field><hidden/></default-field></field>
                                <field name="ticketTypeId"><default-field title="Ticket"><drop-down>
                                    <list-options list="tickets" key="${ticketTypeId}" text="${ticketName} — ₹${price}"/>
                                </drop-down></default-field></field>
                                <field name="attendeeName"><default-field title="Name"><text-line size="25"/></default-field></field>
                                <field name="attendeeEmail"><default-field title="Email"><text-line size="25"/></default-field></field>
                                <field name="attendeePhone"><default-field title="Phone"><text-line size="15"/></default-field></field>
                                <field name="attendeeOrganization"><default-field title="Organization"><text-line size="25"/></default-field></field>
                                <field name="ticketQuantity"><default-field title="Quantity"><text-line size="3" default-value="1"/></default-field></field>
                                <field name="paymentMethod"><default-field title="Payment"><drop-down allow-empty="true">
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="RegPaymentMethod"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="paymentReference"><default-field title="Payment Ref"><text-line size="20"/></default-field></field>
                                <field name="submitButton"><default-field title="Register"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="RegList" list="registrations" skip-form="true">
                            <field name="registrationNumber"><default-field title="Reg #"><display/></default-field></field>
                            <field name="attendeeName"><default-field title="Name"><display/></default-field></field>
                            <field name="attendeeEmail"><default-field title="Email"><display/></default-field></field>
                            <field name="ticketQuantity"><default-field title="Qty"><display/></default-field></field>
                            <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <display-entity entity-name="moqui.basic.StatusItem"/>
                            </default-field></field>
                            <field name="checkedIn"><default-field title="In"><display/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>

                <!-- Sponsors -->
                <container-box>
                    <box-header title="Sponsors"/>
                    <box-toolbar>
                        <container-dialog id="AddSponsorDialog" button-text="Add Sponsor">
                            <form-single name="AddSponsorForm" transition="createSponsor">
                                <field name="eventId"><default-field><hidden/></default-field></field>
                                <field name="sponsorName"><default-field title="Sponsor Name"><text-line size="25"/></default-field></field>
                                <field name="sponsorLevel"><default-field title="Level"><drop-down>
                                    <entity-options key="${enumId}" text="${description}">
                                        <entity-find entity-name="moqui.basic.Enumeration">
                                            <econdition field-name="enumTypeId" value="SponsorLevel"/>
                                        </entity-find>
                                    </entity-options>
                                </drop-down></default-field></field>
                                <field name="sponsorshipAmount"><default-field title="Amount (${currSymbol})"><text-line size="10"/></default-field></field>
                                <field name="websiteUrl"><default-field title="Website"><text-line size="25"/></default-field></field>
                                <field name="notes"><default-field title="Notes"><text-line size="30"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <form-list name="SponsorList" list="sponsors" skip-form="true">
                            <field name="sponsorName"><default-field title="Name"><display/></default-field></field>
                            <field name="sponsorLevel"><default-field title="Level">
                                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/>
                            </default-field></field>
                            <field name="sponsorshipAmount"><default-field title="Amount (${currSymbol})"><display format="#,##,##0"/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
