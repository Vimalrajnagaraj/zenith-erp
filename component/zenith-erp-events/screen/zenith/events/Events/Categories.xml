<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Categories" default-menu-index="5">

    <transition name="createCategory" begin-transaction="true">
        <service-call name="create#zenith.erp.events.EventCategory"/>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <service-call name="update#zenith.erp.events.EventCategory"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.events.EventCategory" list="categories">
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Event Categories"/>
            <box-toolbar>
                <section name="evt_newcat_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCatDialog" button-text="New Category">
                    <form-single name="CreateCatForm" transition="createCategory">
                        <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CategoryList" list="categories" transition="updateCategory">
                    <field name="categoryId"><default-field><hidden/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="20"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="isActive"><default-field title="Active"><drop-down>
                        <option key="Y" text="Yes"/><option key="N" text="No"/>
                    </drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="evt_cat_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
