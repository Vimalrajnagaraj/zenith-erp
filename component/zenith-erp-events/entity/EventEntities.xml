<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Event Category -->
    <entity entity-name="EventCategory" package="zenith.erp.events" short-alias="EventCategories">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- Venue -->
    <entity entity-name="Venue" package="zenith.erp.events" short-alias="Venues">
        <field name="venueId" type="id" is-pk="true"/>
        <field name="venueName" type="text-medium"/>
        <field name="venueType" type="id"/>
        <field name="address" type="text-long"/>
        <field name="city" type="text-medium"/>
        <field name="stateCode" type="text-short"/>
        <field name="pincode" type="text-short"/>
        <field name="capacity" type="number-integer"/>
        <field name="contactPerson" type="text-medium"/>
        <field name="contactPhone" type="text-short"/>
        <field name="contactEmail" type="text-medium"/>
        <field name="rentalCostPerDay" type="currency-precise"/>
        <field name="gstRate" type="number-decimal" default="18"/>
        <field name="amenities" type="text-long"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="VenueType" description="Venue Type"/>
            <moqui.basic.Enumeration enumId="VtConference" enumTypeId="VenueType" description="Conference Hall" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="VtBanquet" enumTypeId="VenueType" description="Banquet Hall" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="VtAuditorium" enumTypeId="VenueType" description="Auditorium" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="VtOutdoor" enumTypeId="VenueType" description="Outdoor / Open Air" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="VtVirtual" enumTypeId="VenueType" description="Virtual / Online" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="VtHybrid" enumTypeId="VenueType" description="Hybrid" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- Event -->
    <entity entity-name="Event" package="zenith.erp.events" short-alias="Events">
        <field name="eventId" type="id" is-pk="true"/>
        <field name="eventNumber" type="text-short"/>
        <field name="eventName" type="text-medium"/>
        <field name="eventType" type="id"/>
        <field name="categoryId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="venueId" type="id"/>
        <field name="startDate" type="date-time"/>
        <field name="endDate" type="date-time"/>
        <field name="registrationOpenDate" type="date-time"/>
        <field name="registrationCloseDate" type="date-time"/>
        <field name="maxAttendees" type="number-integer"/>
        <field name="currentRegistrations" type="number-integer" default="0"/>
        <field name="organizerPartyId" type="id"/>
        <field name="contactEmail" type="text-medium"/>
        <field name="contactPhone" type="text-short"/>
        <field name="websiteUrl" type="text-medium"/>
        <field name="isFreeEvent" type="text-indicator" default="'N'"/>
        <field name="currencyUomId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="notes" type="text-long"/>
        <relationship type="one" related="zenith.erp.events.EventCategory"/>
        <relationship type="one" related="zenith.erp.events.Venue"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="EventType" description="Event Type"/>
            <moqui.basic.Enumeration enumId="EvConference" enumTypeId="EventType" description="Conference" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="EvSeminar" enumTypeId="EventType" description="Seminar" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="EvWorkshop" enumTypeId="EventType" description="Workshop" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="EvWebinar" enumTypeId="EventType" description="Webinar" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="EvTraining" enumTypeId="EventType" description="Training" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="EvMeetup" enumTypeId="EventType" description="Meetup" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="EvExhibition" enumTypeId="EventType" description="Exhibition" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="EvProductLaunch" enumTypeId="EventType" description="Product Launch" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="EvTeamBuild" enumTypeId="EventType" description="Team Building" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="EvAGM" enumTypeId="EventType" description="AGM / Board Meeting" sequenceNum="10"/>

            <moqui.basic.StatusType statusTypeId="Event" description="Event"/>
            <moqui.basic.StatusItem statusId="EvDraft" statusTypeId="Event" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EvPlanning" statusTypeId="Event" description="Planning" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EvPublished" statusTypeId="Event" description="Published" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EvRegOpen" statusTypeId="Event" description="Registration Open" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="EvRegClosed" statusTypeId="Event" description="Registration Closed" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="EvOngoing" statusTypeId="Event" description="Ongoing" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="EvCompleted" statusTypeId="Event" description="Completed" sequenceNum="7"/>
            <moqui.basic.StatusItem statusId="EvCancelled" statusTypeId="Event" description="Cancelled" sequenceNum="8"/>
            <moqui.basic.StatusItem statusId="EvPostponed" statusTypeId="Event" description="Postponed" sequenceNum="9"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvDraft" toStatusId="EvPlanning" transitionName="Start Planning"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvPlanning" toStatusId="EvPublished" transitionName="Publish"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvPublished" toStatusId="EvRegOpen" transitionName="Open Registration"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvRegOpen" toStatusId="EvRegClosed" transitionName="Close Registration"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvRegClosed" toStatusId="EvOngoing" transitionName="Start Event"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvOngoing" toStatusId="EvCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvDraft" toStatusId="EvCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvPlanning" toStatusId="EvCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvPublished" toStatusId="EvCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvRegOpen" toStatusId="EvPostponed" transitionName="Postpone"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EvPostponed" toStatusId="EvRegOpen" transitionName="Reschedule"/>
        </seed-data>
    </entity>

    <!-- Ticket Type (pricing tiers per event) -->
    <entity entity-name="TicketType" package="zenith.erp.events" short-alias="TicketTypes">
        <field name="ticketTypeId" type="id" is-pk="true"/>
        <field name="eventId" type="id"/>
        <field name="ticketName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="price" type="currency-precise"/>
        <field name="gstRate" type="number-decimal" default="18"/>
        <field name="hsnSacCode" type="text-short" default="'999692'"/>
        <field name="maxQuantity" type="number-integer"/>
        <field name="soldCount" type="number-integer" default="0"/>
        <field name="earlyBirdPrice" type="currency-precise"/>
        <field name="earlyBirdEndDate" type="date-time"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <relationship type="one" related="zenith.erp.events.Event"/>
    </entity>

    <!-- Registration -->
    <entity entity-name="EventRegistration" package="zenith.erp.events" short-alias="EventRegistrations">
        <field name="registrationId" type="id" is-pk="true"/>
        <field name="registrationNumber" type="text-short"/>
        <field name="eventId" type="id"/>
        <field name="ticketTypeId" type="id"/>
        <field name="attendeePartyId" type="id"/>
        <field name="attendeeName" type="text-medium"/>
        <field name="attendeeEmail" type="text-medium"/>
        <field name="attendeePhone" type="text-short"/>
        <field name="attendeeOrganization" type="text-medium"/>
        <field name="ticketQuantity" type="number-integer" default="1"/>
        <field name="unitPrice" type="currency-precise"/>
        <field name="gstAmount" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="paymentMethod" type="id"/>
        <field name="paymentReference" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="registrationDate" type="date-time"/>
        <field name="checkedIn" type="text-indicator" default="'N'"/>
        <field name="checkInTime" type="date-time"/>
        <field name="cancelReason" type="text-medium"/>
        <field name="refundAmount" type="currency-precise"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.events.Event"/>
        <relationship type="one" related="zenith.erp.events.TicketType"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="EventRegistration" description="Event Registration"/>
            <moqui.basic.StatusItem statusId="ErPending" statusTypeId="EventRegistration" description="Pending Payment" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="ErConfirmed" statusTypeId="EventRegistration" description="Confirmed" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="ErCheckedIn" statusTypeId="EventRegistration" description="Checked In" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="ErCompleted" statusTypeId="EventRegistration" description="Attended" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="ErCancelled" statusTypeId="EventRegistration" description="Cancelled" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="ErNoShow" statusTypeId="EventRegistration" description="No Show" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="ErRefunded" statusTypeId="EventRegistration" description="Refunded" sequenceNum="7"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErPending" toStatusId="ErConfirmed" transitionName="Confirm"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErConfirmed" toStatusId="ErCheckedIn" transitionName="Check In"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErCheckedIn" toStatusId="ErCompleted" transitionName="Mark Attended"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErPending" toStatusId="ErCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErConfirmed" toStatusId="ErCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErConfirmed" toStatusId="ErNoShow" transitionName="No Show"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ErCancelled" toStatusId="ErRefunded" transitionName="Refund"/>
        </seed-data>
    </entity>

    <!-- Event Session / Agenda Item -->
    <entity entity-name="EventSession" package="zenith.erp.events" short-alias="EventSessions">
        <field name="sessionId" type="id" is-pk="true"/>
        <field name="eventId" type="id"/>
        <field name="sessionTitle" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="speakerName" type="text-medium"/>
        <field name="speakerBio" type="text-long"/>
        <field name="startTime" type="date-time"/>
        <field name="endTime" type="date-time"/>
        <field name="roomName" type="text-short"/>
        <field name="sessionType" type="id"/>
        <field name="sequenceNum" type="number-integer"/>
        <relationship type="one" related="zenith.erp.events.Event"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SessionType" description="Event Session Type"/>
            <moqui.basic.Enumeration enumId="StKeynote" enumTypeId="SessionType" description="Keynote" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="StPanel" enumTypeId="SessionType" description="Panel Discussion" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="StPresentation" enumTypeId="SessionType" description="Presentation" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="StWorkshop" enumTypeId="SessionType" description="Workshop" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="StBreak" enumTypeId="SessionType" description="Break / Networking" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="StQandA" enumTypeId="SessionType" description="Q&amp;A" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- Event Sponsor -->
    <entity entity-name="EventSponsor" package="zenith.erp.events" short-alias="EventSponsors">
        <field name="sponsorId" type="id" is-pk="true"/>
        <field name="eventId" type="id"/>
        <field name="sponsorPartyId" type="id"/>
        <field name="sponsorName" type="text-medium"/>
        <field name="sponsorLevel" type="id"/>
        <field name="sponsorshipAmount" type="currency-precise"/>
        <field name="logoUrl" type="text-medium"/>
        <field name="websiteUrl" type="text-medium"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.events.Event"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="SponsorLevel" description="Sponsor Level"/>
            <moqui.basic.Enumeration enumId="SpTitle" enumTypeId="SponsorLevel" description="Title Sponsor" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="SpPlatinum" enumTypeId="SponsorLevel" description="Platinum" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="SpGold" enumTypeId="SponsorLevel" description="Gold" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="SpSilver" enumTypeId="SponsorLevel" description="Silver" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="SpBronze" enumTypeId="SponsorLevel" description="Bronze" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="SpMedia" enumTypeId="SponsorLevel" description="Media Partner" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- View -->
    <view-entity entity-name="EventRegistrationView" package="zenith.erp.events">
        <member-entity entity-alias="ER" entity-name="zenith.erp.events.EventRegistration"/>
        <member-entity entity-alias="EV" entity-name="zenith.erp.events.Event" join-from-alias="ER">
            <key-map field-name="eventId"/>
        </member-entity>
        <member-entity entity-alias="TT" entity-name="zenith.erp.events.TicketType" join-from-alias="ER">
            <key-map field-name="ticketTypeId"/>
        </member-entity>
        <alias-all entity-alias="ER"/>
        <alias entity-alias="EV" name="eventName"/>
        <alias entity-alias="EV" name="startDate" field="startDate"/>
        <alias entity-alias="TT" name="ticketName"/>
    </view-entity>

</entities>
