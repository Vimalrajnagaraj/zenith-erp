<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== Equipment ========== -->
    <entity entity-name="Equipment" package="zenith.erp.maintenance" short-alias="Equipments">
        <field name="equipmentId" type="id" is-pk="true"/>
        <field name="equipmentNumber" type="text-short"/>
        <field name="equipmentName" type="text-medium"/>
        <field name="equipmentType" type="id"/>
        <field name="make" type="text-medium"/>
        <field name="model" type="text-medium"/>
        <field name="serialNumber" type="text-medium"/>
        <field name="facilityId" type="id"/>
        <field name="locationDetail" type="text-medium"/>
        <field name="purchaseDate" type="date"/>
        <field name="purchaseAmount" type="currency-precise"/>
        <field name="warrantyExpiryDate" type="date"/>
        <field name="statusId" type="id"/>
        <field name="currentMeterReading" type="number-decimal"/>
        <field name="meterUnit" type="text-short"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="criticality" type="text-short"/>
        <field name="description" type="text-long"/>
        <!-- ZE-SB-013 (Tier 4): equipment is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" title="Equipment" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="Equipment" description="Equipment Status"/>
            <moqui.basic.StatusItem statusId="EqActive" statusTypeId="Equipment" description="Active" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EqInMaintenance" statusTypeId="Equipment" description="In Maintenance" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EqRetired" statusTypeId="Equipment" description="Retired" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EqDecommissioned" statusTypeId="Equipment" description="Decommissioned" sequenceNum="4"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EqActive" toStatusId="EqInMaintenance" transitionName="Send to Maintenance"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EqInMaintenance" toStatusId="EqActive" transitionName="Return to Service"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EqActive" toStatusId="EqRetired" transitionName="Retire"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EqRetired" toStatusId="EqDecommissioned" transitionName="Decommission"/>

            <moqui.basic.EnumerationType enumTypeId="EquipmentType" description="Equipment Type"/>
            <moqui.basic.Enumeration enumId="EtMachine" enumTypeId="EquipmentType" description="Machine" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="EtMotor" enumTypeId="EquipmentType" description="Motor/Pump" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="EtCompressor" enumTypeId="EquipmentType" description="Compressor" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="EtConveyor" enumTypeId="EquipmentType" description="Conveyor" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="EtHvac" enumTypeId="EquipmentType" description="HVAC" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="EtElectrical" enumTypeId="EquipmentType" description="Electrical Panel" sequenceNum="6"/>
            <moqui.basic.Enumeration enumId="EtGenerator" enumTypeId="EquipmentType" description="Generator/DG Set" sequenceNum="7"/>
            <moqui.basic.Enumeration enumId="EtTooling" enumTypeId="EquipmentType" description="Tooling/Die/Mould" sequenceNum="8"/>
            <moqui.basic.Enumeration enumId="EtInstrument" enumTypeId="EquipmentType" description="Instrument/Gauge" sequenceNum="9"/>
            <moqui.basic.Enumeration enumId="EtIt" enumTypeId="EquipmentType" description="IT/Server" sequenceNum="10"/>
            <moqui.basic.Enumeration enumId="EtOther" enumTypeId="EquipmentType" description="Other" sequenceNum="11"/>
        </seed-data>
    </entity>

    <!-- ========== Maintenance Plan ========== -->
    <entity entity-name="MaintenancePlan" package="zenith.erp.maintenance" short-alias="MaintenancePlans">
        <field name="planId" type="id" is-pk="true"/>
        <field name="equipmentId" type="id"/>
        <field name="planName" type="text-medium"/>
        <field name="planType" type="text-short"/>
        <field name="frequencyDays" type="number-integer"/>
        <field name="frequencyMeterReading" type="number-decimal"/>
        <field name="lastMaintenanceDate" type="date"/>
        <field name="nextMaintenanceDate" type="date"/>
        <field name="lastMeterReading" type="number-decimal"/>
        <field name="nextMeterReading" type="number-decimal"/>
        <field name="description" type="text-long"/>
        <field name="isActive" type="text-indicator"/>
        <!-- ZE-SB-013 (Tier 4): a maintenance plan is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.maintenance.Equipment"/>
    </entity>

    <!-- ========== Maintenance Work Order ========== -->
    <entity entity-name="MaintWorkOrder" package="zenith.erp.maintenance" short-alias="MaintWorkOrders">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="workOrderNumber" type="text-short"/>
        <field name="equipmentId" type="id"/>
        <field name="planId" type="id"/>
        <field name="workOrderType" type="text-short"/>
        <field name="priority" type="text-short"/>
        <field name="description" type="text-long"/>
        <field name="requestedDate" type="date-time"/>
        <field name="scheduledDate" type="date-time"/>
        <field name="startDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="estimatedHours" type="number-decimal"/>
        <field name="actualHours" type="number-decimal"/>
        <field name="downTimeHours" type="number-decimal"/>
        <field name="totalPartsCost" type="currency-precise"/>
        <field name="totalLaborCost" type="currency-precise"/>
        <field name="remarks" type="text-long"/>
        <!-- ZE-SB-013 (Tier 4): a work order is private to its tenant. -->
        <field name="organizationPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.maintenance.Equipment"/>
        <relationship type="one" related="zenith.erp.maintenance.MaintenancePlan"/>
        <relationship type="one" title="MaintWorkOrder" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="MaintWorkOrder" description="Maintenance Work Order"/>
            <moqui.basic.StatusItem statusId="WoDraft" statusTypeId="MaintWorkOrder" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="WoScheduled" statusTypeId="MaintWorkOrder" description="Scheduled" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="WoInProgress" statusTypeId="MaintWorkOrder" description="In Progress" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="WoOnHold" statusTypeId="MaintWorkOrder" description="On Hold" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="WoCompleted" statusTypeId="MaintWorkOrder" description="Completed" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="WoCancelled" statusTypeId="MaintWorkOrder" description="Cancelled" sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoDraft" toStatusId="WoScheduled" transitionName="Schedule"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoScheduled" toStatusId="WoInProgress" transitionName="Start"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoInProgress" toStatusId="WoOnHold" transitionName="Hold"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoOnHold" toStatusId="WoInProgress" transitionName="Resume"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoInProgress" toStatusId="WoCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoDraft" toStatusId="WoCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="WoScheduled" toStatusId="WoCancelled" transitionName="Cancel"/>
        </seed-data>
    </entity>

    <!-- ========== Work Order Task ========== -->
    <entity entity-name="WorkOrderTask" package="zenith.erp.maintenance" short-alias="WorkOrderTasks">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="taskSeqId" type="id" is-pk="true"/>
        <field name="taskDescription" type="text-medium"/>
        <field name="assignedToPartyId" type="id"/>
        <field name="estimatedHours" type="number-decimal"/>
        <field name="actualHours" type="number-decimal"/>
        <field name="statusId" type="text-short"/>
        <field name="completedDate" type="date-time"/>
        <relationship type="one" related="zenith.erp.maintenance.MaintWorkOrder"/>
    </entity>

    <!-- ========== Work Order Part ========== -->
    <entity entity-name="WorkOrderPart" package="zenith.erp.maintenance" short-alias="WorkOrderParts">
        <field name="workOrderId" type="id" is-pk="true"/>
        <field name="partSeqId" type="id" is-pk="true"/>
        <field name="productId" type="id"/>
        <field name="partName" type="text-medium"/>
        <field name="quantityRequired" type="number-decimal"/>
        <field name="quantityUsed" type="number-decimal"/>
        <field name="unitCost" type="currency-precise"/>
        <field name="totalCost" type="currency-precise"/>
        <relationship type="one" related="zenith.erp.maintenance.MaintWorkOrder"/>
    </entity>

    <!-- ========== Equipment Meter Log ========== -->
    <entity entity-name="EquipmentMeterLog" package="zenith.erp.maintenance" short-alias="EquipmentMeterLogs">
        <field name="logId" type="id" is-pk="true"/>
        <field name="equipmentId" type="id"/>
        <field name="readingDate" type="date-time"/>
        <field name="meterReading" type="number-decimal"/>
        <field name="readingType" type="text-short"/>
        <field name="recordedByPartyId" type="id"/>
        <relationship type="one" related="zenith.erp.maintenance.Equipment"/>
    </entity>

    <!-- ========== Views ========== -->
    <view-entity entity-name="WorkOrderView" package="zenith.erp.maintenance">
        <member-entity entity-alias="WO" entity-name="zenith.erp.maintenance.MaintWorkOrder"/>
        <member-entity entity-alias="EQ" entity-name="zenith.erp.maintenance.Equipment" join-from-alias="WO" join-optional="true">
            <key-map field-name="equipmentId"/></member-entity>
        <alias-all entity-alias="WO"/>
        <alias entity-alias="EQ" name="equipmentName"/>
        <alias entity-alias="EQ" name="equipmentNumber"/>
    </view-entity>
</entities>
