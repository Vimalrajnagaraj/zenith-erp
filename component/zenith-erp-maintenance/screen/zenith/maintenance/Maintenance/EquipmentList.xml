<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Equipment" default-menu-index="2">

    <transition name="createEquipment" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.create#Equipment"/>
        <default-response url="."/>
    </transition>
    <transition name="editEquipment"><default-response url="../EditEquipment"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.maintenance.Equipment" list="equipList">
            <search-form-inputs default-order-by="equipmentName"/>
            <order-by field-name="equipmentName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Equipment Registry"/>
            <box-toolbar>
                <container-dialog id="CreateEquipDialog" button-text="Add Equipment">
                    <form-single name="CreateEquipForm" transition="createEquipment">
                        <field name="equipmentName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="equipmentType"><default-field title="Type">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="EquipmentType"/>
                                    <order-by field-name="sequenceNum"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="make"><default-field title="Make"><text-line size="15"/></default-field></field>
                        <field name="model"><default-field title="Model"><text-line size="15"/></default-field></field>
                        <field name="serialNumber"><default-field title="Serial No"><text-line size="20"/></default-field></field>
                        <field name="locationDetail"><default-field title="Location"><text-line size="25"/></default-field></field>
                        <field name="criticality"><default-field title="Criticality">
                            <drop-down no-current-selected-key="Medium">
                                <option key="Critical"/><option key="High"/><option key="Medium"/><option key="Low"/>
                            </drop-down></default-field></field>
                        <field name="meterUnit"><default-field title="Meter Unit">
                            <drop-down no-current-selected-key="Hours">
                                <option key="Hours"/><option key="Km"/><option key="Cycles"/><option key="Pieces"/>
                            </drop-down></default-field></field>
                        <field name="purchaseDate"><default-field title="Purchase Date"><date-time type="date"/></default-field></field>
                        <field name="purchaseAmount"><default-field title="Purchase Amount"><text-line size="12"/></default-field></field>
                        <field name="warrantyExpiryDate"><default-field title="Warranty Expiry"><date-time type="date"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="EquipList" list="equipList" skip-form="true">
                    <field name="equipmentNumber"><default-field title="EQ #"><display/></default-field></field>
                    <field name="equipmentName"><default-field title="Name"><display/></default-field></field>
                    <field name="equipmentType"><default-field title="Type">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="make"><default-field title="Make"><display/></default-field></field>
                    <field name="model"><default-field title="Model"><display/></default-field></field>
                    <field name="serialNumber"><default-field title="Serial"><display/></default-field></field>
                    <field name="criticality"><default-field title="Criticality"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="currentMeterReading"><default-field title="Meter"><display format="#,##0"/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editEquipment" text="Detail" parameter-map="[equipmentId:equipmentId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
