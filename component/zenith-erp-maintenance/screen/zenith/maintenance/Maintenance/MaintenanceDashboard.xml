<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboard" default-menu-index="1">

    <actions>
        <entity-find-count entity-name="zenith.erp.maintenance.Equipment" count-field="totalEquipment"/>
        <entity-find-count entity-name="zenith.erp.maintenance.Equipment" count-field="activeEquipment">
            <econdition field-name="statusId" value="EqActive"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.maintenance.Equipment" count-field="inMaintenance">
            <econdition field-name="statusId" value="EqInMaintenance"/></entity-find-count>
        <entity-find-count entity-name="zenith.erp.maintenance.MaintWorkOrder" count-field="openWorkOrders">
            <econdition field-name="statusId" operator="in" value="WoDraft,WoScheduled,WoInProgress,WoOnHold"/></entity-find-count>

        <set field="cutoffDate" from="new java.sql.Date(System.currentTimeMillis() + 7L * 24 * 60 * 60 * 1000)"/>
        <entity-find entity-name="zenith.erp.maintenance.MaintenancePlan" list="duePlans">
            <econdition field-name="isActive" value="Y"/>
            <econdition field-name="nextMaintenanceDate" operator="less-equals" from="cutoffDate"/>
            <econdition field-name="nextMaintenanceDate" operator="is-not-null"/>
            <order-by field-name="nextMaintenanceDate"/>
        </entity-find>

        <entity-find entity-name="zenith.erp.maintenance.WorkOrderView" list="recentWorkOrders">
            <econdition field-name="statusId" operator="in" value="WoInProgress,WoScheduled"/>
            <order-by field-name="-requestedDate"/>
            <limit count="10"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="3" md="6">
                <container-box><box-header title="Total Equipment"/>
                <box-body><label text="${totalEquipment}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Active"/>
                <box-body><label text="${activeEquipment}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="In Maintenance"/>
                <box-body><label text="${inMaintenance}" type="h3"/></box-body></container-box>
            </row-col>
            <row-col lg="3" md="6">
                <container-box><box-header title="Open Work Orders"/>
                <box-body><label text="${openWorkOrders}" type="h3"/></box-body></container-box>
            </row-col>
        </container-row>

        <container-box>
            <box-header title="Maintenance Due (Next 7 Days)"/>
            <box-body>
                <form-list name="DuePlanList" list="duePlans" skip-form="true">
                    <field name="equipmentId"><default-field title="Equipment"><display/></default-field></field>
                    <field name="planName"><default-field title="Plan"><display/></default-field></field>
                    <field name="planType"><default-field title="Type"><display/></default-field></field>
                    <field name="nextMaintenanceDate"><default-field title="Due Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="frequencyDays"><default-field title="Frequency (days)"><display/></default-field></field>
                    <field name="lastMaintenanceDate"><default-field title="Last Done"><display format="dd-MM-yyyy"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Active Work Orders"/>
            <box-body>
                <form-list name="RecentWoList" list="recentWorkOrders" skip-form="true">
                    <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                    <field name="equipmentName"><default-field title="Equipment"><display/></default-field></field>
                    <field name="workOrderType"><default-field title="Type"><display/></default-field></field>
                    <field name="priority"><default-field title="Priority"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="assignedToPartyId"><default-field title="Assigned"><display/></default-field></field>
                    <field name="scheduledDate"><default-field title="Scheduled"><display format="dd-MM-yyyy"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
