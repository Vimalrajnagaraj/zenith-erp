<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work Order Detail" default-menu-include="false">

    <parameter name="workOrderId" required="true"/>

    <transition name="updateWo" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): only update a work order your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_wa"
                          in-map="[entityName:'zenith.erp.maintenance.MaintWorkOrder', idField:'workOrderId', idValue:workOrderId, orgField:'organizationPartyId']"/>
            <if condition="!_wa.allowed"><return error="true" message="Work order not found for your account."/></if>
            <service-call name="update#zenith.erp.maintenance.MaintWorkOrder" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="startWo" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.start#WorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="completeWo" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.complete#WorkOrder"/>
        <default-response url="."/>
    </transition>
    <transition name="addTask" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): tasks may only be added to a work order your org owns. -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_wa"
                          in-map="[entityName:'zenith.erp.maintenance.MaintWorkOrder', idField:'workOrderId', idValue:workOrderId, orgField:'organizationPartyId']"/>
            <if condition="!_wa.allowed"><return error="true" message="Work order not found for your account."/></if>
            <service-call name="create#zenith.erp.maintenance.WorkOrderTask" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateTask" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_wa"
                          in-map="[entityName:'zenith.erp.maintenance.MaintWorkOrder', idField:'workOrderId', idValue:workOrderId, orgField:'organizationPartyId']"/>
            <if condition="!_wa.allowed"><return error="true" message="Work order not found for your account."/></if>
            <service-call name="update#zenith.erp.maintenance.WorkOrderTask" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="addPart" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.add#WorkOrderPart"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SB-013 (Tier 4): block rendering another org's work order + its tasks/parts. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_wa"
                      in-map="[entityName:'zenith.erp.maintenance.MaintWorkOrder', idField:'workOrderId', idValue:workOrderId, orgField:'organizationPartyId']"/>
        <if condition="!_wa.allowed"><script>ec.web.sendRedirectAndStopRender('/apps/zenith/maintenance/WorkOrders')</script></if>
        <entity-find-one entity-name="zenith.erp.maintenance.MaintWorkOrder" value-field="wo"/>
        <entity-find-one entity-name="zenith.erp.maintenance.Equipment" value-field="equip">
            <field-map field-name="equipmentId" from="wo?.equipmentId"/></entity-find-one>
        <entity-find entity-name="zenith.erp.maintenance.WorkOrderTask" list="taskList">
            <econdition field-name="workOrderId"/>
            <order-by field-name="taskSeqId"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.maintenance.WorkOrderPart" list="partList">
            <econdition field-name="workOrderId"/>
            <order-by field-name="partSeqId"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box><box-header title="${wo.workOrderNumber}"/>
                <box-body>
                    <form-single name="WoForm" transition="updateWo" map="wo">
                        <field name="workOrderId"><default-field><hidden/></default-field></field>
                        <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="workOrderType"><default-field title="Type"><display/></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down><option key="Critical"/><option key="High"/><option key="Medium"/><option key="Low"/></drop-down></default-field></field>
                        <field name="equipmentId"><default-field title="Equipment"><display text="${equip?.equipmentNumber} - ${equip?.equipmentName}"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="35"/></default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assigned To"><text-line size="15"/></default-field></field>
                        <field name="scheduledDate"><default-field title="Scheduled"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="startDate"><default-field title="Started"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="completedDate"><default-field title="Completed"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="estimatedHours"><default-field title="Est Hours"><text-line size="6"/></default-field></field>
                        <field name="remarks"><default-field title="Remarks"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="wo_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title="Save"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="mnt_WoActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <link url="startWo" text="Start Work" parameter-map="[workOrderId:workOrderId]"
                          condition="wo?.statusId=='WoDraft' || wo?.statusId=='WoScheduled'"
                          confirmation="Start this work order? Equipment will be marked In Maintenance."/>
                    <container-dialog id="CompleteDialog" button-text="Complete">
                        <form-single name="CompleteForm" transition="completeWo">
                            <field name="workOrderId"><default-field><hidden/></default-field></field>
                            <field name="actualHours"><default-field title="Actual Hours"><text-line size="6"/></default-field></field>
                            <field name="downTimeHours"><default-field title="Downtime Hours"><text-line size="6"/></default-field></field>
                            <field name="remarks"><default-field title="Completion Notes"><text-area rows="3" cols="35"/></default-field></field>
                            <field name="submitButton"><default-field title="Complete"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Tasks -->
                <container-box><box-header title="Tasks"/>
                <box-toolbar>
                    <section name="mnt_AddTask_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddTaskDialog" button-text="Add Task">
                        <form-single name="AddTaskForm" transition="addTask">
                            <field name="workOrderId"><default-field><hidden/></default-field></field>
                            <field name="taskSeqId"><default-field title="Seq"><text-line size="6"/></default-field></field>
                            <field name="taskDescription"><default-field title="Task"><text-line size="35"/></default-field></field>
                            <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                            <field name="estimatedHours"><default-field title="Est Hours"><text-line size="6"/></default-field></field>
                            <field name="statusId"><default-field><hidden default-value="Pending"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="TaskList" list="taskList" transition="updateTask">
                        <field name="workOrderId"><default-field><hidden/></default-field></field>
                        <field name="taskSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="taskDescription"><default-field title="Task"><text-line size="25"/></default-field></field>
                        <field name="estimatedHours"><default-field title="Est"><text-line size="4"/></default-field></field>
                        <field name="actualHours"><default-field title="Actual"><text-line size="4"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down><option key="Pending"/><option key="InProgress"/><option key="Completed"/></drop-down></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="task_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                            <default-field title=""><label text="" type="span"/></default-field>
                        </field>
                    </form-list>
                </box-body></container-box>

                <!-- Parts -->
                <container-box><box-header title="Parts Used"/>
                <box-toolbar>
                    <section name="mnt_AddPart_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddPartDialog" button-text="Add Part">
                        <form-single name="AddPartForm" transition="addPart">
                            <field name="workOrderId"><default-field><hidden/></default-field></field>
                            <field name="partName"><default-field title="Part Name"><text-line size="25"/></default-field></field>
                            <field name="productId"><default-field title="Product ID (optional)"><text-line size="15"/></default-field></field>
                            <field name="quantityRequired"><default-field title="Qty Required"><text-line size="6"/></default-field></field>
                            <field name="quantityUsed"><default-field title="Qty Used"><text-line size="6"/></default-field></field>
                            <field name="unitCost"><default-field title="Unit Cost (${currSymbol})"><text-line size="10"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="PartList" list="partList" skip-form="true">
                        <field name="partSeqId"><default-field title="#"><display/></default-field></field>
                        <field name="partName"><default-field title="Part"><display/></default-field></field>
                        <field name="quantityRequired"><default-field title="Req"><display/></default-field></field>
                        <field name="quantityUsed"><default-field title="Used"><display/></default-field></field>
                        <field name="unitCost"><default-field title="Unit Cost"><display format="#,##0.00"/></default-field></field>
                        <field name="totalCost"><default-field title="Total"><display format="#,##0.00"/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
