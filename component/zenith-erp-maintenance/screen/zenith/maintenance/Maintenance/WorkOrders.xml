<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work Orders" default-menu-index="3">

    <transition name="createWo" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.create#WorkOrder"/>
        <default-response url="../EditWorkOrder"/>
    </transition>
    <transition name="editWo"><default-response url="../EditWorkOrder"/></transition>

    <actions>
        <entity-find entity-name="zenith.erp.maintenance.WorkOrderView" list="woList">
            <search-form-inputs default-order-by="-requestedDate"/>
            <order-by field-name="-requestedDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Maintenance Work Orders"/>
            <box-toolbar>
                <container-dialog id="CreateWoDialog" button-text="New Work Order">
                    <form-single name="CreateWoForm" transition="createWo">
                        <field name="equipmentId"><default-field title="Equipment">
                            <drop-down><entity-options key="${equipmentId}" text="${equipmentNumber} - ${equipmentName}">
                                <entity-find entity-name="zenith.erp.maintenance.Equipment">
                                    <econdition field-name="statusId" operator="in" value="EqActive,EqInMaintenance"/>
                                    <order-by field-name="equipmentName"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="workOrderType"><default-field title="Type">
                            <drop-down><option key="Preventive"/><option key="Corrective"/><option key="Emergency"/><option key="Predictive"/></drop-down></default-field></field>
                        <field name="priority"><default-field title="Priority">
                            <drop-down no-current-selected-key="Medium">
                                <option key="Critical"/><option key="High"/><option key="Medium"/><option key="Low"/>
                            </drop-down></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                        <field name="scheduledDate"><default-field title="Scheduled"><date-time/></default-field></field>
                        <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                        <field name="estimatedHours"><default-field title="Est Hours"><text-line size="6"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-list name="WoList" list="woList" skip-form="true">
                    <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                    <field name="equipmentName"><default-field title="Equipment"><display/></default-field></field>
                    <field name="workOrderType"><default-field title="Type"><display/></default-field></field>
                    <field name="priority"><default-field title="Priority"><display/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="assignedToPartyId"><default-field title="Assigned"><display/></default-field></field>
                    <field name="scheduledDate"><default-field title="Scheduled"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="completedDate"><default-field title="Completed"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editWo" text="Detail" parameter-map="[workOrderId:workOrderId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
