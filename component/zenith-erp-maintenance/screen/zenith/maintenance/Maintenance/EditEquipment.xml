<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Equipment Detail" default-menu-include="false">

    <parameter name="equipmentId" required="true"/>

    <transition name="updateEquipment" begin-transaction="true">
        <service-call name="update#zenith.erp.maintenance.Equipment"/>
        <default-response url="."/>
    </transition>
    <transition name="logMeter" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.log#MeterReading"/>
        <default-response url="."/>
    </transition>
    <transition name="createPlan" begin-transaction="true">
        <service-call name="create#zenith.erp.maintenance.MaintenancePlan"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePlan" begin-transaction="true">
        <service-call name="update#zenith.erp.maintenance.MaintenancePlan"/>
        <default-response url="."/>
    </transition>
    <transition name="createWo" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.create#WorkOrder"/>
        <default-response url="../EditWorkOrder"/>
    </transition>

    <actions>
        <entity-find-one entity-name="zenith.erp.maintenance.Equipment" value-field="equip"/>
        <entity-find entity-name="zenith.erp.maintenance.MaintenancePlan" list="planList">
            <econdition field-name="equipmentId"/>
            <order-by field-name="planName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.maintenance.EquipmentMeterLog" list="meterList">
            <econdition field-name="equipmentId"/>
            <order-by field-name="-readingDate"/>
            <limit count="20"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.maintenance.MaintWorkOrder" list="woList">
            <econdition field-name="equipmentId"/>
            <order-by field-name="-requestedDate"/>
            <limit count="15"/>
        </entity-find>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <container-box><box-header title="${equip.equipmentNumber}: ${equip.equipmentName}"/>
                <box-body>
                    <form-single name="EquipForm" transition="updateEquipment" map="equip">
                        <field name="equipmentId"><default-field><hidden/></default-field></field>
                        <field name="equipmentNumber"><default-field title="EQ #"><display/></default-field></field>
                        <field name="equipmentName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <drop-down><entity-options key="${statusId}" text="${description}">
                                <entity-find entity-name="moqui.basic.StatusItem">
                                    <econdition field-name="statusTypeId" value="Equipment"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="make"><default-field title="Make"><text-line size="15"/></default-field></field>
                        <field name="model"><default-field title="Model"><text-line size="15"/></default-field></field>
                        <field name="serialNumber"><default-field title="Serial No"><text-line size="20"/></default-field></field>
                        <field name="criticality"><default-field title="Criticality">
                            <drop-down><option key="Critical"/><option key="High"/><option key="Medium"/><option key="Low"/></drop-down></default-field></field>
                        <field name="currentMeterReading"><default-field title="Meter Reading"><display format="#,##0"/></default-field></field>
                        <field name="meterUnit"><default-field title="Unit"><display/></default-field></field>
                        <field name="locationDetail"><default-field title="Location"><text-line size="25"/></default-field></field>
                        <field name="warrantyExpiryDate"><default-field title="Warranty Expiry"><date-time type="date"/></default-field></field>
                        <field name="description"><default-field title="Notes"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                </box-body></container-box>

                <!-- Meter Log -->
                <container-box><box-header title="Meter Readings"/>
                <box-toolbar>
                    <container-dialog id="LogMeterDialog" button-text="Log Reading">
                        <form-single name="LogMeterForm" transition="logMeter">
                            <field name="equipmentId"><default-field><hidden/></default-field></field>
                            <field name="meterReading"><default-field title="Reading"><text-line size="10"/></default-field></field>
                            <field name="readingType"><default-field title="Type">
                                <drop-down no-current-selected-key="Manual">
                                    <option key="Manual"/><option key="Automatic"/>
                                </drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Log"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body>
                    <form-list name="MeterList" list="meterList" skip-form="true">
                        <field name="readingDate"><default-field title="Date"><display format="dd-MM-yyyy HH:mm"/></default-field></field>
                        <field name="meterReading"><default-field title="Reading"><display format="#,##0"/></default-field></field>
                        <field name="readingType"><default-field title="Type"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Maintenance Plans -->
                <container-box><box-header title="Maintenance Plans"/>
                <box-toolbar>
                    <container-dialog id="CreatePlanDialog" button-text="Add Plan">
                        <form-single name="CreatePlanForm" transition="createPlan">
                            <field name="equipmentId"><default-field><hidden/></default-field></field>
                            <field name="planName"><default-field title="Plan Name"><text-line size="25"/></default-field></field>
                            <field name="planType"><default-field title="Type">
                                <drop-down><option key="Preventive"/><option key="Predictive"/><option key="Condition-Based"/></drop-down></default-field></field>
                            <field name="frequencyDays"><default-field title="Frequency (days)"><text-line size="6"/></default-field></field>
                            <field name="frequencyMeterReading"><default-field title="Frequency (meter)"><text-line size="8"/></default-field></field>
                            <field name="nextMaintenanceDate"><default-field title="Next Due Date"><date-time type="date"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="2" cols="35"/></default-field></field>
                            <field name="isActive"><default-field title="Active">
                                <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body>
                    <form-list name="PlanList" list="planList" transition="updatePlan">
                        <field name="planId"><default-field title="ID"><display/></default-field></field>
                        <field name="planName"><default-field title="Plan"><text-line size="18"/></default-field></field>
                        <field name="planType"><default-field title="Type"><display/></default-field></field>
                        <field name="frequencyDays"><default-field title="Days"><text-line size="4"/></default-field></field>
                        <field name="lastMaintenanceDate"><default-field title="Last Done"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="nextMaintenanceDate"><default-field title="Next Due"><date-time type="date"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    </form-list>
                </box-body></container-box>

                <!-- Create Work Order -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <container-dialog id="CreateWoDialog" button-text="Create Work Order">
                        <form-single name="CreateWoForm" transition="createWo">
                            <field name="equipmentId"><default-field><hidden/></default-field></field>
                            <field name="workOrderType"><default-field title="Type">
                                <drop-down><option key="Preventive"/><option key="Corrective"/><option key="Emergency"/><option key="Predictive"/></drop-down></default-field></field>
                            <field name="priority"><default-field title="Priority">
                                <drop-down no-current-selected-key="Medium">
                                    <option key="Critical"/><option key="High"/><option key="Medium"/><option key="Low"/>
                                </drop-down></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="3" cols="40"/></default-field></field>
                            <field name="scheduledDate"><default-field title="Scheduled"><date-time/></default-field></field>
                            <field name="assignedToPartyId"><default-field title="Assign To"><text-line size="15"/></default-field></field>
                            <field name="estimatedHours"><default-field title="Est Hours"><text-line size="6"/></default-field></field>
                            <field name="planId"><default-field title="Link to Plan">
                                <drop-down allow-empty="true"><entity-options key="${planId}" text="${planName}">
                                    <entity-find entity-name="zenith.erp.maintenance.MaintenancePlan">
                                        <econdition field-name="equipmentId"/>
                                        <econdition field-name="isActive" value="Y"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-body></container-box>

                <!-- Work Order History -->
                <container-box><box-header title="Work Order History"/>
                <box-body>
                    <form-list name="WoList" list="woList" skip-form="true">
                        <field name="workOrderNumber"><default-field title="WO #"><display/></default-field></field>
                        <field name="workOrderType"><default-field title="Type"><display/></default-field></field>
                        <field name="priority"><default-field title="Priority"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="requestedDate"><default-field title="Requested"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="completedDate"><default-field title="Completed"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="editBtn"><default-field title="">
                            <link url="../EditWorkOrder" text="Detail" parameter-map="[workOrderId:workOrderId]"/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
