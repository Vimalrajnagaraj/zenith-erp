<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Plans" default-menu-index="4">

    <transition name="createPlan" begin-transaction="true">
        <service-call name="create#zenith.erp.maintenance.MaintenancePlan"/>
        <default-response url="."/>
    </transition>
    <transition name="updatePlan" begin-transaction="true">
        <service-call name="update#zenith.erp.maintenance.MaintenancePlan"/>
        <default-response url="."/>
    </transition>
    <transition name="checkDue" begin-transaction="true">
        <service-call name="zenith.maintenance.MaintenanceServices.check#MaintenanceDue" out-map="context"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.maintenance.MaintenancePlan" list="planList">
            <order-by field-name="nextMaintenanceDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Maintenance Plans"/>
            <box-toolbar>
                <section name="mnt_CreatePlan_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreatePlanDialog" button-text="New Plan">
                    <form-single name="CreatePlanForm" transition="createPlan">
                        <field name="planId"><default-field title="Plan ID"><text-line size="15"/></default-field></field>
                        <field name="equipmentId"><default-field title="Equipment">
                            <drop-down><entity-options key="${equipmentId}" text="${equipmentNumber} - ${equipmentName}">
                                <entity-find entity-name="zenith.erp.maintenance.Equipment">
                                    <econdition field-name="statusId" value="EqActive"/>
                                    <order-by field-name="equipmentName"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="planName"><default-field title="Plan Name"><text-line size="25"/></default-field></field>
                        <field name="planType"><default-field title="Type">
                            <drop-down><option key="Preventive"/><option key="Predictive"/><option key="Condition-Based"/></drop-down></default-field></field>
                        <field name="frequencyDays"><default-field title="Frequency (days)"><text-line size="6"/></default-field></field>
                        <field name="frequencyMeterReading"><default-field title="Frequency (meter units)"><text-line size="8"/></default-field></field>
                        <field name="nextMaintenanceDate"><default-field title="Next Due"><date-time type="date"/></default-field></field>
                        <field name="nextMeterReading"><default-field title="Next Meter Due"><text-line size="8"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
                <link url="checkDue" text="Check Due Maintenance" confirmation="Scan all plans for due maintenance?"/>
            </box-toolbar>
            <box-body>
                <form-list name="PlanList" list="planList" transition="updatePlan">
                    <field name="planId"><default-field title="ID"><display/></default-field></field>
                    <field name="equipmentId"><default-field title="Equipment"><display/></default-field></field>
                    <field name="planName"><default-field title="Plan"><text-line size="18"/></default-field></field>
                    <field name="planType"><default-field title="Type"><display/></default-field></field>
                    <field name="frequencyDays"><default-field title="Days"><text-line size="4"/></default-field></field>
                    <field name="frequencyMeterReading"><default-field title="Meter"><text-line size="6"/></default-field></field>
                    <field name="lastMaintenanceDate"><default-field title="Last Done"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="nextMaintenanceDate"><default-field title="Next Due"><date-time type="date"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="plan_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
