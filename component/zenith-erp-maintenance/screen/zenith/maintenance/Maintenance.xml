<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Maintenance" default-menu-include="true">
    
    <subscreens default-item="MaintenanceDashboard"/>

    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>
    <transition name="goManufacturing"><default-response url="../manufacturing/WorkOrders"/></transition>
    <transition name="goFleet"><default-response url="../fleet/FleetDashboard"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_inventory_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('inventory'))"><widgets><link url="goInventory" text="Inventory" icon="fa fa-cubes" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_manufacturing_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('manufacturing'))"><widgets><link url="goManufacturing" text="Manufacturing" icon="fa fa-cogs" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_fleet_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('fleet'))"><widgets><link url="goFleet" text="Fleet" icon="fa fa-truck" btn-type="warning" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
