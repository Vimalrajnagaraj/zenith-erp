<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Report Detail" default-menu-include="false">

    <parameter name="reportId" required="true"/>

    <!-- ZE-INV-IV-035 f/u: block forged cross-tenant writes on every mutating transition (guard on the
         new organizationPartyId column; ADMIN exempt). -->
    <transition name="updateReport" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="update#zenith.erp.expenses.ExpenseReport" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="addItem" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.expenses.ExpenseServices.add#ExpenseItem" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="submitReport" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.expenses.ExpenseServices.submit#ExpenseReport"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="approveReport" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.expenses.ExpenseServices.approve#ExpenseReport" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="rejectReport" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.expenses.ExpenseServices.reject#ExpenseReport"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="markPaid" begin-transaction="true">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
            <if condition="!_acc.allowed"><return error="true" message="You do not have access to this record."/></if>
            <service-call name="zenith.expenses.ExpenseServices.markPaid#ExpenseReport"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-INV-IV-035 f/u: cross-tenant IDOR render guard on the new organizationPartyId column.
             Load NOTHING when blocked; widgets show a plain no-access panel. -->
        <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" in-map="[entityName:'zenith.erp.expenses.ExpenseReport', idField:'reportId', idValue:reportId, orgField:'organizationPartyId']" out-map="_acc"/>
        <set field="noAccess" from="!_acc.allowed"/>
        <if condition="_acc.allowed">
        <entity-find-one entity-name="zenith.erp.expenses.ExpenseReport" value-field="report"/>
        <entity-find entity-name="zenith.erp.expenses.ExpenseItem" list="itemList">
            <econdition field-name="reportId"/>
            <order-by field-name="expenseDate"/>
        </entity-find>
        </if>
    </actions>

    <widgets>
        <!-- ZE-INV-IV-035 f/u: cross-tenant / missing report — plain notice, never another org's data -->
        <section name="NoAccess">
            <condition><expression>noAccess</expression></condition>
            <widgets>
                <container-box><box-body>
                    <label text="That expense report isn't part of your account." type="h5" style="text-grey-8"/>
                    <label text="It may belong to another organization, or it may not exist." type="p" style="text-grey-6"/>
                </box-body></container-box>
            </widgets>
        </section>

        <section name="TheRecord">
        <condition><expression>!noAccess</expression></condition>
        <widgets>
        <container-row>
            <row-col lg="5" md="12">
                <!-- Report Header -->
                <container-box><box-header title="${report?.reportNumber}: ${report?.reportTitle}"/>
                <box-body>
                    <form-single name="ReportForm" transition="updateReport" map="report">
                        <field name="reportId"><default-field><hidden/></default-field></field>
                        <field name="reportNumber"><default-field title="Report #"><display/></default-field></field>
                        <field name="reportTitle"><default-field title="Title"><text-line size="25"/></default-field></field>
                        <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                        <field name="reportDate"><default-field title="Report Date"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="periodFrom"><default-field title="Period From"><date-time type="date"/></default-field></field>
                        <field name="periodTo"><default-field title="Period To"><date-time type="date"/></default-field></field>
                        <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                        <field name="totalGstAmount"><default-field title="GST Amount"><display format="#,##,##0.00"/></default-field></field>
                        <field name="approvedAmount"><default-field title="Approved Amount"><display format="#,##,##0.00"/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                        <field name="submittedDate"><default-field title="Submitted"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="approvedDate"><default-field title="Approved"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="paidDate"><default-field title="Paid"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="rejectionReason"><default-field title="Rejection Reason"><display/></default-field></field>
                        <field name="notes"><default-field title="Notes"><text-area rows="2" cols="30"/></default-field></field>
                        <field name="submitButton">
                            <conditional-field name="rpt_save_write" condition="modCanWrite" title="Update"><submit/></conditional-field>
                            <default-field title="Update"><label text="You have view-only access — changes are disabled." type="span" style="text-grey-7"/></default-field>
                        </field>
                    </form-single>
                </box-body></container-box>

                <!-- Actions -->
                <container-box><box-header title="Actions"/>
                <box-body>
                    <section name="exp_ReportActions_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="SubmitDialog" button-text="Submit for Approval">
                        <form-single name="SubmitForm" transition="submitReport">
                            <field name="reportId"><default-field><hidden/></default-field></field>
                            <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ApproveDialog" button-text="Approve">
                        <form-single name="ApproveForm" transition="approveReport">
                            <field name="reportId"><default-field><hidden/></default-field></field>
                            <field name="approvedAmount"><default-field title="Approved Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                            <field name="notes"><default-field title="Comments"><text-area rows="2" cols="35"/></default-field></field>
                            <field name="submitButton"><default-field title="Approve"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="RejectDialog" button-text="Reject">
                        <form-single name="RejectForm" transition="rejectReport">
                            <field name="reportId"><default-field><hidden/></default-field></field>
                            <field name="rejectionReason"><default-field title="Reason"><text-area rows="3" cols="35"/></default-field></field>
                            <field name="submitButton"><default-field title="Reject"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="PaidDialog" button-text="Mark Paid">
                        <form-single name="PaidForm" transition="markPaid">
                            <field name="reportId"><default-field><hidden/></default-field></field>
                            <field name="submitButton"><default-field title="Mark Paid"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-body></container-box>
            </row-col>

            <row-col lg="7" md="12">
                <!-- Add Expense Item -->
                <container-box><box-header title="Expense Items"/>
                <box-toolbar>
                    <section name="exp_AddItem_write"><condition><expression>modCanWrite</expression></condition><widgets>
                    <container-dialog id="AddItemDialog" button-text="Add Expense">
                        <form-single name="AddItemForm" transition="addItem">
                            <field name="reportId"><default-field><hidden/></default-field></field>
                            <field name="categoryId"><default-field title="Category">
                                <drop-down><entity-options key="${categoryId}" text="${categoryName}">
                                    <entity-find entity-name="zenith.erp.expenses.ExpenseCategory">
                                        <econdition field-name="isActive" value="Y"/>
                                        <!-- ZE-SB-013 (Tier 4): own categories + global shared seeds. -->
                                        <econditions combine="or">
                                            <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                                            <econdition field-name="organizationPartyId" operator="is-null"/>
                                        </econditions>
                                        <order-by field-name="categoryName"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="expenseDate"><default-field title="Date"><date-time type="date"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                            <field name="vendorName"><default-field title="Vendor"><text-line size="25"/></default-field></field>
                            <field name="vendorGstin"><default-field title="Vendor GSTIN"><text-line size="18"/></default-field></field>
                            <field name="invoiceNumber"><default-field title="Invoice #"><text-line size="15"/></default-field></field>
                            <field name="amount"><default-field title="Amount (excl GST)"><text-line size="10"/></default-field></field>
                            <field name="gstAmount"><default-field title="GST Amount"><text-line size="10"/></default-field></field>
                            <field name="paymentMode"><default-field title="Payment Mode">
                                <drop-down no-current-selected-key="ExpPay_CASH"><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="ExpPaymentMode"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="hsnSacCode"><default-field title="HSN/SAC"><text-line size="10"/></default-field></field>
                            <field name="gstEligibleForItc"><default-field title="ITC Eligible">
                                <drop-down no-current-selected-key="N"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                            <field name="cityTier"><default-field title="City Tier">
                                <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration">
                                        <econdition field-name="enumTypeId" value="CityTier"/>
                                    </entity-find></entity-options></drop-down></default-field></field>
                            <field name="notes"><default-field title="Notes"><text-line size="25"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    </widgets></section>
                </box-toolbar>
                <box-body>
                    <form-list name="ItemList" list="itemList" skip-form="true">
                        <field name="expenseDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                        <field name="categoryId"><default-field title="Category">
                            <display-entity entity-name="zenith.erp.expenses.ExpenseCategory"
                                            key-field-name="categoryId" text="${categoryName}"/></default-field></field>
                        <field name="description"><default-field title="Description"><display/></default-field></field>
                        <field name="vendorName"><default-field title="Vendor"><display/></default-field></field>
                        <field name="amount"><default-field title="Amount"><display format="#,##,##0.00"/></default-field></field>
                        <field name="gstAmount"><default-field title="GST"><display format="#,##,##0.00"/></default-field></field>
                        <field name="totalAmount"><default-field title="Total"><display format="#,##,##0.00"/></default-field></field>
                        <field name="paymentMode"><default-field title="Mode">
                            <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                        <field name="gstEligibleForItc"><default-field title="ITC"><display/></default-field></field>
                    </form-list>
                </box-body></container-box>
            </row-col>
        </container-row>
        </widgets>
        </section>
    </widgets>
</screen>
