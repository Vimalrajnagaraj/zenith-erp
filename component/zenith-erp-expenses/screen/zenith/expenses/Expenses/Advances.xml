<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Advances" default-menu-index="4">

    <transition name="createAdvance" begin-transaction="true">
        <service-call name="zenith.expenses.ExpenseServices.create#ExpenseAdvance"/>
        <default-response url="."/>
    </transition>
    <transition name="updateAdvance" begin-transaction="true">
        <service-call name="update#zenith.erp.expenses.ExpenseAdvance"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.expenses.ExpenseAdvance" list="advList">
            <order-by field-name="-requestDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Expense Advances"/>
            <box-toolbar>
                <section name="exp_CreateAdv_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateAdvDialog" button-text="Request Advance">
                    <form-single name="CreateAdvForm" transition="createAdvance">
                        <field name="amount"><default-field title="Amount (${currSymbol})"><text-line size="12"/></default-field></field>
                        <field name="purpose"><default-field title="Purpose"><text-line size="30"/></default-field></field>
                        <field name="notes"><default-field title="Notes"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Request"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="AdvList" list="advList" transition="updateAdvance">
                    <field name="advanceId"><default-field><hidden/></default-field></field>
                    <field name="advanceNumber"><default-field title="Adv #"><display/></default-field></field>
                    <field name="employeePartyId"><default-field title="Employee"><display/></default-field></field>
                    <field name="amount"><default-field title="Amount (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="purpose"><default-field title="Purpose"><display/></default-field></field>
                    <field name="requestDate"><default-field title="Requested"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="paidDate"><default-field title="Paid"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down><entity-options key="${statusId}" text="${description}">
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="ExpenseAdvance"/>
                            </entity-find></entity-options></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="adv_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
