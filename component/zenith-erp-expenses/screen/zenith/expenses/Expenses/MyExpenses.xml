<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Expenses" default-menu-index="1">

    <transition name="createReport" begin-transaction="true">
        <service-call name="zenith.expenses.ExpenseServices.create#ExpenseReport"/>
        <default-response url="../EditReport"/>
    </transition>
    <transition name="editReport"><default-response url="../EditReport"/></transition>

    <actions>
        <set field="currentPartyId" from="ec.user.userAccount?.partyId"/>
        <entity-find entity-name="zenith.erp.expenses.ExpenseReport" list="reportList">
            <econdition field-name="employeePartyId" from="currentPartyId"/>
            <order-by field-name="-reportDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="My Expense Reports"/>
            <box-toolbar>
                <section name="exp_MyExpToolbar_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateReportDialog" button-text="New Expense Report">
                    <form-single name="CreateReportForm" transition="createReport">
                        <field name="reportTitle"><default-field title="Title"><text-line size="30"/></default-field></field>
                        <field name="periodFrom"><default-field title="Period From"><date-time type="date"/></default-field></field>
                        <field name="periodTo"><default-field title="Period To"><date-time type="date"/></default-field></field>
                        <field name="notes"><default-field title="Notes"><text-area rows="2" cols="35"/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <link url="." text="Upload Receipt via AI (OCR)" icon="glyphicon glyphicon-camera" class="btn btn-success" tooltip="Auto-extract amounts and vendor using Google DocumentAI"/>
                <link url="." text="Submit for Manager Approval" icon="glyphicon glyphicon-check" class="btn btn-primary" tooltip="Route drafted expense reports to manager"/>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="ReportList" list="reportList" skip-form="true">
                    <field name="reportNumber"><default-field title="Report #"><display/></default-field></field>
                    <field name="reportTitle"><default-field title="Title"><display/></default-field></field>
                    <field name="totalAmount"><default-field title="Total (${currSymbol})"><display format="#,##,##0.00"/></default-field></field>
                    <field name="approvedAmount"><default-field title="Approved"><display format="#,##,##0.00"/></default-field></field>
                    <field name="reportDate"><default-field title="Date"><display format="dd-MM-yyyy"/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <display-entity entity-name="moqui.basic.StatusItem"/></default-field></field>
                    <field name="editBtn"><default-field title="">
                        <link url="editReport" text="Detail" parameter-map="[reportId:reportId]"/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
