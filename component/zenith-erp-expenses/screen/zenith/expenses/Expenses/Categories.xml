<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Categories" default-menu-index="3">

    <transition name="createCategory" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4, global+private): a tenant-created category is private; a no-org admin authors a global one. -->
            <set field="_ao" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
            <if condition="_ao == '_NA_'"><set field="_ao" from="null"/></if>
            <service-call name="create#zenith.erp.expenses.ExpenseCategory" in-map="context + [organizationPartyId:_ao]"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="updateCategory" begin-transaction="true">
        <actions>
            <!-- ZE-SB-013 (Tier 4): edit only your own category (global seeds are read-only to tenants). -->
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'zenith.erp.expenses.ExpenseCategory', idField:'categoryId', idValue:categoryId, orgField:'organizationPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="Category not found for your account."/></if>
            <service-call name="update#zenith.erp.expenses.ExpenseCategory" in-map="context"/>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.expenses.ExpenseCategory" list="catList">
            <!-- ZE-SB-013 (Tier 4): this org's categories + global shared seeds. -->
            <econditions combine="or">
                <econdition field-name="organizationPartyId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')" ignore-if-empty="true"/>
                <econdition field-name="organizationPartyId" operator="is-null"/>
            </econditions>
            <order-by field-name="categoryName"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Expense Categories"/>
            <box-toolbar>
                <section name="exp_CreateCat_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateCatDialog" button-text="New Category">
                    <form-single name="CreateCatForm" transition="createCategory">
                        <field name="categoryId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="categoryName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                        <field name="maxAmountPerClaim"><default-field title="Max per Claim (${currSymbol})"><text-line size="10"/></default-field></field>
                        <field name="requiresReceipt"><default-field title="Receipt Required">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="gstApplicable"><default-field title="GST Applicable">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="defaultGstRate"><default-field title="Default GST %"><text-line size="5"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="CatList" list="catList" transition="updateCategory">
                    <field name="categoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="categoryName"><default-field title="Name"><text-line size="15"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="20"/></default-field></field>
                    <field name="maxAmountPerClaim"><default-field title="Max/Claim"><text-line size="8"/></default-field></field>
                    <field name="requiresReceipt"><default-field title="Receipt">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="gstApplicable"><default-field title="GST">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="defaultGstRate"><default-field title="GST%"><text-line size="4"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="cat_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
