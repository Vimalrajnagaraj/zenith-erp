<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Per Diem Rules" default-menu-index="5">

    <transition name="createRule" begin-transaction="true">
        <service-call name="create#zenith.erp.expenses.PerDiemRule"/>
        <default-response url="."/>
    </transition>
    <transition name="updateRule" begin-transaction="true">
        <service-call name="update#zenith.erp.expenses.PerDiemRule"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.expenses.PerDiemRule" list="ruleList">
            <order-by field-name="cityTier,employeeGrade"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box>
            <box-header title="Per Diem / Travel Allowance Rules"/>
            <box-toolbar>
                <section name="exp_CreateRule_write"><condition><expression>modCanWrite</expression></condition><widgets>
                <container-dialog id="CreateRuleDialog" button-text="New Rule">
                    <form-single name="CreateRuleForm" transition="createRule">
                        <field name="ruleId"><default-field title="ID"><text-line size="15"/></default-field></field>
                        <field name="ruleName"><default-field title="Name"><text-line size="25"/></default-field></field>
                        <field name="cityTier"><default-field title="City Tier">
                            <drop-down><entity-options key="${enumId}" text="${description}">
                                <entity-find entity-name="moqui.basic.Enumeration">
                                    <econdition field-name="enumTypeId" value="CityTier"/>
                                </entity-find></entity-options></drop-down></default-field></field>
                        <field name="employeeGrade"><default-field title="Employee Grade"><text-line size="10"/></default-field></field>
                        <field name="dailyAllowance"><default-field title="Daily Allowance (${currSymbol})"><text-line size="8"/></default-field></field>
                        <field name="hotelLimit"><default-field title="Hotel Limit"><text-line size="8"/></default-field></field>
                        <field name="mealLimit"><default-field title="Meal Limit"><text-line size="8"/></default-field></field>
                        <field name="localConveyanceLimit"><default-field title="Conveyance Limit"><text-line size="8"/></default-field></field>
                        <field name="isActive"><default-field title="Active">
                            <drop-down no-current-selected-key="Y"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                </widgets></section>
            </box-toolbar>
            <box-body>
                <form-list name="RuleList" list="ruleList" transition="updateRule">
                    <field name="ruleId"><default-field title="ID"><display/></default-field></field>
                    <field name="ruleName"><default-field title="Name"><text-line size="12"/></default-field></field>
                    <field name="cityTier"><default-field title="Tier">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId"/></default-field></field>
                    <field name="employeeGrade"><default-field title="Grade"><text-line size="6"/></default-field></field>
                    <field name="dailyAllowance"><default-field title="Daily"><text-line size="6"/></default-field></field>
                    <field name="hotelLimit"><default-field title="Hotel"><text-line size="6"/></default-field></field>
                    <field name="mealLimit"><default-field title="Meal"><text-line size="6"/></default-field></field>
                    <field name="localConveyanceLimit"><default-field title="Convey"><text-line size="6"/></default-field></field>
                    <field name="isActive"><default-field title="Active">
                        <drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                    <field name="submitButton">
                        <conditional-field name="rule_save_write" condition="modCanWrite" title="Save"><submit/></conditional-field>
                        <default-field title=""><label text="" type="span"/></default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
