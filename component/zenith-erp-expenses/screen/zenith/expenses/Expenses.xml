<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Expenses" default-menu-include="true">
    
    <subscreens default-item="MyExpenses"/>

    <transition name="goAccounting"><default-response url="../Accounting/AcctgDashboard"/></transition>
    <transition name="goHr"><default-response url="../Hr/Employees"/></transition>
    <transition name="goPayroll"><default-response url="../payroll/PayrollRuns"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_accounting_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('accounting'))"><widgets><link url="goAccounting" text="Accounting" icon="fa fa-calculator" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_hr_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('hr'))"><widgets><link url="goHr" text="HR" icon="fa fa-users" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_payroll_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('payroll'))"><widgets><link url="goPayroll" text="Payroll" icon="fa fa-money" btn-type="success" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
