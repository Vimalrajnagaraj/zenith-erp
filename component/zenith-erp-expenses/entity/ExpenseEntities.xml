<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- Expense Category -->
    <entity entity-name="ExpenseCategory" package="zenith.erp.expenses" short-alias="ExpenseCategories">
        <field name="categoryId" type="id" is-pk="true"/>
        <field name="categoryName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="parentCategoryId" type="id"/>
        <field name="glAccountId" type="id"/>
        <field name="maxAmountPerClaim" type="currency-precise"/>
        <field name="requiresReceipt" type="text-indicator" default="'Y'"/>
        <field name="gstApplicable" type="text-indicator" default="'Y'"/>
        <field name="defaultGstRate" type="number-decimal"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="ExpPaymentMode" description="Expense Payment Mode"/>
            <moqui.basic.Enumeration enumId="ExpPay_CASH" enumTypeId="ExpPaymentMode" description="Cash" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="ExpPay_CARD" enumTypeId="ExpPaymentMode" description="Credit/Debit Card" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="ExpPay_UPI" enumTypeId="ExpPaymentMode" description="UPI" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="ExpPay_BANK" enumTypeId="ExpPaymentMode" description="Bank Transfer" sequenceNum="4"/>
            <moqui.basic.Enumeration enumId="ExpPay_COMPANY" enumTypeId="ExpPaymentMode" description="Company Card" sequenceNum="5"/>
            <moqui.basic.Enumeration enumId="ExpPay_WALLET" enumTypeId="ExpPaymentMode" description="Digital Wallet" sequenceNum="6"/>
        </seed-data>
    </entity>

    <!-- Expense Report (claim header) -->
    <entity entity-name="ExpenseReport" package="zenith.erp.expenses" short-alias="ExpenseReports">
        <field name="reportId" type="id" is-pk="true"/>
        <field name="reportNumber" type="text-short"/>
        <field name="employeePartyId" type="id"/>
        <!-- ZE-INV-IV-035 f/u: explicit tenant-owner column (was absent — the report's org had to be derived
             via the employee, which blocked a generic org guard). Stamped = active org at create. -->
        <field name="organizationPartyId" type="id"/>
        <field name="reportTitle" type="text-medium"/>
        <field name="reportDate" type="date-time"/>
        <field name="periodFrom" type="date-time"/>
        <field name="periodTo" type="date-time"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="approvedAmount" type="currency-precise"/>
        <field name="totalGstAmount" type="currency-precise"/>
        <field name="statusId" type="id"/>
        <field name="submittedDate" type="date-time"/>
        <field name="approvedDate" type="date-time"/>
        <field name="approvedByPartyId" type="id"/>
        <field name="paidDate" type="date-time"/>
        <field name="rejectionReason" type="text-long"/>
        <field name="notes" type="text-long"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" title="ExpenseReport" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="ExpenseReport" description="Expense Report"/>
            <moqui.basic.StatusItem statusId="ExDraft" statusTypeId="ExpenseReport" description="Draft" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="ExSubmitted" statusTypeId="ExpenseReport" description="Submitted" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="ExUnderReview" statusTypeId="ExpenseReport" description="Under Review" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="ExApproved" statusTypeId="ExpenseReport" description="Approved" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="ExRejected" statusTypeId="ExpenseReport" description="Rejected" sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="ExPartialApprove" statusTypeId="ExpenseReport" description="Partially Approved" sequenceNum="6"/>
            <moqui.basic.StatusItem statusId="ExPaid" statusTypeId="ExpenseReport" description="Paid" sequenceNum="7"/>
            <moqui.basic.StatusItem statusId="ExCancelled" statusTypeId="ExpenseReport" description="Cancelled" sequenceNum="8"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExDraft" toStatusId="ExSubmitted" transitionName="Submit"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExSubmitted" toStatusId="ExUnderReview" transitionName="Review"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExUnderReview" toStatusId="ExApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExUnderReview" toStatusId="ExPartialApprove" transitionName="Partial Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExUnderReview" toStatusId="ExRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExApproved" toStatusId="ExPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExPartialApprove" toStatusId="ExPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExDraft" toStatusId="ExCancelled" transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ExRejected" toStatusId="ExDraft" transitionName="Revise"/>
        </seed-data>
    </entity>

    <!-- Expense Line Item -->
    <entity entity-name="ExpenseItem" package="zenith.erp.expenses" short-alias="ExpenseItems">
        <field name="expenseItemId" type="id" is-pk="true"/>
        <field name="reportId" type="id"/>
        <field name="categoryId" type="id"/>
        <field name="expenseDate" type="date-time"/>
        <field name="description" type="text-medium"/>
        <field name="vendorName" type="text-medium"/>
        <field name="vendorGstin" type="text-short"/>
        <field name="invoiceNumber" type="text-short"/>
        <field name="amount" type="currency-precise"/>
        <field name="gstAmount" type="currency-precise"/>
        <field name="totalAmount" type="currency-precise"/>
        <field name="approvedAmount" type="currency-precise"/>
        <field name="paymentMode" type="id"/>
        <field name="receiptFileName" type="text-medium"/>
        <field name="receiptFilePath" type="text-long"/>
        <field name="hsnSacCode" type="text-short"/>
        <field name="gstEligibleForItc" type="text-indicator" default="'N'"/>
        <field name="cityTier" type="id"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" related="zenith.erp.expenses.ExpenseReport">
            <key-map field-name="reportId"/></relationship>
        <relationship type="one" related="zenith.erp.expenses.ExpenseCategory">
            <key-map field-name="categoryId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="CityTier" description="City Tier (Per Diem)"/>
            <moqui.basic.Enumeration enumId="CityTier_X" enumTypeId="CityTier" description="X-Class (Metro: Delhi, Mumbai, Kolkata, Chennai, Bengaluru, Hyderabad)" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="CityTier_A" enumTypeId="CityTier" description="A-Class (Pune, Ahmedabad, Jaipur, Lucknow, etc.)" sequenceNum="2"/>
            <moqui.basic.Enumeration enumId="CityTier_B" enumTypeId="CityTier" description="B-Class (Other state capitals, tier-2 cities)" sequenceNum="3"/>
            <moqui.basic.Enumeration enumId="CityTier_C" enumTypeId="CityTier" description="C-Class (All other locations)" sequenceNum="4"/>
        </seed-data>
    </entity>

    <!-- Per Diem / Allowance Rules -->
    <entity entity-name="PerDiemRule" package="zenith.erp.expenses" short-alias="PerDiemRules">
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="ruleName" type="text-medium"/>
        <field name="cityTier" type="id"/>
        <field name="employeeGrade" type="text-short"/>
        <field name="dailyAllowance" type="currency-precise"/>
        <field name="hotelLimit" type="currency-precise"/>
        <field name="mealLimit" type="currency-precise"/>
        <field name="localConveyanceLimit" type="currency-precise"/>
        <field name="effectiveFrom" type="date-time"/>
        <field name="effectiveThru" type="date-time"/>
        <field name="isActive" type="text-indicator" default="'Y'"/>
    </entity>

    <!-- Expense Advance (prepaid advance to employee) -->
    <entity entity-name="ExpenseAdvance" package="zenith.erp.expenses" short-alias="ExpenseAdvances">
        <field name="advanceId" type="id" is-pk="true"/>
        <field name="advanceNumber" type="text-short"/>
        <field name="employeePartyId" type="id"/>
        <field name="amount" type="currency-precise"/>
        <field name="purpose" type="text-medium"/>
        <field name="requestDate" type="date-time"/>
        <field name="approvedDate" type="date-time"/>
        <field name="paidDate" type="date-time"/>
        <field name="settledDate" type="date-time"/>
        <field name="linkedReportId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" title="ExpenseAdvance" related="moqui.basic.StatusItem"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="ExpenseAdvance" description="Expense Advance"/>
            <moqui.basic.StatusItem statusId="EaRequested" statusTypeId="ExpenseAdvance" description="Requested" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="EaApproved" statusTypeId="ExpenseAdvance" description="Approved" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="EaPaid" statusTypeId="ExpenseAdvance" description="Paid" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="EaSettled" statusTypeId="ExpenseAdvance" description="Settled" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="EaRejected" statusTypeId="ExpenseAdvance" description="Rejected" sequenceNum="5"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaRequested" toStatusId="EaApproved" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaRequested" toStatusId="EaRejected" transitionName="Reject"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaApproved" toStatusId="EaPaid" transitionName="Mark Paid"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaPaid" toStatusId="EaSettled" transitionName="Settle"/>
        </seed-data>
    </entity>

    <!-- View: Expense Report with item totals -->
    <view-entity entity-name="ExpenseReportView" package="zenith.erp.expenses">
        <member-entity entity-alias="ER" entity-name="zenith.erp.expenses.ExpenseReport"/>
        <alias-all entity-alias="ER"/>
    </view-entity>
</entities>
