<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Field Service" default-menu-index="8">

    <always-actions>
        <set field="html_title" value="Field Service"/>
    </always-actions>

    <subscreens default-item="Tasks"/>

    <transition name="goContacts"><default-response url="../Contacts/Customers"/></transition>
    <transition name="goHelpdesk"><default-response url="../helpdesk/Tickets"/></transition>
    <transition name="goMaintenance"><default-response url="../maintenance/MaintenanceDashboard"/></transition>
    <transition name="goInventory"><default-response url="../Inventory/FindProduct"/></transition>

    <widgets>
        <container style="row items-center justify-end q-px-md q-pt-md q-gutter-sm">
            <section name="gate_contacts_1" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('contacts'))"><widgets><link url="goContacts" text="Customers" icon="fa fa-users" btn-type="primary" style="q-btn--dense"/></widgets></section>
            <section name="gate_helpdesk_2" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('helpdesk'))"><widgets><link url="goHelpdesk" text="Helpdesk" icon="fa fa-life-ring" btn-type="info" style="q-btn--dense"/></widgets></section>
            <section name="gate_maintenance_3" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('maintenance'))"><widgets><link url="goMaintenance" text="Maintenance" icon="fa fa-wrench" btn-type="warning" style="q-btn--dense"/></widgets></section>
            <section name="gate_inventory_4" condition="saasHasAllAccess == true || isSaasTenant != true || (saasAllowedModules != null &amp;&amp; saasAllowedModules.contains('inventory'))"><widgets><link url="goInventory" text="Inventory" icon="fa fa-cubes" btn-type="success" style="q-btn--dense"/></widgets></section>
        </container>
        <subscreens-active/>
    </widgets>
</screen>
