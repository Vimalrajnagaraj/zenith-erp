<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Customer Equipment" default-menu-index="2">

    <transition name="createEquipment">
        <service-call name="create#zenith.erp.fieldservice.FieldEquipment"/>
        <default-response url="."/>
    </transition>

    <transition name="updateEquipment">
        <service-call name="update#zenith.erp.fieldservice.FieldEquipment"/>
        <default-response url="."/>
    </transition>

    <actions>
        <entity-find entity-name="zenith.erp.fieldservice.FieldEquipment" list="equipmentList">
            <search-form-inputs default-order-by="-installationDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Customer Equipment Database"/><box-toolbar>
            <container-dialog id="NewEquipmentDialog" button-text="Register Equipment">
                <form-single name="NewEquipmentForm" transition="createEquipment">
                    <field name="serialNumber"><default-field title="Serial Number"><text-line size="20"/></default-field></field>
                    <field name="modelName"><default-field title="Model Name"><text-line size="40"/></default-field></field>
                    <field name="customerPartyId"><default-field title="Customer (Party ID)"><text-line size="15"/></default-field></field>
                    <field name="installationDate"><default-field title="Installation Date"><date-time type="date"/></default-field></field>
                    <field name="warrantyExpiration"><default-field title="Warranty Expiration"><date-time type="date"/></default-field></field>
                    <field name="notes"><default-field title="Notes"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Register"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-toolbar><box-body>
            <form-list name="EquipmentListForm" list="equipmentList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="equipmentId"><default-field><hidden/></default-field></field>
                <field name="serialNumber">
                    <header-field title="Serial #" show-order-by="true"><text-find size="15" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="modelName">
                    <header-field title="Model" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="customerPartyId">
                    <header-field title="Customer"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="installationDate">
                    <header-field title="Installed On" show-order-by="true"><date-find type="date"/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="warrantyExpiration">
                    <header-field title="Warranty Expiry" show-order-by="true"><date-find type="date"/></header-field>
                    <default-field><display format="yyyy-MM-dd"/></default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
