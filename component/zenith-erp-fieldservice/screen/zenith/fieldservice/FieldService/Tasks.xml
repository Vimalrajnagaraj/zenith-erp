<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tasks" default-menu-index="1">

    <!-- ZE-SB-013 sweep: this transition writes the ENTITY-AUTO create# (not the custom guarded service), so
         the org-ownership guard must live HERE. customerPartyId is a free-text field → reject a foreign party. -->
    <transition name="createTask">
        <actions>
            <service-call name="zenith.base.SecurityServices.assert#RecordOrgAccess" out-map="_ca"
                          in-map="[entityName:'mantle.party.Party', idField:'partyId', idValue:ec.web.parameters.customerPartyId, orgField:'ownerPartyId']"/>
            <if condition="!_ca.allowed"><return error="true" message="That customer isn't part of your organization. Choose one of your own customers."/></if>
            <service-call name="create#zenith.erp.fieldservice.FieldServiceTask" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <transition name="updateTask">
        <service-call name="update#zenith.erp.fieldservice.FieldServiceTask"/>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- ZE-SALES-014 f/u (Tier D): scope export to the active org via the owner -->
        <set field="_expOrg" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <set field="_expOwnerIds" from="null"/>
        <if condition="_expOrg">
            <entity-find entity-name="mantle.party.Party" list="_expOwnerRows"><econdition field-name="ownerPartyId" from="_expOrg"/><select-field field-name="partyId"/></entity-find>
            <set field="_expOwnerIds" from="_expOwnerRows ? _expOwnerRows.collect{it.partyId} : ['__none__']"/>
        </if>
        <entity-find entity-name="zenith.erp.fieldservice.FieldServiceTask" list="taskList">
            <search-form-inputs default-order-by="scheduledDate"/>
            <econdition field-name="customerPartyId" operator="in" from="_expOwnerIds" ignore-if-empty="true"/>
        </entity-find>
        <entity-find entity-name="mantle.party.PersonAndUserAccount" list="userList">
            <order-by field-name="firstName"/>
        </entity-find>
        <entity-find entity-name="zenith.erp.fieldservice.FieldEquipment" list="equipmentList">
            <order-by field-name="serialNumber"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.StatusItem" list="statusList">
            <condition name="statusTypeId" value="FieldServiceStatus"/>
            <order-by field-name="sequenceNum"/>
        </entity-find>
    </actions>

    <widgets>
        <container-box><box-header title="Field Service Tasks (Dispatcher Console)"/><box-toolbar>
            <section name="fld_newtask_write"><condition><expression>modCanWrite</expression></condition><widgets>
            <container-dialog id="NewTaskDialog" button-text="New Task">
                <form-single name="NewTaskForm" transition="createTask">
                    <field name="customerPartyId"><default-field title="Customer (Party ID)"><text-line size="15"/></default-field></field>
                    <field name="technicianPartyId"><default-field title="Assign Technician">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="equipmentId"><default-field title="Target Equipment">
                        <drop-down allow-empty="true">
                            <list-options list="equipmentList" key="${equipmentId}" text="${serialNumber} - ${modelName}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="scheduledDate"><default-field title="Scheduled Date"><date-time/></default-field></field>
                    <field name="statusId"><default-field title="Status">
                        <drop-down no-current-selected-key="FsScheduled">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </default-field></field>
                    <field name="serviceAddress"><default-field title="Service Address"><text-area rows="2" cols="40"/></default-field></field>
                    <field name="issueDescription"><default-field title="Issue Description"><text-area rows="3" cols="60"/></default-field></field>
                    <field name="submitButton"><default-field title="Dispatch"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            </widgets></section>
        </box-toolbar><box-body>
            <render-mode><text type="html,qvt"><![CDATA[<span class="zlc-ph" data-ph="Search Tasks..." style="display:none"></span>]]></text></render-mode>
            <form-list name="TaskListForm" list="taskList" skip-form="true" header-dialog="true"
                       show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <field name="taskId"><default-field><hidden/></default-field></field>
                <field name="customerPartyId">
                    <header-field title="Customer"><text-find size="10" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="equipmentId">
                    <header-field title="Equipment">
                        <drop-down allow-empty="true">
                            <list-options list="equipmentList" key="${equipmentId}" text="${serialNumber}"/>
                        </drop-down>
                    </header-field>
                    <default-field><display-entity entity-name="zenith.erp.fieldservice.FieldEquipment" text="${serialNumber}"/></default-field>
                </field>
                <field name="serviceAddress">
                    <header-field title="Address"><text-find size="20" hide-options="true"/></header-field>
                    <default-field><display/></default-field>
                </field>
                <field name="scheduledDate">
                    <header-field title="Date/Time" show-order-by="true"><date-find/></header-field>
                    <default-field><display format="yyyy-MM-dd HH:mm"/></default-field>
                </field>
                <field name="technicianPartyId">
                    <header-field title="Technician">
                        <drop-down allow-empty="true">
                            <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <form-single name="UpdateTechForm" transition="updateTask">
                            <field name="taskId"><default-field><hidden/></default-field></field>
                            <field name="technicianPartyId"><default-field title="">
                                <drop-down>
                                    <list-options list="userList" key="${partyId}" text="${((firstName?:'') + ' ' + (lastName?:'')).trim()}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton">
                                <conditional-field name="fld_tech_save_write" condition="modCanWrite" title="Set"><submit/></conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field>
                            </field>
                        </form-single>
                    </default-field>
                </field>
                <field name="statusId">
                    <header-field title="Status">
                        <drop-down allow-empty="true">
                            <list-options list="statusList" key="${statusId}" text="${description}"/>
                        </drop-down>
                    </header-field>
                    <default-field>
                        <form-single name="UpdateStatusForm" transition="updateTask">
                            <field name="taskId"><default-field><hidden/></default-field></field>
                            <field name="statusId"><default-field title="">
                                <drop-down>
                                    <list-options list="statusList" key="${statusId}" text="${description}"/>
                                </drop-down>
                            </default-field></field>
                            <field name="submitButton">
                                <conditional-field name="fld_status_save_write" condition="modCanWrite" title="Set"><submit/></conditional-field>
                                <default-field title=""><label text="" type="span"/></default-field>
                            </field>
                        </form-single>
                    </default-field>
                </field>
                <field name="submitButton"><header-field title="Find"><submit/></header-field></field>
            </form-list>
        </box-body></container-box>
    </widgets>
</screen>
