<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="FieldServiceTask" package="zenith.erp.fieldservice">
        <field name="taskId" type="id" is-pk="true"/>
        <field name="customerPartyId" type="id"/>
        <field name="technicianPartyId" type="id"/>
        <field name="equipmentId" type="id"/>
        <field name="scheduledDate" type="date-time"/>
        <field name="statusId" type="id"/>
        <field name="issueDescription" type="text-long"/>
        <field name="resolutionNotes" type="text-long"/>
        <field name="serviceAddress" type="text-medium"/>
        <relationship type="one" title="Customer" related="mantle.party.Party">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Technician" related="mantle.party.Party">
            <key-map field-name="technicianPartyId" related="partyId"/></relationship>
        <relationship type="one" related="zenith.erp.fieldservice.FieldEquipment"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="FieldServiceStatus" description="Field Service Status"/>
            <moqui.basic.StatusItem statusId="FsScheduled" statusTypeId="FieldServiceStatus" description="Scheduled" sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="FsDispatched" statusTypeId="FieldServiceStatus" description="Dispatched" sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="FsInProgress" statusTypeId="FieldServiceStatus" description="In Progress" sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="FsCompleted" statusTypeId="FieldServiceStatus" description="Completed" sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="FsCancelled" statusTypeId="FieldServiceStatus" description="Cancelled" sequenceNum="5"/>
        </seed-data>
    </entity>

    <entity entity-name="FieldEquipment" package="zenith.erp.fieldservice">
        <field name="equipmentId" type="id" is-pk="true"/>
        <field name="serialNumber" type="text-short"/>
        <field name="modelName" type="text-medium"/>
        <field name="customerPartyId" type="id"/>
        <field name="installationDate" type="date"/>
        <field name="warrantyExpiration" type="date"/>
        <field name="notes" type="text-medium"/>
        <relationship type="one" title="Customer" related="mantle.party.Party">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
    </entity>

</entities>
