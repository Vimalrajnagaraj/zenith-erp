<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Field Service Task Lifecycle ========== -->

    <service verb="create" noun="FieldServiceTask">
        <description>Create a new field service task. Defaults to FsScheduled status.</description>
        <in-parameters>
            <parameter name="customerPartyId" required="true"/>
            <parameter name="technicianPartyId"/>
            <parameter name="equipmentId"/>
            <parameter name="scheduledDate"/>
            <parameter name="issueDescription"/>
            <parameter name="serviceAddress"/>
        </in-parameters>
        <out-parameters>
            <parameter name="taskId"/>
        </out-parameters>
        <actions>
            <set field="statusId" value="FsScheduled"/>
            <service-call name="create#zenith.erp.fieldservice.FieldServiceTask" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="dispatch" noun="FieldServiceTask">
        <description>Dispatch a scheduled task to a technician. Validates task is in FsScheduled status.</description>
        <in-parameters>
            <parameter name="taskId" required="true"/>
            <parameter name="technicianPartyId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.fieldservice.FieldServiceTask" value-field="task"/>
            <if condition="!task"><return error="true" message="Field service task [${taskId}] not found."/></if>
            <if condition="task.statusId != 'FsScheduled'">
                <return error="true" message="Task [${taskId}] must be in FsScheduled status to dispatch. Current status: ${task.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.fieldservice.FieldServiceTask"
                          in-map="[taskId: taskId, statusId: 'FsDispatched', technicianPartyId: technicianPartyId]"/>
        </actions>
    </service>

    <service verb="start" noun="FieldServiceTask">
        <description>Start work on a dispatched field service task. Validates task is in FsDispatched status.</description>
        <in-parameters>
            <parameter name="taskId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.fieldservice.FieldServiceTask" value-field="task"/>
            <if condition="!task"><return error="true" message="Field service task [${taskId}] not found."/></if>
            <if condition="task.statusId != 'FsDispatched'">
                <return error="true" message="Task [${taskId}] must be in FsDispatched status to start. Current status: ${task.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.fieldservice.FieldServiceTask"
                          in-map="[taskId: taskId, statusId: 'FsInProgress']"/>
        </actions>
    </service>

    <service verb="complete" noun="FieldServiceTask">
        <description>Complete a field service task. Validates task is in FsInProgress status.</description>
        <in-parameters>
            <parameter name="taskId" required="true"/>
            <parameter name="resolutionNotes"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.fieldservice.FieldServiceTask" value-field="task"/>
            <if condition="!task"><return error="true" message="Field service task [${taskId}] not found."/></if>
            <if condition="task.statusId != 'FsInProgress'">
                <return error="true" message="Task [${taskId}] must be in FsInProgress status to complete. Current status: ${task.statusId}"/>
            </if>

            <service-call name="update#zenith.erp.fieldservice.FieldServiceTask"
                          in-map="[taskId: taskId, statusId: 'FsCompleted', resolutionNotes: resolutionNotes]"/>
        </actions>
    </service>

    <service verb="cancel" noun="FieldServiceTask">
        <description>Cancel a field service task. Cannot cancel if already completed.</description>
        <in-parameters>
            <parameter name="taskId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="zenith.erp.fieldservice.FieldServiceTask" value-field="task"/>
            <if condition="!task"><return error="true" message="Field service task [${taskId}] not found."/></if>
            <if condition="task.statusId == 'FsCompleted'">
                <return error="true" message="Task [${taskId}] is already completed and cannot be cancelled."/>
            </if>

            <service-call name="update#zenith.erp.fieldservice.FieldServiceTask"
                          in-map="[taskId: taskId, statusId: 'FsCancelled']"/>
        </actions>
    </service>

    <!-- ========== Field Equipment Services ========== -->

    <service verb="register" noun="FieldEquipment">
        <description>Register a new piece of field equipment.</description>
        <in-parameters>
            <parameter name="serialNumber" required="true"/>
            <parameter name="modelName" required="true"/>
            <parameter name="customerPartyId"/>
            <parameter name="installationDate"/>
            <parameter name="warrantyExpiration"/>
            <parameter name="notes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="equipmentId"/>
        </out-parameters>
        <actions>
            <service-call name="create#zenith.erp.fieldservice.FieldEquipment" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="update" noun="FieldEquipment">
        <description>Update field equipment details.</description>
        <in-parameters>
            <parameter name="equipmentId" required="true"/>
            <parameter name="serialNumber"/>
            <parameter name="modelName"/>
            <parameter name="customerPartyId"/>
            <parameter name="installationDate"/>
            <parameter name="warrantyExpiration"/>
            <parameter name="notes"/>
        </in-parameters>
        <actions>
            <service-call name="update#zenith.erp.fieldservice.FieldEquipment" in-map="context"/>
        </actions>
    </service>

</services>
